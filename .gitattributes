# .una files keep LF line breaks on checkout (ADR 0020 rule 1); the
# syntax and fmt conformance cases are byte-exact.
*.una text eol=lf
tests/conformance/syntax/*.una -text
tests/conformance/fmt/*.una -text
# Data files of runtime cases are byte-exact: some are not valid UTF-8 on purpose (S-16).
tests/conformance/runtime/*/data/* -text
