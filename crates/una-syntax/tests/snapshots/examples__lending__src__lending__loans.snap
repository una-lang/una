---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module redacted.loans)
(requirement LENDING_1
  (text "A member holds at most three tools at a time")
  (source human)
  (owner front_desk)
  (status active))
(requirement LENDING_2
  (text "A redacted lasts from one to twenty-eight days")
  (source policy "Tool Library Rules 3")
  (owner front_desk)
  (status active))
(kind pub LoanDays (doc "--- The number of days a redacted lasts.") (alias {Int in 1..28}))
(kind pub Day (doc "--- A day, counted from the Unix epoch.") (alias {Int}))
(kind pub Tool (record (name {Text}) (deposit {Nat})))
(kind pub Member (record (name {Text}) (holding {Int in 0..3})))
(kind pub redacted (record (tool {Tool}) (member {Member}) (due {Day})))
(kind pub LendError (sum (NotOnShelf (tool {Text})) ShelfDown))
(kind pub ShelfError (sum Offline))
(capability pub Shelf
  (doc "--- The shelf the tools are kept on.")
  (op pick ((name {Text})) {Option[Tool]} (fails ShelfError))
  (op give_back ((tool {Tool})) {Unit} (fails ShelfError)))
(predicate pub reflect can_borrow
  (doc "--- A member may take one more tool.")
  ((m {Member}))
  {Bool}
  (< (. m holding) 3))
(predicate pub reflect overdue
  (doc "--- A redacted is overdue after its due day.")
  ((redacted {redacted}) (today {Day}))
  {Bool}
  (> today (. redacted due)))
(fn pub lend
  (doc "--- Takes a tool from the shelf and lends it for `days` days from `today`.")
  ((member {Member}) (name {Text}) (today {Day}) (days {LoanDays}))
  {redacted}
  (requires (call can_borrow member))
  (ensures (== (. result due) (+ today days)))
  (ensures (== (. (. result member) holding) (+ (. member holding) 1)))
  (uses @shelf {Shelf[pick]})
  (fails LendError)
  (derived-from LENDING_1 LENDING_2)
  (block
    (let tool
      (handled
        (@shelf.pick name)
        (if-error-fail ShelfDown)
        (if-none-fail (NotOnShelf (tool: name)))))
    (call redacted tool
      (member: (call Member (name: (. member name)) (holding: (+ (. member holding) 1))))
      (due: (+ today days)))))
(fn pub give_back
  (doc "--- Puts a lent tool back on the shelf.")
  ((redacted {redacted}))
  {Member}
  (requires (> (. (. redacted member) holding) 0))
  (ensures (== (. result holding) (- (. (. redacted member) holding) 1)))
  (uses @shelf {Shelf[give_back]})
  (fails LendError)
  (derived-from LENDING_1)
  (block
    (handled (@shelf.give_back (. redacted tool)) (if-error-fail ShelfDown))
    (call Member (name: (. (. redacted member) name)) (holding: (- (. (. redacted member) holding) 1)))))
(fn pub late_days
  (doc "--- The days a returned tool is late, zero when it is on time.")
  ((redacted {redacted}) (today {Day}))
  {Nat}
  (ensures (implies (call overdue redacted today) (> result 0)))
  (ensures (implies (not (call overdue redacted today)) (== result 0)))
  (block (if (> today (. redacted due)) (- today (. redacted due)) 0)))
(handler pub shelf_with
  (doc "--- A shelf holding `tools`.")
  ((tools {List[Tool]}))
  (for Shelf)
  (op pick (name) (method tools first_where (keep: (fn (t) (== (. t name) name)))))
  (op give_back (tool) unit))
(handler pub offline_shelf
  (doc "--- A shelf that cannot be reached.")
  ()
  (for Shelf)
  (op pick (name) (fail Offline))
  (op give_back (tool) (fail Offline)))
(example "a member with room borrows a tool for a week"
  (given @shelf (call shelf_with (tools: (list (call Tool (name: "drill") (deposit: 20))))))
  (do (call lend (call Member (name: "Ana") (holding: 1)) (name: "drill") (today: 100) (days: 7)))
  (expect (== (. result due) 107))
  (expect (== (. (. result member) holding) 2))
  (expect-performed @shelf.pick))
(example "a tool that is not on the shelf is not lent"
  (given @shelf (call shelf_with (tools: (list))))
  (do (call lend (call Member (name: "Ana") (holding: 0)) (name: "saw") (today: 100) (days: 7)))
  (expect-fails NotOnShelf))
(example "a shelf that is offline stops the redacted"
  (given @shelf (call offline_shelf))
  (do (call lend (call Member (name: "Bo") (holding: 0)) (name: "saw") (today: 100) (days: 3)))
  (expect-fails ShelfDown))
(example "giving a tool back frees a place"
  (given @shelf (call shelf_with (tools: (list))))
  (do
    (call give_back
      (call redacted
        (tool: (call Tool (name: "saw") (deposit: 15)))
        (member: (call Member (name: "Bo") (holding: 3)))
        (due: 10))))
  (expect (== (. result holding) 2))
  (expect-performed @shelf.give_back))
(example "a tool returned three days after its due day is three days late"
  (do
    (call late_days
      (call redacted
        (tool: (call Tool (name: "saw") (deposit: 15)))
        (member: (call Member (name: "Bo") (holding: 1)))
        (due: 10))
      (today: 13)))
  (expect (== result 3)))
