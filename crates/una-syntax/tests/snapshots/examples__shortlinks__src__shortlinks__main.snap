(module shortlinks.main)
(import shortlinks.links one_link resolve_or_home)
(fn pub main
  ()
  {Unit}
  (uses @console {Console[print]})
  (block
    (let docs
      (handled
        (call resolve_or_home "docs")
        (with (= @links (call one_link (saved: "docs") (leads_to: "https://example.org/docs"))))))
    (@console.print (text "docs leads to " docs))
    (let blog
      (handled
        (call resolve_or_home "blog")
        (with (= @links (call one_link (saved: "docs") (leads_to: "https://example.org/docs"))))))
    (@console.print (text "blog leads to " blog))))
