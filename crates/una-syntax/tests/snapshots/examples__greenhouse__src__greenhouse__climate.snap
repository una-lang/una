---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module greenhouse.climate)
(requirement GREENHOUSE_1
  (text "Vents open fully whenever the air is above 35 degrees")
  (source regulation "Greenhouse Ventilation Code 4.2")
  (owner growers)
  (status active))
(kind pub Celsius
  (doc "--- Degrees Celsius, as far as the sensors reach.")
  (alias {Int in -40..80}))
(kind pub Percent (doc "--- How far a vent is open.") (alias {Int in 0..100}))
(capability pub Sensor
  (doc "--- A thermometer. What it reports is assumed, not proven: the build report lists it.")
  (op read () {Int} (ensures (and (>= result (neg 40)) (<= result 80)))))
(capability pub Vent
  (doc "--- A roof vent motor, which only takes openings it can reach.")
  (op set ((open {Int})) {Unit} (requires (in open 0..100))))
(fn pub opening
  (doc "--- The opening for a temperature: closed at 20 degrees or below, fully open above 35,")
  (doc "--- and in steps of six in between.")
  ((temperature {Celsius}))
  {Percent}
  (ensures (implies (> temperature 35) (== result 100)))
  (ensures (implies (<= temperature 20) (== result 0)))
  (derived-from GREENHOUSE_1)
  (block
    (when temperature
      (arm (in -40..20) 0)
      (arm (in 21..35) (* (paren (- temperature 20)) 6))
      (arm (in 36..80) 100))))
(fn pub regulate
  (doc "--- Reads the air and sets the vent to match.")
  ()
  {Percent}
  (uses @sensor {Sensor[read]})
  (uses @vent {Vent[set]})
  (block
    (let temperature (@sensor.read))
    (let wanted (call opening temperature))
    (@vent.set wanted)
    wanted))
(fn reading
  (doc "--- The reading of the sensor bound to `@sensor`. Its header is inferred: it is private.")
  ()
  {Celsius}
  (@sensor.read))
(fn pub warmest
  (doc "--- The warmer of two sides of the greenhouse.")
  ()
  {Celsius}
  (uses @north {Sensor[read]})
  (uses @south {Sensor[read]})
  (block
    (let north (handled (call reading) (with (= @sensor @north))))
    (let south (handled (call reading) (with (= @sensor @south))))
    (call max north (b: south))))
(fn pub regulate_warmest
  (doc "--- Sets the vent for the warmer side.")
  ()
  {Percent}
  (uses @north {Sensor[read]})
  (uses @south {Sensor[read]})
  (uses @vent {Vent[set]})
  (block
    (let temperature (call warmest))
    (let wanted (call opening temperature))
    (@vent.set wanted)
    wanted))
(handler pub fixed_sensor
  (doc "--- A sensor that always reads `degrees`. Its operation is verified against `read`'s ensures.")
  ((degrees {Celsius}))
  (for Sensor)
  (op read () degrees))
(handler pub printed_vent
  (doc "--- A vent that prints each setting on the console.")
  ()
  (for Vent)
  (uses @console {Console[print]})
  (op set (open) (@console.print (text "vent at " open "%"))))
(handler pub quiet_vent
  (doc "--- A vent that does nothing, for the examples.")
  ()
  (for Vent)
  (op set (open) unit))
(example "above 35 degrees the vent opens fully" (do (call opening 36)) (expect (== result 100)))
(example "a cold greenhouse stays closed"
  (given @sensor (call fixed_sensor (degrees: 12)))
  (given @vent (call quiet_vent))
  (do (call regulate))
  (expect (== result 0))
  (expect-performed @vent.set))
(example "the vent follows the warmer side"
  (given @north (call fixed_sensor (degrees: 18)))
  (given @south (call fixed_sensor (degrees: 30)))
  (given @vent (call quiet_vent))
  (do (call regulate_warmest))
  (expect (== result 60)))
