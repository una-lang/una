---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module events.types)
(kind pub Phone
  (doc "--- A phone number of 11 digits, validated once at the boundary.")
  (alias {Text} (where (call valid_phone it))))
(kind pub PhoneError (sum Malformed))
(predicate pub opaque valid_phone
  (doc "--- Format check only: eleven digits.")
  ((t {Text}))
  {Bool}
  (and (== (. t len) 11) (call is_digits t)))
(fn pub parse_phone
  (doc "--- The only way to obtain a Phone from untrusted text.")
  ((raw {Text}))
  {Phone}
  (fails PhoneError)
  (block (checked raw (call valid_phone it) (fail Malformed))))
(example "malformed input is rejected" (do (call parse_phone "123")) (expect-fails Malformed))
