---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module journal.main)
(import journal.release length_band)
(fn pub main
  (doc "--- Prints how long today's entry is, never what it says, and copies it where")
  (doc "--- `JOURNAL_COPY` names when that is set and the grant allows writing.")
  ()
  {Unit}
  (uses @console {Console[print]})
  (uses @files {Files[read, write]})
  (uses @env {Env[get]})
  (fails FileError)
  (block
    (let text (handled (@files.read "today.txt") (if-error-pass)))
    (let hundreds (call length_band text))
    (@console.print (text "today's entry runs to about " hundreds " hundred characters"))
    (let copy_to (handled (@env.get "JOURNAL_COPY") (if-none-use "")))
    (if
      (== copy_to "")
      (block unit)
      (block (handled (@files.write copy_to (content: text)) (if-error-use unit))))))
