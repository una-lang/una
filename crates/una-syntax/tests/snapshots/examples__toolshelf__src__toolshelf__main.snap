source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module toolshelf.main)
(import toolshelf.tools CheckoutError Member Tool check_out late_days shelf_with)
(fn catalog
  (doc "--- The tools of the community shelf.")
  ()
  {List[Tool]}
  (list
    (call Tool (name: "drill") (deposit: 20))
    (call Tool (name: "ladder") (deposit: 35))
    (call Tool (name: "saw") (deposit: 15))))
(fn pub main
  ()
  {Unit}
  (uses @console {Console[print]})
  (uses @clock {Clock[now]})
  (fails CheckoutError)
  (block
    (let now (@clock.now))
    (let today (/ now 86400000))
    (let checkout
      (handled
        (call check_out (call Member (name: "Ana") (holding: 0)) (name: "ladder") today (days: 14))
        (with (= @shelf (call shelf_with (tools: (call catalog)))))
        (if-error-pass)))
    (@console.print
      (text (. (. checkout member) name) " took the " (. (. checkout tool) name) " for 14 days"))
    (let late (call late_days checkout (today: (+ today 20))))
    (@console.print (text "returned 20 days later, it is " late " days late"))))
