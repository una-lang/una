---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module shortlinks.links)
(requirement LINKS_1
  (text "A slug has 3 to 16 characters and never starts with a dash")
  (source generated "task 17: short link rules")
  (owner web_team)
  (status proposed))
(kind pub Slug
  (doc "--- A slug, checked once where it enters the program.")
  (alias {Text} (where (call valid_slug it))))
(kind pub SlugError (sum Malformed))
(kind pub LinkError (sum BadSlug (Unknown (slug {Text})) StoreDown))
(kind pub StoreError (sum Offline))
(predicate pub opaque valid_slug
  (doc "--- Format check only. The solver sees an opaque symbol; `checked` establishes it.")
  ((t {Text}))
  {Bool}
  (and (and (>= (. t len) 3) (<= (. t len) 16)) (not (call starts_with t (prefix: "-")))))
(capability pub Links
  (doc "--- Where short links are kept.")
  (op put ((slug {Slug}) (target {Text})) {Unit} (fails StoreError))
  (op get ((slug {Slug})) {Option[Text]} (fails StoreError)))
(fn pub parse_slug
  (doc "--- The only way to obtain a Slug from untrusted text.")
  ((raw {Text}))
  {Slug}
  (fails SlugError)
  (derived-from LINKS_1)
  (block (let text (call trim raw)) (checked text (call valid_slug it) (fail Malformed))))
(fn pub shorten
  (doc "--- Stores a short link and returns its slug.")
  ((raw {Text}) (target {Text}))
  {Slug}
  (uses @links {Links[put]})
  (fails LinkError)
  (block
    (let slug (handled (call parse_slug raw) (if-error-fail BadSlug)))
    (handled (@links.put slug target) (if-error-fail StoreDown))
    slug))
(fn pub resolve
  (doc "--- Where a short link leads.")
  ((raw {Text}))
  {Text}
  (uses @links {Links[get]})
  (fails LinkError)
  (block
    (let slug (handled (call parse_slug raw) (if-error-fail BadSlug)))
    (let target
      (handled (@links.get slug) (if-error-fail StoreDown) (if-none-fail (Unknown (slug: raw)))))
    target))
(fn pub try_resolve
  (doc "--- Resolves a short link, with the failure as a value rather than a failure.")
  ((raw {Text}))
  {Result[Text, LinkError]}
  (uses @links {Links[get]})
  (block (attempt (call resolve raw))))
(fn pub resolve_or_home
  (doc "--- Where a short link leads, or the home page when it cannot be resolved.")
  ((raw {Text}))
  {Text}
  (uses @links {Links[get]})
  (block
    (let outcome (call try_resolve raw))
    (when outcome (arm (is Ok target) target) (arm (is Err) "/"))))
(fn pub lookup
  (doc "--- Where a checked slug leads, or the home page when the store is down or has no such slug.")
  ((slug {Slug}))
  {Text}
  (uses @links {Links[get]})
  (block (let found (handled (@links.get slug) (if-error-use None) (if-none-use "/"))) found))
(handler pub one_link
  (doc "--- A store holding one link.")
  ((saved {Text}) (leads_to {Text}))
  (for Links)
  (op put (slug target) unit)
  (op get (slug) (if (== slug saved) (call Some leads_to) None)))
(handler pub offline_links
  (doc "--- A store that cannot be reached.")
  ()
  (for Links)
  (op put (slug target) (fail Offline))
  (op get (slug) (fail Offline)))
(example "a short link leads to its target"
  (given @links (call one_link (saved: "docs") (leads_to: "https://example.org/docs")))
  (do (call resolve "docs"))
  (expect (== result "https://example.org/docs"))
  (expect-performed @links.get))
(example "a malformed slug is rejected before the store is asked"
  (given @links (call one_link (saved: "docs") (leads_to: "https://example.org/docs")))
  (do (call resolve "-x"))
  (expect-fails BadSlug)
  (expect-not-performed @links.get))
(example "an unknown slug fails"
  (given @links (call one_link (saved: "docs") (leads_to: "https://example.org/docs")))
  (do (call resolve "blog"))
  (expect-fails Unknown))
(example "an attempt reports a failure as a value"
  (given @links (call offline_links))
  (do (call try_resolve "docs"))
  (expect (is result Err)))
(example "without a store the home page is shown"
  (given @links (call offline_links))
  (do (call resolve_or_home "docs"))
  (expect (== result "/")))
(example "a slug is stored"
  (given @links (call one_link (saved: "docs") (leads_to: "https://example.org/docs")))
  (do (call shorten " news " (target: "https://example.org/news")))
  (expect (== result "news"))
  (expect-performed @links.put))
