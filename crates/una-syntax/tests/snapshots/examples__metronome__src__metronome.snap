---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module metronome)
(import std.drive Tick)
(kind pub Metronome
  (doc "--- Where the metronome is: the bar it plays, and the beat in that bar, 0 before the first.")
  (record (bar {Nat}) (beat {Int in 0..4})))
(fn pub init
  (doc "--- The metronome before its first beat.")
  ()
  {Metronome}
  (call Metronome (bar: 1) (beat: 0)))
(fn pub advance
  (doc "--- The beat after `state`: the next one in the bar, or the first of the next bar after the")
  (doc "--- fourth.")
  ((state {Metronome}))
  {Metronome}
  (ensures (>= (. result beat) 1))
  (ensures (implies (< (. state beat) 4) (== (. result bar) (. state bar))))
  (block
    (if
      (< (. state beat) 4)
      (block (call Metronome (bar: (. state bar)) (beat: (+ (. state beat) 1))))
      (block (call Metronome (bar: (+ (. state bar) 1)) (beat: 1))))))
(fn pub step
  (doc "--- Plays one beat for each tick: `tick` on the first beat of a bar, `tock` on the others.")
  ((edit state {Metronome}) (input {Tick}))
  {Unit}
  (uses @console {Console[print]})
  (block
    (assign state (call advance state))
    (if
      (== (. state beat) 1)
      (block (@console.print (text "bar " (. state bar) ": tick")))
      (block (@console.print (text "bar " (. state bar) ": tock"))))))
(fn pub on_stop
  (doc "--- Says where the metronome stopped.")
  ((state {Metronome}))
  {Unit}
  (uses @console {Console[print]})
  (block (@console.print (text "stopped at bar " (. state bar) ", beat " (. state beat)))))
(example "the first beat opens bar 1"
  (do (call advance (call init)))
  (expect (and (== (. result bar) 1) (== (. result beat) 1))))
(example "the fourth beat is followed by the first of the next bar"
  (do (call advance (call Metronome (bar: 1) (beat: 4))))
  (expect (and (== (. result bar) 2) (== (. result beat) 1))))
