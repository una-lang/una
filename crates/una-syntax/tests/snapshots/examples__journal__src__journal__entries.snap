---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module journal.entries)
(kind pub Entry
  (doc "--- A day's entry. Its text is private to the writer.")
  (record (day {Int}) (body {confidential[Private] Text})))
(kind pub Mood (sum Calm Busy))
(kind pub DiaryError (sum Unavailable))
(capability pub Diary
  (doc "--- Where entries are kept. They hold private text, so the store accepts it.")
  (op keep ((entry {Entry})) {Unit} (fails DiaryError) (accepts confidential[Private])))
(fn pub mood
  (doc "--- A long entry means a busy day. The answer depends on the text, so it is as private.")
  ((entry {Entry}))
  {confidential[Private] Mood}
  (if (> (. (. entry body) len) 280) Busy Calm))
(fn pub write
  (doc "--- Writes an entry for `day` and keeps it.")
  ((day {Int}) (body {confidential[Private] Text}))
  {Entry}
  (ensures (== (. result day) day))
  (uses @diary {Diary[keep]})
  (fails DiaryError)
  (block (let entry (call Entry day body)) (handled (@diary.keep entry) (if-error-pass)) entry))
(handler memory_diary
  (doc "--- A diary kept in memory for the examples.")
  ()
  (for Diary)
  (op keep (entry) unit))
(handler full_diary
  (doc "--- A diary with no room left.")
  ()
  (for Diary)
  (op keep (entry) (fail Unavailable)))
(example "an entry is kept"
  (given @diary (call memory_diary))
  (do (call write 1 (body: "Planted tomatoes.")))
  (expect (== (. result day) 1))
  (expect-performed @diary.keep))
(example "a full diary reports it"
  (given @diary (call full_diary))
  (do (call write 2 (body: "Read two chapters.")))
  (expect-fails Unavailable))
(example "a short entry is a calm day"
  (do (call mood (call Entry (day: 3) (body: "Quiet."))))
  (expect (is result Calm)))
