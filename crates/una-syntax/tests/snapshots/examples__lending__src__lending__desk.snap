---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module lending.desk)
(import lending.loans Day LendError Loan LoanDays Member Shelf Tool can_borrow lend shelf_with)
(fn pub lend_anywhere
  (doc "--- Lends from the main shelf, or from the backup shelf when the main one cannot.")
  ((member {Member}) (name {Text}) (today {Day}) (days {LoanDays}))
  {Loan}
  (requires (call can_borrow member))
  (ensures (== (. result due) (+ today days)))
  (uses @main_shelf {Shelf[pick]})
  (uses @backup_shelf {Shelf[pick]})
  (fails LendError)
  (block
    (let first_try
      (handled (attempt (call lend member name today days)) (with (= @shelf @main_shelf))))
    (when first_try
      (arm (is Ok loan) loan)
      (arm
        (is Err)
        (block
          (handled
            (call lend member name today days)
            (with (= @shelf @backup_shelf))
            (if-error-pass)))))))
(example "the backup shelf lends what the main shelf lacks"
  (given @main_shelf (call shelf_with (tools: (list))))
  (given @backup_shelf (call shelf_with (tools: (list (call Tool (name: "saw") (deposit: 15))))))
  (do
    (call lend_anywhere (call Member (name: "Bo") (holding: 2)) (name: "saw") (today: 10) (days: 3)))
  (expect (== (. (. result tool) name) "saw"))
  (expect (== (. result due) 13))
  (expect-performed @backup_shelf.pick))
(example "the main shelf is tried first"
  (given @main_shelf (call shelf_with (tools: (list (call Tool (name: "drill") (deposit: 20))))))
  (given @backup_shelf (call shelf_with (tools: (list))))
  (do
    (call lend_anywhere
      (call Member (name: "Ana") (holding: 0))
      (name: "drill")
      (today: 10)
      (days: 3)))
  (expect (== (. (. result tool) name) "drill"))
  (expect-not-performed @backup_shelf.pick))
