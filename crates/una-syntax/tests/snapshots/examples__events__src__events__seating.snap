---
source: crates/una-syntax/tests/examples.rs
expression: "dump(&parsed.file, &interner, db.file(id).text())"
---
(module events.seating)
(requirement EVENTS_3
  (text "An event with no remaining seats is always shown as sold out")
  (source policy "Box Office Handbook 2.1")
  (owner box_office)
  (status active))
(kind pub Seats (alias {Int in 0..5000}))
(kind pub Availability (sum SoldOut Few Open))
(kind pub Event (record (name {Text}) (remaining {Seats})))
(kind pub Registration (record (name {Text}) (event {Event})))
(fn pub availability
  (doc "--- Availability bands from the Box Office Handbook 2.1.")
  ((e {Event}))
  {Availability}
  (ensures (implies (< (. e remaining) 1) (is result SoldOut)))
  (derived-from EVENTS_3)
  (block
    (when (. e remaining) (arm (in 0..0) SoldOut) (arm (in 1..<20) Few) (arm (in 20..5000) Open))))
(fn pub clamp_seats
  (doc "--- Clamps a raw seat count into the seat range.")
  ((raw {Int}))
  {Seats}
  (if (< raw 0) 0 (if (> raw 5000) 5000 raw)))
(example "an event without seats is sold out"
  (do (call availability (call Event (name: "Launch") (remaining: 0))))
  (expect (is result SoldOut)))
(example "an event with many seats is open"
  (do (call availability (call Event (name: "Workshop") (remaining: 820))))
  (expect (is result Open)))
(example "raw seat counts are clamped" (do (call clamp_seats 9000)) (expect (== result 5000)))
