---
source: crates/una-cli/tests/cli.rs
expression: stdout(&output)
---
module events.checkin

data CheckInError = NotRegistered | Unavailable(reason: Text)

data StoreError = Timeout | Corrupted

cap Registrations {
  op find(key: internal Hashed) : Option[Registration] fails StoreError accepts internal
}

cap Audit {
  op record(key: internal Hashed, status: Availability) : Unit fails StoreError accepts internal
}

fun check_in(phone: secret[PII] {Text | Phone}) : Availability uses {registrations ↦ Registrations[find], audit ↦ Audit[record], keys ↦ Keys[hmac]} fails CheckInError =
  let key: internal Hashed =
    handle
      let %t0: internal Hashed = declassify[events.keys.attendee_key](phone) in
      %t0
    with error ⇒
      fail Unavailable("keys")
  in
  let %t2: Option[Registration] =
    handle
      let %t1: Option[Registration] = registrations.find(key) in
      %t1
    with error%2 ⇒
      fail Unavailable("registrations")
  in
  let registration: Registration =
    case %t2 of
      Some(%t3) ⇒
        %t3
      else ⇒
        fail NotRegistered
  in
  let %t4: Event = registration.event in
  let status: Availability = events.seating.availability(%t4) in
  let _: Unit =
    handle
      let %t6: Unit = audit.record(key, status) in
      %t6
    with error%3 ⇒
      fail Unavailable("audit")
  in
  status

handler one_registration(r: Registration) for Registrations {
  op find(key) =
    let %t0: Option[Registration] = Some(r) in
    %t0
}

handler no_registrations() for Registrations {
  op find(key) =
    let %t0: Option[Registration] = None in
    %t0
}

handler audit_log() for Audit {
  op record(key, status) =
    unit
}

handler fake_keys() for Keys {
  op hmac(key_name, data) =
    let %t0: internal Hashed = std.testing.fake_hash(1) in
    %t0
}
