; ob-133159250d47 postcondition journal.entries.write result.day == day
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort i!Text 0)
(declare-sort u!Kind_journal_entries_Entry 0)
(declare-fun |i!v!path!1| () Bool)
(declare-fun |u!v!body| () i!Text)
(declare-fun |u!v!day| () Int)
(declare-fun |u!v!entry| () u!Kind_journal_entries_Entry)
(declare-fun |u!v!result| () u!Kind_journal_entries_Entry)
(declare-fun u!f!body!u!Kind_journal_entries_Entry (u!Kind_journal_entries_Entry) i!Text)
(declare-fun u!f!day!u!Kind_journal_entries_Entry (u!Kind_journal_entries_Entry) Int)
(assert (= |i!v!path!1| (and (= (u!f!day!u!Kind_journal_entries_Entry |u!v!entry|) |u!v!day|) (= (u!f!body!u!Kind_journal_entries_Entry |u!v!entry|) |u!v!body|) (= |u!v!result| |u!v!entry|))))
(assert |i!v!path!1|)
(assert (not (= (u!f!day!u!Kind_journal_entries_Entry |u!v!result|) |u!v!day|)))
(check-sat)
(get-model)
(get-value (|u!v!body| |u!v!day| (u!f!body!u!Kind_journal_entries_Entry |u!v!entry|) (u!f!day!u!Kind_journal_entries_Entry |u!v!entry|) |u!v!result| (u!f!day!u!Kind_journal_entries_Entry |u!v!result|) |i!v!path!1|))
(get-info :reason-unknown)
(exit)

; ob-23d87748d52e refinement journal.release.hundreds result >= 0
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort i!Text 0)
(declare-fun |i!v!path!1| () Bool)
(declare-fun |u!v!%t0| () Int)
(declare-fun |u!v!%t1| () Int)
(declare-fun |u!v!result| () Int)
(declare-fun |u!v!text| () i!Text)
(declare-fun i!len!i!Text (i!Text) Int)
(assert (>= (i!len!i!Text |u!v!text|) 0))
(assert (= |i!v!path!1| (and (= |u!v!%t0| (i!len!i!Text |u!v!text|)) (= |u!v!%t1| (div |u!v!%t0| 100)) (= |u!v!result| |u!v!%t1|))))
(assert |i!v!path!1|)
(assert (not (>= |u!v!result| 0)))
(check-sat)
(get-model)
(get-value (|u!v!result| |u!v!text| (i!len!i!Text |u!v!text|) |i!v!path!1|))
(get-info :reason-unknown)
(exit)
