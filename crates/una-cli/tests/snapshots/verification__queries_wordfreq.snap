; ob-ee99f1a645a5 precondition wordfreq.words space.len > 0
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort i!Text 0)
(declare-fun |i!lit!20| () i!Text)
(declare-fun |u!v!space| () i!Text)
(declare-fun i!len!i!Text (i!Text) Int)
(assert (= (i!len!i!Text |i!lit!20|) 1))
(assert (>= (i!len!i!Text |u!v!space|) 0))
(assert (>= (i!len!i!Text |i!lit!20|) 0))
(assert (= |u!v!space| |i!lit!20|))
(assert (not (> (i!len!i!Text |u!v!space|) 0)))
(check-sat)
(get-model)
(get-value (|u!v!space| (i!len!i!Text |u!v!space|) |i!lit!20|))
(get-info :reason-unknown)
(exit)

; ob-1ef23ba876c5 postcondition wordfreq.initial result.len == 1
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort i!Text 0)
(declare-fun |i!v!path!1| () Bool)
(declare-fun |u!v!%t0| () i!Text)
(declare-fun |u!v!result| () i!Text)
(declare-fun |u!v!word| () i!Text)
(declare-fun i!len!i!Text (i!Text) Int)
(assert (>= (i!len!i!Text |u!v!%t0|) 0))
(assert (>= (i!len!i!Text |u!v!result|) 0))
(assert (>= (i!len!i!Text |u!v!word|) 0))
(assert (>= (i!len!i!Text |u!v!word|) 1))
(assert (= |i!v!path!1| (and (= (i!len!i!Text |u!v!%t0|) (- 1 0)) (= |u!v!result| |u!v!%t0|))))
(assert |i!v!path!1|)
(assert (not (= (i!len!i!Text |u!v!result|) 1)))
(check-sat)
(get-model)
(get-value (|u!v!result| (i!len!i!Text |u!v!result|) |u!v!word| (i!len!i!Text |u!v!word|) |i!v!path!1|))
(get-info :reason-unknown)
(exit)

; ob-bdc97550ae15 precondition wordfreq.initial 0 <= 0 and 0 <= 1 and 1 <= word.len
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort i!Text 0)
(declare-fun |u!v!word| () i!Text)
(declare-fun i!len!i!Text (i!Text) Int)
(assert (>= (i!len!i!Text |u!v!word|) 0))
(assert (>= (i!len!i!Text |u!v!word|) 1))
(assert (not (and (and (<= 0 0) (<= 0 1)) (<= 1 (i!len!i!Text |u!v!word|)))))
(check-sat)
(get-model)
(get-value (|u!v!word| (i!len!i!Text |u!v!word|)))
(get-info :reason-unknown)
(exit)

