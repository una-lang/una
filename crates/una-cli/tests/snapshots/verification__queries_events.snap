(declare-fun |result| () Int)
(assert (= |path!1| (and (= |%t0| (< |raw| 0)) |%t0| (= |result| 0))))
(assert (= |path!2| (and (= |%t0| (< |raw| 0)) (not |%t0|) (= |%t1| (> |raw| 5000)) |%t1| (= |result| 5000))))
(assert (= |path!3| (and (= |%t0| (< |raw| 0)) (not |%t0|) (= |%t1| (> |raw| 5000)) (not |%t1|) (= |result| |raw|))))
