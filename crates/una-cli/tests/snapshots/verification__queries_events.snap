; ob-040bc2e8a7a6 refinement events.checkin.example "a registered attendee is checked in and audited" valid_phone(parse_phone("12345678901"))
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort Kind_events_seating_Event 0)
(declare-sort Kind_events_seating_Registration 0)
(declare-sort Text 0)
(declare-fun |%t0| () Kind_events_seating_Event)
(declare-fun |%t1| () Kind_events_seating_Registration)
(declare-fun |%t2| () Text)
(declare-fun |text!416e61| () Text)
(declare-fun |text!4c61756e6368| () Text)
(declare-fun event!Kind_events_seating_Registration (Kind_events_seating_Registration) Kind_events_seating_Event)
(declare-fun events.types.valid_phone (Text) Bool)
(declare-fun len!Text (Text) Int)
(declare-fun name!Kind_events_seating_Event (Kind_events_seating_Event) Text)
(declare-fun name!Kind_events_seating_Registration (Kind_events_seating_Registration) Text)
(declare-fun remaining!Kind_events_seating_Event (Kind_events_seating_Event) Int)
(assert (distinct |text!416e61| |text!4c61756e6368|))
(assert (= (len!Text |text!416e61|) 3))
(assert (= (len!Text |text!4c61756e6368|) 6))
(assert (and (<= 0 (remaining!Kind_events_seating_Event |%t0|)) (<= (remaining!Kind_events_seating_Event |%t0|) 5000)))
(assert (>= (len!Text |text!416e61|) 0))
(assert (>= (len!Text |text!4c61756e6368|) 0))
(assert (= (name!Kind_events_seating_Event |%t0|) |text!4c61756e6368|))
(assert (= (remaining!Kind_events_seating_Event |%t0|) 820))
(assert (= (name!Kind_events_seating_Registration |%t1|) |text!416e61|))
(assert (= (event!Kind_events_seating_Registration |%t1|) |%t0|))
(assert (events.types.valid_phone |%t2|))
(assert (not (events.types.valid_phone |%t2|)))
(check-sat)
(get-model)
(get-value (|text!416e61| |text!4c61756e6368|))
(get-info :reason-unknown)
(exit)

