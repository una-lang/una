; ob-c8ef4e89cef2 refinement events.checkin.check_in valid_phone(phone)
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort Text 0)
(declare-fun |phone| () Text)
(declare-fun events.types.valid_phone (Text) Bool)
(assert (events.types.valid_phone |phone|))
(assert (not (events.types.valid_phone |phone|)))
(check-sat)
(get-model)
(get-value (|phone|))
(get-info :reason-unknown)
(exit)

