; ob-5d09382a20ae refinement shortlinks.links.parse_slug valid_slug(result)
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-sort i!Text 0)
(declare-fun |i!v!path!1| () Bool)
(declare-fun |u!v!%t2| () i!Text)
(declare-fun |u!v!raw| () i!Text)
(declare-fun |u!v!result| () i!Text)
(declare-fun |u!v!text| () i!Text)
(declare-fun i!len!i!Text (i!Text) Int)
(declare-fun u!p!shortlinks.links.valid_slug (i!Text) Bool)
(assert (>= (i!len!i!Text |u!v!raw|) 0))
(assert (>= (i!len!i!Text |u!v!text|) 0))
(assert (= |i!v!path!1| (and (<= (i!len!i!Text |u!v!text|) (i!len!i!Text |u!v!raw|)) (u!p!shortlinks.links.valid_slug |u!v!text|) (= |u!v!%t2| |u!v!text|) (= |u!v!result| |u!v!%t2|))))
(assert |i!v!path!1|)
(assert (not (u!p!shortlinks.links.valid_slug |u!v!result|)))
(check-sat)
(get-model)
(get-value (|u!v!raw| (i!len!i!Text |u!v!raw|) |u!v!result| (i!len!i!Text |u!v!text|) |i!v!path!1|))
(get-info :reason-unknown)
(exit)

