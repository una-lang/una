; ob-79326f5fb06e postcondition greenhouse.climate.fixed_sensor.read result >= -40 and result <= 80
(set-option :produce-models true)
(set-option :smt.random_seed 0)
(set-option :rlimit 5000000)
(set-logic QF_UFLIA)
(declare-fun |i!v!path!1| () Bool)
(declare-fun |u!v!degrees| () Int)
(declare-fun |u!v!result| () Int)
(assert (and (<= (- 40) |u!v!degrees|) (<= |u!v!degrees| 80)))
(assert (= |i!v!path!1| (= |u!v!result| |u!v!degrees|)))
(assert |i!v!path!1|)
(assert (not (and (>= |u!v!result| (- 40)) (<= |u!v!result| 80))))
(check-sat)
(get-model)
(get-value (|u!v!degrees| |u!v!result| |i!v!path!1|))
(get-info :reason-unknown)
(exit)

