--- Replaces the element at `index` of `xs` with `item` (`spec/17 §8`).
pub set[T](edit xs: List[T], index: Int, item: T) -> Unit
  requires 0 <= index and index < xs.len
  ensures xs.len == old(xs).len
=
  unit

--- The elements of `xs` in ascending order, equal ones in their order in `xs` (`spec/20 §6`).
pub sort[T: Ord](xs: List[T]) -> List[T]
  ensures result.len == xs.len
=
  xs

--- An entry of a map, as `entries()` lists them (`spec/21 §1` rule 4).
pub kind Entry[K, V]
  key: K
  value: V

--- The map with no entries, of the type its context expects (`spec/21 §2`).
pub empty_map[K: Ord, V]() -> Map[K, V]
  ensures result.len == 0
=
  empty_map()

--- Whether `t` is one JSON number of RFC 8259 §6 (`spec/23 §1`). Opaque: both engines
--- evaluate it.
pub predicate opaque is_json_number(t: Text) -> Bool = t.len > 0

--- The text of a JSON number with a fraction or an exponent, which `Decimal` holds (`spec/23 §1`).
pub kind JsonNumber = Text where is_json_number(it)

--- A JSON value (`spec/23 §1`). `Number` is an exact integer, a JSON number with neither a
--- fraction nor an exponent; other numbers are `Decimal`, as written.
pub kind Json = Null | Boolean(value: Bool) | Number(value: Int) | Decimal(text: JsonNumber) | Str(value: Text) | Array(items: List[Json]) | Object(fields: Map[Text, Json])

--- Why a text is not one JSON value, at the first error in reading order (`spec/23 §3`).
pub kind JsonError = Syntax(at: Int) | TooDeep(at: Int) | DuplicateKey(at: Int) | NumberTooLong(at: Int)

--- The one JSON value of `t` (`spec/23 §3`).
pub parse_json(t: Text) -> Json
  fails JsonError
=
  Null

--- The canonical JSON text of `j` (`spec/23 §4`).
pub to_json(j: Json) -> Text
=
  ""

--- `t` as a JSON string literal (`spec/23 §4` rule 2).
pub quote_json(t: Text) -> Text
=
  t

--- Why `parse_int` fails (`spec/22 §4`).
pub kind ParseError = Empty | NotADigit(at: Int) | NoDigits | TooLong

--- The parts of `t` between the non-overlapping occurrences of `on`, left to right
--- (`spec/22 §2`).
pub split(t: Text, on: Text) -> List[Text]
  requires on.len > 0
  ensures result.len >= 1
=
  [t]

--- The parts joined, with `separator` between each two (`spec/22 §2`).
pub join(parts: List[Text], separator: Text) -> Text = separator

--- Whether `t` ends with `suffix` (`spec/22 §2`).
pub ends_with(t: Text, suffix: Text) -> Bool = true

--- Whether `part` occurs in `t` (`spec/22 §2`).
pub contains_text(t: Text, part: Text) -> Bool = true

--- The position of the first occurrence of `text` in `t`, `Some(0)` for an empty `text`; it
--- is `Some` exactly when `contains_text(t, part: text)` (`spec/22 §2` rule 2).
pub find(t: Text, text: Text) -> Option[Int] = None

--- `t` with every non-overlapping occurrence of `pattern` replaced by `by`, left to right
--- (`spec/22 §2`).
pub replace(t: Text, pattern: Text, by: Text) -> Text
  requires pattern.len > 0
=
  t

--- The scalar values of `t` from position `start` up to, not including, `end`
--- (`spec/22 §2`).
pub slice(t: Text, start: Int, end: Int) -> Text
  requires 0 <= start and start <= end and end <= t.len
  ensures result.len == end - start
=
  t

--- `t` with the ASCII letters `a` to `z` in upper case (`spec/22 §3`).
pub to_upper(t: Text) -> Text
  ensures result.len == t.len
=
  t

--- `t` with the ASCII letters `A` to `Z` in lower case (`spec/22 §3`).
pub to_lower(t: Text) -> Text
  ensures result.len == t.len
=
  t

--- One text of length 1 per scalar value of `t`, in order (`spec/22 §2`).
pub chars(t: Text) -> List[Text]
  ensures result.len == t.len
=
  [t]

--- The integer that `t` writes, an optional `-` and one or more ASCII digits (`spec/22 §4`).
pub parse_int(t: Text) -> Int
  fails ParseError
=
  fail Empty

--- `t` without Unicode white space at its start (`spec/22 §2`).
pub trim_start(t: Text) -> Text
  ensures result.len <= t.len
=
  t

--- `t` without Unicode white space at its end (`spec/22 §2`).
pub trim_end(t: Text) -> Text
  ensures result.len <= t.len
=
  t

--- The UTF-8 encoding of `t` (`spec/22 §2`).
pub bytes(t: Text) -> List[U8]
  ensures result.len >= t.len
=
  []

--- A header of an HTTP request or response (`spec/24 §1`). Its value may hold `internal` data,
--- which a request accepts; a `secret` needs a policy first.
pub kind Header
  name: Text
  value: internal Text

--- An HTTP response, whatever its status (`spec/24 §1` rule 3).
pub kind Response
  status: Int
  headers: List[Header]
  body: Text

--- Why an HTTP request got no response it may return (`spec/24 §1` rule 3).
pub kind HttpError = Denied | BadUrl | BadRequest | Unreachable | TimedOut | TooLarge | Tls | Protocol

--- HTTP/1.1 to the origins that `http:` grants allow (`spec/24 §1`). `key_name` sends the key of
--- that name from the `keys:` grants as a bearer token, which the program never sees.
pub capability Http
  op get(url: Text, headers: List[Header], key_name: Option[Text]) -> internal Response
    fails HttpError
    accepts internal
  op post(url: Text, headers: List[Header], body: Text, key_name: Option[Text]) -> internal Response
    fails HttpError
    accepts internal
  op put(url: Text, headers: List[Header], body: Text, key_name: Option[Text]) -> internal Response
    fails HttpError
    accepts internal
  op delete(url: Text, headers: List[Header], key_name: Option[Text]) -> internal Response
    fails HttpError
    accepts internal
