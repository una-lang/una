-- The prelude of Una v0.1 (spec/14 §1, §3), imported into every module.
-- Signatures and contracts are normative. Bodies are placeholders that the type
-- checker never reads: the interpreter implements these functions (M7).
module prelude

--- An `Int` that is at least zero: an `Int` flows into `Nat` where the bound is proved
--- (`spec/14 §1`, `spec/03 §2`).
pub kind Nat = Int where it >= 0

--- Either `Some(value)`, which holds one value of `T`, or `None`, which holds none
--- (`spec/14 §1`).
pub kind Option[T] = Some(value: T) | None

--- Either `Ok(value)`, which holds the success value of `T`, or `Err(failure)`, which holds the
--- failure of `E` (`spec/14 §1`).
pub kind Result[T, E] = Ok(value: T) | Err(failure: E)

--- Why an operation of `Files` fails (`spec/14 §3`).
pub kind FileError = NotFound | Denied | Io

--- Why `Keys.hmac` fails: `UnknownKey`, a key name that the key file of the grant does not
--- hold (`spec/14 §3`, `spec/13 §5`).
pub kind KeyError = | UnknownKey

--- Writes lines to standard output: `print` writes the line and a newline. It accepts
--- `public` data (`spec/14 §3`).
pub capability Console
  op print(line: Text) -> Unit
    accepts public

--- Reads the time: `now` gives the milliseconds since the Unix epoch. It accepts `public`
--- data (`spec/14 §3`).
pub capability Clock
  op now() -> Int
    accepts public

--- Reads a process environment variable, as `internal` text. It accepts `public` data
--- (`spec/14 §3`).
pub capability Env
  op get(name: Text) -> Option[internal Text]
    accepts public

--- Reads and writes files, with paths relative to the prefix the grant fixes; each operation
--- can fail with `FileError` (`spec/14 §3`).
pub capability Files
  op read(path: Text) -> internal Text
    fails FileError
    accepts public
  op write(path: Text, content: Text) -> Unit
    fails FileError
    accepts internal

--- Computes an HMAC-SHA-256 with a named key of the grant's key file, as `internal` `Hashed`.
--- It accepts `public` for `key_name` and any label for `data`, whose label its result carries
--- (`spec/14 §3`, ADR 0039).
pub capability Keys
  op hmac(key_name: Text, data: Text) -> internal Hashed
    fails KeyError

--- The absolute value of `x` (`spec/14 §1`).
pub abs(x: Int) -> Int
  ensures result >= 0 and (result == x or result == -x)
=
  x

--- The smaller of `a` and `b`; in edition 0.2 and later, of any type with `Ord` (`spec/14 §1`,
--- `spec/20 §6`).
pub min(a: Int, b: Int) -> Int
  ensures result <= a and result <= b and (result == a or result == b)
=
  a

--- The larger of `a` and `b`; in edition 0.2 and later, of any type with `Ord` (`spec/14 §1`,
--- `spec/20 §6`).
pub max(a: Int, b: Int) -> Int
  ensures result >= a and result >= b and (result == a or result == b)
=
  a

--- Whether every character of `t` is an ASCII digit, so it holds of the empty text
--- (`spec/14 §1`).
pub is_digits(t: Text) -> Bool = true

--- Whether `t` starts with `prefix`, comparing Unicode scalar values (`spec/14 §1`).
pub starts_with(t: Text, prefix: Text) -> Bool = true

--- `t` without the Unicode whitespace at both ends (`spec/14 §1`).
pub trim(t: Text) -> Text
  ensures result.len <= t.len
=
  t

--- `Some` of the integer that `t` writes when `t` is an optional `-` followed by one or more
--- ASCII digits, leading zeros allowed, and `None` for any other text: the empty text, `"-"`, a
--- leading `+`, whitespace or digits outside ASCII. `Int` has no bound, so a long text of digits
--- is never `None` for its length (`spec/14 §1`).
pub to_int(t: Text) -> Option[Int] = None

--- Whether `xs` has no elements (`spec/14 §1`).
pub is_empty[T](xs: List[T]) -> Bool
  ensures result == (xs.len == 0)
=
  true

--- `Some` of the element at position 0, and `None` exactly when `xs` is empty (`spec/14 §1`).
pub first[T](xs: List[T]) -> Option[T]
  ensures (result is None) == (xs.len == 0)
=
  None

--- `Some` of the element at position `index`, counted from 0, and `None` exactly when `index`
--- is below `0` or at least `xs.len`; it never fails (`spec/14 §1`).
pub at[T](xs: List[T], index: Int) -> Option[T]
  ensures (result is None) == (index < 0 or index >= xs.len)
=
  None

--- `xs` with `item` added after its last element (`spec/14 §1`).
pub append[T](xs: List[T], item: T) -> List[T]
  ensures result.len == xs.len + 1
=
  xs

--- Compares structurally; in edition 0.2 and later, over any type with `Eq` (`spec/14 §1`,
--- `spec/20 §6`).
pub contains[T](xs: List[T], item: T) -> Bool = true

--- The list of `each(x)` for each element `x` of `xs`, in the order of `xs`; `each` is called
--- from the first element to the last, at most once per element. In edition 0.2 and later it
--- takes an effectful and failing `each`, and stops at the first failure (`spec/14 §1`).
pub map[T, U](xs: List[T], each: fn(T) -> U) -> List[U]
  ensures result.len == xs.len
=
  []

--- The elements `x` of `xs` for which `keep(x)` is `true`, in the order of `xs`; `keep` is
--- called from the first element to the last, at most once per element. In edition 0.2 and
--- later it takes an effectful and failing `keep`, and stops at the first failure
--- (`spec/14 §1`).
pub filter[T](xs: List[T], keep: fn(T) -> Bool) -> List[T]
  ensures result.len <= xs.len
=
  xs

--- `Some` of the first element `x` of `xs` for which `keep(x)` is `true`, and `None` when there
--- is none; `keep` is called from the first element up to that one, at most once per element,
--- and not after it. In
--- edition 0.2 and later it takes an effectful and failing `keep`, and stops at the first
--- failure (`spec/14 §1`).
pub first_where[T](xs: List[T], keep: fn(T) -> Bool) -> Option[T] = None

--- Starts from `initial` and, for each element `x` of `xs` from the first to the last, replaces
--- the accumulator `acc` by `step(acc, x)`, calling `step` at most once per element; the result
--- is the last accumulator, `initial` when `xs` is empty. In edition 0.2 and later it takes an
--- effectful and failing `step`, and stops at the first failure (`spec/14 §1`).
pub fold[T, U](xs: List[T], initial: U, step: fn(U, T) -> U) -> U = initial

--- The exact sum of the elements as an `Int`, `0` when `xs` is empty; `Int` has no bound, so it
--- never overflows. In edition 0.2 and later it takes any integer type and adds the values as
--- `Int` (`spec/14 §1`, `spec/20 §6`).
pub sum(xs: List[Int]) -> Int = 0

--- Whether `o` is `Some` (`spec/14 §1`).
pub is_some[T](o: Option[T]) -> Bool
  ensures result == (o is Some)
=
  true

--- The value `v` when `o` is `Some(v)`, and `default` when `o` is `None`; `default` is an
--- argument like any other, evaluated before the call (`spec/14 §1`).
pub or_else[T](o: Option[T], default: T) -> T = default

--- Whether `r` is `Ok` (`spec/14 §1`).
pub is_ok[T, E](r: Result[T, E]) -> Bool
  ensures result == (r is Ok)
=
  true
