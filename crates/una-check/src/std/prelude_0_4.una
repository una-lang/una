pub dense_tensor_contract[T](t: Tensor[T], with_: Tensor[T], axis: Int, other: Int) -> Tensor[T]
  requires 0 <= axis and axis < t.rank and 0 <= other and other < with_.rank
  requires t.dim(axis: axis) == with_.dim(axis: other)
  requires 3 <= t.rank + with_.rank and t.rank + with_.rank <= 10
  ensures result.rank == t.rank + with_.rank - 2
  ensures (axis > 0 implies result.dim(axis: 0) == t.dim(axis: 0)) and (axis <= 0 and 0 < t.rank - 1 implies result.dim(axis: 0) == t.dim(axis: 1))
  ensures (t.rank - 1 <= 0 and 0 < t.rank - 1 + other implies result.dim(axis: 0) == with_.dim(axis: 0 - t.rank + 1)) and (t.rank - 1 + other <= 0 implies result.dim(axis: 0) == with_.dim(axis: 0 - t.rank + 2))
  ensures (axis > 1 implies result.dim(axis: 1) == t.dim(axis: 1)) and (axis <= 1 and 1 < t.rank - 1 implies result.dim(axis: 1) == t.dim(axis: 2))
  ensures (t.rank - 1 <= 1 and 1 < t.rank - 1 + other implies result.dim(axis: 1) == with_.dim(axis: 1 - t.rank + 1)) and (t.rank - 1 + other <= 1 implies result.dim(axis: 1) == with_.dim(axis: 1 - t.rank + 2))
  ensures (axis > 2 implies result.dim(axis: 2) == t.dim(axis: 2)) and (axis <= 2 and 2 < t.rank - 1 implies result.dim(axis: 2) == t.dim(axis: 3))
  ensures (t.rank - 1 <= 2 and 2 < t.rank - 1 + other implies result.dim(axis: 2) == with_.dim(axis: 2 - t.rank + 1)) and (t.rank - 1 + other <= 2 implies result.dim(axis: 2) == with_.dim(axis: 2 - t.rank + 2))
  ensures (axis > 3 implies result.dim(axis: 3) == t.dim(axis: 3)) and (axis <= 3 and 3 < t.rank - 1 implies result.dim(axis: 3) == t.dim(axis: 4))
  ensures (t.rank - 1 <= 3 and 3 < t.rank - 1 + other implies result.dim(axis: 3) == with_.dim(axis: 3 - t.rank + 1)) and (t.rank - 1 + other <= 3 implies result.dim(axis: 3) == with_.dim(axis: 3 - t.rank + 2))
  ensures (axis > 4 implies result.dim(axis: 4) == t.dim(axis: 4)) and (axis <= 4 and 4 < t.rank - 1 implies result.dim(axis: 4) == t.dim(axis: 5))
  ensures (t.rank - 1 <= 4 and 4 < t.rank - 1 + other implies result.dim(axis: 4) == with_.dim(axis: 4 - t.rank + 1)) and (t.rank - 1 + other <= 4 implies result.dim(axis: 4) == with_.dim(axis: 4 - t.rank + 2))
  ensures (axis > 5 implies result.dim(axis: 5) == t.dim(axis: 5)) and (axis <= 5 and 5 < t.rank - 1 implies result.dim(axis: 5) == t.dim(axis: 6))
  ensures (t.rank - 1 <= 5 and 5 < t.rank - 1 + other implies result.dim(axis: 5) == with_.dim(axis: 5 - t.rank + 1)) and (t.rank - 1 + other <= 5 implies result.dim(axis: 5) == with_.dim(axis: 5 - t.rank + 2))
  ensures (axis > 6 implies result.dim(axis: 6) == t.dim(axis: 6)) and (axis <= 6 and 6 < t.rank - 1 implies result.dim(axis: 6) == t.dim(axis: 7))
  ensures (t.rank - 1 <= 6 and 6 < t.rank - 1 + other implies result.dim(axis: 6) == with_.dim(axis: 6 - t.rank + 1)) and (t.rank - 1 + other <= 6 implies result.dim(axis: 6) == with_.dim(axis: 6 - t.rank + 2))
  ensures (axis > 7 implies result.dim(axis: 7) == t.dim(axis: 7)) and (axis <= 7 and 7 < t.rank - 1 implies result.dim(axis: 7) == t.dim(axis: 8))
  ensures (t.rank - 1 <= 7 and 7 < t.rank - 1 + other implies result.dim(axis: 7) == with_.dim(axis: 7 - t.rank + 1)) and (t.rank - 1 + other <= 7 implies result.dim(axis: 7) == with_.dim(axis: 7 - t.rank + 2))
=
  dense_tensor_contract(t, with: with_, axis: axis, other: other)
