pub dense_tensor_filled_4[T](shape_0: Int, shape_1: Int, shape_2: Int, shape_3: Int, value: T) -> Tensor[T]
  requires shape_0 >= 0 and shape_1 >= 0 and shape_2 >= 0 and shape_3 >= 0
