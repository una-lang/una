module pantry.stock

--- How an item is measured.
pub kind Measure = Grams | Pieces | Milliliters

--- A shelf label, as printed on the shelf.
pub kind Label = Text

pub kind Item
  name: Text
  amount: Nat
  measure: Measure

--- A labeled group of anything: a shelf of items, a box of jars.
pub kind Bin[T]
  label: Label
  entries: List[T]

--- A list with at least one entry.
pub kind NonEmpty[T] = List[T] where it.len > 0

--- Adds `added` to an item.
pub restock(item: Item, added: Nat) -> Item
  ensures result.amount == item.amount + added
=
  Item(name: item.name, amount: item.amount + added, measure: item.measure)

--- Takes `used` from an item that has enough of it.
pub use_up(item: Item, used: Nat) -> Item
  requires used <= item.amount
  ensures result.amount == item.amount - used
=
  Item(name: item.name, amount: item.amount - used, measure: item.measure)

--- The items that have run out.
pub missing(items: List[Item]) -> List[Item]
  ensures result.len <= items.len
=
  items.filter(keep: fn(i) -> i.amount == 0)

--- The names of the items to buy, in pantry order.
pub shopping_list(items: List[Item]) -> List[Text]
  ensures result.len <= items.len
=
  missing(items).map(each: fn(i) -> i.name)

--- How much of one measure the pantry holds.
pub total(items: List[Item], measure: Measure) -> Int = items.fold(initial: 0, step: fn(sum, i) -> if i.measure == measure then sum + i.amount else sum)

--- The item called `name`, when the pantry has it.
pub find(items: List[Item], name: Text) -> Option[Item] = items.first_where(keep: fn(i) -> i.name == name)

--- The amount left of `name`, zero when the pantry has none.
pub amount_of(items: List[Item], name: Text) -> Nat
=
  when find(items, name)
    is Some(item) -> item.amount
    is None -> 0

--- How many entries of a bin satisfy `keep`.
pub count_where[T](bin: Bin[T], keep: fn(T) -> Bool) -> Nat
  ensures result <= bin.entries.len
=
  bin.entries.filter(keep).len

--- The average of some counts, rounded down.
pub average(counts: NonEmpty[Int]) -> Int = counts.sum() / counts.len

example "restocking adds to the amount"
  do restock(Item(name: "rice", amount: 200, measure: Grams), added: 300)
  expect result.amount == 500

example "using up takes from the amount"
  do use_up(Item(name: "eggs", amount: 6, measure: Pieces), used: 4)
  expect result.amount == 2

example "the shopping list names what ran out"
  do shopping_list([Item(name: "rice", amount: 0, measure: Grams), Item(name: "eggs", amount: 6, measure: Pieces), Item(name: "oil", amount: 0, measure: Milliliters)])
  expect result == ["rice", "oil"]

example "totals count one measure only"
  do total([Item(name: "rice", amount: 500, measure: Grams), Item(name: "flour", amount: 200, measure: Grams), Item(name: "eggs", amount: 6, measure: Pieces)], measure: Grams)
  expect result == 700

example "an item the pantry does not have amounts to zero"
  do amount_of([Item(name: "eggs", amount: 6, measure: Pieces)], name: "milk")
  expect result == 0

example "a bin counts the entries that match"
  do count_where(Bin(label: "jars", entries: [3, 0, 5]), keep: fn(n) -> n > 0)
  expect result == 2

example "the average of three counts is rounded down"
  do average([2, 4, 10])
  expect result == 5
