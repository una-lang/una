module events.main

import events.seating (Event, availability, clamp_seats)

pub main() -> Unit
  uses @console: Console[print]
=
  let event = Event(name: "Launch", remaining: clamp_seats(820))
  let status = availability(event)
  let label = when status
    is SoldOut -> "sold out"
    is Few -> "few seats left"
    is Open -> "open"
  @console.print("availability of {event.name}: {label}")
