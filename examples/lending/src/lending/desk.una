module lending.desk

import lending.loans (Day, LendError, Loan, LoanDays, Member, Shelf, Tool, can_borrow, lend, shelf_with)

--- Lends from the main shelf, or from the backup shelf when the main one cannot.
pub lend_anywhere(member: Member, name: Text, today: Day, days: LoanDays) -> Loan
  requires can_borrow(member)
  ensures result.due == today + days
  uses @main_shelf: Shelf[pick]
  uses @backup_shelf: Shelf[pick]
  fails LendError
=
  let first_try = attempt lend(member, name, today, days) with @shelf = @main_shelf
  when first_try
    is Ok(loan) -> loan
    is Err ->
      lend(member, name, today, days) with @shelf = @backup_shelf
        if error pass

example "the backup shelf lends what the main shelf lacks"
  given @main_shelf = shelf_with(tools: [])
  given @backup_shelf = shelf_with(tools: [Tool(name: "saw", deposit: 15)])
  do lend_anywhere(Member(name: "Bo", holding: 2), name: "saw", today: 10, days: 3)
  expect result.tool.name == "saw"
  expect result.due == 13
  expect performed @backup_shelf.pick

example "the main shelf is tried first"
  given @main_shelf = shelf_with(tools: [Tool(name: "drill", deposit: 20)])
  given @backup_shelf = shelf_with(tools: [])
  do lend_anywhere(Member(name: "Ana", holding: 0), name: "drill", today: 10, days: 3)
  expect result.tool.name == "drill"
  expect not performed @backup_shelf.pick
