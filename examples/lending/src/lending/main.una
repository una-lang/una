module lending.main

import lending.loans (LendError, Member, Tool, late_days, lend, shelf_with)

--- The tools of the community shelf.
catalog() -> List[Tool] = [Tool(name: "drill", deposit: 20), Tool(name: "ladder", deposit: 35), Tool(name: "saw", deposit: 15)]

pub main() -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
  fails LendError
=
  let now = @clock.now()
  let today = now / 86_400_000
  let loan = lend(Member(name: "Ana", holding: 0), name: "ladder", today, days: 14) with @shelf = shelf_with(tools: catalog())
    if error pass
  @console.print("{loan.member.name} borrowed the {loan.tool.name} for 14 days")
  let late = late_days(loan, today: today + 20)
  @console.print("returned 20 days later, it is {late} days late")
