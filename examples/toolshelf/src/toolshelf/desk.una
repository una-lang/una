module toolshelf.desk

import toolshelf.tools (Checkout, CheckoutError, Day, KeepDays, Member, Shelf, Tool, can_check_out, check_out, shelf_with)

--- Checks out from the main shelf, or from the backup shelf when the main one cannot.
pub check_out_anywhere(member: Member, name: Text, today: Day, days: KeepDays) -> Checkout
  requires can_check_out(member)
  ensures result.due == today + days
  uses @main_shelf: Shelf[pick]
  uses @backup_shelf: Shelf[pick]
  fails CheckoutError
=
  let first_try = attempt check_out(member, name, today, days) with @shelf = @main_shelf
  when first_try
    is Ok(checkout) -> checkout
    is Err ->
      check_out(member, name, today, days) with @shelf = @backup_shelf
        if error pass

example "the backup shelf has what the main shelf lacks"
  given @main_shelf = shelf_with(tools: [])
  given @backup_shelf = shelf_with(tools: [Tool(name: "saw", deposit: 15)])
  do check_out_anywhere(Member(name: "Bo", holding: 2), name: "saw", today: 10, days: 3)
  expect result.tool.name == "saw"
  expect result.due == 13
  expect performed @backup_shelf.pick

example "the main shelf is tried first"
  given @main_shelf = shelf_with(tools: [Tool(name: "drill", deposit: 20)])
  given @backup_shelf = shelf_with(tools: [])
  do check_out_anywhere(Member(name: "Ana", holding: 0), name: "drill", today: 10, days: 3)
  expect result.tool.name == "drill"
  expect not performed @backup_shelf.pick
