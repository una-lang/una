declassifies nothing. -/
def b1Bad : String := r#"{"schema": "una.core/1", "edition": "0.2", "complete": true, "modules": [{"path": "m", "decls": [{"kind": "fun", "value": {"name": "check", "type_params": [], "constraints": [], "params": [["x", {"kind": "base", "base": {"kind": "int"}, "label": {"level": "secret", "categories": [], "symbols": []}}]], "result": {"kind": "base", "base": {"kind": "bool"}, "label": {"level": "public", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "let", "name": "r", "ty": {"kind": "base", "base": {"kind": "bool"}, "label": {"level": "secret", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "prim", "prim": {"kind": "eq"}, "args": [{"kind": "var", "value": "x"}, {"kind": "int", "value": "1234"}]}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "r"}}}}}, {"kind": "policy", "name": "reveal", "from": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "secret", "categories": [], "symbols": []}}, "to": {"kind": "base", "base": {"kind": "named", "module": "prelude", "name": "List", "args": [{"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}]}, "label": {"level": "public", "categories": [], "symbols": []}}, "via": {"module": "m", "name": "check"}}, {"kind": "fun", "value": {"name": "rev", "type_params": [], "constraints": [], "params": [["s", {"kind": "base", "base": {"kind": "int"}, "label": {"level": "secret", "categories": [], "symbols": []}}]], "result": {"kind": "base", "base": {"kind": "bool"}, "label": {"level": "public", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "let", "name": "b", "ty": {"kind": "base", "base": {"kind": "bool"}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "declassify", "policy": {"module": "m", "name": "reveal"}, "via": {"module": "m", "name": "check"}, "arg": {"kind": "var", "val