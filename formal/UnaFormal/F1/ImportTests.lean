/-- What the reverse mode says of `decl` in `doc`. -/
def reverseRun (doc : String) (decl : String) : String :=
  match Lean.Json.parse doc >>= checkRejected with
  | .ok out => match List.lookup decl out with
    | some (.modelAcceptsCandidate _) => "model-accepts-candidate"
    | some (.modelRejects _) => "model-rejects"
    | some (.notRechecked _) => "not-re-checked"
    | none => "missing"
  | .error e => s!"error: {e}"

