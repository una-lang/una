#guard ["m.rev", "m.public_caller", "m.other"].all (run b1Bad · == "not re-checked")

/-- The review of #452 (Una-1): `helper` declassifies inside a lambda it applies, and `caller`
calls `helper` under a `secret` condition. -/
def una1Repro : String := r#"{"schema": "una.core/1", "edition": "0.2", "complete": true, "modules": [{"path": "rel", "decls": [{"kind": "fun", "value": {"name": "shown", "type_params": [], "constraints": [], "params": [["x", {"kind": "base", "base": {"kind": "int"}, "label": {"level": "internal", "categories": [], "symbols": []}}]], "result": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "atom", "atom": {"kind": "var", "value": "x"}}}}, {"kind": "policy", "name": "reveal", "from": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "internal", "categories": [], "symbols": []}}, "to": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "via": {"module": "rel", "name": "shown"}}]}, {"path": "m", "decls": [{"kind": "fun", "value": {"name": "helper", "type_params": [], "constraints": [], "params": [["x", {"kind": "base", "base": {"kind": "int"}, "label": {"level": "internal", "categories": [], "symbols": []}}]], "result": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "let", "name": "f", "ty": {"kind": "fn", "params": [{"kind": "base", "base": {"kind": "int"}, "label": {"level": "internal", "categories": [], "symbols": []}}], "result": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "uses": [], "fails": null, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "lambda", "params": [["y", {"kind": "base", "base": {"kind": "int"}, "label": {"level": "internal", "categories": [], "symbols": []}}]], "body": {"kind": "let", "name": "r", "ty": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "declassify", "policy": {"module": "rel", "name": "reveal"}, "via": {"module": "rel", "name": "shown"}, "arg": {"kind": "var", "value": "y"}}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "r"}}}, "function": null}}, "body": {"kind": "let", "name": "z", "ty": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "apply", "callee": {"kind": "var", "value": "f"}, "args": [{"kind": "var", "value": "x"}]}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "z"}}}}}}, {"kind": "fun", "value": {"name": "caller", "type_params": [], "constraints": [], "params": [["flag", {"kind": "base", "base": {"kind": "bool"}, "label": {"level": "secret", "categories": [], "symbols": []}}], ["x", {"kind": "base", "base": {"kind": "int"}, "label": {"level": "internal", "categories": [], "symbols": []}}]], "result": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "secret", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "if", "cond": {"kind": "var", "value": "flag"}, "then": {"kind": "let", "name": "a", "ty": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "call", "function": {"module": "m", "name": "helper"}, "type_args": [], "args": [{"kind": "var", "value": "x"}]}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "a"}}}, "otherwise": {"kind": "atom", "atom": {"kind": "int", "value": "0"}}}}}]}], "library": [], "host": []}"#

-- The release inside the lambda is counted in `helper`'s release set, so `caller` is not
-- accepted: it would have no theorem behind it.
#guard run una1Repro "m.helper" == "not re-checked"
#guard run una1Repro "m.caller" == "not re-checked"

/-- `user` calls `odd`, which is outside F1. -/
def reachNonF1 : String := r#"{"schema": "una.core/1", "edition": "0.2", "complete": true, "modules": [{"path": "m", "decls": [{"kind": "fun", "value": {"name": "odd", "type_params": [], "constraints": [], "params": [], "result": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "let", "name": "t", "ty": {"kind": "base", "base": {"kind": "tuple", "values": []}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "tuple", "value": []}}, "body": {"kind": "atom", "atom": {"kind": "int", "value": "1"}}}}}, {"kind": "fun", "value": {"name": "user", "type_params": [], "constraints": [], "params": [], "result": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "let", "name": "a", "ty": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "call", "function": {"module": "m", "name": "odd"}, "type_args": [], "args": []}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "a"}}}}}]}], "library": [], "host": []}"#

