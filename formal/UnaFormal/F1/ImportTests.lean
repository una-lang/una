": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "declassify", "policy": {"module": "rel", "name": "reveal"}, "via": {"module": "rel", "name": "shown"}, "arg": {"kind": "var", "value": "y"}}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "r"}}}, "function": null}}, "body": {"kind": "let", "name": "z", "ty": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "apply", "callee": {"kind": "var", "value": "f"}, "args": [{"kind": "var", "value": "x"}]}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "z"}}}}, "uses_of": [], "fails_of": null, "result_labels": [], "of_raises": []}}, {"kind": "fun", "value": {"name": "caller", "type_params": [], "constraints": [], "params": [["flag", {"kind": "base", "base": {"kind": "bool"}, "label": {"level": "secret", "categories": [], "symbols": []}}], ["x", {"kind": "base", "base": {"kind": "int"}, "label": {"level": "internal", "categories": [], "symbols": []}}]], "result": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "secret", "categories": [], "symbols": []}}, "uses": [], "fails": null, "error": null, "body": {"kind": "if", "cond": {"kind": "var", "value": "flag"}, "then": {"kind": "let", "name": "a", "ty": {"kind": "base", "base": {"kind": "int"}, "label": {"level": "public", "categories": [], "symbols": []}}, "value": {"kind": "rhs", "value": {"kind": "call", "function": {"module": "m", "name": "helper"}, "type_args": [], "args": [{"kind": "var", "value": "x"}]}}, "body": {"kind": "atom", "atom": {"kind": "var", "value": "a"}}}, "otherwise": {"kind": "atom", "atom": {"kind": "int", "value": "0"}}}, "uses_of": [], "fails_of": null, "result_labels": [], "of_raises": []}}]}], "library": [], "host": []}"#

