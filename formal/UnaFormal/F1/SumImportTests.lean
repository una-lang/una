-- a failure with a payload, its secret field from a secret argument.
#guard run sums "m.boom" == "accepted"
-- P2: a secret field of the failure read into `print` after `attempt`.
#guard run sums "m.att_leak" == "rejected"
-- its public twin: the public field.
#guard run sums "m.att_ok" == "accepted"
-- P2: a secret field read into `print` by a handler.
#guard run sums "m.h_leak" == "rejected"
-- its public twin.
#guard run sums "m.h_ok" == "accepted"
-- P3: a variant chosen by a secret, by T-Fail's public program counter.
#guard run sums "m.choice" == "rejected"
-- its public twin.
#guard run sums "m.choice_pub" == "accepted"
-- S1: a `when` of three arms on a secret sum, the print in the third arm.
#guard run sums "m.third" == "rejected"
-- its public twin: exhaustive, so the chain ends in `unreachable`.
#guard run sums "m.third_pub" == "accepted"
-- an arm missing, with no `otherwise`: the importer's own check.
#guard run sums "m.missing" == "not re-checked"
-- a variant twice.
#guard run sums "m.dup" == "not re-checked"
-- one arm and an `otherwise`.
#guard run sums "m.other_arm" == "accepted"
-- a sum where a record is expected: a lookup miss, never a default.
#guard run sums "m.as_record" == "not re-checked"
-- a generic sum.
#guard run sums "m.generic" == "not re-checked"
-- `==` on a sum, which F1 does not model.
#guard run sums "m.eq_sum" == "not re-checked"
-- a kind with a field, flagged `record: false`: a sum of one variant.
#guard run sums "m.w_use" == "accepted"
-- a code kind at `fail`.
#guard run sums "m.c_fail" == "accepted"
-- the same kind at `attempt`, as a code.
#guard run sums "m.c_attempt" == "accepted"
-- and at a handler, as a code.
#guard run sums "m.c_handle" == "accepted"
-- a handler of a code that reads it, as before #512.
#guard run sums "m.c_handle_read" == "not re-checked"
-- a payload kind's variant without fields at `fail`: a `raise`.
#guard run sums "m.p_fail" == "accepted"
-- the same kind at `attempt`, as a payload kind.
#guard run sums "m.p_attempt" == "accepted"
-- and at a handler, as a payload kind.
#guard run sums "m.p_handle" == "accepted"

#guard ["m.check", "m.rev", "m.other"].all (run viaPayload · == "not re-checked")

/-- The body of `third_pub`, as the export writes it. -/
def thirdBody : String := r#"{"kind":"case","scrutinee":{"kind":"var","value":"x"},"arms":[{"ctor":{"kind":{"module":"m","name":"Shape"},"name":"Circle","index":0},"binds":[null],"body":{"kind":"atom","atom":{"kind":"unit"}}},{"ctor":{"kind":{"module":"m","name":"Shape"},"name":"Square","index":1},"binds":[],"body":{"kind":"atom","atom":{"kind":"unit"}}},{"ctor":{"kind":{"module":"m","name":"Shape"},"name":"Tri","index":2},"binds":[null],"body":{"kind":"let","name":"%u","ty":{"kind":"base","base":{"kind":"unit"},"label":{"level":"public","categories":[],"symbols":[]}},"value":{"kind":"rhs","value":{"kind":"op","cap":"console","capability":"Console","capability_path":{"module":"std.host","name":"Console"},"op":"print","args":[{"kind":"text","value":"t"}],"labels":[{"level":"public","categories":[],"symbols":[]}]}},"body":{"kind":"atom","atom":{"kind":"unit"}},"written":false}}],"otherwise":null}"#

/-- `Shape`, as the reading gives its shape: one field, none, one. -/
def shapeCtx : Ctx := { records := [], funs := [], sums := [("m.Shape", [1, 0, 1])] }

def shapeProg : Program :=
  mkProgram [] Label.bot {} [] [] [] [⟨"m.Shape", [[.int .bot], [], [.int .bot]], Label.bot⟩]

/-- The reading of `third_pub`'s body: a chain of three tests, the last `else` `unreachable`. -/
def thirdRead : Option Expr :=
  match Lean.Json.parse thirdBody with
  | .ok j => (plainRun (expr shapeCtx j)).toOption
  | .error _ => none

#guard match thirdRead with
  | some (.caseSum _ 0 _ _ (.caseSum _ 1 _ _ (.caseSum _ 2 _ _ .unreachable))) => true
  | _ => false

/-- **The exhaustive chain runs to a value on every variant, never `aborted`**. -/
def runsOn (v : Val) : Bool :=
  match thirdRead with
  | some e =>
    match (eval Host.unit 50 shapeProg ⟨(), (), fun _ => none⟩ [("x", v)] e).2.1 with
    | .ok _ => true
    | _ => false
  | none => false

#guard [.variant "m.Shape" 0 [.int 1], .variant "m.Shape" 1 [], .variant "m.Shape" 2 [.int 7]].all runsOn

end Una.F1.SumImportTests
