module m

pub capability Vault
  op note(x: Int) -> Unit
    accepts secret

handler quiet() for Vault
  op note(x) = unit

handler tally() for Vault
  op note(x) = unit

pub kind Shut = | Closed

pub capability Door
  op open(code: Int) -> Int
    fails Shut
    accepts secret

handler failing() for Door
  op open(code) = fail Closed

handler fine() for Door
  op open(code) = 0

work(n: Int) -> Unit
  uses @vault: Vault[note]
=
  @vault.note(n)

pub guarded(flag: secret Bool) -> Unit
=
  if flag
    work(1) with @vault = quiet()
  else
    unit

branch(flag: secret Bool) -> Unit
  uses @vault: Vault[note]
=
  if flag
    @vault.note(1)
  else
    unit

pub reach(flag: secret Bool) -> Unit
=
  branch(flag) with @vault = quiet()

pub pick(flag: Bool) -> Unit
=
  if flag
    work(1) with @vault = quiet()
  else
    work(2) with @vault = tally()

open_door() -> Int
  uses @door: Door[open]
  fails Shut
=
  let v = @door.open(1)
    if error pass
  v

pub run(flag: secret Bool) -> secret Int
  fails Shut
=
  if flag
    let a = open_door() with @door = failing()
      if error pass
    a
  else
    let b = open_door() with @door = fine()
      if error pass
    b

pub capability Bell
  op ring(n: Int) -> Unit
    accepts public

handler noisy() for Bell
  uses @console: Console[print]
  op ring(n) = @console.print("ring")

chime() -> Unit
  uses @bell: Bell[ring]
=
  @bell.ring(1)

pub chime_secret(flag: secret Bool) -> Unit
  uses @console: Console[print]
=
  if flag
    chime() with @bell = noisy()
  else
    unit

pub chime_public() -> Unit
  uses @console: Console[print]
=
  chime() with @bell = noisy()

pub capability Gong
  op strike(n: Int) -> Unit
    accepts public

handler soft() for Gong
  op strike(n) = unit

handler hard() for Gong
  uses @console: Console[print]
  op strike(n) = @console.print("gong")

strike_it() -> Unit
  uses @gong: Gong[strike]
=
  @gong.strike(1)

pub pick_gong(flag: Bool) -> Unit
  uses @console: Console[print]
=
  if flag
    strike_it() with @gong = soft()
  else
    strike_it() with @gong = hard()

pub put_one(m: Map[Int, Int]) -> Map[Int, Int] = m.with(key: 1, value: 2)
