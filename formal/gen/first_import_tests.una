module m

pub capability Log
  op write(line: Text) -> Unit

pub head_public(xs: List[Int]) -> Option[Int] = xs.first()

pub top_secret(xs: secret List[Text]) -> Unit
  uses @log: Log[write]
=
  let h = xs.first()
  when h
    is Some(x) -> @log.write("some")
    is None -> unit

pub head_read(xs: List[secret Text]) -> Unit
  uses @log: Log[write]
=
  let h = xs.first()
  when h
    is Some(x) -> @log.write(x)
    is None -> unit

pub presence(xs: List[secret Text]) -> Unit
  uses @log: Log[write]
=
  let h = xs.first()
  when h
    is Some(x) -> @log.write("some")
    is None -> unit

pub text_lt(a: Text, b: Text) -> Bool = a < b

pub text_gt(a: Text, b: Text) -> Bool = a > b

pub text_le(a: Text, b: Text) -> Bool = a <= b

pub text_ge(a: Text, b: Text) -> Bool = a >= b

pub int_lt(a: Int, b: Int) -> Bool = a < b
