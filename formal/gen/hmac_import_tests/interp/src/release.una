trusted module release

pub policy key_of
  from secret Text
  to internal Hashed
  via hmac_it
  purpose "a keyed hash of the text"
  owner privacy

hmac_it(t: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: "pepper{t.len}", data: t)
    if error pass
