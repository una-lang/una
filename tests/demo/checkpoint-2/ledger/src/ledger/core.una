module ledger.core

pub kind LedgerError = | Unavailable

pub capability Journal
  op append(line: Text) -> Unit
    fails LedgerError

--- Records an amount and returns it.
record(amount: Int) -> Int
=
  @journal.append("amount {amount}")
    if error pass
  amount

--- Records every amount and returns their total.
pub total(amounts: List[Int]) -> Int
  uses @journal: Journal[append]
  fails LedgerError
=
  let first = record(amounts.first().or_else(default: 0))
    if error pass
  first
