module clean

pub kind StoreError = Timeout | Corrupted

pub capability Store
  op find(key: Int) -> Option[Text]
    fails StoreError

handler cached() for Store
  op find(key) = Some("stored")

pub describe(key: Int) -> Text
  uses @store: Store[find]
=
  let found = @store.find(key)
    if error use None
  found.or_else(default: "missing")

example "a stored key is described"
  given @store = cached()
  do describe(1)
  expect result == "stored"
