module srv

import std.host (HttpServer, Reply, ServeError)

--- After `close`, `next` fails with `Closed`, a request read and not delivered is answered `503`,
--- and the exchange open finishes (`spec/31 §1` rule 2).
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
  uses @console: Console[print]
=
  let first = attempt @server.next()
  @server.close()
  let after = attempt @server.next()
  let said = when after
    is Err(failure) ->
      when failure
        is Closed -> "closed"
        is Interrupted -> "interrupted"
        is TimedOut -> "timed out"
        is NotHeld -> "not held"
        is BadReply -> "bad reply"
    is Ok(exchange) -> "delivered"
  @console.print(said)
  let answered = when first
    is Ok(one) ->
      @server.reply(to: one.right, reply: Reply(status: 200, headers: [], body: "finished"))
        if error use unit
    is Err(failure) -> unit
  unit
