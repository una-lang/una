module srv

import std.host (Exchange, HttpServer, Reply)

--- Never answers: the task ends holding every right its captures reached.
forget_all(pending: List[internal Exchange]) -> Unit = unit

--- Answers the exchange that a function value gives, whose closure holds it.
later(exchange: fn() -> internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  let held = exchange()
  @server.reply(to: held.right, reply: Reply(status: 200, headers: [], body: "through a closure"))
    if error use unit

--- Starts tasks over a list of exchanges and over a function value that captured one: `start`
--- moves the rights its captures reach, closures included (`spec/31 §1` rule 3 item 2), so the
--- first task's end answers both of its rights `500` and the second task answers its own.
handle(one: internal Exchange, two: internal Exchange, three: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  let answer = fn() -> three
  tasks
    start forget_all([one, two])
    start later(answer)
    @server.reply(to: one.right, reply: Reply(status: 200, headers: [], body: "moved"))
      if error use unit

pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  let first = attempt @server.next()
  let second = attempt @server.next()
  let third = attempt @server.next()
  let handled = when first
    is Ok(one) ->
      when second
        is Ok(two) ->
          when third
            is Ok(three) -> handle(one, two, three)
            is Err(failure) -> unit
        is Err(failure) -> unit
    is Err(failure) -> unit
  @server.close()
