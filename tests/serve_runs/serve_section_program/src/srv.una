module srv

import std.host (Exchange, HttpServer, Reply, Request)

--- Answers `GET /health` with 200, and every other request with 404.
pub handle(request: internal Request) -> internal Reply
=
  if request.method is Get and request.segments == ["health"]
    Reply(status: 200, headers: [], body: "ok")
  else
    Reply(status: 404, headers: [], body: "")

--- Says that the server stopped, after every request drained.
pub on_stop() -> Unit
  uses @console: Console[print]
=
  @console.print("stopped")

--- `answer` of the program of `spec/31 §7` rule 4.
answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  let reply = handle(exchange.request)
  @server.reply(to: exchange.right, reply: reply)
    if error use unit

--- The program of `spec/31 §7` rule 4, which the driver of `serve_section_health` runs as
--- engine code: its trace and its bytes must be the driver's.
pub main() -> Unit
  uses @server: HttpServer[next, reply]
  uses @console: Console[print]
  diverges
=
  tasks
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange)
        is Err(failure) -> unit
  on_stop()
