module srv

import std.host (Exchange, HttpServer, Reply, Request)

--- Answers every request with a `204` that has a body, which `reply` refuses with `BadReply`:
--- the driver ignores the failure, and the end of the request's task answers `500`.
pub handle(request: internal Request) -> internal Reply = Reply(status: 204, headers: [],
  body: "not empty"
)

--- `answer` of the program of `spec/31 §7` rule 4.
answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  let reply = handle(exchange.request)
  @server.reply(to: exchange.right, reply: reply)
    if error use unit

--- The program of `spec/31 §7` rule 4, which the driver of `serve_section_bad_reply` runs as engine
--- code: its trace and its bytes must be the driver's.
pub main() -> Unit
  uses @server: HttpServer[next, reply]
  diverges
=
  tasks
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange)
        is Err(failure) -> unit
