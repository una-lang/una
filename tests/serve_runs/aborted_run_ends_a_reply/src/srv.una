module srv

import std.collections (empty_bit_set)
import std.host (Exchange, HttpServer, Reply, ServeError)

--- Counts.
busy(n: Int) -> Int
=
  var total = 0
  for i in 1..n
    total = total + 1
  total

--- Aborts the run after a count: a bit set of 2^64 bits is past every memory budget, so
--- `empty_bit_set` aborts with U6003 before it allocates (`spec/28 §9` rule 5).
bomb() -> Unit
  uses @console: Console[print]
=
  var big = 1
  for i in 1..2000
    big = big * 1000
  @console.print("aborting")
  const bits = empty_bit_set(size: 18446744073709551616)
  unit

--- Takes a request, counts, then replies.
replier(k: Int) -> Unit
  uses @server: HttpServer[next, reply]
=
  const got = attempt @server.next()
  when got
    is Ok(exchange) ->
      const n = busy(k)
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "replier"))
        if error use unit
    is Err(failure) -> unit

--- Takes a request, then aborts the run.
bomber() -> Unit
  uses @server: HttpServer[next, reply]
  uses @console: Console[print]
=
  const got = attempt @server.next()
  when got
    is Ok(exchange) -> bomb()
    is Err(failure) -> unit

--- A task replies right after a switch of tasks at its operation's check point, while another
--- task aborted the run meanwhile: the `reply` does not start, so nothing is sent after the
--- abort and the right gets the stopped task's `503` (`spec/27 §7`, ADR 0123 rules 4.5 and 4.7).
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
  uses @console: Console[print]
=
  tasks
    start replier(1022)
    start bomber()
  @server.close()
