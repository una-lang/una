module srv

import std.host (Exchange, HttpServer, Reply, Request)

pub kind Refused = | Busy(detail: Text)

--- Fails for every request, with a payload that no peer may see: the host answers `500` with
--- an empty body.
pub handle(request: internal Request) -> internal Reply
  fails Refused
=
  fail Busy(detail: "payload-never-sent")

--- `answer` of the program of `spec/31 §7` rule 4.
answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  let reply = handle(exchange.request)
    if error use Reply(status: 500, headers: [], body: "")
  @server.reply(to: exchange.right, reply: reply)
    if error use unit

--- The program of `spec/31 §7` rule 4, which the driver of `serve_section_failures` runs as engine
--- code: its trace and its bytes must be the driver's.
pub main() -> Unit
  uses @server: HttpServer[next, reply]
  diverges
=
  tasks
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange)
        is Err(failure) -> unit
