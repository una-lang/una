module srv

import std.host (Exchange, HttpServer, Reply, ServeError)

--- Waits for one request and answers it.
waiter() -> Unit
  uses @server: HttpServer[next, reply]
=
  let got = attempt @server.next()
  when got
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "the waiter"))
        if error use unit
    is Err(failure) -> unit

--- Counts long enough for the started task to run and wait in `next`.
busy(n: Int) -> Int
=
  let edit total = 0
  for i in 1..n
    total = total + 1
  total

--- The block fails while its task waits in `next`: the task is cancelled, its `next` ends
--- `interrupted` and takes no request, which a later `next` delivers (ADR 0123 rule 4.7).
serve_one() -> Unit
  uses @server: HttpServer[next, reply]
  fails ServeError
=
  tasks
    start waiter()
    let counted = busy(3000)
    fail Closed

pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  let served = attempt serve_one()
  let later = attempt @server.next()
  let answered = when later
    is Ok(exchange) ->
      @server.reply(to: exchange.right,
        reply: Reply(status: 200, headers: [], body: "a later next")
      )
        if error use unit
    is Err(failure) -> unit
  @server.close()
