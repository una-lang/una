module srv

import std.host (Exchange, HttpServer, Reply)

--- One worker of a pool: waits for one request and answers it.
worker(name: Text) -> Unit
  uses @server: HttpServer[next, reply]
=
  let got = attempt @server.next()
  when got
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "from {name}"))
        if error use unit
    is Err(failure) -> unit

--- Three workers wait in `next` at once: when every ready task waits there, the one that runs
--- blocks on the engine instead of handing the turn to another waiter, and the third worker's
--- `next` ends with the host stop (ADR 0123 rule 4.7, rule 18).
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  tasks
    start worker("a")
    start worker("b")
    start worker("c")
  @server.close()
