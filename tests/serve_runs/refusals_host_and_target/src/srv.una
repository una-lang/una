module srv

import std.host (Exchange, HttpServer, Reply)

--- Answers one request with the first segment of its path.
answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  let first = when exchange.request.segments.at(index: 0)
    is Some(segment) -> segment
    is None -> ""
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "hello {first}"))
    if error use unit

--- `Host` and the target: each request on its own connection from its own peer address is refused with its
--- status and `Connection: close` before the program sees it, its side shut, and its connection
--- closed; a valid request after them is answered (`spec/31 §3`, `§4`, ADR 0123 rules 8, 10 and 11).
--- `cases.txt` names each connection's request.
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
  uses @console: Console[print]
  diverges
=
  tasks at most 1000 at once
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange)
        is Err(failure) -> unit
    on stop
      @server.close()
  @console.print("stopped")
