module srv

import std.host (Exchange, HttpServer, Reply, ServeError)

answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "too late"))
    if error use unit

--- A `tasks` block that fails cancels the tasks it started: one cancelled while it holds a reply
--- right gets the host's `503` with `Retry-After: 1` (`spec/31 §1` rule 3 item 5).
serve_one() -> Unit
  uses @server: HttpServer[next, reply]
  fails ServeError
=
  let exchange = @server.next()
    if error pass
  tasks
    start answer(exchange)
    fail Closed

pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
  uses @console: Console[print]
=
  let served = attempt serve_one()
  let said = when served
    is Err(failure) -> "the block failed"
    is Ok(done) -> "served"
  @console.print(said)
  @server.close()
