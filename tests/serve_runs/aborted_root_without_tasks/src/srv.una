module srv

import std.collections (empty_bit_set)
import std.host (Exchange, HttpServer, Reply, ServeError)

--- Aborts the run after a count: a bit set of 2^64 bits is past every memory budget, so
--- `empty_bit_set` aborts with U6003 before it allocates (`spec/28 §9` rule 5).
bomb() -> Unit
=
  var big = 1
  for i in 1..2000
    big = big * 1000
  const bits = empty_bit_set(size: 18446744073709551616)
  unit

--- Answers `one`, then aborts holding `two`.
answer_one(one: internal Exchange, two: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: one.right, reply: Reply(status: 200, headers: [], body: "one"))
    if error use unit
  bomb()

--- The root holds two rights, answers one and aborts, with no task: the other gets the stopped
--- task's `503` (ADR 0123 rule 4.5), in both engines.
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  const first = attempt @server.next()
  const second = attempt @server.next()
  const answered = when first
    is Ok(one) ->
      when second
        is Ok(two) -> answer_one(one, two)
        is Err(failure) -> unit
    is Err(failure) -> unit
  @server.close()
