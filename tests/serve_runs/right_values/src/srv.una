module srv

import std.host (Exchange, HttpServer, Reply, ServeError)

--- What the request of `one` holds, and how its reply right compares, as text.
shown(one: internal Exchange, two: internal Exchange) -> internal Text
=
  let request = one.request
  let same = one.right == one.right
  let other = one.right == two.right
  "{request.method} {request.target} {request.segments} {request.params} {request.headers} {request.body} {request.peer} {request.listener} {one.right} {same} {other}"

--- Answers `one` with what it holds, and `two` with a word.
answer(one: internal Exchange, two: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: one.right, reply: Reply(status: 200, headers: [], body: shown(one, two)))
    if error use unit
  @server.reply(to: two.right, reply: Reply(status: 200, headers: [], body: "two"))
    if error use unit

--- A request's values as `next` builds them, and reply rights as values: `==` compares the
--- exchange each names, and interpolation writes `<reply-right>` (ADR 0123 rule 1, `spec/31
--- §1`), in both engines.
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  let first = attempt @server.next()
  let second = attempt @server.next()
  let answered = when first
    is Ok(one) ->
      when second
        is Ok(two) -> answer(one, two)
        is Err(failure) -> unit
    is Err(failure) -> unit
  @server.close()
