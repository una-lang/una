module srv

import std.host (Exchange, HttpServer, Reply, ServeError)

--- Answers `next` with `body`, or nothing when it failed.
answer(next: Result[internal Exchange, ServeError], body: Text) -> Unit
  uses @server: HttpServer[reply]
=
  when next
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: body))
        if error use unit
    is Err(failure) -> unit

--- The program holds the first exchange and waits for a second, which `/once` never delivers
--- while the first is open: the second request waits, the third finds `waiting` full and is
--- answered `503` at once; at the host stop the waiting one is answered `503`, and the first
--- drains (ADR 0123 rules 17 and 18, `spec/31 §6` rule 5).
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  let first = attempt @server.next()
  let second = attempt @server.next()
  answer(first, body: "first")
  answer(second, body: "second")
  @server.close()
