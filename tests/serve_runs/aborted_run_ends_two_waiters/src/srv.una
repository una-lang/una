module srv

import std.host (Exchange, HttpServer, Reply, ServeError)

--- Serves one request: whether `next` gave one.
serve_once(name: Text) -> Bool
  uses @server: HttpServer[next, reply]
=
  let got = attempt @server.next()
  when got
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: name))
        if error use unit
      true
    is Err(failure) -> false

--- Serves until `next` fails.
looper() -> Unit
  uses @server: HttpServer[next, reply]
=
  for round in 1..100
    let served = serve_once("looper")
    if not served
      stop

--- Waits for one request.
waiter(name: Text) -> Unit
  uses @server: HttpServer[next, reply]
=
  let served = serve_once(name)
  unit

--- Counts.
busy(n: Int) -> Int
=
  let edit total = 0
  for i in 1..n
    total = total + 1
  total

--- Aborts the run: an integer of more than 4300 digits written as text.
bomb() -> Unit
=
  let edit big = 1
  for i in 1..2000
    big = big * 1000
  let shown = "{big}"
  unit

--- A task aborts the run at 0 ms while others wait in `next`: each `next` ends with the run,
--- taking no request, so nothing is answered at 50 ms (`spec/27 §7`, ADR 0123 rule 4.7).
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  tasks
    start looper()
    start waiter("waiter")
    start bomb()
  @server.close()
