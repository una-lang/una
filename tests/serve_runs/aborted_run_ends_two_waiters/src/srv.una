module srv

import std.collections (empty_bit_set)
import std.host (Exchange, HttpServer, Reply, ServeError)

--- Serves one request: whether `next` gave one.
serve_once(name: Text) -> Bool
  uses @server: HttpServer[next, reply]
=
  const got = attempt @server.next()
  when got
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: name))
        if error use unit
      true
    is Err(failure) -> false

--- Serves until `next` fails.
looper() -> Unit
  uses @server: HttpServer[next, reply]
=
  for round in 1..100
    const served = serve_once("looper")
    if not served
      stop

--- Waits for one request.
waiter(name: Text) -> Unit
  uses @server: HttpServer[next, reply]
=
  const served = serve_once(name)
  unit

--- Counts.
busy(n: Int) -> Int
=
  var total = 0
  for i in 1..n
    total = total + 1
  total

--- Aborts the run after a count: a bit set of 2^64 bits is past every memory budget, so
--- `empty_bit_set` aborts with U6003 before it allocates (`spec/28 §9` rule 5).
bomb() -> Unit
=
  var big = 1
  for i in 1..2000
    big = big * 1000
  const bits = empty_bit_set(size: 18446744073709551616)
  unit

--- A task aborts the run at 0 ms while others wait in `next`: each `next` ends with the run,
--- taking no request, so the program answers nothing; the request read at 50 ms and never
--- delivered gets the host's `503` at the stop (`spec/27 §7`, ADR 0123 rules 4.7 and 18 item 2).
pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  tasks
    start looper()
    start waiter("waiter")
    start bomb()
  @server.close()
