module toolshelf.tools

requirement SHELF_1
  text "A member holds at most three tools at a time"
  source human
  owner front_desk
  status active

requirement SHELF_2
  text "A checkout lasts from one to twenty-eight days"
  source policy "Tool Shelf Rules 3"
  owner front_desk
  status active

--- The number of days a member keeps a tool.
pub kind KeepDays = Int in 1..28

--- A day, counted from the Unix epoch.
pub kind Day = Int

pub kind Tool
  name: Text
  deposit: Nat

pub kind Member
  name: Text
  holding: Int in 0..3

pub kind Checkout
  tool: Tool
  member: Member
  due: Day

pub kind CheckoutError = NotOnShelf(tool: Text) | ShelfDown

pub kind ShelfError = | Offline

--- The shelf the tools are kept on.
pub capability Shelf
  op pick(name: Text) -> Option[Tool]
    fails ShelfError
  op bring_back(tool: Tool) -> Unit
    fails ShelfError

--- A member may take one more tool.
pub predicate reflect can_check_out(m: Member) -> Bool = m.holding < 3

--- A checkout is overdue after its due day.
pub predicate reflect overdue(checkout: Checkout, today: Day) -> Bool = today > checkout.due

--- Checks a tool out from the shelf for `days` days from `today`.
pub check_out(member: Member, name: Text, today: Day, days: KeepDays) -> Checkout
  ensures result.due == today + days
  ensures result.member.holding == member.holding + 1
  uses @shelf: Shelf[pick]
  fails CheckoutError
  derived from SHELF_1, SHELF_2
=
  let tool = @shelf.pick(name)
    if error fail ShelfDown
    if none fail NotOnShelf(tool: name)
  Checkout(tool, member: Member(name: member.name, holding: member.holding + 1), due: today + days)

--- Brings a taken tool back to the shelf.
pub bring_back(checkout: Checkout) -> Member
  requires checkout.member.holding > 0
  ensures result.holding == checkout.member.holding - 1
  uses @shelf: Shelf[bring_back]
  fails CheckoutError
  derived from SHELF_1
=
  @shelf.bring_back(checkout.tool)
    if error fail ShelfDown
  Member(name: checkout.member.name, holding: checkout.member.holding - 1)

--- The days a returned tool is late, zero when it is on time.
pub late_days(checkout: Checkout, today: Day) -> Nat
  ensures overdue(checkout, today) implies result > 0
  ensures not overdue(checkout, today) implies result == 0
=
  if today > checkout.due then today - checkout.due else 0

--- A shelf holding `tools`.
pub handler shelf_with(tools: List[Tool]) for Shelf
  op pick(name) = tools.first_where(keep: fn(t) -> t.name == name)
  op bring_back(tool) = unit

--- A shelf that cannot be reached.
pub handler offline_shelf() for Shelf
  op pick(name) = fail Offline
  op bring_back(tool) = fail Offline

example "a member with room takes a tool for a week"
  given @shelf = shelf_with(tools: [Tool(name: "drill", deposit: 20)])
  do check_out(Member(name: "Ana", holding: 1), name: "drill", today: 100, days: 7)
  expect result.due == 107
  expect result.member.holding == 2
  expect performed @shelf.pick

example "a tool that is not on the shelf cannot be taken"
  given @shelf = shelf_with(tools: [])
  do check_out(Member(name: "Ana", holding: 0), name: "saw", today: 100, days: 7)
  expect fails NotOnShelf

example "a shelf that is offline stops the checkout"
  given @shelf = offline_shelf()
  do check_out(Member(name: "Bo", holding: 0), name: "saw", today: 100, days: 3)
  expect fails ShelfDown

example "bringing a tool back frees a place"
  given @shelf = shelf_with(tools: [])
  do bring_back(Checkout(tool: Tool(name: "saw", deposit: 15), member: Member(name: "Bo", holding: 3), due: 10))
  expect result.holding == 2
  expect performed @shelf.bring_back

example "a tool returned three days after its due day is three days late"
  do late_days(Checkout(tool: Tool(name: "saw", deposit: 15), member: Member(name: "Bo", holding: 1), due: 10), today: 13)
  expect result == 3
