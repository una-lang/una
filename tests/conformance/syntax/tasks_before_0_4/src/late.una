-- test: before edition 0.4, `tasks` is a name, and a `start` line under it does not parse (U0101): the indented line is no handling clause (spec/27 §7, ADR 0117 Conformance)
-- spec: spec/27 §7
-- expect: error U0101 at src/late.una:11:5
module late

note(n: Int) -> Unit = unit

pub late(n: Int) -> Unit
=
  tasks
    start note(n)
