-- test: a handling clause on the line of its expression is not one: `handled` puts each clause on its own indented line (spec/02 §6, #202)
-- spec: spec/02 §6
-- expect: error U0101 at src/same_line.una:20:15
module same_line

pub kind FetchError = Missing | Gone

fetch(id: Int) -> Int
  fails FetchError
=
  if id < 0
    fail Missing
  else
    id

pub pages(ids: List[Int]) -> List[Int]
  fails FetchError
=
  let pages = together for id in ids
    fetch(id) if error pass
  pages
