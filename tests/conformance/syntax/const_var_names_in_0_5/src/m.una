-- test: in edition 0.5, `const` and `var` are keywords, so neither can name a binding or a parameter (U0101) (ADR 0137 rule 1)
-- spec: spec/01 §5
-- expect: error U0101 at src/m.una:9:9
-- expect: error U0101 at src/m.una:11:15
module m

pub f(x: Int) -> Int
=
  const var = x
  var
pub g(n: Int, const: Int) -> Int = n + const
