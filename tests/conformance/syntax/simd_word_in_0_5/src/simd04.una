-- test: in edition 0.5, `simd` is no longer reserved: it is an identifier outside the `simd required` clause (ADR 0120 rule 1, moved to edition 0.5 by ADR 0139 rule 6)
-- spec: spec/01 §5
-- expect: ok
module simd04

pub simd(lanes: Int) -> Int = lanes * 2

pub lanes() -> Int
=
  const simd = 4
  simd * 2
