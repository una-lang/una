-- test: in edition 0.4 `example` is an identifier, so a line `example "..."` at column 1 is an ordinary syntax error, with no U0103 and no rewrite to `test` (ADR 0105, amendment of 2026-11-05)
-- spec: spec/01 §5
-- expect: error U0101 at src/m.una:8:9
module m

pub double(x: Int) -> Int = x * 2

example "doubling works"
  do double(2)
  expect result == 4
