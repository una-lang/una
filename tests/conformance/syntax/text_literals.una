-- test: every valid escape sequence is accepted
-- spec: spec/01 §6
-- expect: tier0-ok
module text_literals

pub quote() -> Text = "she said \"hi\""

pub folder() -> Text = "C:\\data"

pub lines() -> Text = "one\ntwo\tthree"

pub braces() -> Text = "\{not interpolated\}"

pub smile() -> Text = "\u{1F600} and \u{41}"
