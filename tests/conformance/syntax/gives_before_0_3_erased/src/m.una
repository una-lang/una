-- test: the erasure twin of gives_before_0_3: the same program without `gives`, which edition 0.2 accepts and edition 0.3 checks the same way (spec/13 §7, ADR 0094 rule 6)
-- spec: spec/01 §5
-- expect: ok
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub gives(file: Text) -> Text = file

pub refusal(file: Text) -> internal[Service] Text
  uses @service_files: Files[owner, role]
=
  @service_files.owner(file)
