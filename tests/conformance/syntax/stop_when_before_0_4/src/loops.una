-- test: before edition 0.4, `stop when c` does not parse: `stop` is a name, and `when` cannot follow it on the line (U0101, spec/26 §3 rule 1)
-- spec: spec/26 §3
-- expect: error U0101 at src/loops.una:9:10
module loops

pub first_big(xs: List[Int]) -> Int
=
  for x in xs
    stop when x > 10
  0
