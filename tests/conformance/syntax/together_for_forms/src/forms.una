-- test: `together for` stands where a `block_expr` can: as the value of a `let`, as the value of an assignment and as the last line of a block (spec/19 §1 rule 2, #929)
-- spec: spec/19 §1
-- expect: ok
module forms

pub bound(xs: List[Int]) -> List[Int]
=
  let ys = together for x in xs
    x + 1
  ys

pub assigned(xs: List[Int]) -> List[Int]
=
  let edit ys = [0]
  ys = together for x in xs
    x * 2
  ys

pub last(xs: List[Int]) -> List[Int]
=
  together for x in xs
    x + 3
