-- test: in edition 0.4 `example` is an identifier: it names a function, a parameter, a local, a field and a module path segment, with no U0103 (ADR 0105, amendment of 2026-11-05)
-- spec: spec/01 §5
-- expect: ok
module m

import example.names (Sample, example)

pub twice(example: Int) -> Int
=
  let example2 = example * 2
  example2

pub local() -> Int
=
  let example = 3
  example + 1

pub read(s: Sample) -> Int = s.example

pub build() -> Sample = Sample(example: example(1))

test "a field named example"
  do read(build())
  expect result == 2
