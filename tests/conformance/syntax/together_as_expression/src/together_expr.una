-- test: `together` with branches is a statement, and as the value of a `let` it is a syntax error that points to `together for` (spec/19 §1 rule 4)
-- spec: spec/19 §1
-- expect: error U0101 at src/together_expr.una:8:14
module together_expr

pub both(a: Int, b: Int) -> Int
=
  let pair = together
    let x = a
    let y = b
  x + y
