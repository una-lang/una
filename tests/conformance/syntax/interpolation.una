-- test: interpolation embeds expressions without text literals
-- spec: spec/01 §6
-- expect: tier0-ok
module interpolation

pub kind Booking
  name: Text
  seats: Int

pub summary(booking: Booking, extra: Int) -> Text = "{booking.name}: {booking.seats + extra} seats"

pub greeting(name: Text) -> Text = "hello {trim(name)}, braces: \{ \}"
