-- test: nested pattern inside a variant pattern is U0101 (B-001)
-- spec: spec/02 §6
-- expect: error U0101 at 12:13
module nested_pattern

pub kind Shape = Circle(radius: Nat) | Square(side: Nat)

pub size(shape: Option[Shape]) -> Nat
=
  when shape
    is None -> 0
    is Some(Circle(radius)) -> radius
    is Some(Square(side)) -> side
