-- test: the repair of a same-line handling clause applied: the clause on its own line, one level deeper, checks (spec/02 §6, #211)
-- spec: spec/02 §6
-- expect: ok
module onmoved

pub kind FetchError = Missing | Gone

fetch(id: Int) -> Int
  fails FetchError
=
  if id < 0
    fail Missing
  else
    id

pub pages(ids: List[Int]) -> List[Int]
  fails FetchError
=
  let pages = together for id in ids
    fetch(id)
      if error pass
  pages
