-- test: the main declaration, statement and expression forms parse
-- spec: spec/02 §2
-- expect: tier0-ok
module grammar_tour

pub kind Shape = Circle(radius: Nat) | Square(side: Nat)

pub kind Point
  x: Int
  y: Int

pub kind Percent = Int in 0..100

pub kind Positive = Int where it > 0

pub predicate reflect is_small(n: Int) -> Bool = n < 10

pub area(shape: Shape) -> Int
=
  when shape
    is Circle(radius) -> 3 * radius * radius
    is Square(side: length) -> length * length

pub origin() -> Point = Point(x: 0, y: 0)

pub clamp_percent(n: Int) -> Percent
  requires n >= 0
  ensures result <= n
=
  let capped: Int = if n > 100 then 100 else n
  capped

pub describe(n: Positive) -> Text
=
  if is_small(n)
    "small"
  else
    "large"

pub doubled(xs: List[Int]) -> List[Int] = map(xs, each: fn(x: Int) -> x * 2)

pub primes() -> [Int] = [2, 3, 5]

pub either(a: Bool, b: Bool) -> Bool = a and not b or a implies b
