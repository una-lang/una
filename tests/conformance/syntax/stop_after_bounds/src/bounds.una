-- test: `stop after` takes an integer literal from 1 to 2^63 - 1 and is the last line of its example (U0101, spec/26 §6, ADR 0116 rule 19)
-- spec: spec/26 §6
-- expect: error U0101 at src/bounds.una:13:14
-- expect: error U0101 at src/bounds.una:18:14
-- expect: error U0101 at src/bounds.una:24:3
module bounds

pub one() -> Int = 1

example "zero"
  do one()
  expect result == 1
  stop after 0

example "too many"
  do one()
  expect result == 1
  stop after 9_223_372_036_854_775_808

example "not last"
  do one()
  stop after 2
  expect result == 1
