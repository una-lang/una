-- test: in edition 0.4 a function named `example` with a syntax error is a broken declaration like any other, so a caller of it gets no U1001 (ADR 0096 rule 8; ADR 0105, amendment of 2026-11-05)
-- spec: spec/01 §5
-- expect: error U0101 at src/m.una:6:33
module m

pub example(x: Int) -> Int = x +

pub twice(x: Int) -> Int = example(x) * 2
