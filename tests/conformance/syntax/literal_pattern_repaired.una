-- test: the repairs of a literal pattern check: a second `when` with a literal arm and `else` for numbers, Booleans and text, and a comparison in the arm for a negative number (issue #73)
-- spec: spec/02 §6
-- expect: ok
module literal_pattern_repaired

pub size(count: Option[Int]) -> Int
=
  when count
    is Some(inner) ->
      when inner
        is 0 -> 0
        else -> inner
    is None -> 0

pub flag(o: Option[Bool]) -> Int
=
  when o
    is Some(inner) ->
      when inner
        is true -> 1
        else -> 0
    is None -> 0

pub word(o: Option[Text]) -> Int
=
  when o
    is Some(inner) ->
      when inner
        is "a" -> 1
        else -> 0
    is None -> 0

pub below(o: Option[Int]) -> Int
=
  when o
    is Some(inner) -> if inner == -1 then 1 else 2
    is None -> 0
