-- test: in edition 0.3 an `example` declaration is U0103 at the keyword, with the exact rewrite to `test`; its body is read as a test's, so it gets no U0101 (ADR 0105 rule 3)
-- spec: spec/01 §5
-- expect: error U0103 at src/m.una:8:1
module m

pub double(x: Int) -> Int = x * 2

example "doubling works"
  do double(2)
  expect result == 4
