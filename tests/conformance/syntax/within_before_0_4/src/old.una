-- test: before edition 0.4, `within` after an expression does not parse (U0101): it is a name there, and a name cannot follow an expression (spec/27 §5, ADR 0117 Conformance)
-- spec: spec/27 §5
-- expect: error U0101 at src/old.una:10:17
module old

next(n: Int) -> Int = n + 1

pub late(n: Int) -> Int
=
  let x = next(n) within 5
    if error use 0
  x
