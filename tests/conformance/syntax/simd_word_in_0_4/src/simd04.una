-- test: in edition 0.4, `simd` is still reserved for the systems profile (U0103), since ADR 0139 rule 6 moves ADR 0120 rule 1 to edition 0.5
-- spec: spec/01 §5
-- expect: error U0103 at src/simd04.una:9:7
-- expect: error U0103 at src/simd04.una:10:3
module simd04

pub lanes() -> Int
=
  let simd = 4
  simd * 2
