-- test: edition 0.1 keeps the v0.1 tables: `edit` and `take` are reserved for v0.2, `var` keeps its v0.1 message, `old` and `weak` are names, and a block-form `if` needs `else` (spec/01 §5, ADR 0056)
-- spec: spec/01 §5
-- expect: error U0103 at src/words01.una:13:12
-- expect: error U0103 at src/words01.una:15:10
-- expect: error U0103 at src/words01.una:17:9
-- expect: error U0101 at src/words01.una:23:3
module words01

pub old(weak: Int) -> Int = weak

pub uses_old() -> Int = old(weak: 1)

pub copied(var: Int) -> Int = 1

pub bump(edit n: Int) -> Int = n

pub eat(take xs: List[Int]) -> Int = xs.len

pub no_else(flag: Bool) -> Int
=
  if flag
    unit
  1
