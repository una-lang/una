-- test: before edition 0.4, `stop` and `skip` are identifiers, so a bare `stop` or `skip` line is a name that must be bound (U1001), not a statement (spec/26 §3 rule 1, spec/01 §5)
-- spec: spec/26 §3
-- expect: error U1001 at src/loops.una:10:5
-- expect: error U1001 at src/loops.una:12:7
module loops

pub first_big(xs: List[Int]) -> Int
=
  for x in xs
    stop
    if x < 0
      skip
  0
