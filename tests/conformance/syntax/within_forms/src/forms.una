-- test: `within d` bounds a `let`, a statement, an expression after `with`, and an `attempt`, whose `within` comes before its `with` (spec/27 §5, ADR 0117 rule 5)
-- spec: spec/27 §5
-- expect: ok
module forms

import std.time (millisecond, second)

capability Store
  op get(key: Text) -> Int

handler fixed(value: Int) for Store
  op get(key) = value

next(n: Int) -> Int = n + 1

read(key: Text) -> Int
  uses @store: Store[get]
=
  @store.get(key)

pub on_let(n: Int) -> Int
=
  let quick = next(n) within 2 * second
    if error use 0
  quick

pub on_statement() -> Unit
  uses @console: Console[print]
=
  @console.print("tick") within 50 * millisecond
    if error use unit
  unit

pub after_with(key: Text) -> Int
=
  let value = read(key) with @store = fixed(value: 7) within 100 * millisecond
    if error use 0
  value

pub attempted(n: Int) -> Int
=
  let outcome = attempt next(n) within 10 * millisecond
  when outcome
    is Ok(value) -> value
    is Err(failure) -> 0

pub attempted_with(key: Text) -> Int
=
  let outcome = attempt read(key) within 10 * millisecond with @store = fixed(value: 3)
  when outcome
    is Ok(value) -> value
    is Err(failure) -> 0
