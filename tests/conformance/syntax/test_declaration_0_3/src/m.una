-- test: in edition 0.3 the test declaration is written `test`, with the lines and rules of `example`, and `una test` runs it (ADR 0105 rules 1 and 5)
-- spec: spec/08 §2
-- expect: test-pass
module m

pub kind Refusal = | TooLarge

pub double(x: Int) -> Int
  fails Refusal
=
  if x > 100 then fail TooLarge else x * 2

test "doubling works"
  do double(2)
  expect result == 4

test "too large fails"
  do double(101)
  expect fails TooLarge
