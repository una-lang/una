-- expect: error U0007 at 9:28
-- expect: error U0007 at 9:52
-- expect: error U0007 at 9:53
-- expect: error U0007 at 9:54
module unescaped_braces_in_text

pub doc(n: Int) -> Text = "{\"n\": {n}, \"empty\": {}}"
