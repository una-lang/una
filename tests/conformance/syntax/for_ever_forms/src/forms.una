-- test: `for ever`, with or without `on stop`, and `diverges` after `fails` in a header; `for ever in xs` is a loop over `xs` whose variable is `ever`, and `on` stays an identifier (spec/26 §5, ADR 0116 rule 5)
-- spec: spec/26 §5
-- expect: ok
module forms

pub kind Broken = | Snapped

pub spin(limit: Int) -> Int
  fails Broken
  diverges
=
  let edit n = 0
  for ever
    stop when n >= limit
    n = n + 1
  on stop
    n = n + 0
  n

pub quiet() -> Unit
  diverges
=
  for ever
    stop
  unit

pub total(xs: List[Int], on: Int) -> Int
=
  let edit sum = on
  for ever in xs
    sum = sum + ever
  sum
