-- test: in edition 0.5, a run whose only hash table is made through the `on stop` block of a `for ever` loop reads the process key, and the table works (ADR 0119 rule 9, #1199)
-- spec: spec/28 §1
-- grant: console
-- expect: run-output "on stop: 2"
-- expect: run-output "after 3"
module stopping

import std.collections (HashSet, empty_hash_set)

--- How many distinct items `xs` holds.
distinct(xs: List[Int]) -> Int
=
  var s: HashSet[Int] = empty_hash_set()
  for x in xs
    edit s.add(item: x)
  s.len

pub main() -> Unit
  uses @console: Console[print]
  diverges
=
  var n = 0
  for ever
    stop when n == 3
    n = n + 1
  on stop
    @console.print("on stop: {distinct([n, 1, n])}")
  @console.print("after {n}")
