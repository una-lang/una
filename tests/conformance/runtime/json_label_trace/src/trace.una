-- test: a secret Json given to an operation that accepts secret data is accepted in edition 0.4, and the trace redacts the argument by its static label, alike in both engines; a public Json built from public data writes its JSON text (spec/23 §5, spec/11 §5, ADR 0073 J5 as amended)
-- spec: spec/23 §5
-- grant: console
-- expect: run-output "[1,\"a\"]"
module trace

capability Vault
  op store(value: Json) -> Unit
    accepts secret

handler kept() for Vault
  op store(value) = unit

stored(token: secret Text) -> Unit
  uses @vault: Vault[store]
=
  @vault.store(Str(value: token))

pub main() -> Unit
  uses @console: Console[print]
=
  stored("hidden") with @vault = kept()
  @console.print(Array(items: [Number(value: 1), Str(value: "a")]).to_json())
