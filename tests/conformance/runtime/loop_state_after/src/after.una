-- test: in edition 0.5, a list and a map that `for` loops update hold their final values when read after the loops, a copy bound before a loop and a closure created before it keep the values from before, and a closure created in an iteration keeps what it captured when the body then updates the list, in both engines (#1196, spec/17 §5 rule 4, §7)
-- spec: spec/17 §7
-- grant: console
-- expect: run-output "list: [10, 20, 30]"
-- expect: run-output "grown: [10, 20, 30, 4, 5]"
-- expect: run-output "map: {1: 1, 2: 3, 3: 1}"
-- expect: run-output "kept: [1, 2, 3] / [0, 0, 0]"
-- expect: run-output "kept map: {1: 1} / {1: 1, 2: 4, 3: 9}"
-- expect: run-output "closure: 1 2 / [4, 2, 3, 4]"
-- expect: run-output "closure in the body: 6 / [0, 0, 0]"
module after

pub main() -> Unit
  uses @console: Console[print]
=
  var xs = [1, 2, 3]
  for i in 0..<xs.len
    const x = xs.at(index: i).or_else(default: 0)
    edit xs.set(index: i, item: x * 10)
  @console.print("list: {xs}")
  for y in [4, 5]
    xs = xs.append(item: y)
  @console.print("grown: {xs}")
  var counts: Map[Int, Int] = empty_map()
  for k in [2, 1, 2, 3, 2]
    edit counts.update(key: k, initial: 0, change: fn(n) -> n + 1)
  @console.print("map: {counts}")
  var ys = [1, 2, 3]
  const kept = ys
  for i in 0..<ys.len
    edit ys.set(index: i, item: 0)
  @console.print("kept: {kept} / {ys}")
  var m: Map[Int, Int] = empty_map()
  edit m.set(key: 1, value: 1)
  const kept_map = m
  for k in 2..3
    edit m.set(key: k, value: k * k)
  @console.print("kept map: {kept_map} / {m}")
  var zs = [1, 2]
  const first = fn() -> zs.at(index: 0).or_else(default: 0)
  const size = fn() -> zs.len
  for z in [3, 4]
    zs = zs.append(item: z)
    edit zs.set(index: 0, item: z)
  @console.print("closure: {first()} {size()} / {zs}")
  var ws = [1, 2, 3]
  var seen = 0
  for i in 0..<ws.len
    const before = fn() -> ws.at(index: i).or_else(default: 0)
    edit ws.set(index: i, item: 0)
    seen = seen + before()
  @console.print("closure in the body: {seen} / {ws}")
