-- test: conversion keeps the measured type and converts 3 kilometers to the exact magnitude 3000 meters
-- spec: spec/25 §2, §5, §7
-- grant: console
-- expect: run-output "3000"
module units

pub measure Meter

pub measure Kilometer = 1000 * Meter

kilometers_to_meters(km: Int of Kilometer) -> Int of Meter = km.convert()

pub main() -> Unit
  uses @console: Console[print]
=
  let km: Int of Kilometer = 3.measured()
  @console.print("{kilometers_to_meters(km)}")
