-- test: una run compares the capabilities of main with its grants before it starts
-- spec: spec/04 §8
-- grant: console
-- expect: error U3012 at 9:3
module conformance.runtime.startup_grants

pub main() -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let now = @clock.now()
  let started = if now > 0 then "yes" else "no"
  @console.print("started: {started}")
