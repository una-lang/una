-- test: to_int reads a text of at most 4300 digits, the sign excluded and leading zeros included, and is None for a longer one, before any conversion (spec/14 §1, #914)
-- spec: spec/14 §1
-- grant: console
-- expect: run-output "4300 4301 -1 -1"
module conformance.runtime.to_int_cap

length(n: Int) -> Int
=
  let written = "{n}"
  written.len

digits(t: Text) -> Int
=
  when to_int(t)
    is Some(n) -> length(n)
    is None -> -1

pub main() -> Unit
  uses @console: Console[print]
=
  let at_cap = ""
  let signed = "-"
  let over = ""
  let zeros = ""
  @console.print("{digits(at_cap)} {digits(signed)} {digits(over)} {digits(zeros)}")
