-- test: a dense buffer is checked against the memory budget before it is allocated, so a matrix of 10^10 elements stops the run with U6003 at its construction, never an abort of the process
-- spec: spec/29 §17
-- grant: console
-- expect: run-output "starting"
-- expect: error U6003 at src/dense.una:12:15
module dense

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("starting")
  const big = matrix_filled(rows: 100000, columns: 100000, value: 0.0)
  @console.print("rows {big.rows}")
