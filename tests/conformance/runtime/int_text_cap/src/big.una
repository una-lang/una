-- test: an `Int` of more than 4300 digits is never written as text: interpolating it aborts the run with U6003 at the interpolation, after the output so far, in both engines (spec/11 §7, #923)
-- spec: spec/11 §7
-- grant: console
-- expect: run-output "built"
-- expect: error U6003 at src/big.una:21:20
module big

--- Ten to the `exp`, built by a loop of multiplications: cheap to build, quadratic to write.
power(exp: Int) -> Int
=
  let edit n = 1
  for i in 1..exp
    n = n * 10
  n

pub main() -> Unit
  uses @console: Console[print]
=
  let n = power(4300)
  @console.print("built")
  @console.print("{n}")
