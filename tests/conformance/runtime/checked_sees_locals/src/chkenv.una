-- test: the predicate of checked is evaluated in the environment of its locals (review control)
-- spec: spec/11 §4
-- expect: test-pass
-- Promoted from the v0.1 review, adversarial `runtime-checked-environment`.
module chkenv

pub kind Bad = | TooSmall

pub gap(x: Int, y: Int) -> Int
  fails Bad
=
  let v = checked(x, it > y) else fail TooSmall
  100 / (v - y)

pub field_gap(p: Option[Int], y: Int) -> Int
  fails Bad
=
  let v = checked(y, it != 0 and p is Some) else fail TooSmall
  100 / v

example "above"
  do gap(5, y: 3)
  expect result == 50

example "below"
  do gap(1, y: 3)
  expect fails TooSmall

example "equal"
  do gap(3, y: 3)
  expect fails TooSmall

example "field"
  do field_gap(None, y: 4)
  expect fails TooSmall
