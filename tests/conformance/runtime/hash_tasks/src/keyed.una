-- test: a hash table made in the block of a `tasks` statement, or in a started task, takes its key from the run's process key, which the run reads before it starts: the analysis of what the run's code can make enters the block and each `start` (spec/28 §1 rule 3, ADR 0119 rule 6, spec/27 §7)
-- spec: spec/28 §1
-- grant: console
-- expect: run-output "block: {\"c\": 3}"
-- expect: run-output "started: {\"a\": 1, \"b\": 2}"
module keyed

import std.collections (HashMap, empty_hash_map)

--- Prints `m` under `label`.
show(label: Text, m: HashMap[Text, Int]) -> Unit
  uses @console: Console[print]
=
  @console.print("{label}: {m}")

--- Counts `words` in a table of its own, and prints it: a function only a started task calls.
count(words: List[Text]) -> Unit
  uses @console: Console[print]
=
  var counts: HashMap[Text, Int] = empty_hash_map()
  for word in words
    edit counts.update(key: word, initial: 0, change: fn(n) -> n + 1)
  show("started", m: counts)

pub main() -> Unit
  uses @console: Console[print]
=
  tasks
    var block: HashMap[Text, Int] = empty_hash_map()
    edit block.set(key: "c", value: 3)
    start show("block", m: block)
    start count(["a", "b", "b"])
