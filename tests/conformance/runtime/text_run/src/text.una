-- test: the text functions split with empty parts, join, find by scalar position, replace, map ASCII case only, slice and list scalar values, give UTF-8 bytes, trim Unicode white space at one end, and parse integers or fail with Empty, NoDigits or NotADigit(at:), in both engines (spec/22 §2 to §4)
-- spec: spec/22 §2
-- grant: console
-- expect: run-output "[\"a\", \"\", \"b\", \" cé \", \"d\"] a||b| cé |d"
-- expect: run-output "Some(7) None true"
-- expect: run-output "a;;b; cé ;d A,,B, Cé ,D Éaz"
-- expect: run-output "cé  [\"h\", \"é\", \"l\", \"l\", \"o\"] [195, 169]"
-- expect: run-output "[x ] [  x] true"
-- expect: run-output "42 Ok(42)"
-- expect: run-output "-7 Ok(-7)"
-- expect: run-output "-1 Err(Empty)"
-- expect: run-output "-1 Err(NoDigits)"
-- expect: run-output "-1 Err(NotADigit(1))"
-- expect: run-output "-1 Err(NotADigit(1))"
-- expect: run-output "123456789012345678901234567890 Ok(123456789012345678901234567890)"
module text

parsed(t: Text) -> Text
=
  let n = t.parse_int()
    if error use -1
  "{n}"

failure(t: Text) -> Text
=
  let outcome = attempt t.parse_int()
  "{outcome}"

pub main() -> Unit
  uses @console: Console[print]
=
  let line = "a,,b, cé ,d"
  let comma = ","
  let bar = "|"
  let parts = line.split(on: comma)
  @console.print("{parts} {parts.join(separator: bar)}")
  let e = "é"
  let z = "z"
  let bc = "b,"
  @console.print("{line.find(text: e)} {line.find(text: z)} {line.contains_text(part: bc)}")
  let semi = ";"
  let mixed = "ÉaZ"
  @console.print("{line.replace(pattern: comma, by: semi)} {line.to_upper()} {mixed.to_lower()}")
  let hello = "héllo"
  @console.print("{line.slice(start: 6, end: 9)} {hello.chars()} {e.bytes()}")
  let padded = "  x "
  let d = "d"
  @console.print("[{padded.trim_start()}] [{padded.trim_end()}] {line.ends_with(suffix: d)}")
  for t in ["42", "-7", "", "-", "1x", "-a", "123456789012345678901234567890"]
    @console.print("{parsed(t)} {failure(t)}")
