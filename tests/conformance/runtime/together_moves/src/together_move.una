-- test: tasks edit their own copies of the lists they capture, the block's results are new values that later edits update, and the bindings the block reads keep their values after it (spec/19 §4, §6)
-- spec: spec/19 §4, §6
-- grant: console
-- expect: run-output "4 5 3"
-- expect: run-output "1 2 3"
-- expect: run-output "4 10"
-- expect: run-output "1 2 3 0"
module together_move

--- `xs` with `n` items added, edited in place when nothing else holds it.
grown(xs: List[Int], n: Int) -> List[Int]
=
  let edit ys = xs
  for i in 1..n
    ys = ys.append(item: i)
  ys

--- The items of `xs`, joined by spaces.
shown(xs: List[Int]) -> Text
=
  let edit out = ""
  for x in xs
    out = if out == "" then "{x}" else "{out} {x}"
  out

pub main() -> Unit
  uses @console: Console[print]
=
  let edit xs = [1, 2, 3]
  together
    let a = grown(xs, n: 1)
    let b = grown(xs, n: 2)
  let lengths = together for x in xs
    x + 1
  @console.print("{a.len} {b.len} {lengths.len}")
  @console.print(shown(xs))
  let edit c = a
  if c.len > 0
    edit c.set(index: 0, item: 10)
  @console.print("{c.len} {c.at(index: 0).or_else(default: 0)}")
  xs = xs.append(item: 0)
  @console.print(shown(xs))
