-- test: under the virtual clock of tests, `first of` runs its branches in index order and the first that returns wins, also when a later branch would end sooner or at the same time; a failing branch lets the next one run; when every branch fails, the race fails with the first branch's failure; and races nest with `together` three levels deep (spec/27 §6, spec/26 §8, ADR 0117 rules 6, 11 and 12)
-- spec: spec/27 §6
-- expect: test-pass
module races

import std.testing (elapse)
import std.time (Millisecond, millisecond)

--- A duration that moves time forward.
pub kind Delay = Int of Millisecond where it >= 0

pub capability Store
  op get(key: Text) -> Int

pub handler timed(delay: Delay, value: Int) for Store
  op get(key) =
    elapse(delay)
    value

pub kind ReadError = Missing | Broken

pub race(key: Text) -> Int
  uses @slow: Store[get]
  uses @fast: Store[get]
=
  first of
    @slow.get(key)
    @fast.get(key)

missing_below(n: Int) -> Int
  fails ReadError
=
  if n < 0 then fail Missing else n

broken_below(n: Int) -> Int
  fails ReadError
=
  if n < 0 then fail Broken else n + 100

pub fallback(n: Int) -> Int
  fails ReadError
=
  first of
    missing_below(n)
      if error pass
    broken_below(n + 5)
      if error pass

pub both_fail(n: Int) -> Int
  fails ReadError
=
  first of
    missing_below(n)
      if error pass
    broken_below(n)
      if error pass

double(n: Int) -> Int = n * 2

leaf(n: Int) -> restricted Int
=
  first of
    double(n)
    double(n + 1)

middle(n: Int) -> restricted Int
=
  together
    let a = leaf(n)
    let b = leaf(n + 10)
  a + b

pub top(n: Int) -> restricted Int
=
  first of
    middle(n)
    middle(n + 100)

test "the first branch wins, though the second would end sooner"
  given @slow = timed(delay: 50 * millisecond, value: 1)
  given @fast = timed(delay: 10 * millisecond, value: 2)
  do race("k")
  expect result == 1

test "branches that end at the same virtual time: the lowest index wins"
  given @slow = timed(delay: 10 * millisecond, value: 1)
  given @fast = timed(delay: 10 * millisecond, value: 2)
  do race("k")
  expect result == 1

test "a failing branch lets the next one win"
  do fallback(-1)
  expect result == 104

test "when every branch fails, the race fails with the first branch's failure"
  do both_fail(-1)
  expect fails Missing

test "races nest with together three levels deep"
  do top(1)
  expect result == 24
