-- test: loops visit lists and ranges in order, an inclusive range up to the greatest `U8` stops there, a failed loop leaves its `edit` argument unchanged, and iterations are not calls, so 20000 of them run within the call depth (spec/17 §4, §7 rule 1)
-- spec: spec/17 §4, §7
-- grant: console
-- expect: run-output "6 123 0 6 10 13 20000 3"
module for_run

pub kind Oops = Bad | Worse

--- Adds the elements of `xs` to `total`, and fails at a negative one.
add_all(edit total: Int, xs: List[Int]) -> Unit
  fails Oops
=
  for x in xs
    if x < 0
      fail Bad
    total = total + x

pub main() -> Unit
  uses @console: Console[print]
=
  let edit sum = 0
  for x in [1, 2, 3]
    sum = sum + x
  let edit order = ""
  for i in 1..3
    order = "{order}{i}"
  let edit empty = 0
  let nothing: List[Int] = []
  for x in nothing
    empty = empty + 1
  let edit bytes = 0
  let top: U8 = 255
  for b in 250..top
    bytes = bytes + 1
  let edit kept = 10
  add_all(edit kept, xs: [1, -1, 5])
    if error use unit
  let edit added = 10
  add_all(edit added, xs: [1, 2])
    if error use unit
  let edit many = 0
  for i in 0..<20000
    many = many + 1
  let edit pairs = 0
  for i in 0..<3
    for j in 0..<i
      pairs = pairs + 1
  @console.print("{sum} {order} {empty} {bytes} {kept} {added} {many} {pairs}")
