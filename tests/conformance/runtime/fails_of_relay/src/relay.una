-- test: a failure of a function value relays through `fails of` parameters, natively as in the interpreter: under `if error pass`, `if error use` and `attempt`, for a named function and a lambda, through two levels of relay, and in `together` tasks (#267, spec/05 §9, spec/16 §5)
-- spec: spec/05 §9
-- grant: console
-- expect: run-output "pass 7, use 105"
-- expect: run-output "attempt Bad Worse, caught 50"
-- expect: run-output "nested Bad 1102, tasks Bad 2"
module relay

pub kind Oops = Bad | Worse

--- Fails with `Bad` past 1.
parse(n: Int) -> Int
  fails Oops
=
  if n > 1 then fail Bad else 1

--- Passes the failure of `f` on.
passing(f: fn(Int) -> Int) -> Int
  fails of f
=
  let r = f(2)
    if error pass
  r + 100

--- Uses 5 when `f` fails.
using(f: fn(Int) -> Int) -> Int
  fails of f
=
  let r = f(2)
    if error use 5
  r + 100

--- Catches the failure of `f` as a `Result`.
caught(f: fn(Int) -> Int) -> Int
  fails of f
=
  let r = attempt f(2)
  when r
    is Ok(v) -> v
    is Err(e) -> 50

--- Relays through `passing`, a second level of `fails of`.
nested(g: fn(Int) -> Int) -> Int
  fails of g
=
  let r = passing(f: g)
    if error pass
  r + 1000

--- Calls `f` in two tasks; the first one fails.
tasks(f: fn(Int) -> Int) -> Int
  fails of f
=
  together
    let a = f(2)
      if error pass
    let b = f(0)
      if error pass
  a + b

--- `n` as text, or the failure's name.
shown(r: Result[Int, Oops]) -> Text
=
  when r
    is Ok(n) -> "{n}"
    is Err(e) -> "{e}"

pub main() -> Unit
  uses @console: Console[print]
=
  let a = passing(f: parse)
    if error use 7
  let b = using(f: parse)
    if error use 9
  @console.print("pass {a}, use {b}")
  let rc = attempt passing(f: parse)
  let rd = attempt passing(f: fn(n) -> if n > 1 then fail Worse else 1)
  let rf = attempt caught(f: parse)
  @console.print("attempt {shown(rc)} {shown(rd)}, caught {shown(rf)}")
  let rg = attempt nested(g: parse)
  let rh = attempt nested(g: fn(n) -> n)
  let ri = attempt tasks(f: parse)
  let rj = attempt tasks(f: fn(n) -> n)
  @console.print("nested {shown(rg)} {shown(rh)}, tasks {shown(ri)} {shown(rj)}")
