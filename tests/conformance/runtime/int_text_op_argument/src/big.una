-- test: an argument of an operation that holds an `Int` of more than 4300 digits is written in full in its event, and the operation runs, whether or not the run records a trace, in both engines (spec/11 §7, #1223)
-- spec: spec/11 §7
-- grant: console
-- expect: run-output "before"
-- expect: run-output "kept 4299"
-- expect: run-output "kept 4300"
-- expect: run-output "done"
module big

capability Sink
  op put(note: Text, x: Int) -> Unit

handler keep() for Sink
  uses @console: Console[print]
  op put(note, x) = @console.print("kept {note}")

--- Ten to the `exp`, built by a loop of multiplications.
power(exp: Int) -> Int
=
  let edit n = 1
  for i in 1..exp
    n = n * 10
  n

--- Puts ten to the `exp`, which has `exp + 1` digits.
send(exp: Int) -> Unit
  uses @k: Sink[put]
=
  let note = "{exp}"
  @k.put(note, x: power(exp))

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("before")
  send(4299) with @k = keep()
  send(4300) with @k = keep()
  @console.print("done")
