-- test: parse_decimal fails as spec/29 §16 rule 6 states, with TooLong past 4,300 digits; a rendering parses back; as_decimal and json_decimal; a map keyed by decimals is in order
-- spec: spec/29 §16
-- grant: console
-- expect: run-output "[Err(Empty), Err(NoDigits), Err(NotADigit(0)), Err(NotADigit(1)), Err(NotADigit(2)), Err(NotADigit(1)), Err(NotADigit(4)), Err(NotADigit(3))]"
-- expect: run-output "[Ok(12.50), Ok(-0.05), Ok(7.00), Ok(1.23), Ok(0.00)]"
-- expect: run-output "Err(TooLong) true"
-- expect: run-output "Some(7.00) Some(1.5) None None"
-- expect: run-output "Number(42) Decimal(\"-12.50\")"
-- expect: run-output "[-12.50, 0.00]"
module m

parsed(t: Text) -> Result[Decimal[2], ParseError] = attempt parse_decimal(t, scale: 2)

json(t: Text) -> Option[Decimal[1]]
=
  const parsed = attempt parse_json(t)
  when parsed
    is Ok(j) -> as_decimal(j, scale: 1)
    is Err(e) -> None

pub main() -> Unit
  uses @console: Console[print]
=
  const bad = ["", "-", "+1", "01", "1.", "1e5", "1.005", "1.2.3"]
  const good = ["12.5", "-0.05", "7", "1.230000", "-0"]
  @console.print("{map(bad, each: parsed)}")
  @console.print("{map(good, each: parsed)}")
  const d1 = "9999999999"
  const d2 = "{d1}{d1}{d1}{d1}{d1}{d1}{d1}{d1}"
  const d3 = "{d2}{d2}{d2}{d2}{d2}{d2}{d2}{d2}"
  const long = "{d3}{d3}{d3}{d3}{d3}{d3}{d3}{d3}"
  const x: Decimal[2] = -12.50
  const back = "{x}"
  @console.print("{parsed(long)} {parsed(back) == Ok(x)}")
  const n = Number(7)
  const one = "1.5e0"
  const huge = "1e1000000000"
  const fine = "0.125"
  @console.print("{as_decimal(n, scale: 2)} {json(one)} {json(huge)} {json(fine)}")
  const whole: Decimal[0] = 42.0
  @console.print("{json_decimal(whole)} {json_decimal(x)}")
  const zero: Decimal[2] = 0.00
  const names: Map[Decimal[2], Text] = empty_map()
  const prices = names.with(key: x, value: "low").with(key: zero, value: "zero")
  @console.print("{prices.keys()}")
