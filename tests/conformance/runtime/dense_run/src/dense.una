-- test: dense values run: construction and rendering as construction calls, reads, updates in place and by copy while a view shares the buffer, views, element-wise operators, a lane-blocked sum whose zeros are positive, a dot product equal bit for bit to the matching element of a matrix product at 1, 63, 64, 65 and 1000 terms, and a scaled norm
-- spec: spec/29 §17
-- grant: console
-- expect: run-output "array([1.0, 2.0, 3.0]) matrix(rows: 2, columns: 3, elements: [1, 2, 3, 4, 5, 6])"
-- expect: run-output "get 2.0 5 Some(3.0) None"
-- expect: run-output "views array([4, 5, 6]) array([2, 5]) matrix(rows: 3, columns: 2, elements: [1, 4, 2, 5, 3, 6]) array([2.0, 3.0])"
-- expect: run-output "set array([1.0, 9.0, 3.0]) array([1.0, 2.0, 3.0]) array([9.0, 3.0])"
-- expect: run-output "ops array([3.0, 6.0, 9.0]) array([0.0, 0.0, 0.0]) array([-1.0, -2.0, -3.0]) array([0.5, 1.0, 1.5])"
-- expect: run-output "sum 0.0 6.0 21"
-- expect: run-output "dot true true true true true"
-- expect: run-output "norm 1.0e-200 5.0 inf"
-- expect: run-output "equal true false true"
module dense

dot_matches(k: Int) -> Bool
  requires k >= 1
=
  const zero = 0.0
  var xs = array_filled(length: k, value: zero)
  var ys = array_filled(length: k, value: zero)
  var a = matrix_filled(rows: 1, columns: k, value: zero)
  var b = matrix_filled(rows: k, columns: 1, value: zero)
  for i in 0..<k
    const x = 1.0 / (i.to_f64() + 3.0)
    const y = (i mod 7).to_f64() - 2.5
    edit xs.set(index: i, item: x)
    edit ys.set(index: i, item: y)
    edit a.set(row: 0, column: i, item: x)
    edit b.set(row: i, column: 0, item: y)
  const product = a.multiply(by: b)
  const both = xs.dot(with: ys) == product.get(row: 0, column: 0)
  both and xs.dot(with: ys) == a.multiply_array(by: ys).get(index: 0)

pub main() -> Unit
  uses @console: Console[print]
=
  const a: Array[F64] = array([1.0, 2.0, 3.0])
  const items: List[I32] = [1, 2, 3, 4, 5, 6]
  const m = matrix(rows: 2, columns: 3, elements: items)
  @console.print("{a} {m}")
  @console.print("get {a.get(index: 1)} {m.get(row: 1, column: 1)} {a.at(index: 2)} {a.at(index: 3)}")
  @console.print("views {m.row(index: 1)} {m.column(index: 1)} {m.transpose()} {a.slice(from: 1, until: 3)}")
  const view = a.slice(from: 1, until: 3)
  var b = a
  edit b.set(index: 1, item: 9.0)
  var v = view
  edit v.set(index: 0, item: 9.0)
  @console.print("set {b} {a} {v}")
  @console.print("ops {a + a + a} {a - a} {-a} {a / 2.0}")
  const zeros: Array[F64] = array([-0.0])
  @console.print("sum {zeros.sum()} {a.sum()} {m.sum_exact()}")
  @console.print("dot {dot_matches(1)} {dot_matches(63)} {dot_matches(64)} {dot_matches(65)} {dot_matches(1000)}")
  const tiny: Array[F64] = array([1.0e-200])
  const big: Array[F64] = array([1.7976931348623157e308, 1.7976931348623157e308])
  @console.print("norm {tiny.norm2()} {array([3.0, 4.0]).norm2()} {big.norm2()}")
  @console.print("equal {a == a.compact()} {a == b} {m.transpose().transpose() == m}")
