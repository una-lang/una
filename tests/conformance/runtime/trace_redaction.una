-- test: a secret argument is redacted in the trace, directly and inside a record, a list and an option (review control)
-- spec: spec/11 §5
-- expect: test-pass
-- Promoted from the v0.1 review, adversarial `runtime-trace-redaction`.
module trace_redaction

pub kind Card
  owner: Text
  number: secret Text

pub capability Vault
  op keep(tag: Text, card: Card, extra: List[secret Text], maybe: Option[secret Text], raw: secret Text) -> Unit
    accepts secret

pub handler vault() for Vault
  op keep(tag, card, extra, maybe, raw) = unit

pub store(pin: secret Text) -> Unit
  uses @vault: Vault[keep]
=
  let card = Card(owner: "Ana", number: pin)
  @vault.keep("t", card, extra: [pin, "x"], maybe: Some(pin), raw: pin)

example "the trace does not show the pin"
  given @vault = vault()
  do store("4111-SECRET")
  expect performed @vault.keep
