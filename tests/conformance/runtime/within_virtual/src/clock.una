-- test: under the virtual clock of tests, a `within` gives its expression's value when the expression returns before the deadline, and its time-out when the deadline passes first: also when the expression returns exactly at the deadline, and for tasks started inside it; an operation in progress completes, nothing after the next check point runs, and a `for ever` cut by it runs its `on stop`; nested, only the outer deadline that passed reports; `if error pass` passes the time-out as the function's `TimedOut` (spec/27 §5, spec/26 §8, ADR 0117 rule 5)
-- spec: spec/27 §5
-- expect: test-pass
module clock

import std.testing (elapse)
import std.time (Millisecond, millisecond)

pub capability Store
  op get(key: Text) -> Int

--- A duration that moves time forward.
pub kind Delay = Int of Millisecond where it >= 0

pub handler slow_store(delay: Delay) for Store
  op get(key) =
    elapse(delay)
    7

pub kind ReadError = Missing | TimedOut

pub capability Log
  op write(line: Text) -> Unit

pub handler memory_log() for Log
  op write(line) = unit

read(key: Text) -> Int
  uses @store: Store[get]
=
  @store.get(key)

pub bounded(key: Text) -> Int
  uses @store: Store[get]
=
  let value = read(key) within 100 * millisecond
    if error use 0
  value

pub twice(key: Text) -> Int
  uses @store: Store[get]
=
  let first = read(key)
  let second = read(key)
  first + second

pub logged(key: Text) -> Int
  uses @store: Store[get]
  uses @log: Log[write]
=
  let value = read(key)
  @log.write("late")
  value

pub bounded_logged(key: Text) -> Int
  uses @store: Store[get]
  uses @log: Log[write]
=
  let value = logged(key) within 100 * millisecond
    if error use -1
  value

pub inner(key: Text) -> Int
  uses @store: Store[get]
=
  let value = read(key) within 1000 * millisecond
    if error use -1
  value

pub outer(key: Text) -> Int
  uses @store: Store[get]
=
  let value = inner(key) within 100 * millisecond
    if error use -2
  value

pub pair(key: Text) -> Int
  uses @store: Store[get]
=
  together
    let a = twice(key)
    let b = twice(key)
  a + b

pub bounded_pair(key: Text) -> Int
  uses @store: Store[get]
=
  let value = pair(key) within 100 * millisecond
    if error use -3
  value

pub strict(key: Text) -> Int
  uses @store: Store[get]
  fails ReadError
=
  let value = read(key) within 100 * millisecond
    if error pass
  value

example "a deadline met keeps the value"
  given @store = slow_store(delay: 50 * millisecond)
  do bounded("k")
  expect result == 7

example "a deadline missed gives the fallback"
  given @store = slow_store(delay: 150 * millisecond)
  do bounded("k")
  expect result == 0

example "an expression that returns at its deadline has missed it"
  given @store = slow_store(delay: 100 * millisecond)
  do bounded("k")
  expect result == 0

example "the deadline cuts the expression at its next check point"
  given @store = slow_store(delay: 150 * millisecond)
  given @log = memory_log()
  do bounded_logged("k")
  expect result == -1
  expect not performed @log.write

example "nested, only the outer deadline reports"
  given @store = slow_store(delay: 150 * millisecond)
  do outer("k")
  expect result == -2

example "tasks inside a within are cancelled with it"
  given @store = slow_store(delay: 30 * millisecond)
  do bounded_pair("k")
  expect result == -3

example "if error pass passes the time-out as the function's TimedOut"
  given @store = slow_store(delay: 150 * millisecond)
  do strict("k")
  expect fails TimedOut

example "in time, the value passes"
  given @store = slow_store(delay: 10 * millisecond)
  do strict("k")
  expect result == 7

pub polling(key: Text) -> Int
  uses @store: Store[get]
  uses @log: Log[write]
  diverges
=
  let edit reads = 0
  for ever
    let value = @store.get(key)
    reads = reads + 1
  on stop
    @log.write("stopped after {reads}")
  reads

pub bounded_polling(key: Text) -> Int
  uses @store: Store[get]
  uses @log: Log[write]
  diverges
=
  let value = polling(key) within 100 * millisecond
    if error use -4
  value

example "a for ever inside a within runs its on stop when the deadline cuts it"
  given @store = slow_store(delay: 30 * millisecond)
  given @log = memory_log()
  do bounded_polling("k")
  expect result == -4
  expect performed @log.write
  stop after 100
