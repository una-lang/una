-- test: calls of function values that are themselves `secret`, at a `public` program counter, directly, through a kind's field, and from a generic function under a decision on its type parameter, run `tasks` statements that fail and cancel their tasks, and stay legal and run as before; each such call stands under `pc ⊔ l_f` and is quiet, so its `cancelled` events and block numbers do not reach the trace, which the native tests compare across secrets in both engines (spec/26 §6 rule 4, spec/07 §3 rule 4, S-39); its data are `internal`, above `public` and so quiet, and at most the `internal` that the schedule of started tasks may depend on, since check points under a `secret` program counter are U4002 in a program that starts tasks (spec/27 §8 rule 5, #1684)
-- spec: spec/26 §6
-- grant: console
-- expect: run-output "w 1"
module values

pub kind Bad = Boom | Other

pub kind Job
  run: fn() -> Unit

noop() -> Unit = unit

boom() -> Unit
  fails Bad
=
  fail Boom

run_block() -> Unit
  fails Bad
=
  tasks
    start noop()
    boom()
      if error pass

blk() -> Unit
=
  let r = attempt run_block()
  noop()

nothing() -> Unit = unit

when_true(b: Bool) -> Unit
=
  if b
    blk()

pick[T](a: T, b: T, f: fn(Bool) -> Unit) -> Unit = f(a == b)

worker(n: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("w {n}")

pub main() -> Unit
  uses @console: Console[print]
=
  let s: internal Int = 2
  let f = if s > 0 then blk else nothing
  f()
  let a = if s > 1 then Job(run: blk) else Job(run: nothing)
  a.run()
  pick(s, b: 2, f: when_true)
  tasks
    start worker(1)
