-- test: a failure ends the function, and handling clauses and attempt catch it
-- spec: spec/11 §4
-- grant: console
-- expect: run-output "found 30"
-- expect: run-output "missing -1"
-- expect: run-output "attempt: unavailable: negative"
-- expect: run-output "wrapped: broken: lookup"
-- expect: run-output "passed: missing"
module conformance.runtime.failures_and_handling

pub kind LookupError = Missing | Unavailable(reason: Text)

pub kind AppError = | Broken(detail: Text)

pub find(key: Int) -> Int
  fails LookupError
=
  if key < 0 then fail Unavailable(reason: "negative") else if key > 9 then fail Missing else key * 10

pub wrapped(key: Int) -> Int
  fails AppError
=
  let value = find(key)
    if error fail Broken(detail: "lookup")
  value

pub passed(key: Int) -> Int
  fails LookupError
=
  let value = find(key)
    if error pass
  value + 1

pub describe(failure: LookupError) -> Text
=
  when failure
    is Missing -> "missing"
    is Unavailable(reason) -> "unavailable: {reason}"

pub main() -> Unit
  uses @console: Console[print]
=
  let a = find(3)
    if error use 0
  @console.print("found {a}")
  let b = find(20)
    if error use -1
  @console.print("missing {b}")
  let outcome = attempt find(-5)
  let shown = when outcome
    is Ok(value) -> "ok {value}"
    is Err(failure) -> describe(failure)
  @console.print("attempt: {shown}")
  let wrapped_outcome = attempt wrapped(20)
  let detail = when wrapped_outcome
    is Ok -> "ok"
    is Err(failure) ->
      when failure
        is Broken(detail) -> "broken: {detail}"
  @console.print("wrapped: {detail}")
  let passed_outcome = attempt passed(12)
  let why = when passed_outcome
    is Ok -> "ok"
    is Err(failure) -> describe(failure)
  @console.print("passed: {why}")
