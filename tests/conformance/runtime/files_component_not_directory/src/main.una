-- test: a read and a write of a path with a component that is a file, where a directory is looked up, fail with Io, not NotFound, and the file is left as it was
-- spec: spec/14 §3
-- grant: console
-- grant: files:data:read,write
-- expect: run-output "read of a name in a file: io"
-- expect: run-output "write of a name in a file: io"
-- expect: run-output "read below a name in a file: io"
-- expect: run-output "write below a name in a file: io"
-- expect: run-output "read below one in a directory below: io"
-- expect: run-output "read of the file: read"
module main

describe(failure: FileError) -> Text
=
  when failure
    is NotFound -> "not found"
    is Denied -> "denied"
    is Io -> "io"

show(path: Text) -> Text
  uses @files: Files[read]
=
  let content = attempt @files.read(path)
  when content
    is Ok -> "read"
    is Err(failure) -> describe(failure)

save(path: Text) -> Text
  uses @files: Files[write]
=
  let saved = attempt @files.write(path, content: "entry")
  when saved
    is Ok -> "written"
    is Err(failure) -> describe(failure)

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  let r0 = show("note.txt/new.txt")
  @console.print("read of a name in a file: {r0}")
  let r1 = save("note.txt/new.txt")
  @console.print("write of a name in a file: {r1}")
  let r2 = show("note.txt/x/new.txt")
  @console.print("read below a name in a file: {r2}")
  let r3 = save("note.txt/x/new.txt")
  @console.print("write below a name in a file: {r3}")
  let r4 = show("sub/note.txt/x/new.txt")
  @console.print("read below one in a directory below: {r4}")
  let r5 = show("note.txt")
  @console.print("read of the file: {r5}")
