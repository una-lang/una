-- test: interpolation writes integers, booleans and texts, and a text's length counts scalar values
-- spec: spec/14 §2
-- grant: console
-- expect: run-output "name: Zoë, seats: 42, open: true, length: 3"
-- expect: run-output "braces and quotes: {\"una\"}"
module conformance.runtime.text_interpolation

pub main() -> Unit
  uses @console: Console[print]
=
  let name = "Zoë"
  let seats = 42
  let open = seats > 0
  let length = name.len
  @console.print("name: {name}, seats: {seats}, open: {open}, length: {length}")
  @console.print("braces and quotes: \{\"una\"\}")
