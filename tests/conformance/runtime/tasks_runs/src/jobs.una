-- test: a `tasks` statement waits for the tasks it started, at most its bound at once; leaving its block by `stop` of an enclosing loop waits for them too; and a started task past `--task-depth` ends alone while the others run on (spec/27 §7, ADR 0117 rule 7)
-- spec: spec/27 §7
-- grant: console
-- expect: run-output "job 1"
-- expect: run-output "job 2"
-- expect: run-output "job 3"
-- expect: run-output "all done"
-- expect: run-output "job 1"
-- expect: run-output "job 2"
-- expect: run-output "stopped"
-- expect: run-output "dove 3"
-- expect: run-output "dives done"
module jobs

say(n: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("job {n}")

deep(n: Int) -> Int = if n == 0 then 0 else deep(n - 1) + 1

dive(n: Int) -> Unit
  uses @console: Console[print]
=
  let d = deep(n)
  @console.print("dove {d}")

all() -> Unit
  uses @console: Console[print]
=
  tasks at most 2 at once
    for n in 1..3
      start say(n)
  @console.print("all done")

first_two() -> Unit
  uses @console: Console[print]
=
  for n in 1..10
    tasks
      start say(n)
      stop when n == 2
  @console.print("stopped")

dives() -> Unit
  uses @console: Console[print]
=
  tasks
    start dive(100000)
    start dive(3)
  @console.print("dives done")

pub main() -> Unit
  uses @console: Console[print]
=
  all()
  first_two()
  dives()
