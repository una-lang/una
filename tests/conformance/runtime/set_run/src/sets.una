-- test: in edition 0.5, a `Set` holds each item once and lists its items in ascending order: `has`, `add`, `remove`, `with`, `without`, `first`, `last`, `between`, `items`, `.len` and the set operations give their results, on the empty set too; a set renders as `{a, b}`, compares by its items, and keeps value semantics through a binding; both engines agree (ADR 0119 rule 7)
-- spec: spec/28 §6
-- grant: console
-- expect: run-output "empty: {} 0 false None None [] [] {}"
-- expect: run-output "built: {1, 2, 3, 5, 8} 5 true false Some(1) Some(8)"
-- expect: run-output "between: [2, 3, 5] [] [] [8]"
-- expect: run-output "updated: {1, 2, 5, 8, 13} 5 false true"
-- expect: run-output "values: {1, 2, 3, 5, 8} {1, 2, 3, 5, 8, 21} {2, 3, 5, 8}"
-- expect: run-output "kept: {1, 2, 3, 5, 8} {1, 2, 3, 5, 8, 34}"
-- expect: run-output "equal: true false true"
-- expect: run-output "union: {1, 2, 3, 4, 5, 6, 8} {1, 2, 3, 5, 8} {1, 2, 3, 5, 8}"
-- expect: run-output "intersection: {2, 5, 8} {} {}"
-- expect: run-output "difference: {1, 3} {4, 6} {1, 2, 3, 5, 8} {}"
-- expect: run-output "subset: true false true true"
-- expect: run-output "texts: {\"a\", \"b\", \"z\"} [\"a\", \"b\", \"z\"]"
module sets

import std.collections (Set, empty_set)

--- The set of the items of `xs`, each once.
of(xs: List[Int]) -> Set[Int]
=
  var s: Set[Int] = empty_set()
  for x in xs
    edit s.add(item: x)
  s

pub main() -> Unit
  uses @console: Console[print]
=
  const empty: Set[Int] = empty_set()
  @console.print("empty: {empty} {empty.len} {empty.has(item: 1)} {empty.first()} {empty.last()} {empty.items()} {empty.between(low: 0, high: 9)} {empty.without(item: 1)}")
  const fib = of([5, 3, 8, 1, 2, 3, 5, 1])
  @console.print("built: {fib} {fib.len} {fib.has(item: 3)} {fib.has(item: 4)} {fib.first()} {fib.last()}")
  @console.print("between: {fib.between(low: 2, high: 7)} {fib.between(low: 9, high: 20)} {fib.between(low: 7, high: 2)} {fib.between(low: 8, high: 8)}")
  var grown = fib
  edit grown.remove(item: 3)
  edit grown.remove(item: 4)
  edit grown.add(item: 13)
  edit grown.add(item: 1)
  @console.print("updated: {grown} {grown.len} {grown.has(item: 3)} {grown.has(item: 13)}")
  const more = fib.with(item: 21)
  const less = fib.without(item: 1)
  @console.print("values: {fib} {more} {less}")
  var copy = fib
  edit copy.add(item: 34)
  @console.print("kept: {fib} {copy}")
  @console.print("equal: {fib == of([8, 5, 3, 2, 1])} {fib == more} {empty == of([])}")
  const evens = of([2, 4, 6, 8])
  @console.print("union: {fib.union(other: of([4, 6, 2]))} {fib.union(other: empty)} {empty.union(other: fib)}")
  @console.print("intersection: {fib.intersection(other: of([2, 5, 8, 13]))} {fib.intersection(other: empty)} {empty.intersection(other: fib)}")
  @console.print("difference: {fib.difference(other: evens.union(other: of([5])))} {evens.difference(other: fib)} {fib.difference(other: empty)} {empty.difference(other: fib)}")
  @console.print("subset: {of([1, 8]).is_subset(of: fib)} {evens.is_subset(of: fib)} {empty.is_subset(of: fib)} {fib.is_subset(of: fib)}")
  const no_texts: Set[Text] = empty_set()
  const texts = no_texts.with(item: "z").with(item: "a").with(item: "b").with(item: "a")
  @console.print("texts: {texts} {texts.items()}")
