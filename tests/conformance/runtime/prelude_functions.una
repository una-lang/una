-- test: the prelude's functions compute what their signatures and contracts describe
-- spec: spec/14 §1
-- grant: console
-- expect: run-output "sum of doubled: 28"
-- expect: run-output "above 2: 3"
-- expect: run-output "product: 60"
-- expect: run-output "first: 3, third: 4, tenth exists: false"
-- expect: run-output "first above 3: 4"
-- expect: run-output "appended: true, empty: false"
-- expect: run-output "parsed: -42, malformed: false"
-- expect: run-output "[una], digits: true, prefix: true"
-- expect: run-output "min: -2, max: 3, abs: 17"
module conformance.runtime.prelude_functions

pub main() -> Unit
  uses @console: Console[print]
=
  let xs = [3, 1, 4, 1, 5]
  let doubled = xs.map(each: fn(x) -> x * 2)
  let total = doubled.sum()
  @console.print("sum of doubled: {total}")
  let big = xs.filter(keep: fn(x) -> x > 2)
  let count = big.len
  @console.print("above 2: {count}")
  let product = xs.fold(initial: 1, step: fn(acc, x) -> acc * x)
  @console.print("product: {product}")
  let first = xs.first().or_else(default: 0)
  let third = xs.at(index: 2).or_else(default: 0)
  let tenth = xs.at(index: 9).is_some()
  @console.print("first: {first}, third: {third}, tenth exists: {tenth}")
  let found = xs.first_where(keep: fn(x) -> x > 3).or_else(default: 0)
  @console.print("first above 3: {found}")
  let more = xs.append(item: 9)
  let has = more.contains(item: 9)
  let empty = more.is_empty()
  @console.print("appended: {has}, empty: {empty}")
  let parsed = to_int("-42").or_else(default: 0)
  let malformed = to_int("4x").is_some()
  @console.print("parsed: {parsed}, malformed: {malformed}")
  let trimmed = trim("  una  ")
  let digits = is_digits("2026")
  let prefix = starts_with("una.core", prefix: "una")
  @console.print("[{trimmed}], digits: {digits}, prefix: {prefix}")
  let low = min(3, b: -2)
  let high = max(3, b: -2)
  let size = abs(-17)
  @console.print("min: {low}, max: {high}, abs: {size}")
