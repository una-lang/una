-- test: `tasks` statements and `first of` blocks that quiet code runs under a `secret` program counter, in the root task and in a started one, stay legal and run as before, then public ones run; quiet code numbers its blocks apart, so the paths of the public tasks do not depend on the secret, which the native tests compare across secrets in both engines (spec/26 §6 rule 4, spec/27 §6, §7, S-39); its data are `internal`, above `public` and so quiet, and at most the `internal` that the schedule of started tasks may depend on, since check points under a `secret` program counter are U4002 in a program that starts tasks (spec/27 §8 rule 5, #1684)
-- spec: spec/26 §6
-- grant: console
-- expect: run-output "w 1"
-- expect: run-output "w 2"
module paths

noop() -> Unit = unit

drop(n: Int) -> Unit = unit

double(n: Int) -> Int = n * 2

race(i: Int) -> Int
=
  first of
    double(i)
    double(i)

worker(n: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("w {n}")

inner(s: internal Int) -> Unit
  uses @console: Console[print]
=
  for i in 0..<3
    if s > i
      tasks
        start noop()
  tasks
    start worker(2)

pub main() -> Unit
  uses @console: Console[print]
=
  let s: internal Int = 2
  for i in 0..<3
    if s > i
      tasks
        start noop()
      drop(race(i))
  tasks
    start worker(1)
  tasks
    start inner(s)
