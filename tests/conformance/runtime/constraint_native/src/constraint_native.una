-- test: values of a constrained type parameter compare by the built-in order of the type that instantiates it, also through a caller's type parameter: integers of every width, beyond a tagged word too, text and variants without payloads; `to_int()` gives the value as `Int` (spec/20 §1, §7, #171)
-- spec: spec/20 §7
-- grant: console
-- expect: run-output "ints: true false true"
-- expect: run-output "wide: true false"
-- expect: run-output "text: true false, levels: true false"
-- expect: run-output "smallest: -7 apple Low 3"
-- expect: run-output "widened: 18446744073709551615 -9223372036854775808 200"
-- expect: run-output "sorted: 0 1 18446744073709551615"
-- expect: run-output "two levels: true false, values: true false true"
module constraint_native

pub kind Level = Low | Mid | High

--- Whether `a` comes before `than`.
before[T: Ord](a: T, than: T) -> Bool = a < than

--- Whether `a` is at most `than`, through `before` with the caller's type parameter.
at_most[T: Ord](a: T, than: T) -> Bool = not before(than, than: a)

--- The least of `xs` and `floor`.
smallest[T: Ord](xs: List[T], floor: T) -> T = xs.fold(initial: floor, step: fn(best,
    x
  ) -> min(best, b: x))

--- Whether `a` is at most `than`, two generic callers away from `before`.
within[T: Ord](a: T, than: T) -> Bool = at_most(a, than: than)

--- What `check` gives of `a` and `b`.
holds[T, R](a: T, b: T, check: fn(T, T) -> R) -> R = check(a, b)

--- Whether `a` comes before `than`, through `before` passed as a function value of `T`.
before_by_value[T: Ord](a: T, than: T) -> Bool = holds(a, b: than, check: before)

--- The value of `x` as `Int`.
widen[T: Integer](x: T) -> Int = x.to_int()

--- The level's name.
name(level: Level) -> Text
=
  when level
    is Low -> "Low"
    is Mid -> "Mid"
    is High -> "High"

pub main() -> Unit
  uses @console: Console[print]
=
  let small: I8 = -7
  let big: U64 = 18446744073709551615
  let half: U64 = 4611686018427387904
  let least: I64 = -9223372036854775808
  let byte: U8 = 200
  @console.print("ints: {before(1, than: 2)} {before(small, than: small)} {at_most(small, than: small)}")
  @console.print("wide: {before(half, than: big)} {before(big, than: half)}")
  let apple = "apple"
  let pear = "pear"
  let fig = "fig"
  let first = before(apple, than: pear)
  let second = before(pear, than: apple)
  @console.print("text: {first} {second}, levels: {before(Low, than: High)} {at_most(High, than: Mid)}")
  let level = name(smallest([High, Mid], floor: Low))
  let word = smallest([pear, apple], floor: fig)
  @console.print("smallest: {smallest([3, 5], floor: -7)} {word} {level} {smallest([4, 3], floor: 9)}")
  @console.print("widened: {widen(big)} {widen(least)} {widen(byte)}")
  let zero: U64 = 0
  let one: U64 = 1
  let sorted = sort([big, zero, one])
  let shown = sorted.fold(initial: "", step: fn(acc, x) -> "{acc} {x.to_int()}")
  @console.print("sorted:{shown}")
  let deep = within(Mid, than: High)
  let deeper = within(pear, than: apple)
  let valued = holds(Low, b: High, check: before)
  let generic_value = before_by_value(big, than: half)
  let text_value = before_by_value(apple, than: pear)
  @console.print("two levels: {deep} {deeper}, values: {valued} {generic_value} {text_value}")
