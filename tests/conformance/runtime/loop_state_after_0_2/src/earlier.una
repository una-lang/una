-- test: in edition 0.2, lists and maps that `for` loops update, through two levels of loops or two loops in a row, hold their final values when read after the loops; copies bound before a loop, in the outer body too, and a closure created before it keep the values from before; a loop whose body fails leaves its list as it was, under `if error use` and in a handler inside another loop; a function whose loops update a copy of its argument gives the same result twice and leaves the argument as it was, in both engines (#1196, spec/17 §7)
-- spec: spec/17 §7
-- grant: console
-- expect: run-output "list: [10, 20, 30, 4, 5]"
-- expect: run-output "map: {1: 1, 2: 3, 3: 1}"
-- expect: run-output "kept: [1, 2, 3] / [0, 0, 0] / {1: 1} / {1: 1, 2: 4, 3: 9}"
-- expect: run-output "closure: 1 2 / [4, 2, 3, 4]"
-- expect: run-output "nested: [1, 3, 5] / snapshots: 7 [8, 16]"
-- expect: run-output "in a row: [1, 2, 3] [2, 3, 4] [6, 9, 12]"
-- expect: run-output "failed: [1] [1, 2, 3] / handled in a loop: [0, 1, 3]"
-- expect: run-output "again: [3, 4, 5] [3, 4, 5] / [1, 2, 3]"
module earlier

pub kind Limit = | Full

--- Appends each item of `items` to `xs`, failing at the first one over 9.
fill(edit xs: List[Int], items: List[Int]) -> Unit
  fails Limit
=
  for x in items
    if x > 9
      fail Full
    xs = xs.append(item: x)

--- `xs` with the items of `items` appended, failing at the first one over 9.
filled(xs: List[Int], items: List[Int]) -> List[Int]
  fails Limit
=
  let edit out = xs
  for x in items
    if x > 9
      fail Full
    out = out.append(item: x)
  out

--- `xs` with `rounds` added to each item, one at a time, by two levels of loops.
raised(xs: List[Int], rounds: Int) -> List[Int]
=
  let edit out = xs
  for r in 0..<rounds
    for i in 0..<out.len
      let x = out.at(index: i).or_else(default: 0)
      edit out.set(index: i, item: x + 1)
  out

pub main() -> Unit
  uses @console: Console[print]
=
  let edit xs = [1, 2, 3]
  for i in 0..<xs.len
    let x = xs.at(index: i).or_else(default: 0)
    edit xs.set(index: i, item: x * 10)
  for y in [4, 5]
    xs = xs.append(item: y)
  @console.print("list: {xs}")
  let edit counts: Map[Int, Int] = empty_map()
  for k in [2, 1, 2, 3, 2]
    let n = counts.get(key: k)
      if none use 0
    edit counts.set(key: k, value: n + 1)
  @console.print("map: {counts}")
  let edit ys = [1, 2, 3]
  let kept = ys
  for i in 0..<ys.len
    edit ys.set(index: i, item: 0)
  let edit m: Map[Int, Int] = empty_map()
  edit m.set(key: 1, value: 1)
  let kept_map = m
  for k in 2..3
    edit m.set(key: k, value: k * k)
  @console.print("kept: {kept} / {ys} / {kept_map} / {m}")
  let edit zs = [1, 2]
  let first = fn() -> zs.at(index: 0).or_else(default: 0)
  let size = fn() -> zs.len
  for z in [3, 4]
    zs = zs.append(item: z)
    edit zs.set(index: 0, item: z)
  @console.print("closure: {first()} {size()} / {zs}")
  let edit grid = [0, 0, 0]
  for r in 0..<2
    for i in 0..<grid.len
      let x = grid.at(index: i).or_else(default: 0)
      edit grid.set(index: i, item: x + i + r)
  let edit doubling = [1, 2]
  let edit firsts = 0
  for r in 0..<3
    let snapshot = doubling
    for i in 0..<doubling.len
      let x = doubling.at(index: i).or_else(default: 0)
      edit doubling.set(index: i, item: x * 2)
    firsts = firsts + snapshot.at(index: 0).or_else(default: 0)
  @console.print("nested: {grid} / snapshots: {firsts} {doubling}")
  let edit row = [1, 2, 3]
  let first_copy = row
  for i in 0..<row.len
    let x = row.at(index: i).or_else(default: 0)
    edit row.set(index: i, item: x + 1)
  let second_copy = row
  for i in 0..<row.len
    let x = row.at(index: i).or_else(default: 0)
    edit row.set(index: i, item: x * 3)
  @console.print("in a row: {first_copy} {second_copy} {row}")
  let edit ws = [1]
  fill(edit ws, items: [2, 3, 10, 4])
    if error use unit
  let failed = ws
  fill(edit ws, items: [2, 3])
    if error use unit
  let edit kept_items = [0]
  for item in [1, 20, 3]
    kept_items = filled(kept_items, items: [item])
      if error use kept_items
  @console.print("failed: {failed} {ws} / handled in a loop: {kept_items}")
  let base = [1, 2, 3]
  let once = raised(base, rounds: 2)
  let twice = raised(base, rounds: 2)
  @console.print("again: {once} {twice} / {base}")
