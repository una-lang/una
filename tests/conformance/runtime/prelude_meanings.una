-- test: beyond their contracts, the prelude's functions compute what spec/14 §1 states: the element `first` and `at` return, where `append` puts the item, the order of `map` and `filter`, the first accepted element, the accumulator of `fold`, the exact `sum`, `or_else`, `to_int` on other texts, and `Nat` (#692)
-- spec: spec/14 §1
-- grant: console
-- expect: run-output "first Some(7) None at Some(8)"
-- expect: run-output "append 1 2 3 len 3"
-- expect: run-output "map 10 20 30"
-- expect: run-output "filter 5 4 2"
-- expect: run-output "first_where Some(5) None"
-- expect: run-output "fold abc empty 9"
-- expect: run-output "sum 0 big 18446744073709551616"
-- expect: run-output "or_else 3 9"
-- expect: run-output "to_int lead None trail None"
-- expect: run-output "nat 3"
module prelude_meanings

show_opt(o: Option[Int]) -> Text
=
  when o
    is Some(v) -> "Some({v})"
    is None -> "None"

show(xs: List[Int]) -> Text = fold(xs, initial: "", step: fn(acc,
    x
  ) -> if acc.len == 0 then "{x}" else "{acc} {x}")

pub main() -> Unit
  uses @console: Console[print]
=
  let nothing_yet: List[Int] = []
  let pair = [7, 8]
  @console.print("first {show_opt(first(pair))} {show_opt(first(nothing_yet))} at {show_opt(at(pair, index: 1))}")
  let grown = append([1, 2], item: 3)
  @console.print("append {show(grown)} len {grown.len}")
  let tens = map([1, 2, 3], each: fn(x) -> x * 10)
  @console.print("map {show(tens)}")
  let kept = filter([5, 1, 4, 2], keep: fn(x) -> x > 1)
  @console.print("filter {show(kept)}")
  let found = first_where([1, 5, 7], keep: fn(x) -> x > 4)
  let missing = first_where([1, 2], keep: fn(x) -> x > 4)
  @console.print("first_where {show_opt(found)} {show_opt(missing)}")
  let empty_text = ""
  let joined = fold(["a", "b", "c"], initial: empty_text, step: fn(acc, x) -> "{acc}{x}")
  let start = fold(nothing_yet, initial: 9, step: fn(acc, x) -> acc + x)
  @console.print("fold {joined} empty {start}")
  let big = sum([9223372036854775807, 9223372036854775807, 2])
  @console.print("sum {sum(nothing_yet)} big {big}")
  let some_three: Option[Int] = Some(3)
  let nothing: Option[Int] = None
  @console.print("or_else {or_else(some_three, default: 9)} {or_else(nothing, default: 9)}")
  let lead = " 7"
  let trail = "7 "
  @console.print("to_int lead {show_opt(to_int(lead))} trail {show_opt(to_int(trail))}")
  let n: Nat = 3
  @console.print("nat {n}")
