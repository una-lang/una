-- test: handler installations in quiet code, under a `secret` program counter (through a callee, written directly under the branch, in a started task) and under the conservative rules (an operation body under an effect floor above `public`, a decision on values of a type parameter), stay legal and run as before; quiet code numbers none of its installations, `with:<h>#q`, so no instance id depends on the secret: the native test `s41_the_conformance_case_has_one_trace_for_every_secret` runs this case for several secrets and compares whole traces in both engines (spec/26 §6 rule 4, spec/27 §8, S-41); its data are `internal`, above `public` and so quiet, and at most the `internal` that the schedule of started tasks may depend on, since check points under a `secret` program counter are U4002 in a program that starts tasks (spec/27 §8 rule 5, #1684)
-- spec: spec/26 §6
-- grant: console
-- expect: run-output "done 3"
module installs

capability Sink
  op put(x: Int) -> Unit

capability Box
  op hold(x: Int) -> Unit
    accepts internal

handler keep() for Sink
  op put(x) = unit

handler box() for Box
  op hold(x) = quiet_put()

use_it() -> Unit
  uses @k: Sink[put]
=
  @k.put(1)

quietly() -> Int
=
  let n = 1
  n

inner() -> Unit
=
  let r = quietly() with @k = keep()
  unit

quiet_put() -> Unit
=
  use_it() with @k = keep()

hold_one() -> Unit
  uses @b: Box[hold]
=
  @b.hold(1)

branchy[T](a: T, b: T) -> Unit
=
  if a == b
    quiet_put()

worker(s: internal Int) -> Unit
=
  for i in 0..<3
    if s > i
      inner()
  use_it() with @k = keep()

pub main() -> Unit
  uses @console: Console[print]
=
  let s: internal Int = 2
  for i in 0..<3
    if s > i
      inner()
      let r = quietly() with @k = keep()
      unit
  hold_one() with @b = box()
  branchy(1, b: 1)
  tasks
    start worker(s)
  use_it() with @k = keep()
  @console.print("done 3")
