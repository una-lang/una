-- test: trace arguments are keyed by the source names of the operation's parameters
-- spec: spec/11 §5
-- grant: console
-- expect: run-output "read: 3"
-- expect: test-pass
module store

pub kind E = | Bad

pub capability Store
  op put(k: secret[PII] Int, v: Int) -> Unit
    fails E
    accepts secret[PII]
  op get(k: Int) -> Option[Int]
    fails E

pub save(k: secret[PII] Int, v: Int) -> Option[Int]
  uses @s: Store
  fails E
=
  @s.put(k, v)
    if error pass
  @s.get(v)
    if error pass

handler mem() for Store
  op put(k, v) = unit
  op get(k) = Some(k)

pub main() -> Unit
  uses @console: Console[print]
=
  let read = save(7, v: 3) with @s = mem()
    if error use None
  let n = or_else(read, default: 0)
  @console.print("read: {n}")

example "saves and reads"
  given @s = mem()
  do or_else(save(7, v: 3), default: 0)
  expect result == 3
