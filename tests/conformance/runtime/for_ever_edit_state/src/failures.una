-- test: the state of `for ever` and `for until` taken from an `edit` parameter or a list is released once in native code, whether the loop ends by a failure, by `stop`, or cut by a `within` around the call; `on stop` runs on the state from before the loop after a failure or a cut (spec/26 §4, §5, #1198)
-- spec: spec/26 §5
-- grant: console
-- expect: run-output "on stop after a failure: 0 [7]"
-- expect: run-output "after a failure: [7]"
-- expect: run-output "on stop after a stop: 2 [7, 1, 2]"
-- expect: run-output "after a stop: [7, 1, 2]"
-- expect: run-output "on stop after a cut: 1"
-- expect: run-output "after a cut: [7]"
-- expect: run-output "after until: [7, 1, 2]"
module failures

import std.time (millisecond, second)

pub kind Broken = | Snapped

fail_forever(edit xs: List[Int], count: Int) -> Unit
  uses @console: Console[print]
  fails Broken
  diverges
=
  let edit n = 0
  for ever
    if n == count
      fail Snapped
    n = n + 1
    xs = xs.append(item: n)
  on stop
    @console.print("on stop after a failure: {n} {xs}")
  unit

stop_forever(edit xs: List[Int], count: Int) -> Unit
  uses @console: Console[print]
  diverges
=
  let edit n = 0
  for ever within 60 * second
    stop when n == count
    n = n + 1
    xs = xs.append(item: n)
  on stop
    @console.print("on stop after a stop: {n} {xs}")
  unit

cut_forever(edit xs: List[Int]) -> Unit
  uses @console: Console[print]
  diverges
=
  let edit n = 0
  for ever
    n = n + 1
    xs = if xs.len < 100 then xs.append(item: n) else xs
  on stop
    @console.print("on stop after a cut: {xs.len}")
  unit

until_count(edit xs: List[Int], count: Int) -> Unit
  requires count >= 0
=
  let edit n = 0
  for until n >= count decreases count - n
    n = n + 1
    xs = xs.append(item: n)
  unit

pub main() -> Unit
  uses @console: Console[print]
  diverges
=
  let edit failed = [7]
  fail_forever(edit failed, count: 2)
    if error use unit
  @console.print("after a failure: {failed}")
  let edit stopped = [7]
  stop_forever(edit stopped, count: 2)
  @console.print("after a stop: {stopped}")
  let edit cut = [7]
  cut_forever(edit cut) within 20 * millisecond
    if error use unit
  @console.print("after a cut: {cut}")
  let edit counted = [7]
  until_count(edit counted, count: 2)
  @console.print("after until: {counted}")
