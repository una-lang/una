-- test: `stop after N` is a budget of each `for ever` instance, counted from 0 at each entry: a loop under a `secret` branch that runs any number of iterations does not move where a later public loop stops, a single loop stops at the start of iteration N + 1, each loop of a sequence and each entry of a loop entered again gets N, and the iterations of a `for` loop inside a `for ever` body do not count (spec/26 §6 rule 1, §8 rule 1, ADR 0116 rule 19, #1472)
-- spec: spec/26 §6, §8
-- expect: test-pass
module budgets

--- A `for ever` under a `secret` branch, which runs `s + 1` iterations when `s` is
--- positive, up to its own budget, and none otherwise.
spin(s: secret Int) -> Unit
  diverges
=
  if s > 0
    let edit k: secret Int = 0
    for ever
      stop when k >= s
      k = k + 1

--- A `for ever` under a `secret` branch that only the budget stops.
spin_forever(s: secret Bool) -> Unit
  diverges
=
  if s
    let edit k: secret Int = 0
    for ever
      k = k + 1

--- The iterations a public loop runs after `spin(s)`: the same for every `s`.
pub after_secret(s: secret Int) -> Int
  diverges
=
  spin(s)
  let edit n = 0
  for ever
    n = n + 1
  n

pub after_secret_forever(s: secret Bool) -> Int
  diverges
=
  spin_forever(s)
  let edit n = 0
  for ever
    n = n + 1
  n

--- One loop alone.
pub single() -> Int
  diverges
=
  let edit n = 0
  for ever
    n = n + 1
  n

--- Two loops in a row: each runs its own budget.
pub twice() -> Int
  diverges
=
  let edit first = 0
  for ever
    first = first + 1
  let edit second = 0
  for ever
    second = second + 1
  first * 100 + second

--- A loop that the body of a `for` enters three times: each entry runs its own budget.
pub entered(times: Int) -> Int
  diverges
=
  let edit total = 0
  for i in 0..<times
    total = total + single()
  total

--- A `for` loop inside a `for ever` body: only the `for ever` iterations count.
pub nested() -> Int
  diverges
=
  let edit n = 0
  for ever
    for i in 0..<10
      n = n + 1
  n

test "a secret of 0 leaves the public loop its budget"
  do after_secret(0)
  expect result == 8
  stop after 8

test "a secret of 2 leaves the public loop its budget"
  do after_secret(2)
  expect result == 8
  stop after 8

test "a secret of 5 leaves the public loop its budget"
  do after_secret(5)
  expect result == 8
  stop after 8

test "a secret past the budget leaves the public loop its budget"
  do after_secret(12)
  expect result == 8
  stop after 8

test "a secret loop that only the budget stops leaves the public loop its budget"
  do after_secret_forever(true)
  expect result == 4
  stop after 4

test "with no secret loop the public loop runs the same budget"
  do after_secret_forever(false)
  expect result == 4
  stop after 4

test "a single loop stops at the start of iteration N + 1"
  do single()
  expect result == 3
  stop after 3

test "each loop of a sequence runs its own budget"
  do twice()
  expect result == 303
  stop after 3

test "each entry of a loop runs its own budget"
  do entered(3)
  expect result == 6
  stop after 2

test "a for loop inside a for ever body does not use the budget"
  do nested()
  expect result == 20
  stop after 2
