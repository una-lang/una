-- test: in edition 0.5, `to_stack`, `to_queue`, `to_set`, `to_hash_set` and `to_hash_map` of `std.collections`, called with method syntax on a list, make a stack with the last element of the list on top, a queue with the first element in front, a set of the list's items, each once, a hash set of its items, each once, in the order of first occurrence, and a hash map of its entries, each key in the order of first occurrence with the value of its last entry, on the empty list too; both engines agree (ADR 0119 rules 10 and 16)
-- spec: spec/28 §10
-- grant: console
-- expect: run-output "stack: [1, 2, 1, 4] 4 Some(1)"
-- expect: run-output "queue: [4, 1, 2, 1] 4 Some(4) Some(1)"
-- expect: run-output "set: {1, 2, 4} 3"
-- expect: run-output "empty: [] [] {}"
-- expect: run-output "sorted: {1, 2, 3, 4, 5} {1, 2, 3, 4} {\"a\", \"b\"}"
-- expect: run-output "hash set: {4, 1, 2} 3 {\"b\", \"a\"}"
-- expect: run-output "hash map: {\"b\": 4, \"a\": 2} 2"
-- expect: run-output "hash empty: {} {}"
module conversions

import std.collections (to_hash_map, to_hash_set, to_queue, to_set, to_stack)

pub main() -> Unit
  uses @console: Console[print]
=
  const xs = [4, 1, 2, 1]
  const s = xs.to_stack()
  const q = xs.to_queue()
  const t = xs.to_set()
  @console.print("stack: {s} {s.len} {s.peek()}")
  @console.print("queue: {q} {q.len} {q.peek()} {q.peek_back()}")
  @console.print("set: {t} {t.len}")
  const nothing: List[Int] = []
  @console.print("empty: {nothing.to_stack()} {nothing.to_queue()} {nothing.to_set()}")
  const falling = [5, 4, 3, 2, 1]
  const rising = [1, 2, 3, 4]
  const words = ["b", "a", "b"]
  @console.print("sorted: {falling.to_set()} {rising.to_set()} {words.to_set()}")
  const h = xs.to_hash_set()
  @console.print("hash set: {h} {h.len} {words.to_hash_set()}")
  const es = [Entry(key: "b", value: 1), Entry(key: "a", value: 2), Entry(key: "b", value: 4)]
  const m = es.to_hash_map()
  @console.print("hash map: {m} {m.len}")
  const no_entries: List[Entry[Text, Int]] = []
  @console.print("hash empty: {nothing.to_hash_set()} {no_entries.to_hash_map()}")
