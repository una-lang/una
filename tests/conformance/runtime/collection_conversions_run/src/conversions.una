-- test: in edition 0.4, `to_stack`, `to_queue` and `to_set` of `std.collections`, called with method syntax on a list, make a stack with the last element of the list on top, a queue with the first element in front, and a set of the list's items, each once, on the empty list too; both engines agree (ADR 0119 rule 16)
-- spec: spec/28 §10
-- grant: console
-- expect: run-output "stack: [1, 2, 1, 4] 4 Some(1)"
-- expect: run-output "queue: [4, 1, 2, 1] 4 Some(4) Some(1)"
-- expect: run-output "set: {1, 2, 4} 3"
-- expect: run-output "empty: [] [] {}"
-- expect: run-output "sorted: {1, 2, 3, 4, 5} {1, 2, 3, 4} {\"a\", \"b\"}"
module conversions

import std.collections (to_queue, to_set, to_stack)

pub main() -> Unit
  uses @console: Console[print]
=
  let xs = [4, 1, 2, 1]
  let s = xs.to_stack()
  let q = xs.to_queue()
  let t = xs.to_set()
  @console.print("stack: {s} {s.len} {s.peek()}")
  @console.print("queue: {q} {q.len} {q.peek()} {q.peek_back()}")
  @console.print("set: {t} {t.len}")
  let nothing: List[Int] = []
  @console.print("empty: {nothing.to_stack()} {nothing.to_queue()} {nothing.to_set()}")
  let falling = [5, 4, 3, 2, 1]
  let rising = [1, 2, 3, 4]
  let words = ["b", "a", "b"]
  @console.print("sorted: {falling.to_set()} {rising.to_set()} {words.to_set()}")
