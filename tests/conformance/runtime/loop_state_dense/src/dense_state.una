-- test: in edition 0.5, an array, a matrix and a set that `for` loops update, through one or two levels of loops, hold their final values when read after the loops, while a copy bound before a loop and a closure created before it keep the values from before; a function whose loop updates a copy of its array argument gives the same result when called twice and leaves the argument as it was (#1196, spec/17 §7)
-- spec: spec/17 §7
-- grant: console
-- expect: run-output "array: array([1.0, 2.0, 3.0]) / array([0.0, 0.0, 0.0]) / Some(0.0)"
-- expect: run-output "matrix: matrix(rows: 2, columns: 2, elements: [0.0, 1.0, 2.0, 3.0]) / matrix(rows: 2, columns: 2, elements: [0.0, 0.0, 0.0, 0.0])"
-- expect: run-output "set: {1, 3} / {5}"
-- expect: run-output "doubled: array([2.0, 4.0, 6.0]) array([2.0, 4.0, 6.0]) / array([1.0, 2.0, 3.0])"
module dense_state

import std.collections (Set, empty_set)

--- `a` with each element doubled.
doubled(a: Array[F64]) -> Array[F64]
=
  var out = a
  for i in 0..<out.len
    const x = out.get(index: i)
    edit out.set(index: i, item: x * 2.0)
  out

pub main() -> Unit
  uses @console: Console[print]
=
  const zero = 0.0
  var a = array_filled(length: 3, value: zero)
  const kept = a
  const first = fn() -> a.at(index: 0)
  for i in 0..<a.len
    edit a.set(index: i, item: i.to_f64() + 1.0)
  @console.print("array: {a} / {kept} / {first()}")
  var m = matrix_filled(rows: 2, columns: 2, value: zero)
  const before = m
  for r in 0..<m.rows
    for c in 0..<m.columns
      const v = r * 2 + c
      edit m.set(row: r, column: c, item: v.to_f64())
  @console.print("matrix: {m} / {before}")
  var s: Set[Int] = empty_set()
  edit s.add(item: 5)
  const kept_set = s
  for x in [3, 1, 3]
    edit s.add(item: x)
  for x in [5]
    edit s.remove(item: x)
  @console.print("set: {s} / {kept_set}")
  const sample: Array[F64] = array([1.0, 2.0, 3.0])
  const twice = doubled(sample)
  const again = doubled(sample)
  @console.print("doubled: {twice} {again} / {sample}")
