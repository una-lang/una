-- test: integers of hundreds of limbs, past every threshold of multiplication, division and text conversion, compute and print alike in both engines (#1093)
-- spec: spec/11 §4
-- grant: console
-- expect: run-output "product 814734386"
-- expect: run-output "exact true 0"
-- expect: run-output "division 77936783 892284069"
-- expect: run-output "negative 922063223 269696572 true true"
-- expect: run-output "text 1955 451694074"
-- expect: run-output "read back true"
-- expect: run-output ""
module big

--- `b` squared `k` times: b^(2^k), by products of growing size.
squarings(b: Int, k: Int) -> Int
=
  let edit n = b
  for i in 0..<k
    n = n * n
  n

--- The Euclidean quotient of `a` by `b`, 0 for a zero divisor.
quot(a: Int, b: Int) -> Int = if b == 0 then 0 else a / b

--- The Euclidean remainder of `a` by `b`, 0 for a zero divisor.
rest(a: Int, b: Int) -> Int = if b == 0 then 0 else a mod b

pub main() -> Unit
  uses @console: Console[print]
=
  let m = 1000000007
  -- 3^16384 has 406 limbs and 7^8192 360: their products are Toom-3's, their quotient
  -- Burnikel-Ziegler's.
  let x = squarings(3, k: 14)
  let y = squarings(7, k: 13) + 12345
  let p = x * y
  @console.print("product {rest(p, b: m)}")
  @console.print("exact {quot(p, b: y) == x} {rest(p, b: y)}")
  let n = x * x + y
  @console.print("division {rest(quot(n, b: y), b: m)} {rest(rest(n, b: y), b: m)}")
  let negative = 0 - n
  let q = quot(negative, b: y)
  let r = rest(negative, b: y)
  @console.print("negative {rest(q, b: m)} {rest(r, b: m)} {r >= 0} {q * y + r == negative}")
  -- 3^4096 has 1955 digits, written by divide and conquer and read back.
  let t = squarings(3, k: 12)
  let written = "{t}"
  @console.print("text {written.len} {rest(t, b: m)}")
  let back = or_else(written.to_int(), default: 0)
  @console.print("read back {back == t}")
  @console.print("{squarings(2, k: 11) * 3 - 1}")
