-- test: the body of a reflect predicate and the predicate of `checked` compute integers exactly, as the verifier reads them, even where a fixed-width product leaves its type, so a value at the top of `U32` passes the gate that the proof says it passes (#180, spec/18 §3)
-- spec: spec/18 §3
-- grant: console
-- expect: run-output "top: true, one: false, two: true"
-- expect: run-output "admitted: 1, rejected: 1"
-- expect: run-output "inline: 1, rejected: 1"
-- expect: run-output "past: true, zero: false"
module exact

pub kind Rejected = Small | Odd

pub predicate reflect scaled_large(x: U32) -> Bool = x * 4294967295 > 4294967295

--- A literal past `U32` is exact in a reflect body too: no U2022 (Leonardo, 2026-10-06).
pub predicate reflect past_top(x: U32) -> Bool = x + 4294967296 > 8589934590

pub kind Big = U32 where scaled_large(it)

pub admit(x: U32) -> Big
  fails Rejected
=
  checked(x, scaled_large(it)) else fail Small

pub admit_inline(x: U32) -> U32
  fails Rejected
=
  checked(x, it * 4294967295 > 4294967295) else fail Small

--- 1 for a success, 0 for a failure.
pub counted(r: Result[U32, Rejected]) -> Int
=
  when r
    is Ok(v) -> 1
    is Err(e) -> 0

pub main() -> Unit
  uses @console: Console[print]
=
  let top: U32 = 4294967295
  let one: U32 = 1
  let two: U32 = 2
  @console.print("top: {scaled_large(top)}, one: {scaled_large(one)}, two: {scaled_large(two)}")
  let a = attempt admit(top)
  let b = attempt admit(one)
  @console.print("admitted: {counted(a)}, rejected: {1 - counted(b)}")
  let c = attempt admit_inline(top)
  let d = attempt admit_inline(one)
  @console.print("inline: {counted(c)}, rejected: {1 - counted(d)}")
  let zero: U32 = 0
  @console.print("past: {past_top(top)}, zero: {past_top(zero)}")
