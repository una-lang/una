-- test: under the virtual clock of tests, a `tasks` statement waits for its tasks, at most its bound at once; a block that fails cancels the tasks it started, here before they ran; a started task past `--task-depth` ends alone; and a host stop ends the `for ever` of the block, whose `on stop` runs before its tasks drain (spec/27 §7, spec/26 §8, ADR 0117 rules 7 and 11)
-- spec: spec/27 §7
-- expect: test-pass
module jobs

pub capability Log
  op write(line: Text) -> Unit

pub handler quiet() for Log
  op write(line) = unit

pub kind JobError = Broken | Lost

log_job(n: Int) -> Unit
  uses @log: Log[write]
=
  @log.write("job {n}")

check(n: Int) -> Unit
  fails JobError
=
  if n < 0 then fail Broken else unit

deep(n: Int) -> Int = if n == 0 then 0 else deep(n - 1) + 1

dive(n: Int) -> Unit
  uses @log: Log[write]
=
  let d = deep(n)
  @log.write("dove {d}")

pub every(n: Int) -> Int
  uses @log: Log[write]
=
  tasks at most 2 at once
    for job in 1..n
      start log_job(job)
  n

pub failing(n: Int) -> Unit
  uses @log: Log[write]
  fails JobError
=
  tasks
    start log_job(n)
    check(-1)
      if error pass

pub dives() -> Int
  uses @log: Log[write]
=
  tasks
    start dive(100000)
    start dive(3)
  1

pub serve() -> Int
  uses @log: Log[write]
  diverges
=
  let edit served = 0
  tasks at most 4 at once
    for ever
      start log_job(served)
      served = served + 1
    on stop
      @log.write("stopping after {served}")
  served

example "a tasks statement waits for its tasks, two at once"
  given @log = quiet()
  do every(5)
  expect result == 5
  expect performed @log.write

example "a failing block cancels its tasks, which here never run"
  given @log = quiet()
  do failing(1)
  expect fails Broken
  expect not performed @log.write

example "a started task past --task-depth ends alone, and the others run on"
  given @log = quiet()
  do dives()
  expect result == 1
  expect performed @log.write

example "a host stop ends the for ever of the block, then its tasks drain"
  given @log = quiet()
  do serve()
  expect result == 3
  expect performed @log.write
  stop after 3
