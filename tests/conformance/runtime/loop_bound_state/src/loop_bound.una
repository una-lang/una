-- test: a loop evaluates its source once, so a body that updates the bindings the source names changes neither the range's bounds nor the list it visits, whether the bounds are small or big integers (#182, spec/17 §4)
-- spec: spec/17 §4
-- grant: console
-- expect: run-output "big: 4611686018427387914"
-- expect: run-output "inclusive: 4611686018427387907 4611686018427387905"
-- expect: run-output "small: 10"
-- expect: run-output "list: 2 6"
-- expect: run-output "failed: early 3"
module loop_bound

pub kind Stop = Early | Late

--- Counts up from a big start until `limit`, failing at `at` steps.
pub stops(limit: Int, at: Int) -> Int
  fails Stop
=
  let start = 4611686018427387900 + 1
  let edit end = start + limit
  let edit steps = 0
  for i in start..<end
    if steps == at
      fail Early
    end = i
    steps = steps + 1
  steps

--- The count, or `early`.
pub shown(r: Result[Int, Stop]) -> Text
=
  when r
    is Ok(k) -> "{k}"
    is Err(e) -> "early"

pub main() -> Unit
  uses @console: Console[print]
=
  let base = 4611686018427387900
  let edit n = base + 5
  for i in base..<n
    n = i + 10
  @console.print("big: {n}")
  let edit low = 4611686018427387900
  let edit high = base + 6
  for i in low..high
    high = i + 1
    low = i - 1
  @console.print("inclusive: {high} {low}")
  let edit m = 5
  for i in 0..<m
    m = i + 6
  @console.print("small: {m}")
  let edit xs = [1, 2, 3]
  let edit sum = 0
  for x in xs
    xs = [x, x]
    sum = sum + x
  @console.print("list: {xs.len} {sum}")
  let stopped = attempt stops(4, at: 2)
  let finished = attempt stops(3, at: 9)
  @console.print("failed: {shown(stopped)} {shown(finished)}")
