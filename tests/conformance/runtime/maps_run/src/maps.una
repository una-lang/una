-- test: maps list their entries in key order for big and tagged integers, fixed-width integers, texts by scalar values and variants, render as {k: v}, compare structurally, keep value semantics through a binding, a closure and a record, and cross together tasks, in both engines (spec/21 §2, §5)
-- spec: spec/21 §5
-- grant: console
-- expect: run-output "counts: {\"a\": 1, \"b\": 3, \"c\": 1} 3"
-- expect: run-output "ints: [-5, 4611686018427387904, 9223372036854775807]"
-- expect: run-output "fixed: {7: false, 200: true}"
-- expect: run-output "texts: [\"Z\", \"z\", \"é\"]"
-- expect: run-output "colors: [Entry(key: Red, value: 1), Entry(key: Blue, value: 3)]"
-- expect: run-output "kept: {\"a\": 1, \"c\": 1, \"d\": 4} / {\"a\": 1, \"b\": 3, \"c\": 1} / 3 / {\"a\": 1, \"b\": 3, \"c\": 1}"
-- expect: run-output "equal: false true"
-- expect: run-output "absent: None false Some(4)"
-- expect: run-output "tasks: [{\"x\": 1, \"y\": 1}, {\"y\": 1}]"
module maps

pub kind Color = Red | Green | Blue

pub kind Box
  counts: Map[Text, Int]

count_words(words: List[Text]) -> Map[Text, Int]
=
  let edit counts: Map[Text, Int] = empty_map()
  for word in words
    let n = counts.get(key: word)
      if none use 0
    edit counts.set(key: word, value: n + 1)
  counts

pub main() -> Unit
  uses @console: Console[print]
=
  let counts = count_words(["b", "a", "b", "c", "b"])
  @console.print("counts: {counts} {counts.len}")
  let no_ints: Map[Int, Text] = empty_map()
  let big = no_ints.with(key: 9223372036854775807, value: "max").with(key: -5,
    value: "neg"
  ).with(key: 4611686018427387904, value: "tag")
  @console.print("ints: {big.keys()}")
  let fixed: Map[U8, Bool] = empty_map()
  @console.print("fixed: {fixed.with(key: 200, value: true).with(key: 7, value: false)}")
  let no_texts: Map[Text, Int] = empty_map()
  let texts = no_texts.with(key: "é", value: 1).with(key: "z", value: 2).with(key: "Z", value: 3)
  @console.print("texts: {texts.keys()}")
  let colors: Map[Color, Int] = empty_map()
  @console.print("colors: {colors.with(key: Blue, value: 3).with(key: Red, value: 1).entries()}")
  let edit kept = counts
  let seen = fn() -> kept.len
  let box = Box(counts: kept)
  edit kept.remove(key: "b")
  edit kept.set(key: "d", value: 4)
  @console.print("kept: {kept} / {counts} / {seen()} / {box.counts}")
  let again = count_words(["c", "b", "a", "b", "b"])
  @console.print("equal: {kept == counts} {counts == again}")
  let b = "b"
  let d = "d"
  @console.print("absent: {kept.get(key: b)} {kept.has(key: b)} {kept.get(key: d)}")
  let parts = together for words in [["x", "y"], ["y"]]
    count_words(words)
  @console.print("tasks: {parts}")
