-- test: parse_decimal accepts a coefficient of exactly 4,300 digits and refuses one of 4,301 with TooLong, in both engines
-- spec: spec/29 §16
-- grant: console
-- expect: run-output "true Err(TooLong)"
module m

parsed(t: Text) -> Result[Decimal[2], ParseError] = attempt parse_decimal(t, scale: 2)

pub main() -> Unit
  uses @console: Console[print]
=
  const a1 = "9"
  const a2 = "{a1}{a1}"
  const a4 = "{a2}{a2}"
  const a8 = "{a4}{a4}"
  const a16 = "{a8}{a8}"
  const a32 = "{a16}{a16}"
  const a64 = "{a32}{a32}"
  const a128 = "{a64}{a64}"
  const a256 = "{a128}{a128}"
  const a512 = "{a256}{a256}"
  const a1024 = "{a512}{a512}"
  const a2048 = "{a1024}{a1024}"
  const a4096 = "{a2048}{a2048}"
  const whole = "{a4096}{a128}{a64}{a8}{a2}"
  const at_cap = "{whole}.99"
  const over = "{whole}9.99"
  @console.print("{parsed(at_cap).is_ok()} {parsed(over)}")
