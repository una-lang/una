-- test: parse_decimal accepts a coefficient of exactly 4,300 digits and refuses one of 4,301 with TooLong, in both engines
-- spec: spec/29 §16
-- grant: console
-- expect: run-output "true Err(TooLong)"
module m

parsed(t: Text) -> Result[Decimal[2], ParseError] = attempt parse_decimal(t, scale: 2)

pub main() -> Unit
  uses @console: Console[print]
=
  let a1 = "9"
  let a2 = "{a1}{a1}"
  let a4 = "{a2}{a2}"
  let a8 = "{a4}{a4}"
  let a16 = "{a8}{a8}"
  let a32 = "{a16}{a16}"
  let a64 = "{a32}{a32}"
  let a128 = "{a64}{a64}"
  let a256 = "{a128}{a128}"
  let a512 = "{a256}{a256}"
  let a1024 = "{a512}{a512}"
  let a2048 = "{a1024}{a1024}"
  let a4096 = "{a2048}{a2048}"
  let whole = "{a4096}{a128}{a64}{a8}{a2}"
  let at_cap = "{whole}.99"
  let over = "{whole}9.99"
  @console.print("{parsed(at_cap).is_ok()} {parsed(over)}")
