-- test: an operation served by a handler that quiet code installed, `with:<h>#q`, appends no event: a function with no effects of its own that installs a handler and performs an operation, called under a `secret` branch (directly, through a chain of calls, in a loop, through a `secret` function value, in a task started at a `public` program counter, with a failing operation, and for a capability that accepts `secret`), runs as before, and the native test `l1544_the_conformance_case_has_one_trace_for_every_secret` runs this case for several secrets and compares whole traces in both engines (spec/26 §6 rule 4, #1544)
-- spec: spec/26 §6
-- grant: console
-- expect: run-output "done"
module local

pub kind Oops = Bad | Worse

capability Sink
  op put(x: Int) -> Unit

capability Vault
  op keep(x: secret Int) -> Unit
    accepts secret

capability Flaky
  op try(x: Int) -> Unit
    fails Oops

handler keep() for Sink
  op put(x) = unit

handler vault() for Vault
  op keep(x) = unit

handler flaky() for Flaky
  op try(x) = fail Bad

use_it() -> Unit
  uses @k: Sink[put]
=
  @k.put(1)

pinger() -> Unit
=
  use_it() with @k = keep()

direct() -> Unit
=
  @k.put(2) with @k = keep()

chain() -> Unit = pinger()

stash(s: secret Int) -> Unit
=
  @v.keep(s) with @v = vault()

flake() -> Int
=
  let r = trying() with @f = flaky()
    if error use unit
  1

trying() -> Unit
  uses @f: Flaky[try]
  fails Oops
=
  @f.try(1)
    if error pass

nothing() -> Unit = unit

worker(s: secret Int) -> Unit
=
  if s > 0
    pinger()
  use_it() with @k = keep()

pub main() -> Unit
  uses @console: Console[print]
=
  let s: secret Int = 2
  if s > 0
    pinger()
    direct()
  for i in 0..<3
    if s > i
      chain()
  let f = if s > 1 then pinger else nothing
  f()
  if s > 2
    let r = flake()
    unit
  if s > 0
    stash(s)
  tasks
    start worker(s)
  use_it() with @k = keep()
  @console.print("done")
