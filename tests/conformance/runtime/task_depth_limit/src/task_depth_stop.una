-- test: a task of a block that recurses past the maximum call depth aborts the run with U6003 at the call, never past its stack (spec/27 §4 rule 2)
-- spec: spec/27 §4
-- grant: console
-- expect: run-output "starting"
-- expect: error U6003 at src/task_depth_stop.una:9:50
module task_depth_stop

--- Never reaches 0 from a negative `n`.
countdown(n: Int) -> Int = if n == 0 then 0 else countdown(n - 1)

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("starting")
  together
    let x = countdown(-1)
    let y = countdown(3)
  @console.print("finished after {x} {y}")
