-- test: integers have arbitrary precision
-- spec: spec/11 §4
-- grant: console
-- expect: run-output "25! = 15511210043330985984000000"
-- expect: run-output "negated: -15511210043330985984000000"
-- expect: run-output "squared exceeds it: true"
module conformance.runtime.big_integers

factorial(n: Int) -> Int = if n <= 1 then 1 else n * factorial(n - 1)

pub main() -> Unit
  uses @console: Console[print]
=
  let big = factorial(25)
  @console.print("25! = {big}")
  let negated = 0 - big
  @console.print("negated: {negated}")
  let exceeds = big * big > big
  @console.print("squared exceeds it: {exceeds}")
