-- test: a `for ever` under a `secret` program counter, and a call of a function that says `diverges` under one, stay legal and run as before: `stop when` ends them, `on stop` runs, and the public loop after them is unchanged; a host stop that ends such a loop appends no `stop` event, which the native tests compare across secrets in both engines (spec/26 §6 rule 4, S-39)
-- spec: spec/26 §6
-- grant: console
-- expect: run-output "public loop ran 3"
-- expect: run-output "done"
module quiet

count_to(s: secret Int) -> secret Int
  diverges
=
  let edit k: secret Int = 0
  if s > 0
    for ever
      stop when k >= s
      k = k + 1
    on stop
      k = k + 0
  k

spin(s: secret Int) -> Unit
  diverges
=
  let edit k = 0
  for ever
    stop when k == 4
    k = k + 1

pub main() -> Unit
  uses @console: Console[print]
  diverges
=
  let s: secret Int = 5
  let r = count_to(s)
  if r > 2
    spin(s)
  let edit n = 0
  for ever
    stop when n == 3
    n = n + 1
  on stop
    @console.print("public loop ran {n}")
  @console.print("done")
