-- test: each expectation form holds against the result and the trace of the do line
-- spec: spec/08 §2
-- expect: test-pass
module conformance.runtime.examples_pass

pub kind StoreError = Offline | Full

pub capability Store
  op put(key: Int) -> Unit
    fails StoreError

pub handler memory() for Store
  op put(key) = unit

pub handler offline() for Store
  op put(key) = fail Offline

pub save(key: Int) -> Int
  uses @store: Store[put]
  fails StoreError
=
  @store.put(key)
    if error pass
  key + 1

pub skip(key: Int) -> Int = key

example "a saved key is stored"
  given @store = memory()
  do save(4)
  expect result == 5
  expect performed @store.put

example "an offline store fails after trying"
  given @store = offline()
  do save(4)
  expect fails Offline
  expect performed @store.put

example "skipping stores nothing"
  given @store = memory()
  do skip(4)
  expect result == 4
  expect not performed @store.put
