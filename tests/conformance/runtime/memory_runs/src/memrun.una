-- test: updates run as their desugared forms: a field update, an edit receiver, a failed call that leaves its edit argument unchanged, `if none` after an edit call, `set`, and `if` without `else` (spec/17 §4, §7 rule 1)
-- spec: spec/17 §4, §7
-- grant: console
-- expect: run-output "5 1 102 1 7 5 10"
module memrun

pub kind Tally
  count: Int
  label: Text

pub kind Oops = Bad | Worse

add(edit t: Tally, by: Int) -> Unit
=
  t.count = t.count + by

risky(edit n: Int, go: Bool) -> Unit
  fails Oops
=
  n = n + 100
  if go
    fail Bad
  n = n + 1

find(edit xs: List[Int], at: Int) -> Option[Int]
=
  if at >= 0 and at < xs.len
    set(edit xs, index: at, item: 0)
    Some(1)
  else
    None

pub main() -> Unit
  uses @console: Console[print]
=
  let edit t = Tally(count: 0, label: "a")
  add(edit t, by: 2)
  edit t.add(by: 3)
  let edit n = 1
  risky(edit n, go: true)
    if error use unit
  let failed = n
  risky(edit n, go: false)
    if error use unit
  let edit xs = [5, 6]
  let hit = find(edit xs, at: 1)
    if none use 7
  let miss = find(edit xs, at: 9)
    if none use 7
  let edit k = 0
  if t.count > 4
    k = 10
  @console.print("{t.count} {failed} {n} {hit} {miss} {xs.sum} {k}")
