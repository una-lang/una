-- test: a read and a write below a directory that does not exist in the granted directory fail with NotFound, at any depth, behind a directory that exists, and whatever follows the missing directory, a NUL included: confinement answers, and no directory is created
-- spec: spec/14 §3
-- grant: console
-- grant: files:data:read,write
-- expect: run-output "read below a missing directory: not found"
-- expect: run-output "write below a missing directory: not found"
-- expect: run-output "read two directories below it: not found"
-- expect: run-output "write two directories below it: not found"
-- expect: run-output "read below one missing in a directory that exists: not found"
-- expect: run-output "write below one missing in a directory that exists: not found"
-- expect: run-output "read of a name with a NUL below it: not found"
-- expect: run-output "write of a name with a NUL below it: not found"
-- expect: run-output "read again after the writes: not found"
module main

describe(failure: FileError) -> Text
=
  when failure
    is NotFound -> "not found"
    is Denied -> "denied"
    is Io -> "io"

show(path: Text) -> Text
  uses @files: Files[read]
=
  let content = attempt @files.read(path)
  when content
    is Ok -> "read"
    is Err(failure) -> describe(failure)

save(path: Text) -> Text
  uses @files: Files[write]
=
  let saved = attempt @files.write(path, content: "entry")
  when saved
    is Ok -> "written"
    is Err(failure) -> describe(failure)

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  let r0 = show("missing/new.txt")
  @console.print("read below a missing directory: {r0}")
  let r1 = save("missing/new.txt")
  @console.print("write below a missing directory: {r1}")
  let r2 = show("missing/deeper/new.txt")
  @console.print("read two directories below it: {r2}")
  let r3 = save("missing/deeper/new.txt")
  @console.print("write two directories below it: {r3}")
  let r4 = show("sub/missing/new.txt")
  @console.print("read below one missing in a directory that exists: {r4}")
  let r5 = save("sub/missing/new.txt")
  @console.print("write below one missing in a directory that exists: {r5}")
  let r6 = show("missing/a\u{0}b")
  @console.print("read of a name with a NUL below it: {r6}")
  let r7 = save("missing/a\u{0}b")
  @console.print("write of a name with a NUL below it: {r7}")
  let r8 = show("missing/new.txt")
  @console.print("read again after the writes: {r8}")
