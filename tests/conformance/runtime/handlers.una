-- test: with installs a handler instance whose operations run with the handler's own capabilities
-- spec: spec/11 §4
-- grant: console
-- expect: run-output "next: 42"
-- expect: run-output "log: a one"
-- expect: run-output "log: a two"
-- expect: run-output "journal: b one"
-- expect: run-output "journal: b two"
module conformance.runtime.handlers

pub capability Counter
  op next() -> Int

pub handler starting_at(start: Int) for Counter
  op next() = start + 1

pub capability Log
  op write(line: Text) -> Unit

pub handler console_log(prefix: Text) for Log
  uses @console: Console[print]
  op write(line) = @console.print("{prefix}{line}")

pub twice(label: Text) -> Unit
  uses @log: Log[write]
=
  @log.write("{label} one")
  @log.write("{label} two")

pub journaled(label: Text) -> Unit
  uses @journal: Log[write]
=
  twice(label) with @log = @journal

pub main() -> Unit
  uses @console: Console[print]
=
  let n = @counter.next() with @counter = starting_at(41)
  @console.print("next: {n}")
  twice("a") with @log = console_log("log: ")
  journaled("b") with @journal = console_log("journal: ")
