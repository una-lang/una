-- test: units on the new numbers are erased before code generation and leave every value unchanged (ADR 0120 rule 65): an F64 converted up and down by its literal ratio, F32 products and a conversion between the float types, a decimal converted to cents exactly, a complex value and its squared norm, and an array's sum and dot product, each the value of the same program without units
-- spec: spec/25 §7, §9
-- grant: console
-- expect: run-output "f64 1500.0 1.5 1500.0 3.0"
-- expect: run-output "f32 0.0625 0.25"
-- expect: run-output "decimal 1999.00 20.00"
-- expect: run-output "complex complex(re: 3.0, im: -4.0) 25.0 3.0"
-- expect: run-output "dense 6.0 12.0"
module measures

pub measure Meter

pub measure Kilometer = 1000 * Meter

pub measure Usd

pub measure Cent = Usd / 100

pub main() -> Unit
  uses @console: Console[print]
=
  const k: F64 of Kilometer = 1.5
  const m: F64 of Meter = k.convert()
  const back: F64 of Kilometer = m.convert()
  @console.print("f64 {m} {back} {m.magnitude()} {k + k}")
  const short: F32 of Meter = 0.25
  @console.print("f32 {short * short} {short.to_f64()}")
  const price: Decimal[2] of Usd = 19.99
  const cents: Decimal[2] of Cent = price.convert()
  @console.print("decimal {cents} {price + 0.01}")
  const z: Complex[F64] of Meter = complex(re: 3.0, im: -4.0)
  @console.print("complex {z} {z.norm_sqr()} {z.re}")
  const two: F64 of Meter = 2.0
  const a: Array[F64 of Meter] = array_filled(length: 3, value: two)
  @console.print("dense {a.sum()} {a.dot(with: a)}")
