-- test: division and remainder are Euclidean for every sign combination and for operands beyond 64 bits, which never overflow (review control)
-- spec: spec/11 §4
-- grant: console
-- expect: run-output "7 / 2 = 3, 7 mod 2 = 1"
-- expect: run-output "-7 / 2 = -4, -7 mod 2 = 1"
-- expect: run-output "7 / -2 = -3, 7 mod -2 = 1"
-- expect: run-output "-7 / -2 = 4, -7 mod -2 = 1"
-- expect: run-output "-8 / -2 = 4, -8 mod -2 = 0"
-- expect: run-output "0 / -3 = 0, 0 mod -3 = 0"
-- expect: run-output "-1 / 100000000000000000000000000000 = -1, -1 mod 100000000000000000000000000000 = 99999999999999999999999999999"
-- expect: run-output "-100000000000000000000000000001 / -100000000000000000000000000000 = 2, -100000000000000000000000000001 mod -100000000000000000000000000000 = 99999999999999999999999999999"
-- expect: run-output "big 9999999999999999999999999999999800000000000000000000000000000001"
-- expect: run-output "neg 9223372036854775808 -9223372036854775809 9223372036854775808"
-- Promoted from the v0.1 review, adversarial `runtime-euclidean-division`, without its line of negative literal divisors, which R-031 covers.
module euclidean_division_signs

show(a: Int, b: Int) -> Text
  requires b != 0
=
  "{a} / {b} = {a / b}, {a} mod {b} = {a mod b}"

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print(show(7, b: 2))
  @console.print(show(-7, b: 2))
  @console.print(show(7, b: -2))
  @console.print(show(-7, b: -2))
  @console.print(show(-8, b: -2))
  @console.print(show(0, b: -3))
  @console.print(show(-1, b: 100000000000000000000000000000))
  @console.print(show(-100000000000000000000000000001, b: -100000000000000000000000000000))
  @console.print("big {99999999999999999999999999999999 * 99999999999999999999999999999999}")
  @console.print("neg {-(-9223372036854775808)} {-9223372036854775808 - 1} {9223372036854775807 + 1}")
