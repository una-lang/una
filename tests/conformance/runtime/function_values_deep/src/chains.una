-- test: a loop nests values through function values, each closing over the previous one, in a record or alone, deeper than the call depth, and releasing them does not overflow the stack in either engine (spec/17 §4, ADR 0032)
-- spec: spec/17 §4
-- grant: console
-- expect: run-output "built 2000000 2000000"
module chains

pub kind Link = End | Next(rest: fn() -> Link)

--- A chain of `n` records, each holding a function value that closes over the one before.
pub through_records(n: Int) -> Int
=
  let edit link: Link = End
  let edit count = 0
  for i in 0..<n
    let previous = link
    link = Next(rest: fn() -> previous)
    count = count + 1
  count

--- A chain of `n` function values, each closing over the one before.
pub through_functions(n: Int) -> Int
=
  let edit f: fn() -> Int = fn() -> 0
  let edit count = 0
  for i in 0..<n
    let previous = f
    f = fn() -> previous() + 1
    count = count + 1
  count

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("built {through_records(n: 2000000)} {through_functions(n: 2000000)}")
