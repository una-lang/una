-- test: `for ever` runs its body until `stop`, then `on stop` runs with the bindings the body updated, and execution goes on after the loop, in both engines (spec/26 §5, ADR 0116 rules 8 and 10)
-- spec: spec/26 §5
-- grant: console
-- expect: run-output "alive 0"
-- expect: run-output "alive 1"
-- expect: run-output "alive 2"
-- expect: run-output "stopped at 3"
-- expect: run-output "after 3"
module alive

pub main() -> Unit
  uses @console: Console[print]
  diverges
=
  let edit n = 0
  for ever
    stop when n == 3
    @console.print("alive {n}")
    n = n + 1
  on stop
    @console.print("stopped at {n}")
  @console.print("after {n}")
