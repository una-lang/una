-- test: two tasks started by one `tasks` statement each install two handlers and perform an operation on each instance; installations are numbered run-wide in the order they happen, `with:<h>#<n>`, so under the interpreter's schedule, which both engines follow under `--virtual-time`, the first task's instances are `#1` and `#2` and the second's `#3` and `#4`, while under the real clock native code numbers them in the order of real time across tasks: the native test `started_tasks_number_installations_run_wide_in_schedule_order` compares whole traces under virtual time and, under the real clock, each task's events with the instance ids up to one renumbering of the run (spec/27 §8 rules 1, 3 and 4, spec/16 §5)
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "w 1"
-- expect: run-output "w 2"
-- expect: run-output "done"
module installs

capability Sink
  op put(x: Int) -> Unit

handler keep() for Sink
  op put(x) = unit

use_it(x: Int) -> Unit
  uses @k: Sink[put]
=
  @k.put(x)

worker(n: Int) -> Unit
  uses @console: Console[print]
=
  use_it(n) with @k = keep()
  use_it(n + 10) with @k = keep()
  @console.print("w {n}")

pub main() -> Unit
  uses @console: Console[print]
=
  tasks
    start worker(1)
    start worker(2)
  @console.print("done")
