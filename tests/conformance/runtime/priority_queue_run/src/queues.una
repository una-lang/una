-- test: in edition 0.5, a `PriorityQueue` gives back the item of the first priority, the least for `lowest_first` and the greatest for `highest_first`, and among equal priorities the one pushed first; `pop`, `pop_ranked`, `peek` and `peek_priority` give `None` on an empty queue, `items()` and the Una form list the items in the order of the pops, `Text` priorities order by their scalar values, and a copy keeps its value when the original changes; both engines agree (ADR 0119 rule 13)
-- spec: spec/28 §8
-- grant: console
-- expect: run-output "empty: [] 0 None None [] None none"
-- expect: run-output "lowest: [\"chest pain\", \"cut\", \"sprained ankle\", \"fever\", \"cough\"] len 5 next Some(\"chest pain\") at Some(1)"
-- expect: run-output "popped: Some(\"chest pain\") cut@2, now [\"sprained ankle\", \"fever\", \"cough\"], saved [\"chest pain\", \"cut\", \"sprained ankle\", \"fever\", \"cough\"]"
-- expect: run-output "drained: Some(\"sprained ankle\") Some(\"fever\") Some(\"cough\") None [] 0"
-- expect: run-output "highest: [2, 5, 1, 4, 0, 3] len 6 next Some(2) at Some(2)"
-- expect: run-output "copy: [2, 5, 1, 4, 0, 3] top 14 jobs [2, 5, 1, 4, 0, 3]"
-- expect: run-output "texts: [2, 3, 1] Some(\"apple\")"
module queues

import std.collections (PriorityQueue, Ranked, highest_first, lowest_first)

--- The item and the priority of a ranked entry, or `none`.
shown(r: Option[Ranked[Text, Int]]) -> Text
=
  when r
    is Some(x) -> "{x.item}@{x.priority}"
    is None -> "none"

--- The item plus the priority of a ranked entry, or 0.
score(r: Option[Ranked[Int, Int]]) -> Int
=
  when r
    is Some(x) -> x.item + x.priority
    is None -> 0

--- A triage line, the least priority first.
triage() -> Unit
  uses @console: Console[print]
=
  var waiting: PriorityQueue[Text, Int] = lowest_first()
  const nothing = edit waiting.pop()
  const no_rank = edit waiting.pop_ranked()
  @console.print("empty: {waiting} {waiting.len} {waiting.peek()} {waiting.peek_priority()} {waiting.items()} {nothing} {shown(no_rank)}")
  edit waiting.push(item: "sprained ankle", priority: 3)
  edit waiting.push(item: "chest pain", priority: 1)
  edit waiting.push(item: "fever", priority: 3)
  edit waiting.push(item: "cut", priority: 2)
  edit waiting.push(item: "cough", priority: 3)
  const saved = waiting
  @console.print("lowest: {waiting} len {waiting.len} next {waiting.peek()} at {waiting.peek_priority()}")
  const first = edit waiting.pop()
  const second = edit waiting.pop_ranked()
  @console.print("popped: {first} {shown(second)}, now {waiting.items()}, saved {saved}")
  const a = edit waiting.pop()
  const b = edit waiting.pop()
  const c = edit waiting.pop()
  const d = edit waiting.pop()
  @console.print("drained: {a} {b} {c} {d} {waiting} {waiting.len}")

--- Jobs, the greatest priority first, with ties in push order.
jobs() -> Unit
  uses @console: Console[print]
=
  var jobs: PriorityQueue[Int, Int] = highest_first()
  for i in 0..<6
    edit jobs.push(item: i, priority: i mod 3)
  @console.print("highest: {jobs} len {jobs.len} next {jobs.peek()} at {jobs.peek_priority()}")
  var copy = jobs
  edit copy.push(item: 9, priority: 5)
  const top = edit copy.pop_ranked()
  @console.print("copy: {copy.items()} top {score(top)} jobs {jobs}")
  var words: PriorityQueue[Int, Text] = lowest_first()
  edit words.push(item: 1, priority: "pear")
  edit words.push(item: 2, priority: "apple")
  edit words.push(item: 3, priority: "fig")
  @console.print("texts: {words} {words.peek_priority()}")

pub main() -> Unit
  uses @console: Console[print]
=
  triage()
  jobs()
