-- test: the memory budget of a dense buffer of integers counts the heap that each element's copy allocates of its own, so filling an array of ten million elements with an integer of 1,200 digits stops with U6003 before any allocation, though the element slots alone would fit
-- spec: spec/29 §17
-- grant: console
-- expect: run-output "starting"
-- expect: error U6003 at src/dense.una:15:16
module dense

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("starting")
  var big = 1
  for i in 0..<1200
    big = big * 10
  const wide = array_filled(length: 10000000, value: big)
  @console.print("length {wide.len}")
