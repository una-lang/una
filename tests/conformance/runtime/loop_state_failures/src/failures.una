-- test: in edition 0.4, a list that a loop updates keeps its value from before when the loop's body fails, under `if error use`, under `attempt` and in a handler inside another loop, and when a `within` cuts the loop or the `for ever` around it, whose `on stop` sees the values from before; a loop that ends within its deadline, a `for ever within` that stops, and updates under `within` in a loop's body leave the final values, read after the loop, in both engines (#1196, spec/17 §7)
-- spec: spec/17 §7
-- grant: console
-- expect: run-output "failed: [1]"
-- expect: run-output "filled: [1, 2, 3]"
-- expect: run-output "attempt: false [1] / [1]"
-- expect: run-output "handled in a loop: [0, 1, 3]"
-- expect: run-output "in time: [4, 5]"
-- expect: run-output "cut: [4, 5]"
-- expect: run-output "within in a loop: {1: 2, 2: 1}"
-- expect: run-output "on stop after a failure: 0 [7]"
-- expect: run-output "after a failure: [7]"
-- expect: run-output "on stop after a stop: 2 [7, 1, 2]"
-- expect: run-output "after a stop: [7, 1, 2]"
-- expect: run-output "on stop after a cut: 0 {1: 0}"
-- expect: run-output "after a cut: {1: 0}"
module failures

import std.time (millisecond, second)

pub kind Limit = | Full

--- Appends each item of `items` to `xs`, failing at the first one over 9.
fill(edit xs: List[Int], items: List[Int]) -> Unit
  fails Limit
=
  for x in items
    if x > 9
      fail Full
    xs = xs.append(item: x)

--- `xs` with the items of `items` appended, failing at the first one over 9.
filled(xs: List[Int], items: List[Int]) -> List[Int]
  fails Limit
=
  let edit out = xs
  for x in items
    if x > 9
      fail Full
    out = out.append(item: x)
  out

--- Raises every item of `xs` by one, `rounds` times over, through two levels of loops.
raise(edit xs: List[Int], rounds: Int) -> Unit
=
  for r in 0..<rounds
    for i in 0..<xs.len
      let x = xs.at(index: i).or_else(default: 0)
      edit xs.set(index: i, item: x + 1)

--- Appends 1, 2, ... to `xs`, and fails in the third iteration.
fail_forever(edit xs: List[Int]) -> Unit
  uses @console: Console[print]
  fails Limit
  diverges
=
  let edit n = 0
  for ever
    n = n + 1
    if n == 3
      fail Full
    xs = xs.append(item: n)
  on stop
    @console.print("on stop after a failure: {n} {xs}")
  unit

--- Appends 1 to `count` to `xs`, each iteration under a deadline, then stops.
stop_forever(edit xs: List[Int], count: Int) -> Unit
  uses @console: Console[print]
  diverges
=
  let edit n = 0
  for ever within 60 * second
    stop when n == count
    n = n + 1
    xs = xs.append(item: n)
  on stop
    @console.print("on stop after a stop: {n} {xs}")
  unit

--- Counts in `m` until something outside cuts the loop.
cut_forever(edit m: Map[Int, Int]) -> Unit
  uses @console: Console[print]
  diverges
=
  let edit n = 0
  for ever
    n = n + 1
    edit m.set(key: 1, value: n)
  on stop
    @console.print("on stop after a cut: {n} {m}")
  unit

pub main() -> Unit
  uses @console: Console[print]
  diverges
=
  let edit xs = [1]
  fill(edit xs, items: [2, 3, 10, 4])
    if error use unit
  @console.print("failed: {xs}")
  fill(edit xs, items: [2, 3])
    if error use unit
  @console.print("filled: {xs}")
  let base = [1]
  let tried = attempt filled(base, items: [5, 10])
  let fallback = filled(base, items: [5, 10])
    if error use base
  @console.print("attempt: {tried.is_ok()} {fallback} / {base}")
  let edit kept = [0]
  for item in [1, 20, 3]
    kept = filled(kept, items: [item])
      if error use kept
  @console.print("handled in a loop: {kept}")
  let edit ys = [1, 2]
  raise(edit ys, rounds: 3) within 60 * second
    if error use unit
  @console.print("in time: {ys}")
  raise(edit ys, rounds: 4000000000) within 20 * millisecond
    if error use unit
  @console.print("cut: {ys}")
  let edit seen: Map[Int, Int] = empty_map()
  for k in [1, 2, 1]
    let count = seen.get(key: k)
      if none use 0
    edit seen.set(key: k, value: count + 1) within 60 * second
      if error use unit
  @console.print("within in a loop: {seen}")
  let edit zs = [7]
  fail_forever(edit zs)
    if error use unit
  @console.print("after a failure: {zs}")
  stop_forever(edit zs, count: 2)
  @console.print("after a stop: {zs}")
  let edit counts: Map[Int, Int] = empty_map()
  edit counts.set(key: 1, value: 0)
  cut_forever(edit counts) within 100 * millisecond
    if error use unit
  @console.print("after a cut: {counts}")
