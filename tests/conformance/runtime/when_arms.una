-- test: when selects the arm of the variant, range or literal, and binds the fields of the variant
-- spec: spec/11 §4
-- grant: console
-- expect: run-output "areas: 12 12 0"
-- expect: run-output "bands: low mid high high"
-- expect: run-output "greetings: hi Ana, hello"
module conformance.runtime.when_arms

pub kind Shape = Circle(radius: Int) | Rect(width: Int, height: Int) | Dot

pub area(shape: Shape) -> Int
=
  when shape
    is Circle(radius) -> 3 * radius * radius
    is Rect(width, height: h) -> width * h
    is Dot -> 0

pub band(n: Int) -> Text
=
  when n
    in 0..<10 -> "low"
    in 10..<100 -> "mid"
    else -> "high"

pub greet(name: Text) -> Text
=
  when name
    is "Ana" -> "hi Ana"
    else -> "hello"

pub main() -> Unit
  uses @console: Console[print]
=
  let circle = area(Circle(radius: 2))
  let rect = area(Rect(width: 3, height: 4))
  let dot = area(Dot)
  @console.print("areas: {circle} {rect} {dot}")
  let a = band(5)
  let b = band(50)
  let c = band(500)
  let d = band(-1)
  @console.print("bands: {a} {b} {c} {d}")
  let ana = greet("Ana")
  let other = greet("Bo")
  @console.print("greetings: {ana}, {other}")
