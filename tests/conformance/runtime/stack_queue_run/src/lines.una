-- test: in edition 0.4, a `Stack` pops its last push first and a `Queue` its first, a `Queue` also pushes and pops at its front and back, `peek` and `pop` give `None` on an empty collection, `items()` and the Una form list the top or the front first, `==` compares the elements in order, and a copy keeps its value when the original changes; both engines agree (ADR 0119 rules 5 and 6)
-- spec: spec/28 §5
-- grant: console
-- expect: run-output "empty stack: [] 0 None None"
-- expect: run-output "stack: [\"news\", \"home\"] items [\"news\", \"home\"] len 2 top Some(\"news\") popped Some(\"sports\") saved [\"sports\", \"news\", \"home\"]"
-- expect: run-output "stack equal: false true"
-- expect: run-output "empty queue: [] 0 None None None None"
-- expect: run-output "queue: [0, 1, 2, 3] items [0, 1, 2, 3] len 4 front Some(0) back Some(3)"
-- expect: run-output "popped: Some(0) Some(3), now [1, 2], copy [0, 1, 2, 3]"
-- expect: run-output "queue equal: true false"
-- expect: run-output "drained: Some(1) Some(2) None [] 0"
module lines

import std.collections (Queue, Stack, empty_queue, empty_stack)

--- The pages visited, most recent first.
history() -> Unit
  uses @console: Console[print]
=
  let edit pages: Stack[Text] = empty_stack()
  let nothing = edit pages.pop()
  @console.print("empty stack: {pages} {pages.len} {pages.peek()} {nothing}")
  edit pages.push(item: "home")
  edit pages.push(item: "news")
  edit pages.push(item: "sports")
  let saved = pages
  let back = edit pages.pop()
  @console.print("stack: {pages} items {pages.items()} len {pages.len} top {pages.peek()} popped {back} saved {saved}")
  let unequal = pages == saved
  edit pages.push(item: "sports")
  let equal = pages == saved
  @console.print("stack equal: {unequal} {equal}")

--- A line served at both ends.
line() -> Unit
  uses @console: Console[print]
=
  let edit waiting: Queue[Int] = empty_queue()
  let none_front = edit waiting.pop()
  let none_back = edit waiting.pop_back()
  @console.print("empty queue: {waiting} {waiting.len} {waiting.peek()} {waiting.peek_back()} {none_front} {none_back}")
  edit waiting.push(item: 1)
  edit waiting.push(item: 2)
  edit waiting.push(item: 3)
  edit waiting.push_front(item: 0)
  let copy = waiting
  @console.print("queue: {waiting} items {waiting.items()} len {waiting.len} front {waiting.peek()} back {waiting.peek_back()}")
  let first = edit waiting.pop()
  let last = edit waiting.pop_back()
  @console.print("popped: {first} {last}, now {waiting}, copy {copy}")
  let edit other: Queue[Int] = empty_queue()
  edit other.push(item: 1)
  edit other.push(item: 2)
  let same = waiting == other
  let differs = waiting == copy
  @console.print("queue equal: {same} {differs}")
  let a = edit waiting.pop()
  let b = edit waiting.pop()
  let c = edit waiting.pop()
  @console.print("drained: {a} {b} {c} {waiting} {waiting.len}")

pub main() -> Unit
  uses @console: Console[print]
=
  history()
  line()
