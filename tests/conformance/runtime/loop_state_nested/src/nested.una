-- test: in edition 0.5, a list and a map updated through two levels of nested loops, and a list updated by two loops in a row, hold their final values when read after the loops, and copies taken before each loop, in the outer body too, keep theirs; a function whose loops update a copy of its argument gives the same result when called twice with one argument, which keeps its value, when the call is the argument's last use, and when it re-enters itself from inside its own loop, in both engines (#1196, spec/17 §7)
-- spec: spec/17 §7
-- grant: console
-- expect: run-output "nested: [1, 3, 5]"
-- expect: run-output "nested map: {10: 1, 20: 3, 40: 2}"
-- expect: run-output "snapshots: 7 / [8, 16]"
-- expect: run-output "in a row: [6, 9, 12]"
-- expect: run-output "copies: [1, 2, 3] [2, 3, 4] [6, 9, 12]"
-- expect: run-output "again: [3, 4, 5] [3, 4, 5] / [1, 2, 3]"
-- expect: run-output "moved: [4, 5, 6]"
-- expect: run-output "re-entered: [8, 18] [8, 18] / [0, 10]"
module nested

--- `xs` with `rounds` added to each item, one at a time, by two levels of loops.
raised(xs: List[Int], rounds: Int) -> List[Int]
=
  var out = xs
  for r in 0..<rounds
    for i in 0..<out.len
      const x = out.at(index: i).or_else(default: 0)
      edit out.set(index: i, item: x + 1)
  out

--- `xs` with 2 to the power `depth` added to each item: a loop runs each level below on the
--- state, then another raises each item by one.
layered(xs: List[Int], depth: Int) -> List[Int]
=
  var out = xs
  for level in 0..<depth
    out = layered(out, depth: level)
  for i in 0..<out.len
    const x = out.at(index: i).or_else(default: 0)
    edit out.set(index: i, item: x + 1)
  out

pub main() -> Unit
  uses @console: Console[print]
=
  var grid = [0, 0, 0]
  for r in 0..<2
    for i in 0..<grid.len
      const x = grid.at(index: i).or_else(default: 0)
      edit grid.set(index: i, item: x + i + r)
  @console.print("nested: {grid}")
  var pairs: Map[Int, Int] = empty_map()
  for a in [1, 2]
    for b in [10, 20]
      edit pairs.update(key: a * b, initial: 0, change: fn(n) -> n + a)
  @console.print("nested map: {pairs}")
  var doubling = [1, 2]
  var firsts = 0
  for r in 0..<3
    const snapshot = doubling
    for i in 0..<doubling.len
      const x = doubling.at(index: i).or_else(default: 0)
      edit doubling.set(index: i, item: x * 2)
    firsts = firsts + snapshot.at(index: 0).or_else(default: 0)
  @console.print("snapshots: {firsts} / {doubling}")
  var row = [1, 2, 3]
  for i in 0..<row.len
    const x = row.at(index: i).or_else(default: 0)
    edit row.set(index: i, item: x + 1)
  for i in 0..<row.len
    const x = row.at(index: i).or_else(default: 0)
    edit row.set(index: i, item: x * 3)
  @console.print("in a row: {row}")
  var col = [1, 2, 3]
  const first_copy = col
  for i in 0..<col.len
    const x = col.at(index: i).or_else(default: 0)
    edit col.set(index: i, item: x + 1)
  const second_copy = col
  for i in 0..<col.len
    const x = col.at(index: i).or_else(default: 0)
    edit col.set(index: i, item: x * 3)
  @console.print("copies: {first_copy} {second_copy} {col}")
  const base = [1, 2, 3]
  const once = raised(base, rounds: 2)
  const twice = raised(base, rounds: 2)
  @console.print("again: {once} {twice} / {base}")
  const more = raised(once, rounds: 1)
  @console.print("moved: {more}")
  const start = [0, 10]
  const deep_once = layered(start, depth: 3)
  const deep_twice = layered(start, depth: 3)
  @console.print("re-entered: {deep_once} {deep_twice} / {start}")
