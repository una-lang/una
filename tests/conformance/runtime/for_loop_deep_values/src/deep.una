-- test: a loop builds a value deeper than the call depth, and comparing and releasing it do not overflow the stack (spec/17 §4, ADR 0032)
-- spec: spec/17 §4
-- grant: console
-- expect: run-output "built true"
module deep

pub kind Node
  value: Int
  next: Option[Node]

pub chain(n: Int) -> Option[Node]
=
  let edit chain: Option[Node] = None
  for i in 0..<n
    chain = Some(Node(value: i, next: chain))
  chain

pub main() -> Unit
  uses @console: Console[print]
=
  let a = chain(300000)
  let b = chain(300000)
  let same = a == b
  @console.print("built {same}")
