-- test: in edition 0.5, a `BitSet` holds integers from 0 to `size - 1`, one bit each, its size fixed when it is made: `has`, `add`, `remove`, `with`, `without`, `first`, `last`, `items`, `.len`, `.size` and the set operations give their results at both edges of the range and across word boundaries, on a set of size 0, on the empty set and on the full set; `has`, `remove` and `without` outside the range find nothing; a bit set renders as `{a, b}`, compares by its size and its members, and keeps value semantics through a binding; both engines agree (ADR 0119 rule 14)
-- spec: spec/28 §9
-- grant: console
-- expect: run-output "zero: {} 0 0 false None None []"
-- expect: run-output "empty: {} 130 0 false false None None []"
-- expect: run-output "built: {0, 63, 64, 129} 130 4 Some(0) Some(129) [0, 63, 64, 129]"
-- expect: run-output "has: true false true true false false false"
-- expect: run-output "removed: {0, 64, 129} 3 {0, 63, 64, 129}"
-- expect: run-output "values: {0, 63, 64, 129} {0, 63, 64, 128, 129} {63, 64, 129}"
-- expect: run-output "union: {0, 1, 63, 64, 128, 129} {0, 63, 64, 129} {0, 63, 64, 129}"
-- expect: run-output "intersection: {64} {} {0, 63, 64, 129}"
-- expect: run-output "difference: {0, 63, 129} {0, 63, 64, 129} {} {}"
-- expect: run-output "subset: true false true true"
-- expect: run-output "equal: true false false true"
-- expect: run-output "full: 130 130 Some(0) Some(129) true false"
-- expect: run-output "drained: {} 0 130 130"
module bits

import std.collections (empty_bit_set)

pub main() -> Unit
  uses @console: Console[print]
=
  const zero = empty_bit_set(size: 0)
  @console.print("zero: {zero} {zero.size} {zero.len} {zero.has(item: 0)} {zero.first()} {zero.last()} {zero.items()}")
  const empty = empty_bit_set(size: 130)
  @console.print("empty: {empty} {empty.size} {empty.len} {empty.has(item: 0)} {empty.has(item: 129)} {empty.first()} {empty.last()} {empty.items()}")
  var b = empty_bit_set(size: 130)
  edit b.add(item: 129)
  edit b.add(item: 0)
  edit b.add(item: 64)
  edit b.add(item: 63)
  edit b.add(item: 64)
  @console.print("built: {b} {b.size} {b.len} {b.first()} {b.last()} {b.items()}")
  @console.print("has: {b.has(item: 0)} {b.has(item: 1)} {b.has(item: 63)} {b.has(item: 129)} {b.has(item: -1)} {b.has(item: 130)} {b.has(item: 1000)}")
  var c = b
  edit c.remove(item: 63)
  edit c.remove(item: 62)
  edit c.remove(item: 130)
  edit c.remove(item: -1)
  @console.print("removed: {c} {c.len} {b}")
  const more = b.with(item: 128)
  const less = b.without(item: 0).without(item: 500)
  @console.print("values: {b} {more} {less}")
  const other = empty.with(item: 1).with(item: 64).with(item: 128)
  @console.print("union: {b.union(other: other)} {b.union(other: empty)} {empty.union(other: b)}")
  @console.print("intersection: {b.intersection(other: other)} {b.intersection(other: empty)} {b.intersection(other: b)}")
  @console.print("difference: {b.difference(other: other)} {b.difference(other: empty)} {empty.difference(other: b)} {b.difference(other: b)}")
  @console.print("subset: {less.is_subset(of: b)} {b.is_subset(of: less)} {empty.is_subset(of: b)} {b.is_subset(of: b)}")
  const same = empty.with(item: 0).with(item: 63).with(item: 64).with(item: 129)
  @console.print("equal: {b == same} {b == more} {zero == empty} {empty == empty_bit_set(size: 130)}")
  var full = empty_bit_set(size: 130)
  for i in 0..<130
    if 0 <= i and i < full.size
      edit full.add(item: i)
  @console.print("full: {full.len} {full.size} {full.first()} {full.last()} {full.has(item: 129)} {full.has(item: 130)}")
  var drained = full
  for i in 0..<130
    edit drained.remove(item: i)
  @console.print("drained: {drained} {drained.len} {drained.size} {full.len}")
