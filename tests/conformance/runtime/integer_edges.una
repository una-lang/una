-- test: integers stay exact across the 63-bit boundary in both directions, through addition, subtraction, multiplication, negation, division and comparison, and recursion and range arms compute as the interpreter does (native slice 2 control)
-- spec: spec/11 §4
-- grant: console
-- expect: run-output "add 4611686018427387904 4611686018427387903"
-- expect: run-output "sub -4611686018427387905 -4611686018427387904"
-- expect: run-output "mul 4611686018427387904 -4611686018427387904 21267647932558653966460912964485513216"
-- expect: run-output "neg 4611686018427387904 -4611686018427387903"
-- expect: run-output "div 2305843009213693952 0 -1"
-- expect: run-output "cmp true true false true"
-- expect: run-output "fib 6765 sum 12502500"
-- expect: run-output "bands small medium large negative"
module integer_edges

fib(n: Int) -> Int = if n < 2 then n else fib(n - 1) + fib(n - 2)

sum_to(n: Int) -> Int = if n == 0 then 0 else n + sum_to(n - 1)

band(n: Int) -> Text
=
  when n
    in 0..<10 -> "small"
    in 10..<1000 -> "medium"
    else -> if n < 0 then "negative" else "large"

pub main() -> Unit
  uses @console: Console[print]
=
  let max = 4611686018427387903
  let min = -4611686018427387904
  let over = max + 1
  @console.print("add {over} {over - 1}")
  let under = min - 1
  @console.print("sub {under} {under + 1}")
  let two = 2
  @console.print("mul {2305843009213693952 * two} {min * 1} {over * over}")
  @console.print("neg {-min} {-max}")
  @console.print("div {over / two} {max / over} {min / over}")
  @console.print("cmp {over > max} {under < min} {over == max} {over - 1 == max}")
  @console.print("fib {fib(20)} sum {sum_to(5000)}")
  @console.print("bands {band(5)} {band(50)} {band(5000)} {band(-5)}")
