-- test: a package's own `Rounding` variants and `parse_decimal` keep their meaning in edition 0.4
-- spec: spec/29 §16
-- expect: ok
module m

pub kind Mode = TowardZero | AwayFromZero

pub parse_decimal(t: Text) -> Int = t.len

pub mode() -> Mode = TowardZero

pub n() -> Int = parse_decimal("abc")
