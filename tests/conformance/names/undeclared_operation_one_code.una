-- test: an operation the capability does not declare is U1001 in a body, after `expect performed` and after `expect not performed`, and an attenuated binding stays U3002
-- spec: spec/05 §9
-- expect: error U1001 at 20:8
-- expect: error U3002 at 25:8
-- expect: error U1001 at 35:25
-- expect: error U1001 at 40:29
module undeclared_operation_one_code

pub capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

pub handler quiet() for Log
  op write(line) = unit
  op flush() = unit

pub erase() -> Unit
  uses @log: Log
=
  @log.erase()

pub flush_only() -> Unit
  uses @log: Log[write]
=
  @log.flush()

pub note() -> Unit
  uses @log: Log[write]
=
  @log.write("x")

example "an operation the capability lacks"
  given @log = quiet()
  do note()
  expect performed @log.wirte

example "an operation the capability lacks, negated"
  given @log = quiet()
  do note()
  expect not performed @log.erase
