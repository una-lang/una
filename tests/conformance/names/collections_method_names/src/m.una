-- test: in edition 0.5, a package function named like a built-in method of a collection is U1002 when its first parameter has that type or is a type parameter; with any other first parameter it is accepted (ADR 0119 rule 0)
-- spec: spec/28 §2
-- expect: error U1002 at src/m.una:9:5
-- expect: error U1002 at src/m.una:11:5
module m

import std.collections (Queue, Set)

pub pop(q: Queue[Int]) -> Option[Int] = None

pub has[T](x: T, item: Int) -> Bool = false

pub between(n: Int, s: Set[Int]) -> Int = n

pub push(count: Int) -> Int = count + 1
