-- test: locals, patterns, lambdas, type parameters, the prelude and shadowed prelude names resolve
-- spec: spec/02 §1
-- expect: tier0-ok
module resolution_tour

pub kind LookupError = NotFound | Unavailable

pub kind Shape = Circle(radius: Nat) | Square(side: Nat)

pub area(shape: Shape) -> Int
=
  when shape
    is Circle(radius) -> 3 * radius * radius
    is Square(side: length) -> length * length

pub largest[T](items: List[T], size: fn(T) -> Int) -> Int = fold(items, initial: 0,
  step: fn(best: Int, item: T) -> max(best, b: size(item))
)

pub find(key: Int) -> Int
  fails LookupError
=
  if key < 0
    fail NotFound
  else
    key
