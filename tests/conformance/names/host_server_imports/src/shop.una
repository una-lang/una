-- test: in edition 0.4, `std.host` exports `HttpServer`, its kinds and `ReplyRight`, which an import brings into scope; a variant of `Method` is read by the kind of the value it tests (spec/31 §1, ADR 0123 rules 0 and 1)
-- spec: spec/31 §1
-- expect: ok
module shop

import std.host (Exchange, Header, HttpServer, Method, Param, Reply, ReplyRight, Request,
  ServeError, Status
)

--- The status of the reply to `request`.
status_of(request: internal Request) -> internal Status = if request.method is Get then 200 else 405

--- The first parameter of the query, if any.
first_param(request: internal Request) -> internal Option[Param] = request.params.first()

--- Whether two exchanges name one reply right.
same(a: internal Exchange, b: internal Exchange) -> internal Bool = a.right == b.right

--- A reply with a location.
created(id: internal Int) -> internal Reply = Reply(status: 201,
  headers: [Header(name: "location", value: "/orders/{id}")], body: ""
)

--- What a reply right writes in text.
shown(right: internal ReplyRight) -> internal Text = "{right}"

--- Answers once, and tells whether the host refused the reply.
answer(exchange: internal Exchange) -> internal Bool
  uses @server: HttpServer[reply]
=
  let sent = attempt @server.reply(to: exchange.right, reply: created(7))
  when sent
    is Ok(done) -> true
    is Err(failure) -> failure is NotHeld or failure is BadReply

--- The method a test asks for.
method() -> Method = Post

--- Why the server stopped.
why(failure: ServeError) -> Bool = failure is Closed
