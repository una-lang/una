-- test: before edition 0.4, `F32`, `Decimal`, `Complex`, `Array`, `Matrix`, `Tensor` and `Lu` are ordinary names of kinds, variants and units
-- spec: spec/29 §18
-- expect: ok
module m

pub kind F32 = A | B

pub kind Decimal
  digits: Int

pub kind Complex
  re: Int

pub kind Array = Empty | Full

pub kind Shape = Matrix | Tensor

pub measure Lu
