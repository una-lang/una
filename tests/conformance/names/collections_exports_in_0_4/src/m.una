-- test: in edition 0.4, `std.collections` exports its seven types and the kind `Ranked`: each is usable in a signature, a hash key of any `Eq` type, records and lists included, is accepted, and `Ranked` is a record of the module (ADR 0119 rules 0 and 8)
-- spec: spec/28 §2
-- expect: ok
module m

import std.collections (BitSet, HashMap, HashSet, PriorityQueue, Queue, Ranked, Set, Stack)

pub kind Point
  x: Int
  y: Int

pub sequences(a: Stack[Int], b: Queue[Text]) -> Unit = unit

pub sets(c: Set[Int], d: HashSet[List[Text]], e: BitSet) -> Unit = unit

pub keyed(f: HashMap[Point, Int], g: PriorityQueue[Point, Int]) -> Unit = unit

pub ranked() -> Ranked[Text, Int] = Ranked(item: "a", priority: 1)

pub priority_of(r: Ranked[Text, Int]) -> Int = r.priority
