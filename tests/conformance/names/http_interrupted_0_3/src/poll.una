-- test: before edition 0.4, `HttpError` keeps its eight variants: `Interrupted` names nothing, so a `when` arm of it is U1001 (spec/26 §6 rule 5, ADR 0116 rule 12)
-- spec: spec/26 §6
-- expect: error U1001 at src/poll.una:18:8
module poll

--- What a failure of a request says.
pub describe(failure: HttpError) -> Text
=
  when failure
    is Denied -> "denied"
    is BadUrl -> "bad url"
    is BadRequest -> "bad request"
    is Unreachable -> "unreachable"
    is TimedOut -> "timed out"
    is TooLarge -> "too large"
    is Tls -> "tls"
    is Protocol -> "protocol"
    is Interrupted -> "interrupted"
