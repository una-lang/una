-- test: a package of edition 0.3 that declares `Finite64`, `Finite32`, `parse_f32` and `f32_from_bits`, names that edition 0.4 adds to the prelude, and keeps their meaning in edition 0.4
-- spec: spec/29 §18
-- expect: ok
module m

pub kind Finite64 = Yes | No

pub kind Finite32
  value: Int

pub parse_f32(t: Text) -> Int = t.len

pub f32_from_bits(bits: Int) -> Int = bits + 1

pub used() -> Int = parse_f32("abc") + f32_from_bits(bits: 2) + Finite32(value: 3).value

pub pick() -> Finite64 = Yes
