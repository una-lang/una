-- test: an operation of an unknown capability reports only the capability name
-- spec: spec/10 §1
-- expect: error U1001 at 7:16
module unknown_capability_operation

pub f() -> Int
  uses @store: Store[find]
=
  let v = @store.find(1)
    if error use None
  when v
    is Some(n) -> n
    is None -> 0
