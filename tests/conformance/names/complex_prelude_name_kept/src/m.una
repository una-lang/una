-- test: a package's own `complex` keeps its meaning in edition 0.4: its calls, with integer arguments, are not the prelude's construction of a complex value
-- spec: spec/29 §19
-- expect: ok
module m

pub complex(re: Int, im: Int) -> Int = re * 10 + im

pub used() -> Int = complex(re: 1, im: 2) + 3.complex(im: 4)
