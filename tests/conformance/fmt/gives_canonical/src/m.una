-- test: the canonical form of an operation label is `op gives level[Cats] where c`, one space around each word (ADR 0094 rule 1)
-- spec: spec/15 §4
-- expect: ok
module m

pub capability Files
  op owner(file: Text) -> Text
  op note(line: Text) -> Unit

pub refusal(file: Text, dry_run: Bool) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service], note gives internal[Service] where not dry_run]
=
  if not dry_run
    @service_files.note("looked up {file}")
  @service_files.owner(file)
