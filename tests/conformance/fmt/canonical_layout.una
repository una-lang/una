-- test: comments, blank lines and nested blocks in canonical form
-- spec: spec/01 §2, §3
-- expect: tier0-ok
module canonical_layout

-- Sizes of things.
pub kind Size = Small | Large

pub kind Only = | One

--- Classifies a number.
--- Negative numbers are small.
pub size(x: Int) -> Size -- the classification
=
  -- Thresholds come from the tests.
  let limit = 10

  if x < limit
    Small
  else
    Large

pub predicate reflect small(n: Int) -> Bool = n < 10
-- End of module.
