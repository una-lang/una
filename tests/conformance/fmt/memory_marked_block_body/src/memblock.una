-- test: a body or an arm that is a single call with `edit` or `take` keeps its block form, since the call is legal only as a statement (spec/15 §4, spec/17 §3 rule 5)
-- spec: spec/15 §4
-- expect: ok
module memblock

eat(take xs: List[Int]) -> Int = xs.len

inc(edit n: Int) -> Unit
=
  n = n + 1

pub block_take(xs: List[Int]) -> Int
=
  eat(take xs)

pub block_edit(edit n: Int) -> Unit
=
  inc(edit n)

pub kind Tally
  count: Int

add(edit t: Tally, by: Int) -> Unit
=
  t.count = t.count + by

pub receiver(edit t: Tally) -> Unit
=
  edit t.add(by: 1)

pub arm(k: Int, edit n: Int) -> Unit
=
  when k
    is 1 ->
      inc(edit n)
    else -> unit
