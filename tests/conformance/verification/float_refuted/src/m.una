-- test: a refutable float contract within the bound is refuted, with its counterexample: a product of two values in [0, 1] is not always at most 0.5
-- spec: spec/29 §8
-- expect: error U5001 at src/m.una:11:3
module m

pub kind Unit01 = F64 where it.ieee_ge(other: 0.0) and it <= 1.0

pub half(a: Unit01, b: Unit01) -> F64
  ensures result <= 0.5
=
  a * b
