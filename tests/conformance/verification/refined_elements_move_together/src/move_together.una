-- test: movement together: an `Int` task value of a `together for` whose list is annotated `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_together.una:17:5
module move_together

pub kind Pos = Int where it > 0

pub kept(ps: List[Pos]) -> List[Pos]
=
  let out: List[Pos] = together for x in ps
    x
  out

pub moved(xs: List[Int]) -> List[Pos]
=
  let out: List[Pos] = together for x in xs
    x
  out
