-- test: a field equation of a construction is a constraint, never a definition: a result that implies a field of a record equals 5.0 when the record equals a construction is not refuted from the cone query, and the full query proves it
-- spec: spec/29 §8
-- expect: ok
module m

pub kind P
  x: F64

pub is_five(b: P) -> Bool
  ensures result implies b.x == 5.0
=
  b == P(x: 5.0)
