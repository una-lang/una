-- test: movement map_without: a map's `without` of a `Map[Text, Int]` bound by a `let` annotated `Map[Text, Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_map_without.una:15:28
module move_map_without

pub kind Pos = Int where it > 0

pub kept(m: Map[Text, Pos]) -> Int
=
  let m2: Map[Text, Pos] = m.without(key: "a")
  m2.len

pub moved(m: Map[Text, Int]) -> Int
=
  let m2: Map[Text, Pos] = m.without(key: "a")
  m2.len
