-- test: a handler operation that breaks the ensures of its operation is refuted (R-037)
-- spec: spec/12 §3
-- expect: error U5001 at 14:16
module handler_postcondition_refuted

pub capability Counter
  op count() -> Int
    ensures result >= 0

pub handler zero() for Counter
  op count() = 0

pub handler broken() for Counter
  op count() = -1
