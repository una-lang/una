-- test: `divide` and `remainder` carry a `division` obligation, refuted for a divisor that may be zero, proven when guarded
-- spec: spec/29 §16
-- expect: error U5001 at src/m.una:7:57
-- expect: error U5001 at src/m.una:14:56
module m

pub split(x: Decimal[2], y: Decimal[2]) -> Decimal[2] = x.divide(by: y, scale: 2,
  rounding: HalfEven
)

pub guarded(x: Decimal[2], y: Decimal[2]) -> Decimal[2]
  requires y > 0.00
=
  x.divide(by: y, scale: 2, rounding: HalfEven)

pub rest(x: Decimal[2], y: Decimal[2]) -> Decimal[2] = x.remainder(by: y, scale: 0)

pub literal(x: Decimal[2]) -> Decimal[2] = x.divide(by: 3.00, scale: 2, rounding: HalfEven)
