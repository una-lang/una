-- test: a loop that updates a list only by `set`, by a helper that ensures the length is unchanged, under branches, failures or nested loops of the same kind keeps its length, in the body and after the loop (ADR 0071 D1, D2)
-- spec: spec/17 §5
module frame

pub kind Bad = Negative | TooLarge

--- `set` keeps the length, so the range's bound stays a valid index.
pub bump(edit xs: List[Int]) -> Unit
  ensures xs.len == old(xs).len
=
  for i in 0..<xs.len
    set(edit xs, index: i, item: i + 1)

--- An editable copy.
pub zeroed(xs: List[Int]) -> List[Int]
  ensures result.len == xs.len
=
  let edit ys = xs
  for i in 0..<ys.len
    edit ys.set(index: i, item: 0)
  ys

--- The bound computed before the loop.
pub doubled(edit xs: List[Int]) -> Unit
=
  let n = xs.len
  for i in 0..<n
    set(edit xs, index: i, item: 2 * i)

--- A helper whose contract keeps the length.
put(edit ys: List[Int], at: Int) -> Unit
  requires 0 <= at and at < ys.len
  ensures ys.len == old(ys).len
=
  set(edit ys, index: at, item: 1)

pub through_helper(edit xs: List[Int]) -> Unit
=
  for i in 0..<xs.len
    put(edit xs, at: i)

--- A branch, a failure and a nested loop keep it too.
pub branches(edit xs: List[Int], limit: Int) -> Unit
  fails Bad
=
  for i in 0..<xs.len
    if limit < 0
      fail Negative
    if i < limit
      set(edit xs, index: i, item: limit)
    for j in 0..<xs.len
      set(edit xs, index: j, item: i)
