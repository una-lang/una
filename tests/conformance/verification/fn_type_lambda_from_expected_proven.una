-- test: a lambda parameter takes the refinement of the expected parameter type (ADR 0037 case 3)
-- spec: spec/12 §3
-- expect: ok
module fn_type_lambda_from_expected_proven

pub kind Pos = Int where it > 0

pub apply(f: fn(Pos) -> Int, x: Pos) -> Int = f(x)

pub takes_pos(x: Pos) -> Int = x

pub use_it() -> Int = apply(fn(y) -> takes_pos(y), x: 1)
