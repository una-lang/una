-- test: the deadline of `within` is at least 1, a `refinement` obligation: `within 0` is refuted, and a deadline from a parameter refined to `1..` is proven (spec/27 §5, ADR 0117 rule 5)
-- spec: spec/27 §5
-- expect: error U5001 at src/zero.una:12:26
module zero

import std.time (millisecond)

next(n: Int) -> Int = n + 1

pub never(n: Int) -> Int
=
  let x = next(n) within 0 * millisecond
    if error use 0
  x

pub every(n: Int, ms: Int) -> Int
  requires ms >= 1
=
  let x = next(n) within ms * millisecond
    if error use 0
  x
