-- test: contracts over F32 are exact at binary32 (`Float32`): a refined kind over [0, 1], a bound on one square root, a product within [0, 1], `0.1 + 0.2 == 0.3`, true in binary32 and false in binary64, a conversion of an integer of modest range, the conversions between the formats, totalOrder from an IEEE comparison and the classifications are proven
-- spec: spec/29 §18
-- expect: ok
module m

pub kind Unit01 = F32 where it.ieee_ge(other: 0.0) and it <= 1.0

pub root(x: Unit01) -> F32
  ensures result <= 1.0
=
  x.sqrt()

pub product(a: Unit01, b: Unit01) -> Unit01 = a * b

pub single() -> F32
  ensures result == 0.3
=
  0.1 + 0.2

pub small(n: Int) -> F32
  requires 0 <= n and n <= 100
  ensures result <= 100.0
=
  n.to_f32()

pub widened(x: F32) -> F64
  requires x.is_finite()
  ensures result.is_finite()
=
  x.to_f64()

pub narrowed(x: F64) -> F32
  requires x.ieee_ge(other: 0.0) and x <= 1.0
  ensures result <= 1.0
=
  x.to_f32()

pub magnitude(x: F32) -> F32
  ensures result.is_nan() or result.ieee_ge(other: 0.0)
=
  x.abs()

pub ordered(x: F32, y: F32) -> Bool
  requires x.ieee_lt(other: y)
  ensures result
=
  x < y
