-- test: a call argument fed by a generic call checks every flow (function result refinement, function parameter refinement, refinement); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/12 §3
-- expect: error U5001 at 28:209
-- expect: error U5001 at 30:209
-- expect: error U5001 at 32:209
module sweep_flow_arg_generic

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub id[T](x: T) -> T = x

pub take_r(v: Pos) -> Int = 0

pub take_f(v: fn(Int) -> Pos) -> Int = 0

pub take_e(v: fn(Int) -> Int) -> Int = 0

pub r_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> Int = take_r(id(0))

pub f_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> Int = take_f(id(g))

pub p_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> Int = take_e(id(w))

pub p_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> Int = take_e(id(g))
