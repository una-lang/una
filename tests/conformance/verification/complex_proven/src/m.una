-- test: contracts over `Complex[F64]` and `Complex[F32]` read the fields `re` and `im` into the float sorts, a construction gives its fields, and `==` compares the components by identity, so a field of a value equal to a construction, a swap of the components, a conjugate's components and a comparison of the fields of equal values are proven
-- spec: spec/29 §19
-- expect: ok
module m

pub real_part(z: Complex[F64]) -> F64
  requires z == complex(re: 1.5, im: 2.5)
  ensures result == 1.5
=
  z.re

pub swapped(z: Complex[F64]) -> Complex[F64]
  ensures result == complex(re: z.im, im: z.re)
=
  complex(re: z.im, im: z.re)

pub conjugate(z: Complex[F32]) -> Complex[F32]
  ensures result.re == z.re and result.im == -z.im
=
  z.conj()

pub same(z: Complex[F64], w: Complex[F64]) -> Bool
  requires z == w
  ensures result
=
  z.im == w.im
