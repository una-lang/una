-- test: an annotated let whose right side has the same refined function type verifies, whatever the right side is (N-005)
-- spec: spec/12 §3
-- expect: ok
module fn_type_annotated_let_same_refinement

pub kind Pos = Int where it > 0

pub kind Holder
  run: fn(Int) -> Pos

pub inv(p: Pos) -> Int = 100 / p

pub one(x: Int) -> Pos = 1

pub make() -> fn(Int) -> Pos = one

pub by_call() -> Int
=
  let f: fn(Int) -> Pos = make()
  inv(f(1))

pub by_field(h: Holder) -> Int
=
  let f: fn(Int) -> Pos = h.run
  inv(f(1))

pub taker() -> fn(Int) -> Int = inv_or_zero

pub inv_or_zero(x: Int) -> Int = if x > 0 then 100 / x else 0

pub by_param() -> Int
=
  let f: fn(Pos) -> Int = taker()
  f(1)
