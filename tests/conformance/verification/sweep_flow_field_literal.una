-- test: a constructor field fed by a literal checks every flow (refinement); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/12 §3
-- expect: error U5001 at 21:211
module sweep_flow_field_literal

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub kind BoxR
  v: Pos

pub r_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxR = BoxR(v: 0)

pub r_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxR = BoxR(v: 1)
