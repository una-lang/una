-- test: an argument that may fall outside its parameter's range is refuted at the argument
-- spec: spec/12 §3
-- expect: error U5001 at 10:49
module refinement_argument_refuted

pub kind Seats = Int in 0..5000

pub book(seats: Seats) -> Int = seats

pub unguarded(raw: Int) -> Int = book(1) + book(raw)
