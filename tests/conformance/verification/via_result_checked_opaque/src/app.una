-- test: a via function establishes an opaque refinement of the policy's to type with checked (R-007)
-- spec: spec/12 §3
-- expect: ok
module app

import release (Slug, SlugError, as_slug)

pub publish(raw: internal Text) -> Slug
  fails SlugError
=
  let slug = as_slug(raw)
    if error pass
  slug
