-- test: a lambda whose parameter annotation is stronger than the expected parameter type is refuted at the lambda (ADR 0037 rule 12, case 4)
-- spec: spec/12 §3
-- expect: error U5001 at 10:29
module fn_type_lambda_annotation_refuted

pub kind Pos = Int where it > 0

pub apply(f: fn(Int) -> Int, x: Int) -> Int = f(x)

pub use_it() -> Int = apply(fn(y: Pos) -> y, x: 0)
