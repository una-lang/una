-- test: a variant field named tag is a user symbol distinct from the encoder's tag function (R-009)
-- spec: spec/12 §4
-- expect: error U5001 at 13:11
module field_named_tag

pub kind Marker = Stamp(tag: Int) | Blank

pub main() -> Unit
  uses @console: Console[print]
=
  let m = Stamp(tag: 5)
  let zero = 0
  let q = 100 / zero
  @console.print("q = {q}")
