-- test: movement with_argument: a `List[Int]` passed to a handler parameter declared `List[Pos]` at a `with` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_with_argument.una:23:39
module move_with_argument

pub kind Pos = Int where it > 0

pub capability Source
  op pick() -> List[Pos]

handler holding(xs: List[Pos]) for Source
  op pick() = xs

count() -> Int
  uses @src: Source[pick]
=
  let xs = @src.pick()
  xs.len

pub moved(ints: List[Int], ps: List[Pos]) -> Int
=
  let a = count() with @src = holding(ps)
  let b = count() with @src = holding(ints)
  a + b
