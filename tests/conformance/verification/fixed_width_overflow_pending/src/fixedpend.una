-- test: stage 1 of issue #28: every `overflow` obligation is unknown until its encoding is implemented, so fixed-width arithmetic and narrowing conversions do not pass tier 1 (spec/18 §3)
-- spec: spec/18 §3
-- expect: error U5002 at src/fixedpend.una:8:31
-- expect: error U5002 at src/fixedpend.una:10:28
-- expect: error U5002 at src/fixedpend.una:12:27
module fixedpend

pub add(a: U8, b: U8) -> U8 = a + b

pub narrow(a: I32) -> U8 = a.to_u8()

pub negate(a: I8) -> I8 = -a
