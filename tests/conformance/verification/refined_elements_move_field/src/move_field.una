-- test: movement field: a `List[Int]` stored in a field declared `List[Pos]`, by a constructor and by a place is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_field.una:12:86
-- expect: error U5001 at src/move_field.una:17:13
module move_field

pub kind Pos = Int where it > 0

pub kind Bag
  items: List[Pos]

pub built(ps: List[Pos], ints: List[Int]) -> List[Bag] = [Bag(items: ps), Bag(items: ints)]

pub stored(ints: List[Int], ps: List[Pos]) -> Int
=
  let edit b = Bag(items: ps)
  b.items = ints
  b.items.len
