-- test: a locked condition outside what the verifier encodes is U7002 at its lock entry in `una.toml`, before any `contract_lock` obligation: a comparison with `unit`, and a call of a function that is not a predicate (ADR 0092 rule 8, as amended)
-- spec: spec/12 §3
-- expect: error U7002 at una.toml:8:3
-- expect: error U7002 at una.toml:11:3
module shop

pub capability Catalog
  op set_price(sku: Int, cents: Int) -> Unit
  op set_rate(sku: Int, rate: Int) -> Unit

valid(sku: Int) -> Bool = sku > 0

pub update(sku: Int, cents: Int, mode: Unit) -> Unit
  uses @catalog: Catalog[set_price where cents > 0]
=
  if cents > 0
    @catalog.set_price(sku, cents)
  unit

pub rate(sku: Int, rate: Int) -> Unit
  uses @catalog: Catalog[set_rate]
=
  @catalog.set_rate(sku, rate)
