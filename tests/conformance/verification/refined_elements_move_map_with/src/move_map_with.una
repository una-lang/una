-- test: movement map_with: a map's `with` of a `Map[Text, Int]` bound by a `let` annotated `Map[Text, Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_map_with.una:15:28
module move_map_with

pub kind Pos = Int where it > 0

pub kept(m: Map[Text, Pos], p: Pos) -> Int
=
  let m2: Map[Text, Pos] = m.with(key: "a", value: p)
  m2.len

pub moved(m: Map[Text, Int]) -> Int
=
  let m2: Map[Text, Pos] = m.with(key: "a", value: 1)
  m2.len
