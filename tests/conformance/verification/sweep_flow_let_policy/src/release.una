trusted module release

pub kind Pos = Int where it > 0

pub policy lower
  from secret Int
  to public Int
  via reveal
  purpose "sweep"
  owner ops

pub policy lower_pos
  from secret Int
  to public Pos
  via clamp
  purpose "sweep"
  owner ops

pub policy mask
  from secret Int
  to internal Int
  via keep
  purpose "sweep"
  owner ops

reveal(n: secret Int) -> public Int = n

clamp(n: secret Int) -> public Pos = if n > 0 then n else 1

keep(n: secret Int) -> internal Int = n
