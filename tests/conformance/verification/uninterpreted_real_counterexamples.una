-- test: real refutations through products, quotients and remainders keep their status and counterexample: the query is solved once more with the arithmetic interpreted, and an unreachable division by zero does not count; refutations no execution has stay unknown (issue #104, ADR 0054)
-- spec: spec/12 §6
-- expect: error U5001 at 14:25
-- expect: error U5001 at 19:3
-- expect: error U5001 at 25:3
-- expect: error U5001 at 34:3
-- expect: error U5002 at 36:29
module uninterpreted_real_counterexamples

pub kind Pos = Int where it > 0

pub kind Small = Int where it >= 1 and it <= 2

pub sq(a: Int) -> Pos = a * a

pub small(a: Small, b: Small) -> Int
  ensures result < 4
=
  a * b

pub half(x: Int) -> Int
  requires x == 7
  ensures result == 3
=
  x / (0 - 2)

pub unreachable(a: Option[Int], n: Int) -> Int
  requires a is Some
=
  let zero = 0
  let x = when a
    is Some(v) -> v
    is None -> 100 / zero
  100 / (x + n)

pub square(a: Int) -> Nat = a * a
