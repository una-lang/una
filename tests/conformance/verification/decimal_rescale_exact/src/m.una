-- test: `rescale_exact` requires that no nonzero digit is dropped: proven from a `requires`, refuted otherwise
-- spec: spec/29 §16
-- expect: error U5001 at src/m.una:11:44
module m

pub exact(x: Decimal[4]) -> Decimal[2]
  requires x.coefficient() mod 100 == 0
=
  x.rescale_exact(scale: 2)

pub inexact(x: Decimal[4]) -> Decimal[2] = x.rescale_exact(scale: 2)
