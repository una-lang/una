-- test: the conversion of an Int beyond 64 bits is uninterpreted: a fact that needs it is never proven, and a refutation whose model needs it is unknown, U5002 with the conversion's reason
-- spec: spec/29 §8
-- expect: error U5002 at src/m.una:11:3
-- expect: error U5002 at src/m.una:17:3
module m

pub huge(n: Int) -> F64
  requires n > 9223372036854775807
  ensures result <= 1.0
=
  n.to_f64()

pub sign(n: Int) -> F64
  requires n >= 0
  ensures result.ieee_ge(other: 0.0)
=
  n.to_f64()
