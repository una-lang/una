-- test: movement map_entries: a map's `entries()` of a `Map[Text, Int]` bound by a `let` annotated `List[Entry[Text, Pos]]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_map_entries.una:15:36
module move_map_entries

pub kind Pos = Int where it > 0

pub kept(m: Map[Text, Pos]) -> Int
=
  let es: List[Entry[Text, Pos]] = m.entries()
  es.len

pub moved(m: Map[Text, Int]) -> Int
=
  let es: List[Entry[Text, Pos]] = m.entries()
  es.len
