-- test: movement operation_argument: a `List[Int]` passed to an operation parameter declared `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_operation_argument.una:15:13
module move_operation_argument

pub kind Pos = Int where it > 0

pub capability Sink
  op put(xs: List[Pos]) -> Unit

pub moved(ints: List[Int], ps: List[Pos]) -> Unit
  uses @sink: Sink[put]
=
  @sink.put(ps)
  @sink.put(ints)
