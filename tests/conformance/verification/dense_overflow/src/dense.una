-- test: `+` on arrays of a fixed-width element type is the `zip_map` of the element type's `+`, with its `overflow` obligation over two elements: refuted when the element type does not bound it, proven when a refinement does; a scalar `*` likewise, and a division by a scalar carries its `division` obligation once
-- spec: spec/29 §17
-- expect: error U5001 at src/dense.una:10:3
-- expect: error U5001 at src/dense.una:19:63
module dense

pub unbounded(a: Array[I32], b: Array[I32]) -> Array[I32]
  requires a.len == b.len
=
  a + b

pub bounded(a: Array[I32 in 0..1000], b: Array[I32 in 0..1000]) -> Array[I32]
  requires a.len == b.len
=
  a + b

pub scaled(a: Array[I16 in -100..100]) -> Array[I16] = 3 * a

pub divided(a: Array[I32 in 0..1000], k: I32) -> Array[I32] = a / k
