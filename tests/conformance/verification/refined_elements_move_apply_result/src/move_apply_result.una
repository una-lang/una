-- test: movement apply_result: a function value's `List[Int]` result bound by a `let` annotated `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_apply_result.una:11:22
module move_apply_result

pub kind Pos = Int where it > 0

pub moved(f: fn() -> List[Int], g: fn() -> List[Pos]) -> Int
=
  let a: List[Pos] = g()
  let b: List[Pos] = f()
  a.len + b.len
