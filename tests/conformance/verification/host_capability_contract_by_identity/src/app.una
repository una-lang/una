-- test: a host operation carries only its own contract, not that of a user capability of the same name (R-008)
-- spec: spec/10 §11
-- expect: error U5001 at src/app.una:12:18
module app

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
=
  let text = @files.read("empty.txt")
    if error use "fallback"
  let per_char = 100 / text.len
  @console.print("computed a ratio")
