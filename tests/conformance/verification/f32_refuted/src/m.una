-- test: refutable F32 contracts are refuted at binary32, with their counterexamples: a product of two values in [0, 1] is not always at most 0.5, the F32 nearest 0.1 widened to F64 is not the F64 0.1, and a finite F64 narrowed to F32 may be an infinity
-- spec: spec/29 §18
-- expect: error U5001 at src/m.una:13:3
-- expect: error U5001 at src/m.una:19:3
-- expect: error U5001 at src/m.una:25:3
module m

pub kind Unit01 = F32 where it.ieee_ge(other: 0.0) and it <= 1.0

pub half(a: Unit01, b: Unit01) -> F32
  ensures result <= 0.5
=
  a * b

pub widened(x: F32) -> F64
  requires x == 0.1
  ensures result == 0.1
=
  x.to_f64()

pub narrowed(x: F64) -> F32
  requires x.is_finite()
  ensures result.is_finite()
=
  x.to_f32()
