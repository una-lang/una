-- test: an off-by-one index in a function that constructs a record with float fields goes to the full query, which is over the weight bound: U5002 with the float reason, not a refutation from the cone query
-- spec: spec/29 §8
-- expect: error U5002 at 22:14
module m

pub kind Body
  x: F64
  v: F64

get(xs: List[Body], i: Int) -> Body
  requires 0 <= i and i < xs.len
=
  when at(xs, index: i)
    is Some(b) -> b
    is None -> Body(x: 0.0, v: 0.0)

pub step(xs: List[Body], dt: F64) -> Body
  requires xs.len > 0
=
  let b = get(xs, i: 0)
  let moved = Body(x: b.x + b.v * dt, v: b.v * dt / 2.0)
  let last = get(xs, i: xs.len)
  Body(x: moved.x + last.x, v: moved.v)
