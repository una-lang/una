-- test: an if and a when branch join fed by a field read checks every flow (function result refinement, function parameter refinement, refinement); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/12 §3
-- expect: error U5001 at 33:218
-- expect: error U5001 at 40:10
-- expect: error U5001 at 51:218
-- expect: error U5001 at 58:10
-- expect: error U5001 at 69:218
-- expect: error U5001 at 76:10
module sweep_flow_join_field

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub zero(x: Int) -> Int = 0

pub one(x: Int) -> Pos = 1

pub take_r(v: Pos) -> Int = 0

pub take_f(v: fn(Int) -> Pos) -> Int = 0

pub take_e(v: fn(Int) -> Int) -> Int = 0

pub r_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_r(if c then h.n else 1)

pub rw_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> h.n
    is None -> 1
  take_r(y)

pub r_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_r(if c then h.p else 1)

pub rw_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> h.p
    is None -> 1
  take_r(y)

pub f_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_f(if c then h.run else one)

pub fw_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> h.run
    is None -> one
  take_f(y)

pub f_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_f(if c then h.pos else one)

pub fw_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> h.pos
    is None -> one
  take_f(y)

pub p_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_e(if c then h.pinv else zero)

pub pw_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> h.pinv
    is None -> zero
  take_e(y)

pub p_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_e(if c then h.run else zero)

pub pw_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> h.run
    is None -> zero
  take_e(y)
