trusted module app.keys

pub policy text_key
  from secret[PII] Text
  to internal Hashed
  via hmac_text
  purpose "key a text"
  owner tests

hmac_text(text: secret[PII] Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: "pepper", data: text)
    if error pass
