-- test: movement handler_result: a handler operation returning a `List[Int]` where the operation declares `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_handler_result.una:15:15
module move_handler_result

pub kind Pos = Int where it > 0

pub capability Source
  op pick() -> List[Pos]

handler good(ps: List[Pos]) for Source
  op pick() = ps

handler bad(ints: List[Int]) for Source
  op pick() = ints
