-- test: a list literal given for a field of a generic kind whose type argument the expected type fixes takes that type, so its literals are fixed-width: `Box(v: [1, 2])` where a `Box[List[U8]]` is expected, and `Bag(items: [1, 2])` where a `Bag[U8]` is (`spec/18 §2` rule 1, ADR 0103 rule 5, #1657)
-- spec: spec/18 §2
-- expect: ok
module fixed_width

pub kind Box[T]
  v: T

pub kind Bag[T]
  items: List[T]

pub bytes() -> Box[List[U8]] = Box(v: [1, 2])

pub byte_bag() -> Bag[U8] = Bag(items: [1, 2])
