-- test: a callee's contract is instantiated with its type arguments, so `min` proves its `ensures` over `Int`, `U8`, `Text` and a type parameter alike; in a generic body the order of `T` is uninterpreted, so no law of orders holds there, not even one that every instance satisfies, and `to_int()` of `T` has no bounds (spec/20 §5)
-- spec: spec/20 §5
-- expect: error U5001 at src/constraint_facts.una:36:3
-- expect: error U5001 at src/constraint_facts.una:41:3
-- expect: error U5001 at src/constraint_facts.una:51:3
module constraint_facts

pub low(a: Int, b: Int) -> Int
  ensures result <= a
=
  min(a, b: b)

pub low_u8(a: U8, b: U8) -> U8
  ensures result <= b
=
  min(a, b: b)

pub low_text(a: Text, b: Text) -> Text
  ensures result == a or result == b
=
  min(a, b: b)

pub low_generic[T: Ord](a: T, b: T) -> T
  ensures result <= a and result <= b
=
  min(a, b: b)

pub chosen[T: Ord](a: T, b: T) -> T
  ensures result == a or result == b
=
  if a < b then a else b

pub reflexive[T: Ord](a: T) -> Bool
  ensures result
=
  a <= a

pub total_order[T: Ord](a: T, b: T) -> Bool
  ensures result
=
  a <= b or b <= a

pub reflexive_int(a: Int) -> Bool
  ensures result
=
  a <= a

pub natural[T: Integer](x: T) -> Int
  ensures result >= 0
=
  x.to_int()

pub natural_u8(x: U8) -> Int
  ensures result >= 0
=
  x.to_int()

pub sorted_length(xs: List[Text]) -> Int
  ensures result == xs.len
=
  sort(xs).len
