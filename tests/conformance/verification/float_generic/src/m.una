-- test: a type parameter instantiated with F64 compares by totalOrder in the callee's contract: the negative zero below the positive zero and every value below NaN are proven through it
-- spec: spec/29 §8
-- expect: ok
module m

less[T: Ord](a: T, b: T) -> Bool
  ensures result == (a < b)
=
  a < b

pub zeros(a: F64, b: F64) -> Bool
  requires a.is_negative_zero() and b.is_positive_zero()
  ensures result
=
  less(a, b: b)

pub below_nan(x: F64) -> Bool
  requires not x.is_nan()
  ensures result
=
  less(x, b: nan())
