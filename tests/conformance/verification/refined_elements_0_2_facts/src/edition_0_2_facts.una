-- test: in edition 0.2 an element read through `first` carries no refinement: `[p]` is a `List[Int]` (ADR 0103 rule 9)
-- spec: spec/03 §3
-- expect: error U5001 at src/edition_0_2_facts.una:14:25
module edition_0_2_facts

pub kind Pos = Int where it > 0

needs(n: Pos) -> Int = n

pub via_first(p: Pos) -> Int
=
  let xs = [p]
  when xs.first()
    is Some(x) -> needs(x)
    is None -> 0
