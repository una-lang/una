-- test: a call that passes a conditioned binding proves that the callee's condition implies the caller's: an unconditioned callee needs the caller's condition at the call, a callee that promises it needs nothing more, and a rebind with `with` passes the same binding (ADR 0092 rules 3 and 4, spec/05 §3)
-- spec: spec/05 §3
-- expect: error U5001 at src/calls.una:23:3
-- expect: error U5001 at src/calls.una:40:3
-- expect: error U5001 at src/calls.una:45:3
module calls

pub capability Log
  op write(n: Int) -> Unit

helper(n: Int) -> Unit = @log.write(n)

pub promises(n: Int, quiet: Bool) -> Unit
  uses @log: Log[write where not quiet]
=
  if not quiet
    @log.write(n)
  unit

pub to_helper(n: Int, dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  helper(n)

pub to_helper_guarded(n: Int, dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  if not dry
    helper(n)
  unit

pub to_promise(n: Int, dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  promises(n, quiet: dry)

pub to_promise_wrong(n: Int, dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  promises(n, quiet: false)

pub rebound(n: Int, dry: Bool) -> Unit
  uses @main: Log[write where not dry]
=
  helper(n) with @log = @main
