-- test: a `systems` package of edition 0.3 declared in `una.toml`: an `Int` addition that can leave the tagged range is refuted, and a guarded one is proven (ADR 0109 rules 1 and 3)
-- spec: spec/18 §3
-- expect: error U5001 at src/systems.una:7:34
module systems

-- U5001: `a + b` on unbounded parameters can leave the tagged range.
pub add(a: Int, b: Int) -> Int = a + b

-- Proven: the guard bounds both operands.
pub guarded(a: Int, b: Int) -> Int = if a in 0..1000 and b in 0..1000 then a + b else 0
