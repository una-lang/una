-- test: each rounding mode of `divide` with a negative divisor, a negative dividend and both, at a tie, proven against its rule; a wrong value refuted
-- spec: spec/29 §16
-- expect: error U5001 at src/m.una:178:3
module m

pub halfeven_pp() -> Bool
  ensures result
=
  const n: Decimal[0] = 7.0
  n.divide(by: 2.0, scale: 0, rounding: HalfEven) == 4.0

pub halfeven_pn() -> Bool
  ensures result
=
  const n: Decimal[0] = 7.0
  n.divide(by: -2.0, scale: 0, rounding: HalfEven) == -4.0

pub halfeven_np() -> Bool
  ensures result
=
  const n: Decimal[0] = -7.0
  n.divide(by: 2.0, scale: 0, rounding: HalfEven) == -4.0

pub halfeven_nn() -> Bool
  ensures result
=
  const n: Decimal[0] = -7.0
  n.divide(by: -2.0, scale: 0, rounding: HalfEven) == 4.0

