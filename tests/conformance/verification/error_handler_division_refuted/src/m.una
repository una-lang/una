-- test: a function whose `if error use` handler reads `error` keeps the division by the handled value, which is refuted
-- spec: spec/12 §3
-- expect: error U5001 at src/m.una:17:3
module m

pub kind Problem = A | B

risky(n: Int) -> Int
  fails Problem
=
  if n > 0 then fail B else 1

pub f(n: Int) -> Int
=
  let v = risky(n)
    if error use (if error is A then 1 else 0)
  10 / v
