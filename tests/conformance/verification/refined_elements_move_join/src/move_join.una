-- test: movement join: a `List[Int]` branch of an `if` whose value is annotated `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_join.una:10:23
module move_join

pub kind Pos = Int where it > 0

pub moved(ints: List[Int], ps: List[Pos], c: Bool) -> Int
=
  let ys: List[Pos] = if c
    ps
  else
    ints
  ys.len
