-- test: in edition 0.5, `add` on a `Set[Pos]` stores its item at `Pos`, a `refinement` obligation, refuted for a non-positive item and proven for a `Pos` (ADR 0119 rule 7, ADR 0103 rule 3)
-- spec: spec/28 §6
-- expect: error U5001 at src/items.una:19:20
module items

import std.collections (Set, empty_set)

pub kind Pos = Int where it > 0

pub kept(p: Pos) -> Int
=
  var s: Set[Pos] = empty_set()
  edit s.add(item: p)
  s.items().len

pub moved() -> Int
=
  var s: Set[Pos] = empty_set()
  edit s.add(item: 0)
  s.items().len
