-- test: movement argument: a `List[Int]` passed to a `List[Pos]` parameter is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_argument.una:13:17
module move_argument

pub kind Pos = Int where it > 0

pub takes(xs: List[Pos]) -> Int = xs.len

pub moved(ints: List[Int], ps: List[Pos]) -> Int
=
  let a = takes(ps)
  let b = takes(ints)
  a + b
