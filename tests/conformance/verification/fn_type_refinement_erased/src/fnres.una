-- test: a lambda that returns 0 where `fn(Int) -> Pos` is expected is refuted at its result, and calls through the value assume `Pos`, so the divisions are proven (R-013, adversarial verify-fn-type-refinement-erased)
-- spec: spec/12 §3
-- expect: error U5001 at src/fnres.una:25:26
-- expect: error U5001 at src/fnres.una:26:39
module fnres

pub kind Pos = Int where it > 0

pub kind Box
  run: fn(Int) -> Pos

apply(g: fn(Int) -> Pos) -> Int
=
  let v = g(0)
  100 / v

apply_box(b: Box) -> Int
=
  let v = b.run(0)
  100 / v

pub main() -> Unit
  uses @console: Console[print]
=
  let q = apply(fn(x) -> 0)
  let r = apply_box(Box(run: fn(x) -> 0))
  @console.print("q = {q} {r}")
