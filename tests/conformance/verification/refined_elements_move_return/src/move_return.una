-- test: movement return: a `List[Int]` returned as a `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_return.una:10:43
module move_return

pub kind Pos = Int where it > 0

pub kept(ps: List[Pos]) -> List[Pos] = ps

pub moved(ints: List[Int]) -> List[Pos] = ints
