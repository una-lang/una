-- test: a lambda's body is not a position of `result`, even in a test's `expect` line, so `result` inside it is U2012 at the checker, not an internal error
-- spec: spec/02 §8
-- expect: error U2012 at src/m.una:10:29
module m

pub zero() -> Int = 0

test "divides by the result"
  do zero()
  expect (fn(x: Int) -> x / result == 1)(5)
