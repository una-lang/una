-- test: `result` inside a lambda of a test's `expect` line has no value in Core IR, so the test does not elaborate and the package is rejected: U8001
-- spec: spec/09 §3
-- expect: error U8001 at src/m.una:8:1
module m

pub zero() -> Int = 0

test "divides by the result"
  do zero()
  expect (fn(x: Int) -> x / result == 1)(5)
