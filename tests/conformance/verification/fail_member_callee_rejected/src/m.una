-- test: a field read of a `fail` expression does not elaborate, and the package is rejected rather than the callee's `requires` going unchecked at its call: U8001
-- spec: spec/09 §3
-- expect: error U8001 at src/m.una:8:1
module m

pub kind Problem = Oops | Other

pub div(a: Int, b: Int) -> Int
  requires b != 0
  fails Problem
=
  let q = a / b
  if q > 10 then (fail Oops).len else q

pub use_it() -> Int
  fails Problem
=
  let r = div(a: 1, b: 0)
    if error pass
  r
