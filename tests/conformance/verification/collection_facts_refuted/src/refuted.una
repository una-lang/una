-- test: in edition 0.5, the verifier concludes nothing that a run can violate: membership after a `remove` at a key that may equal the one added is refuted, never proven, in a hash map, a set and a map; `same_entries` says nothing of the order of `keys()`; nothing bounds a hash set's length, so the measure of a walk over one is refuted; and which item a queue keeps in front after a `pop` is not known (ADR 0119 V2, V3 and rule 20, rule 11, ADR 0069 amendment of 2026-10-19)
-- spec: spec/28 §11
-- expect: error U5001 at src/refuted.una:19:3
-- expect: error U5001 at src/refuted.una:27:3
-- expect: error U5001 at src/refuted.una:35:3
-- expect: error U5001 at src/refuted.una:40:33
-- expect: error U5001 at src/refuted.una:45:3
-- expect: error U5001 at src/refuted.una:53:3
module refuted

import std.collections (HashMap, HashSet, Queue, Set)

pub aliased(m: HashMap[Text, Int], a: Text, b: Text) -> Bool
  ensures result
=
  var n = m
  edit n.set(key: a, value: 1)
  edit n.remove(key: b)
  n.has(key: a)

pub aliased_item(s: Set[Int], x: Int, y: Int) -> Bool
  ensures result
=
  var t = s
  edit t.add(item: x)
  edit t.remove(item: y)
  t.has(item: x)

pub aliased_in_a_map(m: Map[Text, Int], a: Text, b: Text) -> Bool
  ensures result
=
  var n = m
  edit n.set(key: a, value: 1)
  edit n.remove(key: b)
  n.has(key: a)

pub same_order(a: HashMap[Text, Int], b: HashMap[Text, Int]) -> Bool
  ensures result
=
  if a.same_entries(as: b) then a.keys() == b.keys() else true

pub hashed_measure(seen: HashSet[Int], waiting: Queue[Int], nodes: Int) -> Int
  ensures result >= 0
=
  2 * (nodes - seen.len) + waiting.len

pub next_in_front(q: Queue[Int]) -> Bool
  requires q.len > 1
  ensures result
=
  var r = q
  const first = edit r.pop()
  r.peek() == first
