-- test: an operation conditioned by `where` runs only where its condition holds: unguarded it is U5001 with the counterexample, guarded or under `requires` it is proven; the condition is of the arguments the caller passed, so reassigning an `edit` parameter changes nothing (ADR 0092 rule 3, spec/05 §3)
-- spec: spec/05 §3
-- expect: error U5001 at src/ops.una:14:3
-- expect: error U5001 at src/ops.una:32:25
-- expect: error U5001 at src/ops.una:46:3
module ops

pub capability Log
  op write(n: Int) -> Unit

pub unguarded(n: Int, dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  @log.write(n)

pub guarded(n: Int, dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  if not dry
    @log.write(n)
  unit

pub required(n: Int, dry: Bool) -> Unit
  requires not dry
  uses @log: Log[write where not dry]
=
  @log.write(n)

pub in_lambda(xs: List[Int], dry: Bool) -> List[Unit]
  uses @log: Log[write where not dry]
=
  xs.map(each: fn(n) -> @log.write(n))

pub lambda_guarded(xs: List[Int], dry: Bool) -> Int
  uses @log: Log[write where not dry]
=
  if not dry
    let written = xs.map(each: fn(n) -> @log.write(n))
    unit
  xs.len

pub reassigned(n: Int, edit dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  dry = false
  @log.write(n)

pub reassigned_guarded(n: Int, edit dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  if not dry
    dry = true
    @log.write(n)
  unit
