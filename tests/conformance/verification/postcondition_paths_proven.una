-- test: an ensures clause holds on every return path
-- spec: spec/12 §3
-- expect: ok
module postcondition_paths_proven

pub kind Band = Low | Mid | High

pub band(n: Int) -> Band
  ensures n < 10 implies result is Low
  ensures n >= 100 implies result is High
=
  if n < 10 then Low else if n < 100 then Mid else High
