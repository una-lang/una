-- test: the repairs of a function value's preconditions check once applied: a lambda that guards every `requires`, and a named helper with a handling clause for a function that can fail (issue #106, V12-003)
-- spec: spec/12 §3
-- expect: ok
module precondition_repairs_check

pub kind Bad = | Broke

pub same(a: Int, b: Int) -> Int
  requires a == b
  requires a > 0
=
  a - b

pub apply(f: fn(Int, Int) -> Int) -> Int = f(1, 2)

pub guarded() -> Int = apply(fn(a, b) -> if a == b and a > 0 then same(a, b) else 0)

pub risky(a: Int, b: Int) -> Int
  requires a == b
  requires a > 0
  fails Bad
=
  if a > 5 then fail Broke else a - b

pub apply_failing(f: fn(Int, Int) -> Int fails Bad) -> Int
  fails Bad
=
  let v = f(1, 2)
    if error pass
  v

risky_where_defined(a: Int, b: Int) -> Int
  fails Bad
=
  if a == b and a > 0
    let v = risky(a, b)
      if error pass
    v
  else
    0

pub helped() -> Int
  fails Bad
=
  let v = apply_failing(risky_where_defined)
    if error pass
  v
