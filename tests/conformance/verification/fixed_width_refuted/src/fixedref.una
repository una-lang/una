-- test: a constant expression that leaves the range, unsigned negation, and the least I64 divided by -1 are refuted overflow obligations (spec/18 §2, §3)
-- spec: spec/18 §3
-- expect: error U5001 at src/fixedref.una:8:24
-- expect: error U5001 at src/fixedref.una:10:28
-- expect: error U5001 at src/fixedref.una:12:30
module fixedref

pub constant() -> U8 = 200 + 100

pub negated(a: U8) -> U8 = -a

pub divided(a: I64) -> I64 = a / -1
