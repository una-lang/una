-- test: an off-by-one index in a function with float lets is refuted from the cone query, with its counterexample
-- spec: spec/29 §8
-- expect: error U5001 at src/m.una:18:3
module m

get(xs: List[F64], i: Int) -> F64
  requires 0 <= i and i < xs.len
=
  when at(xs, index: i)
    is Some(v) -> v
    is None -> 0.0

pub last(xs: List[F64], k: F64) -> F64
  requires xs.len > 0
=
  let a = k * 2.0
  let b = a + 1.0
  get(xs, i: xs.len) + b
