-- test: an inclusive range ends at its upper bound without computing its successor, so the loop variable of `low..255` may be 255 and of `low..<255` may not (spec/17 §4, §5 rule 3)
-- spec: spec/17 §4, §5
-- expect: error U5001 at src/for_over.una:11:20
module for_over

--- The loop variable of `low..top` reaches 255, so its successor overflows `U8`.
pub successor(low: U8) -> Unit
=
  let top: U8 = 255
  for b in low..top
    let next: U8 = b + 1
    unit
  unit

--- In `low..<top` it stays below 255, so the successor fits.
pub below(low: U8) -> Unit
=
  let top: U8 = 255
  for b in low..<top
    let next: U8 = b + 1
    unit
  unit
