-- test: values of a fixed-width type lie in its range, guarded operations and conversions are proven, and the method contracts hold (spec/18 §3, §5, §6)
-- spec: spec/18 §6
-- expect: ok
module fixedproof

pub add(a: U8, b: U8) -> U8 = if a < 100 and b < 100 then a + b else 0

pub narrow(a: I32) -> U8 = if a >= 0 and a <= 255 then a.to_u8() else 0

pub widen(a: U8) -> I64 = a.to_i64() * 1000

pub bounded(a: U8) -> Bool
  ensures result
=
  a <= 255 and a >= 0

pub wrap(a: U8) -> U8
  ensures result == (a + 1) mod 256
=
  a.wrapping_add(by: 1)

pub saturate(a: I8) -> I8
  ensures result == 127 or result == a + 1
=
  a.saturating_add(by: 1)

pub masked(a: U8) -> U8
  ensures result <= 15
=
  a.bit_and(mask: 15)

pub doubled(a: U8) -> U8
  ensures result == (a * 4) mod 256
=
  a.wrapping_shift_left(by: 2)

pub halved(a: U16) -> U16
  ensures result <= a
=
  a.shift_right(by: 1)
