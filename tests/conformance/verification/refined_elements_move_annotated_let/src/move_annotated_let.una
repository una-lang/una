-- test: movement annotated_let: a `List[Int]` bound by a `let` annotated `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_annotated_let.una:11:22
module move_annotated_let

pub kind Pos = Int where it > 0

pub moved(ints: List[Int], ps: List[Pos]) -> Int
=
  let a: List[Pos] = ps
  let b: List[Pos] = ints
  a.len + b.len
