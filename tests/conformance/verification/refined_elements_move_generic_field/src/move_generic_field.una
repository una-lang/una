-- test: movement generic_field: an `Int` stored in the field of a generic kind built at `Box[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_generic_field.una:13:44
module move_generic_field

pub kind Pos = Int where it > 0

pub kind Box[T]
  value: T

pub kept(p: Pos) -> Box[Pos] = Box(value: p)

pub moved(n: Int) -> Box[Pos] = Box(value: n)
