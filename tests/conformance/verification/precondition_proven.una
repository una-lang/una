-- test: a call under a condition that implies the callee's requires is accepted, and the callee's ensures holds
-- spec: spec/12 §3
-- expect: ok
module precondition_proven

pub half(n: Int) -> Int
  requires n >= 0
  ensures result >= 0 and result <= n
=
  n / 2

pub halve(n: Int) -> Int = if n >= 0 then half(n) else 0
