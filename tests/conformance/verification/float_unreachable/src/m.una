-- test: an integer goal on a path that only float facts make unreachable: the cone query abstracts the float condition and is refuted, and the full query proves the goal; a Bool binder of a float comparison that a kept condition uses is connected the same way
-- spec: spec/29 §8
-- expect: ok
module m

geti(xs: List[Int], i: Int) -> Int
  requires 0 <= i and i < xs.len
=
  when at(xs, index: i)
    is Some(v) -> v
    is None -> 0

pub guarded(xs: List[Int], x: F64) -> Int
  requires xs.len == 1
=
  if x.ieee_lt(other: 1.0) and x.ieee_gt(other: 2.0) then geti(xs, i: 5) else geti(xs, i: 0)

pub flagged(xs: List[Int], x: F64) -> Int
  requires xs.len == 1
=
  let low = x < 1.0
  let high = x > 2.0
  if low and high then geti(xs, i: 5) else geti(xs, i: 0)
