-- test: a callee's ensures and the prelude's contracts are hypotheses for the caller
-- spec: spec/12 §3
-- expect: ok
module callee_ensures_proven

pub kind Positive = Int where it > 0

pub kind Natural = Int where it >= 0

pub positive(n: Int) -> Int
  ensures result > 0
=
  if n > 0 then n else 1

pub make(n: Int) -> Positive = positive(n)

pub size(n: Int) -> Natural = abs(n)

pub first_or_zero(xs: List[Int]) -> Int
  ensures xs.len == 0 implies result == 0
=
  when xs.first()
    is Some(x) -> x
    is None -> 0
