-- test: a shift amount is an Int with the precondition `0 <= n and n < width`; widening conversions and wrapping methods carry no obligation (spec/18 §4, §5)
-- spec: spec/18 §5
-- expect: error U5001 at src/fixedshift.una:10:32
module fixedshift

pub fixed(a: U32) -> U32 = a.shift_right(3).wrapping_shift_left(31)

pub widen(a: U8) -> U16 = a.to_u16().wrapping_mul(a.to_u16())

pub any(a: U8, n: Int) -> U8 = a.shift_right(n)
