-- test: `error` inside a lambda of an `if error use` handler has no value in Core IR, so the function does not elaborate and the package is rejected: U8001
-- spec: spec/09 §3
-- expect: error U8001 at src/m.una:13:1
module m

pub kind Problem = A | B

risky(n: Int) -> Int
  fails Problem
=
  if n > 0 then fail B else 1

pub f(n: Int) -> Int
=
  let v = risky(n)
    if error use (fn(k: Int) -> if error is A then k else 0)(1)
  10 / v
