-- test: a lambda's body is not a position of `error`, even in an `if error use` handler, so `error` inside it is U2013 at the checker, not an internal error
-- spec: spec/02 §8
-- expect: error U2013 at src/m.una:16:36
module m

pub kind Problem = A | B

risky(n: Int) -> Int
  fails Problem
=
  if n > 0 then fail B else 1

pub f(n: Int) -> Int
=
  let v = risky(n)
    if error use (fn(k: Int) -> if error is A then k else 0)(1)
  10 / v
