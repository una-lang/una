-- test: a header whose condition on a locked operation does not imply the lock's is U3023, through a refuted `contract_lock` obligation (ADR 0092 rule 8)
-- spec: spec/12 §3
-- expect: error U3023 at src/shop.una:15:33
module shop

pub capability Catalog
  op price(sku: Int) -> Int
  op set_price(sku: Int, cents: Int) -> Unit
  op journal(n: Int) -> Unit

pub capability Log
  op write(n: Int) -> Unit

pub update(sku: Int, cents: Int, dry_run: Bool) -> Unit
  uses @catalog: Catalog[price, set_price where cents > 0, journal where not dry_run]
=
  if cents > 0
    @catalog.set_price(sku, cents)
  unit
