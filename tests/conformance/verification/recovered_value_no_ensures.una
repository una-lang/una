-- test: a value recovered with if error use does not inherit the callee's ensures (review control)
-- spec: spec/06 §3
-- expect: error U5001 at 19:3
module recovered_value_no_ensures

pub kind Oops = | Bad

g(x: Int) -> Int
  ensures result > 0
  fails Oops
=
  if x > 5 then fail Bad else 1

pub f(x: Int) -> Int
  ensures result > 0
=
  let v = g(x)
    if error use 0
  v
