-- test: movement declassify: a policy's `List[Int]` result bound by a `let` annotated `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_declassify.una:19:23
trusted module move_declassify

pub kind Pos = Int where it > 0

pub policy open_list
  from secret List[Int]
  to public List[Int]
  via opened
  purpose "test"
  owner team

opened(xs: secret List[Int]) -> public List[Int] = xs

pub moved(xs: secret List[Int]) -> Int
=
  let ys: List[Pos] = open_list(xs)
  ys.len
