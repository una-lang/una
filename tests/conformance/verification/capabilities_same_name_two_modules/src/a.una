-- test: two capabilities with one name in two modules are two declarations with their own contracts (R-008)
-- spec: spec/10 §11
-- expect: error U5001 at src/a.una:12:14
-- expect: error U5001 at src/b.una:13:3
module a

pub capability Store
  op get() -> Int
    ensures result > 0

pub handler zero() for Store
  op get() = 0

pub ratio() -> Int
  uses @store: Store[get]
=
  let n = @store.get()
  100 / n
