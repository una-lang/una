-- test: a float contract that weighs more than the bound, a dot product of four, is U5002 with the float reason, before any solving
-- spec: spec/29 §8
-- expect: error U5002 at X
module m

pub kind Unit01 = F64 where it.ieee_ge(other: 0.0) and it <= 1.0

pub dot(a: Unit01, b: Unit01, c: Unit01, d: Unit01) -> F64
  ensures result <= 2.0
=
  a * b + c * d
