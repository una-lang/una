-- test: an element read through `first`, `at`, `first_where`, `or_else`, a pattern, a loop variable, a lambda's parameter, `fold`'s accumulator under an expected type, and a map's `get` carries its refinement, which proves `needs`' precondition (ADR 0103 rule 6)
-- spec: spec/12 §3
-- expect: ok
module access

pub kind Pos = Int where it > 0

needs(n: Pos) -> Int = n

pub via_first(ps: List[Pos]) -> Int
=
  when ps.first()
    is Some(x) -> needs(x)
    is None -> 0

pub via_at(ps: List[Pos]) -> Int
=
  when ps.at(index: 2)
    is Some(x) -> needs(x)
    is None -> 0

pub via_first_where(ps: List[Pos]) -> Int
=
  let found = ps.first_where(keep: fn(x) -> x > 5)
    if none use 1
  needs(found)

pub via_or_else(ps: List[Pos], p: Pos) -> Int
=
  let x = ps.first().or_else(default: p)
  needs(x)

pub via_some(p: Pos) -> Int
=
  when Some(p)
    is Some(x) -> needs(x)
    is None -> 0

pub via_loop(ps: List[Pos]) -> Int
=
  let edit total = 0
  for x in ps
    total = total + needs(x)
  total

pub via_lambda(ps: List[Pos]) -> List[Int] = ps.map(each: fn(x) -> needs(x))

pub via_fold(ps: List[Pos], p: Pos) -> Pos
=
  let best: Pos = ps.fold(initial: p, step: fn(acc, x) -> acc + x)
  best

pub via_get(m: Map[Text, Pos]) -> Int
=
  when m.get(key: "a")
    is Some(v) -> needs(v)
    is None -> 0

pub fold_at_the_base(ps: List[Pos], p: Pos) -> Int = ps.fold(initial: p, step: fn(acc,
    x
  ) -> acc - x)
