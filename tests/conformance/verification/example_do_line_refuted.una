-- test: a call on the do line of an example that breaks the callee's requires is refuted (R-037)
-- spec: spec/12 §3
-- expect: error U5001 at 12:6
module example_do_line_refuted

pub half(n: Int) -> Int
  requires n >= 0
=
  n / 2

example "half of a negative number"
  do half(-4)
  expect result == -2
