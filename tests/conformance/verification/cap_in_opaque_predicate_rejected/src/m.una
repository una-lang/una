-- test: a capability reference in the body of an opaque predicate does not elaborate, and the package is rejected rather than the body's division going unverified: U8001
-- spec: spec/09 §3
-- expect: error U8001 at src/m.una:6:1
module m

pub predicate opaque p(n: Int) -> Bool = @c > @c and 100 / n > 0
