-- test: a Decimal holds a JsonNumber, whose refinement is an obligation at the constructor: a text that checked has tested proves it, any other text, a literal included, is refuted; and a JsonNumber in a signature is its refinement, never false, so nothing about it holds vacuously (spec/23 §1, §7, N-27)
-- spec: spec/23 §7
-- expect: error U5001 at src/json_decimal.una:8:42
-- expect: error U5001 at src/json_decimal.una:18:32
-- expect: error U5001 at src/json_decimal.una:20:38
module json_decimal

pub unchecked(t: Text) -> Json = Decimal(t)

pub tested(t: Text) -> Json
  fails JsonError
=
  let n = checked(t, is_json_number(it)) else fail Syntax(0)
  Decimal(n)

pub same(a: JsonNumber) -> JsonNumber = a

pub forged() -> Json = Decimal("x")

pub negative(a: JsonNumber) -> Nat = -1
