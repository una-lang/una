-- test: a call of a callee that may fail keeps the callee's `requires` as an obligation at the call, which is refuted
-- spec: spec/12 §3
-- expect: error U5001 at src/m.una:18:11
module m

pub kind Problem = Oops | Other

pub div(a: Int, b: Int) -> Int
  requires b != 0
  fails Problem
=
  let q = a / b
  if q > 10 then fail Oops else q

pub use_it() -> Int
  fails Problem
=
  let r = div(a: 1, b: 0)
    if error pass
  r
