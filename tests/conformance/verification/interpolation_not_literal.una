-- test: interpolated texts are not encoded as distinct literal constants (review control)
-- spec: spec/12 §4
-- expect: error U5001 at 11:3
-- expect: error U5001 at 16:3
-- expect: error U5001 at 21:3
module interpolation_not_literal

pub same(x: Int, y: Int) -> Bool
  ensures result == false
=
  "{x}" == "{y}"

pub lit(x: Int) -> Bool
  ensures result == false
=
  "n{x}" == "n1"

pub lens(x: Int) -> Int
  ensures result == 4
=
  "n{x}".len
