-- test: arithmetic on a fixed-width type and a narrowing conversion carry an `overflow` obligation, refuted with a counterexample when the result can leave the range (spec/18 §3)
-- spec: spec/18 §3
-- expect: error U5001 at src/fixedover.una:8:31
-- expect: error U5001 at src/fixedover.una:10:28
-- expect: error U5001 at src/fixedover.una:12:27
module fixedover

pub add(a: U8, b: U8) -> U8 = a + b

pub narrow(a: I32) -> U8 = a.to_u8()

pub negate(a: I8) -> I8 = -a
