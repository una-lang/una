-- test: in edition 0.5, `push` on a priority queue stores its item at `T` and its priority at `P`, each a `refinement` obligation when its type is refined, refuted for a non-positive value and proven for a `Pos` (ADR 0119 rules 1 and 13, ADR 0103 rule 3)
-- spec: spec/28 §8
-- expect: error U5001 at src/items.una:20:21
-- expect: error U5001 at src/items.una:26:36
module items

import std.collections (PriorityQueue, lowest_first)

pub kind Pos = Int where it > 0

pub kept(p: Pos) -> Int
=
  var q: PriorityQueue[Pos, Pos] = lowest_first()
  edit q.push(item: p, priority: p)
  q.items().len

pub moved_item() -> Int
=
  var q: PriorityQueue[Pos, Int] = lowest_first()
  edit q.push(item: 0, priority: 1)
  q.items().len

pub moved_priority() -> Int
=
  var q: PriorityQueue[Text, Pos] = lowest_first()
  edit q.push(item: "a", priority: -2)
  q.items().len
