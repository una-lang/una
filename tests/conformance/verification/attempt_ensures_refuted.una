-- test: a failed attempt carries no ensures, as failures have no postcondition (spec/04 §2), so the error path is refuted (DECISION D-131)
-- spec: spec/12 §3
-- expect: error U5001 at 20:15
module attempt_ensures_refuted

pub kind Oops = | TooLarge

pub bump(n: Int) -> Int
  ensures result > n
  fails Oops
=
  if n > 100 then fail TooLarge else n + 1

pub always_bumped(n: Int) -> Int
  ensures result > n
=
  let outcome = attempt bump(n)
  when outcome
    is Ok(value) -> value
    is Err -> n
