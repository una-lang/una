-- test: a refutation whose model divides by zero on its path keeps its status, and the division obligation reports the division; a zero divisor on a path that does not divide keeps the counterexample (ADR 0054, amendment of 2026-10-08, #399)
-- spec: spec/12 §6
-- expect: error U5001 at 11:11
-- expect: error U5001 at 12:3
-- expect: error U5001 at 17:18
module zero_divisor_counterexample

pub divided(a: Int, b: Int) -> Int
  ensures result == 7
=
  let q = a / b
  q

pub skipped(a: Int, b: Int) -> Int
  ensures result != 5
=
  if b == 0 then 5 else a / b
