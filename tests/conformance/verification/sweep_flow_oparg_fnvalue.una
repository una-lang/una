-- test: an operation argument fed by a function value parameter checks every flow (refinement); each _bad probe is rejected and each _ok twin accepted (flow sweep, ADR 0050)
-- spec: spec/12 §3
-- expect: error U5001 at 38:13
module sweep_flow_oparg_fnvalue

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  hide: fn(secret Int) -> Int

capability Probe
  op take_l(v: fn(secret Int) -> Int) -> Int
    accepts secret
  op take_d(v: Int) -> Int
  op take_f(v: fn(Int) -> Pos) -> Int
    accepts secret
  op take_r(v: Pos) -> Int

mk_g() -> fn(Int) -> Int = fn(x: Int) -> x

mk_u() -> fn(secret Int) -> Int = fn(x: secret Int) -> 0

mk_k() -> fn(Int) -> Pos = fn(x: Int) -> 1

secret_of(x: secret Int) -> secret Int = x

zero(x: Int) -> Int = 0

ident[T](x: T) -> T = x

pub f_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, u: fn(secret Int) -> Int, t: fn(Int) -> secret Int) -> Int
  uses @p: Probe[take_f]
=
  @p.take_f(g)

pub f_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, u: fn(secret Int) -> Int, t: fn(Int) -> secret Int) -> Int
  uses @p: Probe[take_f]
=
  @p.take_f(k)
