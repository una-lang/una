-- test: refutable contracts over `Complex[F64]` are refuted with their counterexamples: the real part of a value equal to `complex(re: 1.5, im: 2.5)` is not 2.5, and a conjugate is not the value itself when its imaginary part is not zero
-- spec: spec/29 §19
-- expect: error U5001 at src/m.una:11:3
-- expect: error U5001 at src/m.una:16:3
module m

pub real_part(z: Complex[F64]) -> F64
  requires z == complex(re: 1.5, im: 2.5)
  ensures result == 2.5
=
  z.re

pub conjugate(z: Complex[F64]) -> Complex[F64]
  ensures result == z
=
  z.conj()
