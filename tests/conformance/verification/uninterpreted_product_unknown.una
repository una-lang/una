-- test: a refutation whose model disagrees with real arithmetic at a product of two values is unknown, U5002, with no counterexample; one whose model agrees is refuted, U5001 (issue #72, ADR 0053)
-- spec: spec/12 §6
-- expect: error U5002 at 7:38
-- expect: error U5001 at 13:3
module uninterpreted_product_unknown

pub product(a: Nat, b: Nat) -> Nat = a * b

pub six(a: Int, b: Int) -> Int
  requires a == 2 and b == 3
  ensures result != 6
=
  a * b
