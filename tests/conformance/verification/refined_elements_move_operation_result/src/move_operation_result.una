-- test: movement operation_result: an operation's `List[Int]` result bound by a `let` annotated `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_operation_result.una:16:22
module move_operation_result

pub kind Pos = Int where it > 0

pub capability Source
  op ints() -> List[Int]
  op poss() -> List[Pos]

pub moved() -> Int
  uses @source: Source[ints, poss]
=
  let a: List[Pos] = @source.poss()
  let b: List[Pos] = @source.ints()
  a.len + b.len
