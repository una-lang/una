-- test: movement map_get: a map's `get` of a `Map[Text, Int]` bound by a `let` annotated `Option[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_map_get.una:15:24
module move_map_get

pub kind Pos = Int where it > 0

pub kept(m: Map[Text, Pos]) -> Int
=
  let o: Option[Pos] = m.get(key: "a")
  0

pub moved(m: Map[Text, Int]) -> Int
=
  let o: Option[Pos] = m.get(key: "a")
  0
