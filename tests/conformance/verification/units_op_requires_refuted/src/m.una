-- test: a call of a capability operation whose measured `requires` may not hold is refuted at the call
-- spec: spec/12 §3
-- expect: error U5001 at src/m.una:19:3
module m

pub measure Meter

pub capability Pump
  op push(a: I32 of Meter) -> I32 of Meter
    requires a > 0
    ensures result == a

handler fake() for Pump
  op push(a) = a

pub run(a: I32 of Meter) -> I32 of Meter
  uses @pump: Pump[push]
=
  @pump.push(a)
