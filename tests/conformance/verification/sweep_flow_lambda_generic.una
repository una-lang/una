-- test: a lambda result fed by a generic call checks every flow (function result refinement, function parameter refinement, refinement); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/12 §3
-- expect: error U5001 at 28:224
-- expect: error U5001 at 30:224
-- expect: error U5001 at 32:224
module sweep_flow_lambda_generic

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub id[T](x: T) -> T = x

pub apply_r(f: fn(Int) -> Pos) -> Int = 0

pub apply_f(f: fn(Int) -> fn(Int) -> Pos) -> Int = 0

pub apply_e(f: fn(Int) -> fn(Int) -> Int) -> Int = 0

pub r_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print]) -> Int = apply_r(fn(x: Int) -> id(0))

pub f_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print]) -> Int = apply_f(fn(x: Int) -> id(g))

pub p_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print]) -> Int = apply_e(fn(x: Int) -> id(w))

pub p_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print]) -> Int = apply_e(fn(x: Int) -> id(g))
