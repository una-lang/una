-- test: a decimal is its coefficient in the verifier: a refinement on amounts is proven for a sum and refuted for a difference, with the counterexample by value
-- spec: spec/29 §16
-- expect: error U5001 at src/m.una:10:44
module m

pub kind Amount = Decimal[2] where it >= 0.00

pub sum(a: Amount, b: Amount) -> Amount = a + b

pub diff(a: Amount, b: Amount) -> Amount = a - b

pub mixed(a: Amount, rate: Decimal[4]) -> Bool
  requires rate >= 0.0000
  ensures result
=
  a + rate >= 0.0
