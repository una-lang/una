-- test: a recursive function over a recursive kind is verified by its contract at each recursive call, and the encoding has no acyclicity axiom, so `left != e` is not provable (ADR 0060 R3, spec/12 §4)
-- spec: spec/12 §4
-- expect: error U5001 at src/reccon.una:14:22
-- expect: error U5001 at src/reccon.una:23:28
module reccon

pub kind Expr = Lit(value: Int) | Add(left: Expr, right: Expr)

--- The number of nodes, claimed at least two: a literal has one.
pub size(e: Expr) -> Int
  ensures result >= 2
=
  when e
    is Lit(value) -> 1
    is Add(left, right) -> 1 + size(left) + size(right)

--- No fact of the encoding says that a value differs from its fields.
pub not_cyclic(e: Expr) -> Bool
  requires e is Add
  ensures result
=
  when e
    is Add(left, right) -> left != e
    else -> true
