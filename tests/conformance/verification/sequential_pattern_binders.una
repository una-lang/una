-- test: pattern variables of one name in two when expressions are distinct solver symbols (review control)
-- spec: spec/12 §4
-- expect: error U5001 at 13:19
module sequential_pattern_binders

pub f(o2: Option[Int]) -> Int
=
  let o1 = Some(5)
  let a = when o1
    is Some(v) -> v
    is None -> 1
  let b = when o2
    is Some(v) -> 100 / v
    is None -> 0
  a + b
