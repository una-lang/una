-- test: movement edit_back: a `List[Pos]` place passed to an `edit` parameter of `List[Int]`: the final value flows back is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_edit_back.una:20:13
module move_edit_back

pub kind Pos = Int where it > 0

grow(edit xs: List[Int]) -> Unit
=
  xs = xs.append(item: -1)

keep(edit xs: List[Pos]) -> Unit
=
  xs = xs

pub moved(ps: List[Pos]) -> Int
=
  let edit mine: List[Pos] = ps
  keep(edit mine)
  grow(edit mine)
  mine.len
