-- test: literal arms that miss a value are refuted with a goal that prints the literals as values (R-032)
-- spec: spec/12 §3
-- expect: error U5001 at 10:3
module literal_arms_goal_text

pub kind Level = Low | High

pub classify(n: Int in 0..2) -> Level
=
  when n
    is 0 -> Low
    is 2 -> High
