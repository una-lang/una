-- test: the list of a `together for` has one element per task: as many as its list has, or as many integers as its range holds, none for an empty range (spec/19 §4 rule 2)
-- spec: spec/19 §4
-- expect: error U5001 at src/together_length.una:42:3
module together_length

pub doubled(xs: List[Int]) -> List[Int]
  ensures result.len == xs.len
=
  together for x in xs
    x * 2

pub bound(xs: List[Int]) -> Int
  ensures result == xs.len
=
  let ys = together for x in xs
    x + 1
  ys.len

pub inclusive(a: Int, b: Int) -> List[Int]
  ensures a <= b implies result.len == b - a + 1
  ensures a > b implies result.len == 0
=
  together for i in a..b
    i

pub exclusive(n: Int) -> List[Int]
  requires n >= 0
  ensures result.len == n
=
  together for i in 0..<n
    i

pub empty_range() -> List[Int]
  ensures result.len == 0
=
  together for i in 3..<1
    i

pub too_long(xs: List[Int]) -> List[Int]
  ensures result.len == xs.len + 1
=
  together for x in xs
    x
