-- test: movement priority_update: an `Int` pushed onto a `PriorityQueue[Pos, Pos]`, as its item or as its priority, is a `refinement` obligation, refuted, while a `Pos` pushed onto it gives none; the editable bindings are annotated, since without an annotation they would drop the refinements (`spec/17 §2` rule 4) (ADR 0103 rules 3 and 4, ADR 0119 rule 1)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_priority_update.una:21:21
-- expect: error U5001 at src/move_priority_update.una:22:34
module move_priority_update

import std.collections (PriorityQueue)

pub kind Pos = Int where it > 0

pub kept(q: PriorityQueue[Pos, Pos], p: Pos) -> Int
=
  var r: PriorityQueue[Pos, Pos] = q
  edit r.push(item: p, priority: p)
  const o = edit r.pop()
  r.len

pub moved(q: PriorityQueue[Pos, Pos], n: Int) -> Int
=
  var r: PriorityQueue[Pos, Pos] = q
  edit r.push(item: n, priority: 1)
  edit r.push(item: 1, priority: n)
  r.len
