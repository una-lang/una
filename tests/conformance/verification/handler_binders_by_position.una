-- test: handler operation binders bind the operation's parameters by position (review control)
-- spec: spec/05 §5
-- expect: error U5001 at 11:19
module handler_binders_by_position

pub capability Pick
  op pick(a: Int, b: Int) -> Int
    ensures result == a

pub handler swapped() for Pick
  op pick(b, a) = a

pub use_pick() -> Int
  ensures result == 1
  uses @p: Pick[pick]
=
  @p.pick(1, b: 2)

example "the handler breaks the contract"
  given @p = swapped()
  do use_pick()
  expect result == 1
