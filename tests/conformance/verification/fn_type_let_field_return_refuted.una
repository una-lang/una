-- test: a function value flowing into an annotated let, a constructor field and a declared result is an obligation at the value (ADR 0037 rule 2)
-- spec: spec/12 §3
-- expect: error U5001 at 17:27
-- expect: error U5001 at 20:36
-- expect: error U5001 at 22:36
module fn_type_let_field_return_refuted

pub kind Pos = Int where it > 0

pub kind Holder
  run: fn(Int) -> Int

pub takes_pos(x: Pos) -> Int = x

pub bound() -> Int
=
  let g: fn(Int) -> Int = takes_pos
  g(0)

pub held() -> Holder = Holder(run: takes_pos)

pub returned() -> fn(Int) -> Int = takes_pos
