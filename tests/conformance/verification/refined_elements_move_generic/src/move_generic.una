-- test: movement generic: a `List[Int]` given to a generic function whose type argument the expected type fixes to `List[Pos]` is a `refinement` obligation, refuted, while the same movement at the same refined type gives none (ADR 0103 rules 3 and 4)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_generic.una:13:25
module move_generic

pub kind Pos = Int where it > 0

id[T](x: T) -> T = x

pub moved(ints: List[Int], ps: List[Pos]) -> Int
=
  let a: List[Pos] = id(ps)
  let b: List[Pos] = id(ints)
  a.len + b.len
