-- test: variants that share a field name with different types have distinct field functions (R-019)
-- spec: spec/12 §4
-- expect: ok
module variants_share_field_name

pub kind Shape = Circle(size: Int) | Label(size: Text)

pub measure(s: Shape) -> Int
  ensures result >= 0
=
  when s
    is Circle(size) -> abs(size)
    is Label(size) -> size.len
