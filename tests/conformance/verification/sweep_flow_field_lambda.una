-- test: a constructor field fed by a lambda checks every flow (function result refinement, function parameter refinement); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/12 §3
-- expect: error U5001 at 28:35
-- expect: error U5001 at 38:21
module sweep_flow_field_lambda

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub kind BoxF
  v: fn(Int) -> Pos

pub kind BoxE
  v: fn(Int) -> Int

pub f_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxF = BoxF(v: fn(y: Int) -> 0)

pub f_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxF = BoxF(v: fn(y: Int) -> 1)

pub p_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxE = BoxE(v: fn(y: Pos) -> y)

pub p_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxE = BoxE(v: fn(y: Int) -> y)
