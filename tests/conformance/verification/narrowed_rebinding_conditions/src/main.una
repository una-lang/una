-- test: a narrowed rebinding keeps the conditions of the binding it narrows: the callee's `write` is charged against `not dry` at the call, proven under `if not dry` and not without it (ADR 0093 rules 4 and 13, ADR 0092 rule 3)
-- spec: spec/05 §3
-- expect: error U5001 at src/main.una:15:3
module main

pub capability Log
  op write(n: Int) -> Unit
  op flush() -> Unit

helper(n: Int) -> Unit = @log.write(n)

pub rebound(n: Int, dry: Bool) -> Unit
  uses @out: Log[write where not dry, flush]
=
  helper(n) with @log = @out[write]

pub guarded(n: Int, dry: Bool) -> Unit
  uses @out: Log[write where not dry, flush]
=
  if not dry
    helper(n) with @log = @out[write]
  unit
