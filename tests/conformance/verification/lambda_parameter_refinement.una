-- test: an annotated lambda parameter, and one that takes its type from the expected function type, assume their refinement (issue #71, UI-008)
-- spec: spec/12 §3
-- expect: ok
module lambda_parameter_refinement

pub kind Pos = Int where it > 0

pub need_pos(n: Int) -> Int
  requires n > 0
=
  n

pub apply(f: fn(Pos) -> Int, x: Pos) -> Int = f(x)

pub named_pos(n: Pos) -> Int = need_pos(n)

pub annotated(x: Pos) -> Int = apply(fn(n: Pos) -> need_pos(n), x: x)

pub from_expected(x: Pos) -> Int = apply(fn(n) -> need_pos(n), x: x)
