-- test: the deadline of `for ever within` is at least 1, a `refinement` obligation: `within 0` is refuted, and a deadline from a parameter refined to `1..` is proven (spec/26 §6, ADR 0116 rule 11)
-- spec: spec/26 §6
-- expect: error U5001 at src/zero.una:11:19
module zero

import std.time (millisecond)

pub never() -> Unit
  diverges
=
  for ever within 0 * millisecond
    stop
  unit

pub every(ms: Int) -> Unit
  requires ms >= 1
  diverges
=
  for ever within ms * millisecond
    stop
  unit
