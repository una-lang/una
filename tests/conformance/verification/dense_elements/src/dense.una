-- test: `get` is in the refinement language over integer elements: a read is the element term, and `set` ensures the element it writes, so reading it back is proven; an element of `F64` in a clause is U2014 until floats are in the refinement language
-- spec: spec/29 §17
-- expect: error U2014 at src/dense.una:22:26
-- expect: error U2014 at src/dense.una:22:45
module dense

pub first(a: Array[I32]) -> I32
  requires a.len > 0
  ensures result == a.get(index: 0)
=
  a.get(index: 0)

pub written(m: Matrix[I64], i: Int, j: Int) -> Bool
  requires 0 <= i and i < m.rows and 0 <= j and j < m.columns
  ensures result
=
  var n = m
  edit n.set(row: i, column: j, item: 5)
  n.get(row: i, column: j) == 5

pub float(a: Array[F64]) -> F64
  requires a.len > 0 and a.get(index: 0) == a.get(index: 0)
=
  a.get(index: 0)
