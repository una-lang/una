-- test: movement seq_update: an `Int` pushed onto a `Queue[Pos]` or a `Stack[Pos]` is a `refinement` obligation, refuted, while a `Pos` pushed onto it gives none; the editable bindings are annotated, since without an annotation they would drop the element refinement (`spec/17 §2` rule 4) (ADR 0103 rules 3 and 4, ADR 0119 rule 1)
-- spec: spec/12 §3
-- expect: error U5001 at src/move_seq_update.una:23:21
-- expect: error U5001 at src/move_seq_update.una:25:21
module move_seq_update

import std.collections (Queue, Stack)

pub kind Pos = Int where it > 0

pub kept(q: Queue[Pos], s: Stack[Pos], p: Pos) -> Int
=
  var r: Queue[Pos] = q
  edit r.push(item: p)
  edit r.push_front(item: p)
  var t: Stack[Pos] = s
  edit t.push(item: p)
  r.len + t.len

pub moved(q: Queue[Pos], s: Stack[Pos], n: Int) -> Int
=
  var r: Queue[Pos] = q
  edit r.push(item: n)
  var t: Stack[Pos] = s
  edit t.push(item: n)
  r.len + t.len
