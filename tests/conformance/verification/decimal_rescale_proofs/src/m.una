pub identity(x: Decimal[2]) -> Bool
  ensures result
=
  const q = x.divide(by: 3.00, scale: 0, rounding: TowardZero)
  const r = x.remainder(by: 3.00, scale: 0)
  x == 3.00 * q + r

pub sign(x: Decimal[2]) -> Bool
  requires x >= 0.00
  ensures result
=
  x.remainder(by: 3.00, scale: 1) >= 0.00

pub wrong() -> Bool
  ensures result
=
  const x: Decimal[2] = 2.25
  x.rescale(scale: 1, rounding: HalfEven) == 2.3
