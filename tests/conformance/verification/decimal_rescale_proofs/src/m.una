-- test: rescale by each rounding mode at a tie, beyond it and below it, on both signs, proven against rule 4; remainder's identity `x == y × q + r` and its sign proven; a wrong rounding refuted
-- spec: spec/29 §16
-- expect: error U5001 at src/m.una:233:3
module m

pub halfeven_2_25() -> Bool
  ensures result
=
  const x: Decimal[2] = 2.25
  x.rescale(scale: 1, rounding: HalfEven) == 2.2

pub halfeven_n2_25() -> Bool
  ensures result
=
  const x: Decimal[2] = -2.25
  x.rescale(scale: 1, rounding: HalfEven) == -2.2

