-- test: each row of the FloatingPoint encoding is the run-time semantics: literals by their bits, the rounded operators, identity and totalOrder, the IEEE comparisons, the classifications, the zeros and the conversions of every integer width, each pinned by a fact that holds only under that semantics
-- spec: spec/29 §8
-- expect: ok
module m

pub kind Unit01 = F64 where it.ieee_ge(other: 0.0) and it <= 1.0

pub add() -> F64
  ensures result == 0.30000000000000004 and result != 0.3
=
  0.1 + 0.2

pub sub() -> F64
  ensures result == 0.09999999999999998
=
  1.0 - 0.9

pub mul() -> F64
  ensures result == 0.30000000000000004
=
  0.1 * 3.0

pub div() -> F64
  ensures result == 0.3333333333333333
=
  1.0 / 3.0

pub div_zero(x: F64) -> F64
  requires x.is_finite() and x.ieee_gt(other: 0.0)
  ensures result.is_infinite() and not result.is_sign_negative()
=
  x / 0.0

pub zero_by_zero() -> F64
  ensures result.is_nan() and result == nan()
=
  0.0 / 0.0

pub neg(x: F64) -> F64
  requires x.is_positive_zero()
  ensures result.is_negative_zero()
=
  -x

pub root() -> F64
  ensures result == 1.4142135623730951
=
  2.0.sqrt()

pub root_negative() -> F64
  ensures result.is_nan()
=
  (-1.0).sqrt()

pub magnitude(x: F64) -> F64
  requires x.is_negative_zero()
  ensures result.is_positive_zero()
=
  x.abs()

pub identity(a: F64, b: F64) -> Bool
  requires a.is_negative_zero() and b.is_positive_zero()
  ensures not result
=
  a == b

pub identity_nan() -> Bool
  ensures result
=
  nan() == nan()

pub different(a: F64, b: F64) -> Bool
  requires a.is_negative_zero() and b.is_positive_zero()
  ensures result
=
  a != b

pub total_zeros(a: F64, b: F64) -> Bool
  requires a.is_negative_zero() and b.is_positive_zero()
  ensures result
=
  a < b and b > a and a <= b and b >= a and not (b < a)

pub total_nan(x: F64) -> Bool
  requires not x.is_nan()
  ensures result
=
  x < nan() and nan() > x and nan() <= nan() and nan() >= nan() and not (nan() < nan())

pub total_infinity() -> Bool
  ensures result
=
  -infinity() < -1.0e308 and 1.0e308 < infinity() and infinity() < nan()

pub ieee_zeros(a: F64, b: F64) -> Bool
  requires a.is_negative_zero() and b.is_positive_zero()
  ensures result
=
  a.ieee_eq(other: b) and not a.ieee_ne(other: b) and not a.ieee_lt(other: b) and a.ieee_le(other: b) and a.ieee_ge(other: b) and not b.ieee_gt(other: a)

pub ieee_nan(x: F64) -> Bool
  ensures result
=
  let n = nan()
  not n.ieee_eq(other: x) and n.ieee_ne(other: x) and not n.ieee_lt(other: x) and not n.ieee_le(other: x) and not n.ieee_gt(other: x) and not n.ieee_ge(other: x)

pub classes() -> Bool
  ensures result
=
  let n = nan()
  let i = infinity()
  n.is_nan() and not n.is_finite() and not n.is_infinite() and not n.is_sign_negative() and i.is_infinite() and not i.is_finite() and (-i).is_sign_negative() and 5.0e-324.is_finite()

pub zeros(a: F64, b: F64) -> Bool
  requires a.is_negative_zero() and b.is_positive_zero()
  ensures result
=
  a.is_zero() and b.is_zero() and a.is_sign_negative() and not b.is_sign_negative() and not nan().is_zero() and not 5.0e-324.is_zero()

pub subnormal() -> F64
  ensures result == 5.0e-324
=
  1.0e-323 / 2.0

pub overflow() -> F64
  ensures result == infinity()
=
  1.7976931348623157e308 * 2.0

pub tie() -> F64
  ensures result == 9007199254740992.0
=
  9007199254740992.0 + 1.0

pub product(a: Unit01, b: Unit01) -> Unit01 = a * b

pub from_i8(n: I8) -> F64
  ensures result.ieee_ge(other: -128.0) and result <= 127.0
=
  n.to_f64()

pub from_u8(n: U8) -> F64
  ensures result.ieee_ge(other: 0.0) and result <= 255.0
=
  n.to_f64()

pub from_i16(n: I16) -> F64
  ensures result.ieee_ge(other: -32768.0) and result <= 32767.0
=
  n.to_f64()

pub from_u16(n: U16) -> F64
  ensures result.ieee_ge(other: 0.0) and result <= 65535.0
=
  n.to_f64()

pub from_i32(n: I32) -> F64
  ensures result.is_finite()
=
  n.to_f64()

pub from_i64(n: I64) -> F64
  requires n == 9223372036854775807
  ensures result == 9223372036854775808.0
=
  n.to_f64()

pub from_i64_min(n: I64) -> F64
  requires n == -9223372036854775808
  ensures result == -9223372036854775808.0
=
  n.to_f64()

pub from_u64(n: U64) -> F64
  requires n == 18446744073709551615
  ensures result == 18446744073709551616.0
=
  n.to_f64()

pub from_int(n: Int) -> F64
  requires n == 9007199254740993
  ensures result == 9007199254740992.0
=
  n.to_f64()

pub from_int_negative(n: Int) -> F64
  requires n == -9007199254740993
  ensures result == -9007199254740992.0
=
  n.to_f64()

pub from_int_range(n: Int) -> F64
  requires 0 <= n and n <= 100
  ensures result <= 100.0
=
  n.to_f64()
