-- test: a tensor index that may be out of range, an index list of another length than the rank, a reshape to another number of elements, a contraction over axes of lengths that may differ, a factorization of a matrix that may not be square, and a solve with a right-hand side of another size are each a refuted precondition, U5001
-- spec: spec/29 §17
-- expect: error U5001 at src/dense.una:14:3
-- expect: error U5001 at src/dense.una:19:3
-- expect: error U5001 at src/dense.una:24:3
-- expect: error U5001 at src/dense.una:29:3
-- expect: error U5001 at src/dense.una:31:53
-- expect: error U5001 at src/dense.una:33:60
module dense

pub outside(t: Tensor[F64]) -> F64
  requires t.rank == 2
=
  t.get(at: [0, 0])

pub ranked(t: Tensor[F64]) -> F64
  requires t.rank == 2 and t.dim(axis: 0) > 0 and t.dim(axis: 1) > 0
=
  t.get(at: [0])

pub resized() -> Tensor[F64]
=
  const g = tensor_filled(shape: [2, 3], value: 1.0)
  g.reshape(shape: [5])

pub mismatched(a: Tensor[F64], b: Tensor[F64]) -> Tensor[F64]
  requires a.rank == 2 and b.rank == 2
=
  a.contract(with: b, axis: 1, other: 0)

pub not_square(a: Matrix[F64]) -> Option[Lu[F64]] = a.lu()

pub unrelated(f: Lu[F64], b: Matrix[F64]) -> Matrix[F64] = f.solve(rhs: b)
