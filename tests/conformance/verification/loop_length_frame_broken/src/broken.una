-- test: the length frame of a loop holds only for updates that keep the length by contract: an append, a helper without the exact clause or with a weaker one, a rebind to a literal, a taken list, another list and a nested loop that appends break it, and a failure that hinges on the forgotten state is unknown (ADR 0071 D1, D3)
-- spec: spec/17 §5
-- expect: error U5002 at src/broken.una:18:5
-- expect: error U5002 at src/broken.una:27:5
-- expect: error U5002 at src/broken.una:39:5
-- expect: error U5002 at src/broken.una:47:5
-- expect: error U5002 at src/broken.una:56:5
-- expect: error U5001 at src/broken.una:63:5
-- expect: error U5002 at src/broken.una:71:5
-- expect: error U5002 at src/broken.una:75:11
module broken

--- An append breaks the frame.
pub appended(edit xs: List[Int]) -> Unit
=
  for i in 0..<xs.len
    xs = xs.append(item: i)
    set(edit xs, index: i, item: 0)

--- A helper that keeps the length without saying so.
quiet(edit ys: List[Int]) -> Unit = unit

pub unsaid(edit xs: List[Int]) -> Unit
=
  for i in 0..<xs.len
    quiet(edit xs)
    set(edit xs, index: i, item: 0)

--- A helper whose contract is weaker than equality.
grows(edit ys: List[Int]) -> Unit
  ensures ys.len >= old(ys).len
=
  ys = ys.append(item: 0)

pub weaker(edit xs: List[Int]) -> Unit
=
  for i in 0..<xs.len
    grows(edit xs)
    set(edit xs, index: i, item: 0)

--- A branch that rebinds to a literal.
pub reset(edit xs: List[Int], c: Bool) -> Unit
=
  for i in 0..<xs.len
    if c
      xs = []
    set(edit xs, index: i, item: 0)

--- A list taken and rebuilt.
rebuilt(take ys: List[Int]) -> List[Int] = ys

pub taken(edit xs: List[Int]) -> Unit
=
  for i in 0..<xs.len
    xs = rebuilt(take xs)
    set(edit xs, index: i, item: 0)

--- Another list.
pub other(edit xs: List[Int], ys: List[Int]) -> Unit
=
  for i in 0..<xs.len
    xs = ys
    set(edit xs, index: i, item: 0)

--- A nested loop that appends.
pub nested(edit xs: List[Int]) -> Unit
=
  for i in 0..<xs.len
    for j in 0..<1
      xs = xs.append(item: j)
    set(edit xs, index: i, item: 0)

--- After a loop that appends, the length is not the entry one.
pub after(edit xs: List[Int]) -> Unit
  ensures xs.len == old(xs).len
=
  for i in 0..<xs.len
    xs = xs.append(item: i)
