-- test: binders of one name in sibling blocks are distinct solver symbols (review control)
-- spec: spec/12 §4
-- expect: error U5001 at 15:5
module sibling_scope_lets

pub f(y: Int) -> Int
=
  let a = if true
    let t = abs(7)
    t
  else
    0
  let b = if true
    let t = y
    100 / t
  else
    0
  a + b
