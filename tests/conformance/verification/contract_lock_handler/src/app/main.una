-- test: a locked function that installs a handler from another module, whose operation runs a helper with inferred `uses`, is charged at the `with` against its own locked condition (ADR 0092 rules 3 and 8)
-- spec: spec/05 §3
-- expect: error U5001 at src/app/main.una:17:25
module app.main

import app.caps (Log, Store)
import app.handlers (forwarding)

save(n: Int) -> Unit
  uses @store: Store[put]
=
  @store.put(n)

pub run(n: Int, dry: Bool) -> Unit
  uses @log: Log[write where not dry]
=
  save(n) with @store = forwarding()
