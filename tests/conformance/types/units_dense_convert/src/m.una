-- test: `convert()` is not defined on a dense value, so it is U2030 (ADR 0120 rule 64)
-- spec: spec/25 §9, spec/29 §17
-- expect: error U2030 at src/m.una:10:62
module m

pub measure Meter

pub measure Kilometer = 1000 * Meter

pub bad(a: Array[F64 of Kilometer]) -> Array[F64 of Meter] = a.convert()
