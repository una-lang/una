-- test: a float literal other than zero as a pattern, in a `when` arm or with `is`, is U2032; a literal zero there is U2033
-- spec: spec/29 §5
-- expect: error U2032 at src/m.una:8:28
-- expect: error U2033 at src/m.una:10:28
-- expect: error U2032 at src/m.una:15:5
module m

pub half(x: F64) -> Bool = x is 0.5

pub zero(x: F64) -> Bool = x is 0.0

pub named(x: F64) -> Text
=
  when x
    is 1.5 -> "one and a half"
    else -> "other"
