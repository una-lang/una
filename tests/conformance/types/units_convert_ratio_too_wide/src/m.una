-- test: a `convert()` whose ratio does not fit the magnitude's integer type is U2030
-- spec: spec/25 §5
-- expect: error U2030 at src/m.una:18:49
module m

pub measure Meter

pub measure Second

pub measure Gram

pub measure Kilometer = 1000 * Meter

pub measure Hour = 3600000 * Millisecond

pub measure Millisecond

pub bad(h: I16 of Hour) -> I16 of Millisecond = h.convert()
