-- test: generic types given as many arguments as they have parameters are accepted (U2003 twin)
-- spec: spec/03 §2
-- expect: ok
module type_argument_counts

pub kind Pair[A, B]
  first: A
  second: B

pub kind Failure = | Broken

pub size(xs: List[Int]) -> Int = xs.len

pub first(pair: Pair[Int, Text]) -> Int = pair.first

pub pick(x: Option[Int], r: Result[Int, Failure]) -> Int
=
  when x
    is Some(value) -> value
    is None -> 0
