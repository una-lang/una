-- test: in edition 0.5, `add` and `remove` update a set written `edit s.add(...)`, as the whole expression of a statement, and each method of a set takes its number of labeled arguments (ADR 0119 rule 7)
-- spec: spec/28 §6
-- expect: error U2020 at src/wrong.una:13:3
-- expect: error U3013 at src/wrong.una:14:18
-- expect: error U2001 at src/wrong.una:15:13
module wrong

import std.collections (Set)

pub wrong(s: Set[Int]) -> Int
=
  var t = s
  t.add(item: 1)
  const units = [edit t.add(item: 3)]
  const b = t.between(low: 1)
  t.len
