-- test: in edition 0.4, `add` and `remove` update a set written `edit s.add(...)`, as the whole expression of a statement, and each method of a set takes its number of labeled arguments (ADR 0119 rule 7)
-- spec: spec/28 §6
-- expect: error U2020 at src/wrong.una:13:3
-- expect: error U3013 at src/wrong.una:14:16
-- expect: error U2001 at src/wrong.una:15:11
module wrong

import std.collections (Set)

pub wrong(s: Set[Int]) -> Int
=
  let edit t = s
  t.add(item: 1)
  let units = [edit t.add(item: 3)]
  let b = t.between(low: 1)
  t.len
