-- test: converting cents to dollars divides the coefficient by 100, which a decimal would round, so it is U2030 (ADR 0120 rule 63)
-- spec: spec/25 §9
-- expect: error U2030 at src/m.una:10:55
module m

pub measure Usd

pub measure Cent = Usd / 100

pub bad(c: Decimal[2] of Cent) -> Decimal[2] of Usd = c.convert()
