-- test: a map's methods take labeled arguments after the receiver, set and remove are written edit m.set(...) on an editable binding, and the others read it (spec/21 §2)
-- spec: spec/21 §2
-- expect: error U2020 at src/methods.una:39:3
-- expect: error U2004 at src/methods.una:40:17
-- expect: error U2001 at src/methods.una:41:11
-- expect: error U2001 at src/methods.una:42:19
-- expect: error U2001 at src/methods.una:42:29
-- expect: error U2019 at src/methods.una:43:8
module methods

pub counts(words: List[Text]) -> Map[Text, Int]
=
  let edit counts: Map[Text, Int] = empty_map()
  for word in words
    let n = counts.get(key: word)
      if none use 0
    edit counts.set(key: word, value: n + 1)
  counts

pub sizes(m: Map[Text, Int]) -> List[Int]
=
  let ks = m.keys()
  let vs = m.values()
  let es = m.entries()
  [ks.len, vs.len, es.len, m.len]

pub first_key(m: Map[Text, Int]) -> Text
=
  let es = m.entries()
  let first = es.first_where(keep: fn(e) -> e.value > 0)
    if none use Entry(key: "", value: 0)
  first.key

pub both(m: Map[Text, Int]) -> Bool = m.has(key: "a") and m.without(key: "a").has(key: "b")

pub wrong(m: Map[Text, Int]) -> Unit
=
  let edit n = m
  n.set(key: "a", value: 1)
  edit n.remove("a")
  let k = n.keys(1)
  edit n.set(key: 1, value: "x")
  edit m.remove(key: "a")
  unit
