-- test: an integer operand before an F64 operand is U2001 with a repair that converts it; a zero integer where an F64 is expected is U2001; a range arm over an F64 is U2032; `5.e2()` stays a method call in edition 0.3
-- spec: spec/29 §1, §2, §5
-- expect: error U2001 at src/m.una:9:38
-- expect: error U2001 at src/m.una:9:42
-- expect: error U2001 at src/m.una:11:21
-- expect: error U2032 at src/m.una:16:5
module m

pub sum(n: Int, value: F64) -> F64 = n + value

pub zero() -> F64 = 0 + 1.0

pub ranged(x: F64) -> Text
=
  when x
    in 0..1 -> "unit"
    else -> "other"

e2(n: Int) -> Int = n * 100

pub hundred() -> Int = 5.e2()
