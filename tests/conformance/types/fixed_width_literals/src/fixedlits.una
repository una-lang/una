-- test: an integer literal takes the fixed-width type its context expects, and one that does not fit is U2022 (spec/18 §2)
-- spec: spec/18 §2
-- expect: error U2022 at src/fixedlits.una:9:21
-- expect: error U2022 at src/fixedlits.una:11:21
-- expect: error U2022 at src/fixedlits.una:13:21
-- expect: error U2022 at src/fixedlits.una:15:28
module fixedlits

pub port() -> U16 = 70000

pub below() -> I8 = -129

pub minus() -> U8 = -1

pub sum(a: U8) -> U8 = a + 256

pub least() -> I8 = -128

pub greatest() -> U64 = 18446744073709551615

pub other(a: U8) -> Bool = 255 == a
