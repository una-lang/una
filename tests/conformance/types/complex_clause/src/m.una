-- test: the arithmetic of `Complex[F64]` and `Complex[F32]` and their methods are code only, U2014 in a clause, while their fields, `complex(re:, im:)` and `==` are in the refinement language
-- spec: spec/29 §19
-- expect: error U2014 at src/m.una:11:21
-- expect: error U2014 at src/m.una:16:21
-- expect: error U2014 at src/m.una:21:21
-- expect: error U2014 at src/m.una:26:21
-- expect: error U2014 at src/m.una:31:21
module m

pub product(x: Complex[F64], y: Complex[F64]) -> Complex[F64]
  ensures result == x * y
=
  x * y

pub quotient(x: Complex[F32], y: Complex[F32]) -> Complex[F32]
  ensures result == x / y
=
  x / y

pub conjugate(x: Complex[F64]) -> Complex[F64]
  ensures result == x.conj()
=
  x.conj()

pub negated(x: Complex[F64]) -> Complex[F64]
  ensures result == -x
=
  -x

pub norm(x: Complex[F64]) -> F64
  ensures result == x.norm_sqr()
=
  x.norm_sqr()
