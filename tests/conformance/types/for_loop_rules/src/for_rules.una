-- expect: error U3013 at src/for_rules.una:71:12
-- expect: error U2017 at src/for_rules.una:89:3
module for_rules

eat(take xs: List[Int]) -> Int = xs.len

pub var_assigned(xs: List[Int]) -> Unit
=
  for x in xs
    x = 1
  unit

pub not_a_list(n: Int) -> Unit
=
  for x in n
    unit
  unit

pub not_integers(t: Text) -> Unit
=
  for i in 0..<t
    unit
  unit

pub taken_each_time(xs: List[Int]) -> Int
=
  let items = [1, 2]
  let edit total = 0
  for x in xs
    let n = eat(take items)
    total = total + n
  total

pub retaken(xs: List[Int]) -> Int
=
  let edit items = [1, 2]
  let edit total = 0
  for x in xs
    let n = eat(take items)
    items = [n]
    total = total + n
  total

pub inner_value(xs: List[Int]) -> Unit
=
  for x in xs
    x + 1
  unit

pub last_line(xs: List[Int]) -> Unit
=
  let edit total = 0
  for x in xs
    total = total + x

grab(edit xs: List[Int]) -> List[Int]
=
  xs = xs.append(item: 0)
  xs

pub marked_source() -> Int
=
  let edit xs = [1]
  for x in grab(edit xs)
    unit
  xs.len

pub marked_in_body(ys: List[Int]) -> Int
=
  let edit xs = [1]
  for y in ys
    let grown = grab(edit xs)
    unit
  xs.len

pub revived_in_body(ys: List[Int]) -> Int
=
  let edit items = [1]
  let n = eat(take items)
  for y in ys
    items = [y]
  items.len + n
