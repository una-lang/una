-- test: a wrapping method of a measured fixed-width value is outside the refinement language in a capability operation's `requires` clause: U2014
-- spec: spec/03 §3
-- expect: error U2014 at src/m.una:10:14
module m

pub measure Meter

pub capability Pump
  op push(a: I32 of Meter) -> I32 of Meter
    requires a.wrapping_add(by: a) > a
    ensures result == a

handler fake() for Pump
  op push(a) = a

pub run(a: I32 of Meter) -> I32 of Meter
  uses @pump: Pump[push]
=
  @pump.push(a)
