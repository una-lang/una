-- test: a reflect predicate that calls another predicate and an opaque predicate that cannot fail are accepted (U2015 twin)
-- spec: spec/03 §4
-- expect: ok
module predicate_bodies

predicate reflect positive(n: Int) -> Bool = n > 0

predicate reflect small_positive(n: Int) -> Bool = positive(n) and n < 10

predicate opaque tidy(t: Text) -> Bool = t.len < 80

pub kind Small = Int where small_positive(it)

pub kind Tidy = Text where tidy(it)

pub three() -> Small = 3
