-- test: a started task captures the bindings before it and cannot change them, so passing one as `edit` is U2023, as in a `together` branch (spec/27 §7, spec/19 §2, ADR 0117 rule 7)
-- spec: spec/27 §7
-- expect: error U2023 at src/capture.una:14:21
module capture

bump(edit n: Int) -> Unit
=
  n = n + 1

pub run(start_at: Int) -> Int
=
  let edit total = start_at
  tasks
    start bump(edit total)
  total
