-- test: a where clause on a kind whose base is a function type is U2002 at the clause, once for the kind and its alias; range sugar binds to the result (ADR 0045)
-- spec: spec/03 §3
-- expect: error U2002 at 14:35
-- expect: error U2002 at 16:30
-- expect: error U2002 at 18:48
module refined_function_kind

pub kind Pos = Int where it > 0

pub predicate opaque good(f: fn(Int) -> Int) -> Bool = true

pub kind Unary = fn(Int) -> Int

pub kind F = fn(Int) -> Int where good(it)

pub kind Named = Unary where good(it)

pub kind Guarded = secret fn(Int) -> Int where good(it)

pub kind G = F

pub kind Banded = fn(Int) -> Int in 0..5

pub kind Positive = fn(Int) -> Pos

pub g(f: F) -> Int = f(1)

pub h(x: fn(Int) -> Int) -> Int = g(x)

pub k(f: G) -> Int = f(1)
