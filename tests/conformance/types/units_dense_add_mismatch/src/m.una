-- test: the elements of two arrays added element-wise need one unit, so meters plus seconds is U2028 at the second operand (ADR 0120 rule 64)
-- spec: spec/25 §9, spec/29 §17
-- expect: error U2028 at src/m.una:13:7
module m

pub measure Meter

pub measure Second

pub bad(a: Array[F64 of Meter], b: Array[F64 of Second]) -> Array[F64 of Meter]
  requires a.len == b.len
=
  a + b
