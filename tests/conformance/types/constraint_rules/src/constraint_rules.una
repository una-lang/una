-- test: an operator on a type parameter needs its constraint (U2026), `==` included, in public headers and in private ones that write a constraint; a private function without one infers it, and its callers must satisfy it (U2025), through nested generic calls and function values; records, lists and functions satisfy what they are (spec/20 §1, §3)
-- spec: spec/20 §1, §3
-- expect: error U2026 at src/constraint_rules.una:19:35
-- expect: error U2026 at src/constraint_rules.una:21:39
-- expect: error U2026 at src/constraint_rules.una:23:35
-- expect: error U2026 at src/constraint_rules.una:25:38
-- expect: error U2025 at src/constraint_rules.una:33:46
-- expect: error U2025 at src/constraint_rules.una:37:55
-- expect: error U2025 at src/constraint_rules.una:43:15
-- expect: error U2025 at src/constraint_rules.una:44:13
-- expect: error U2025 at src/constraint_rules.una:45:41
module constraint_rules

pub kind Box
  size: Int

pub kind Color = Red | Green

pub same[T](a: T, b: T) -> Bool = a == b

pub less[T: Eq](a: T, b: T) -> Bool = a < b

pub as_int[T: Ord](x: T) -> Int = x.to_int()

written[T: Eq](a: T, b: T) -> Bool = a < b

inferred_eq[T](a: T, b: T) -> Bool = a == b

inferred_ord[T](a: T, b: T) -> Bool = a < b

nested[T](a: T, b: T) -> Bool = inferred_ord(a, b: b)

pub through_private[T](a: T, b: T) -> Bool = nested(a, b: b)

pub through_ok[T: Ord](a: T, b: T) -> Bool = nested(a, b: b)

pub eq_on_list[T](xs: List[T], ys: List[T]) -> Bool = inferred_eq(xs, b: ys)

pub uses_concrete(b: Box, c: Color, f: fn(Int) -> Int) -> Bool
=
  let records = inferred_eq(b, b: b)
  let sums = inferred_ord(c, b: Green)
  let boxes = inferred_ord(b, b: b)
  let fns = inferred_eq(f, b: f)
  let as_value = [b].map(each: fn(x) -> inferred_ord(x, b: x))
  records and sums and boxes and fns
