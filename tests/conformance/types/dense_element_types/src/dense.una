module dense

pub texts(m: Matrix[Text]) -> Int = 0

pub ints(m: Matrix[Int]) -> Int = 0

pub any[T](m: Matrix[T]) -> Int = 0

pub filled() -> Int = matrix_filled(rows: 1, columns: 1, value: "a").rows

pub mapped(m: Matrix[F64]) -> Int = m.map(each: fn(x) -> x.is_nan()).rows
