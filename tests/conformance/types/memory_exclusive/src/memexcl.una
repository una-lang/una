-- test: an `edit` argument excludes any other use of its root binding in the same call, even of a disjoint field (spec/17 §3 rule 4)
-- spec: spec/17 §3
-- expect: error U2018 at src/memexcl.una:34:20
-- expect: error U2018 at src/memexcl.una:39:23
-- expect: error U2018 at src/memexcl.una:44:24
-- expect: error U2018 at src/memexcl.una:49:24
module memexcl

pub kind Point
  x: Int
  y: Int

move(edit p: Point, by: Int) -> Unit
=
  p.x = p.x + by

shift(edit a: Int, by: Int) -> Unit
=
  a = a + by

swap(edit a: Int, edit b: Int) -> Unit
=
  let t = a
  a = b
  b = t

keep(edit a: Point, take b: Point) -> Unit
=
  a = b

pub reads_itself() -> Unit
=
  let edit p = Point(x: 1, y: 2)
  move(edit p, by: p.y)

pub disjoint_fields() -> Unit
=
  let edit p = Point(x: 1, y: 2)
  shift(edit p.x, by: p.y)

pub twice() -> Unit
=
  let edit n = 1
  swap(edit n, b: edit n)

pub edit_and_take() -> Unit
=
  let edit p = Point(x: 1, y: 2)
  keep(edit p, b: take p)

pub distinct() -> Unit
=
  let edit n = 1
  let edit m = 2
  let d = 3
  swap(edit n, b: edit m)
  shift(edit n, by: d)
