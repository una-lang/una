-- test: calls that write `edit` or `take` where the parameter declares it, on distinct bindings, and a function with such a parameter that is only called, are accepted; otherwise U2018, U2020 and U2021 (positive twin, #11)
-- spec: spec/17 §3
-- expect: ok
module memok

pub kind Tally
  count: Int

add(edit t: Tally, by: Int) -> Unit
=
  t.count = t.count + by

swap(edit a: Int, edit b: Int) -> Unit
=
  let t = a
  a = b
  b = t

eat(take xs: List[Int]) -> Int = xs.len

pub counted() -> Int
=
  let edit t = Tally(count: 0)
  add(edit t, by: 2)
  t.count

pub swapped() -> Int
=
  let edit a = 1
  let edit b = 2
  swap(edit a, edit b)
  a - b

pub eaten() -> Int
=
  let xs = [1, 2, 3]
  eat(take xs)
