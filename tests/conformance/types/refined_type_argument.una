-- test: a refined kind, or a type that contains one, written as a type argument is ill-formed in v0.1 (R-012)
-- spec: spec/03 §3
-- expect: error U2002 at 24:25
-- expect: error U2002 at 26:23
-- expect: error U2002 at 28:25
-- expect: error U2002 at 30:22
-- expect: error U2002 at 32:30
-- expect: error U2002 at 34:23
-- expect: error U2002 at 37:15
-- expect: error U2002 at 39:20
-- expect: error U2002 at 41:18
module refined_type_argument

pub kind Pos = Int where it > 0

pub kind Box[T]
  value: T

kind Failure = | Bad

pub kind Held
  value: Pos

pub a(x: Pos) -> Option[Pos] = Some(x)

pub b(x: Pos) -> List[Pos] = [x]

pub c(x: Pos) -> Result[Pos, Failure] = Ok(x)

pub d(x: Pos) -> Box[Pos] = Box(value: x)

pub e(x: Int) -> Option[List[Pos]] = None

pub f(x: Int) -> List[Int in 0..5] = []

pub kind Many
  items: List[Pos]

pub kind Ps = List[Pos]

pub g(h: fn(List[Pos]) -> Int) -> Int = 0

pub fine(h: fn(Pos) -> Int, p: Pos, xs: List[secret Int]) -> Int = h(p)
