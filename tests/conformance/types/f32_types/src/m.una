-- test: F32 is distinct from F64 and from the integer types: an integer literal where an F32 is expected, an F64 or an integer operand of an F32 operator, an F32 operand of an F64 operator, a comparison of an F32 with an F64, `mod` and `to_int()` on an F32 are U2001
-- spec: spec/29 §18
-- expect: error U2001 at src/m.una:14:20
-- expect: error U2001 at src/m.una:16:25
-- expect: error U2001 at src/m.una:18:40
-- expect: error U2001 at src/m.una:20:45
-- expect: error U2001 at src/m.una:22:42
-- expect: error U2001 at src/m.una:24:39
-- expect: error U2001 at src/m.una:26:37
-- expect: error U2001 at src/m.una:28:37
-- expect: error U2001 at src/m.una:30:31
module m

pub one() -> F32 = 1

pub negative() -> F32 = -2

pub mixed(x: F32, y: F64) -> F32 = x + y

pub mixed_back(x: F32, y: F64) -> F64 = y * x

pub integer(x: F32, n: Int) -> F32 = x - n

pub ordered(x: F32, y: F64) -> Bool = x < y

pub equal(x: F32, y: F64) -> Bool = x == y

pub modulo(x: F32, y: F32) -> F32 = x mod y

pub truncate(x: F32) -> Int = x.to_int()
