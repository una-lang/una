-- test: a method of the fixed-width types is no method of `Int of Meter`, as of `Int`: U2001
-- spec: spec/25 §4
-- expect: error U2001 at src/m.una:14:61
module m

pub measure Meter

pub measure Second

pub measure Gram

pub measure Kilometer = 1000 * Meter

pub bad(a: Int of Meter, b: Int of Meter) -> Int of Meter = a.wrapping_add(by: b)
