-- test: an unlabeled first argument binds the first parameter, and punning applies from the second argument on (ADR 0049, UI-009)
-- spec: spec/04 §3
-- expect: error U2006 at 9:47
module first_argument_binds_first_parameter

pub minus(a: Int, b: Int) -> Int = a - b

--- `b` binds `a`, so the punned `a` gives `a` a second time.
pub swapped(a: Int, b: Int) -> Int = minus(b, a)

--- Labels say what is meant.
pub swapped_labeled(a: Int, b: Int) -> Int = minus(a: b, b: a)

--- Rule 3's example: `key` is the first parameter, and `decision` is punned.
pub record(key: Int, decision: Bool) -> Int = if decision then key else 0

pub caller(key: Int, decision: Bool) -> Int = record(key, decision)

--- An unlabeled first argument of any name binds the first parameter.
pub other_name(x: Int, y: Int) -> Int = minus(x, b: y)

example "minus with labels swapped"
  do swapped_labeled(10, b: 3)
  expect result == -7
