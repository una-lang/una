-- test: labels flow through every operation of F64: a comparison, `to_f64()`, `to_int_exact()`, `to_bits()`, and the prelude functions `parse_f64`, its failure, `f64_from_bits`, `as_f64` and `json_number` each carry their argument's label, so each secret result written to the console is U4003
-- spec: spec/29 §11
-- expect: error U4003 at src/m.una:17:18
-- expect: error U4003 at src/m.una:23:18
-- expect: error U4003 at src/m.una:25:18
-- expect: error U4003 at src/m.una:27:18
-- expect: error U4003 at src/m.una:33:18
-- expect: error U4003 at src/m.una:35:18
-- expect: error U4003 at src/m.una:37:18
-- expect: error U4003 at src/m.una:39:18
module m

pub compare(x: secret F64, y: F64) -> Unit
  uses @console: Console[print]
=
  let less = x < y
  @console.print("less {less}")

pub convert(n: secret Int, x: secret F64) -> Unit
  uses @console: Console[print]
=
  let f = n.to_f64()
  @console.print("converted {f}")
  let e = x.to_int_exact()
  @console.print("exact {e}")
  let b = x.to_bits()
  @console.print("bits {b}")

pub prelude(t: secret Text, k: secret U64, j: secret Json, x: secret F64) -> Unit
  uses @console: Console[print]
=
  let r = attempt parse_f64(t)
  @console.print("parsed {r}")
  let v = f64_from_bits(bits: k)
  @console.print("from bits {v}")
  let a = as_f64(j)
  @console.print("as float {a}")
  let n = json_number(x)
  @console.print("as json {n}")
