-- test: kinds, generics, labeled calls, methods, when, handling clauses, attempt, lambdas and interpolation type-check
-- spec: spec/10 §3, §4
-- expect: tier0-ok
module types_tour

pub kind Seats = Int in 0..5000

pub kind Level = Low | Mid | High

pub kind Shape = Circle(radius: Int) | Rect(width: Int, height: Int) | Dot

pub kind Venue
  name: Text
  seats: Seats
  levels: List[Level]

pub kind Pair[A, B]
  first: A
  second: B

pub kind StoreError = Timeout | Corrupted

pub kind LookupError = Missing | Unavailable(reason: Text)

pub capability Store
  op find(key: Int) -> Option[Venue]
    fails StoreError
    accepts internal

predicate reflect large(v: Venue) -> Bool = v.seats > 1000

pub area(shape: Shape) -> Int
=
  when shape
    is Circle(radius) -> 3 * radius * radius
    is Rect(width, height: h) -> width * h
    is Dot -> 0

pub band(n: Int) -> Level
=
  when n
    in 0..<10 -> Low
    in 10..<100 -> Mid
    else -> High

pub swap[A, B](p: Pair[A, B]) -> Pair[B, A] = Pair(first: p.second, second: p.first)

pub describe(v: Venue) -> Text = "{v.name} seats {v.seats}, large: {v.large()}"

pub total(xs: List[Int]) -> Int = xs.map(each: fn(x) -> x * 2).fold(initial: 0, step: fn(acc, x) -> acc + x)

pub rank(level: Level) -> Int = if level < High then 0 else 1

pub lookup(key: Int) -> Venue
  uses @store: Store[find]
  fails LookupError
=
  let venue = @store.find(key)
    if error fail Unavailable(reason: "store")
    if none fail Missing
  venue

pub probe(key: Int) -> Bool
  uses @store: Store[find]
=
  let outcome = attempt @store.find(key)
  when outcome
    is Ok(found) -> found.is_some()
    is Err(failure) -> failure == Timeout

pub fallback(key: Int) -> Int
  uses @store: Store[find]
=
  let venue = @store.find(key)
    if error use None
    if none use Venue(name: "none", seats: 0, levels: [])
  venue.seats

handler venues(v: Venue) for Store
  op find(key) = Some(v)

example "a venue is found"
  given @store = venues(Venue(name: "Hall", seats: 10, levels: [Low]))
  do lookup(1)
  expect result.seats == 10
