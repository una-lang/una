-- test: a clause comparing meters with seconds is U2028
-- spec: spec/25 §6
-- expect: error U2028 at src/m.una:15:12
module m

pub measure Meter

pub measure Second

pub measure Gram

pub measure Kilometer = 1000 * Meter

pub bad(d: Int of Meter, t: Int of Second) -> Int of Meter
  requires d > t
=
  d
