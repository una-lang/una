-- test: in edition 0.5, `set`, `remove` and `add` update a hash table written `edit m.set(...)`, as the whole expression of a statement, each method takes its number of labeled arguments, and `same_entries` needs values that satisfy `Eq` (ADR 0119 rules 11 and 12)
-- spec: spec/28 §7
-- expect: error U2020 at src/wrong.una:15:3
-- expect: error U3013 at src/wrong.una:16:18
-- expect: error U2001 at src/wrong.una:17:13
-- expect: error U2020 at src/wrong.una:22:3
-- expect: error U2025 at src/wrong.una:28:32
module wrong

import std.collections (HashMap, HashSet)

pub maps(m: HashMap[Text, Int]) -> Int
=
  var t = m
  t.set(key: "a", value: 1)
  const units = [edit t.remove(key: "a")]
  const g = t.get(key: "a", value: 2)
  t.len

pub sets(s: HashSet[Int]) -> Int
=
  s.add(item: 1)
  s.len

--- The values of a map of sets have no `==`.
pub nested(a: HashMap[Text, HashSet[Int]],
  b: HashMap[Text, HashSet[Int]]
) -> Bool = a.same_entries(as: b)
