-- test: in clauses every integer type reads as its mathematical Int: types mix, and literals are Int, so no U2022 (spec/18 §2)
-- spec: spec/18 §2
-- expect: tier0-ok
module fixedclause

pub kind Small = U8 where it < 300 and it + 1 > 0

pub same(a: U8, b: U16) -> U8
  requires a + b < 1000
  ensures result <= 300 and result == a
=
  a
