-- test: a wrapping method of a measured fixed-width value is outside the refinement language in a kind's `where` clause: U2014 at the alias
-- spec: spec/03 §3
-- expect: error U2014 at src/m.una:8:35
module m

pub measure Meter

pub kind Odd = I32 of Meter where it.wrapping_add(by: it) > it

pub g(x: Odd) -> Int
  ensures result == 1
=
  0
