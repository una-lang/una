-- test: a lambda parameter takes its type from an annotation or from the expected function type (U2010 twin)
-- spec: spec/03 §7
-- expect: ok
module lambda_parameter_types

pub one() -> Int
=
  let f = fn(x: Int) -> x + 1
  f(0)

pub doubled(xs: List[Int]) -> List[Int] = xs.map(each: fn(x) -> x * 2)

pub apply(g: fn(Int) -> Int) -> Int = g(1)

pub two() -> Int = apply(g: fn(x) -> x + 1)
