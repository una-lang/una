-- test: result in an ensures clause and error in the fail part of an if error clause are accepted; elsewhere they are U2012 and U2013 (positive twin, #11)
-- spec: spec/02 §8
-- expect: ok
module result_and_error_ok

pub kind Broken = | Broke

pub kind Outer = | Wrapped(inner: Broken)

pub positive(x: Int) -> Int
  requires x > 0
  ensures result > 0
=
  x

pub risky(x: Int) -> Int
  fails Broken
=
  if x > 5 then fail Broke else x

pub relay(x: Int) -> Int
  fails Outer
=
  let v = risky(x)
    if error fail Wrapped(inner: error)
  v
