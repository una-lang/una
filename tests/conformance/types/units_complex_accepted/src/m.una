-- test: Complex[F64] and Complex[F32] take units in edition 0.4 (ADR 0120 rule 64): one unit for both components, which `complex(re:, im:)` takes from its arguments or the expected type, `+` and `-` in one unit, `*` and `/` multiplying and dividing, `conj` keeping, `scale(by:)` multiplying by the scalar's unit, `norm_sqr()` squaring, `re` and `im` with the unit, `==`, `measured()` and `magnitude()`, all accepted
-- spec: spec/25 §9
-- expect: ok
module m

pub measure Volt

pub measure Ampere

pub measure Ohm = Volt / Ampere

pub make(re: F64 of Volt, im: F64 of Volt) -> Complex[F64] of Volt = complex(re, im)

pub literal() -> Complex[F64] of Volt = complex(re: 1.0, im: -2.0)

pub sum(a: Complex[F64] of Volt, b: Complex[F64] of Volt) -> Complex[F64] of Volt = a + b - -a

pub impedance(v: Complex[F64] of Volt, i: Complex[F64] of Ampere) -> Complex[F64] of Ohm = v / i

pub power(v: Complex[F64] of Volt, i: Complex[F64] of Ampere) -> Complex[F64] of Volt * Ampere = v * i.conj()

pub scaled(i: Complex[F32] of Ampere, r: F32 of Ohm) -> Complex[F32] of Volt = i.scale(by: r)

pub squared(v: Complex[F64] of Volt) -> F64 of Volt * Volt = v.norm_sqr()

pub parts(v: Complex[F64] of Volt) -> F64 of Volt = v.re + v.im

pub same(a: Complex[F64] of Volt, b: Complex[F64] of Volt) -> Bool = a == b

pub tagged(z: Complex[F64]) -> Complex[F64] of Volt = z.measured()

pub raw(z: Complex[F64] of Volt) -> Complex[F64] = z.magnitude()
