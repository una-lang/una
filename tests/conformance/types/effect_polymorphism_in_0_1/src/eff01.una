-- test: edition 0.1 keeps the pure prelude: a lambda that uses a capability, passed to `map`, is U3004 (spec/14 §1, ADR 0062)
-- spec: spec/14 §1
-- expect: error U3004 at src/eff01.una:12:39
module eff01

pub capability Log
  op write(line: Text) -> Unit

pub logged(names: List[Text]) -> Int
  uses @log: Log[write]
=
  let done = names.map(each: fn(n) -> @log.write(n))
  done.len
