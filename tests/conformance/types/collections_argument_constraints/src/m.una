-- test: a `Set`'s item and a `PriorityQueue`'s priority must satisfy `Ord`, and a `HashMap`'s key and a `HashSet`'s item `Eq`, where the type is written: a record or a hash set fails, a public generic function writes the constraint, and a private one infers it (ADR 0119 rules 7, 8 and 13)
-- spec: spec/28 §3
-- expect: error U2025 at src/m.una:16:16
-- expect: error U2025 at src/m.una:18:15
-- expect: error U2025 at src/m.una:20:15
-- expect: error U2025 at src/m.una:22:14
-- expect: error U2025 at src/m.una:24:19
module m

import std.collections (HashMap, HashSet, PriorityQueue, Set)

pub kind Point
  x: Int
  y: Int

pub ordered(s: Set[Point]) -> Unit = unit

pub ranked(q: PriorityQueue[Text, Point]) -> Unit = unit

pub nested(h: HashSet[HashSet[Int]]) -> Unit = unit

pub keyed(m: HashMap[HashMap[Text, Int], Int]) -> Unit = unit

pub generic[T](s: Set[T]) -> Unit = unit

pub generic_ord[T: Ord](s: Set[T]) -> Unit = unit

pub generic_eq[T: Eq](s: HashSet[T]) -> Unit = unit

inferred[T](s: HashSet[T]) -> Unit = unit
