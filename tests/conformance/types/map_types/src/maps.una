-- test: a map's key type must satisfy Ord where the type is written: Int, fixed-width, Text and payload-less sums do, others are U2025; a public generic function writes T: Ord, a private one infers it, and a kind's parameter cannot be a key (spec/21 §1 rule 2, N-15)
-- spec: spec/21 §1
-- expect: error U2025 at src/maps.una:24:16
-- expect: error U2025 at src/maps.una:26:16
-- expect: error U2025 at src/maps.una:28:17
-- expect: error U2025 at src/maps.una:31:17
-- expect: error U2025 at src/maps.una:40:12
module maps

pub kind Color = Red | Green

pub kind Point
  x: Int
  y: Int

--- Keys that satisfy `Ord`.
pub by_text() -> Map[Text, Int] = empty_map()

pub by_fixed() -> Map[I8, Bool] = empty_map()

pub by_color() -> Map[Color, List[Int]] = empty_map()

--- Keys that do not.
pub by_bool(m: Map[Bool, Int]) -> Int = m.len

pub by_list(m: Map[List[Int], Int]) -> Int = m.len

pub by_point(m: Map[Point, Int]) -> Int = m.len

--- A public generic function names its key's constraint.
pub sized[T](m: Map[T, Int]) -> Int = m.len

pub sized_ord[T: Ord](m: Map[T, Int]) -> Int = m.len

--- A private one infers it.
counted[T](m: Map[T, Int]) -> Int = m.len

--- A kind's parameter cannot be constrained.
pub kind Index[T]
  entries: Map[T, Int]

pub kind Fixed
  entries: Map[Text, Int]

--- The type of `empty_map()` comes from its context.
pub sizes() -> Int
=
  let m: Map[Text, Int] = empty_map()
  m.len
