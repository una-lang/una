-- test: the repair of U2009 at a compared variant applied: `e is V` and `not (e is V)` test a variant with fields (spec/10 §12 rule 6, #205)
-- spec: spec/10 §12
-- expect: ok
module variant_compared_with_is

pub kind Problem = Overdrawn(index: Int) | Closed

pub overdrawn(e: Problem) -> Bool = e is Overdrawn

pub other(e: Problem) -> Bool = not (e is Overdrawn)
