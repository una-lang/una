-- test: expect fails names a variant of the error kind of the do expression (R-020)
-- spec: spec/10 §12
-- expect: ok
-- expect: test-pass
module expect_fails_in_do_kind

kind E = A | B

kind Other = | Z

pub f(x: Int) -> Int
  fails E
=
  if x > 0 then fail A else fail B

pub g(x: Int) -> Other = Z

example "the do expression fails with a variant of its kind"
  do f(0)
  expect fails B
