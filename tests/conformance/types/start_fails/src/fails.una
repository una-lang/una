-- test: a started task must not fail after its handling clauses: a call that can fail without a clause, `if error pass` and `if error fail` are U3029, and `if error use` handles the failure (spec/27 §7, ADR 0117 rule 7)
-- spec: spec/27 §7
-- expect: error U3029 at src/fails.una:19:11
-- expect: error U3029 at src/fails.una:21:7
-- expect: error U3029 at src/fails.una:23:21
module fails

pub kind JobError = Broken

run_job(n: Int) -> Unit
  fails JobError
=
  if n < 0 then fail Broken else unit

pub run(n: Int) -> Unit
  fails JobError
=
  tasks
    start run_job(n)
    start run_job(n + 1)
      if error pass
    start run_job(n + 2)
      if error fail Broken
    start run_job(n + 3)
      if error use unit
