-- test: an F64 carries labels as an Int does: the result of an operator, a method and a conversion joins its operands' labels, so a secret float written to the console is U4003
-- spec: spec/29 §11
-- expect: error U4003 at src/m.una:10:18
module m

pub show(x: secret F64, y: F64) -> Unit
  uses @console: Console[print]
=
  let z = (x * y).sqrt().floor()
  @console.print("{z}")
