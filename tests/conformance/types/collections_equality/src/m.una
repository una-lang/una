-- test: `HashMap`, `HashSet` and `PriorityQueue` have no `==`, nor has a record that holds one, each U2001 with a message that names what compares instead; `Stack`, `Queue`, `Set` and `BitSet` compare with `==` (ADR 0119 rules 2 and 11)
-- spec: spec/28 §3
-- expect: error U2001 at src/m.una:14:66
-- expect: error U2001 at src/m.una:16:54
-- expect: error U2001 at src/m.una:18:80
-- expect: error U2001 at src/m.una:20:36
module m

import std.collections (BitSet, HashMap, HashSet, PriorityQueue, Queue, Set, Stack)

pub kind Bag
  items: HashSet[Int]

pub maps(a: HashMap[Text, Int], b: HashMap[Text, Int]) -> Bool = a == b

pub sets(a: HashSet[Int], b: HashSet[Int]) -> Bool = a != b

pub queues(a: PriorityQueue[Text, Int], b: PriorityQueue[Text, Int]) -> Bool = a == b

pub bags(a: Bag, b: Bag) -> Bool = a == b

pub stacks(a: Stack[Int], b: Stack[Int]) -> Bool = a == b

pub fifos(a: Queue[Text], b: Queue[Text]) -> Bool = a == b

pub ordered(a: Set[Int], b: Set[Int]) -> Bool = a == b

pub bits(a: BitSet, b: BitSet) -> Bool = a == b
