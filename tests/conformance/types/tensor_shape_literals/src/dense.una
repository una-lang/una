-- test: a tensor's shape, index and permutation are list literals of 1 to 8 elements, a permutation of integer literals, and an axis an integer literal below 8, so the checker gives each call the contract of its rank; anything else is U2038, and so is `tensor_filled` as a function value
-- spec: spec/29 §17
-- expect: error U2038 at src/dense.una:12:49
-- expect: error U2038 at src/dense.una:14:29
-- expect: error U2038 at src/dense.una:16:62
-- expect: error U2038 at src/dense.una:18:44
-- expect: error U2038 at src/dense.una:20:55
-- expect: error U2038 at src/dense.una:22:57
-- expect: error U2038 at src/dense.una:24:54
module dense

pub computed(shape: List[Int]) -> Tensor[F64] = tensor_filled(shape: shape, value: 0.0)

pub deep() -> Tensor[F64] = tensor_filled(shape: [1, 1, 1, 1, 1, 1, 1, 1, 1], value: 0.0)

pub index(t: Tensor[F64], place: List[Int]) -> Option[F64] = t.at(at: place)

pub twice(t: Tensor[F64]) -> Tensor[F64] = t.permute(axes: [0, 0])

pub axis(t: Tensor[F64], k: Int) -> Int = t.dim(axis: k)

pub beyond(t: Tensor[F64]) -> Tensor[F64] = t.sum(axis: 8)

pub value(xs: List[List[Int]]) -> Int = xs.map(each: tensor_filled).len
