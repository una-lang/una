-- test: F64 takes units in edition 0.3 (ADR 0114 rule 12): arithmetic within one unit, products, quotients and square roots, constants that take a unit, `convert()` by a ratio k or 1/k of at most 2^53, `measured()` and `magnitude()`, comparisons, the methods with their units, `to_f64()` of a measured integer, interpolation and a list of measured values, all accepted
-- spec: spec/25 §9, spec/29 §12
-- expect: ok
module m

pub measure Meter

pub measure Second

pub measure Kilometer = 1000 * Meter

pub measure Millimeter = Meter / 1000

pub measure Hertz = 1 / Second

pub measure Wide = 9007199254740992 * Meter

pub total(a: F64 of Meter, b: F64 of Meter) -> F64 of Meter = a + b - 0.5

pub area(a: F64 of Meter, b: F64 of Meter) -> F64 of Meter * Meter = a * b

pub side(s: F64 of Meter * Meter) -> F64 of Meter = s.sqrt()

pub speed(d: F64 of Meter, t: F64 of Second) -> F64 of Meter / Second = d / t

pub rate(t: F64 of Second) -> F64 of Hertz = 1.0 / t

pub scaled(d: F64 of Meter) -> F64 of Meter = 2.0 * d + d * 0.5 - -d

pub up(k: F64 of Kilometer) -> F64 of Meter = k.convert()

pub down(m: F64 of Meter) -> F64 of Kilometer = m.convert()

pub fine(m: F64 of Meter) -> F64 of Millimeter = m.convert()

pub wide(w: F64 of Wide) -> F64 of Meter = w.convert()

pub tag(x: F64) -> F64 of Meter = x.measured()

pub raw(d: F64 of Meter) -> F64 = d.magnitude()

pub longer(a: F64 of Meter, b: F64 of Meter) -> Bool = a > b or a == 1.5 or a.ieee_lt(other: b)

pub methods(a: F64 of Meter, b: F64 of Meter, t: F64 of Second) -> F64 of Meter
=
  let r = a.abs() + a.floor() + a.ceil() + a.trunc() + a.round_half_even() + a.round_half_away()
  let m = a.rem(by: b) + a.ieee_min(other: b) + a.ieee_max(other: b) + a.clamp(lo: b, hi: 10.0)
  r + m + a.copy_sign(from: t)

pub fused(v: F64 of Meter / Second, t: F64 of Second, x: F64 of Meter) -> F64 of Meter = v.fma(times: t, plus: x)

pub tests(a: F64 of Meter) -> Bool = a.is_nan() or a.is_finite() or a.is_zero()

pub whole(a: F64 of Meter) -> Option[Int of Meter] = a.to_int_exact()

pub widened(n: Int of Meter) -> F64 of Meter = n.to_f64()

pub said(a: F64 of Meter) -> Text = "{a}"

pub lengths(xs: List[F64 of Meter]) -> List[F64 of Meter] = xs.map(each: fn(x) -> x * 2.0)
