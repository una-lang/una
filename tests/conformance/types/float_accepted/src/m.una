-- test: F64 in edition 0.3: float literals with digits on both sides of the point, `_` between digits and a lowercase exponent; operators, methods with labeled arguments, conversions, comparisons by identity and totalOrder, IEEE comparisons, the prelude functions, `Map[F64, V]`, `sort`, `min`, `max` and interpolation, all accepted
-- spec: spec/29 §1, §2, §3, §4, §5
-- expect: ok
module m

pub kind Body
  mass: F64
  name: Text

pub literals() -> List[F64] = [0.5, 1.0, 6.674_30e-11, 1.0e21, 1.0e-7, 0.0, -0.0,
  1.7976931348623158e308, 2.4703282292062328e-324
]

pub arithmetic(a: F64, b: F64) -> F64 = (a + b) * (a - b) / -a

pub methods(x: F64, y: F64) -> F64
=
  let s = x.abs().sqrt() + x.fma(times: y, plus: 1.0) + x.rem(by: y)
  let r = x.floor() + x.ceil() + x.trunc() + x.round_half_even() + x.round_half_away()
  s + r + x.copy_sign(from: y) + x.ieee_min(other: y) + x.ieee_max(other: y) + x.clamp(lo: 0.5,
    hi: 1.5
  )

pub tests(x: F64, y: F64) -> Bool
=
  let ieee = x.ieee_eq(other: y) or x.ieee_ne(other: y) or x.ieee_lt(other: y) or x.ieee_le(other: y)
  let more = x.ieee_gt(other: y) or x.ieee_ge(other: 0.0) or x.is_nan() or x.is_finite() or x.is_infinite()
  let zeros = x.is_sign_negative() or x.is_zero() or x.is_positive_zero() or x.is_negative_zero()
  ieee or more or zeros or x == y or x < y or x >= 1.5

pub conversions(n: Int, b: U8, x: F64) -> Option[Int]
=
  let f = n.to_f64() + b.to_f64()
  let bits = x.to_bits()
  let back = f64_from_bits(bits: bits)
  (f + back).floor().to_int_exact()

pub specials() -> List[F64] = [nan(), infinity(), -infinity()]

pub keyed(xs: List[F64]) -> Map[F64, Text]
=
  let sorted = sort(xs)
  let low = min(1.0, b: 2.0)
  let high = max(low, b: 3.0)
  let found = contains(sorted, item: high)
  empty_map().with(key: low, value: "low {high} {found}")

pub heavier(a: Body, b: Body) -> Bool = a.mass > b.mass or a == b

pub parsed(t: Text) -> Result[F64, ParseError] = attempt parse_f64(t)

pub json(x: F64) -> Option[F64]
=
  when json_number(x)
    is Some(j) -> as_f64(j)
    is None -> None
