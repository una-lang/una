-- test: edition 0.4 is cumulative over 0.3, so it has F64: literals, operators, methods, conversions, the prelude functions and U2033's repairs, all accepted
-- spec: spec/29 §13
-- expect: ok
module m

pub kind Body
  mass: F64

pub step(b: Body, dt: F64, n: Int) -> F64
=
  let x = b.mass * dt + n.to_f64()
  let y = x.sqrt().copy_sign(from: dt).clamp(lo: 0.5, hi: 1.5)
  if y.is_zero() or y.ieee_lt(other: 0.0) then nan() else y.floor()

pub keyed(xs: List[F64]) -> Map[F64, Text] = empty_map().with(key: max(1.0, b: infinity()), value: "{sort(xs)}")

pub read(t: Text) -> Result[F64, ParseError] = attempt parse_f64(t)
