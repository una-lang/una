-- test: in edition 0.4 a package declaration named like a dense constructor of the prelude wins over it, as for any prelude name
-- spec: spec/29 §17
-- expect: ok
module dense

pub array(n: Int) -> Int = n + 1

pub matrix(rows: Int) -> Text = "{rows}"

pub both() -> Text = "{array(1)} {matrix(rows: 2)}"
