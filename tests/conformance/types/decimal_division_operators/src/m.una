-- test: `/` and `mod` are not defined on decimals: U2001 with repairs to `divide` and `remainder`
-- spec: spec/29 §16
-- expect: error U2001 at src/m.una:7:60
-- expect: error U2001 at src/m.una:9:56
module m

pub quotient(x: Decimal[2], y: Decimal[2]) -> Decimal[2] = x / y

pub rest(x: Decimal[2], y: Decimal[2]) -> Decimal[2] = x mod y
