-- test: a complex value carries the labels of its components as an Int does: `complex(re:, im:)`, an operator and `scale(by:)` join their operands' labels, and a field of a secret complex value is secret, so writing one to the console is U4003
-- spec: spec/29 §19
-- expect: error U4003 at src/m.una:11:18
-- expect: error U4003 at src/m.una:17:18
module m

pub built(x: secret F64, y: F64) -> Unit
  uses @console: Console[print]
=
  const z = complex(re: y, im: x) * complex(re: 1.0, im: 0.0)
  @console.print("{z.re}")

pub scaled(x: secret F32, y: F32) -> Unit
  uses @console: Console[print]
=
  const z = complex(re: y, im: y).scale(by: x)
  @console.print("{z}")
