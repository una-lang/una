-- test: converting meters to seconds is between dimensions: U2030
-- spec: spec/25 §5
-- expect: error U2030 at src/m.una:18:45
module m

pub measure Meter

pub measure Second

pub measure Gram

pub measure Kilometer = 1000 * Meter

pub measure Hour = 3600000 * Millisecond

pub measure Millisecond

pub bad(d: Int of Meter) -> Int of Second = d.convert()
