-- test: every branch of `first of` has the one type of the block, so a branch of another type is U2001 (spec/27 §6, ADR 0117 rule 6)
-- spec: spec/27 §6
-- expect: error U2001 at src/mixed.una:14:5
module mixed

count(n: Int) -> Int = n + 1

label(n: Int) -> Text = "n"

pub mixed(n: Int) -> Int
=
  let value = first of
    count(n)
    label(n)
  value
