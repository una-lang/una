-- test: `start` takes no `with` clause, since its task outlives the statement a `with` scopes over: U2035 at the binding (spec/27 §7, ADR 0117 rule 7)
-- spec: spec/27 §7
-- expect: error U2035 at src/launch.una:21:28
module launch

pub capability Log
  op write(line: Text) -> Unit

pub handler quiet() for Log
  op write(line) = unit

log_line(n: Int) -> Unit
  uses @log: Log[write]
=
  @log.write("job {n}")

pub run(n: Int) -> Unit
  uses @log: Log[write]
=
  tasks
    start log_line(n) with @log = quiet()
