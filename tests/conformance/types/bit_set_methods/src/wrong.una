-- expect: error U2001 at src/wrong.una:18:28
-- expect: error U2001 at src/wrong.una:19:13
module wrong

import std.collections (BitSet, Set)

pub wrong(b: BitSet, s: Set[Int]) -> Int
=
  var t = b
  t.add(item: 1)
  const units = [edit t.remove(item: 3)]
  const c = b.with(item: "a")
  const d = b.union(other: s)
  const e = b.first(item: 1)
  t.size
