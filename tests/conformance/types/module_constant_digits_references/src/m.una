-- test: what substituting constants writes into a package counts each decimal digit of an integer, as it counts each character of a text: a 4,300-digit integer named 2,500 times in one `expect` line writes about 10,750,000 digits, past the cap of 10,000,000, and is U2041 at the reference that passes it (ADR 0126 rule 5, #1632, #2317)
-- spec: spec/10 §8
-- expect: error U2041 at src/m.una:84:71
module m

pub const n: Int = 

pub id(x: Int) -> Int = x

test "a long integer named many times"
