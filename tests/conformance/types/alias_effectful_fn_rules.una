-- test: an alias of an effectful function type is still second-class, so it cannot instantiate a type parameter; an operation its capability lacks is still unknown; and an alias whose `uses` lists no operations needs all of them, as the function type it names does
-- spec: spec/05 §3, §6
-- expect: error U1001 at 14:44
-- expect: error U3016 at 18:21
-- expect: error U3002 at 23:3
module alias_effectful_fn_rules

capability Log
  op write(line: Text) -> Unit
  op wipe() -> Unit

kind Printer = fn(Text) -> Unit uses @c: Console[print]

kind Bad = fn(Text) -> Unit uses @log: Log[wrte]

kind Logger = fn(Text) -> Unit uses @log: Log

pub stored(ps: List[Printer]) -> Int = ps.len

narrow(l: Logger) -> Unit
  uses @log: Log[write]
=
  l("z")
