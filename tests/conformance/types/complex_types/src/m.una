-- expect: error U2001 at src/m.una:31:48
-- expect: error U2001 at src/m.una:33:30
module m

pub wrong(z: Complex[Int]) -> Int = 0

pub mixed(x: F64, y: F32) -> Complex[F64] = complex(re: x, im: y)

pub integer(n: Int) -> Complex[F64] = complex(re: n, im: 0.0)

pub plus_real(z: Complex[F64]) -> Complex[F64] = z + 1.0

pub times_real(z: Complex[F64], x: F64) -> Complex[F64] = z * x

pub real_times(z: Complex[F64], x: F64) -> Complex[F64] = x * z

pub ordered(z: Complex[F64], w: Complex[F64]) -> Bool = z < w

pub modulo(z: Complex[F64], w: Complex[F64]) -> Complex[F64] = z mod w

pub widened(z: Complex[F32]) -> Complex[F64] = z

pub half() -> Complex[F64] = complex(re: 1.0)
