-- test: a call writes `edit` or `take` exactly where the parameter declares it, `edit` takes a place and `take` a binding, and operations and handlers declare no conventions (spec/17 §3 rules 1, 2 and 8)
-- spec: spec/17 §3
-- expect: error U2020 at src/memconv.una:18:13
-- expect: error U2020 at src/memconv.una:20:15
-- expect: error U2020 at src/memconv.una:34:7
-- expect: error U2020 at src/memconv.una:39:9
-- expect: error U2020 at src/memconv.una:44:7
-- expect: error U2020 at src/memconv.una:49:7
-- expect: error U2020 at src/memconv.una:53:12
-- expect: error U2020 at src/memconv.una:59:12
-- expect: error U2020 at src/memconv.una:64:3
module memconv

pub kind Tally
  count: Int

pub capability Ledger
  op record(edit n: Int) -> Unit

handler fixed(edit start: Int) for Ledger
  op record(n) = unit

add(edit t: Tally, by: Int) -> Unit
=
  t.count = t.count + by

eat(take xs: List[Int]) -> Int = xs.len

plain(n: Int) -> Int = n

pub missing_marker() -> Unit
=
  let edit t = Tally(count: 0)
  add(t, by: 1)

pub marker_on_plain() -> Int
=
  let edit n = 1
  plain(edit n)

pub missing_take() -> Int
=
  let xs = [1]
  eat(xs)

pub wrong_marker() -> Int
=
  let edit xs = [1]
  eat(edit xs)

pub not_a_place() -> Unit
=
  add(edit Tally(count: 0), by: 1)
  unit

pub take_a_field() -> Int
=
  let edit w = Wrap(items: [1])
  eat(take w.items)

pub receiver_unmarked() -> Unit
=
  let edit t = Tally(count: 0)
  t.add(by: 1)

pub kind Wrap
  items: List[Int]
