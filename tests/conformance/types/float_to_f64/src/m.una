-- test: in edition 0.3, a package function `to_f64` whose first parameter is an integer or a type parameter is U1002; one on another type is accepted
-- spec: spec/29 §4
-- expect: error U1002 at src/m.una:6:5
module m

pub to_f64[T](n: T) -> Text = "x"

pub kind Celsius
  value: Int

pub other(c: Celsius) -> F64 = c.value.to_f64()
