-- test: converting inches to centimeters is by the ratio 127/50, neither k nor 1/k, so it is U2030 (ADR 0114 rule 12.5)
-- spec: spec/25 §9
-- expect: error U2030 at src/m.una:12:48
module m

pub measure Meter

pub measure Centimeter = Meter / 100

pub measure Inch = 127 * Meter / 5000

pub bad(i: F64 of Inch) -> F64 of Centimeter = i.convert()
