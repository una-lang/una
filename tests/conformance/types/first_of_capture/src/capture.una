-- test: a branch of `first of` captures the bindings before the block and cannot change them, so passing one as `edit` is U2023, as in a `together` branch (spec/27 §6, spec/19 §2, ADR 0117 rule 6)
-- spec: spec/27 §6
-- expect: error U2023 at src/capture.una:16:15
-- expect: error U2023 at src/capture.una:17:15
module capture

bump(edit n: Int) -> Int
=
  n = n + 1
  n

pub race(start: Int) -> Int
=
  let edit total = start
  let value = first of
    bump(edit total)
    bump(edit total)
  value
