-- test: a constant expression takes the unit its context expects, in code and in clauses: `d + 2 * 3`, `requires d > 2 * 1000`, and `for i in 0..d` gives `i` the unit of `d`
-- spec: spec/25 §3
-- expect: ok
module m

pub measure Meter

pub f(d: Int of Meter) -> Int of Meter
  requires d > 2 * 1000
=
  d + 2 * 3

pub g(d: Int of Meter) -> Int of Meter
=
  let edit last = d
  for i in 0..d
    last = i
  last
