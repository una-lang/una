-- test: `scale` changes its receiver in place, so a factor in seconds is U2028 at `by` (ADR 0120 rule 64)
-- spec: spec/25 §9
-- expect: error U2028 at src/m.una:13:20
module m

pub measure Meter

pub measure Second

pub bad(a: Array[F64 of Meter], t: F64 of Second) -> Array[F64 of Meter]
=
  var b = a
  edit b.scale(by: t)
  b
