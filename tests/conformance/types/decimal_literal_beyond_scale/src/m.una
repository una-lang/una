-- test: a decimal literal is never rounded: a nonzero digit beyond the expected scale is U2037, as the other operand of an operator too
-- spec: spec/29 §16
-- expect: error U2037 at src/m.una:7:29
-- expect: error U2037 at src/m.una:9:52
module m

pub price() -> Decimal[2] = 19.995

pub fee(price: Decimal[2]) -> Decimal[2] = price + 0.005
