-- test: a kind alias of a function type resolves the operations its `uses` lists, or all of them when it lists none, for a host capability and a module's own, and serves as a parameter type
-- spec: spec/05 §3, §6
-- expect: ok
module alias_effectful_fn

capability Log
  op write(line: Text) -> Unit

kind Printer = fn(Text) -> Unit uses @c: Console[print]

kind Writer = fn(Text) -> Unit uses @log: Log[write]

kind Shouter = fn(Text) -> Unit uses @c: Console

run(p: Printer) -> Unit
  uses @c: Console[print]
=
  p("x")

record(w: Writer) -> Unit
  uses @log: Log[write]
=
  w("y")

shout(s: Shouter) -> Unit
  uses @c: Console
=
  s("z")
