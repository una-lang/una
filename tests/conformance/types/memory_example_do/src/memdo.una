-- test: a `do` line is not a statement, so a call with a marker there is U3013, and an example exercises a convention through a function that edits a local copy (spec/17 §3 rule 5)
-- spec: spec/17 §3
-- expect: error U3013 at src/memdo.una:19:6
-- expect: error U2020 at src/memdo.una:19:16
module memdo

pub bump(edit n: Int) -> Unit
=
  n = n + 1

--- Runs `bump` on a local copy, so an example can exercise it.
pub bumped(n: Int) -> Int
=
  let edit copy = n
  bump(edit copy)
  copy

example "a marker on a do line"
  do bump(edit 1)
  expect result == unit

example "through a function that edits a local copy"
  do bumped(1)
  expect result == 2
