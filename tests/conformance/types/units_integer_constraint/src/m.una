-- test: a measured type does not satisfy `Integer`: `sum` of a list of grams is U2025
-- spec: spec/25 §4
-- expect: error U2025 at src/m.una:14:41
module m

pub measure Meter

pub measure Second

pub measure Gram

pub measure Kilometer = 1000 * Meter

pub bad(xs: List[Int of Gram]) -> Int = xs.sum()
