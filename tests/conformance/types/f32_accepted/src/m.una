-- test: F32 in edition 0.5: float literals typed by an expected F32, an operator's other operand included, on either side; operators, methods with labeled arguments, `to_f32` of an integer and of an F64, `to_f64` of an F32, `to_bits` as a U32, comparisons by identity and totalOrder, the prelude functions, `Map[F32, V]`, `sort` and `max`, all accepted
-- spec: spec/29 §18
-- expect: ok
module m

pub kind Sample
  value: F32
  name: Text

pub literals() -> List[F32] = [0.5, 1.0, 0.1, 6.674_30e-11, 1.0e-45, 3.4028235e38,
  3.4028235677973366e38, 0.0, -0.0
]

pub arithmetic(a: F32, b: F32) -> F32 = (a + b) * (a - b) / -a + 0.1

pub literal_first(x: F32) -> F32 = 0.1 + x * 2.5

pub methods(x: F32, y: F32) -> F32
=
  const s = x.abs().sqrt() + x.fma(times: y, plus: 1.0) + x.rem(by: y)
  const r = x.floor() + x.ceil() + x.trunc() + x.round_half_even() + x.round_half_away()
  const c = x.clamp(lo: 0.5, hi: 1.5)
  s + r + x.copy_sign(from: y) + x.ieee_min(other: y) + x.ieee_max(other: y) + c

pub tests(x: F32, y: F32) -> Bool
=
  const ieee = x.ieee_eq(other: y) or x.ieee_lt(other: 0.5) or x.is_nan() or x.is_finite() or x.is_zero()
  ieee or x == y or x < y or x >= 1.5 or 0.25 < x

pub conversions(n: Int, b: U8, x: F32, d: F64) -> Option[Int]
=
  const f = n.to_f32() + b.to_f32() + d.to_f32()
  const wide: F64 = x.to_f64() + d
  const bits: U32 = x.to_bits()
  const back = f32_from_bits(bits: bits)
  (f + back + wide.to_f32()).floor().to_int_exact()

pub specials() -> List[F32] = [nan().to_f32(), infinity().to_f32(), -infinity().to_f32()]

pub keyed(xs: List[F32]) -> Map[F32, Text]
=
  const sorted = sort(xs)
  const low: F32 = 1.0
  const three: F32 = 3.0
  const high = max(low, b: three)
  empty_map().with(key: low, value: "low {high} {contains(sorted, item: high)}")

pub heavier(a: Sample, b: Sample) -> Bool = a.value > b.value or a == b

pub parsed(t: Text) -> Result[F32, ParseError] = attempt parse_f32(t)
