-- test: every comparison of an F64 with a float literal zero, `0.0` or `-0.0`, on either side, is U2033, each with the repair of its form
-- spec: spec/29 §5
-- expect: error U2033 at src/m.una:12:26
-- expect: error U2033 at src/m.una:14:26
-- expect: error U2033 at src/m.una:16:26
-- expect: error U2033 at src/m.una:18:26
-- expect: error U2033 at src/m.una:20:26
-- expect: error U2033 at src/m.una:22:26
-- expect: error U2033 at src/m.una:24:39
module m

pub eq(x: F64) -> Bool = x == 0.0

pub ne(x: F64) -> Bool = x != -0.0

pub lt(x: F64) -> Bool = x < 0.0

pub le(x: F64) -> Bool = x <= 0.000

pub gt(x: F64) -> Bool = 0.0 > x

pub ge(x: F64) -> Bool = x >= -0.0

pub guard(n: F64, d: F64) -> F64 = if d == 0.0 then 0.0 else n / d
