-- test: the scale of `parse_decimal` and `as_decimal` is a literal from 0 to 38 at the parameter `scale`, however the argument binds it: a punned or labeled variable, a negative or an out-of-range scale is U2037, so no run-time value sets a scale
-- spec: spec/29 §16
-- expect: error U2037 at src/m.una:14:20
-- expect: error U2037 at src/m.una:19:27
-- expect: error U2037 at src/m.una:24:27
-- expect: error U2037 at src/m.una:26:68
-- expect: error U2037 at src/m.una:32:19
module m

pub punned(t: Text) -> Decimal[0]
  fails ParseError
=
  let scale = 2
  parse_decimal(t, scale)

pub labeled(t: Text, s: Int) -> Decimal[2]
  fails ParseError
=
  parse_decimal(t, scale: s)

pub wide(t: Text) -> Decimal[2]
  fails ParseError
=
  parse_decimal(t, scale: 39)

pub negative(j: Json) -> Option[Decimal[2]] = as_decimal(j, scale: -1)

pub method(t: Text) -> Decimal[0]
  fails ParseError
=
  let scale = 2
  t.parse_decimal(scale)
