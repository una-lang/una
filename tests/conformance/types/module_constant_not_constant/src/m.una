module m

pub kind Point
  x: Int
  y: Int

pub const origin: Point = Point(x: 0, y: 0)

pub double(n: Int) -> Int = n * 2

pub const a: Int = double(2)

pub const b: Int = "ab".len

pub const c: Int = fn(x) -> x

pub const d: Text = "n {1}"

pub const e: Int = if true then 1 else 2

pub const f: Int = origin.x

pub const g: Bool = true implies false
