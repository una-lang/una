-- test: conversions and the wrapping, saturating and bit methods are built-in methods of the integer types (spec/18 §4, §5)
-- spec: spec/18 §4
-- expect: error U2001 at src/fixedmeth.una:15:30
-- expect: error U2001 at src/fixedmeth.una:17:28
-- expect: error U2001 at src/fixedmeth.una:19:26
-- expect: error U2001 at src/fixedmeth.una:21:44
module fixedmeth

pub widen(a: U8) -> I64 = a.to_i64()

pub to_math(a: I32) -> Int = a.to_int()

pub wrapped(a: U8, b: U8) -> U8 = a.wrapping_add(b).saturating_sub(1).bit_xor(255)

pub not_int(n: Int) -> Int = n.wrapping_add(1)

pub labeled(a: U8) -> U8 = a.wrapping_add(b: 1)

pub extra(a: U8) -> U8 = a.bit_not(1)

pub mixed(a: U8, b: U16) -> U8 = a.bit_and(b)
