-- test: conversions and the wrapping, saturating and bit methods are built-in methods of the integer types, whose argument is labeled `by` or `mask` (spec/18 §4, §5)
-- spec: spec/18 §4
-- expect: error U2001 at src/fixedmeth.una:16:30
-- expect: error U2004 at src/fixedmeth.una:18:45
-- expect: error U2005 at src/fixedmeth.una:20:42
-- expect: error U2001 at src/fixedmeth.una:22:26
-- expect: error U2001 at src/fixedmeth.una:24:50
module fixedmeth

pub widen(a: U8) -> I64 = a.to_i64()

pub to_math(a: I32) -> Int = a.to_int()

pub wrapped(a: U8, b: U8) -> U8 = a.wrapping_add(by: b).saturating_sub(by: 1).bit_xor(mask: 255)

pub not_int(n: Int) -> Int = n.wrapping_add(by: 1)

pub unlabeled(a: U8) -> U8 = a.wrapping_add(1)

pub wrong_label(a: U8) -> U8 = a.bit_and(by: 15)

pub extra(a: U8) -> U8 = a.bit_not(1)

pub mixed(a: U8, b: U16) -> U8 = a.bit_and(mask: b)

pub punned(a: U8, by: U8, mask: U8) -> U8 = a.wrapping_mul(by).bit_or(mask)
