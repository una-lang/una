-- test: after expect fails, the variant is looked up only in the error kind of the do expression (R-020)
-- spec: spec/10 §12
-- expect: error U1001 at 19:16
module expect_fails_outside_do_kind

kind E = A | B

kind Other = | Z

pub f(x: Int) -> Int
  fails E
=
  if x > 0 then fail A else fail B

pub g(x: Int) -> Other = Z

example "a variant of an unrelated kind"
  do f(1)
  expect fails Z
