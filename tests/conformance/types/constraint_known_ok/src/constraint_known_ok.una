-- test: the constraints `Eq`, `Ord` and `Integer` are accepted; any other name after `:` is U2027 (positive twin, #11)
-- spec: spec/20 §2
-- expect: ok
module constraint_known_ok

pub same[T: Eq](a: T, b: T) -> Bool = a == b

pub least[T: Ord](a: T, b: T) -> T = if a < b then a else b

pub widened[T: Integer](a: T) -> Int = a.to_int()
