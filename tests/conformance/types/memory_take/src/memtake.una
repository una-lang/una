-- test: a binding passed by `take` cannot be used again, also after a branch that takes it, until an assignment gives it a new value (spec/17 §3 rule 3)
-- spec: spec/17 §3
-- expect: error U2017 at src/memtake.una:14:7
-- expect: error U2017 at src/memtake.una:22:3
-- expect: error U2017 at src/memtake.una:28:20
module memtake

eat(take xs: List[Int]) -> Int = xs.len

pub used_after() -> Int
=
  let xs = [1, 2]
  let n = eat(take xs)
  n + xs.len

pub taken_in_branch(flag: Bool) -> Int
=
  let edit xs = [1, 2]
  if flag
    let n = eat(take xs)
    unit
  xs.len

pub taken_twice() -> Int
=
  let xs = [1]
  let a = eat(take xs)
  let b = eat(take xs)
  a + b

pub revived() -> Int
=
  let edit xs = [1, 2]
  let n = eat(take xs)
  xs = [n]
  xs.len

pub revived_in_both(flag: Bool) -> Int
=
  let edit xs = [1, 2]
  let n = eat(take xs)
  let m = if flag
    xs = [1]
    1
  else
    xs = [2]
    2
  xs.len + n + m
