-- test: the body of a `reflect` predicate computes fixed-width arithmetic exactly, as the verifier reads it: no `overflow` obligation and no U2022 for a literal past the type, so the package checks with no obligation (2026-10-06; spec/18 §2, §3)
-- spec: spec/18 §3
-- expect: ok
module reflexact

pub predicate reflect scaled_large(x: U32) -> Bool = x * 4294967295 > 4294967295

pub predicate reflect past_top(x: U32) -> Bool = x + 4294967296 > 4294967296

pub predicate reflect below_zero(x: U8) -> Bool = x - 1 < 0
