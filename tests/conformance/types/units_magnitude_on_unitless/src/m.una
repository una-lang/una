-- test: `magnitude()` on a unitless value is U2028
-- spec: spec/25 §5
-- expect: error U2028 at src/m.una:18:26
module m

pub measure Meter

pub measure Second

pub measure Gram

pub measure Kilometer = 1000 * Meter

pub measure Hour = 3600000 * Millisecond

pub measure Millisecond

pub bad(n: Int) -> Int = n.magnitude()
