-- test: `uses of p` and `fails of p` name a parameter of a plain function type (U3017 to U3019); a pure parameter takes no effects (U3004); the parameter is only called or passed on, not bound or captured (U3006); a call with effects is a whole statement and is handled (U3013, U3007); a callee`s own kind and `fails of` share one kind (U3009) (spec/05 §9 rule 9, ADR 0062)
-- spec: spec/05 §9
-- expect: error U3017 at src/effrules.una:24:11
-- expect: error U3018 at src/effrules.una:29:11
-- expect: error U3019 at src/effrules.una:34:11
-- expect: error U3004 at src/effrules.una:44:21
-- expect: error U3006 at src/effrules.una:54:11
-- expect: error U3006 at src/effrules.una:60:25
-- expect: error U3013 at src/effrules.una:72:3
-- expect: error U3007 at src/effrules.una:77:12
-- expect: error U3009 at src/effrules.una:91:60
-- expect: error U3009 at src/effrules.una:98:34
-- expect: error U3013 at src/effrules.una:103:11
module effrules

pub kind Oops = Bad | Worse

pub kind Other = Odd | Even

pub capability Log
  op write(line: Text) -> Unit

pub no_param(xs: List[Int]) -> Unit
  uses of missing
=
  unit

pub not_a_function(n: Int) -> Unit
  uses of n
=
  unit

pub fixed(f: fn(Int) -> Unit uses @log: Log[write]) -> Unit
  uses of f
=
  unit

--- A pure higher-order function: its parameter has no `uses of`.
pub pure_run(f: fn(Int) -> Unit, x: Int) -> Unit = f(x)

pub effects_into_pure() -> Unit
  uses @log: Log[write]
=
  pure_run(fn(n) -> @log.write("{n}"), x: 1)

pub runs(f: fn(Int) -> Unit) -> Unit
  uses of f
=
  f(1)

pub escapes(f: fn(Int) -> Unit) -> Unit
  uses of f
=
  let g = f
  unit

pub in_lambda(f: fn(Int) -> Unit) -> Unit
  uses of f
=
  let g = fn(x: Int) -> f(x)
  unit

pub through_map(f: fn(Int) -> Unit, xs: List[Int]) -> Unit
  uses of f
=
  let done = xs.map(each: fn(x) -> f(x))
  unit

pub not_a_statement(xs: List[Text]) -> Int
  uses @log: Log[write]
=
  xs.map(each: fn(x) -> @log.write(x)).len

pub unhandled(xs: List[Text]) -> List[Int]
  fails Oops
=
  let ys = xs.map(each: fn(t) -> if t.len > 0 then t.len else fail Bad)
  ys

pub retry(n: Int, act: fn(Int) -> Int) -> Int
  fails Oops
  fails of act
=
  let r = act(n)
    if error pass
  r

pub wrong_kind() -> Int
  fails Oops
=
  let r = retry(1, act: fn(n) -> if n > 0 then n else fail Odd)
    if error pass
  r

pub own_fail(xs: List[Int], f: fn(Int) -> Int) -> Int
  fails of f
=
  if xs.len > 0 then 1 else fail Bad

pub nested_in_expression(rows: List[List[Text]]) -> Int
  uses @log: Log[write]
=
  let n = rows.map(each: fn(row) -> row.map(each: fn(cell) -> @log.write(cell))).len
  n
