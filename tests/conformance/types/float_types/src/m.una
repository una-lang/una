-- test: F64 is distinct from the integer types: an integer literal where an F64 is expected, an integer operand of an F64 operator, `mod`, `to_int()` and the prelude's `abs` on an F64 are U2001
-- spec: spec/29 §1, §2, §3, §4
-- expect: error U2001 at src/m.una:11:20
-- expect: error U2001 at src/m.una:13:40
-- expect: error U2001 at src/m.una:15:37
-- expect: error U2001 at src/m.una:17:31
-- expect: error U2001 at src/m.una:19:35
-- expect: error U2001 at src/m.una:21:25
module m

pub one() -> F64 = 1

pub mixed(x: F64, n: Int) -> F64 = x + n

pub modulo(x: F64, y: F64) -> F64 = x mod y

pub truncate(x: F64) -> Int = x.to_int()

pub absolute(x: F64) -> Int = abs(x)

pub negative() -> F64 = -2
