-- test: a comparison of an F32 with a float literal zero is U2033 on either side, and a float literal pattern over an F32 is U2032, as for F64
-- spec: spec/29 §18
-- expect: error U2033 at src/m.una:9:26
-- expect: error U2033 at src/m.una:11:26
-- expect: error U2032 at src/m.una:13:28
-- expect: error U2032 at src/m.una:18:5
module m

pub eq(x: F32) -> Bool = x == 0.0

pub gt(x: F32) -> Bool = 0.0 > x

pub half(x: F32) -> Bool = x is 0.5

pub named(x: F32) -> Text
=
  when x
    is 1.5 -> "one and a half"
    else -> "other"
