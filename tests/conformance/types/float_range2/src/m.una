-- test: U2031 at the edges of the range: `1.0e309` rounds to an infinity, `1.0e-400` to zero, and an exponent of twenty digits too
-- spec: spec/29 §2
-- expect: error U2031 at src/m.una:8:20
-- expect: error U2031 at src/m.una:10:21
-- expect: error U2031 at src/m.una:12:21
module m

pub big() -> F64 = 1.0e309

pub tiny() -> F64 = 1.0e-400

pub huge() -> F64 = 1.0e99999999999999999999
