-- test: in edition 0.4 a package declaration named like a tensor constructor of the prelude wins over it, as for any prelude name, and its shape is no list literal
-- spec: spec/29 §17
-- expect: ok
module dense

pub tensor(n: Int) -> Int = n + 1

pub tensor_filled(rows: Int) -> Text = "{rows}"

pub both() -> Text = "{tensor(1)} {tensor_filled(rows: 2)}"
