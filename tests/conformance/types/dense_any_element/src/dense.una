-- test: an Array of any element type is read, updated in place and sliced, its length is in the refinement language, and `with:`, `and:`, `from:` label the arguments of dense methods
-- spec: spec/29 §17
-- expect: ok
module dense

pub first(names: Array[Text]) -> Option[Text] = names.at(index: 0)

pub renamed(names: Array[Text]) -> Array[Text]
  requires names.len >= 3
  ensures result.len == 2
=
  var copy = names
  edit copy.set(index: 0, item: "a")
  copy.slice(from: 1, until: 3).compact()

pub combined(c: Matrix[F64], a: Matrix[F64], b: Matrix[F64]) -> Matrix[F64]
  requires c.rows == a.rows and a.columns == b.rows and b.columns == c.columns
  ensures result.rows == c.rows
=
  var out = c
  edit out.add_product(of: a, and: b)
  out

pub paired(a: Array[F64], b: Array[F64]) -> Array[F64]
  requires a.len == b.len
=
  a.zip_map(with: b, each: fn(x, y) -> x.fma(times: y, plus: 1.0))
