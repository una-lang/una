module shop

pub capability Catalog
  op price(sku: Int) -> Int
  op set_price(sku: Int, cents: Int) -> Unit
  op journal(n: Int) -> Unit

pub capability Log
  op write(n: Int) -> Unit

pub update(sku: Int, cents: Int, dry_run: Bool) -> Unit = unit
