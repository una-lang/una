-- test: a public function without uses calls a function with effects
-- spec: spec/04 §2, §5
-- expect: error U3003 at 14:24
module effects_exceed_uses

capability Log
  op write(line: Text) -> Unit

pub note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub report() -> Unit = note("done")
