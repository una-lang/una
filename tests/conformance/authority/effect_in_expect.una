-- test: effectful calls in `expect` lines, one needing a host capability (review control)
-- spec: spec/04 §4
-- expect: error U3013 at 32:20
-- expect: error U3013 at 33:10
-- expect: error U3014 at 33:10
module effect_in_expect

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

handler rows(n: Int) for Store
  op find(key) = None
  op count() = n

pub counted() -> Int
  uses @store: Store[count]
=
  @store.count()

pub greet() -> Unit
  uses @console: Console[print]
=
  @console.print("hi")

example "an expect line with effects"
  given @store = rows(n: 3)
  do counted()
  expect result == counted()
  expect greet() == unit
