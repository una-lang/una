-- test: a handler installed around a call of an inferred function answers at `public` in the installing body, so the callee reads it unlabeled and returns it `public` (ADR 0094 rules 3 and 4)
-- spec: spec/05 §9
-- expect: ok
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

handler fixed() for Files
  op owner(file) = "nobody"
  op role(file) = "none"

owner_of(file: Text) -> Text = @files.owner(file)

pub shown(file: Text) -> Text
=
  owner_of(file) with @files = fixed()
