-- test: two attempt calls on one line of an opaque predicate body are rejected (R-029)
-- spec: spec/04 §4
-- expect: error U3013 at 20:60
-- expect: error U3013 at 20:82
module effect_in_predicate_line

pub kind ParseError = | Bad

parse(t: Text) -> Int
  fails ParseError
=
  if t == "1" then 1 else fail Bad

predicate opaque parses(a: Text) -> Bool =
  let parsed = attempt parse(a)
  when parsed
    is Ok(n) -> n == 1
    is Err(e) -> false

predicate opaque same(a: Text, b: Text) -> Bool = (attempt parse(a)) == (attempt parse(b))
