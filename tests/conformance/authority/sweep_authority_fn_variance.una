-- test: function types are covariant in `uses` and `fails` and contravariant through their parameters at the call argument, the only flow site of a second-class value (label sweep)
-- spec: spec/05 §6
-- expect: error U3003 at 48:12
-- expect: error U3009 at 50:42
-- expect: error U3006 at 67:11
module sweep_authority_fn_variance

capability Log
  op write(line: Text) -> Unit

kind Boom = | Exploded

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

quiet(line: Text) -> Unit = unit

boom(x: Int) -> Int
  fails Boom
=
  fail Exploded

plain(x: Int) -> Int = x

run_pure(f: fn(Text) -> Unit) -> Unit = f("x")

run_logged(f: fn(Text) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  f("x")

run_int(f: fn(Int) -> Int) -> Int = f(1)

run_failing(f: fn(Int) -> Int fails Boom) -> Int
  fails Boom
=
  let n = f(1)
    if error pass
  n

give_pure(g: fn(fn(Text) -> Unit) -> Unit) -> Unit = g(quiet)

pub effectful_into_pure() -> Unit
  uses @log: Log[write]
=
  run_pure(note)

pub failing_into_pure() -> Int = run_int(boom)

pub pure_into_effectful() -> Unit
  uses @log: Log[write]
=
  run_logged(quiet)

pub pure_into_failing() -> Int
  fails Boom
=
  let n = run_failing(plain)
    if error pass
  n

pub stored() -> Int
  uses @log: Log[write]
=
  let f = note
  0

pub parameter_contravariance() -> Unit = give_pure(fn(h: fn(Text) -> Unit uses @log: Log[write]) -> unit)
