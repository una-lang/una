-- test: examples take every capability from given, may nest effects on the do line and expect performed operations
-- spec: spec/08 §2
-- expect: tier0-ok
module examples_with_given

import std.testing (fake_hash)

pub kind StoreError = Timeout | Corrupted

pub kind LookupError = | Missing

pub capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError

pub capability Hasher
  op hash(seed: Int) -> internal Hashed

handler rows(values: List[Int]) for Store
  op find(key) = values.at(index: key)

handler fake() for Hasher
  op hash(seed) = fake_hash(seed)

handler fake_console() for Console
  op print(line) = unit

pub lookup(key: Int) -> Int
  uses @store: Store[find]
  fails LookupError
=
  let value = @store.find(key)
    if error fail Missing
    if none fail Missing
  value

pub digest(seed: Int) -> internal Hashed
  uses @hasher: Hasher[hash]
=
  @hasher.hash(seed)

pub greet(name: Text) -> Unit
  uses @console: Console[print]
=
  @console.print("hello {name}")

example "a stored value is found"
  given @store = rows(values: [10, 20])
  do lookup(1)
  expect result == 20
  expect performed @store.find

example "a missing value fails"
  given @store = rows(values: [])
  do lookup(abs(lookup(0)))
  expect fails Missing

example "a digest is the fake hash"
  given @hasher = fake()
  do digest(1)
  expect result == fake_hash(1)

example "a host capability may be given a handler"
  given @console = fake_console()
  do greet("Ana")
  expect performed @console.print
