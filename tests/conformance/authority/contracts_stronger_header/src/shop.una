-- test: a header stronger than its lock is accepted: an operation left out, and a condition that implies the lock's (ADR 0092 rule 8, as amended)
-- spec: spec/05 §3
-- expect: ok
module shop

pub capability Catalog
  op price(sku: Int) -> Int
  op set_price(sku: Int, cents: Int) -> Unit
  op journal(n: Int) -> Unit

pub capability Log
  op write(n: Int) -> Unit

pub update(sku: Int, cents: Int, dry_run: Bool) -> Unit
  uses @catalog: Catalog[price, set_price where not dry_run and cents > 0]
=
  if not dry_run and cents > 0
    @catalog.set_price(sku, cents)
  unit
