module media.app

import media.cache (mirrored)
import media.resize (shrink)
import media.store (Files, Net)

pub two(path: Text) -> Text
  uses @secrets: Files[read, write]
  uses @user: Files[read, write]
=
  shrink(path)

pub own(path: Text) -> Text
  uses @files: Files[read, write]
  uses @secrets: Files[read, write]
=
  shrink(path)

pub value(path: Text) -> Text
  uses @files: Files[read]
=
  let f = shrink
  f(path)

save(path: Text) -> Unit
  uses @files: Files[write]
=
  @files.write(path, data: path)

pub install(path: Text) -> Unit
  uses @user_net: Net[post]
=
  save(path) with @n = @user_net, @files = mirrored()

pub shadow(path: Text) -> Text
  uses @secrets: Files[read, write]
  uses @user: Files[read, write]
=
  shrink(path) with @user = @secrets

pub shadow2(path: Text) -> Text
  uses @secrets: Files[read, write]
  uses @user: Files[read, write]
=
  shrink(path) with @secrets = @user[write]

pub narrowed(path: Text) -> Text
  uses @secrets: Files[read, write]
=
  shrink(path) with @secrets = @secrets[write]

apply(p: Text, f: fn(Text) -> Text uses @files: Files[read]) -> Text
  uses @files: Files[read]
=
  f(p)

pub lam_arg(path: Text) -> Text
  uses @secrets: Files[read, write]
  uses @user: Files[read, write]
=
  apply(path, f: fn(p) -> shrink(p)) with @user = @secrets

via(p: Text) -> Text
  uses @files: Files[read]
=
  shrink(p) with @files = @files[read]

pub lam_via(path: Text) -> Text
  uses @secrets: Files[read, write]
=
  apply(path, f: fn(p) -> via(p)) with @files = @secrets

pub lam_value(path: Text) -> Text
  uses @secrets: Files[read, write]
=
  apply(path, f: fn(p) -> apply(p, f: shrink)) with @files = @secrets
