-- test: `on_stop` of the served module cannot say `diverges`: the stop ends after finitely many steps (spec/31 §7, ADR 0123 rule 16)
-- spec: spec/31 §7
-- expect: error U3027 at src/srv.una:15:3
module srv

import std.host (Reply, Request)

--- Answers every request with 200.
pub handle(request: internal Request) -> internal Reply = Reply(status: 200, headers: [],
  body: "ok"
)

--- Stops.
pub on_stop() -> Unit
  diverges
=
  unit
