-- test: an inferred function reads a labeled operation at the join of its callers' labels, so returning the answer at one caller's label only is U4001 in its body (ADR 0094 rule 3)
-- spec: spec/05 §9
-- expect: error U4001 at src/m.una:10:50
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

owner_of(file: Text) -> internal[Service] Text = @files.owner(file)

pub by_service(file: Text) -> internal[Service] Text
  uses @files: Files[owner gives internal[Service]]
=
  owner_of(file)

pub by_billing(file: Text) -> internal[Billing, Service] Text
  uses @files: Files[owner gives internal[Billing]]
=
  owner_of(file)
