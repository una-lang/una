-- test: capabilities compared (review control)
-- spec: spec/05 §6
-- expect: error U3005 at 15:3
-- expect: error U3005 at 15:11
module cap_compared

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

leak() -> Bool
  uses @log: Log[write]
  uses @other: Log[write]
=
  @log == @other
