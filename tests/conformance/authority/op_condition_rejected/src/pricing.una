-- expect: error U2016 at src/pricing.una:64:40
module pricing

predicate opaque positive(n: Int) -> Bool = n > 0

pub kind Fault = Bad | Worse

pub capability Catalog
  op price(sku: Int) -> Int
  op journal(note: Text) -> Unit

pub not_bool(n: Int) -> Unit
  uses @catalog: Catalog[journal where n]
=
  unit

pub uses_result(n: Int) -> Unit
  uses @catalog: Catalog[journal where result]
=
  unit

pub uses_it(n: Int) -> Unit
  uses @catalog: Catalog[journal where it > 0]
=
  unit

pub calls_op(n: Int) -> Unit
  uses @catalog: Catalog[journal where @catalog.price(n) > 0]
=
  unit

pub unknown_name(n: Int) -> Unit
  uses @catalog: Catalog[journal where m > 0]
=
  unit

pub uses_checked(n: Int) -> Unit
  uses @catalog: Catalog[journal where checked(n > 0, it) else fail Bad]
=
  unit

pub uses_attempt(n: Int) -> Unit
  uses @catalog: Catalog[journal where attempt @catalog.price(n)]
=
  unit

pub uses_lambda(n: Int) -> Unit
  uses @catalog: Catalog[journal where (fn(x: Int) -> x > 0)(n)]
=
  unit

pub uses_opaque(n: Int) -> Unit
  uses @catalog: Catalog[journal where positive(n)]
=
  unit
