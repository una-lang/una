-- test: the effects of a lambda given to a boundary are authority granted to it, checked against the ceiling: U3021 for one that posts (ADR 0093 rule 3)
-- spec: spec/05 §4
-- expect: error U3021 at src/media/app.una:12:3
module media.app

import media.resize (notify, shrink, size_of)
import media.store (Files, Net)

pub announce(path: Text) -> Unit
  uses @net: Net[post]
=
  notify(path, done: fn(p) -> @net.post(p))

pub quiet(path: Text) -> Unit = notify(path, done: fn(p) -> unit)
