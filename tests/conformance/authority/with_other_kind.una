-- test: `with @log = @audit` across capability kinds (review control)
-- spec: spec/05 §4
-- expect: error U3001 at 22:3
module with_other_kind

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

capability Audit
  op write(line: Text) -> Unit
  op flush() -> Unit

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub run() -> Unit
  uses @audit: Audit[write]
=
  note("x") with @log = @audit
