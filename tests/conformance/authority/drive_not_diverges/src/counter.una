-- test: none of the functions of a driven module may say `diverges` (U3027) (spec/26 §2, ADR 0116 rule 2)
-- spec: spec/26 §2
-- expect: error U3027 at src/counter.una:11:3
module counter

import std.drive (Tick)

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
  diverges
=
  count = count + 1
