-- test: a test that uses `HttpServer` without a `given` handler is U3014, as for every host capability (spec/31 §1, ADR 0123 rule 1)
-- spec: spec/31 §1
-- expect: error U3014 at src/srv.una:14:6
module srv

import std.host (HttpServer)

pub stop_serving() -> Unit
  uses @server: HttpServer[close]
=
  @server.close()

test "the server stops"
  do stop_serving()
  expect result == unit
