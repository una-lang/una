-- test: private helper with inferred `fails` passed to `map` (review control)
-- spec: spec/05 §9
-- expect: error U3009 at 13:16
module inferred_fails_into_map

kind E = | Bad

helper(x: Int) -> Int = if x > 0 then x else fail Bad

pub run(xs: List[Int]) -> List[Int]
  fails E
=
  xs.map(each: helper)
