-- test: a private function whose inferred `uses` label an operation is not a function value, as one whose header writes the label is not (ADR 0094 rule 1)
-- spec: spec/05 §3
-- expect: error U3006 at src/m.una:22:31
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

owner_of(file: Text) -> internal[Service] Text = @files.owner(file)

pub each(files: List[Text], f: fn(Text) -> internal[Service] Text uses @files: Files[owner]) -> List[internal[Service] Text]
  uses @files: Files[owner]
=
  files.map(each: f)

pub refusals(files: List[Text], file: Text) -> List[internal[Service] Text]
  uses @files: Files[owner gives internal[Service]]
  uses @plain: Files[owner]
=
  let direct = owner_of(file)
  let others = each(files, f: owner_of) with @files = @plain
  others.append(item: direct)
