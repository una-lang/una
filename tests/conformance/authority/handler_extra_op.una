-- test: handler implements an op the capability lacks (review control)
-- spec: spec/05 §9
-- expect: error U3010 at 16:6
module handler_extra_op

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

handler extra() for Store
  op find(key) = None
  op count() = 0
  op wipe() = unit
