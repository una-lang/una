-- test: a call, in the body of `together for`, of a function whose effects include `reply` is U3033 at the call (spec/31 §1, ADR 0123 rule 5)
-- spec: spec/31 §1
-- expect: error U3033 at src/srv.una:18:5
module srv

import std.host (Exchange, HttpServer, Reply)

send(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: exchange.right, reply: Reply(status: 204, headers: [], body: ""))
    if error use unit

answer_all(exchanges: internal List[Exchange]) -> Unit
  uses @server: HttpServer[reply]
=
  let sent = together for exchange in exchanges
    send(exchange)
  unit
