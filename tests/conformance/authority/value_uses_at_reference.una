-- test: a function value runs on the bindings its `uses` resolve to where it is named, whoever calls it, so they are needed there as a lambda's are where it is written: a reference with no binding of a name its function uses is U3001, or U3003 in code with no `uses`; a reference under a binding, then called under another, is accepted
-- spec: spec/05 §6
-- expect: error U3001 at 39:16
-- expect: error U3003 at 41:40
module value_uses_at_reference

capability Log
  op write(n: Int) -> Int

capability Net
  op post(n: Int) -> Int

handler h1() for Log
  op write(n) = n

handler h2() for Log
  op write(n) = n + 1

runner(n: Int, f: fn(Int) -> Int uses @log: Log[write]) -> Int
=
  f(n) with @log = h2()

write_it(n: Int) -> Int
  uses @log: Log[write]
=
  @log.write(n)

pub named(n: Int) -> Int
=
  runner(n, f: write_it) with @log = h1()

pub lambda(n: Int) -> Int
=
  runner(n, f: fn(m) -> @log.write(m)) with @log = h1()

pub no_binding(n: Int) -> Int
  uses @net: Net[post]
=
  runner(n, f: write_it)

pub pure(n: Int) -> Int = runner(n, f: write_it)
