-- test: a lock whose string has escapes, or is a multi-line string with a line-ending backslash, is read as its value and matched by its parsed conditions: a header that writes the same conditions plainly is accepted (ADR 0092 rule 8, as amended)
-- spec: spec/05 §3
-- expect: ok
module shop

pub capability Catalog
  op set_price(sku: Int, cents: Int) -> Unit
  op set_name(sku: Int, name: Text) -> Unit

pub update(sku: Int, cents: Int, name: Text) -> Unit
  uses @catalog: Catalog[set_price where cents > 0, set_name where name == "a"]
=
  if cents > 0
    @catalog.set_price(sku, cents)
  if name == "a"
    @catalog.set_name(sku, name)
  unit

pub rename(sku: Int, cents: Int, name: Text) -> Unit
  uses @catalog: Catalog[set_price where cents > 0, set_name where name == "b"]
=
  if cents > 0
    @catalog.set_price(sku, cents)
  if name == "b"
    @catalog.set_name(sku, name)
  unit
