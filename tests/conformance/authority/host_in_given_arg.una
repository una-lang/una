-- test: `given` handler that needs a host capability (review control)
-- spec: spec/05 §9
-- expect: error U3014 at 24:18
module host_in_given_arg

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

handler rows(n: Int) for Store
  uses @clock: Clock[now]
  op find(key) = None
  op count() = @clock.now()

pub counted() -> Int
  uses @store: Store[count]
=
  @store.count()

example "a handler that needs a host capability"
  given @store = rows(n: 3)
  do counted()
  expect result > 0
