-- test: a parameter that an `of` clause names, given to a boundary directly or called in a lambda given to it, runs the effects its caller chooses, which no ceiling bounds: U3021 at the call (ADR 0093 rule 5)
-- spec: spec/05 §4
-- expect: error U3021 at src/media/app.una:13:3
-- expect: error U3021 at src/media/app.una:18:3
module media.app

import media.resize (notify, shrink, size_of)
import media.store (Files, Net)

pub forward(path: Text, g: fn(Text) -> Unit) -> Unit
  uses of g
=
  notify(path, done: g)

pub wrap(path: Text, g: fn(Text) -> Unit) -> Unit
  uses of g
=
  notify(path, done: fn(p) -> g(p))

pub announce(path: Text) -> Unit
  uses @net: Net[post]
=
  forward(path, g: fn(p) -> @net.post(p))
