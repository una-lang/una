-- test: a function that mentions a poisoned function as a value is poisoned, so a clause on its call is not U3025 (ADR 0100 rule 3)
-- spec: spec/06 §3
-- expect: error U3007 at src/main.una:15:11
module main

kind E = | Bad

risky(n: Int) -> Int
  fails E
=
  if n < 0 then fail Bad else n

c(n: Int) -> Int
=
  let x = risky(n)
  x

f(n: Int) -> Int
=
  let h = c
  let y = h(n)
    if error pass
  y

pub user(n: Int) -> Int
  fails E
=
  let z = f(n)
    if error use 0
  z
