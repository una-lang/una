-- test: ADR 0093 rule 6: a call that needs two grants within the ceiling gets one U3020 for each, each with its narrowed grant; `una fix` applies them in two rounds
-- spec: spec/13 §3
-- expect: error U3020 at src/media/app.una:13:3
module media.app

import media.resize (share)
import media.store (Files, Net)

pub send(path: Text) -> Unit
  uses @files: Files[read, write]
  uses @net: Net[post]
=
  share(path)
