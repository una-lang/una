-- test: a std.testing function used as a value, not called, is U3015 even in handler bodies and examples (R-017)
-- spec: spec/14 §4
-- expect: error U3015 at 19:14
-- expect: error U3015 at 25:12
-- expect: error U3015 at 26:26
module testing_function_as_value

import std.testing (fake_hash)

pub capability Maker
  op get() -> fn(Int) -> internal Hashed

pub apply(make: fn(Int) -> internal Hashed) -> internal Hashed = make(1)

pub capability Hasher
  op hash(seed: Int) -> internal Hashed

pub handler leak() for Maker
  op get() = fake_hash

pub handler direct() for Hasher
  op hash(seed) = fake_hash(seed)

example "a testing function passed as a value"
  do apply(fake_hash)
  expect result == apply(fake_hash)
