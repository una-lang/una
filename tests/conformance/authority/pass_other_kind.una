-- test: if error pass needs the error kind of the function
-- spec: spec/06 §3
-- expect: error U3008 at 19:5
module pass_other_kind

kind StoreError = Timeout | Corrupted

kind LookupError = Missing | Unavailable

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError

pub lookup(key: Int) -> Option[Int]
  uses @store: Store[find]
  fails LookupError
=
  @store.find(key)
    if error pass
