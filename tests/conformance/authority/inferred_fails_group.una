-- test: functions that pass each other's failures first decide together: each takes its first failure after those passes, and each pass of the other kind is U3008
-- spec: spec/04 §5
-- expect: error U3008 at 14:5
-- expect: error U3008 at 20:5
module inferred_fails_group

kind A = | A1

kind B = | B1

f(n: Int) -> Int
=
  let x = g(n - 1)
    if error pass
  if x < 0 then fail A1 else x

g(n: Int) -> Int
=
  let y = f(n - 1)
    if error pass
  if y < 0 then fail B1 else y

pub run(n: Int) -> Int
  fails A
=
  f(n)
    if error pass
