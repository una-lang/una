-- test: a narrowed rebinding `with @x = @y[ops]` keeps the labels of the operations it keeps for an inferred callee, so returning the answer as `public` is U4001 in the callee (ADR 0094 rule 3)
-- spec: spec/05 §9
-- expect: error U4001 at src/m.una:10:32
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

owner_of(file: Text) -> Text = @files.owner(file)

pub refusal(file: Text) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service], role]
=
  let narrowed = owner_of(file) with @files = @service_files[owner]
  narrowed
