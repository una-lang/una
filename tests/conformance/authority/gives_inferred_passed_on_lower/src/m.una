-- test: an inferred function holds the labels its callers pass, so passing the binding on to a declared callee that reads the operation lower is U3022 there (ADR 0094 rule 3)
-- spec: spec/05 §4
-- expect: error U3022 at src/m.una:15:29
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

owner_seen(file: Text) -> Text
  uses @files: Files[owner]
=
  @files.owner(file)

relay(file: Text) -> Text = owner_seen(file)

pub refusal(file: Text) -> internal[Service] Text
  uses @files: Files[owner gives internal[Service]]
=
  relay(file)
