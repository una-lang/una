-- test: checked within the escape budget is accepted
-- spec: spec/06 §6
-- expect: tier0-ok
module app.parse

pub kind ParseError = Empty | TooLong

pub nonempty(raw: Text) -> Text
  fails ParseError
=
  checked(raw, raw.len > 0) else fail Empty

pub short(raw: Text) -> Text
  fails ParseError
=
  checked(raw, raw.len < 80) else fail TooLong
