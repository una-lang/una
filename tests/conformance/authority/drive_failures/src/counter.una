-- test: `step` and `on_stop` of a driven module declare no `fails`, since the host has no caller to give a failure to; `init` may fail (spec/26 §2, ADR 0116 rule 2)
-- spec: spec/26 §2
-- expect: error U3029 at src/counter.una:17:3
-- expect: error U3029 at src/counter.una:22:3
module counter

import std.drive (Tick)

pub kind Fault = | Bad

pub init() -> Int
  fails Fault
=
  0

pub step(edit count: Int, input: Tick) -> Unit
  fails Fault
=
  count = count + 1

pub on_stop(count: Int) -> Unit
  fails Fault
=
  unit
