-- test: a `uses` of `HttpServer` that no `serve` grant allows is U3012, as for every host capability (spec/31 §1, ADR 0123 rule 1)
-- spec: spec/31 §1
-- expect: error U3012 at src/srv.una:9:3
module srv

import std.host (HttpServer)

pub main() -> Unit
  uses @server: HttpServer[close]
=
  @server.close()
