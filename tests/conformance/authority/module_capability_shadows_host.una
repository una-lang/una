-- test: a module capability named like a host capability is not granted by the host grant (review control)
-- spec: spec/05 §7
-- grant: console
-- grant: clock
-- expect: error U3012 at 14:3
module module_capability_shadows_host

pub capability Clock
  op now() -> Int
    ensures result == 0

pub main() -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let t = @clock.now()
  let q = 100 / (t + 1)
  @console.print("q = {q}")
