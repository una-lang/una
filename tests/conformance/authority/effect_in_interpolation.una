-- test: effect inside interpolation (review control)
-- spec: spec/04 §4
-- expect: error U3013 at 16:9
module effect_in_interpolation

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

pub run() -> Text
  uses @store: Store[count]
=
  "n = {@store.count()}"
