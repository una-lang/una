-- test: `for ever`, and a call of a function that says `diverges`, are legal only in a function that says it, outside lambdas, `together` tasks, `on stop` blocks and the bodies of `for ever` loops (U3027) (spec/26 §5, ADR 0116 rules 8 to 10)
-- spec: spec/26 §5
-- expect: error U3027 at src/sites.una:20:3
-- expect: error U3027 at src/sites.una:24:19
-- expect: error U3027 at src/sites.una:28:25
-- expect: error U3027 at src/sites.una:35:13
-- expect: error U3027 at src/sites.una:43:5
-- expect: error U3027 at src/sites.una:45:5
module sites

spin() -> Unit
  diverges
=
  for ever
    stop
  unit

loops() -> Unit
=
  for ever
    stop
  unit

calls() -> Unit = spin()

lambdas() -> Int
=
  let f = fn(x: Int) -> spin_value(x)
  f(1)

tasks() -> Int
  diverges
=
  together
    let a = spin_value(1)
    let b = 2
  a + b

nested() -> Unit
  diverges
=
  for ever
    spin()
  on stop
    spin()
  unit

spin_value(x: Int) -> Int
  diverges
=
  let edit n = x
  for ever
    stop when n > 3
    n = n + 1
  n
