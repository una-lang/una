-- test: the right-hand sides of a `with` resolve outside it, so a narrowing of a handler that the same `with` installs names nothing in scope (ADR 0093 rule 4, spec/10 §6)
-- spec: spec/05 §4
-- expect: error U3001 at src/main.una:28:49
module main

capability Files
  op read(path: Text) -> Text
  op write(path: Text, data: Text) -> Unit

reader(path: Text) -> Text
  uses @files: Files[read]
=
  @files.read(path)

writer(path: Text) -> Unit
  uses @files: Files[read, write]
=
  let data = @files.read(path)
  @files.write(path, data: data)

handler memory() for Files
  op read(path) = path
  op write(path, data) = unit

pub show(path: Text) -> Text
  uses @user_files: Files[read]
=
  reader(path) with @store = memory(), @files = @store[read]
