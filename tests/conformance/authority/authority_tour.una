-- test: uses, attenuation, rebinding, handler instances, handlers with uses, failures and one effect per line check
-- spec: spec/05 §3, §4, §5
-- expect: tier0-ok
module authority_tour

pub kind StoreError = Timeout | Corrupted

pub kind LookupError = Missing | Unavailable(reason: Text)

pub capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op put(key: Int, value: Int) -> Unit
    fails StoreError

pub capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

pub handler rows(values: List[Int]) for Store
  op find(key) = values.at(index: key)
  op put(key, value) = unit

pub handler echo() for Log
  uses @out: Log[write]
  op write(line) = @out.write(line)
  op flush() = unit

pub lookup(key: Int) -> Int
  uses @store: Store[find]
  fails LookupError
=
  let value = @store.find(key)
    if error fail Unavailable(reason: "store")
    if none fail Missing
  value

pub note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub attenuated(key: Int) -> Int
  uses @store: Store
  uses @log: Log
  fails LookupError
=
  let value = lookup(key)
    if error pass
  note("found {value}")
  value

pub rebound(key: Int) -> Int
  uses @primary: Store[find]
  uses @journal: Log[write]
  fails LookupError
=
  let value = lookup(key) with @store = @primary
    if error pass
  note("found {value}") with @log = @journal
  value

pub installed(key: Int) -> Int
  uses @out: Log[write]
=
  let value = lookup(key) with @store = rows(values: [1, 2, 3])
    if error use 0
  note("found {value}") with @log = echo()
  value

pub attempted(key: Int) -> Bool
  uses @store: Store[find]
=
  let outcome = attempt @store.find(key)
  outcome.is_ok()

pub each(lines: List[Text], write: fn(Text) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  unit

pub notes(lines: List[Text]) -> Unit
  uses @log: Log[write]
=
  each(lines, write: fn(line) -> @log.write(line))
  each(lines, write: note)

pub branches(key: Int) -> Unit
  uses @log: Log
=
  when key
    is 0 -> @log.write("zero")
    else ->
      @log.write("other")
      @log.flush()
