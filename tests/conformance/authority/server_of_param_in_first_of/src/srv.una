-- test: `uses of` parameters called in the branches of `first of`, in a program that serves, are U3033 at each call (spec/31 §1, ADR 0123 rule 5)
-- spec: spec/31 §1
-- expect: error U3033 at src/srv.una:26:5
-- expect: error U3033 at src/srv.una:27:5
module srv

import std.host (Exchange, HttpServer, Reply)

send(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: exchange.right, reply: Reply(status: 204, headers: [], body: ""))
    if error use unit

answered(exchange: internal Exchange) -> Int
  uses @server: HttpServer[reply]
=
  send(exchange)
  1

race(f: fn() -> Int, g: fn() -> Int) -> Unit
  uses of f
  uses of g
=
  let won = first of
    f()
    g()
  unit

answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  race(f: fn() -> answered(exchange), g: fn() -> answered(exchange))
