-- test: private helper with inferred effects passed as `map` argument (review control)
-- spec: spec/05 §9
-- expect: error U3001 at 13:3
-- expect: error U3003 at 19:16
module inferred_fn_value_into_map

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

helper(x: Int) -> Int
=
  @log.write("x")
  x

pub run(xs: List[Int]) -> List[Int]
  uses @log: Log[write]
=
  xs.map(each: helper)
