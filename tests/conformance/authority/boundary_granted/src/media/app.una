-- test: a call into a boundary module is granted with `with`, within the ceiling, and a callee that needs nothing needs no grant (ADR 0093 rules 3 and 5)
-- spec: spec/05 §4
-- expect: ok
module media.app

import media.resize (notify, shrink, size_of)
import media.store (Files, Net)

pub preview(path: Text) -> Text
  uses @files: Files[read, write]
=
  shrink(path) with @files = @files[read]

pub peek(path: Text) -> Text
  uses @user_files: Files[read]
=
  shrink(path) with @files = @user_files

pub sized(path: Text) -> Int = size_of(path)
