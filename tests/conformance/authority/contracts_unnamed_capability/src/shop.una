-- test: a binding of a capability that the lock does not name at all is U3023 (ADR 0092 rule 8, as amended)
-- spec: spec/05 §3
-- expect: error U3023 at src/shop.una:16:3
module shop

pub capability Catalog
  op price(sku: Int) -> Int
  op set_price(sku: Int, cents: Int) -> Unit
  op journal(n: Int) -> Unit

pub capability Log
  op write(n: Int) -> Unit

pub update(sku: Int, cents: Int, dry_run: Bool) -> Unit
  uses @catalog: Catalog[price, set_price where not dry_run, journal where not dry_run]
  uses @log: Log[write]
=
  if not dry_run
    @catalog.set_price(sku, cents)
  unit
