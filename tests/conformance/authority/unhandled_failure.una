-- test: a statement that can fail needs an if error clause
-- spec: spec/06 §3
-- expect: error U3007 at 15:15
module unhandled_failure

kind StoreError = Timeout | Corrupted

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError

pub lookup(key: Int) -> Unit
  uses @store: Store[find]
=
  let found = @store.find(key)
  unit
