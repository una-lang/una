-- test: the `uses` of `init`, `step` and `on_stop` are checked against the grants, as those of `main` are (spec/26 §2, ADR 0116 rule 2)
-- spec: spec/26 §2
-- expect: error U3012 at src/counter.una:11:3
module counter

import std.drive (Tick)

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
  uses @console: Console[print]
=
  count = count + 1
  @console.print("{count}")
