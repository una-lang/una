-- test: `elapse` of `std.testing` is called only in tests and in handlers that only tests install, and is not a value (U3015, spec/14 §4, spec/26 §6)
-- spec: spec/26 §6
-- expect: error U3015 at src/clocked.una:11:3
-- expect: error U3015 at src/clocked.una:14:11
module clocked

import std.testing (elapse)
import std.time (millisecond)

pub wait() -> Unit =
  elapse(5 * millisecond)

pub hold() -> Int =
  let f = elapse
  1
