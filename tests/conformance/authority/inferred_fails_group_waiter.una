-- test: a function that waits for a group is not part of it: it takes the kind the group gives, so its own later variant of another kind is U3009
-- spec: spec/04 §5
-- expect: error U3009 at 14:22
module inferred_fails_group_waiter

kind A = | A1

kind B = | B1

x(n: Int) -> Int
=
  let v = g(n)
    if error pass
  if v < 0 then fail A1 else v

g(n: Int) -> Int
=
  h(n - 1)
    if error pass

h(n: Int) -> Int
=
  let w = g(n - 1)
    if error pass
  if w < 0 then fail B1 else w

pub run(n: Int) -> Int
  fails B
=
  x(n)
    if error pass
