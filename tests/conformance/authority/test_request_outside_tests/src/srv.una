-- test: `test_request` and `test_exchange` of `std.testing` are called only in tests and in handlers that only tests install, and are not values (U3015, spec/14 §4, ADR 0123 rule 21)
-- spec: spec/14 §4
-- expect: error U3015 at src/srv.una:14:3
-- expect: error U3015 at src/srv.una:17:44
-- expect: error U3015 at src/srv.una:21:11
module srv

import std.host (Exchange, Method, Request)
import std.testing (TestRequestError, test_exchange, test_request)

pub made() -> Request
  fails TestRequestError
=
  test_request(method: Get, target: "/", body: "")
    if error pass

pub paired(request: Request) -> Exchange = test_exchange(request)

pub held() -> Int
=
  let f = test_exchange
  1
