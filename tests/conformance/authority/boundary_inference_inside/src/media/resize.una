module media.resize

import media.cache (stamp)
import media.store (Files)

pub shrink(path: Text) -> Text
  uses @files: Files[read]
=
  @files.read(path)

pub size_of(path: Text) -> Int = 1

pub notify(path: Text, done: fn(Text) -> Unit) -> Unit
  uses of done
=
  done(path)

measure(n: Int) -> Unit = stamp(n)

pub sized_stamp(n: Int) -> Unit
  uses @files: Files[write]
=
  measure(n)
