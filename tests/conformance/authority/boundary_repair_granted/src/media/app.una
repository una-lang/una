-- test: ADR 0093 rule 6: the program that the narrowed grants of U3020's first repairs leave builds: each grant lies within the ceiling, from a binding of the caller's own name or another
-- spec: spec/13 §3
-- expect: ok
module media.app

import media.resize (share, shrink)
import media.store (Files, Net)

pub preview(path: Text) -> Text
  uses @files: Files[read, write]
=
  shrink(path) with @files = @files[read]

pub peek(path: Text) -> Text
  uses @user_files: Files[read, write]
=
  shrink(path) with @files = @user_files[read]

pub send(path: Text) -> Unit
  uses @files: Files[read, write]
  uses @net: Net[post]
=
  share(path) with @files = @files[read], @net = @net[post]
