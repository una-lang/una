-- test: an inferred function reads a labeled operation at the join of the labels its callers pass, so each caller passes, the one with the lower label too (ADR 0094 rule 3)
-- spec: spec/05 §9
-- expect: ok
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

owner_of(file: Text) -> internal[Billing, Service] Text = @files.owner(file)

pub by_service(file: Text) -> internal[Billing, Service] Text
  uses @files: Files[owner gives internal[Service]]
=
  owner_of(file)

pub by_billing(file: Text) -> internal[Billing, Service] Text
  uses @files: Files[owner gives internal[Billing]]
=
  owner_of(file)

pub unlabeled(file: Text) -> internal[Billing, Service] Text
  uses @files: Files[owner]
=
  owner_of(file)
