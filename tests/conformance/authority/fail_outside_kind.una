-- test: fail raises a variant of the declared error kind
-- spec: spec/06 §2
-- expect: error U3009 at 13:24
module fail_outside_kind

kind StoreError = Timeout | Corrupted

kind LookupError = Missing | Unavailable

pub check(key: Int) -> Int
  fails LookupError
=
  if key < 0 then fail Timeout else key
