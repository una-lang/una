-- test: a callee with an unhandled failure (U3007) is poisoned, so a clause on its call is not U3025 (ADR 0100 rule 3, shape a)
-- spec: spec/06 §3
-- expect: error U3007 at src/main.una:15:11
module main

kind E = | Bad

risky(n: Int) -> Int
  fails E
=
  if n < 0 then fail Bad else n

c(n: Int) -> Int
=
  let x = risky(n)
  x

pub user(n: Int) -> Int
  fails E
=
  let y = c(n)
    if error use 0
  y
