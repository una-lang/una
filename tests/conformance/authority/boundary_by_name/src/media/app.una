-- test: a call into a boundary module takes no capability by name from the caller's context: U3020 at the call (ADR 0093 rule 3)
-- spec: spec/05 §4
-- expect: error U3020 at src/media/app.una:12:3
module media.app

import media.resize (notify, shrink, size_of)
import media.store (Files, Net)

pub preview(path: Text) -> Text
  uses @files: Files[read]
=
  shrink(path)
