-- test: a function whose `uses` label an operation is not used as a value, since a function type carries no `gives` (ADR 0094 rule 1)
-- spec: spec/05 §3
-- expect: error U3006 at src/m.una:16:11
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

refusal(file: Text) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service]]
=
  @service_files.owner(file)

pub pick() -> fn(Text) -> internal[Service] Text uses @service_files: Files[owner]
=
  let f = refusal
  f
