-- test: a function with effects is a value only as a call argument
-- spec: spec/05 §6
-- expect: error U3006 at 17:14
module function_value_escapes

capability Log
  op write(line: Text) -> Unit

pub note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub run() -> Unit
  uses @log: Log[write]
=
  let keep = note
  unit
