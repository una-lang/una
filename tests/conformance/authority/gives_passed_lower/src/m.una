-- test: a binding whose operation gives a label is not passed to a callee that reads the operation lower (ADR 0094 rule 3)
-- spec: spec/05 §4
-- expect: error U3022 at src/m.una:18:14
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

owner_seen(file: Text) -> Text
  uses @files: Files[owner]
=
  @files.owner(file)

pub refusal(file: Text) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service]]
=
  let seen = owner_seen(file) with @files = @service_files
  seen
