-- test: an unhandled failure is reported once at its site, wherever the site is: a loop body, a nested loop, a lambda in a loop, a `when` arm, a handler operation, a private function that omits `fails`, `within`, and a function's whole body (#932)
-- spec: spec/06 §3
-- expect: error U3007 at src/once.una:28:13
-- expect: error U3007 at src/once.una:37:15
-- expect: error U3007 at src/once.una:45:27
-- expect: error U3007 at src/once.una:53:15
-- expect: error U3007 at src/once.una:61:17
-- expect: error U3007 at src/once.una:67:13
-- expect: error U3007 at src/once.una:81:11
-- expect: error U3007 at src/once.una:84:33
module once

import std.time (millisecond)

kind Boom = | Exploded

risky(n: Int) -> Int
  fails Boom
=
  if n > 3
    fail Exploded
  n

pub in_loop(xs: List[Int]) -> Int
=
  let edit s = 0
  for x in xs
    let y = risky(x)
    s = s + y
  s

pub in_nested_loop(n: Int) -> Int
=
  let edit s = 0
  for i in 0..<n
    for j in 0..<i
      let y = risky(j)
      s = s + y
  s

pub in_lambda_in_loop(xs: List[Int]) -> Int
=
  let edit s = 0
  for x in xs
    let g = fn(y: Int) -> risky(y)
    s = s + g(x)
  s

pub in_arm(n: Option[Int]) -> Int
=
  when n
    is Some(v) ->
      let y = risky(v)
      y
    is None -> 0

capability Tally
  op count(n: Int) -> Int

handler tally() for Tally
  op count(n) = risky(n)

inferred(xs: List[Int]) -> Int
=
  let edit s = 0
  for x in xs
    let y = risky(x)
    s = s + y
  s

pub calls_inferred(xs: List[Int]) -> Int
=
  let s = inferred(xs)
    if error use 0
  s

next(n: Int) -> Int = n + 1

pub in_within(n: Int) -> Int
=
  let x = next(n) within 10 * millisecond
  x

pub whole_body(n: Int) -> Int = risky(n)
