-- test: capability operation needs a binding in scope
-- spec: spec/05 §3
-- expect: error U3001 at 18:3
module cap_not_in_scope

kind StoreError = Timeout | Corrupted

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError

capability Log
  op write(line: Text) -> Unit

pub lookup(key: Int) -> Option[Int]
  uses @log: Log[write]
=
  @store.find(key)
    if error use None
