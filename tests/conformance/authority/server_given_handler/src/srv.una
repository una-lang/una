-- test: a test installs a handler of `HttpServer` with `given`, as for every capability; a handler whose `next` fails `Closed` serves a loop that ends (spec/31 §1, ADR 0123 rule 21)
-- spec: spec/31 §1
-- expect: test-pass
module srv

import std.host (Exchange, HttpServer, Reply, ReplyRight, ServeError)

--- Answers one request, or tells why it got none.
pub serve_one() -> Bool
  uses @server: HttpServer[next, reply]
=
  let next = attempt @server.next()
  when next
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 204, headers: [], body: ""))
        if error use unit
      true
    is Err(failure) -> false

--- A server that has closed.
handler closed() for HttpServer
  op next() = fail Closed
  op reply(to, reply) = unit
  op close() = unit

test "a closed server delivers nothing"
  given @server = closed()
  do serve_one()
  expect result == false
