-- test: a call needs the operations of the callee
-- spec: spec/05 §4
-- expect: error U3002 at 18:3
module callee_needs_operations

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

pub note(line: Text) -> Unit
  uses @log: Log[write, flush]
=
  @log.write(line)

pub report() -> Unit
  uses @log: Log[write]
=
  note("done")
