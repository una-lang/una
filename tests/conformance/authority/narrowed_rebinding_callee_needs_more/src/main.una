-- test: a narrowed binding lacks the operations it does not list, so a callee that needs one of them is U3002 at the call (ADR 0093 rule 4)
-- spec: spec/05 §4
-- expect: error U3002 at src/main.una:24:3
module main

capability Files
  op read(path: Text) -> Text
  op write(path: Text, data: Text) -> Unit

reader(path: Text) -> Text
  uses @files: Files[read]
=
  @files.read(path)

writer(path: Text) -> Unit
  uses @files: Files[read, write]
=
  let data = @files.read(path)
  @files.write(path, data: data)

pub save(path: Text) -> Unit
  uses @user_files: Files[read, write]
=
  writer(path) with @files = @user_files[read]
