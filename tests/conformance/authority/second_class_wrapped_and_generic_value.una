-- test: U3006 for wrapped effectful functions, and U3016 at the effectful argument of a generic function value
-- spec: spec/05 §6
-- expect: error U3006 at 30:14
-- expect: error U3006 at 35:15
-- expect: error U3016 at 42:13
-- expect: error U3006 at 48:35
-- expect: error U3006 at 54:35
module a06_ok_wrapped

kind Boom = | Exploded

capability Log
  op write(line: Text) -> Unit

id[T](x: T) -> T = x

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

boom(x: Int) -> Int
  fails Boom
=
  fail Exploded

pub ok_wrapped() -> Int
  uses @log: Log[write]
=
  let r = Ok(note)
  1

pub err_wrapped() -> Int
=
  let r = Err(boom)
  1

pub value_of_generic() -> Unit
  uses @log: Log[write]
=
  let i = id
  let g = i(note)
  g("x")

pub mapped() -> Int
  uses @log: Log[write]
=
  let gs = [1].map(each: fn(x) -> note)
  gs.len

pub mapped_param(f: fn(Text) -> Unit uses @log: Log[write]) -> Int
  uses @log: Log[write]
=
  let gs = [1].map(each: fn(x) -> f)
  gs.len
