-- test: effect nested in an `attempt` argument (review control)
-- spec: spec/04 §4
-- expect: error U3013 at 21:18
module effect_in_attempt_arg

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

double(n: Int) -> Int
  fails StoreError
=
  n * 2

pub run() -> Result[Int, StoreError]
  uses @store: Store[count]
=
  attempt double(@store.count())
