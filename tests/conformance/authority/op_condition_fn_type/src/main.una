-- test: a function type's `uses` keep the names-only form, so `where` there is a parse error, also in edition 0.3 (ADR 0092 rule 1, spec/02 §3)
-- spec: spec/02 §3
-- expect: error U0101 at src/main.una:9:51
module main

pub capability Log
  op write(n: Int) -> Unit

pub apply(f: fn(Int) -> Unit uses @log: Log[write where true], n: Int) -> Unit
  uses @log: Log[write]
=
  f(n)
