-- test: the locked binding renamed is a binding the lock does not name: U3023 (ADR 0092 rule 8, as amended)
-- spec: spec/05 §3
-- expect: error U3023 at src/shop.una:15:3
module shop

pub capability Catalog
  op price(sku: Int) -> Int
  op set_price(sku: Int, cents: Int) -> Unit
  op journal(n: Int) -> Unit

pub capability Log
  op write(n: Int) -> Unit

pub update(sku: Int, cents: Int, dry_run: Bool) -> Unit
  uses @shop: Catalog[price, set_price where not dry_run, journal where not dry_run]
=
  if not dry_run
    @shop.set_price(sku, cents)
  unit
