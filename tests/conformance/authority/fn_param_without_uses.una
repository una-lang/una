-- test: private function calls an effectful function parameter with no declared uses (inferred) (review control)
-- spec: spec/05 §9
-- expect: ok
module fn_param_without_uses

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

each(line: Text, write: fn(Text) -> Unit uses @log: Log[write]) -> Unit = write(line)

pub run() -> Unit
  uses @log: Log[write]
=
  each("x", write: fn(t) -> @log.write(t))
