-- test: effect as a `when` scrutinee (review control)
-- spec: spec/04 §4
-- expect: error U3013 at 16:8
module effect_in_when_scrutinee

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

pub run() -> Int
  uses @store: Store[count]
=
  when @store.count()
    is 0 -> 0
    else -> 1
