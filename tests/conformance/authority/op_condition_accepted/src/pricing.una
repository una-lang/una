-- test: an operation of a function's or a handler's `uses` may carry `where` and a condition over the parameters, in the refinement language (ADR 0092 rule 1, spec/05 §3)
-- spec: spec/05 §3
-- expect: ok
module pricing

pub capability Catalog
  op price(sku: Int) -> Int
  op set_price(sku: Int, cents: Int) -> Unit
  op journal(note: Text) -> Unit

pub update(sku: Int, cents: Int, dry_run: Bool, limit: Int) -> Int
  uses @catalog: Catalog[price, set_price where not dry_run and cents <= limit, journal where not dry_run]
=
  if not dry_run and cents <= limit
    @catalog.set_price(sku, cents: cents)
  @catalog.price(sku)

handler quiet(dry_run: Bool) for Catalog
  uses @inner: Catalog[price, set_price where not dry_run, journal where not dry_run]
  op price(sku) = @inner.price(sku)
  op set_price(sku, cents) = unit
  op journal(note) = unit
