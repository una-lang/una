-- test: a call needs every capability of the callee under the same name
-- spec: spec/05 §4
-- expect: error U3001 at 17:3
module callee_needs_capability

capability Log
  op write(line: Text) -> Unit

pub note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub report() -> Unit
  uses @journal: Log[write]
=
  note("done")
