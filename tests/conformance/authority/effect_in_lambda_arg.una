-- test: effect nested in a lambda body expression (review control)
-- spec: spec/04 §4
-- expect: error U3013 at 21:29
module effect_in_lambda_arg

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

each(xs: List[Int], f: fn(Int) -> Int uses @store: Store[count]) -> Int
  uses @store: Store[count]
=
  0

pub run() -> Int
  uses @store: Store[count]
=
  each([1], f: fn(x) -> x + @store.count())
