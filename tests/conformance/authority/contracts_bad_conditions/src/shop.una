-- test: a lock condition that is not a `Bool` of the refinement language over the function's parameters is U7002 at its entry, whatever makes it so: an unknown function or variant, a predicate the module does not import, `result`, `it`, an operation (ADR 0092 rule 8)
-- spec: spec/05 §3
-- expect: error U7002 at una.toml:9:3
-- expect: error U7002 at una.toml:10:3
-- expect: error U7002 at una.toml:11:3
-- expect: error U7002 at una.toml:12:3
-- expect: error U7002 at una.toml:13:3
-- expect: error U7002 at una.toml:14:3
module shop

pub capability Catalog
  op price(sku: Int) -> Int
  op set_price(sku: Int, cents: Int) -> Unit
  op journal(n: Int) -> Unit

pub capability Log
  op write(n: Int) -> Unit

pub update(sku: Int, cents: Int, dry_run: Bool) -> Unit
  uses @catalog: Catalog[price, set_price where not dry_run, journal where not dry_run]
=
  if not dry_run
    @catalog.set_price(sku, cents)
  unit
