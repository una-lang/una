-- test: `given` handler needs a capability bound by a later `given` (review control)
-- spec: spec/05 §9
-- expect: error U3001 at 25:18
module given_order

capability Log
  op write(line: Text) -> Unit

capability Store
  op count() -> Int

handler quiet() for Log
  op write(line) = unit

handler logged(n: Int) for Store
  uses @log: Log[write]
  op count() = n

pub counted() -> Int
  uses @store: Store[count]
=
  @store.count()

example "a given needs a later given"
  given @store = logged(n: 1)
  given @log = quiet()
  do counted()
  expect result == 1
