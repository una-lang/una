-- test: with installs a handler for the capability the callee needs
-- spec: spec/05 §4
-- expect: error U3010 at 22:28
module handler_wrong_capability

capability Log
  op write(line: Text) -> Unit

capability Audit
  op record(line: Text) -> Unit

handler silent() for Audit
  op record(line) = unit

pub note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub report() -> Unit
=
  note("done") with @log = silent()
