-- test: effect in an `if` condition (review control)
-- spec: spec/04 §4
-- expect: error U3013 at 16:6
module effect_in_if_condition

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

pub run() -> Int
  uses @store: Store[count]
=
  if @store.count() > 0
    1
  else
    0
