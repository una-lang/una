-- test: U3002 at an attenuated binding ranks first the repair that uses another binding which permits the operation (issue #69, UI-005)
-- spec: spec/05 §9
-- expect: error U3002 at 14:21
module attenuated_binding_repair

pub capability Payments
  op charged(amount: Int) -> Unit
  op refund(amount: Int) -> Unit

pub settle(amount: Int) -> Unit
  uses @service_payments: Payments[charged]
  uses @agent_payments: Payments[refund]
=
  @service_payments.refund(amount)
