-- test: in the `serve` form the host owns every exchange, so `on_stop` cannot use `HttpServer` (spec/31 §7, ADR 0123 rule 16, decision S6-D3)
-- spec: spec/31 §7
-- expect: error U3033 at src/srv.una:15:3
module srv

import std.host (HttpServer, Reply, Request)

--- Answers every request with 200.
pub handle(request: internal Request) -> internal Reply = Reply(status: 200, headers: [],
  body: "ok"
)

--- Takes a request after the drain, which the host-driven form does not allow.
pub on_stop() -> Unit
  uses @server: HttpServer[next]
=
  let next = attempt @server.next()
  unit
