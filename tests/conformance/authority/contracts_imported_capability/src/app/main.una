-- test: a capability is the declaration its name resolves to: a lock that names an imported capability locks it (ADR 0092 rule 8, as amended)
-- spec: spec/05 §3
-- expect: ok
module app.main

import app.caps (Catalog)

pub update(sku: Int, cents: Int, dry_run: Bool) -> Unit
  uses @catalog: Catalog[price, set_price where not dry_run, journal where not dry_run]
=
  if not dry_run
    @catalog.set_price(sku, cents)
  unit
