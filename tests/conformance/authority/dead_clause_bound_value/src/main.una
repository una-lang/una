-- test: a call of a local bound to a poisoned function is not judged dead (ADR 0100 rule 4)
-- spec: spec/06 §3
-- expect: error U3007 at src/main.una:15:11
module main

kind E = | Bad

risky(n: Int) -> Int
  fails E
=
  if n < 0 then fail Bad else n

c(n: Int) -> Int
=
  let x = risky(n)
  x

pub user(n: Int) -> Int
  fails E
=
  let f = c
  let y = f(n)
    if error use 0
  y
