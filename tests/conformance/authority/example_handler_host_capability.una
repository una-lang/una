-- test: an example cannot install a handler that uses a host capability (review control)
-- spec: spec/08 §2
-- expect: error U3014 at 19:16
module example_handler_host_capability

pub capability Log
  op write(line: Text) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(line) = @console.print(line)

pub greet() -> Unit
  uses @log: Log[write]
=
  @log.write("hello")

example "the handler reaches the console"
  given @log = to_console()
  do greet()
  expect result == unit
