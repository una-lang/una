-- test: in the `serve` form the host owns every exchange, so `handle` cannot use `HttpServer` (spec/31 §7, ADR 0123 rule 16, decision S6-D3)
-- spec: spec/31 §7
-- expect: error U3033 at src/srv.una:10:3
module srv

import std.host (HttpServer, Reply, Request)

--- Closes the server from a request, which the host-driven form does not allow.
pub handle(request: internal Request) -> internal Reply
  uses @server: HttpServer[close]
=
  @server.close()
  Reply(status: 200, headers: [], body: "ok")
