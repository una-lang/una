-- test: rebinding to a capability with fewer operations (review control)
-- spec: spec/05 §9
-- expect: error U3002 at 18:3
module with_fewer_ops

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

note(line: Text) -> Unit
  uses @log: Log[write, flush]
=
  @log.write(line)

pub run() -> Unit
  uses @journal: Log[write]
=
  note("x") with @log = @journal
