-- test: authority matrix for a kind alias of an effectful function type: operations listed or omitted, a different capability, and the caller's `uses` accounting; every cell gives the same diagnostics as its twin `alias_authority_ops_inline` (#15)
-- spec: spec/05 §3, §4, §6
-- expect: error U3002 at 41:3
-- expect: error U3002 at 51:29
-- expect: error U3002 at 62:3
-- expect: error U3001 at 73:3
-- expect: error U3001 at 79:24
-- expect: error U3003 at 85:15
-- expect: error U3003 at 91:3
-- expect: error U3006 at 100:11
-- expect: error U3003 at 101:3
module alias_authority_ops_alias

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

capability Audit
  op note(line: Text) -> Unit

kind Writer = fn(Text) -> Unit uses @log: Log[write]

kind AnyLog = fn(Text) -> Unit uses @log: Log

kind Auditor = fn(Text) -> Unit uses @audit: Audit

-- Operations listed: a caller holding them, or more, may call; one holding others may not.
pub listed_held(w: Writer) -> Unit
  uses @log: Log[write]
=
  w("a")

pub listed_more(w: Writer) -> Unit
  uses @log: Log
=
  w("b")

pub listed_other_op(w: Writer) -> Unit
  uses @log: Log[flush]
=
  w("c")

pub listed_lambda_ok() -> Unit
  uses @log: Log[write]
=
  listed_held(fn(t) -> @log.write(t))

pub listed_lambda_exceeds() -> Unit
  uses @log: Log
=
  listed_held(fn(t) -> @log.flush())

-- No operation list: the type needs every operation of `Log`.
pub all_held(w: AnyLog) -> Unit
  uses @log: Log
=
  w("d")

pub all_subset(w: AnyLog) -> Unit
  uses @log: Log[write]
=
  w("e")

pub all_lambda_flush() -> Unit
  uses @log: Log
=
  all_held(fn(t) -> @log.flush())

-- A different capability: holding `Audit` does not stand for `Log`, and an `Audit` function is not a `Log` one.
pub other_cap_held(w: Writer) -> Unit
  uses @audit: Audit
=
  w("f")

pub other_cap_lambda() -> Unit
  uses @log: Log[write]
  uses @audit: Audit
=
  listed_held(fn(t) -> @audit.note(t))

pub other_cap_param(a: Auditor) -> Unit
  uses @log: Log[write]
  uses @audit: Audit
=
  listed_held(a)

-- Accounting: a public function declares what its function parameter performs; a private one infers it.
pub undeclared(w: Writer) -> Unit
=
  let line = "g"
  w(line)

relay(w: Writer) -> Unit
=
  let line = "h"
  w(line)

pub through_relay_undeclared(w: Writer) -> Unit
=
  let f = w
  relay(f)

pub through_relay_declared(w: Writer) -> Unit
  uses @log: Log[write]
=
  relay(w)
