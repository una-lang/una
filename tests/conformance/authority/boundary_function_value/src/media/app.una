-- test: a function of a boundary used as a value outside it is a call into the boundary at the reference: U3020 without a grant, accepted with one (ADR 0093 rule 3)
-- spec: spec/05 §4
-- expect: error U3020 at src/media/app.una:17:18
module media.app

import media.resize (notify, shrink, size_of)
import media.store (Files, Net)

apply(path: Text, f: fn(Text) -> Text uses @files: Files[read]) -> Text
  uses @files: Files[read]
=
  f(path)

pub by_name(path: Text) -> Text
  uses @files: Files[read]
=
  apply(path, f: shrink)

pub granted(path: Text) -> Text
  uses @files: Files[read]
=
  apply(path, f: shrink) with @files = @files[read]
