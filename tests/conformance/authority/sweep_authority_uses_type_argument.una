-- test: an effectful function type never instantiates List, Option, Result or a user kind, written or inferred, so their variance for `uses` is rejected by construction (label sweep)
-- spec: spec/05 §6
-- expect: error U3016 at 21:21
-- expect: error U3016 at 23:24
-- expect: error U3016 at 25:24
-- expect: error U3016 at 27:18
-- expect: error U3006 at 32:13
module sweep_authority_uses_type_argument

capability Log
  op write(line: Text) -> Unit

kind Box[T]
  value: T

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub listed(xs: List[fn(Text) -> Unit uses @log: Log[write]]) -> Int = xs.len

pub optional(o: Option[fn(Text) -> Unit uses @log: Log[write]]) -> Int = 0

pub resulted(r: Result[fn(Text) -> Unit uses @log: Log[write], Int]) -> Int = 0

pub boxed(b: Box[fn(Text) -> Unit uses @log: Log[write]]) -> Int = 0

pub inferred() -> Int
  uses @log: Log[write]
=
  let xs = [note]
  xs.len
