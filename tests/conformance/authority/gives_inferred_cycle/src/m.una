-- test: inferred functions that call each other read a labeled operation at the join of the labels their outside callers pass, so returning the answer as `public` in the cycle is U4001 (ADR 0094 rule 3)
-- spec: spec/05 §9
-- expect: error U4001 at src/m.una:17:5
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

ping(file: Text, n: Int) -> Text = pong(file, n: n)

pong(file: Text, n: Int) -> Text
=
  if n > 0
    ping(file, n: n - 1)
  else
    @files.owner(file)

pub refusal(file: Text) -> internal[Service] Text
  uses @files: Files[owner gives internal[Service]]
=
  ping(file, n: 3)
