-- test: U3025 and U3026 never suppress each other: a package with one of each reports both (ADR 0100 rule 4)
-- spec: spec/06 §3
-- expect: error U3025 at src/main.una:12:5
-- expect: error U3026 at src/main.una:15:42
module main

double(n: Int) -> Int = n * 2

pub plus(n: Int) -> Int
=
  let x = double(n)
    if error use 0
  x

pub tried(n: Int) -> Result[Int, Text] = attempt double(n)
