-- test: a capability reference used to perform its operations, or passed on as a capability, is accepted; as a value it is U3005 (positive twin, #11)
-- spec: spec/05 §6
-- expect: ok
module cap_reference_ok

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write("note: {line}")

pub relay(line: Text) -> Unit
  uses @log: Log[write]
=
  note(line)
