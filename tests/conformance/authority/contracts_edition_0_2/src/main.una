-- test: in edition 0.2, `[contracts]` is the unknown table it always was; edition 0.3 reads the lock, which this header satisfies, and its erasure twin is contracts_edition_0_2_erased (spec/13 §7, ADR 0092 rule 8)
-- spec: spec/13 §7
-- expect: error U7002 at una.toml:6:2
module main

pub capability Catalog
  op price(sku: Int) -> Int

pub update(sku: Int) -> Int
  uses @catalog: Catalog[price]
=
  @catalog.price(sku)
