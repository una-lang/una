-- test: a handler granted into a boundary counts with its own `uses`: one without `uses` is within any ceiling, and one that posts exceeds a ceiling without `Net` (ADR 0093 rule 5)
-- spec: spec/05 §4
-- expect: error U3021 at src/media/app.una:25:3
module media.app

import media.resize (notify, shrink, size_of)
import media.store (Files, Net)

handler memory() for Files
  op read(path) = path
  op write(path, data) = unit

handler posting() for Files
  uses @net: Net[post]
  op read(path) = path
  op write(path, data) = @net.post(data)

pub fresh(path: Text) -> Text
=
  shrink(path) with @files = memory()

pub sent(path: Text) -> Text
  uses @net: Net[post]
=
  shrink(path) with @files = posting()
