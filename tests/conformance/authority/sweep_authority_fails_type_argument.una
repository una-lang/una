-- test: a failing function type never instantiates List, Option, Result or a user kind, written or inferred, so their variance for `fails` is rejected by construction (label sweep)
-- spec: spec/05 §6
-- expect: error U3016 at 20:21
-- expect: error U3016 at 22:24
-- expect: error U3016 at 24:29
-- expect: error U3016 at 26:18
-- expect: error U3006 at 30:22
module sweep_authority_fails_type_argument

kind Boom = | Exploded

kind Box[T]
  value: T

boom(x: Int) -> Int
  fails Boom
=
  fail Exploded

pub listed(xs: List[fn(Int) -> Int fails Boom]) -> Int = xs.len

pub optional(o: Option[fn(Int) -> Int fails Boom]) -> Int = 0

pub resulted(r: Result[Int, fn(Int) -> Int fails Boom]) -> Int = 0

pub boxed(b: Box[fn(Int) -> Int fails Boom]) -> Int = 0

pub inferred() -> Int
=
  let b = Box(value: boom)
  0
