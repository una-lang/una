-- test: editions 0.1 and 0.2 accept an `if error` clause on an expression that cannot fail (ADR 0100 rule 6)
-- spec: spec/06 §3
-- expect: ok
module main

kind LookupError = Missing | Unavailable

capability Log
  op write(line: Text) -> Unit

double(n: Int) -> Int = n * 2

risky(n: Int) -> Int
  fails LookupError
=
  if n < 0 then fail Missing else n

pub next(n: Int) -> Int
  fails LookupError
=
  let x = n + 1
    if error fail Unavailable
  let y = double(x)
    if error use 0
  y

pub logged(n: Int) -> Int
  uses @log: Log[write]
=
  @log.write(line: "next")
    if error pass
  n

pub tried(n: Int) -> Bool
=
  let r = attempt risky(n)
    if error use Ok(0)
  r.is_ok()
