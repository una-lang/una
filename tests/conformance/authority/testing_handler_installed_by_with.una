-- test: a handler that uses std.testing may be installed by given lines only; a with binding of it is U3015 (R-017)
-- spec: spec/14 §4
-- expect: error U3015 at 21:26
module testing_handler_installed_by_with

import std.testing (fake_hash)

pub capability Hasher
  op hash(seed: Int) -> internal Hashed

pub handler fake() for Hasher
  op hash(seed) = fake_hash(seed)

pub digest(seed: Int) -> internal Hashed
  uses @hasher: Hasher[hash]
=
  @hasher.hash(seed)

pub main() -> Unit
=
  let d = digest(7) with @hasher = fake()
  unit

example "the fake handler hashes equal seeds equally"
  given @hasher = fake()
  do digest(1)
  expect result == fake_hash(1)
