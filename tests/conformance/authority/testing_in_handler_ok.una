-- test: a std.testing function called inside a handler operation is accepted; stored or called outside a handler or example it is U3015 (positive twin, #11)
-- spec: spec/14 §4
-- expect: ok
module testing_in_handler_ok

import std.testing (fake_hash)

pub capability Keys2
  op mk(seed: Int) -> internal Hashed

pub handler fake() for Keys2
  op mk(seed) = fake_hash(seed)
