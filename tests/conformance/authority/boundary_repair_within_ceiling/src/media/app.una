-- test: ADR 0093 rule 6: a U3020 whose requirement lies within the ceiling, from a caller that holds a binding permitting it, ranks the grant narrowed to what the callee declares first; with an edit at a statement or a `let` whose whole expression is the call
-- spec: spec/13 §3
-- expect: error U3020 at src/media/app.una:14:3
-- expect: error U3020 at src/media/app.una:19:3
-- expect: error U3020 at src/media/app.una:24:15
module media.app

import media.resize (shrink)
import media.store (Files)

pub preview(path: Text) -> Text
  uses @files: Files[read, write]
=
  shrink(path)

pub peek(path: Text) -> Text
  uses @user_files: Files[read, write]
=
  shrink(path)

pub bound(path: Text) -> Text
  uses @files: Files[read]
=
  let small = shrink(path)
  small
