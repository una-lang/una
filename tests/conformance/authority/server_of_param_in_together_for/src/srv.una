-- test: a `uses of` parameter called in the body of `together for`, in a program that serves, is U3033 at the call (spec/31 §1, ADR 0123 rule 5)
-- spec: spec/31 §1
-- expect: error U3033 at src/srv.una:18:5
module srv

import std.host (Exchange, HttpServer, Reply)

send(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: exchange.right, reply: Reply(status: 204, headers: [], body: ""))
    if error use unit

run_each(f: fn() -> Unit) -> Unit
  uses of f
=
  let done = together for i in [1, 2]
    f()
  unit

answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  run_each(f: fn() -> send(exchange))
