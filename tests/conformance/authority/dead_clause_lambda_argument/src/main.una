-- test: a call given a lambda whose body has an unhandled failure is not judged dead (ADR 0100 rule 4)
-- spec: spec/06 §3
-- expect: error U3007 at src/main.una:16:39
module main

kind E = | Bad

risky(n: Int) -> Int
  fails E
=
  if n < 0 then fail Bad else n

pub guarded(xs: List[Int]) -> List[Int]
  fails E
=
  let ys = xs.map(each: fn(x: Int) -> risky(x))
    if error use []
  ys
