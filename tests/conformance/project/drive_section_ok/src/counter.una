-- test: a driven module whose `init`, `step` and `on_stop` have the exact shapes, with no `requires` and no refinement, is accepted; each checks in its body what it needs (spec/26 §2)
-- spec: spec/26 §2
-- expect: ok
module counter

import std.drive (Tick)

--- Starts the count.
pub init() -> Int = 0

--- Counts each tick, and each missed one.
pub step(edit count: Int, input: Tick) -> Unit
=
  if input.missed >= 0
    count = count + 1 + input.missed

--- Stops.
pub on_stop(count: Int) -> Unit = unit
