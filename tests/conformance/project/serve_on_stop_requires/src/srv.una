-- test: the host calls `on_stop` at every stop with no fact it establishes, so a `requires` on `on_stop` is U7008 at the `serve` section's module (spec/31 §7, ADR 0123 rule 16)
-- spec: spec/31 §7
-- expect: error U7008 at ita.una:10:10
module srv

import std.host (Reply, Request)

--- Answers every request with 200.
pub handle(request: internal Request) -> internal Reply = Reply(status: 200, headers: [],
  body: "ok"
)

--- Stops.
pub on_stop() -> Unit
  requires 1 + 1 == 2
=
  unit
