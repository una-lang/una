ita acme/case
  version 0.1.0
  edition 0.4
  profile app
  about "A package of edition 0.4"
  license "Apache-2.0"
  home "https://example.com/case"
  publish to itaty

labels
  PII

escapes
  checked per module 0

run
  entry main
  grants
    console
    files "data/" read, write
    http "https://api.example.com" get, post
