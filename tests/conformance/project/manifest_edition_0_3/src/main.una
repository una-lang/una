-- test: edition 0.3 is accepted, and it has every construct of edition 0.2: an `edit` binding, a `for` loop and a fixed-width integer (spec/13 §7, ADR 0056 amendment)
-- spec: spec/13 §7
-- expect: ok
module main

pub total(xs: List[Int]) -> Int
=
  let edit sum = 0
  for x in xs
    sum = sum + x
  sum

pub small(n: I32) -> I32 = n
