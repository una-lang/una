-- test: a una.toml that is not valid TOML gives the default settings: the package is checked in edition 0.1 although it names edition 0.3, so `edit` is reserved and `I32` is unknown
-- spec: spec/13 §7
-- expect: error U7002 at una.toml:5:10
-- expect: error U0103 at src/main.una:11:7
-- expect: error U1001 at src/main.una:16:14
-- expect: error U1001 at src/main.una:16:22
module main

pub total(xs: List[Int]) -> Int
=
  let edit sum = 0
  for x in xs
    sum = sum + x
  sum

pub small(n: I32) -> I32 = n
