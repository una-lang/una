-- test: the host calls `on_stop` at the stop with no fact it establishes, so a `requires` on `on_stop` is a precondition nothing proves: U7008 at the `drive` section's module (spec/26 §2)
-- spec: spec/26 §2
-- expect: error U7008 at ita.una:6:10
module counter

import std.drive (Tick)

--- Starts the count.
pub init() -> Int = 0

--- Counts each tick.
pub step(edit count: Int, input: Tick) -> Unit
=
  count = count + 1

--- Stops.
pub on_stop(count: Int) -> Unit
  requires count > 0
=
  unit
