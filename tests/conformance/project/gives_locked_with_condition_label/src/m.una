-- test: a lock that writes a label and a condition on one operation checks the label at tier 0, so a header that drops both gets U3023 for the label first (ADR 0094 with ADR 0092 rule 8)
-- spec: spec/05 §3
-- expect: error U3023 at src/m.una:11:30
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub refusal(file: Text, dry_run: Bool) -> Text
  uses @service_files: Files[owner]
=
  @service_files.owner(file)
