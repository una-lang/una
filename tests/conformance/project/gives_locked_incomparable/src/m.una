-- test: a header label incomparable with its lock's reads the operation below the lock in a category, which is U3023 at the operation (ADR 0094 with ADR 0092 rule 8)
-- spec: spec/05 §3
-- expect: error U3023 at src/m.una:11:30
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub refusal(file: Text) -> secret[Billing, Service] Text
  uses @service_files: Files[owner gives secret[Billing]]
=
  @service_files.owner(file)
