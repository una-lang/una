-- test: a [boundaries] entry names a module of the package and a ceiling of capabilities it sees, with operations they declare (ADR 0093 rules 1 and 9)
-- spec: spec/13 §7
-- expect: ok
module gallery.app

import gallery.store (Files)
import gallery.thumbnailer (thumbnail)

pub show(path: Text) -> Text
  uses @user_files: Files[read, write]
=
  thumbnail(path) with @files = @user_files[read]
