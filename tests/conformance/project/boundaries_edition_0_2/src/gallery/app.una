-- test: [boundaries] is a table of edition 0.3; editions 0.1 and 0.2 keep it unknown (ADR 0093)
-- spec: spec/13 §7
-- expect: error U7002 at una.toml:6:2
module gallery.app

import gallery.store (Files)
import gallery.thumbnailer (thumbnail)

pub show(path: Text) -> Text
  uses @user_files: Files[read]
=
  thumbnail(path) with @files = @user_files
