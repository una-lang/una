-- test: a module in [trusted] and inside a boundary is U7002: a boundary module never releases (ADR 0093 rule 8)
-- spec: spec/13 §7
-- expect: error U7002 at una.toml:10:12
module gallery.app

import gallery.store (Files)
import gallery.thumbnailer (thumbnail)

pub show(path: Text) -> Text
  uses @user_files: Files[read, write]
=
  thumbnail(path) with @files = @user_files[read]
