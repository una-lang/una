-- test: a refinement inside a type argument of the state is refused as one at its top is: the host hands `Some(7)` from `init` to `step` by the state's type without its refinements, so `step` would assume of the value inside what `init` never proved (spec/26 §2)
-- spec: spec/26 §2
-- expect: error U7008 at ita.una:6:10
module counter

import std.drive (Tick)

--- A count that cannot exist.
kind Never = Int where it == 0 and it == 1

--- Needs the impossible.
impossible(count: Int) -> Unit
  requires 1 == 2
=
  unit

--- Starts with a count.
pub init() -> Option[Int] = Some(7)

--- Counts each tick, through the impossible, which the refinement would prove.
pub step(edit state: Option[Never], input: Tick) -> Unit
=
  when state
    is Some(count) -> impossible(count)
    is None -> unit
