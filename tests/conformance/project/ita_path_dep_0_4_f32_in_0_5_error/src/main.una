-- test: a dependency of edition 0.4 under a root of edition 0.5 sees only the names of edition 0.4: `F32` is U1001 in the dependency as when it is checked alone (ADR 0122 rule 49, ADR 0139 rule 6)
-- spec: spec/30 §12
-- expect: error U1001 at deps/util/src/text.una:3:13
-- expect: error U1001 at deps/util/src/text.una:3:21
module main

import strings.text (twice)

pub greet() -> Text
=
  const line = twice("hello")
  line
