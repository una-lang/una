-- test: the `within` of a `serve` section is at most a day, 86400000 milliseconds (spec/31 §7, ADR 0123 rule 16)
-- spec: spec/31 §7
-- expect: error U7008 at ita.una:7:10
module health

import std.host (Reply, Request)

--- Answers every request with 200.
pub handle(request: internal Request) -> internal Reply = Reply(status: 200, headers: [],
  body: "ok"
)
