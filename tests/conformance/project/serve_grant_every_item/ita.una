ita case
  version 0.1.0
  edition 0.4

run
  grants
    serve "https://0.0.0.0:8443"
      certificate "tls/chain.pem"
      key "tls/key.pem"
      tls12
      at most 256 at once
      at most 6000 per minute
      waiting at most 0
      connections at most 1048576
      peer none
      handshakes at most 512 per second
      requests at most 1
      line at most 64 KiB
      headers at most 1000
      header at most 256 KiB
      body at most 0 KiB
      buffers at most 65536 MiB
      peer_buffers at most 1 MiB
      replies at most 1 MiB
      peer_replies none
      delivered at most 65536 MiB
      idle within 1 second
      read within 3600 seconds
      write within 30 seconds
      answer within 86400 seconds
      hosts "shop.example", "*.shop.example"
    serve "http://127.0.0.1:8080"
      at most 1 per second
      peer at most 1
      peer_buffers none
      peer_replies at most 65536 MiB
      hosts "*"
