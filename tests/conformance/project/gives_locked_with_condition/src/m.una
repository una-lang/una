-- test: a lock that writes a label and a condition on one operation checks both: a header that keeps the label and drops the condition gets a refuted `contract_lock` obligation, U3023 at the operation (ADR 0094 with ADR 0092 rule 8)
-- spec: spec/05 §3
-- expect: error U3023 at src/m.una:11:30
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub refusal(file: Text, dry_run: Bool) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service]]
=
  @service_files.owner(file)
