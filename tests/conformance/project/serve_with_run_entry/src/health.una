-- test: a package runs one program, so a `serve` section beside a `run entry` is U7008 (spec/31 §7, ADR 0123 rule 16)
-- spec: spec/31 §7
-- expect: error U7008 at ita.una:10:1
module health

import std.host (Reply, Request)

pub main() -> Unit = unit

--- Answers every request with 200.
pub handle(request: internal Request) -> internal Reply = Reply(status: 200, headers: [],
  body: "ok"
)
