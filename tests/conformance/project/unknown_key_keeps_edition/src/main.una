-- test: an unknown key of una.toml is U7002 and the other keys are still read: the package keeps edition 0.3, so an `edit` binding and a fixed-width integer are accepted
-- spec: spec/13 §7
-- expect: error U7002 at una.toml:5:1
module main

pub total(xs: List[Int]) -> Int
=
  let edit sum = 0
  for x in xs
    sum = sum + x
  sum

pub small(n: I32) -> I32 = n
