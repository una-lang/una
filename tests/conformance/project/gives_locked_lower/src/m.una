-- test: a header that drops a locked label reads the operation below its lock, which is U3023 at the operation, with the edit that writes the label back (ADR 0094 with ADR 0092 rule 8)
-- spec: spec/05 §3
-- expect: error U3023 at src/m.una:11:60
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub refusal(file: Text) -> Text
  uses @service_files: Files[role gives internal[Service], owner]
=
  @service_files.owner(file)
