-- test: the host calls `step` for every tick with no fact about the state or the tick, so a `requires` on `step` is a precondition nothing proves: U7008 at the `drive` section's module (spec/26 §2)
-- spec: spec/26 §2
-- expect: error U7008 at ita.una:6:10
module counter

import std.drive (Tick)

--- Starts the count.
pub init() -> Int = 0

--- Counts each tick, assuming none was missed.
pub step(edit count: Int, input: Tick) -> Unit
  requires input.missed == 0
=
  count = count + 1
