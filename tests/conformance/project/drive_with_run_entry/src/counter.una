-- test: a package has a drive section or a run entry, not both (spec/26 §2, ADR 0116 rule 1)
-- spec: spec/26 §2
-- expect: error U7008 at ita.una:8:1
module counter

import std.drive (Tick)

pub main() -> Unit = unit

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
=
  count = count + 1
