-- test: a lock of `[contracts]` cannot label an operation in this version, so `gives` there is U7002 (ADR 0094 with ADR 0092 rule 8; #566 part 2)
-- spec: spec/05 §3
-- expect: error U7002 at una.toml:10:16
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub refusal(file: Text) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service]]
=
  @service_files.owner(file)
