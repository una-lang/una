-- test: a `serve` section names the module whose `handle` the host calls for each request, and whose `on_stop` it calls after the drain; both may use what the grants allow (spec/31 §7, ADR 0123 rule 16)
-- spec: spec/31 §7
-- expect: ok
module health

import std.host (Reply, Request)

--- Answers `GET /health` with 200, and every other request with 404.
pub handle(request: internal Request) -> internal Reply
=
  if request.method is Get and request.segments == ["health"]
    Reply(status: 200, headers: [], body: "ok")
  else
    Reply(status: 404, headers: [], body: "")

--- Says that the server stopped.
pub on_stop() -> Unit
  uses @console: Console[print]
=
  @console.print("stopped")
