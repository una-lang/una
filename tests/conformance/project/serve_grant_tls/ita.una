ita case
  version 0.1.0
  edition 0.4

run
  grants
    serve "http://127.0.0.1:8080"
      certificate "tls/chain.pem"
      key "tls/key.pem"
      tls12
    serve "https://127.0.0.1:8443"
      certificate "tls/chain.pem"
    serve "https://127.0.0.1:8444"
      key "tls/key.pem"
    serve "https://127.0.0.1:8445"
      certificate "tls/a;b.pem"
      key "tls/key.pem"
    serve "https://127.0.0.1:8446"
      certificate "tls/chain.pem"
      key ""
