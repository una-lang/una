-- test: a [run] entry inside a boundary is U7002: its grants would bypass the ceiling (ADR 0093 rule 10)
-- spec: spec/13 §7
-- expect: error U7002 at una.toml:10:9
module gallery.app

import gallery.store (Files)
import gallery.thumbnailer (thumbnail)

pub show(path: Text) -> Text
  uses @user_files: Files[read, write]
=
  thumbnail(path) with @files = @user_files[read]
