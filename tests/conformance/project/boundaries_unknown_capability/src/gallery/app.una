-- test: a ceiling's capability that the boundary module does not see is U7002, and the entry permits nothing, so the grant is U3021 (ADR 0093 rules 1 and 3)
-- spec: spec/13 §7
-- expect: error U7002 at una.toml:7:26
-- expect: error U3021 at src/gallery/app.una:13:3
module gallery.app

import gallery.store (Files)
import gallery.thumbnailer (thumbnail)

pub show(path: Text) -> Text
  uses @user_files: Files[read, write]
=
  thumbnail(path) with @files = @user_files[read]
