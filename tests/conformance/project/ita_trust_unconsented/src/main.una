-- test: a trust line without the lock's consent to the package's content is U7012
-- spec: spec/30 §13
-- expect: error U7012 at ita.una:6:3
-- expect: error U3024 at src/main.una:10:36
-- expect: error U7005 at deps/util/src/keys.una:1:1
module main

import util.keys (reveal)

pub show(t: secret Text) -> Text = reveal(t)

-- A refused trust leaves the module untrusted, so its header is U7005 and the release
-- of its policy into the package extent is U3024 as well.
