-- test: ADR 0067 adversarial check of #231, L09_together: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l09.una:13:34
module l09

both[T](a: T, b: T) -> Int
=
  together
    let x = if a == b then 1 else 0
    let y = 2
  x + y

pub leak(s: secret Int) -> Int = both(s, b: 0)
