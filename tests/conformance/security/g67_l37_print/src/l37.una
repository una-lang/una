-- test: ADR 0067 adversarial check of #231, L37_print: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4003 at src/l37.una:11:18
module l37

less[T](a: T, b: T) -> Int = if a == b then 1 else 0

pub leak(s: secret Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{less(s, b: 0)}")
