-- test: an editable `Queue` or `Stack` keeps its declared labels: a push or a pop under a `secret` condition into a `public` one is U4001, since its length would reveal the condition, and so is a `secret` item pushed into a `public` element position (ADR 0119 IF1, spec/17 §6 rule 1)
-- spec: spec/28 §5
-- expect: error U4001 at src/m.una:14:23
-- expect: error U4001 at src/m.una:21:17
-- expect: error U4001 at src/m.una:28:21
module m

import std.collections (Queue, Stack, empty_queue)

pub pushed(flag: secret Bool) -> Int
=
  var q: Queue[Int] = empty_queue()
  if flag
    edit q.push(item: 1)
  q.len

pub popped(flag: secret Bool, s: Stack[Int]) -> Int
=
  var t = s
  if flag
    const top = edit t.pop()
    unit
  t.len

pub secret_item(pin: secret Int) -> Int
=
  var q: Queue[Int] = empty_queue()
  edit q.push(item: pin)
  q.len
