-- test: ADR 0067 recheck of #231, F03c_fn_param_of_param_Int: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f03c.una:6:75
module f03c

mk[T](a: T, b: T) -> fn(fn(Int) -> Int) -> Int = fn(k: fn(Int) -> Int) -> k(if a == b then 1 else 0)

pub leak(s: secret Int) -> Int
=
  let g = mk(s, b: 0)
  g(fn(x: Int) -> x)
