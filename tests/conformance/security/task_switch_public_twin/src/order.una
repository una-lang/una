-- test: the public twin of `task_switch_secret_loop`: the same tasks, whose loops a `public` key bounds, are accepted, and the interpreter's schedule orders their prints by that key, the same in both engines (spec/27 §8 rules 2 and 5, #1684)
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "2"
-- expect: run-output "5"
-- expect: run-output "7"
-- expect: run-output "1"
-- expect: run-output "3"
-- expect: run-output "4"
-- expect: run-output "6"
module order

spin(n: Int) -> Int
=
  let edit acc = 0
  for i in 0..<n
    acc = acc + 1
  acc

bit(k: Int, key: Int) -> Int
=
  let edit x = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: Int) -> Unit
  uses @console: Console[print]
=
  let r = spin(bit(k, key: key) * 3000)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
