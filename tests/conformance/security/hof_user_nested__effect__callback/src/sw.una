-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): reject: twice -> apply_eff, the callback's effect
-- spec: spec/07 §7
-- expect: error U4002 at src/sw.una:36:3
-- expect: error U4001 at src/sw.una:36:37
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

apply_eff[U](x: U, f: fn(U) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  f(x)

twice[V](x: V, f: fn(V) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  apply_eff(x, f: f)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  twice(if a == b then p else q, f: k)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> @log.write(xs.len))
