-- test: the twin of `tconc_via_first_of` (#1154): the sibling works on `public` data, so `τ_conc` at the request in the `via` function, the precise one of `spec/27 §11`, is at most `internal`, and the limited grant is accepted
-- spec: spec/07 §5
-- expect: ok
module main

import release (key_of)

crunch(key: Int) -> Int
=
  let edit acc = key
  for i in 0..1000
    acc = if acc > 0 then acc - 1 else acc + 1
  acc

spin(key: Int, n: Int) -> Int
=
  let spent = crunch(key)
  n

--- The policy is called in a branch of `first of`, beside a branch that works on `key`.
pub both(key: Int, n: Int) -> internal Int
  uses @http: Http[get]
=
  first of
    key_of(n)
    spin(key, n: n)
