module sweep_variance_option_return

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub ret_0(v: Option[secret Int]) -> Option[Int] = v

pub ret_1(v: Option[Int]) -> Option[secret Int] = v
