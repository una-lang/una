-- test: ADR 0067 recheck of #231, P07_user_hof_passes_on: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/p07.una:25:30
module p07

pub capability Log
  op write(n: Int) -> Unit

noisy(x: Int) -> secret Bool
  uses @log: Log[write]
=
  @log.write(x)
  x < secret_threshold()

secret_threshold() -> secret Int = 3

find[T](xs: List[T], keep: fn(T) -> Bool) -> Option[T]
  uses of keep
=
  xs.first_where(keep)

pub leak(xs: List[Int]) -> Unit
  uses @log: Log[write]
=
  let found = find(xs, keep: noisy)
  unit
