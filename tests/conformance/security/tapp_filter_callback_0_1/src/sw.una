-- test: in edition 0.1, a function value given a value of a type parameter, or a decision on such values (#253, review of #343): leak (U4003): whether the decided element passes a public predicate, through filter
-- spec: spec/07 §7
-- expect: error U4001 at src/sw.una:13:53
-- expect: error U4003 at src/sw.una:14:14
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](a: T, b: T, p: T, q: T, keep: fn(T) -> Bool) -> Unit
  uses @log: Log[write]
=
  let kept = [if a == b then p else q].filter(keep: keep)
  @log.write(kept.len)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], keep: fn(xs) -> xs.len > 0)
