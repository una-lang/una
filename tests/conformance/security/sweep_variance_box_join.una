-- test: a kind whose parameter is only in data positions is covariant at a branch join (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:3
module sweep_variance_box_join

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub join_0(c: Bool, v: Box[secret Int], w: Box[Int]) -> Box[Int]
=
  let j = if c then w else v
  j

pub join_1(c: Bool, v: Box[Int], w: Box[secret Int]) -> Box[secret Int]
=
  let j = if c then w else v
  j
