-- test: a request task that reads `secret` data and replies with what a policy releases, without `within`, is accepted: the `start` runs under an `internal` program counter and `reply` accepts `internal` (spec/31 §1, ADR 0123 IF2, IF6, IF7)
-- spec: spec/31 §1
-- expect: ok
module srv

import release (shown)
import std.host (Exchange, HttpServer, Reply)

pub capability Vault
  op balance(of: Text) -> secret Int
    accepts internal

answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
  uses @vault: Vault[balance]
=
  let cents = @vault.balance(of: exchange.request.body)
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: shown(cents)))
    if error use unit

serve_all(exchanges: internal List[Exchange]) -> Unit
  uses @server: HttpServer[reply]
  uses @vault: Vault[balance]
=
  tasks
    for exchange in exchanges
      start answer(exchange)
