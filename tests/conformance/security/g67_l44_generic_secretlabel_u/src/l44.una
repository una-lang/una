-- test: ADR 0067 adversarial check of #231, L44_generic_secretlabel_U: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l44.una:8:34
module l44

second[T, U](a: T, b: U) -> U = b

pub leak(s: secret Int) -> Int = second(1, b: s)
