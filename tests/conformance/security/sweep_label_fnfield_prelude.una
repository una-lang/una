-- test: a kind whose field is a function type: prelude results over kinds with function fields carry the fields' labels when called (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 20:3
-- expect: error U4001 at 22:42
-- expect: error U4001 at 24:47
module sweep_label_fnfield_prelude

kind Src
  get: fn() -> secret Int

kind Feed[T]
  get: fn() -> T

make(pin: secret Int) -> Src = Src(get: fn() -> pin)

pub firsts(ss: List[Src], s: Src) -> Int
=
  let t = ss.first()
    if none use s
  t.get()

pub mapped(ss: List[Src]) -> List[Int] = ss.map(each: fn(s) -> s.get())

pub fed(fs: List[Feed[secret Int]]) -> Bool = fs.is_empty()
