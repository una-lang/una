-- test: `and` short-circuits, so its right operand runs only when the left one, decided by a `secret` bit, is true: the call in it is a check point under that label, U4002 in a program that starts tasks (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:21:19
module order

yes() -> Bool = true

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: key)
  let edit c: secret Int = 0
  for i in 0..<3000
    if b == 1 and yes()
      c = c + 1
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
