-- test: a function value chosen by `secret` data runs one lambda or another, so which calls the task makes, and how deep, is decided by the value's label: a call of it joins that label, U4003 at the `start` (spec/31 §1, ADR 0123 IF6, #1674)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:30:7
module srv

import std.host (Exchange, HttpServer, Reply)

big(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + big(n - 1)

answer(exchange: internal Exchange, key: secret Int, keys: secret List[Int]) -> Unit
  uses @server: HttpServer[reply]
=
  let a = fn() -> big(5000)
  let b = fn() -> 0
  let f = if key > exchange.request.body.len then a else b
  let d = f()
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all(exchanges: internal List[Exchange], key: secret Int, keys: secret List[Int]) -> Unit
  uses @server: HttpServer[reply]
=
  tasks
    for exchange in exchanges
      start answer(exchange, key: key, keys: keys)
