-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, the review matrix): accept: control: the decision in a list of records of lists
-- spec: spec/07 §7
-- expect: ok
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

deep[U](xs: List[Hold[List[U]]], f: fn(Hold[List[U]]) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(xs.map(each: f).sum())

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit uses @log: Log[write], hk: fn(Hold[List[T]]) -> Int) -> Unit
  uses @log: Log[write]
=
  deep([Hold(value: [p])], f: hk)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> @log.write(xs.len), hk: fn(h) -> h.value.len)
