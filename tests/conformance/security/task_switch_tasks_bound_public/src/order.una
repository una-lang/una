-- test: the public twin of `task_switch_tasks_bound`: the same program on a `public` key is accepted (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- expect: ok
module order

noop() -> Unit = unit

spin2() -> Unit
=
  for i in 0..<2000
    noop()

bit(k: Int, key: Int) -> Int
=
  let edit x: Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: Int) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: key)
  tasks at most abs(b) + 1 at once
    start spin2()
    start spin2()
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
