-- test: a server echoes an internal request field as an internal Json in an internal reply body in edition 0.4, keeping the structure and escaping of to_json, with no policy (spec/23 §5, spec/31 §7, ADR 0073 J5 as amended)
-- spec: spec/23 §5
-- expect: ok
module srv

import std.host (Reply, Request)

--- Answers with the request's body inside a JSON object.
pub handle(request: internal Request) -> internal Reply = Reply(status: 200, headers: [],
  body: Object(fields: empty_map().with(key: "echo", value: Str(value: request.body))).to_json()
)
