--- A coarse release whose `via` works in proportion to its argument.
trusted module release

pub policy bucket
  from internal Int
  to Int
  via coarse
  purpose "probe the check points of a via"
  owner tests

coarse(n: internal Int) -> Int
=
  let edit acc: internal Int = 0
  for i in 0..<n
    acc = acc + 1
  0
