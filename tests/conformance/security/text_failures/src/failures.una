-- test: whether parse_int fails on a secret, and where, is secret: attempt's Ok or Err, the payload of Err, a failure in its place and the value that replaces it all carry the argument's labels, each with a control, and a public text's failure stays public (spec/22 §5 rule 2, N-27)
-- spec: spec/22 §5
-- expect: error U4001 at src/failures.una:16:3
-- expect: error U4001 at src/failures.una:34:8
-- expect: error U4001 at src/failures.una:36:18
-- expect: error U4002 at src/failures.una:50:5
-- expect: error U4001 at src/failures.una:58:3
module failures

pub kind Bad = Other | Worse

--- Whether a secret parses, through `attempt`.
pub ok_tag(s: secret Text) -> Bool
=
  let r = attempt s.parse_int()
  r is Ok

pub ok_tag_control(s: secret Text) -> secret Bool
=
  let r = attempt s.parse_int()
  r is Ok

position(e: secret ParseError) -> secret Int
=
  when e
    is NotADigit(at) -> at
    is Empty -> -1
    is NoDigits -> -2

--- Where a secret fails to parse, through the payload of `Err`.
pub err_position(s: secret Text) -> Int
=
  let r = attempt s.parse_int()
  when r
    is Ok(n) -> 0
    is Err(e) -> position(e)

pub err_position_control(s: secret Text) -> secret Int
=
  let r = attempt s.parse_int()
  when r
    is Ok(n) -> 0
    is Err(e) -> position(e)

--- Whether a secret parses, through a failure of the caller.
pub relayed(s: secret Text) -> secret Int
  fails Bad
=
  let n = s.parse_int()
    if error fail Other
  n

--- Whether a secret parses, through the value that replaces the failure.
pub used(s: secret Text) -> Int
=
  let n = s.parse_int()
    if error use 0
  n

pub used_control(s: secret Text) -> secret Int
=
  let n = s.parse_int()
    if error use 0
  n

--- A public text's failure stays public.
pub public_tag(t: Text) -> Bool
=
  let r = attempt t.parse_int()
  r is Ok
