-- test: an if and a when branch join fed by a lambda checks every flow (uses, label, fails); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/10 §2
-- expect: error U4001 at 27:242
-- expect: error U4001 at 34:10
-- expect: error U3003 at 38:242
-- expect: error U3003 at 43:33
-- expect: error U3007 at 49:242
-- expect: error U3007 at 54:33
module sweep_flow_join_lambda

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub zero(x: Int) -> Int = 0

pub take_e(v: fn(Int) -> Int) -> Int = 0

pub m_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_e(if c then fn(y: Int) -> s else zero)

pub mw_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> fn(y: Int) -> s
    is None -> zero
  take_e(y)

pub m_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_e(if c then fn(y: Int) -> y else zero)

pub e_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_e(if c then fn(y: Int) -> q(y) else zero)

pub ew_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> fn(y: Int) -> q(y)
    is None -> zero
  take_e(y)

pub e_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_e(if c then fn(y: Int) -> g(y) else zero)

pub x_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  c: Bool
) -> Int = take_e(if c then fn(y: Int) -> z(y) else zero)

pub xw_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print],
  o: Option[Int]
) -> Int
=
  let y = when o
    is Some(v) -> fn(y: Int) -> z(y)
    is None -> zero
  take_e(y)
