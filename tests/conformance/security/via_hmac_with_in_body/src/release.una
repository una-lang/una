trusted module release

pub kind ViaError = Broke(detail: Text) | Gone

pub policy key_of
  from secret Text
  to internal Hashed
  via hmac_it
  purpose "a keyed hash of the text"
  owner privacy

hmac_it(t: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  uses @other: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: "pepper", data: t) with @keys = @other
    if error pass
