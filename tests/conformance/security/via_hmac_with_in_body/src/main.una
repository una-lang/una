-- test: a with in the via body keeps the policy failure at the to label (ADR 0098)
-- spec: spec/07 §5
-- expect: error U4002 at src/main.una:14:5
module main

import release (key_of)

pub passes(t: secret Text) -> Unit
  uses @keys: Keys[hmac]
  uses @other: Keys[hmac]
  fails KeyError
=
  let k = key_of(t)
    if error pass
  unit
