-- test: in a run that reads the environment, whose answers are `internal`, every reading of `Clock.now` the entry reaches is `internal` (ADR 0116 amendment of 2026-11-09, C1, What it breaks): printing it is refused (U4003)
-- spec: spec/14 §3
-- expect: error U4003 at src/leak.una:14:18
module leak

pub main() -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
  uses @env: Env[get]
=
  let start = @clock.now()
  let mode = @env.get("MODE")
  let stop = @clock.now()
  @console.print("{stop - start} ms")
