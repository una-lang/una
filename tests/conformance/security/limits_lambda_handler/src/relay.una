-- test: the history of a limit through a lambda and a handler (ADR 0116 P1, P8, P11, ADR 0117 IF4): the request in `fetch` is called only from a lambda, and every lambda is one node of the call graph, reached from the handler `relay`, which calls its function parameter; P10 counts that node's body as `⊤`, since a lambda runs wherever a function value is called (IF5 item 4), and refused the request; P11 summarizes every lambda of the package, and no code on data above `internal` runs between two requests, so it is accepted (`limits_between_lambda_secret` is its refused twin)
-- spec: spec/27 §9
-- expect: ok
module relay

capability Work
  op go(url: Text) -> Unit

--- One request, whose failure it handles.
fetch(url: Text) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

handler relay(each: fn(Text) -> Unit uses @http: Http[get]) for Work
  uses @http: Http[get]
  op go(url) = each(url)

serve(url: Text) -> Unit
  uses @work: Work[go]
=
  @work.go(url)

pub run(url: Text) -> Unit
  uses @http: Http[get]
=
  serve(url) with @work = relay(each: fn(u) -> fetch(u))
