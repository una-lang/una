-- test: precise `τ_conc` (ADR 0116 P2): the block of a `tasks` statement is a part, so `report(n)`, run by the block beside the started `churn(key)`, has a `secret` `τ_conc` (U4003 at the print)
-- spec: spec/27 §11
-- expect: error U4003 at src/report.una:24:18
module report

import std.time (millisecond)

crunch(key: secret Int) -> secret Int = key * 3

--- Work on `key`, which a started task runs.
churn(key: secret Int) -> Unit
=
  let spent = crunch(key)
  unit

step(n: Int) -> Int = n + 1

--- Prints whether `step(n)` met its deadline: the value carries the deadline's timing label.
report(n: Int) -> Unit
  uses @console: Console[print]
=
  let v = step(n) within 10 * millisecond
    if error use 0
  @console.print("{v}")

--- Starts `churn(key)`, and runs `report(n)` in the block itself, beside it.
pub serve(key: secret Int, n: Int) -> Unit
  uses @console: Console[print]
=
  tasks
    start churn(key)
    report(n)
  unit
