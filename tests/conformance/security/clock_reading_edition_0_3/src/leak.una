-- test: editions 0.1 to 0.3 do not change (ADR 0116 amendment of 2026-11-09, C6): their readings of `Clock.now` stay unlabeled, and timing stays out of model (spec/07 §1), so the elapsed time of work on a `secret` parameter prints
-- spec: spec/14 §3
-- expect: ok
module leak

work(n: secret Int) -> secret Int = n * n

pub show(n: secret Int) -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let start = @clock.now()
  let squared = work(n)
  let stop = @clock.now()
  @console.print("{stop - start} ms")
