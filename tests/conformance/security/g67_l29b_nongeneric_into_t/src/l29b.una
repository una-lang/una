-- test: ADR 0067 adversarial check of #231, L29b_nongeneric_into_T: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l29b.una:10:15
module l29b

put[T](x: T, k: Int) -> Option[Int] = Some(k)

pub leak(k: secret Int) -> Int
=
  when put(1, k)
    is Some(v) -> v
    is None -> 0
