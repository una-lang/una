-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): reject: relay -> logger, the callee's effect
-- spec: spec/07 §7
-- expect: error U4002 at src/sw.una:36:3
-- expect: error U4001 at src/sw.una:36:37
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

logger[U](x: U, f: fn(U) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(f(x))

relay[V](x: V, f: fn(V) -> Int) -> Unit
  uses @log: Log[write]
=
  logger(x, f: f)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  relay(if a == b then p else q, f: k)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
