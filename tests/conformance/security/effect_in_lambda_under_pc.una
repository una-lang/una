-- test: effectful lambda argument under a secret pc (review control)
-- spec: spec/07 §3
-- expect: error U4002 at 15:5
module effect_in_lambda_under_pc

each(lines: List[Text], write: fn(Text) -> Unit uses @console: Console[print]) -> Unit
  uses @console: Console[print]
=
  unit

pub leak(flag: secret Bool) -> Unit
  uses @console: Console[print]
=
  if flag
    each(["a"], write: fn(l) -> @console.print(l))
  else
    unit
