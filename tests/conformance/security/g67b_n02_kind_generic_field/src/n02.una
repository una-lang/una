-- test: ADR 0067 recheck of #231, N02_kind_generic_field: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n02.una:12:34
module n02

kind Pair[A, B]
  first: A
  second: B

pick[U](x: U, y: U, p: U, q: U) -> U = if x == y then p else q

pub leak(s: secret Int) -> Int = pick(Pair(first: s, second: 0), y: Pair(first: 0, second: 0), p: Pair(first: 0, second: 1), q: Pair(first: 0, second: 2)).second
