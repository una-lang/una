-- test: a record kind with a secret field: a generic function result is raised by the field labels of its type argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 25:32
-- expect: error U4001 at 27:32
module sweep_label_record_generic

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Acct) -> secret Int = x.pin

same[T](a: T, b: T) -> Bool = a == b

keep[T](a: T) -> Int = 1

pub generic(x: Acct) -> Bool = same(x, b: Acct(id: 1, pin: 2))

pub constant(x: Acct) -> Int = keep(x)

pub generic_twin(x: Acct) -> secret Bool = same(x, b: Acct(id: 1, pin: 2))
