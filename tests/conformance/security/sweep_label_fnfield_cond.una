-- test: a kind whose field is a function type: an `if` or `when` on a function field's result raises the program counter (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:32
-- expect: error U4003 at 22:13
-- expect: error U4003 at 23:13
module sweep_label_fnfield_cond

kind Src
  get: fn() -> secret Int

kind Feed[T]
  get: fn() -> T

make(pin: secret Int) -> Src = Src(get: fn() -> pin)

pub chosen(s: Src) -> Int = if s.get() > 0 then 1 else 0

pub printed(s: Src) -> Unit
  uses @console: Console[print]
=
  when s.get()
    is 0 -> @console.print("zero")
    else -> @console.print("other")
