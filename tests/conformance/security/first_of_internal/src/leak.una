-- test: timing decides which branch of `first of` wins, so its value is labeled with the timing of every branch (ADR 0117 IF3): a race over a branch that reads `internal` data gives an `internal` value, which a `public` sink refuses (U4003)
-- spec: spec/27 §6
-- expect: error U4003 at src/leak.una:14:18
module leak

pick(token: internal Text) -> Int = 1

pub show(token: internal Text) -> Unit
  uses @console: Console[print]
=
  let winner = first of
    pick(token)
    pick("constant")
  @console.print("{winner}")
