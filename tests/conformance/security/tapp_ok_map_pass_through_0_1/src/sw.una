-- test: in edition 0.1, a function value given a value of a type parameter, or a decision on such values (#253, review of #343): ok (no U4xxx): map of k over values of T, with no decision
-- spec: spec/07 §7
-- expect: ok
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let ns = [p, q].map(each: k)
  @log.write(ns.sum())

pub fine(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], q: [1], k: fn(xs) -> xs.len)
