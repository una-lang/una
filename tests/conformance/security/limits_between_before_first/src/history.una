-- test: the code between two requests (ADR 0116 P11): `run` works on a `secret` before its first request, which cannot matter, since every bucket starts full, and nothing on the `secret` decides whether a request happens; P10 refused it for its ancestor's whole body, P11 accepts it
-- spec: spec/27 §9
-- expect: ok
module history

--- One request, whose failure it handles.
fetch(url: Text) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

crunch(key: secret Int) -> secret Int = key * 3

pub run(url: Text, key: secret Int) -> Unit
  uses @http: Http[get]
=
  let spent = crunch(key)
  fetch(url)
  fetch(url)
