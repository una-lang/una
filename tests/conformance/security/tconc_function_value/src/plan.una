-- test: precise `τ_conc` through `Λ` (ADR 0116 P1, P3): a branch calls `apply(route, x: 3)`, beside a branch that works on a `secret`; the call of a function value reaches `Λ`, and `Λ` every function named as a value, so the `within` of `plan_route` runs beside the race's parts, whose `κ` is `⊤` (IF5 item 4), and passing its `TimedOut` on is U4002
-- spec: spec/27 §11
-- expect: error U4002 at src/plan.una:17:5
module plan

import std.time (millisecond)

pub kind PlanError = | TimedOut

step(n: Int) -> Int = n + 1

--- A deadline over `public` work, whose `TimedOut` it passes on.
plan_route(n: Int) -> Int
  fails PlanError
=
  let v = step(n) within 10 * millisecond
    if error pass
  v

route(n: Int) -> Int
=
  let r = plan_route(n)
    if error use 0
  r

apply(g: fn(Int) -> Int, x: Int) -> Int = g(x)

crunch(key: secret Int) -> secret Int = key * 3

--- A branch runs `route` as a function value, beside a branch that works on `key`.
pub both(key: secret Int, n: Int) -> secret Int
=
  together
    let a = crunch(key)
    let b = apply(route, x: 3)
  a
