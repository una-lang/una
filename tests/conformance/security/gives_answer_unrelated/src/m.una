-- test: a flow that no labeled answer explains keeps its U4001 when the body also reads a labeled answer, which its message does not name (ADR 0094 rule 7)
-- spec: spec/07 §3
-- expect: error U4001 at src/m.una:13:3
module m

pub capability Files
  op owner(file: Text) -> Text

pub other(file: Text, pin: secret Text) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service]]
=
  let owner = @service_files.owner(file)
  pin
