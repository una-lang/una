-- test: a `start ... within` that moves a reply right is checked as a `reply` of its task's auto-answer under `pc ⊔ τ(e)`: an expression that computes on `secret` data and never replies is U4003 at the `start` (spec/31 §1, ADR 0123 IF6)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:18:7
module srv

import std.host (Exchange)
import std.time (second)

crunch(exchange: internal Exchange, key: secret Int) -> Unit
=
  let spent = key * 3
  unit

serve_all(exchanges: internal List[Exchange], key: secret Int) -> Unit
=
  tasks
    for exchange in exchanges
      start crunch(exchange, key: key) within 5 * second
        if error use unit
