-- test: ADR 0067 adversarial check of #231, L43_mutable: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l43.una:11:11
module l43

count_eq[T](xs: List[T], p: T) -> Int
=
  let edit n = 0
  for x in xs
    if x == p
      n = n + 1
  n

pub leak(xs: List[secret Int]) -> Int = count_eq(xs, p: 1)
