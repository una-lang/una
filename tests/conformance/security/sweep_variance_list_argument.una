-- test: `List` is covariant at a call argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 14:48
module sweep_variance_list_argument

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

take_0(w: List[Int]) -> Int = 0

pub arg_0(v: List[secret Int]) -> Int = take_0(v)

take_1(w: List[secret Int]) -> Int = 0

pub arg_1(v: List[Int]) -> Int = take_1(v)
