-- test: the twin of `tconc_via_tasks`: the same policy is called outside the construct, where no task runs beside it, so `L_lim` stays `internal`
-- spec: spec/07 §5
-- expect: ok
module main

import release (key_of)

crunch(key: Int) -> Int
=
  let edit acc = key
  for i in 0..1000
    acc = if acc > 0 then acc - 1 else acc + 1
  acc

churn(key: Int) -> Unit
=
  let spent = crunch(key)
  unit

--- The policy is called after the `tasks` statement, beside nothing.
pub both(key: Int, n: Int) -> Unit
  uses @http: Http[get]
=
  tasks
    start churn(key)
  let b = key_of(n)
  unit
