-- test: call of an effectful function parameter under a secret pc (review control)
-- spec: spec/07 §3
-- expect: error U4002 at 10:5
module fnvalue_under_pc

pub leak(flag: secret Bool, write: fn(Text) -> Unit uses @console: Console[print]) -> Unit
  uses @console: Console[print]
=
  if flag
    write("yes")
  else
    unit
