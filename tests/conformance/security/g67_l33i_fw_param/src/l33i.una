-- test: ADR 0067 adversarial check of #231, L33i_fw_param: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U0101 at src/l33i.una:15:52
module l33i

pub capability Log
  op write(n: Int) -> Unit

below(x: Int, t: secret Int) -> secret Bool
  uses @log: Log[write]
=
  @log.write(x)
  x < t

scan(xs: List[Int], p: fn(Int) -> secret Bool uses Log[write]) -> Unit
  uses @log: Log[write]
=
  let found = xs.first_where(keep: p)
  unit

pub leak(xs: List[Int], t: secret Int) -> Unit
  uses @log: Log[write]
=
  scan(xs, p: fn(x) -> below(x, t))
