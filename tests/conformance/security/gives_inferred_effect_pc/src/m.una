-- test: in an inferred function, a branch on a labeled answer runs under the label its callers pass, so an effect there through an operation that accepts `public` data is U4003 (ADR 0094 rules 2 and 3)
-- spec: spec/07 §3
-- expect: error U4003 at src/m.una:17:5
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub capability Mailer
  op send(to: Text) -> Unit

notify(file: Text) -> Unit
=
  let owner = @files.owner(file)
  if owner == "root"
    @mailer.send("root")
  unit

pub refusal(file: Text) -> Unit
  uses @files: Files[owner gives internal[Service]]
  uses @mailer: Mailer[send]
=
  notify(file)
