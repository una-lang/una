-- test: ADR 0067 recheck of #231, N06i_firstwhere_choice: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n06i.una:11:8
-- expect: error U4001 at src/n06i.una:12:19
module n06i

find[U](xs: List[U], y: U) -> Option[U] = xs.first_where(keep: fn(x) -> x == y)

pub leak(s: secret Int) -> Int
=
  when find([[s], [0, 0]], y: [0])
    is Some(v) -> v.len
    is None -> 0
