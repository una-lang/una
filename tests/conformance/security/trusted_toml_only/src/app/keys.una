-- test: una.toml lists the module, header lacks `trusted` (review control)
-- spec: spec/07 §7
-- expect: error U4004 at src/app/keys.una:7:12
-- expect: error U7005 at una.toml:10:12
module app.keys

pub policy mask
  from secret[PII] Text
  to internal Text
  via masked
  purpose "show the last digits"
  owner privacy

masked(t: secret[PII] Text) -> internal Text = t
