-- test: only its policy uses a via function
-- spec: spec/07 §5
-- expect: error U4005 at src/app/keys.una:15:52
trusted module app.keys

pub policy mask
  from secret[PII] Text
  to internal Text
  via masked
  purpose "show the last digits"
  owner privacy

masked(t: secret[PII] Text) -> internal Text = t

pub around(t: secret[PII] Text) -> internal Text = masked(t)
