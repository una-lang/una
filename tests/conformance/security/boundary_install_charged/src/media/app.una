-- test: a handler installed outside a call into a boundary and granted on to it by name, through a header binding, calls and rebindings, narrowed or not, is charged where it is installed: its `uses` lie within the ceiling (ADR 0093 rule 15); a sibling binding of the same `with` resolves outside it, and a handler that reaches no call into the boundary, or that uses nothing, is accepted
-- spec: spec/05 §4
-- expect: error U3021 at src/media/app.una:41:26
-- expect: error U3021 at src/media/app.una:46:24
-- expect: error U3021 at src/media/app.una:51:26
module media.app

import media.log (Log, Net)
import media.render (show)

handler noisy() for Log
  uses @net: Net[post]
  op write(n) = @net.post(n)

handler quiet() for Log
  op write(n) = n

forward(n: Int) -> Int
  uses @log: Log[write]
=
  show(n) with @log = @log

relay(n: Int) -> Int
  uses @log: Log[write]
=
  forward(n)

renamed(n: Int) -> Int
  uses @out: Log[write]
=
  forward(n) with @log = @out[write]

local_only(n: Int) -> Int
  uses @log: Log[write]
=
  @log.write(n)

pub one_frame(n: Int) -> Int
  uses @net: Net[post]
=
  forward(n) with @log = noisy()

pub two_frames(n: Int) -> Int
  uses @net: Net[post]
=
  relay(n) with @log = noisy()

pub through_rename(n: Int) -> Int
  uses @net: Net[post]
=
  renamed(n) with @out = noisy()

pub sibling(n: Int) -> Int
  uses @net: Net[post]
  uses @log: Log[write]
=
  renamed(n) with @log = noisy(), @out = @log

pub control(n: Int) -> Int
  uses @net: Net[post]
=
  forward(n) with @log = quiet()

pub unrelated(n: Int) -> Int
  uses @net: Net[post]
=
  local_only(n) with @log = noisy()
