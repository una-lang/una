-- test: the `secret` version of the positive control `serve_handoff_residue` of `crates/una-cli/tests/timing_channels.rs` (ADR 0123, S4 design §10.3 and §11.5, SC2): a `secret` key decides how many bytes the first reply leaves pending on a serve thread, which, through the grant's `replies` and `connections`, decides whether a later `next` under a deadline receives its request. The body is `secret`, above the `internal` of `Reply.body` (U4001); the key is read after a server operation, so `L_srv` is `secret` and the `next` under each deadline is U4003, each reply under its outcome U4003, and the call of `late` under it U4002 (spec/31 §1, #1660). The oracle checks that this file is its program
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:26:23
-- expect: error U4003 at src/srv.una:29:7
-- expect: error U4001 at src/srv.una:42:54
-- expect: error U4003 at src/srv.una:52:23
-- expect: error U4003 at src/srv.una:55:7
-- expect: error U4002 at src/srv.una:57:24
module srv

import std.host (Exchange, HttpServer, Reply)
import std.time (millisecond, second)

key() -> secret Int = 1

doubled(n: Int) -> Text
=
  let edit t = "x"
  for i in 0..<n
    t = "{t}{t}"
  t

late() -> Unit
  uses @server: HttpServer[next, reply]
=
  let again = attempt @server.next() within 10 * second
  when again
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "late"))
        if error use unit
    is Err(failure) -> unit

pub main() -> Unit
  uses @server: HttpServer[next, reply, close]
=
  let big = doubled(25)
  let probe = doubled(23)
  let first = attempt @server.next()
  let answered_first = when first
    is Ok(exchange) ->
      @server.reply(to: exchange.right,
        reply: Reply(status: 200, headers: [], body: if key() > 0 then big else "x")
      )
        if error use unit
    is Err(failure) -> unit
  let second = attempt @server.next()
  let answered_second = when second
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: probe))
        if error use unit
    is Err(failure) -> unit
  let third = attempt @server.next() within 500 * millisecond
  let answered_third = when third
    is Ok(exchange) ->
      @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "in time"))
        if error use unit
    is Err(failure) -> late()
  @server.close()
