-- test: the twin of `tconc_within_phase`: the part's own work is on `public` data, so `TimedOut` may be passed on
-- spec: spec/27 §11
-- expect: ok
module plan

import std.time (millisecond)

pub kind PlanError = | TimedOut

crunch_open(n: Int) -> Int = n * 3

plan(n: Int) -> Int = n + 1

--- Public work that runs for a while.
busy(n: Int) -> Int
=
  let edit acc = n
  for i in 0..1000
    acc = acc + 1
  acc

--- Its own work on `m` decides when `plan(n)` starts, and so which work of the sibling it
--- overlaps (ADR 0116 P2).
warm_then_plan(m: Int, n: Int) -> Int
  fails PlanError
=
  let spent = crunch_open(m)
  let value = plan(n) within 10 * millisecond
    if error pass
  value

pub both(m: Int, n: Int) -> Int
  fails PlanError
=
  together
    let a = warm_then_plan(m, n)
      if error pass
    let b = busy(n)
  b
