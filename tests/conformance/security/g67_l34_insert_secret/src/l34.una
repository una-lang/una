-- test: ADR 0067 adversarial check of #231, L34_insert_secret: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l34.una:12:49
module l34

insert[T: Ord](sorted: List[T], item: T) -> List[T]
=
  let ahead = sorted.filter(keep: fn(s) -> s < item)
  let behind = sorted.filter(keep: fn(s) -> not (s < item))
  behind.fold(initial: ahead.append(item: item), step: fn(acc, s) -> acc.append(item: s))

pub leak(xs: List[Int], s: secret Int) -> Int = insert(xs, item: s).fold(initial: 0, step: fn(acc, v) -> acc * 10 + 1)
