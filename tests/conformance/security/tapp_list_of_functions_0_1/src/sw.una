-- test: in edition 0.1, a function value given a value of a type parameter, or a decision on such values (#253, review of #343): leak (U4003): the function value comes out of a list
-- spec: spec/07 §7
-- expect: error U4003 at src/sw.una:16:14
-- expect: error U4001 at src/sw.una:21:37
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](a: T, b: T, p: T, q: T, ks: List[fn(T) -> Int]) -> Unit
  uses @log: Log[write]
=
  let n = when ks.first()
    is Some(f) -> f(if a == b then p else q)
    is None -> 0
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], ks: [fn(xs) -> xs.len])
