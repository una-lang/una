-- test: a policy call runs its `via` function (#1673): the `via` installs a handler with a `secret` parameter, which the policy's header does not show, so the timing label of a `within` around the policy call is `secret`, and `w` cannot hold its outcome (U4001)
-- spec: spec/07 §5
-- expect: error U4001 at src/main.una:12:16
module main

import release (key_of)
import std.time (millisecond)

--- The deadline bounds the call of the policy, and so the run of its `via` function.
pub probe(n: Int) -> Int
=
  let w: Int = key_of(n) within 10 * millisecond
    if error use 0
  w
