-- test: private helper with inferred Console effect called under a secret pc (review control)
-- spec: spec/07 §3
-- expect: error U4002 at 12:5
module inferred_helper_under_pc

ping() -> Unit = @console.print("ping")

pub leak(flag: secret Bool) -> Unit
  uses @console: Console[print]
=
  if flag
    ping()
  else
    unit
