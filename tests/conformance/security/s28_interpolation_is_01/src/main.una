-- test: `is` against a text literal that interpolates a `secret` value would give a `public` `Bool` decided by the secret; a pattern is a constant, so it is U4008 (S-28), edition 0.1
-- spec: spec/07 §7
-- expect: error U4008 at src/main.una:9:16
module main

pub check(g: Text) -> Bool
=
  let s: secret Text = "abc"
  let b = g is "{s}"
  b
