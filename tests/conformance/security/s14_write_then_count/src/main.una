-- test: after a write to an `internal` path, how many of a list of files exist is `internal` too (S-14)
-- spec: spec/07 §7
-- expect: error U4001 at src/main.una:10:3
module main

exists(name: Text) -> Bool
  uses @files: Files[read]
=
  let r = attempt @files.read(name)
  is_ok(r)

pub probe(secret_path: internal Text) -> Unit
  uses @files: Files[read, write]
  uses @console: Console[print]
=
  let w = attempt @files.write(secret_path, content: "x")
  let found = ["a.txt", "b.txt", "c.txt"].filter(keep: fn(n) -> exists(n))
  @console.print("{found.len} of the files exist")
