-- test: in edition 0.1, after a write to an `internal` path, how many of a list of files exist is `internal` too (S-14)
-- spec: spec/07 §7
-- expect: error U4001 at src/main.una:10:6
module main

exists(name: Text) -> Int
  uses @files: Files[read]
=
  let r = attempt @files.read(name)
  if is_ok(r) then 1 else 0

pub probe(secret_path: internal Text) -> Unit
  uses @files: Files[read, write]
  uses @console: Console[print]
=
  let w = attempt @files.write(secret_path, content: "x")
  let a = exists("a.txt")
  let b = exists("b.txt")
  @console.print("{a + b} of the files exist")
