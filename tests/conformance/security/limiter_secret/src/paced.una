-- test: a `limiter` installed over a statement that computes on a `secret` is U4001 at the binding: whether `acquire` finds a token depends on the timing of that statement, and `Limited` carries `internal` (spec/27 §10, ADR 0117 rule 9, IF5)
-- spec: spec/27 §10
-- expect: error U4001 at 20:19
module paced

import std.limit (Limit, limiter)
import std.time (second)

crunch(key: secret Int) -> secret Int = key * 3

serve(key: secret Int) -> Unit
  uses @gate: Limit[acquire]
=
  let spent = crunch(key)
  let got = attempt @gate.acquire()
  unit

pub run(key: secret Int) -> Unit
=
  serve(key) with @gate = limiter(at_most: 1, per: second, waiting: 0)
