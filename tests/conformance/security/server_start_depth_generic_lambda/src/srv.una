-- test: a task that calls a function value and recurses through a generic function, on `internal` data only, is accepted, though the package holds a generic function with a lambda that branches on a value of its type parameter: the task holds no data above `internal` (spec/31 §1, ADR 0123 IF6, #1674)
-- spec: spec/31 §1
-- expect: ok
module srv

import std.host (Exchange, HttpServer, Reply)

one(n: Int) -> Int = n

pub largest[T: Ord](xs: List[T],
  floor: T
) -> List[Int] = xs.map(each: fn(x) -> if x > floor then one(1) else 0)

grec[T](x: T, n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    grec(x, n: n - 1)

answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  let f = fn() -> 1
  let n = f()
  let g = grec(exchange.request.body, n: exchange.request.body.len)
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

serve_all(exchanges: internal List[Exchange]) -> Unit
  uses @server: HttpServer[reply]
=
  tasks
    for exchange in exchanges
      start answer(exchange)
