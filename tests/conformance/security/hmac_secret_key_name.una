-- test: the key name of Keys.hmac accepts only public data, since its failure reveals it (R-015)
-- spec: spec/07 §7
-- expect: error U4003 at 11:24
module hmac_secret_key_name

-- Promoted from the v0.1 review, adversarial `flow-host-op-fails-on-secret.una`.
pub probe(name: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: name, data: "x")
    if error pass
