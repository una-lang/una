-- test: a function type is contravariant in its parameters and covariant in its result at a branch join (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:3
-- expect: error U4001 at 21:3
module sweep_variance_fn_join

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub join_0(c: Bool, v: fn(Int) -> secret Int, w: fn(Int) -> Int) -> fn(Int) -> Int
=
  let j = if c then w else v
  j

pub join_1(c: Bool, v: fn(Int) -> Int, w: fn(secret Int) -> Int) -> fn(secret Int) -> Int
=
  let j = if c then w else v
  j

pub join_2(c: Bool, v: fn(secret Int) -> Int, w: fn(Int) -> Int) -> fn(Int) -> Int
=
  let j = if c then w else v
  j

pub join_3(c: Bool, v: fn(Int) -> Int, w: fn(Int) -> secret Int) -> fn(Int) -> secret Int
=
  let j = if c then w else v
  j
