-- test: ADR 0067 recheck of #231, N06b_let_then_return: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n06b.una:11:34
module n06b

pick[U](x: U, y: U, p: U, q: U) -> U
=
  let r = if x == y then p else q
  r

pub leak(s: secret Int) -> Int = pick([s], y: [0], p: [], q: [1, 2]).len
