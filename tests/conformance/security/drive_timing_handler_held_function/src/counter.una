-- test: the timing label of a driven step joins what the handlers it installs can run: one whose parameter is a kind with a field of function type is `⊤`, whatever function the field holds (spec/26 §2 rule 5 item 3, ADR 0116 IF7, issue #1436)
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:24:34
module counter

import std.drive (Tick)

kind Holder
  run: fn(Int) -> Int

capability Store
  op load() -> Int

handler held(h: Holder) for Store
  op load() = h.run(0)

use_store() -> Int
  uses @store: Store[load]
=
  @store.load()

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
=
  let h = Holder(run: fn(x: Int) -> x + count)
  let loaded = use_store() with @store = held(h: h)
  count = count + loaded
