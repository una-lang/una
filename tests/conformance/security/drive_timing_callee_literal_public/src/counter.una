-- test: a driven step that calls a function computing only on `public` values made from its own literals has a `public` timing label, and its `input` needs no label (spec/26 §2, ADR 0116 IF5, IF7, #1685, `docs/plan/0116-tau-item7-amendment-draft.md`): the accepted twin of `drive_timing_callee_literal_secret`
-- spec: spec/26 §2
-- expect: ok
module counter

import std.drive (Tick)

spin(n: Int) -> Int
=
  let edit acc = 0
  for i in 0..<n
    acc = acc + 1
  acc

shown() -> Unit
=
  let k = 3000
  let r = spin(k)
  unit

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
=
  shown()
  count = count + 1
