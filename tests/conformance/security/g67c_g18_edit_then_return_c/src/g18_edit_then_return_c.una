-- test: ADR 0067 amendment (2026-10-06), G18_edit_then_return_c: a T value decided by comparing T values goes where a value of T is expected (a lambda, a higher-order function, a function result, an `edit` binding or a field of the body), which edition 0.2 rejects in the generic body; the control, sound, is rejected there, an accepted cost, since accepting it soundly would need re-checking lambdas (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/g18_edit_then_return_c.una:10:9
module g18_edit_then_return_c

pick[T](a: T, b: T, p: T, q: T) -> T
=
  let edit r = q
  if a == b
    r = p
  r

pub leak(s: Int) -> Int = pick([s], b: [0], p: [], q: [1, 2]).len
