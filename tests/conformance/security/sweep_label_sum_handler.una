-- test: a sum kind with a secret variant field: a handler operation result keeps the field labels of the declared result (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 34:3
module sweep_label_sum_handler

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Guess) -> secret Int
=
  when x
    is Hit(pin) -> pin
    is Miss -> 0

capability Store
  op fetch() -> Guess

handler fixed() for Store
  op fetch() = Hit(pin: 2)

pub fetched() -> Bool
  uses @store: Store[fetch]
=
  let x = @store.fetch()
  x == Hit(pin: 2)

pub installed() -> secret Bool
=
  fetched_twin() with @store = fixed()

fetched_twin() -> secret Bool
  uses @store: Store[fetch]
=
  let x = @store.fetch()
  x == Hit(pin: 2)
