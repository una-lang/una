-- test: label order shape `option-of-list-leak` (#323, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:16:18
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit o = None
  o = Some([1])
  let early = o.or_else(default: [])
  o = Some([s.len])
  @console.print("{early}")
