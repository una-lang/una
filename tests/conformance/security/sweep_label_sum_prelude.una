-- test: a sum kind with a secret variant field: prelude results carry the field labels of their element and argument types (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 38:43
-- expect: error U4001 at 40:40
-- expect: error U4001 at 42:37
-- expect: error U4001 at 44:46
-- expect: error U4001 at 46:40
-- expect: error U4001 at 48:43
-- expect: error U4001 at 50:38
-- expect: error U4001 at 52:43
-- expect: error U4001 at 54:46
-- expect: error U4001 at 56:40
-- expect: error U4001 at 58:44
-- expect: error U4001 at 60:43
-- expect: error U4001 at 62:30
-- expect: error U4001 at 64:30
-- expect: error U4001 at 66:30
module sweep_label_sum_prelude

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Guess) -> secret Int
=
  when x
    is Hit(pin) -> pin
    is Miss -> 0

pub p_contains(xs: List[Guess]) -> Bool = xs.contains(item: Hit(pin: 2))

pub p_first(xs: List[Guess]) -> Bool = xs.first() is Some

pub p_at(xs: List[Guess]) -> Bool = xs.at(index: 0) is Some

pub p_first_where(xs: List[Guess]) -> Bool = xs.first_where(keep: fn(y) -> true) is Some

pub p_filter(xs: List[Guess]) -> Int = xs.filter(keep: fn(y) -> true).len

pub p_map(xs: List[Guess]) -> List[Int] = xs.map(each: fn(y) -> 1)

pub p_fold(xs: List[Guess]) -> Int = xs.fold(initial: 0, step: fn(n, y) -> n + 1)

pub p_is_some(o: Option[Guess]) -> Bool = o.is_some()

pub p_is_ok(r: Result[Guess, Int]) -> Bool = r.is_ok()

pub p_append(xs: List[Guess]) -> Int = xs.append(item: Hit(pin: 2)).len

pub p_or_else(o: Option[Guess]) -> Guess = o.or_else(default: Hit(pin: 2))

pub p_is_empty(xs: List[Guess]) -> Bool = xs.is_empty()

pub p_sum(x: Guess) -> Int = [grab(x)].sum()

pub p_min(x: Guess) -> Int = min(grab(x), b: 0)

pub p_max(x: Guess) -> Int = max(grab(x), b: 0)

pub p_len_twin(xs: List[Guess]) -> Int = xs.len
