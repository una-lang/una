trusted module release

import std.time (millisecond)

pub kind ViaError = | Gone

pub policy key_of
  from secret Text
  to internal Hashed
  via hmac_it
  purpose "a keyed hash of the text"
  owner privacy

hmac_it(t: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails ViaError
=
  @keys.hmac(key_name: "pepper", data: t) within 1 * millisecond
    if error fail Gone
