-- test: a trusted `via` policy whose `Keys.hmac` call has a `within` is not plain (ADR 0098 rule 2): its failure is decided by the timing of the `secret` data `hmac` reads (ADR 0117 IF2), so a public print that branches on it is refused
-- spec: spec/27 §5
-- expect: error U4003 at src/main.una:16:18
module main

import release (ViaError, key_of)

pub probe(t: secret Text) -> Unit
  uses @keys: Keys[hmac]
  uses @console: Console[print]
=
  let k = attempt key_of(t)
  let shown = when k
    is Ok(v) -> "in time"
    is Err(e) -> "timed out"
  @console.print(shown)
