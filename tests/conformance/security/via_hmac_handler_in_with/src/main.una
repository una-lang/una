-- test: a Keys handler installed by a with around a call of the policy keeps its failure at the to label: the handler, not the key name, decides whether it fails (ADR 0098)
-- spec: spec/07 §5
-- expect: error U4002 at src/main.una:13:5
module main

import release (key_of)

pub passes(t: secret Text) -> Unit
  uses @keys: Keys[hmac]
  fails KeyError
=
  let k = key_of(t)
    if error pass
  unit

handler failing_keys() for Keys
  op hmac(key_name, data) = fail UnknownKey

pub faked(t: secret Text) -> Unit
  fails KeyError
=
  passes(t) with @keys = failing_keys()
    if error pass
