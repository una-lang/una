-- test: a function type is contravariant in its parameters and covariant in its result at a return (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 13:57
-- expect: error U4001 at 15:57
module sweep_variance_fn_return

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub ret_0(v: fn(Int) -> secret Int) -> fn(Int) -> Int = v

pub ret_1(v: fn(Int) -> Int) -> fn(secret Int) -> Int = v

pub ret_2(v: fn(secret Int) -> Int) -> fn(Int) -> Int = v

pub ret_3(v: fn(Int) -> Int) -> fn(Int) -> secret Int = v
