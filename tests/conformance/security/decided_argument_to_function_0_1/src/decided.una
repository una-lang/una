-- test: in edition 0.1, under D-137, a function value called with an argument chosen by comparing values of a type parameter raises the call's result by them, so writing that result to a public sink is U4003; a value of the type parameter passed through stays accepted (spec/07 §7 rule 8, #253)
-- spec: spec/07 §7
-- expect: error U4001 at src/decided.una:14:13
-- expect: error U4003 at src/decided.una:15:14
module decided

pub capability Log
  op write(n: Int) -> Unit

--- The argument of `k` is chosen by comparing `T` values, so what `k` returns depends on them.
apply[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let n = k(if a == b then p else q)
  @log.write(n)

--- A value of `T` passed through: `k` is checked against the caller's type argument.
pass_through[T](p: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let n = k(p)
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  apply([s], b: [0], p: [], q: [1, 2], k: fn(xs) -> xs.len)

pub fine(xs: List[Int]) -> Unit
  uses @log: Log[write]
=
  pass_through(xs, k: fn(ys) -> ys.len)
