-- test: `Result` is covariant in both arguments at a branch join (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:3
-- expect: error U4001 at 21:3
module sweep_variance_result_join

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub join_0(c: Bool, v: Result[secret Int, Int], w: Result[Int, Int]) -> Result[Int, Int]
=
  let j = if c then w else v
  j

pub join_1(c: Bool, v: Result[Int, secret Int], w: Result[Int, Int]) -> Result[Int, Int]
=
  let j = if c then w else v
  j

pub join_2(c: Bool, v: Result[Int, Int], w: Result[secret Int, secret Int]) -> Result[secret Int,
  secret Int
]
=
  let j = if c then w else v
  j
