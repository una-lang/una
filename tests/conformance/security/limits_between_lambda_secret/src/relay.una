-- test: the code between two requests through a lambda and a handler (ADR 0116 P11): `Λ`'s summaries join every lambda's, and the lambda that the handler `relay` calls runs `twice`, which works on a captured `secret` between its two requests: U4001 at the request in `fetch`
-- spec: spec/27 §9
-- expect: error U4001 at src/relay.una:13:25
module relay

capability Work
  op go(url: Text) -> Unit

--- One request, whose failure it handles.
fetch(url: Text) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

twice(url: Text, key: secret Int) -> Unit
  uses @http: Http[get]
=
  fetch(url)
  let spent = key * 3
  fetch(url)

handler relay(each: fn(Text) -> Unit uses @http: Http[get]) for Work
  uses @http: Http[get]
  op go(url) = each(url)

serve(url: Text) -> Unit
  uses @work: Work[go]
=
  @work.go(url)

pub run(url: Text, key: secret Int) -> Unit
  uses @http: Http[get]
=
  serve(url) with @work = relay(each: fn(u) -> twice(u, key))
