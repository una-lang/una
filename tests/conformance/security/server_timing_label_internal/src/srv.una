-- test: in a package that performs an operation of `HttpServer`, the serve threads' work after it labels every timing site at least `internal` (`L_srv`), so passing on the failure of a `within` outside the server is U4002 (spec/31 §1, ADR 0123 S4 amendment IF-S1)
-- spec: spec/31 §1
-- expect: error U4002 at src/srv.una:17:5
module srv

import std.host (HttpServer)
import std.time (second)

pub kind Slow = | TimedOut

work(n: Int) -> Int = n + 1

timed(n: Int) -> Int
  fails Slow
=
  work(n) within 5 * second
    if error pass

pub main() -> Unit
  uses @server: HttpServer[close]
=
  @server.close()
