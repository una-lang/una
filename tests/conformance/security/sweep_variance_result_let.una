-- test: `Result` is covariant in both arguments at an annotated `let` (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:29
-- expect: error U4001 at 20:29
module sweep_variance_result_let

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub let_0(v: Result[secret Int, Int]) -> Int
=
  let w: Result[Int, Int] = v
  0

pub let_1(v: Result[Int, secret Int]) -> Int
=
  let w: Result[Int, Int] = v
  0

pub let_2(v: Result[Int, Int]) -> Int
=
  let w: Result[secret Int, secret Int] = v
  0
