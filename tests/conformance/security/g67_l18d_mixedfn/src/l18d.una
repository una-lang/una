-- test: ADR 0067 adversarial check of #231, L18d_mixedfn: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l18d.una:11:3
module l18d

pick[T, U](a: T, b: T, x: U, y: U) -> U = if a == b then x else y

pub leak(s: secret Int) -> Int
=
  let g = pick(s, b: 0, x: fn(n: Int) -> 1, y: fn(n: Int) -> 2)
  g(0)
