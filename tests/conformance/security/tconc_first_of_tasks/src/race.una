-- test: precise `τ_conc` of a race (ADR 0116 C, `spec/27 §11`): a started task prints the winner of a `first of` of two `public` branches, beside a started task that works on a `secret`, so `τ_conc` of the race, and its value, are `secret` (U4003 at the print)
-- spec: spec/27 §11
-- expect: error U4003 at src/race.una:22:18
module race

crunch(key: secret Int) -> secret Int = key * 3

churn(key: secret Int) -> Unit
=
  let spent = crunch(key)
  unit

step(n: Int) -> Int = n + 1

--- Prints which of two `public` branches won: the value carries the race's timing label.
report(n: Int) -> Unit
  uses @console: Console[print]
=
  let v = first of
    step(n)
    step(n + 1)
  @console.print("{v}")

--- Starts `churn(key)` and `report(n)`, which run beside each other.
pub serve(key: secret Int, n: Int) -> Unit
  uses @console: Console[print]
=
  tasks
    start churn(key)
    start report(n)
  unit
