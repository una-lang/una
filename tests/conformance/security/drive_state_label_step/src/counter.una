-- test: the host hands the state that `init` returns to `step`, so its label flows into the label of `step`'s state parameter: a `secret` state given to an unlabeled parameter is U4001 (spec/26 §2)
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:10:22
module counter

import std.drive (Tick)

pub init() -> secret Int = 42

pub step(edit count: Int, input: Tick) -> Unit
  uses @console: Console[print]
=
  @console.print("{count}")
