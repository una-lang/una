-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, the review matrix): accept: control: failer(decided, f: k) if error use 7, then a write
-- spec: spec/07 §7
-- expect: ok
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

failer[U](x: U, f: fn(U) -> Int) -> Int
  fails Bad
=
  if f(x) > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let n = failer(p, f: k)
    if error use 7
  @log.write(1)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
