-- test: `List` is covariant at a constructor field (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:54
module sweep_variance_list_field

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

kind Hold0
  w: List[Int]

pub field_0(v: List[secret Int]) -> Hold0 = Hold0(w: v)

kind Hold1
  w: List[secret Int]

pub field_1(v: List[Int]) -> Hold1 = Hold1(w: v)
