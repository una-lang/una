-- test: a secret-chosen function value passed for a user parameter named by `uses of` or `fails of`, directly, through a relay and into constrained generics, is U4001 at the argument, as edition 0.1 reports for the same functions without `of` clauses; `sort` and `contains` keep the labels of their arguments (spec/07 §7, ADR 0062, ADR 0066, #210)
-- spec: spec/07 §7
-- expect: error U4001 at src/userof.una:44:13
-- expect: error U4001 at src/userof.una:49:13
-- expect: error U4001 at src/userof.una:54:22
-- expect: error U4001 at src/userof.una:59:21
-- expect: error U4001 at src/userof.una:64:3
-- expect: error U4001 at src/userof.una:66:55
module userof

positive(x: Int) -> Bool = x > 0

negative(x: Int) -> Bool = x < 0

count[T](xs: List[T], keep: fn(T) -> Bool) -> Int
  uses of keep
  fails of keep
=
  let kept = xs.filter(keep)
    if error pass
  kept.len

relay[T](xs: List[T], keep: fn(T) -> Bool) -> Int
  uses of keep
  fails of keep
=
  count(xs, keep)
    if error pass

best[T: Ord](xs: List[T], floor: T, better: fn(T, T) -> T) -> T
  uses of better
=
  xs.fold(initial: floor, step: better)

same[T: Eq](xs: List[T], item: T, keep: fn(T) -> Bool) -> Bool
  uses of keep
=
  let kept = xs.filter(keep)
  xs.contains(item) and kept.len > 0

pub through_user(s: secret Bool, xs: List[Int]) -> Int
=
  let keep = if s then positive else negative
  count(xs, keep)

pub through_relay(s: secret Bool, xs: List[Int]) -> Int
=
  let keep = if s then positive else negative
  relay(xs, keep)

pub through_ord(s: secret Bool, xs: List[Int]) -> Int
=
  let better = if s then fn(a: Int, b: Int) -> max(a, b: b) else fn(a: Int, b: Int) -> min(a, b: b)
  best(xs, floor: 0, better)

pub through_eq(s: secret Bool, xs: List[Int]) -> Bool
=
  let keep = if s then positive else negative
  same(xs, item: 1, keep)

pub sorted(s: secret Bool, xs: List[Int]) -> List[Int]
=
  let chosen = if s then xs else []
  chosen.sort()

pub contained(s: secret Int, xs: List[Int]) -> Bool = xs.contains(item: s)
