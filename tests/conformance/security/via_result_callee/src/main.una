-- test: a deadline outcome reaches the result of a `via` function (#1673): the `within` in a function that the `via` body calls decides that function's `restricted` result, which the `via` body returns unchecked, and the policy is called in a branch of `together` beside work on a `secret` key, so the site's concurrent label is above `public` (U4001 at the `within`)
-- spec: spec/07 §5
-- expect: error U4001 at src/release.una:19:27
module main

import release (key_of)

crunch(key: secret Int) -> secret Int
=
  let edit acc = key
  for i in 0..1000
    acc = if acc > 0 then acc - 1 else acc + 1
  acc

--- The policy is called in a branch of `together`, beside a branch that works on `key`.
pub both(key: secret Int, n: internal Int) -> Int
=
  together
    let a = crunch(key)
    let b = key_of(n)
  b
