-- test: ADR 0067 recheck of #231, F07_named_generic_callback: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f07.una:10:34
module f07

size[V](xs: List[V]) -> Int = xs.len

apply[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Int = k(if a == b then p else q)

pub leak(s: secret Int) -> Int = apply([s], b: [0], p: [], q: [1, 2], k: size)
