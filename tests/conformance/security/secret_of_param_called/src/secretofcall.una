-- test: calling an `of` parameter whose function type is `secret` runs the caller's effects under a `secret` condition, which this function cannot see, so it is U4002, as calling the parameter under a `secret` condition is (spec/07 §3 rule 4, spec/07 §7 rule 9, #216)
-- spec: spec/07 §3
-- expect: error U4002 at src/secretofcall.una:14:3
-- expect: error U4001 at src/secretofcall.una:23:24
-- expect: error U4002 at src/secretofcall.una:23:24
module secretofcall

pub kind Oops = | Bad

--- The choice of `keep` is secret, and it runs effects its caller chose.
pub run(keep: secret fn(Int) -> Bool, x: Int) -> secret Bool
  uses of keep
=
  keep(x)

--- The same parameter without an `of` clause runs no effects, so the call is allowed.
pub pure_run(keep: secret fn(Int) -> Bool, x: Int) -> secret Bool = keep(x)

--- Passed on for another `of` parameter, it runs there under its label too.
pub relay(keep: secret fn(Int) -> Bool, xs: List[Int]) -> secret Int
  uses of keep
=
  let kept = xs.filter(keep)
  kept.len
