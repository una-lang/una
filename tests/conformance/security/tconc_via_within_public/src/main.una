-- test: the twin of `tconc_via_within`: the handler's parameter is `public`, so the `within` around the policy call is `public`
-- spec: spec/07 §5
-- expect: ok
module main

import release (key_of)
import std.time (millisecond)

--- The deadline bounds the call of the policy, and so the run of its `via` function.
pub probe(n: Int) -> Int
=
  let w: Int = key_of(n) within 10 * millisecond
    if error use 0
  w
