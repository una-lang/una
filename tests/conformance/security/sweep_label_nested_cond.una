-- test: nested kinds and generics holding a secret: an `if` or `when` on a comparison of it raises the program counter (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 34:61
-- expect: error U4003 at 40:5
-- expect: error U4003 at 42:5
-- expect: error U4003 at 48:16
-- expect: error U4003 at 49:17
-- expect: error U4001 at 53:63
-- expect: error U4003 at 59:5
-- expect: error U4003 at 61:5
-- expect: error U4003 at 67:16
-- expect: error U4003 at 68:17
-- expect: error U4001 at 72:42
-- expect: error U4003 at 78:5
-- expect: error U4003 at 80:5
-- expect: error U4003 at 86:16
-- expect: error U4003 at 87:17
module sweep_label_nested_cond

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab_boxed_list(x: Box[List[secret Int]]) -> secret Int = x.value.sum()

pub chosen_boxed_list(x: Box[List[secret Int]]) -> Int = if x == Box(value: [2]) then 1 else 0

pub printed_boxed_list(x: Box[List[secret Int]]) -> Unit
  uses @console: Console[print]
=
  if x == Box(value: [2])
    @console.print("hit")
  else
    @console.print("miss")

pub matched_boxed_list(x: Box[List[secret Int]]) -> Unit
  uses @console: Console[print]
=
  when x == Box(value: [2])
    is true -> @console.print("hit")
    is false -> @console.print("miss")

grab_option_box(x: Option[Box[secret Int]]) -> secret Int = x.or_else(default: Box(value: 0)).value

pub chosen_option_box(x: Option[Box[secret Int]]) -> Int = if x == Some(Box(value: 2)) then 1 else 0

pub printed_option_box(x: Option[Box[secret Int]]) -> Unit
  uses @console: Console[print]
=
  if x == Some(Box(value: 2))
    @console.print("hit")
  else
    @console.print("miss")

pub matched_option_box(x: Option[Box[secret Int]]) -> Unit
  uses @console: Console[print]
=
  when x == Some(Box(value: 2))
    is true -> @console.print("hit")
    is false -> @console.print("miss")

grab_wallet(x: Wallet) -> secret Int = x.acct.pin

pub chosen_wallet(x: Wallet) -> Int = if x == Wallet(acct: Acct(id: 1, pin: 2)) then 1 else 0

pub printed_wallet(x: Wallet) -> Unit
  uses @console: Console[print]
=
  if x == Wallet(acct: Acct(id: 1, pin: 2))
    @console.print("hit")
  else
    @console.print("miss")

pub matched_wallet(x: Wallet) -> Unit
  uses @console: Console[print]
=
  when x == Wallet(acct: Acct(id: 1, pin: 2))
    is true -> @console.print("hit")
    is false -> @console.print("miss")
