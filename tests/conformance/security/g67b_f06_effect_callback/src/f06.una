-- test: ADR 0067 recheck of #231, F06_effect_callback: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4003 at src/f06.una:17:53
module f06

pub capability Log
  op write(n: Int) -> Unit

apply[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit) -> Unit
  uses of k
=
  k(if a == b then p else q)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  apply([s], b: [0], p: [], q: [1, 2], k: fn(xs) -> @log.write(xs.len))
