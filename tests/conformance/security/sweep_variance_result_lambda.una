-- test: `Result` is covariant in both arguments at a lambda result (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:45
-- expect: error U4001 at 20:45
module sweep_variance_result_lambda

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub lam_0(v: Result[secret Int, Int]) -> Int
=
  let f: fn() -> Result[Int, Int] = fn() -> v
  0

pub lam_1(v: Result[Int, secret Int]) -> Int
=
  let f: fn() -> Result[Int, Int] = fn() -> v
  0

pub lam_2(v: Result[Int, Int]) -> Int
=
  let f: fn() -> Result[secret Int, secret Int] = fn() -> v
  0
