-- test: ADR 0067 adversarial check of #231, L07_failchannel: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4002 at src/l07.una:13:5
-- expect: error U3007 at src/l07.una:19:3
module l07

kind Boom = | Exploded

guard[T](a: T, b: T) -> Int
  fails Boom
=
  if a == b
    fail Exploded
  0

pub leak(s: secret Int) -> Int
  fails Boom
=
  guard(s, b: 0)
