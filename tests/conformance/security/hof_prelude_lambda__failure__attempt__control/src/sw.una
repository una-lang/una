-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, the review matrix): accept: control: attempt of a failing k inside an annotated lambda, which is pure
-- spec: spec/07 §7
-- expect: ok
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int fails Bad) -> Unit
  uses @log: Log[write]
=
  let n = [p].map(each: fn(x: T) -> attempt k(x))
  let m = when n.first()
    is Some(r) -> if r is Ok then 1 else 0
    is None -> 2
  @log.write(m)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: check_len)
