-- test: the body of `for until c` runs under the label of `c`, since how many iterations run depends on it, so every binding it updates is labeled at least that (spec/26 §4, ADR 0116 IF1)
-- spec: spec/26 §4
-- expect: error U4001 at src/flows.una:12:9
-- expect: error U4001 at src/flows.una:13:13
module flows

pub count(s: secret Int) -> Int
=
  let edit i = 0
  let edit steps = 0
  for until i >= s decreases s - i
    i = i + 1
    steps = steps + 1
  steps
