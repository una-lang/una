-- test: function values: equality on function values is rejected by construction, and equality on their results is labeled (label sweep)
-- spec: spec/07 §7
-- expect: error U2001 at 17:39
-- expect: error U4001 at 17:39
-- expect: error U4001 at 19:40
-- expect: error U4001 at 24:3
module sweep_label_fnvalue_eq

low(x: Int) -> Int = x

high(x: Int) -> Int = x + 1

pick(pin: secret Int) -> secret fn(Int) -> Int = if pin > 0 then low else high

is_pin[T](x: T, y: T) -> Int = if x == y then 1 else 0

pub values(pin: secret Int) -> Bool = pick(pin) == low

pub results(pin: secret Int) -> Bool = pick(pin)(1) == 1

pub captured(pin: secret Int) -> Bool
=
  let f = fn(x: Int) -> x + pin
  f(1) != 1

pub results_twin(pin: secret Int) -> secret Bool = pick(pin)(1) == 1

pub captured_twin(pin: secret Int) -> secret Bool
=
  let f = fn(x: Int) -> x + pin
  f(1) != 1
