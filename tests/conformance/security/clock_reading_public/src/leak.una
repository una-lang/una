-- test: a run whose code handles only `public` data gives `public` readings of `Clock.now` (ADR 0116 amendment of 2026-11-09, C1, migration item 1): printing the elapsed time of `public` work is accepted
-- spec: spec/14 §3
-- expect: ok
module leak

work(n: Int) -> Int = n * n

pub show(n: Int) -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let start = @clock.now()
  let squared = work(n)
  let stop = @clock.now()
  @console.print("{stop - start} ms")
