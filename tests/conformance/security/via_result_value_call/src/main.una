-- test: a `via` that calls a function value can only call one that code it reaches makes, a lambda written there or a function it names as a value, when no function value can come from outside that code (#1710): `reveal_it` names `bump` and passes it to `twice`, so the lambda of `tally`, whose `within` runs beside the tasks of `pair`, is not code the `via` reaches, and the package is accepted; its negative twin `via_result_handler_value` gets the function value from a handler installed by the policy's caller (spec/07 §5 rule 7)
-- spec: spec/07 §5
-- expect: ok
module main

import release (key_of)
import std.time (millisecond)

timed(t: Int) -> restricted Int
=
  let v: restricted Int = t within 1 * millisecond
    if error use 0
  v

pub tally(n: Int) -> List[restricted Int] = [n].map(each: fn(x: Int) -> timed(x))

pub pair(a: Int, b: Int) -> Int
=
  together
    let x = a + 1
    let y = b + 1
  x + y

--- The policy is called from sequential code.
pub once(n: internal Int) -> Int = key_of(n)
