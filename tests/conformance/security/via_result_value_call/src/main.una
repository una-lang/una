-- test: a `via` that calls a function value reaches every lambda's code and every function named as a value (#1673): the `within` that a lambda of `tally` runs, beside the tasks of `pair`, is refused although the policy is called from sequential code, a stated over-approximation of `spec/07 §5` rule 7 (U4001 at the `within`)
-- spec: spec/07 §5
-- expect: error U4001 at src/main.una:11:27
module main

import release (key_of)
import std.time (millisecond)

timed(t: Int) -> restricted Int
=
  let v: restricted Int = t within 1 * millisecond
    if error use 0
  v

pub tally(n: Int) -> List[restricted Int] = [n].map(each: fn(x: Int) -> timed(x))

pub pair(a: Int, b: Int) -> Int
=
  together
    let x = a + 1
    let y = b + 1
  x + y

--- The policy is called from sequential code.
pub once(n: internal Int) -> Int = key_of(n)
