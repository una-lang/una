-- test: ADR 0067 recheck of #231, N06_elem_param_pos: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n06.una:11:19
module n06

wrap[U](x: U, y: U, p: U, q: U) -> List[U] = [if x == y then p else q]

pub leak(s: secret Int) -> Int
=
  when wrap([s], y: [0], p: [], q: [1, 2]).first
    is Some(v) -> v.len
    is None -> 0
