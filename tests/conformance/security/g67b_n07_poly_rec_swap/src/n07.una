-- test: ADR 0067 recheck of #231, N07_poly_rec_swap: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n07.una:12:34
module n07

f[T, U](a: T, b: U, ka: T, kb: U,
  n: Int
) -> List[Int] = if n <= 0 then (if b == kb then [1] else []) else f(b, b: a, ka: kb,
  kb: ka, n: n - 1
)

pub leak(s: secret Int) -> Int = f(s, b: 0, ka: 5, kb: 0, n: 1).len
