-- test: the history of a limit (ADR 0116 P8, ADR 0117 IF4): the twin of `limits_history_secret` whose work between the two requests is on `public` data, the same program but for that label, so every ancestor of the request is timed by `internal` data at most, and the limits are accepted
-- spec: spec/27 §9
-- expect: ok
module history

--- One request, whose failure it handles.
fetch(url: Text) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

crunch(key: Int) -> Int = key * 3

pub run(url: Text, key: Int) -> Unit
  uses @http: Http[get]
=
  fetch(url)
  let spent = crunch(key)
  fetch(url)
