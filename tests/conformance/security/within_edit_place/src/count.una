-- test: the places `e within d` updates must be labeled at least its timing label (ADR 0117 IF2): `count_step(edit n, data: secret) within d` with `n` labeled `public` is U4001 at `n`
-- spec: spec/27 §5
-- expect: error U4001 at src/count.una:15:20
module count

import std.time (millisecond)

count_step(edit n: public Int, data: secret Int) -> Unit
=
  n = n + 1

pub counted(data: secret Int) -> public Int
=
  let edit n: public Int = 0
  count_step(edit n, data: data) within 10 * millisecond
    if error use unit
  n
