-- test: a kind whose parameter is inside a function type is invariant at a return (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 13:47
-- expect: error U4001 at 15:47
module sweep_variance_sink_return

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub ret_0(v: Sink[Int]) -> Sink[secret Int] = v

pub ret_1(v: Sink[secret Int]) -> Sink[Int] = v

pub ret_2(v: Sink[secret Int]) -> Sink[secret Int] = v
