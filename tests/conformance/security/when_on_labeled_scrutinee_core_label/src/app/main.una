-- test: `when` over a `secret` scrutinee, with a literal arm and a range arm, its result kept `secret`: accepted, and its Core export labels each comparison with the scrutinee `secret`, the label of what it decides (S-27, the test of crates/una-cli/tests/core_text_labels.rs)
-- spec: spec/07 §3
-- expect: ok
module app.main

pub main() -> Unit
  uses @console: Console[print]
=
  let s: secret Int = 3
  let r = when s
    is 3 -> 1
    in 4..9 -> 2
    else -> 3
  @console.print("done")
