module fetch

--- One request, whose failure it handles.
get_one(url: Text) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

--- Starts a task that makes a request.
pub fetch_all(url: Text) -> Unit
  uses @http: Http[get]
=
  tasks
    start get_one(url)
  unit
