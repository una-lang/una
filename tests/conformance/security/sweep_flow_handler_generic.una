-- test: a handler operation result fed by a generic call checks every flow (uses, label, fails); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/10 §2
-- expect: error U4001 at 34:14
-- expect: error U3003 at 46:14
-- expect: error U3016 at 46:17
-- expect: error U3009 at 58:14
-- expect: error U3016 at 58:17
module sweep_flow_handler_generic

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub capability SrcL
  op get() -> Int

pub capability SrcE
  op get() -> fn(Int) -> Int

pub id[T](x: T) -> T = x

pub handler l_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos,
  t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) for SrcL
  op get() = id(s)

pub handler l_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos,
  t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) for SrcL
  op get() = id(0)

pub handler e_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos,
  t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) for SrcE
  op get() = id(q)

pub handler e_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos,
  t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) for SrcE
  op get() = id(g)

pub handler x_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos,
  t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) for SrcE
  op get() = id(z)
