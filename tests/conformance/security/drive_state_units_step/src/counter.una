-- test: the host hands the result of `init` to `step` unchanged, so an `Int of Second` start may not reach an `Int of Millisecond` state, which ordinary code refuses as U2028 (spec/26 §2, issue #1647)
-- spec: spec/26 §2
-- expect: error U2028 at src/counter.una:11:22
module counter

import std.drive (Tick)
import std.time (Millisecond, Second, millisecond)

pub init() -> Int of Second = 7.measured()

pub step(edit state: Int of Millisecond, input: Tick) -> Unit
  uses @console: Console[print]
=
  state = state + millisecond
  @console.print("{state.magnitude()}")
