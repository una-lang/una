-- test: which lambda runs is chosen by a `secret` bit, and only one of them calls a function, so the call of the function value passes a `secret` number of check points: it stands under the value's label, U4002 in a program that starts tasks (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:20:5
module order

noop() -> Unit = unit

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let f = if bit(k, key: key) == 1 then fn() -> noop() else fn() -> unit
  for i in 0..<3000
    f()
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
