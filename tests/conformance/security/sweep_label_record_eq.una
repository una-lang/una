-- test: a record kind with a secret field: `==` and `!=` are labeled with the declared field labels (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 21:27
-- expect: error U4001 at 23:27
module sweep_label_record_eq

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Acct) -> secret Int = x.pin

pub eq(x: Acct) -> Bool = x == Acct(id: 1, pin: 2)

pub ne(x: Acct) -> Bool = x != Acct(id: 1, pin: 2)

pub eq_twin(x: Acct) -> secret Bool = x == Acct(id: 1, pin: 2)
