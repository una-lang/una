-- test: a task that calls a policy whose `via` recurses holds `secret` data and can recurse, so its depth may depend on that data, even through a helper whose parameter is `internal`: U4003 at the `start` (spec/31 §1, ADR 0123 IF6, #1674)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:21:7
module srv

import release (shown)
import std.host (Exchange, HttpServer, Reply)

answer(exchange: internal Exchange, key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  let t = shown(key - exchange.request.body.len)
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

serve_all(exchanges: internal List[Exchange], key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  tasks
    for exchange in exchanges
      start answer(exchange, key: key)
