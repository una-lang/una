--- Releases a constant, but its `via` recurses on the `secret` amount through a helper whose
--- parameter is `internal`, which a `via` body, checked without labels, may pass.
trusted module release

pub policy shown
  from secret Int
  to internal Text
  via written
  purpose "answer whether a balance is positive"
  owner tests

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

written(cents: secret Int) -> secret Text = if deep(cents) >= 0 then "known" else "never"
