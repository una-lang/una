-- test: ADR 0067 recheck of #231, P05d_generic_named_fails: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4002 at src/p05d.una:19:32
-- expect: error U4002 at src/p05d.una:19:66
module p05d

kind Boom = | Exploded

check[T](x: T, k: T, n: Int) -> Bool
  fails Boom
=
  if n == 7
    fail Exploded
  x == k

scan[T](xs: List[T], k: T) -> Option[T]
  fails Boom
=
  let r = xs.first_where(keep: fn(x) -> if k == k then true else fail Exploded)
    if error pass
  r

pub leak(xs: List[secret Int]) -> Bool
  fails Boom
=
  let r = scan(xs, k: 1)
    if error pass
  true
