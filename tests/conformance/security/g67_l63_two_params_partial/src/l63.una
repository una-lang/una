-- test: ADR 0067 adversarial check of #231, L63_two_params_partial: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l63.una:8:34
module l63

tagged[T, U](a: T, b: T, u: U) -> List[U] = if a == b then [u] else [u, u]

pub leak(s: secret Int) -> Int = tagged(s, b: 0, u: 1).len
