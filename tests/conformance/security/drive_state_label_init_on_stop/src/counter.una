-- test: the host hands the state that `init` returns to `on_stop` when it stops before the first tick, so the result of `init` flows into the label of `on_stop`'s parameter too: a `secret` start given to an unlabeled parameter is U4001 (spec/26 §2)
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:14:20
module counter

import std.drive (Tick)

pub init() -> secret Int = 42

pub step(edit count: secret Int, input: secret Tick) -> Unit
=
  count = count + 1

pub on_stop(count: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{count}")
