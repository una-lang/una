-- test: a kind whose parameter is inside a function type is invariant at a constructor field (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:47
-- expect: error U4001 at 21:54
module sweep_variance_sink_field

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

kind Hold0
  w: Sink[secret Int]

pub field_0(v: Sink[Int]) -> Hold0 = Hold0(w: v)

kind Hold1
  w: Sink[Int]

pub field_1(v: Sink[secret Int]) -> Hold1 = Hold1(w: v)

kind Hold2
  w: Sink[secret Int]

pub field_2(v: Sink[secret Int]) -> Hold2 = Hold2(w: v)
