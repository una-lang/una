-- test: in edition 0.1, a function value given a value of a type parameter, or a decision on such values (#253, review of #343): leak (U4003): the function value is a field of a generic record
-- spec: spec/07 §7
-- expect: error U4001 at src/sw.una:17:13
-- expect: error U4003 at src/sw.una:18:14
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Box[T]
  run: fn(T) -> Int

g[T](a: T, b: T, p: T, q: T, box: Box[T]) -> Unit
  uses @log: Log[write]
=
  let f = box.run
  let n = f(if a == b then p else q)
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], box: Box(run: fn(xs) -> xs.len))
