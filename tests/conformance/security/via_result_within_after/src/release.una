trusted module release

import std.time (millisecond)

pub policy key_of
  from internal Int
  to Int
  via reveal_it
  purpose "a test"
  owner privacy

--- The `via` function: whether `count(t)` meets its deadline becomes its result.
reveal_it(t: internal Int) -> Int
=
  let v: Int = count(t) within 1 * millisecond
    if error use 0
  v

count(t: internal Int) -> internal Int = t + 1
