-- test: a handler result of Sink[Int] for an operation declared to return Sink[secret Int] (N-002)
-- spec: spec/07 §7
-- expect: error U4001 at 13:15
module rv_hdl_result_kind_variance

kind Sink[T]
  eat: fn(T) -> Int

capability Source
  op sink() -> Sink[secret Int]

handler plain() for Source
  op sink() = Sink(eat: fn(x: Int) -> x)

pub via_op(pin: secret Int) -> Int
  uses @src: Source[sink]
=
  let s = @src.sink()
  s.eat(pin)

pub installed(pin: secret Int) -> Int
=
  via_op(pin) with @src = plain()

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let raw = @env.get("PIN")
    if none use ""
  let pin: secret Int = to_int(raw)
    if none use 0
  let shown = installed(pin)
  @console.print("pin is {shown}")
