-- test: precise `τ_conc` (ADR 0116 P4, P5): a `within` in a lambda that no part of a task construct reaches has `τ_conc = public`, since nothing runs beside it, so whether it timed out may flow to the `public` result; the preview gave every site in a lambda `⊤`
-- spec: spec/27 §11
-- expect: ok
module app

import std.time (millisecond)

step(n: Int) -> Int = n + 1

--- A `within` in a lambda, which no part of a task construct reaches.
pub run(n: Int) -> List[Bool] = [n].map(each: fn(x: Int) -> (attempt step(x) within 10 * millisecond).is_ok())
