-- test: the declassification tour's lookup: a policy whose `via` only calls Keys.hmac with a literal key name, its failure passed on, fails at the program counter, so `if error fail` in public code is accepted (ADR 0098); a `via` that decides its failure on the secret stays rejected (s18_via_failure_internal_to)
-- spec: spec/07 §5
-- expect: ok
module app.lookup

import app.keys (phone_key)
import app.types (Phone)

pub kind LookupError = | Unavailable

pub capability Directory
  op find(key: internal Hashed) -> Option[Text]
    accepts internal

pub name_for(phone: secret[PII] Phone) -> Option[Text]
  uses @directory: Directory[find]
  uses @keys: Keys[hmac]
  fails LookupError
=
  let key = phone_key(phone)
    if error fail Unavailable
  @directory.find(key)
