-- test: the timing label of a driven step joins the labels of the handlers it installs: here one with a `secret` argument (spec/26 §2, ADR 0116 IF7)
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:21:34
module counter

import std.drive (Tick)

capability Store
  op load() -> Int

handler fixed(value: secret Int) for Store
  op load() = 0

use_store() -> Int
  uses @store: Store[load]
=
  @store.load()

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
=
  let loaded = use_store() with @store = fixed(7)
  count = count + loaded
