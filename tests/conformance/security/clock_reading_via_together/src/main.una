-- test: the `together` form of `clock_reading_via_sequential` (ADR 0116 amendment of 2026-11-09, C7, `spec/07 §5` rule 7): the policy is called in a branch beside work on a `secret`, so the reading inside its `via` function is timed by that work, `τ_conc` included, and is U4001
-- spec: spec/07 §5
-- expect: error U4001 at src/release.una:15:13
module main

import release (stamp_of)

work(n: secret Int) -> secret Int = n * n

pub show(n: secret Int) -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  together
    let stamp = stamp_of(0)
    let squared = work(n)
  @console.print("done")
