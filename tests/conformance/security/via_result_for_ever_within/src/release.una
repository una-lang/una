trusted module release

import std.time (millisecond)

pub policy key_of
  from internal Int
  to Int
  via reveal_it
  purpose "a test"
  owner privacy

--- The `via` function: how far the loop counts before its deadline becomes its result.
reveal_it(t: internal Int) -> Int
  diverges
=
  let edit n = 0
  for ever within 1 * millisecond
    n = n + 1
  n
