-- test: a reading of `Clock.now` in `on_stop` follows the work of `init` and of every `step`, which the host calls before it with no call edge to it (ADR 0116 amendment of 2026-11-09, C1 item 4): `step` computes on a `secret` value, so the reading in `on_stop` is `secret` and its print is U4003
-- spec: spec/14 §3
-- expect: error U4003 at src/counter.una:22:18
module counter

import std.drive (Tick)

key() -> secret Int = 7

pub init() -> Int = 0

pub step(edit count: Int, input: secret Tick) -> Unit
=
  let k = key() * 2
  count = count + 1

pub on_stop(count: Int) -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let now = @clock.now()
  @console.print("{now}")
