-- test: the depth of a started task is a channel at `internal`, a known residual (#1677, as #1708 is for the count of check points): a task whose recursion an `internal` key decides runs past `--task-depth` and ends alone, and the run goes on, so whether its public print happens follows the key's bits (90 is 0b1011010: the tasks of the bits that are 0 print). Above `internal` the same program is refused, `security/task_switch_recursion` (spec/27 §7, §8 rule 5)
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "2"
-- expect: run-output "5"
-- expect: run-output "7"
module order

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

bit(k: Int, key: internal Int) -> internal Int
=
  let edit x: internal Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: internal Int) -> Unit
  uses @console: Console[print]
=
  let r = deep(bit(k, key: key) * 3000)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: internal Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
