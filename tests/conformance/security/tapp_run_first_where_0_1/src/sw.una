-- test: in edition 0.1, a function value given a value of a type parameter, or a decision on such values (#253, review of #343): leak (U4003): run form, where the printed number differs with the secret; the decided element reaches a callback of a prelude function
-- spec: spec/07 §7
-- expect: error U4001 at src/sw.una:17:59
-- expect: error U4003 at src/sw.una:21:14
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

g[T](a: T, b: T, p: T, q: T, keep: fn(T) -> Bool) -> Unit
  uses @log: Log[write]
=
  let found = [if a == b then p else q].first_where(keep: keep)
  let n = when found
    is Some(x) -> 1
    is None -> 0
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], p: [], q: [1], keep: fn(xs) -> xs.len > 0)
