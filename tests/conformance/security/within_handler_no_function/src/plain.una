-- test: a handler that a `within` reaches and whose parameters hold no function counts by their deep labels and by what its operation bodies run (ADR 0116 IF5 item 3, issue #1436): a kind of `Int` and `List[Text]` fields, an operation body that calls a function of the package or gives `map` a lambda written at the call (#1023), a lambda written at the call in the site, and the capability reached through `together` or `start`, all on `public` data, keep `if error pass` accepted; a handler that holds a function and that no deadline reaches is accepted too
-- spec: spec/27 §5
-- expect: ok
module plain

import std.time (millisecond)

pub kind E = | TimedOut

kind Config
  step: Int
  names: List[Text]

kind Holder
  run: fn(Int) -> Int

twice(x: Int) -> Int = x * 2

-- A parameter of a kind with no function in it counts by its deep label.
capability ConfigStore
  op get(key: Int) -> Int

handler configured(c: Config) for ConfigStore
  op get(key) = key + c.step + c.names.len

pub by_config(n: Int) -> Int
  fails E
=
  let c = Config(step: 2, names: ["a"])
  let a = @s.get(n) with @s = configured(c: c) within 10 * millisecond
    if error pass
  a

-- An operation body that calls a function of the package, and one that gives `map` a lambda
-- written at the call (issue #1023), count by what they run.
capability PlainStore
  op get(key: Int) -> Int

handler plain_calls() for PlainStore
  op get(key) = twice(key) + [key].map(each: fn(x: Int) -> x + 1).len

pub by_calls(n: Int) -> Int
  fails E
=
  let a = @s.get(n) with @s = plain_calls() within 10 * millisecond
    if error pass
  a

-- A lambda written at the call of `map` in the site, beside the handler.
pub by_lambda(n: Int) -> Int
  fails E
=
  let a = @s.get([n].map(each: fn(x: Int) -> x + n).len) with @s = plain_calls() within 10 * millisecond
    if error pass
  a

-- The same capability through `together` and through `tasks` with `start`.
spread(n: Int) -> Int
  uses @s: ConfigStore[get]
=
  together
    let a = @s.get(n)
    let b = n
  a + b

poke(n: Int) -> Unit
  uses @s: ConfigStore[get]
=
  let a = @s.get(n)
  unit

started(n: Int) -> Int
  uses @s: ConfigStore[get]
=
  tasks
    start poke(n)
  n

pub by_together(n: Int) -> Int
  fails E
=
  let c = Config(step: 2, names: [])
  let a = spread(n) with @s = configured(c: c) within 10 * millisecond
    if error pass
  a

pub by_start(n: Int) -> Int
  fails E
=
  let c = Config(step: 2, names: [])
  let a = started(n) with @s = configured(c: c) within 10 * millisecond
    if error pass
  a

-- A handler that holds a function, installed where no deadline reaches it.
capability HeldStore
  op get(key: Int) -> Int

handler held(h: Holder) for HeldStore
  op get(key) = h.run(key)

pub undeadlined(n: Int) -> Int
=
  let h = Holder(run: fn(x: Int) -> x + n)
  @s.get(n) with @s = held(h: h)
