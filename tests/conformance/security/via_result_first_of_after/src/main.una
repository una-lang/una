-- test: the twin of `via_result_first_of`: the same policy is called after the work on `key`, where no part of a task construct runs beside it, so the concurrent label of the `first of` is `public`
-- spec: spec/07 §5
-- expect: ok
module main

import release (key_of)

crunch(key: secret Int) -> secret Int
=
  let edit acc = key
  for i in 0..1000
    acc = if acc > 0 then acc - 1 else acc + 1
  acc

--- The policy is called after the work on `key`, beside nothing.
pub both(key: secret Int, n: internal Int) -> Int
=
  let a = crunch(key)
  let b = key_of(n)
  b
