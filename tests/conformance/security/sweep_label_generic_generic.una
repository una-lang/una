-- test: a generic kind instantiated with a secret type: a generic function result is raised by the field labels of its type argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 25:43
-- expect: error U4001 at 27:43
module sweep_label_generic_generic

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Box[secret Int]) -> secret Int = x.value

same[T](a: T, b: T) -> Bool = a == b

keep[T](a: T) -> Int = 1

pub generic(x: Box[secret Int]) -> Bool = same(x, b: Box(value: 2))

pub constant(x: Box[secret Int]) -> Int = keep(x)

pub generic_twin(x: Box[secret Int]) -> secret Bool = same(x, b: Box(value: 2))
