-- test: whether `acquire` of `std.limit` failed is labeled `internal`, the label `Limited` carries, so a public print that branches on it is U4003: with a hidden `acquire` under an `internal` branch before it, it would print whether that branch took the token (S-46, spec/27 §10 rule 4, ADR 0117 IF5)
-- spec: spec/27 §10
-- expect: error U4003 at src/leak.una:26:17
-- expect: error U4003 at src/leak.una:27:18
module leak

import std.limit (Limit, limiter)
import std.time (minute)

maybe(s: internal Int) -> Unit
  uses @gate: Limit[acquire]
=
  if s > 0
    let a = attempt @gate.acquire()
    unit
  else
    unit

step(s: internal Int) -> Unit
  uses @gate: Limit[acquire]
  uses @console: Console[print]
=
  maybe(s)
  let b = attempt @gate.acquire()
  when b
    is Ok(v) -> @console.print("token")
    is Err(e) -> @console.print("none")

pub main(s: internal Int) -> Unit
  uses @console: Console[print]
=
  step(s) with @gate = limiter(at_most: 1, per: minute, waiting: 0)
  @console.print("done")
