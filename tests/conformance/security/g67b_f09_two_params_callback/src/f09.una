-- test: ADR 0067 recheck of #231, F09_two_params_callback: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f09.una:8:34
module f09

apply[T, U](a: T, b: T, p: U, q: U, k: fn(U) -> Int) -> Int = k(if a == b then p else q)

pub leak(s: secret Int) -> Int = apply(s, b: 0, p: 1, q: 2, k: fn(x: Int) -> x)
