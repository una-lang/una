-- test: ADR 0067 recheck of #231, N07f_swap_cross: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n07f.una:10:34
module n07f

f[T, U](a: T, b: U, k: T, n: Int) -> List[Int] = if n <= 0 then [] else g(b, b: a, k: k, n: n - 1)

g[T, U](a: T, b: U, k: U, n: Int) -> List[Int] = if b == k then [1] else []

pub leak(s: secret Int) -> Int = f(s, b: 0, k: 5, n: 1).len
