-- test: the twin of `server_start_depth_unseen_secret` with an `internal` key: accepted (spec/31 §1, #1682)
-- spec: spec/31 §1
-- expect: ok
module srv

import std.collections (to_set)
import std.host (Exchange, HttpServer, Reply)

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

answer(exchange: internal Exchange, key: internal Int) -> Unit
  uses @server: HttpServer[reply]
=
  const d = deep(exchange.request.body.len)
  const s = to_set([1, 2, 3])
  const masked: internal Int = key * 2 + 1
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all(key: internal Int) -> Unit
  uses @server: HttpServer[next, reply, close]
  diverges
=
  tasks at most 1000 at once
    for ever
      const next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange, key: key)
        is Err(failure) -> unit
    on stop
      @server.close()
