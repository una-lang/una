-- test: ADR 0067 recheck of #231, P10_passthrough_generic: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4002 at src/p10.una:19:24
-- expect: error U4002 at src/p10.una:19:33
module p10

pub capability Log
  op write(n: Int) -> Unit

lg[T](x: T, k: T) -> Bool
  uses @log: Log[write]
=
  @log.write(0)
  x == k

scan[T](xs: List[T], k: T) -> Option[T]
  uses @log: Log[write]
=
  xs.first_where(keep: fn(x) -> lg(x, k: k))

pub leak(xs: List[Int], s: secret Int) -> Unit
  uses @log: Log[write]
=
  let r = scan([s, 1], k: 1)
  unit
