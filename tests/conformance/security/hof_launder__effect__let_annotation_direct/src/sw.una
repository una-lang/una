-- test: a decision on values of a type parameter given to function values or to annotations (#346, #350, #354, the review matrix): reject: let y: T = decided; k(y) with an effectful k
-- spec: spec/07 §7
-- expect: error U4001 at src/sw.una:25:14
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  let y: T = if a == b then p else q
  k(y)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> @log.write(xs.len))
