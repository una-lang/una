-- test: ADR 0067 adversarial check of #231, L18c_mixedoption: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l18c.una:11:8
-- expect: error U4001 at src/l18c.una:12:19
module l18c

pick[T, U](a: T, b: T, x: U, y: U) -> U = if a == b then x else y

pub leak(s: secret Int) -> Int
=
  when pick(s, b: 0, x: Some(1), y: Some(2))
    is Some(v) -> v
    is None -> 0
