-- test: a fold or append whose result depends on labeled elements keeps their label, so these leaks stay rejected (issue #89, ADR 0051)
-- spec: spec/07 §7
-- expect: error U4001 at 12:43
-- expect: error U4001 at 12:69
-- expect: error U4001 at 14:55
-- expect: error U4001 at 16:44
-- expect: error U4001 at 16:70
-- expect: error U4001 at 18:59
-- expect: error U4001 at 20:76
module fold_append_leaks

pub summed(xs: List[secret Int]) -> Int = xs.fold(initial: 0, step: fn(acc, x) -> acc + x)

pub declassified(xs: List[secret Int]) -> List[Int] = xs.fold(initial: [], step: fn(acc,
    x
  ) -> acc.append(item: x))

pub counted(xs: List[secret Int]) -> Int = xs.fold(initial: 0, step: fn(acc,
    x
  ) -> if x > 0 then acc + 1 else acc)

pub appended(xs: List[Int], s: secret Int) -> List[Int] = xs.append(item: s)

pub generic_count[T](xs: List[T], y: T) -> Int = xs.fold(initial: 0, step: fn(acc,
    x
  ) -> if x == y then acc + 1 else acc)
