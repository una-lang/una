-- test: a reading of `Clock.now` carries the timing label of the code that ran before it, `τ⁰` of the bodies of its ancestors (ADR 0116 amendment of 2026-11-09, C1): two readings around work on a `secret` parameter are `secret`, so printing the elapsed time is refused (U4003)
-- spec: spec/14 §3
-- expect: error U4003 at src/leak.una:15:18
module leak

work(n: secret Int) -> secret Int = n * n

pub show(n: secret Int) -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let start = @clock.now()
  let squared = work(n)
  let stop = @clock.now()
  @console.print("{stop - start} ms")
