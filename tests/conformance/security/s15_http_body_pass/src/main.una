-- test: the server receives the body, and may decide the failure by it, so a request with an `internal` body fails with an `internal` failure, which `if error pass` would reveal (S-15)
-- spec: spec/07 §7
-- expect: error U4002 at src/main.una:11:5
module main

pub send(url: Text, note: internal Text) -> internal Int
  uses @http: Http[post]
  fails HttpError
=
  let response = @http.post(url, headers: [], body: note, key_name: None)
    if error pass
  response.status
