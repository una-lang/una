-- test: the body of a `for ever within` that calls `map` with a lambda written at the call has the timing label of what the lambda captures (ADR 0116 IF5 items 2 and 4, IF8): on `public` captures `Http`'s `internal` failure is accepted; a `secret` capture, or a function value whose code is not known at the call, makes it too low (U4001 at the loop)
-- spec: spec/26 §7
-- expect: error U4001 at src/poll.una:23:3
-- expect: error U4001 at src/poll.una:33:3
module poll

import std.time (millisecond)

pub openly(count: Int, url: Text) -> Unit
  uses @http: Http[get]
  diverges
=
  for ever within 100 * millisecond
    let doubled = [count].map(each: fn(x: Int) -> x * count)
    let reading = attempt @http.get(url, headers: [], key_name: None)
    stop
  unit

pub secretly(count: Int, key: secret Int, url: Text) -> Unit
  uses @http: Http[get]
  diverges
=
  for ever within 100 * millisecond
    let doubled = [count].map(each: fn(x: Int) -> if x > key then 1 else 2)
    let reading = attempt @http.get(url, headers: [], key_name: None)
    stop
  unit

pub opaquely(count: Int, url: Text, g: fn(Int) -> Int) -> Unit
  uses @http: Http[get]
  diverges
=
  for ever within 100 * millisecond
    let doubled = [count].map(each: g)
    let reading = attempt @http.get(url, headers: [], key_name: None)
    stop
  unit
