-- test: the twin of `clock_wait_server` (#1891): the same wait of 1.5 s after a server operation, written as a loop that never ends by itself under a `within` whose deadline is `public` (spec/27 §5 rule 5), reads no clock and stops on no labeled data, so it is accepted; the time-out carries the `within`'s timing label, which `L_srv` raises, and `if error use unit` keeps it in a value nothing reads
-- spec: spec/27 §5
-- expect: ok
module srv

import std.host (HttpServer)
import std.time (millisecond)

spin() -> Unit
  diverges
=
  for ever
    unit

pub main() -> Unit
  uses @server: HttpServer[next, close]
  diverges
=
  let first = attempt @server.next()
  let paused = spin() within 1500 * millisecond
    if error use unit
  @server.close()
