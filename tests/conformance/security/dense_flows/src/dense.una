-- test: the flows of dense values: a secret item into public elements, an update under a secret branch, a secret scalar labeling every element, secret slice bounds labeling the shape, a secret-shaped input of `add_product` deciding the receiver's elements, and `zip_map` with a secret-shaped operand
-- spec: spec/29 §17
-- expect: error U4001 at src/dense.una:14:8
-- expect: error U4001 at src/dense.una:22:10
-- expect: error U4003 at src/dense.una:28:18
-- expect: error U4003 at src/dense.una:34:18
-- expect: error U4001 at src/dense.una:40:28
-- expect: error U4003 at src/dense.una:47:18
module dense

pub item(a: Array[F64], v: secret F64) -> Array[F64]
=
  var b = a
  edit b.set(index: 0, item: v)
  b

pub branch(a: Array[F64], s: secret Bool) -> Array[F64]
  requires a.len > 0
=
  var b = a
  if s
    edit b.scale(by: 2.0)
  b

pub scalar(a: Array[F64], k: secret F64) -> Unit
  uses @console: Console[print]
=
  @console.print("{(k * a).to_list()}")

pub bounds(a: Array[F64], s: secret Int) -> Unit
  requires 0 <= s and s <= a.len
  uses @console: Console[print]
=
  @console.print("{a.slice(from: s, until: a.len).len}")

pub product(c: Matrix[F64], a: secret Matrix[F64], b: Matrix[F64]) -> Matrix[F64]
  requires c.rows == a.rows and a.columns == b.rows and b.columns == c.columns
=
  var out = c
  edit out.add_product(of: a, and: b)
  out

pub zipped(a: Array[F64], b: secret Array[F64]) -> Unit
  requires a.len == b.len
  uses @console: Console[print]
=
  @console.print("{a.zip_map(with: b, each: fn(x, y) -> x + y).len}")
