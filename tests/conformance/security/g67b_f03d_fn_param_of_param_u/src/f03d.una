-- test: ADR 0067 recheck of #231, F03d_fn_param_of_param_U: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f03d.una:6:86
module f03d

mk[T, U](a: T, b: T, p: U, q: U) -> fn(fn(U) -> Int) -> Int = fn(k: fn(U) -> Int) -> k(if a == b then p else q)

pub leak(s: secret Int) -> Int
=
  let g = mk(s, b: 0, p: 1, q: 2)
  g(fn(x: Int) -> x)
