-- test: the program of `task_switch_secret_loop` without a `tasks` statement runs its workers one after another, with no switch, so its `secret` loops move no order and it is accepted (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "1"
-- expect: run-output "2"
module order

spin(n: secret Int) -> secret Int
=
  let edit acc: secret Int = 0
  for i in 0..<n
    acc = acc + 1
  acc

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let r = spin(bit(k, key: key) * 3000)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  for k in 0..<3
    worker(k, key: key)
