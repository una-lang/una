-- test: a policy whose `to` is public releases its failure publicly, as its value (S-18 twin) (edition 0.1)
-- spec: spec/07 §5
-- expect: ok
module main

import release (Gate, checkpin)

pub probe(n: internal Int) -> Unit
  uses @console: Console[print]
=
  let r = attempt checkpin(n)
  when r
    is Ok(v) -> @console.print("passed")
    is Err(e) -> @console.print("failed")

pub passes(n: internal Int) -> Unit
  fails Gate
=
  let v = checkpin(n)
    if error pass
  unit
