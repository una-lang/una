-- test: ADR 0067 recheck of #231, F01_fn_result_T: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f01.una:6:63
module f01

mk[T](a: T, b: T, p: T, q: T) -> fn(Int) -> T = fn(n: Int) -> if a == b then p else q

pub leak(s: secret Int) -> Int
=
  let g = mk([s], b: [0], p: [], q: [1, 2])
  g(0).len
