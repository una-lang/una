-- test: the via function takes the from type and returns the to type
-- spec: spec/07 §5
-- expect: error U4005 at src/app/keys.una:9:7
trusted module app.keys

pub policy mask
  from secret[PII] Text
  to internal Text
  via masked
  purpose "show the last digits"
  owner privacy

masked(t: secret[PII] Text) -> internal Int = 0
