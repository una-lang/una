-- test: secret handler argument into a public handler parameter (review control)
-- spec: spec/07 §7
-- expect: error U4001 at 19:35
module handler_arg_secret

capability Store
  op count() -> Int

handler rows(n: Int) for Store
  op count() = n

counted() -> Int
  uses @store: Store[count]
=
  @store.count()

pub run(pin: secret Int) -> Int
=
  counted() with @store = rows(n: pin)
