-- test: a `checked` predicate that reads a labeled value besides its operand fails under that value's label, so a public failure is U4002 (S-17) (edition 0.1)
-- spec: spec/10 §7
-- expect: error U4002 at src/main.una:12:3
-- expect: error U4002 at src/main.una:20:3
module main

pub kind LenError = | TooLong

pub short(raw: Text, limit: secret Int) -> Text
  fails LenError
=
  checked(raw, raw.len < limit) else fail TooLong

pub kind Limits
  most: secret Int

pub within(raw: Text, limits: Limits) -> Text
  fails LenError
=
  checked(raw, raw.len < limits.most) else fail TooLong
