-- test: a function type is contravariant in its parameters and covariant in its result at a call argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:53
-- expect: error U4001 at 19:46
module sweep_variance_fn_argument

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

take_0(w: fn(Int) -> Int) -> Int = 0

pub arg_0(v: fn(Int) -> secret Int) -> Int = take_0(v)

take_1(w: fn(secret Int) -> Int) -> Int = 0

pub arg_1(v: fn(Int) -> Int) -> Int = take_1(v)

take_2(w: fn(Int) -> Int) -> Int = 0

pub arg_2(v: fn(secret Int) -> Int) -> Int = take_2(v)

take_3(w: fn(Int) -> secret Int) -> Int = 0

pub arg_3(v: fn(Int) -> Int) -> Int = take_3(v)
