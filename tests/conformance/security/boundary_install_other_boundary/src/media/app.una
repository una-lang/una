-- test: a handler of one boundary installed outside it and granted on by name to a call into another boundary is charged against that boundary where it is installed, as it is when granted directly; a handler whose `uses` name the binding it installs resolves them outside its `with`, so the handler installed further up is charged (ADR 0093 rule 15)
-- spec: spec/05 §4
-- expect: error U3021 at src/media/app.una:33:3
-- expect: error U3021 at src/media/app.una:38:26
-- expect: error U3021 at src/media/app.una:43:24
module media.app

import media.log (Disk, Log, Net)
import media.render (show)
import media.vendor (posting)

handler relog() for Log
  uses @log: Log[write]
  op write(n) = @log.write(n)

handler heavy() for Log
  uses @disk: Disk[put]
  op write(n) = @disk.put(n)

forward(n: Int) -> Int
  uses @log: Log[write]
=
  show(n) with @log = @log

again(n: Int) -> Int
  uses @log: Log[write]
=
  forward(n) with @log = relog()

pub direct(n: Int) -> Int
  uses @net: Net[post]
=
  show(n) with @log = posting(), @net = @net

pub indirect(n: Int) -> Int
  uses @net: Net[post]
=
  forward(n) with @log = posting(), @net = @net

pub self_named(n: Int) -> Int
  uses @disk: Disk[put]
=
  again(n) with @log = heavy()
