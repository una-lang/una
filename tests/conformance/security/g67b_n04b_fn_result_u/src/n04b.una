-- test: ADR 0067 recheck of #231, N04b_fn_result_U: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n04b.una:6:57
module n04b

choose[U](x: U, y: U) -> fn(Int) -> Int = fn(n: Int) -> if x == y then 1 else 2

pub leak(s: secret Int) -> Int
=
  let g = choose([s], y: [0])
  g(0)
