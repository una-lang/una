-- test: whether `reply` fails is `internal`, decided by the reply right, the reply and the task's own rights, so `if error pass` on it is U4002 (spec/31 §1, ADR 0123 IF3)
-- spec: spec/31 §1
-- expect: error U4002 at src/srv.una:13:5
module srv

import std.host (Exchange, HttpServer, Reply, ServeError)

send(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
  fails ServeError
=
  @server.reply(to: exchange.right, reply: Reply(status: 204, headers: [], body: ""))
    if error pass
