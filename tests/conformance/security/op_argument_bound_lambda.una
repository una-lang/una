-- test: a lambda first bound with `let` has its own type, so as an operation argument its result is data that `accepts` bounds (ADR 0050, ADR 0081, #85)
-- spec: spec/07 §7
-- expect: ok
module op_argument_bound_lambda

capability Probe
  op grab(w: fn() -> Int) -> Int
    accepts secret

pub bound(pin: secret Int) -> Int
  uses @p: Probe[grab]
=
  let w = fn() -> pin
  @p.grab(w)
