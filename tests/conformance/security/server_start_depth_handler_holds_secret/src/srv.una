-- test: a `start` in a handler's operation body, whose task only holds a `secret` key that decides none of its calls, keeps the coarse depth test, since no function holds the `start`: U4003 at the `start`, with the coarse test's message, that it holds `secret` data (spec/31 §1, ADR 0123 IF6, #1682)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:31:9
module srv

import std.host (Exchange, HttpServer, Reply)

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

answer(exchange: internal Exchange, key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  let d = deep(exchange.request.body.len)
  let masked: secret Int = key * 2 + 1
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

capability Runner
  op go() -> Unit

handler running(exchanges: internal List[Exchange], key: secret Int) for Runner
  uses @server: HttpServer[reply]
  op go() =
    tasks
      for exchange in exchanges
        start answer(exchange, key: key)

use_runner() -> Unit
  uses @r: Runner[go]
=
  @r.go()

pub serve_all(exchanges: internal List[Exchange], key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  use_runner() with @r = running(exchanges, key: key)
