-- test: an `edit` argument flows into its parameter, and the final value of the parameter flows back into the place at the declared type, so the two carry the same labels (spec/17 §6 rule 2)
-- spec: spec/17 §6
-- expect: error U4001 at src/memlabels.una:18:9
-- expect: error U4001 at src/memlabels.una:23:13
-- expect: error U4001 at src/memlabels.una:29:14
module memlabels

hide(edit n: secret Int) -> Unit
=
  n = n + 1

count(edit n: Int) -> Unit
=
  n = n + 1

leak(edit out: Int, s: secret Int) -> Unit
=
  out = s

pub public_into_secret() -> Int
=
  let edit p = 0
  hide(edit p)
  p

pub secret_into_public(s: secret Int) -> Unit
=
  let edit q: secret Int = s
  count(edit q)

pub same_labels(s: secret Int) -> Unit
=
  let edit q: secret Int = s
  hide(edit q)
