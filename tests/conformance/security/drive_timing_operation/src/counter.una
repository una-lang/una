-- test: the timing label of a driven step joins the labels of the results of the operations it and its callees perform: here `Env.get`, whose result is `internal` (spec/26 §2, ADR 0116 IF7)
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:16:34
module counter

import std.drive (Tick)

pub init() -> Int = 0

read(name: Text) -> Unit
  uses @env: Env[get]
=
  let value = @env.get(name)
  unit

pub step(edit count: Int, input: Tick) -> Unit
  uses @env: Env[get]
=
  read("MODE")
  count = count + 1
