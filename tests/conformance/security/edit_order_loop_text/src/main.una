-- test: label order shape `loop-text` (#323, N-45, review #330): a determined position stays fixed
-- spec: spec/17 §6
-- expect: error U4001 at src/main.una:16:9
module main

-- review: rejected (U4001): a text has no open position, so its label is fixed (control)
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit t = ""
  for i in 0..<2
    @console.print(t)
    t = "{t}{s}"
