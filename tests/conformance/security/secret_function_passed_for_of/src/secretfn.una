-- test: a function value chosen by a secret and passed for a parameter that an `of` clause names keeps its secret label, so what the callee computes with it is secret, as in edition 0.1 (spec/07 §7, ADR 0062, #210)
-- spec: spec/07 §7
-- expect: error U4001 at src/secretfn.una:19:3
-- expect: error U4001 at src/secretfn.una:19:13
-- expect: error U4001 at src/secretfn.una:24:3
-- expect: error U4001 at src/secretfn.una:24:10
-- expect: error U4001 at src/secretfn.una:26:70
-- expect: error U4001 at src/secretfn.una:26:80
module secretfn

positive(x: Int) -> Bool = x > 0

negative(x: Int) -> Bool = x < 0

--- The predicate is chosen by a secret, so the count depends on the secret.
pub pick(s: secret Bool, xs: List[Int]) -> Int
=
  let keep = if s then positive else negative
  xs.filter(keep).len

pub pick_map(s: secret Bool, xs: List[Int]) -> List[Int]
=
  let each = if s then fn(x: Int) -> x + 1 else fn(x: Int) -> x
  xs.map(each)

pub pick_param(keep: secret fn(Int) -> Bool, xs: List[Int]) -> Int = xs.filter(keep).len
