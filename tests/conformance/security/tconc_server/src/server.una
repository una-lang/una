-- test: the server-shaped program of ADR 0116, amendment of 2026-10-25, section H (#1154): every request is handled in a started task beside other requests and beside the block, whose `for ever within` is a site in the block; `κ` of each `tasks` statement is `internal`, from `ρ` of `Http`, so every deadline, the race, `L_res` and `L_lim` are `internal`, and the grant's limits are accepted
-- spec: spec/27 §9
-- expect: ok
module server

import std.time (millisecond, second)

pub serve_all(paths: List[Text]) -> Unit
  uses @http: Http[get]
=
  tasks at most 64 at once
    for path in paths
      start handle(path) within 2 * second
        if error use unit
  unit

pub serve_polls(base: Text) -> Unit
  uses @http: Http[get]
  diverges
=
  tasks at most 64 at once
    let edit n = 0
    for ever within 1000 * millisecond
      stop when n == 100
      start handle("{base}/{n}") within 2 * second
        if error use unit
      n = n + 1
    unit
  unit

handle(path: Text) -> Unit
  uses @http: Http[get]
=
  let reply = attempt @http.get(url: "https://api.example.com/{path}", headers: [],
    key_name: None
  ) within 500 * millisecond
  let size = first of
    measure(path)
    measure("{path}/")
  unit

measure(path: Text) -> Int = path.len
