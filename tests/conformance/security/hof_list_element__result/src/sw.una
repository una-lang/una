-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, the review matrix): reject: a function from a list, called with the decision; `leak`'s list of lambdas is U4001 either way (invariant element)
-- spec: spec/07 §7
-- expect: error U4001 at src/sw.una:28:21
-- expect: error U4003 at src/sw.una:30:14
-- expect: error U4001 at src/sw.una:35:37
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, ks: List[fn(T) -> Int]) -> Unit
  uses @log: Log[write]
=
  let n = when ks.first()
    is Some(f) -> f(if a == b then p else q)
    is None -> 0
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], ks: [fn(xs) -> xs.len])
