-- test: `τ_conc` (ADR 0116 IF6): a function that a `together` branch reaches can run beside a sibling that computes on a `secret`, so its `within`'s time-out is labeled `⊤` there and `if error pass` is U4002; the same `within` in a function no task reaches is accepted (ADR 0117 IF2)
-- spec: spec/27 §5
-- expect: error U4002 at src/poll.una:18:5
module poll

import std.time (millisecond)

pub kind PollError = | TimedOut

step(n: Int) -> Int = n + 1

crunch(key: secret Int) -> secret Int = key * 3

pub polled(n: Int) -> Int
  fails PollError
=
  let value = step(n) within 10 * millisecond
    if error pass
  value

pub alone(n: Int) -> Int
  fails PollError
=
  let value = step(n) within 10 * millisecond
    if error pass
  value

pub both(key: secret Int, n: Int) -> Int
  fails PollError
=
  together
    let a = crunch(key)
    let b = polled(n)
      if error pass
  b
