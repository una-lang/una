-- test: `first_where` over a `public` list stops where its predicate first holds, so a predicate whose result is `secret`, here through a captured binding, decides how many elements it visits: U4002 at the call (spec/27 §8 rule 5, #1684, review H2)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:21:13
module order

noop() -> Unit = unit

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: key)
  let xs = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
  for i in 0..<300
    let f = xs.first_where(keep: fn(y: Int) -> b == 1)
    unit
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
