-- test: the declassification tour's lookup before S-18: a policy call with an `internal` `to`, followed by `if error fail`, fails publicly on what the `via` decided (ADR 0090)
-- spec: spec/07 §5
-- expect: error U4002 at src/app/lookup.una:21:5
module app.lookup

import app.keys (phone_key)
import app.types (Phone)

pub kind LookupError = | Unavailable

pub capability Directory
  op find(key: internal Hashed) -> Option[Text]
    accepts internal

pub name_for(phone: secret[PII] Phone) -> Option[Text]
  uses @directory: Directory[find]
  uses @keys: Keys[hmac]
  fails LookupError
=
  let key = phone_key(phone)
    if error fail Unavailable
  @directory.find(key)
