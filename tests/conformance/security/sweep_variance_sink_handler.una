-- test: a kind whose parameter is inside a function type is invariant at a handler result (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 17:16
-- expect: error U4001 at 23:16
module sweep_variance_sink_handler

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

capability Give0
  op give(v: Sink[Int]) -> Sink[secret Int]

handler giving0() for Give0
  op give(v) = v

capability Give1
  op give(v: Sink[secret Int]) -> Sink[Int]

handler giving1() for Give1
  op give(v) = v

capability Give2
  op give(v: Sink[secret Int]) -> Sink[secret Int]

handler giving2() for Give2
  op give(v) = v
