-- test: a helper that can fail is only called at a public program counter, so its public write leaves reads public (S-14 twin)
-- spec: spec/07 §7
-- expect: ok
module main

mark() -> Unit
  uses @files: Files[write]
  fails FileError
=
  @files.write("marker.txt", content: "")
    if error pass

pub probe() -> Unit
  uses @files: Files[read, write]
  uses @console: Console[print]
  fails FileError
=
  mark()
    if error pass
  let r = attempt @files.read("marker.txt")
  when r
    is Ok(v) -> @console.print("marked")
    is Err(e) -> @console.print("not marked")
