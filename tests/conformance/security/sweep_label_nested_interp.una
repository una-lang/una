-- test: nested kinds and generics holding a secret: an interpolation of a comparison of it is a secret argument of Console (label sweep)
-- spec: spec/07 §7
-- expect: error U4003 at 25:18
-- expect: error U4003 at 37:18
-- expect: error U4003 at 49:18
module sweep_label_nested_interp

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab_boxed_list(x: Box[List[secret Int]]) -> secret Int = x.value.sum()

pub shown_boxed_list(x: Box[List[secret Int]]) -> Unit
  uses @console: Console[print]
=
  @console.print("same {x == Box(value: [2])}")

pub shown_twin_boxed_list(x: Box[List[secret Int]]) -> Unit
  uses @console: Console[print]
=
  @console.print("fixed")

grab_option_box(x: Option[Box[secret Int]]) -> secret Int = x.or_else(default: Box(value: 0)).value

pub shown_option_box(x: Option[Box[secret Int]]) -> Unit
  uses @console: Console[print]
=
  @console.print("same {x == Some(Box(value: 2))}")

pub shown_twin_option_box(x: Option[Box[secret Int]]) -> Unit
  uses @console: Console[print]
=
  @console.print("fixed")

grab_wallet(x: Wallet) -> secret Int = x.acct.pin

pub shown_wallet(x: Wallet) -> Unit
  uses @console: Console[print]
=
  @console.print("same {x == Wallet(acct: Acct(id: 1, pin: 2))}")

pub shown_twin_wallet(x: Wallet) -> Unit
  uses @console: Console[print]
=
  @console.print("fixed")
