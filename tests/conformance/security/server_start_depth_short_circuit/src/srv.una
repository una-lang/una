-- test: the left operand of `and` decides whether its right operand's calls run, so a task whose deep call stands behind a `secret` operand has a depth that depends on `secret` data: U4003 at the `start` (spec/31 §1, ADR 0123 IF6, #1674)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:27:7
module srv

import std.host (Exchange, HttpServer, Reply)

big(n: Int) -> Bool
=
  if n <= 0
    true
  else
    big(n - 1)

answer(exchange: internal Exchange, key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  let b = key > 0 and big(5000)
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

serve_all(exchanges: internal List[Exchange], key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  tasks
    for exchange in exchanges
      start answer(exchange, key: key)
