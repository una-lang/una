-- test: the twin of `tconc_function_value`: the same `apply(route, x: 3)` runs after the `together`, so no part reaches `Λ` and the `within` of `plan_route` is `public`. A twin that differs only in the label of the sibling's data cannot be accepted: a part that calls a function value has `κ = ⊤` (ADR 0116 F, items 1 and 7)
-- spec: spec/27 §11
-- expect: ok
module plan

import std.time (millisecond)

pub kind PlanError = | TimedOut

step(n: Int) -> Int = n + 1

--- A deadline over `public` work, whose `TimedOut` it passes on.
plan_route(n: Int) -> Int
  fails PlanError
=
  let v = step(n) within 10 * millisecond
    if error pass
  v

route(n: Int) -> Int
=
  let r = plan_route(n)
    if error use 0
  r

apply(g: fn(Int) -> Int, x: Int) -> Int = g(x)

crunch(key: secret Int) -> secret Int = key * 3

--- The function value runs after the `together`, beside nothing.
pub both(key: secret Int, n: Int) -> secret Int
=
  together
    let a = crunch(key)
    let c = step(n)
  let b = apply(route, x: 3)
  a
