-- test: the twin of `server_start_depth_handler_decides_secret` with an `internal` key: accepted (spec/31 §1, #1682)
-- spec: spec/31 §1
-- expect: ok
module srv

import std.host (Exchange, HttpServer, Reply)

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

capability Depth
  op go() -> internal Int

handler deciding(k: internal Int) for Depth
  op go() = if k > 0 then deep(3000) else 0

use_depth() -> internal Int
  uses @d: Depth[go]
=
  @d.go()

answer(exchange: internal Exchange, key: internal Int) -> Unit
  uses @server: HttpServer[reply]
=
  let n = exchange.request.body.len
  let e = deep(n)
  let d = use_depth() with @d = deciding(key)
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all(key: internal Int) -> Unit
  uses @server: HttpServer[next, reply, close]
  diverges
=
  tasks at most 1000 at once
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange, key: key)
        is Err(failure) -> unit
    on stop
      @server.close()
