-- test: a secret function stored through an `edit` argument or a `let edit` binding updated under a secret condition keeps its label when passed to `filter`: U4001 at the argument and the result, as edition 0.1 reports for a field or `let` of type `secret fn` (spec/17 §6, spec/07 §7, #210)
-- spec: spec/17 §6
-- expect: error U4001 at src/edits.una:25:3
-- expect: error U4001 at src/edits.una:25:19
-- expect: error U4001 at src/edits.una:32:3
-- expect: error U4001 at src/edits.una:32:13
module edits

positive(x: Int) -> Bool = x > 0

negative(x: Int) -> Bool = x < 0

pub kind Rule
  keep: secret fn(Int) -> Bool
  name: Text

choose(edit rule: Rule, s: secret Bool) -> Unit
=
  rule.keep = if s then positive else negative

pub through_edit_field(s: secret Bool, xs: List[Int]) -> Int
=
  let edit rule = Rule(keep: positive, name: "rule")
  choose(edit rule, s)
  xs.filter(keep: rule.keep).len

pub through_let_edit(s: secret Bool, xs: List[Int]) -> Int
=
  let edit keep: secret fn(Int) -> Bool = positive
  if s
    keep = negative
  xs.filter(keep).len
