-- test: the public twin of `task_switch_first_where_predicate`: the same program on a `public` key is accepted (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- expect: ok
module order

noop() -> Unit = unit

bit(k: Int, key: Int) -> Int
=
  let edit x: Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: Int) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: key)
  let xs = [2, 2, 2, 2, 2, 2, 2, 2, 2, 2]
  for i in 0..<300
    let f = xs.first_where(keep: fn(y: Int) -> b == 1)
    unit
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
