-- test: ADR 0067 adversarial check of #231, L17_fnparam: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l17.una:6:44
module l17

tester[T](a: T) -> fn(T) -> Int = fn(y) -> if y == a then 1 else 0

pub leak(s: secret Int) -> Int
=
  let g = tester(s)
  g(1)
