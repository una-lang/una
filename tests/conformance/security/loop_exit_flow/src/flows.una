-- test: whether later iterations run must not depend on secret data: `stop` under a secret condition is an implicit flow (U4002), and the rest of the body after a `skip` under a secret branch runs under it (U4001); public conditions are accepted (spec/26 §3, ADR 0116 IF2, IF3)
-- spec: spec/26 §3
-- expect: error U4002 at src/flows.una:12:5
-- expect: error U4002 at src/flows.una:21:7
-- expect: error U4001 at src/flows.una:31:9
module flows

pub when_secret(xs: List[secret Int]) -> Int
=
  let edit n = 0
  for x in xs
    stop when x > 3
    n = n + 1
  n

pub under_secret(xs: List[secret Int]) -> Int
=
  let edit n = 0
  for x in xs
    if x > 3
      stop
    n = n + 1
  n

pub after_skip(xs: List[secret Int]) -> Int
=
  let edit n = 0
  for x in xs
    if x > 3
      skip
    n = n + 1
  n

pub public_exits(xs: List[Int], s: secret Int) -> secret Int
=
  let edit n: secret Int = 0
  for x in xs
    if x > 3
      skip
    stop when x > 9
    n = n + s
  n
