-- test: in edition 0.3 JSON keeps labels as ADR 0073 J5 states them: a value parsed from a secret text, a text quoted or written from a secret, and a value bound from a secret Json are secret; a secret cannot enter a Json constructor, whose positions are public; and whether a parse of a secret text fails, and where, is secret too, so attempt gives a secret Result and if error pass and if error fail are U4002 (spec/23 §5, ADR 0073 J5)
-- spec: spec/23 §5
-- expect: error U4001 at src/json_labels_0_3.una:22:3
-- expect: error U4002 at src/json_labels_0_3.una:23:5
-- expect: error U4001 at src/json_labels_0_3.una:25:47
-- expect: error U4001 at src/json_labels_0_3.una:27:42
-- expect: error U4001 at src/json_labels_0_3.una:29:39
-- expect: error U4002 at src/json_labels_0_3.una:37:5
-- expect: error U4001 at src/json_labels_0_3.una:38:8
-- expect: error U4001 at src/json_labels_0_3.una:39:22
-- expect: error U4001 at src/json_labels_0_3.una:45:3
-- expect: error U4001 at src/json_labels_0_3.una:50:8
-- expect: error U4001 at src/json_labels_0_3.una:53:12
-- expect: error U4001 at src/json_labels_0_3.una:54:26
-- expect: error U4002 at src/json_labels_0_3.una:61:5
-- expect: error U4001 at src/json_labels_0_3.una:65:3
module json_labels_0_3

pub parsed(t: secret Text) -> Json
  fails JsonError
=
  t.parse_json()
    if error pass

pub wrapped(token: secret Text) -> Json = Str(token)

pub quoted(token: secret Text) -> Text = token.quote_json()

pub written(j: secret Json) -> Text = j.to_json()

pub kept(token: secret Text) -> secret Text = token.quote_json()

pub bound(t: secret Text) -> Text
  fails JsonError
=
  let j = t.parse_json()
    if error pass
  when j
    is Str(value) -> value
    else -> ""

pub accepted(t: secret Text) -> Bool
=
  let r = attempt t.parse_json()
  r is Ok

pub position(t: secret Text) -> Int
=
  let r = attempt t.parse_json()
  when r
    is Ok(j) -> -1
    is Err(e) ->
      when e
        is Syntax(at) -> at
        else -> -1

pub refailed(t: secret Text) -> secret Json
  fails JsonError
=
  t.parse_json()
    if error fail Syntax(0)

pub defaulted(t: secret Text) -> Json
=
  t.parse_json()
    if error use Null

pub labeled(t: secret Text) -> secret Bool
=
  let r = attempt t.parse_json()
  r is Ok
