-- test: ADR 0067 adversarial check of #231, L20_mutual3: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l20.una:12:34
module l20

f[T](a: T, b: T, n: Int) -> Int = if n <= 0 then 0 else g(a, b, n: n - 1)

g[T](a: T, b: T, n: Int) -> Int = h(a, b, n: n)

h[T](a: T, b: T, n: Int) -> Int = if n == 5 then (if a == b then 1 else 0) else f(a, b, n: n)

pub leak(s: secret Int) -> Int = f(s, b: 0, n: 9)
