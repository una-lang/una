-- test: ADR 0067 adversarial check of #231, L59_inferred_uses: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l59.una:22:3
module l59

pub capability Log
  op write(n: Int) -> Unit

note(n: Int) -> Unit
  uses @log: Log[write]
=
  @log.write(n)

cmp[T](a: T, b: T) -> Int
=
  note(0)
  if a == b then 1 else 0

pub leak(s: secret Int) -> Int
  uses @log: Log[write]
=
  cmp(s, b: 0)
