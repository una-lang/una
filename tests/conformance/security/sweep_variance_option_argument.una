-- test: `Option` is covariant at a call argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 14:50
module sweep_variance_option_argument

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

take_0(w: Option[Int]) -> Int = 0

pub arg_0(v: Option[secret Int]) -> Int = take_0(v)

take_1(w: Option[secret Int]) -> Int = 0

pub arg_1(v: Option[Int]) -> Int = take_1(v)
