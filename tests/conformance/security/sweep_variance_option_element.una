-- test: `Option` is covariant at a list element (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:3
module sweep_variance_option_element

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub elem_0(v: Option[secret Int], w: Option[Int]) -> List[Option[Int]]
=
  let ws = [w, v]
  ws

pub elem_1(v: Option[Int], w: Option[secret Int]) -> List[Option[secret Int]]
=
  let ws = [w, v]
  ws
