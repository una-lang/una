-- test: a handler installed outside a boundary may call what its installation gives it under bindings of its own, so a call into the boundary granted that handler counts what the lambdas and functions given to it use, as it counts a handler that declares those `uses` (ADR 0093 rules 5 and 14)
-- spec: spec/05 §4
-- expect: error U3021 at src/media/app.una:30:3
-- expect: error U3021 at src/media/app.una:35:3
-- expect: error U3021 at src/media/app.una:40:3
module media.app

import media.log (Log, Net)
import media.render (show)

handler mute() for Net
  op post(n) = n

handler relay(cb: fn(Int) -> Int uses @net: Net[post]) for Log
  op write(n) =
    cb(n) with @net = mute()

handler relay_held(cb: fn(Int) -> Int uses @net: Net[post]) for Log
  uses @net: Net[post]
  op write(n) = cb(n)

say(n: Int) -> Int
  uses @net: Net[post]
=
  @net.post(n)

pub by_lambda(n: Int) -> Int
  uses @net: Net[post]
=
  show(n) with @log = relay(cb: fn(m) -> @net.post(m))

pub by_named(n: Int) -> Int
  uses @net: Net[post]
=
  show(n) with @log = relay(cb: say)

pub held(n: Int) -> Int
  uses @net: Net[post]
=
  show(n) with @log = relay_held(cb: fn(m) -> @net.post(m))
