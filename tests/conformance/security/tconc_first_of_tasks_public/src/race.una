-- test: the twin of `tconc_first_of_tasks`: the other started task works on `public` data, so the race's value is `public` and may be printed
-- spec: spec/27 §11
-- expect: ok
module race

crunch_open(n: Int) -> Int = n * 3

churn_open(n: Int) -> Unit
=
  let spent = crunch_open(n)
  unit

step(n: Int) -> Int = n + 1

--- Prints which of two `public` branches won: the value carries the race's timing label.
report(n: Int) -> Unit
  uses @console: Console[print]
=
  let v = first of
    step(n)
    step(n + 1)
  @console.print("{v}")

--- Starts `churn_open(m)` and `report(n)`, which run beside each other.
pub serve(m: Int, n: Int) -> Unit
  uses @console: Console[print]
=
  tasks
    start churn_open(m)
    start report(n)
  unit
