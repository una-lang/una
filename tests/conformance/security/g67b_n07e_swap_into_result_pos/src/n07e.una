-- test: ADR 0067 recheck of #231, N07e: the only branch is on the public `n`, and both branches return `f`'s `b` (`g` returns its first argument, `f`'s `b`), so from `f(s, b: 0)` the element is the public 0 and the summaries accept it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: ok
module n07e

f[T, U](a: T, b: U, n: Int) -> List[U] = if n <= 0 then [b] else g(b, b: a, n: n - 1)

g[T, U](a: T, b: U, n: Int) -> List[T] = [a]

pub leak(s: secret Int) -> Int
=
  when f(s, b: 0, n: 1).first
    is Some(v) -> v
    is None -> 0
