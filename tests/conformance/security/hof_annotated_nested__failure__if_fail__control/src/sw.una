-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): accept: control: an annotated lambda in an if whose other branch fails
-- spec: spec/07 §7
-- expect: ok
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

logger_f[U](x: U, f: fn(U) -> Int) -> Int
  uses @log: Log[write]
=
  @log.write(f(x))
  0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int, c: Bool) -> Int
  uses @log: Log[write]
  fails Bad
=
  let n = logger_f(p, f: if c then fn(x: T) -> k(x) else fail Oops)
    if error pass
  @log.write(1)
  2

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let r = g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len, c: true)
    if error use 3
  @log.write(5)
