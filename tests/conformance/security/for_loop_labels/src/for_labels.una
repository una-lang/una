-- test: a loop runs its body under the top label of its list, or the labels of its range bounds, and the loop variable carries the labels of the elements: a public update, a branch on a secret element or a failure there is U4001 or U4002 (spec/17 §6 rule 3, V2-16)
-- spec: spec/17 §6
-- expect: error U4001 at src/for_labels.una:16:9
-- expect: error U4001 at src/for_labels.una:24:11
-- expect: error U4001 at src/for_labels.una:31:9
-- expect: error U4002 at src/for_labels.una:39:7
-- expect: error U4001 at src/for_labels.una:46:12
module for_labels

pub kind Oops = Bad | Worse

pub counted(pins: secret List[Int]) -> Int
=
  let edit n = 0
  for p in pins
    n = n + 1
  n

pub branched(pins: List[secret Int]) -> Int
=
  let edit n = 0
  for p in pins
    if p > 3
      n = n + 1
  n

pub ranged(limit: secret Int) -> Int
=
  let edit n = 0
  for i in 0..<limit
    n = n + 1
  n

pub failing(pins: secret List[Int]) -> Unit
  fails Oops
=
  for p in pins
    if p > 3
      fail Bad
  unit

pub element(pins: secret List[Int]) -> Int
=
  let edit last = 0
  for p in pins
    last = p
  last

pub secret_total(pins: secret List[Int]) -> secret Int
=
  let edit n: secret Int = 0
  for p in pins
    n = n + p
  n

pub public_list(xs: List[Int]) -> Int
  fails Oops
=
  let edit n = 0
  for x in xs
    if x > 3
      fail Bad
    n = n + x
  n
