-- test: nested kinds and generics holding a secret: a generic function result is raised by the field labels of its type argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 29:60
-- expect: error U4001 at 31:60
-- expect: error U4001 at 41:62
-- expect: error U4001 at 43:62
-- expect: error U4001 at 53:41
-- expect: error U4001 at 55:41
module sweep_label_nested_generic

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab_boxed_list(x: Box[List[secret Int]]) -> secret Int = x.value.sum()

same_boxed_list[T](a: T, b: T) -> Bool = a == b

keep_boxed_list[T](a: T) -> Int = 1

pub generic_boxed_list(x: Box[List[secret Int]]) -> Bool = same_boxed_list(x, b: Box(value: [2]))

pub constant_boxed_list(x: Box[List[secret Int]]) -> Int = keep_boxed_list(x)

pub generic_twin_boxed_list(x: Box[List[secret Int]]) -> secret Bool = same_boxed_list(x,
  b: Box(value: [2])
)

grab_option_box(x: Option[Box[secret Int]]) -> secret Int = x.or_else(default: Box(value: 0)).value

same_option_box[T](a: T, b: T) -> Bool = a == b

keep_option_box[T](a: T) -> Int = 1

pub generic_option_box(x: Option[Box[secret Int]]) -> Bool = same_option_box(x,
  b: Some(Box(value: 2))
)

pub constant_option_box(x: Option[Box[secret Int]]) -> Int = keep_option_box(x)

pub generic_twin_option_box(x: Option[Box[secret Int]]) -> secret Bool = same_option_box(x,
  b: Some(Box(value: 2))
)

grab_wallet(x: Wallet) -> secret Int = x.acct.pin

same_wallet[T](a: T, b: T) -> Bool = a == b

keep_wallet[T](a: T) -> Int = 1

pub generic_wallet(x: Wallet) -> Bool = same_wallet(x, b: Wallet(acct: Acct(id: 1, pin: 2)))

pub constant_wallet(x: Wallet) -> Int = keep_wallet(x)

pub generic_twin_wallet(x: Wallet) -> secret Bool = same_wallet(x, b: Wallet(acct: Acct(id: 1,
      pin: 2
    )))
