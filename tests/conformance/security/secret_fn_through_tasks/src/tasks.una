-- test: a secret-chosen function value used inside a `together for` body or a `together` branch keeps its label: the `filter` arguments and the results are U4001, as for the same `let` statements outside the block (spec/19 §3, spec/07 §7, #210)
-- spec: spec/19 §3
-- expect: error U4001 at src/tasks.una:18:26
-- expect: error U4001 at src/tasks.una:20:3
-- expect: error U4001 at src/tasks.una:26:23
-- expect: error U4001 at src/tasks.una:27:23
-- expect: error U4001 at src/tasks.una:28:3
module tasks

positive(x: Int) -> Bool = x > 0

negative(x: Int) -> Bool = x < 0

pub through_together_for(s: secret Bool, groups: List[List[Int]]) -> List[Int]
=
  let keep = if s then positive else negative
  let counts = together for xs in groups
    let kept = xs.filter(keep)
    kept.len
  counts

pub through_branch(s: secret Bool, xs: List[Int], ys: List[Int]) -> Int
=
  let keep = if s then positive else negative
  together
    let a = xs.filter(keep)
    let b = ys.filter(keep)
  a.len + b.len
