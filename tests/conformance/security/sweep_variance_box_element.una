-- test: a kind whose parameter is only in data positions is covariant at a list element (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:3
module sweep_variance_box_element

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub elem_0(v: Box[secret Int], w: Box[Int]) -> List[Box[Int]]
=
  let ws = [w, v]
  ws

pub elem_1(v: Box[Int], w: Box[secret Int]) -> List[Box[secret Int]]
=
  let ws = [w, v]
  ws
