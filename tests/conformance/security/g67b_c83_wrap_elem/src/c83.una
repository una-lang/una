-- test: ADR 0067 recheck of #231, control C83_wrap_elem: the same shapes with nothing secret decided, which edition 0.2 accepts (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: ok
module c83

wrap[T](x: T) -> List[T] = [x, x]

pub fine(xs: List[secret Int]) -> Int
=
  when wrap(xs).first
    is Some(v) -> v.len
    is None -> 0
