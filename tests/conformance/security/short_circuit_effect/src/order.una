-- test: a call with effects cannot stand in the right operand of `and`, `or` or `implies`, where a label of the left operand would decide whether it runs: it must be the whole expression of a statement or `let` (U3013), and under a `secret` left operand its effects are U4002 too, with or without tasks (#1677, spec/07 §3, spec/27 §8 rule 5)
-- spec: spec/07 §3
-- expect: error U3013 at src/order.una:17:17
-- expect: error U4002 at src/order.una:17:17
module order

noisy(k: Int) -> Bool
  uses @console: Console[print]
=
  @console.print("{k}")
  true

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let b = key mod 2
  if b == 1 and noisy(k)
    unit
  else
    unit

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  worker(1, key: key)
