-- test: a policy in a trusted module lowers a secret phone to an internal key
-- spec: spec/07 §5
-- expect: tier0-ok
module app.lookup

import app.keys (phone_key)
import app.types (Phone)

pub capability Directory
  op find(key: internal Hashed) -> Option[Text]
    accepts internal

pub name_for(phone: secret[PII] Phone) -> internal Option[Text]
  uses @directory: Directory[find]
  uses @keys: Keys[hmac]
=
  -- The policy's failure is decided by the phone, so it is released like the key, at
  -- `internal` (ADR 0090): it is handled under that label, not failed publicly.
  let key = attempt phone_key(phone)
  when key
    is Ok(hashed) -> @directory.find(hashed)
    is Err -> None
