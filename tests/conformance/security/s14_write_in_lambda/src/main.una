-- test: a write inside a lambda enters the file-state label as `internal`, since a lambda may run under any program counter, so a later read's failure is `internal` and branching on it is not public (S-14)
-- spec: spec/07 §7
-- expect: error U4003 at src/main.una:18:17
-- expect: error U4003 at src/main.una:19:18
module main

pub save_all(paths: List[Text]) -> List[internal Result[Unit, internal FileError]]
  uses @files: Files[write]
=
  paths.map(each: fn(p) -> attempt @files.write(p, content: "x"))

pub probe() -> Unit
  uses @files: Files[read]
  uses @console: Console[print]
=
  let r = attempt @files.read("a.txt")
  when r
    is Ok(v) -> @console.print("present")
    is Err(e) -> @console.print("absent")
