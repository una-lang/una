module sweep_label_nested_prelude

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab_boxed_list(x: Box[List[secret Int]]) -> secret Int = x.value.sum()

pub p_contains_boxed_list(xs: List[Box[List[secret Int]]]) -> Bool = xs.contains(item: Box(value: [2]))

pub p_first_boxed_list(xs: List[Box[List[secret Int]]]) -> Bool = xs.first() is Some

pub p_at_boxed_list(xs: List[Box[List[secret Int]]]) -> Bool = xs.at(index: 0) is Some

pub p_first_where_boxed_list(xs: List[Box[List[secret Int]]]) -> Bool = xs.first_where(keep: fn(y) -> true) is Some

pub p_filter_boxed_list(xs: List[Box[List[secret Int]]]) -> Int = xs.filter(keep: fn(y) -> true).len

pub p_map_boxed_list(xs: List[Box[List[secret Int]]]) -> List[Int] = xs.map(each: fn(y) -> 1)

pub p_fold_boxed_list(xs: List[Box[List[secret Int]]]) -> Int = xs.fold(initial: 0, step: fn(n, y) -> n + 1)

pub p_is_some_boxed_list(o: Option[Box[List[secret Int]]]) -> Bool = o.is_some()

pub p_is_ok_boxed_list(r: Result[Box[List[secret Int]], Int]) -> Bool = r.is_ok()

pub p_append_boxed_list(xs: List[Box[List[secret Int]]]) -> Int = xs.append(item: Box(value: [2])).len

pub p_or_else_boxed_list(o: Option[Box[List[secret Int]]]) -> Box[List[secret Int]] = o.or_else(default: Box(value: [2]))

pub p_is_empty_boxed_list(xs: List[Box[List[secret Int]]]) -> Bool = xs.is_empty()

pub p_sum_boxed_list(x: Box[List[secret Int]]) -> Int = [grab_boxed_list(x)].sum()

pub p_min_boxed_list(x: Box[List[secret Int]]) -> Int = min(grab_boxed_list(x), b: 0)

pub p_max_boxed_list(x: Box[List[secret Int]]) -> Int = max(grab_boxed_list(x), b: 0)

pub p_len_twin_boxed_list(xs: List[Box[List[secret Int]]]) -> Int = xs.len

grab_option_box(x: Option[Box[secret Int]]) -> secret Int = x.or_else(default: Box(value: 0)).value

pub p_contains_option_box(xs: List[Option[Box[secret Int]]]) -> Bool = xs.contains(item: Some(Box(value: 2)))

pub p_first_option_box(xs: List[Option[Box[secret Int]]]) -> Bool = xs.first() is Some

pub p_at_option_box(xs: List[Option[Box[secret Int]]]) -> Bool = xs.at(index: 0) is Some

pub p_first_where_option_box(xs: List[Option[Box[secret Int]]]) -> Bool = xs.first_where(keep: fn(y) -> true) is Some

pub p_filter_option_box(xs: List[Option[Box[secret Int]]]) -> Int = xs.filter(keep: fn(y) -> true).len

pub p_map_option_box(xs: List[Option[Box[secret Int]]]) -> List[Int] = xs.map(each: fn(y) -> 1)

pub p_fold_option_box(xs: List[Option[Box[secret Int]]]) -> Int = xs.fold(initial: 0, step: fn(n, y) -> n + 1)

pub p_is_some_option_box(o: Option[Option[Box[secret Int]]]) -> Bool = o.is_some()

pub p_is_ok_option_box(r: Result[Option[Box[secret Int]], Int]) -> Bool = r.is_ok()

pub p_append_option_box(xs: List[Option[Box[secret Int]]]) -> Int = xs.append(item: Some(Box(value: 2))).len

pub p_or_else_option_box(o: Option[Option[Box[secret Int]]]) -> Option[Box[secret Int]] = o.or_else(default: Some(Box(value: 2)))

pub p_is_empty_option_box(xs: List[Option[Box[secret Int]]]) -> Bool = xs.is_empty()

pub p_sum_option_box(x: Option[Box[secret Int]]) -> Int = [grab_option_box(x)].sum()

pub p_min_option_box(x: Option[Box[secret Int]]) -> Int = min(grab_option_box(x), b: 0)

pub p_max_option_box(x: Option[Box[secret Int]]) -> Int = max(grab_option_box(x), b: 0)

pub p_len_twin_option_box(xs: List[Option[Box[secret Int]]]) -> Int = xs.len

grab_wallet(x: Wallet) -> secret Int = x.acct.pin

pub p_contains_wallet(xs: List[Wallet]) -> Bool = xs.contains(item: Wallet(acct: Acct(id: 1, pin: 2)))

pub p_first_wallet(xs: List[Wallet]) -> Bool = xs.first() is Some

pub p_at_wallet(xs: List[Wallet]) -> Bool = xs.at(index: 0) is Some

pub p_first_where_wallet(xs: List[Wallet]) -> Bool = xs.first_where(keep: fn(y) -> true) is Some

pub p_filter_wallet(xs: List[Wallet]) -> Int = xs.filter(keep: fn(y) -> true).len

pub p_map_wallet(xs: List[Wallet]) -> List[Int] = xs.map(each: fn(y) -> 1)

pub p_fold_wallet(xs: List[Wallet]) -> Int = xs.fold(initial: 0, step: fn(n, y) -> n + 1)

pub p_is_some_wallet(o: Option[Wallet]) -> Bool = o.is_some()

pub p_is_ok_wallet(r: Result[Wallet, Int]) -> Bool = r.is_ok()

pub p_append_wallet(xs: List[Wallet]) -> Int = xs.append(item: Wallet(acct: Acct(id: 1, pin: 2))).len

pub p_or_else_wallet(o: Option[Wallet]) -> Wallet = o.or_else(default: Wallet(acct: Acct(id: 1, pin: 2)))

pub p_is_empty_wallet(xs: List[Wallet]) -> Bool = xs.is_empty()

pub p_sum_wallet(x: Wallet) -> Int = [grab_wallet(x)].sum()

pub p_min_wallet(x: Wallet) -> Int = min(grab_wallet(x), b: 0)

pub p_max_wallet(x: Wallet) -> Int = max(grab_wallet(x), b: 0)

pub p_len_twin_wallet(xs: List[Wallet]) -> Int = xs.len
