-- test: label order shape `loop-nested-result` (#323, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:17:20
module main

-- review: rejected (U4003) once nested positions are checked: the Err side inside a list
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = []
  xs = xs.append(item: Ok(0))
  for i in 0..<2
    let r = xs.at(index: i).or_else(default: Ok(0))
    @console.print("{r}")
    xs = xs.append(item: Err(s.len))
