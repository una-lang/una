-- test: a `secret` key read from a field of a record decides a branch around a call, in a started task; that data would decide how many check points the task passes, so the check point is U4002 (spec/27 §8 rule 5, #1684); its `internal` twin is `task_switch_internal_record_field` (#1708)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:24:7
module order

noop() -> Unit = unit

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

kind Box
  key: secret Int

worker(k: Int, box: Box) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: box.key)
  for i in 0..<3000
    if b == 1
      noop()
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  let box = Box(key: key)
  tasks
    for k in 0..<8
      start worker(k, box: box)
