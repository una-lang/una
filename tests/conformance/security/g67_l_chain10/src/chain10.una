-- test: ADR 0067 adversarial check of #231, L_chain10: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/chain10.una:28:34
module chain10

f0[T](a: T, b: T) -> Int = f1(a, b: b)

f1[T](a: T, b: T) -> Int = f2(a, b: b)

f2[T](a: T, b: T) -> Int = f3(a, b: b)

f3[T](a: T, b: T) -> Int = f4(a, b: b)

f4[T](a: T, b: T) -> Int = f5(a, b: b)

f5[T](a: T, b: T) -> Int = f6(a, b: b)

f6[T](a: T, b: T) -> Int = f7(a, b: b)

f7[T](a: T, b: T) -> Int = f8(a, b: b)

f8[T](a: T, b: T) -> Int = f9(a, b: b)

f9[T](a: T, b: T) -> Int = f10(a, b: b)

f10[T](a: T, b: T) -> Int = if a == b then 1 else 0

pub leak(s: secret Int) -> Int = f0(s, b: 0)
