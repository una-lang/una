-- test: function values: an `if` on the result of a labeled function value raises the program counter (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:41
-- expect: error U4003 at 23:5
-- expect: error U4003 at 25:5
module sweep_label_fnvalue_cond

low(x: Int) -> Int = x

high(x: Int) -> Int = x + 1

pick(pin: secret Int) -> secret fn(Int) -> Int = if pin > 0 then low else high

is_pin[T](x: T, y: T) -> Int = if x == y then 1 else 0

pub chosen(pin: secret Int) -> Int = if pick(pin)(1) > 0 then 1 else 0

pub printed(pin: secret Int) -> Unit
  uses @console: Console[print]
=
  let f = is_pin
  if f(pin, 1234) > 0
    @console.print("hit")
  else
    @console.print("miss")

pub chosen_twin(pin: secret Int) -> secret Int = if pick(pin)(1) > 0 then 1 else 0

pub printed_twin(n: Int) -> Unit
  uses @console: Console[print]
=
  let f = is_pin
  if f(n, 1234) > 0
    @console.print("hit")
  else
    @console.print("miss")
