-- test: an open position that inference leaves unsolved is U2001, which names it, and no label diagnostic
-- spec: spec/17 §2
-- expect: error U2001 at src/main.una:10:18
-- expect: error U2001 at src/main.una:15:23
-- expect: error U2001 at src/main.una:21:31
module main

pub nones() -> Int
=
  let edit xs = [None]
  xs.len

pub results() -> Int
=
  let edit xs = [Some(Ok(1))]
  xs.len

pub empty_lists() -> Int
=
  let edit m = empty_map()
  edit m.set(key: "a", value: [])
  m.len
