-- test: ADR 0067 recheck of #231, N03b_nested_list_inner: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n03b.una:11:8
-- expect: error U4001 at src/n03b.una:12:23
module n03b

pick[U](x: U, y: U, p: U, q: U) -> U = if x == y then p else q

pub leak(s: secret Int) -> Int
=
  when pick([[s]], y: [[0]], p: [[1]], q: [[2, 3]]).first
    is Some(inner) -> inner.len
    is None -> 0
