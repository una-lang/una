-- test: `Files.write` accepts at most `internal` for its path and content, so the file-state label's cap at `internal` hides no higher label (S-14, spec/14 §3)
-- spec: spec/07 §7
-- expect: error U4003 at src/main.una:10:32
-- expect: error U4003 at src/main.una:11:50
module main

pub save(path: secret Text, content: secret Text) -> Unit
  uses @files: Files[write]
=
  let a = attempt @files.write(path, content: "x")
  let b = attempt @files.write("a.txt", content: content)
  unit
