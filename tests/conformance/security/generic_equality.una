-- test: `==` on a type parameter inside a generic function returns an unlabeled Bool; instantiated with secret/internal data; runtime demo prints an internal env var comparison to Console (R-004)
-- spec: spec/07 §7
-- expect: error U4001 at 9:37
-- expect: error U4003 at 18:18
module generic_equality

same[T](a: T, b: T) -> Bool = a == b

pub leak(pin: secret Int) -> Bool = same(pin, b: 1234)

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  let guess = same(pin, b: "1234")
  @console.print("pin is 1234: {guess}")
