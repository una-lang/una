-- test: a via function with a requires clause is U4005 at the clause, since the policy call checks only from
-- spec: spec/07 §5, §7
-- expect: error U4005 at src/release.una:13:3
module app

import release (Pos, lower)

recip(p: Pos) -> Int = 100 / p

pub main() -> Unit
  uses @console: Console[print]
=
  let p = lower(0)
  let q = recip(p)
  @console.print("q = {q}")
