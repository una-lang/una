-- test: a record kind with a secret field: a call through a function value, generic or not, keeps the field labels (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 29:3
-- expect: error U4001 at 34:3
-- expect: error U4001 at 39:3
module sweep_label_record_fnvalue

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Acct) -> secret Int = x.pin

same[T](a: T, b: T) -> Bool = a == b

equal(a: Acct, b: Acct) -> secret Bool = a == b

pub generic_value(x: Acct) -> Bool
=
  let f = same
  f(x, Acct(id: 1, pin: 2))

pub plain_value(x: Acct) -> Bool
=
  let g = equal
  g(x, Acct(id: 1, pin: 2))

pub lambda_value(x: Acct) -> Bool
=
  let h = fn(a: Acct) -> a == Acct(id: 1, pin: 2)
  h(x)

pub generic_value_twin(x: Acct) -> secret Bool
=
  let f = same
  f(x, Acct(id: 1, pin: 2))

pub plain_value_twin(x: Acct) -> secret Bool
=
  let g = equal
  g(x, Acct(id: 1, pin: 2))

pub lambda_value_twin(x: Acct) -> secret Bool
=
  let h = fn(a: Acct) -> a == Acct(id: 1, pin: 2)
  h(x)
