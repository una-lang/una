-- test: whether `next` returns a request is `public`, so an accept loop that prints a line for each request it accepts stays at a `public` program counter (spec/31 §1, ADR 0123 IF1)
-- spec: spec/31 §1
-- expect: ok
module srv

import std.host (Exchange, HttpServer, Reply)

answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: exchange.right, reply: Reply(status: 204, headers: [], body: ""))
    if error use unit

pub main() -> Unit
  uses @server: HttpServer[next, reply]
  uses @console: Console[print]
  diverges
=
  for ever
    let next = attempt @server.next()
    when next
      is Ok(exchange) ->
        @console.print("accepted a request")
        answer(exchange)
      is Err(failure) -> @console.print("no request")
