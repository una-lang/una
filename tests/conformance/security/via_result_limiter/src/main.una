-- test: the outcome of a limiter wait reaches the result of a `via` function (#1673): whether `acquire` of a `limiter` the `via` body installs finds a token decides its result, and the policy is called in a branch of `together` beside work on a `secret` key, so the concurrent label of the statement the `limiter` scopes over is above `public`: one U4001 at the binding, which `spec/27 §10` reports already for the same label
-- spec: spec/07 §5
-- expect: error U4001 at src/release.una:16:25
module main

import release (key_of)

crunch(key: secret Int) -> secret Int
=
  let edit acc = key
  for i in 0..1000
    acc = if acc > 0 then acc - 1 else acc + 1
  acc

--- The policy is called in a branch of `together`, beside a branch that works on `key`.
pub both(key: secret Int, n: internal Int) -> Int
=
  together
    let a = crunch(key)
    let b = key_of(n)
  b
