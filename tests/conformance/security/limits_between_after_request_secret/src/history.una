-- test: the code between two requests (ADR 0116 P11): `mix` reads `key` after the request of `get` and before the request of `fetch`, so the second request's wait at the bucket reveals it: U4001 at each request
-- spec: spec/27 §9
-- expect: error U4001 at src/history.una:10:25
module history

--- One request, whose failure it handles, and a value.
get(url: Text) -> Int
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  0

mix(a: Int, key: secret Int) -> secret Int = a + key

pub run(url: Text, key: secret Int) -> Unit
  uses @http: Http[get]
=
  let a = get(url)
  let b = mix(a, key)
  let c = get(url)
  unit
