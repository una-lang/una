-- test: the history of a limit through a handler (ADR 0116 P1, P8, ADR 0117 IF4): the twin of `limits_handler_secret` whose handler works on `public` data, the same program but for that label, so the limits are accepted
-- spec: spec/27 §9
-- expect: ok
module busy

capability Work
  op go(url: Text) -> Unit

--- One request, whose failure it handles.
fetch(url: Text) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

crunch(key: Int) -> Int = key * 3

handler busy(seed: Int) for Work
  uses @http: Http[get]
  op go(url) =
    fetch(url)
    let spent = crunch(seed)
    fetch(url)

serve(url: Text) -> Unit
  uses @work: Work[go]
=
  @work.go(url)

pub run(url: Text, key: Int) -> Unit
  uses @http: Http[get]
=
  serve(url) with @work = busy(seed: key)
