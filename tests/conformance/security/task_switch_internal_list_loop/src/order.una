-- test: the twin of `task_switch_list_loop` with `internal` data: a `for` loop over a list whose label is `internal`, whose length that data chose, in a started task. Its iterations are `uncounted` (spec/27 §8 rule 5, #1708): accepted, the prints in order, and no `task switch` in the report
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "1"
-- expect: run-output "2"
-- expect: run-output "3"
-- expect: run-output "4"
-- expect: run-output "5"
-- expect: run-output "6"
-- expect: run-output "7"
module order

noop() -> Unit = unit

bit(k: Int, key: internal Int) -> internal Int
=
  let edit x: internal Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

total(xs: internal List[Int]) -> internal Int
=
  let edit acc: internal Int = 0
  for x in xs
    acc = acc + x
  acc

worker(k: Int, key: internal Int, big: List[Int]) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: key)
  let xs: internal List[Int] = if b == 1 then big else []
  let t = total(xs)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: internal Int = 90
  let edit big: List[Int] = []
  for i in 0..<3000
    big = append(big, item: i)
  tasks
    for k in 0..<8
      start worker(k, key: key, big: big)
