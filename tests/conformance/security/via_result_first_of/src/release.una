trusted module release

pub policy key_of
  from internal Int
  to Int
  via reveal_it
  purpose "a test"
  owner privacy

--- The `via` function: which branch of the race wins becomes its result.
reveal_it(t: internal Int) -> Int
=
  first of
    fast(t)
    slow(t)

fast(t: internal Int) -> internal Int = 1

slow(t: internal Int) -> internal Int
=
  let edit acc = t
  for i in 0..100
    acc = acc + 1
  2
