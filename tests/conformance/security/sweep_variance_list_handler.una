-- test: `List` is covariant at a handler result (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:16
module sweep_variance_list_handler

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

capability Give0
  op give(v: List[secret Int]) -> List[Int]

handler giving0() for Give0
  op give(v) = v

capability Give1
  op give(v: List[Int]) -> List[secret Int]

handler giving1() for Give1
  op give(v) = v

capability Give0Twin
  op give(v: List[secret Int]) -> List[secret Int]

handler giving0_twin() for Give0Twin
  op give(v) = v
