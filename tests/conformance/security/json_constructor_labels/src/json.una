-- test: in edition 0.4 a Json constructor accepts labeled arguments and its result carries the join of their labels: a secret text in Str, a secret key of an Object, a secret element of an Array and a public Json beside a secret one all give a secret Json, whose to_json is secret; Null, an empty Array and an empty Object stay public; the labeled value meets each lower declared type or sink where it reaches one: a public parameter (U4001), Console (U4003), a when on it, which raises the program counter of what it prints (U4003), and the failure of a parse it decides under if error pass (U4002) (spec/23 §5, ADR 0073 J5 as amended)
-- spec: spec/23 §5
-- expect: error U4001 at src/json.una:31:49
-- expect: error U4003 at src/json.una:36:18
-- expect: error U4003 at src/json.una:42:22
-- expect: error U4002 at src/json.una:49:5
module json

pub wrapped(token: secret Text) -> secret Json = Str(value: token)

pub written(token: secret Text) -> secret Text = Str(value: token).to_json()

keys(token: secret Text) -> secret Map[secret Text, Json] = empty_map().with(key: token,
  value: Null
)

pub keyed(token: secret Text) -> secret Json = Object(fields: keys(token))

pub listed(token: secret Text) -> secret Json = Array(items: [Number(value: 1), Str(value: token)])

pub nested(j: secret Json) -> secret Json = Array(items: [Null, j])

pub null() -> Json = Null

pub empty_array() -> Json = Array(items: [])

pub empty_object() -> Json = Object(fields: empty_map())

consume(j: Json) -> Int = 0

pub passed(token: secret Text) -> Int = consume(Str(value: token))

pub printed(token: secret Text) -> Unit
  uses @console: Console[print]
=
  @console.print(Str(value: token).to_json())

pub bound(token: secret Text) -> Unit
  uses @console: Console[print]
=
  when Str(value: token)
    is Str(value) -> @console.print(value)
    else -> unit

pub reparsed(token: secret Text) -> secret Json
  fails JsonError
=
  Str(value: token).to_json().parse_json()
    if error pass
