-- test: no label of an editable binding is decided by the order its reads and writes are checked
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:21:20
-- expect: error U4003 at src/main.una:25:20
-- expect: error U4003 at src/main.una:29:20
-- expect: error U4003 at src/main.una:35:18
-- expect: error U4003 at src/main.una:40:20
-- expect: error U4001 at src/main.una:46:11
-- expect: error U4001 at src/main.una:47:12
-- expect: error U4001 at src/main.una:51:40
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = []
  for i in 0..<2
    @console.print("{xs}")
    xs = xs.append(item: s.len)
  let edit o = None
  for i in 0..<2
    @console.print("{o}")
    o = Some(s.len)
  let edit m = empty_map()
  for i in 0..<2
    @console.print("{m}")
    edit m.set(key: i, value: s.len)
  let edit lists = empty_map()
  edit lists.set(key: "a", value: [1])
  edit lists.set(key: "b", value: [s.len])
  let a = lists.get(key: "a").or_else(default: [])
  @console.print("{a}")
  let edit nested = empty_map()
  for i in 0..<2
    let inner = nested.get(key: "x").or_else(default: empty_map())
    let row = inner.get(key: "y").or_else(default: [])
    @console.print("{row}")
    edit nested.set(key: "x", value: empty_map().with(key: "y", value: [s.len]))
  let edit xss = [[0]]
  for i in 0..<2
    let first = xss.at(index: i).or_else(default: [])
    @console.print("{first}")
    xss = xss.append(item: [s.len])
  let edit fs = []
  for i in 0..<2
    let f = fs.at(index: 0).or_else(default: fn(n: Int) -> n)
    @console.print("{f(1)}")
    fs = fs.append(item: fn(n: Int) -> n + s.len)
