-- test: in edition 0.5, the priorities of a priority queue are its shape: a `secret` priority pushed into a queue with a `public` top label is U4001 at the priority, with a control, and what `pop` gives from a queue of `secret` priorities is `secret`, U4003 at `Console`, while a queue of `public` priorities prints (ADR 0119 IF4)
-- spec: spec/28 §8
-- expect: error U4001 at src/channels.una:13:36
-- expect: error U4003 at src/channels.una:29:18
module channels

import std.collections (PriorityQueue, lowest_first)

--- A secret priority into an editable queue with a public top label.
pub into_public(x: secret Int) -> Unit
=
  var q: PriorityQueue[Text, Int] = lowest_first()
  edit q.push(item: "a", priority: x)
  unit

--- The control: the priority type is secret, so the queue's top label is too.
pub into_secret(x: secret Int) -> Unit
=
  var q: PriorityQueue[Text, secret Int] = lowest_first()
  edit q.push(item: "a", priority: x)
  unit

--- Which item comes out first depends on the secret priorities.
pub popped(q: PriorityQueue[Text, secret Int]) -> Unit
  uses @console: Console[print]
=
  var r = q
  const next = edit r.pop()
  @console.print("{next}")

--- The control: public priorities.
pub popped_public(q: PriorityQueue[Text, Int]) -> Unit
  uses @console: Console[print]
=
  var r = q
  const next = edit r.pop()
  @console.print("{next}")
