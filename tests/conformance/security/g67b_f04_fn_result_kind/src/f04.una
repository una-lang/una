-- test: ADR 0067 recheck of #231, F04_fn_result_kind: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f04.una:6:71
module f04

mk[T](a: T, b: T, p: T, q: T) -> fn(Int) -> Option[T] = fn(n: Int) -> Some(if a == b then p else q)

pub leak(s: secret Int) -> Int
=
  let g = mk([s], b: [0], p: [], q: [1, 2])
  when g(0)
    is Some(v) -> v.len
    is None -> 0
