-- test: the state of `on_stop` must have the units of the result of `init` and of the state of `step`: an `Int of Millisecond` state may not reach `on_stop(state: Int of Second)` (spec/26 §2, issue #1647)
-- spec: spec/26 §2
-- expect: error U2028 at src/counter.una:13:20
module counter

import std.drive (Tick)
import std.time (Millisecond, Second)

pub init() -> Int of Millisecond = 7.measured()

pub step(edit state: Int of Millisecond, input: Tick) -> Unit = unit

pub on_stop(state: Int of Second) -> Unit = unit
