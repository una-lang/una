-- test: a policy call runs its `via` function (#1673): the `via` makes a request on a grant with limits, and the policy is called in a construct beside work on a `secret`; the policy call's edge to the `via` makes `both`, whose body reads the `secret`, an ancestor of the request (`L_lim`, ADR 0116 P10) and puts the request beside that work (`τ_conc`, `spec/27 §11`), above the `internal` that `L_lim` allows (U4001 at the request)
-- spec: spec/07 §5
-- expect: error U4001 at src/release.una:14:23
module main

import release (key_of)

crunch(key: secret Int) -> secret Int
=
  let edit acc = key
  for i in 0..1000
    acc = if acc > 0 then acc - 1 else acc + 1
  acc

--- The policy is called in a branch of `together`, beside a branch that works on `key`.
pub both(key: secret Int, n: Int) -> Int
  uses @http: Http[get]
=
  together
    let a = crunch(key)
    let b = key_of(n)
  b
