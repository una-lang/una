-- test: a record kind with a secret field: as a capability operation argument it exceeds a public sink (label sweep)
-- spec: spec/07 §7
-- expect: error U4003 at 29:15
module sweep_label_record_sink

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Acct) -> secret Int = x.pin

capability Audit
  op note(x: Acct) -> Unit
    accepts public
  op keep(x: Acct) -> Unit
    accepts secret

pub sunk(x: Acct) -> Unit
  uses @audit: Audit[note]
=
  @audit.note(x)

pub kept(x: Acct) -> Unit
  uses @audit: Audit[keep]
=
  @audit.keep(x)
