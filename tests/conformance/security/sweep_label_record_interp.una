-- test: a record kind with a secret field: an interpolation of a comparison of it is a secret argument of Console (label sweep)
-- spec: spec/07 §7
-- expect: error U4003 at 23:18
module sweep_label_record_interp

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Acct) -> secret Int = x.pin

pub shown(x: Acct) -> Unit
  uses @console: Console[print]
=
  @console.print("same {x == Acct(id: 1, pin: 2)}")

pub shown_twin(x: Acct) -> Unit
  uses @console: Console[print]
=
  @console.print("fixed")
