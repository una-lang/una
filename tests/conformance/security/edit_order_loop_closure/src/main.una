-- test: label order shape `loop-closure` (#323, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:16:20
module main

-- review: rejected (U4003): a closure reads the binding
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = []
  for i in 0..<2
    let show = fn() -> "{xs}"
    @console.print(show())
    xs = xs.append(item: s.len)
