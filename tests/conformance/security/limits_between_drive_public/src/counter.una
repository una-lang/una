-- test: the `public` twin of `limits_between_drive_secret`: the step works on a `public` state after its request (ADR 0116 P11)
-- spec: spec/27 §9
-- expect: ok
module counter

import std.drive (Tick)

pub init() -> Int = 42

pub step(edit count: Int, input: internal Tick) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get("https://api.example.com/tick", headers: [], key_name: None)
  let spent = count * 3
  unit
