-- test: a write to an `internal` path decides whether a later read of a public path succeeds, so the read's failure is `internal` and branching on it is not public (S-14)
-- spec: spec/07 §7
-- expect: error U4003 at src/main.una:14:17
-- expect: error U4003 at src/main.una:15:18
module main

pub probe(secret_path: internal Text) -> Unit
  uses @files: Files[read, write]
  uses @console: Console[print]
=
  let w = attempt @files.write(secret_path, content: "x")
  let r = attempt @files.read("a.txt")
  when r
    is Ok(v) -> @console.print("the secret path was a.txt")
    is Err(e) -> @console.print("the secret path was not a.txt")
