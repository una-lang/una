-- test: the twin of `via_result_value_call`: the `via` applies only lambdas written at their calls, so the lambdas of other functions are not code it reaches, and the `within` that a lambda of `tally` runs, beside the tasks of `pair`, is not checked against the `via` (spec/07 §5 rule 7)
-- spec: spec/07 §5
-- expect: ok
module main

import release (key_of)
import std.time (millisecond)

timed(t: Int) -> restricted Int
=
  let v: restricted Int = t within 1 * millisecond
    if error use 0
  v

pub tally(n: Int) -> List[restricted Int] = [n].map(each: fn(x: Int) -> timed(x))

pub pair(a: Int, b: Int) -> Int
=
  together
    let x = a + 1
    let y = b + 1
  x + y

--- The policy is called from sequential code.
pub once(n: internal Int) -> Int = key_of(n)
