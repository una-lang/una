-- test: ADR 0067 adversarial check of #231, L36_tag_by_index: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l36.una:10:54
module l36

kind Box[T]
  item: T
  count: Int

boxed[T](a: T, b: T) -> Box[T] = Box(item: a, count: if a == b then 1 else 0)

pub leak(s: secret Int) -> Int = boxed(s, b: 0).count
