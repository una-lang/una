trusted module release

pub kind ViaError = Broke(detail: Text) | Gone

pub policy key_of
  from secret Text
  to internal Hashed
  via hmac_it
  purpose "a keyed hash of the text"
  owner privacy

hmac_it(t: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails ViaError
=
  let sizes = [t].map(each: fn(x) -> if x.len < 20 then x.len else fail Gone)
    if error pass
  @keys.hmac(key_name: "pepper", data: t)
    if error fail Gone
