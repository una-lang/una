-- test: an editable binding keeps its declared label: an assignment, an `edit` argument or a join under a `secret` condition, or of a `secret` value, into a `public` binding is U4001 (spec/17 §6 rule 1, V2-16)
-- spec: spec/17 §6
-- expect: error U4001 at src/memflow.una:24:9
-- expect: error U4001 at src/memflow.una:31:14
-- expect: error U4001 at src/memflow.una:38:15
-- expect: error U4001 at src/memflow.una:46:11
-- expect: error U4001 at src/memflow.una:49:11
-- expect: error U4001 at src/memflow.una:57:9
-- expect: error U4001 at src/memflow.una:61:3
-- expect: error U4001 at src/memflow.una:66:7
module memflow

pub kind Tally
  count: Int

add(edit t: Tally) -> Unit
=
  t.count = t.count + 1

pub assigned(pin: secret Int) -> Int
=
  let edit n = 0
  if pin > 3
    n = 1
  n

pub passed_as_edit(pin: secret Int) -> Int
=
  let edit t = Tally(count: 0)
  if pin > 3
    add(edit t)
  t.count

pub field(pin: secret Int) -> Int
=
  let edit t = Tally(count: 0)
  if pin > 3
    t.count = 5
  t.count

pub in_when(pin: secret Int) -> Int
=
  let edit n = 0
  let u = when pin
    is 1 ->
      n = 2
      unit
    else ->
      n = 3
      unit
  n

pub joined_value(pin: secret Int) -> Int
=
  let edit n = 0
  let y = if pin > 3
    n = 1
    2
  else
    3
  n + y

pub secret_value(pin: secret Int) -> Int
=
  let edit n = 0
  n = if pin > 3 then 1 else 2
  n

pub secret_binding(pin: secret Int) -> Unit
=
  let edit n: secret Int = 0
  if pin > 3
    n = 1
