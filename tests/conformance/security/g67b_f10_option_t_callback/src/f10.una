-- test: ADR 0067 recheck of #231, F10_option_T_callback: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f10.una:8:34
module f10

apply[T](a: T, b: T, k: fn(Option[T]) -> Int) -> Int = k(if a == b then Some(a) else None)

pub leak(s: secret Int) -> Int = apply(s, b: 0,
  k: fn(o: Option[secret Int]) -> if o is Some then 1 else 0
)
