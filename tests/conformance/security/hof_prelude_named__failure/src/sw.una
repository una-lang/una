-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): rule: a failing callback of the prelude is U3009 in edition 0.1
-- spec: spec/07 §7
-- expect: error U4002 at src/sw.una:28:11
-- expect: error U3009 at src/sw.una:28:47
-- expect: error U4001 at src/sw.una:28:47
-- expect: error U4003 at src/sw.una:29:14
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int fails Bad) -> Unit
  uses @log: Log[write]
=
  let n = [if a == b then p else q].map(each: k).sum()
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: check_len)
