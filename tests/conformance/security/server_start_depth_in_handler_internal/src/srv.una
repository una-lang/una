-- test: the twin of `server_start_depth_in_handler_secret` with an `internal` key, which the auto-answer accepts: accepted (spec/31 §1, #1682)
-- spec: spec/31 §1
-- expect: ok
module srv

import std.host (Exchange, HttpServer, Reply)

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

answer(exchange: internal Exchange, d: internal Int) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

capability Runner
  op go() -> Unit

handler running(exchanges: internal List[Exchange], key: internal Int) for Runner
  uses @server: HttpServer[reply]
  op go() =
    tasks
      for exchange in exchanges
        start answer(exchange, d: if key > 0 then deep(3000) else 0)

use_runner() -> Unit
  uses @r: Runner[go]
=
  @r.go()

pub serve_all(exchanges: internal List[Exchange], key: internal Int) -> Unit
  uses @server: HttpServer[reply]
=
  use_runner() with @r = running(exchanges, key: key)
