-- test: ADR 0067 adversarial check of #231, L14_nested: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l14.una:10:34
-- expect: error U4001 at src/l14.una:10:71
-- expect: error U4001 at src/l14.una:10:116
module l14

nest[T](a: T, b: T) -> List[List[Int]] = [[if a == b then 1 else 0]]

pub leak(s: secret Int) -> Int = nest(s, b: 0).fold(initial: 0, step: fn(acc,
    row
  ) -> row.fold(initial: acc, step: fn(n, v) -> n + v))
