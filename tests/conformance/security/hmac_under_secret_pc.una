-- test: Keys.hmac under a secret condition, whose failure would reveal it (R-015)
-- spec: spec/07 §7
-- expect: error U4003 at 10:27
module hmac_under_secret_pc

pub probe(flag: secret Bool) -> Unit
  uses @keys: Keys[hmac]
=
  if flag
    let outcome = attempt @keys.hmac(key_name: "pepper", data: "yes")
    unit
  else
    unit
