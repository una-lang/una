-- test: a function value whose result is `secret` instantiates a generic function whose body calls a function under a branch on that result: the label of the function value's result is what its type argument carries, so the generic call is U4002 (spec/27 §8 rule 5, #1684, review H1)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:27:5
module order

noop() -> Unit = unit

go[T: Eq](f: fn() -> T, t: T) -> Unit
=
  if f() == t
    noop()
  else
    unit

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: key)
  for i in 0..<3000
    go(fn() -> b == 1, t: true)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
