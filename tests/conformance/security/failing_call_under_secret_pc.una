-- test: a call that can fail under a secret condition
-- spec: spec/07 §3
-- expect: error U4002 at 17:17
module failing_call_under_secret_pc

kind LookupError = | Missing

find(key: Int) -> Int
  fails LookupError
=
  if key > 0 then key else fail Missing

pub lookup(flag: secret Bool) -> secret Int
  fails LookupError
=
  if flag
    let value = find(1)
      if error use 0
    value
  else
    0
