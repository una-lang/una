-- test: where a generic body's result does depend on values of a type parameter, its summary holds the parameter at that position, so a secret argument still reaches the result there: by a branch, by a filter over a comparison, by a recursive helper, through a returned function's result, an option's presence and a kind's field (ADR 0067, spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/summaryleaks.una:22:41
-- expect: error U4001 at src/summaryleaks.una:27:48
-- expect: error U4001 at src/summaryleaks.una:29:48
-- expect: error U4001 at src/summaryleaks.una:32:138
-- expect: error U4001 at src/summaryleaks.una:34:51
-- expect: error U4001 at src/summaryleaks.una:37:49
-- expect: error U4001 at src/summaryleaks.una:47:49
-- expect: error U4001 at src/summaryleaks.una:50:60
module summaryleaks

pub kind Box[T]
  item: T
  count: Int

pub concat[T](front: List[T], back: List[T]) -> List[T] = back.fold(initial: front, step: fn(acc,
    x
  ) -> acc.append(item: x))

--- The shape depends on a comparison of `T` values: the top carries `T`.
smaller[T: Ord](a: T, b: T) -> List[T] = if a < b then [a] else [b, a]

pub leak_branch(s: secret Int) -> Int = smaller(s, b: 0).len

--- A filter over a comparison: the top carries `T` (L4).
below[T: Ord](xs: List[T], pivot: T) -> List[T] = xs.filter(keep: fn(x) -> x < pivot)

pub leak_filter(xs: List[secret Int]) -> Int = below(xs, pivot: 0).len

pub leak_first(xs: List[secret Int]) -> Bool = xs.first_where(keep: fn(x) -> x > 0).is_some()

--- Recursion: a branch on `T` values deep in the recursion still reaches the top.
matches[T: Eq](xs: List[T], x: T,
  n: Int
) -> List[Int] = if n <= 0 then (if xs.contains(item: x) then [1] else []) else concat([],
  back: matches(xs, x, n: n - 1)
)

pub leak_recursion(xs: List[secret Int]) -> Int = matches(xs, x: 1, n: 3).len

--- A returned function whose result reads a captured `T` value.
tester[T: Eq](x: T) -> fn(T) -> Bool = fn(y) -> y == x

pub leak_function(s: secret Int) -> Bool
=
  let test = tester(s)
  test(1)

--- An option whose presence depends on a `T` value.
found[T: Eq](xs: List[T], x: T) -> Option[Int] = if xs.contains(item: x) then Some(1) else None

pub leak_option(xs: List[secret Int]) -> Bool = found(xs, x: 1).is_some()

--- A kind's `Int` field computed from a `T` value.
counted[T: Eq](x: T, y: T) -> Box[T] = Box(item: x, count: if x == y then 1 else 0)

pub leak_field(s: secret Int) -> Int = counted(s, y: 0).count
