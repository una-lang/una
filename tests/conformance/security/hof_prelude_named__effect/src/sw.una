-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, the review matrix): rule: an effectful callback of the prelude is U3003 in edition 0.1
-- spec: spec/07 §7
-- expect: error U4002 at src/sw.una:28:15
-- expect: error U3003 at src/sw.una:28:51
-- expect: error U4001 at src/sw.una:28:51
-- expect: error U4003 at src/sw.una:29:14
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  let units = [if a == b then p else q].map(each: k)
  @log.write(units.len)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> @log.write(xs.len))
