-- test: ADR 0067 amendment (2026-10-06), B07_map_with_k_c: a T value decided by comparing T values goes where a value of T is expected (a lambda, a higher-order function, a function result, an `edit` binding or a field of the body), which edition 0.2 rejects in the generic body; the control, sound, is rejected there, an accepted cost, since accepting it soundly would need re-checking lambdas (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/b07_map_with_k_c.una:8:44
module b07_map_with_k_c

apply[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Int
=
  when [if a == b then p else q].map(each: k).first
    is Some(v) -> v
    is None -> 0

pub leak(s: Int) -> Int = apply([s], b: [0], p: [], q: [1, 2], k: fn(xs) -> xs.len)
