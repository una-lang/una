-- test: the via function of a policy is private
-- spec: spec/07 §5
-- expect: error U4005 at src/app/keys.una:9:7
trusted module app.keys

pub policy mask
  from secret[PII] Text
  to internal Text
  via masked
  purpose "show the last digits"
  owner privacy

pub masked(t: secret[PII] Text) -> internal Text = t
