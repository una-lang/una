-- test: a driven step that only prints `public` values has a `public` timing label, and its `input` needs no label (spec/26 §2, ADR 0116 IF7)
-- spec: spec/26 §2
-- expect: ok
module counter

import std.drive (Tick)

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
  uses @console: Console[print]
=
  count = count + 1
  @console.print("frame {count} at {input.at}")
