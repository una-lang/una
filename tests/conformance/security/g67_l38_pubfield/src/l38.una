-- test: ADR 0067 adversarial check of #231, L38_pubfield: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l38.una:11:41
module l38

kind Out
  n: Int

less[T](a: T, b: T) -> Int = if a == b then 1 else 0

pub leak(s: secret Int) -> Out = Out(n: less(s, b: 0))
