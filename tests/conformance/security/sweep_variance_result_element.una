-- test: `Result` is covariant in both arguments at a list element (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:3
-- expect: error U4001 at 21:3
module sweep_variance_result_element

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub elem_0(v: Result[secret Int, Int], w: Result[Int, Int]) -> List[Result[Int, Int]]
=
  let ws = [w, v]
  ws

pub elem_1(v: Result[Int, secret Int], w: Result[Int, Int]) -> List[Result[Int, Int]]
=
  let ws = [w, v]
  ws

pub elem_2(v: Result[Int, Int], w: Result[secret Int, secret Int]) -> List[Result[secret Int,
    secret Int
  ]]
=
  let ws = [w, v]
  ws
