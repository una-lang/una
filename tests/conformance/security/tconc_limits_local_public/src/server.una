-- test: `L_lim` with the precise `τ_conc` (ADR 0116 amendment of 2026-10-25, C, #1154): the grant carries limits, and a `tasks` block starts `churn_open(key)`, on a `public` local, beside a started task that makes a request; every ancestor's `τ⁰` is `internal`, from `ρ` of `Http`, and so is `τ_conc` at the request, so the limits are accepted, which the preview's `⊤` refused; its twin is `tconc_limits_tasks`
-- spec: spec/27 §9
-- expect: ok
module server

crunch(key: secret Int) -> secret Int = key * 3

churn(key: secret Int) -> Unit
=
  let spent = crunch(key)
  unit

crunch_open(n: Int) -> Int = n * 3

churn_open(n: Int) -> Unit
=
  let spent = crunch_open(n)
  unit

fetch(path: Text) -> Unit
  uses @http: Http[get]
=
  let reply = attempt @http.get(url: "https://api.example.com/{path}", headers: [], key_name: None)
  unit

pub serve(path: Text) -> Unit
  uses @http: Http[get]
=
  let key: Int = 7
  tasks
    start churn_open(key)
    start fetch(path)
  unit
