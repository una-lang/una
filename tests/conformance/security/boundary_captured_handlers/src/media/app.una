-- test: a lambda or a function value given to a boundary runs on the bindings its `uses` resolve to where it is written, even when the boundary calls it under a handler of its own: a handler there counts with its own `uses` and releases; inside a lambda written outside the call, a captured binding is not followed, so the value is opaque; a handler that fits and releases nothing is accepted (ADR 0093 rules 5 and 8)
-- spec: spec/05 §4
-- expect: error U3024 at src/media/app.una:36:3
-- expect: error U3024 at src/media/app.una:40:3
-- expect: error U3021 at src/media/app.una:45:3
-- expect: error U3021 at src/media/app.una:49:25
-- expect: error U3024 at src/media/app.una:49:25
module media.app

import media.log (Log, Net)
import media.release (reveal)
import media.render (process)

handler leaky() for Log
  op write(n) = reveal(n)

handler costly() for Log
  uses @net: Net[post]
  op write(n) = @net.post(n)

handler plain() for Log
  op write(n) = n

via_log(n: Int) -> Int
  uses @log: Log[write]
=
  @log.write(n)

around(n: Int, f: fn(Int) -> Int uses @log: Log[write]) -> Int
  uses @log: Log[write]
=
  f(n)

pub by_lambda(n: Int) -> Int
=
  process(n, f: fn(m) -> @log.write(m)) with @log = leaky()

pub by_value(n: Int) -> Int
=
  process(n, f: via_log) with @log = leaky()

pub by_costly(n: Int) -> Int
  uses @net: Net[post]
=
  process(n, f: fn(m) -> @log.write(m)) with @log = costly()

pub nested(n: Int) -> Int
=
  around(n, f: fn(m) -> process(m, f: via_log)) with @log = plain()

pub fine(n: Int) -> Int
=
  process(n, f: fn(m) -> @log.write(m)) with @log = plain()
