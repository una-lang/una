-- test: `Result` is covariant in both arguments at a constructor field (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 16:61
-- expect: error U4001 at 21:61
module sweep_variance_result_field

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

kind Hold0
  w: Result[Int, Int]

pub field_0(v: Result[secret Int, Int]) -> Hold0 = Hold0(w: v)

kind Hold1
  w: Result[Int, Int]

pub field_1(v: Result[Int, secret Int]) -> Hold1 = Hold1(w: v)

kind Hold2
  w: Result[secret Int, secret Int]

pub field_2(v: Result[Int, Int]) -> Hold2 = Hold2(w: v)
