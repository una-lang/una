-- test: a generic kind instantiated with a secret type: as a capability operation argument it exceeds a public sink (label sweep)
-- spec: spec/07 §7
-- expect: error U4003 at 29:15
module sweep_label_generic_sink

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Box[secret Int]) -> secret Int = x.value

capability Audit
  op note(x: Box[secret Int]) -> Unit
    accepts public
  op keep(x: Box[secret Int]) -> Unit
    accepts secret

pub sunk(x: Box[secret Int]) -> Unit
  uses @audit: Audit[note]
=
  @audit.note(x)

pub kept(x: Box[secret Int]) -> Unit
  uses @audit: Audit[keep]
=
  @audit.keep(x)
