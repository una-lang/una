-- test: function values: a function value that is labeled, or whose result or parameter carries a label, exceeds a public sink (label sweep)
-- spec: spec/07 §7
-- expect: error U4003 at 26:16
-- expect: error U4003 at 32:16
-- expect: error U4003 at 38:20
-- expect: error U4003 at 44:16
module sweep_label_fnvalue_sink

low(x: Int) -> Int = x

high(x: Int) -> Int = x + 1

pick(pin: secret Int) -> secret fn(Int) -> Int = if pin > 0 then low else high

is_pin[T](x: T, y: T) -> Int = if x == y then 1 else 0

capability Relay
  op relay(f: fn(Int) -> Int) -> Unit
    accepts public
  op relay_all(fs: List[fn(Int) -> Int]) -> Unit
    accepts public

pub labeled(pin: secret Int) -> Unit
  uses @relay: Relay[relay]
=
  @relay.relay(pick(pin))

pub captured(pin: secret Int) -> Unit
  uses @relay: Relay[relay]
=
  let f = fn(x: Int) -> x + pin
  @relay.relay(f)

pub listed(pin: secret Int) -> Unit
  uses @relay: Relay[relay_all]
=
  let f = fn(x: Int) -> x + pin
  @relay.relay_all([f])

pub parameter() -> Unit
  uses @relay: Relay[relay]
=
  let f = fn(x: secret Int) -> 1
  @relay.relay(f)

pub plain() -> Unit
  uses @relay: Relay[relay]
=
  @relay.relay(low)
