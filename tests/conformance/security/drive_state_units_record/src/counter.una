-- test: units are compared in the type argument of a generic record: `Clock[Int of Second]` may not reach `Clock[Int of Millisecond]` (spec/26 §2, issue #1647)
-- spec: spec/26 §2
-- expect: error U2028 at src/counter.una:17:22
module counter

import std.drive (Tick)
import std.time (Millisecond, Second)

kind Clock[T]
  elapsed: T

pub init() -> Clock[Int of Second]
=
  let start: Int of Second = 7.measured()
  Clock(elapsed: start)

pub step(edit state: Clock[Int of Millisecond], input: Tick) -> Unit = unit
