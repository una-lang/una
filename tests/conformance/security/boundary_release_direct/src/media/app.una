-- test: a call into a boundary module whose called function performs a release directly in its own body is U3024; a call that reaches none is accepted (ADR 0093 rule 8, amendment of 2026-10-11)
-- spec: spec/07 §6
-- expect: error U3024 at src/media/app.una:8:34
module media.app

import media.render (plain, show)

pub leak(n: secret Int) -> Int = show(n)

pub fine(n: Int) -> Int = plain(n)
