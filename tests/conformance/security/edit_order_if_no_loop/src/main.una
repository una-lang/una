-- test: label order shape `if-no-loop` (#323, N-45, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:16:18
module main

-- review: accepted, no leak: a read before the only flow, without a loop, sees a value with no internal data (control)
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = []
  if s.len > 100
    unit
  @console.print("{xs}")
  xs = xs.append(item: s.len)
