-- test: the twin of `tconc_residue_dep` whose dependency function makes its request with no task construct: nothing outside the root package can leave a request on a helper, `L_res` is `public`, and the `within` over pure work prints (ADR 0116 P9)
-- spec: spec/26 §7
-- expect: ok
module main

import std.time (millisecond)
import util.fetch (fetch_all)

pub run(url: Text) -> Unit
  uses @http: Http[get]
=
  fetch_all(url) with @http = @http[get]

step(n: Int) -> Int = n + 1

pub show(n: Int) -> Unit
  uses @console: Console[print]
=
  let v = step(n) within 10 * millisecond
    if error use 0
  @console.print("{v}")
