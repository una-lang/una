-- test: the result of Keys.hmac carries the label of data, so lowering it needs a policy (R-014)
-- spec: spec/07 §5, §7
-- expect: error U4001 at 11:3
module hmac_without_policy

-- Promoted from the v0.1 review, adversarial `flow-hmac-without-policy.una`.
pub launder(phone: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: "pepper", data: phone)
    if error pass
