-- test: the residue of a loser of `first of` (ADR 0116 P9): a program without a task races a request against pure work, and a request that loses is cut while its helper keeps working, at moments the network decides, beside later code; `L_res` is the race's `internal` label, from `ρ` of `Http`, and joins the timing label of every site, so the outcome of a later `within` over pure work is `internal`, which `Console.print` refuses (U4003)
-- spec: spec/27 §6
-- expect: error U4003 at src/race.una:35:18
module race

import std.time (millisecond)

--- Public work that runs for a while.
busy(m: Int) -> Int
=
  let edit total = 0
  for i in 1..m
    total = total + 1
  total

--- One request, whose failure it handles.
fetch(url: Text) -> Int
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  1

step(n: Int) -> Int = n + 1

pub run(url: Text, m: Int, n: Int) -> Unit
  uses @console: Console[print]
  uses @http: Http[get]
=
  for i in 1..10
    let got = first of
      fetch(url)
      busy(m)
  let v = step(n) within 10 * millisecond
    if error use 0
  @console.print("{v}")
