-- test: ADR 0067 adversarial check of #231, L22_recfnvalue: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l22.una:10:34
module l22

apply[T](f: fn(T, T) -> Int, a: T, b: T) -> Int = f(a, b)

cmp[T](a: T, b: T) -> Int = if a == b then 1 else 0

go[T](a: T, b: T) -> Int = apply(cmp, a, b)

pub leak(s: secret Int) -> Int = go(s, b: 0)
