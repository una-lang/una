-- test: an interpolated record carries the labels of all its fields, so a `secret` field makes the text secret and `Console` rejects it; nothing is redacted (spec/07 §7 rule 3, ADR 0068 D3)
-- spec: spec/07 §7
-- grant: console
-- expect: error U4003 at src/secret_print.una:14:18
module secret_print

pub kind Account
  owner: Text
  balance: secret Int

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("account {open()}")

open() -> Account = Account(owner: "Ana", balance: 10)
