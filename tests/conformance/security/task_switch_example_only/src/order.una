-- test: a private function whose loop a `secret` value bounds, which only a `test` declaration calls, is code that no run of the program reaches: `una test` runs it, a run never does, so its check points move no schedule of started tasks and the package is accepted; its twin `task_switch_reached` calls the same function from a task and is refused (spec/27 §8 rule 5, #1707)
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "1"
module order

spin(n: secret Int) -> secret Int
=
  let edit acc: secret Int = 0
  for i in 0..<n
    acc = acc + 1
  acc

twice(n: secret Int) -> secret Int = spin(n) + spin(n)

worker(k: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  tasks
    for k in 0..<2
      start worker(k)

test "spin counts its bound twice"
  do twice(3)
  expect result == 6
