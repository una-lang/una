-- test: the category of a `gives` label is declared in `[labels] categories`, as a type's is (ADR 0094 rule 1)
-- spec: spec/07 §2
-- expect: error U4007 at src/m.una:10:51
module m

pub capability Files
  op owner(file: Text) -> Text
  op role(file: Text) -> Text

pub refusal(file: Text) -> internal Text
  uses @service_files: Files[owner gives internal[Nope]]
=
  @service_files.owner(file)
