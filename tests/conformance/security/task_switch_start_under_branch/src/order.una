-- test: a `start` under a branch on a `secret` bit: the started call is a check point of the task that runs the `tasks` statement; that data would decide how many check points the task passes, so the check point is U4002 (spec/27 §8 rule 5, #1684); its `internal` twin is `task_switch_internal_start_under_branch` (#1708)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:32:15
module order

noop() -> Unit = unit

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

spin() -> Unit
=
  for i in 0..<3000
    noop()

printer(k: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  tasks
    for k in 0..<8
      if bit(k, key: key) == 1
        start spin()
      start printer(k)
