-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, the review matrix): reject: (if decided then k else j)(p)
-- spec: spec/07 §7
-- expect: error U4003 at src/sw.una:26:14
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int, j: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let n = (if a == b then k else j)(p)
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len, j: fn(xs) -> 0)
