-- test: ADR 0067 adversarial check of #231, L52_param_pos_when: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l52.una:12:34
module l52

pick[U](x: U, y: U, p: U, q: U) -> U
=
  when x == y
    is true -> p
    is false -> q

pub leak(s: secret Int) -> Int = pick([s], y: [0], p: [], q: [s, s]).len
