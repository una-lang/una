-- test: a `start` in a handler's operation body, whose started call decides by a `secret` key whether it calls the recursive `deep`, keeps the coarse depth test, since no function holds the `start` for the precise one to look in: U4003 at the `start`, and U4002 at the call that the key decides (spec/31 §1, ADR 0123 IF6, #1682)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:30:9
-- expect: error U4002 at src/srv.una:30:51
module srv

import std.host (Exchange, HttpServer, Reply)

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

answer(exchange: internal Exchange, d: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

capability Runner
  op go() -> Unit

handler running(exchanges: internal List[Exchange], key: secret Int) for Runner
  uses @server: HttpServer[reply]
  op go() =
    tasks
      for exchange in exchanges
        start answer(exchange, d: if key > 0 then deep(3000) else 0)

use_runner() -> Unit
  uses @r: Runner[go]
=
  @r.go()

pub serve_all(exchanges: internal List[Exchange], key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  use_runner() with @r = running(exchanges, key: key)
