-- test: a read in a module checked before the module that writes still carries the file-state label (S-14, from Una-2's review)
-- spec: spec/07 §7
-- expect: error U4001 at src/a_reader.una:10:3
module a_reader

pub found() -> Bool
  uses @files: Files[read]
=
  let r = attempt @files.read("marker.txt")
  is_ok(r)
