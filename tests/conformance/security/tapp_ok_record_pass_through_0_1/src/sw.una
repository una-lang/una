-- test: in edition 0.1, a function value given a value of a type parameter, or a decision on such values (#253, review of #343): ok (no U4xxx): a record's function value applied to a value of T, with no decision
-- spec: spec/07 §7
-- expect: ok
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Box[T]
  run: fn(T) -> Int

g[T](p: T, box: Box[T]) -> Unit
  uses @log: Log[write]
=
  let f = box.run
  @log.write(f(p))

pub fine(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], box: Box(run: fn(xs) -> xs.len))
