-- test: ADR 0067 recheck of #231, L20b: `f` swaps its arguments through `g` into `h`, which compares its `b`, which is `f`'s `b`; from `f(s, b: 0)` that is public, so the summaries `top from U` accept it, and the mirror call `f(0, b: s)` is rejected (g67_l20c_mutualswap_mirror) (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: ok
module l20b

f[T, U](a: T, b: U, n: Int) -> List[Int] = if n <= 0 then [] else g(b, b: a, n: n - 1)

g[T, U](a: T, b: U, n: Int) -> List[Int] = h(b, b: a, n: n)

h[T, U](a: T, b: U, n: Int) -> List[Int] = if n == 1 then (if b == b then [1] else []) else f(a, b, n: n - 1)

pub leak(s: secret Int) -> Int = f(s, b: 0, n: 9).len
