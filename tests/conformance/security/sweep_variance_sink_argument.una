-- test: a kind whose parameter is inside a function type is invariant at a call argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:41
-- expect: error U4001 at 19:48
module sweep_variance_sink_argument

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

take_0(w: Sink[secret Int]) -> Int = 0

pub arg_0(v: Sink[Int]) -> Int = take_0(v)

take_1(w: Sink[Int]) -> Int = 0

pub arg_1(v: Sink[secret Int]) -> Int = take_1(v)

take_2(w: Sink[secret Int]) -> Int = 0

pub arg_2(v: Sink[secret Int]) -> Int = take_2(v)
