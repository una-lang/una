-- test: a kind whose parameter is inside a function type is invariant at an annotated `let` (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:29
-- expect: error U4001 at 20:22
module sweep_variance_sink_let

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub let_0(v: Sink[Int]) -> Int
=
  let w: Sink[secret Int] = v
  0

pub let_1(v: Sink[secret Int]) -> Int
=
  let w: Sink[Int] = v
  0

pub let_2(v: Sink[secret Int]) -> Int
=
  let w: Sink[secret Int] = v
  0
