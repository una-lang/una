-- test: an if and a when branch join fed by a function value parameter checks every flow (uses, label, fails); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/10 §2
-- expect: error U4001 at 33:218
-- expect: error U4001 at 40:10
-- expect: error U3003 at 51:218
-- expect: error U3006 at 51:228
-- expect: error U3006 at 56:19
-- expect: error U3003 at 58:10
-- expect: error U3009 at 69:218
-- expect: error U3006 at 69:228
-- expect: error U3006 at 74:19
-- expect: error U3009 at 76:10
module sweep_flow_join_fnvalue

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub zero(x: Int) -> Int = 0

pub take_l(v: Int) -> Int = 0

pub take_e(v: fn(Int) -> Int) -> Int = 0

pub l_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], c: Bool) -> Int = take_l(if c then t(1) else 0)

pub lw_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], o: Option[Int]) -> Int
=
  let y = when o
    is Some(v) -> t(1)
    is None -> 0
  take_l(y)

pub l_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], c: Bool) -> Int = take_l(if c then g(1) else 0)

pub lw_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], o: Option[Int]) -> Int
=
  let y = when o
    is Some(v) -> g(1)
    is None -> 0
  take_l(y)

pub e_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], c: Bool) -> Int = take_e(if c then q else zero)

pub ew_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], o: Option[Int]) -> Int
=
  let y = when o
    is Some(v) -> q
    is None -> zero
  take_e(y)

pub e_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], c: Bool) -> Int = take_e(if c then g else zero)

pub ew_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], o: Option[Int]) -> Int
=
  let y = when o
    is Some(v) -> g
    is None -> zero
  take_e(y)

pub x_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], c: Bool) -> Int = take_e(if c then z else zero)

pub xw_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int, w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom, q: fn(Int) -> Int uses @c: Console[print], o: Option[Int]) -> Int
=
  let y = when o
    is Some(v) -> z
    is None -> zero
  take_e(y)
