-- test: ADR 0067 adversarial check of #231, L54_param_pos_kindfield: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l54.una:12:34
module l54

kind Card
  pin: secret Int
  tag: Int

pick[U](x: U, y: U, p: U, q: U) -> U = if x == y then p else q

pub leak(s: secret Int) -> Int = pick(Card(pin: s, tag: 0), y: Card(pin: 1234, tag: 0), p: Card(pin: 0, tag: 1), q: Card(pin: 0, tag: 2)).tag
