-- test: a request task with no recursion whose depth is the longest chain its code shows, four calls here, could end alone past a `--task-depth` an operator lowers below it, so which chain runs must not depend on data above `internal`; that choice is a branch, a check point that `secret` data decide in a program that starts tasks, so it is refused (U4002, spec/27 §8 rule 5) and no run with a lowered `--task-depth` can turn it into a `500` that tells the data (spec/31 §1, #1681)
-- spec: spec/31 §1
-- expect: error U4002 at src/srv.una:20:5
module srv

import std.host (Exchange, HttpServer, Reply)

one(n: secret Int) -> secret Int = n + 1

two(n: secret Int) -> secret Int = one(n) + 1

three(n: secret Int) -> secret Int = two(n) + 1

four(n: secret Int) -> secret Int = three(n) + 1

answer(exchange: internal Exchange, key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  let d = if key > 0
    four(key)
  else
    key
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all(key: secret Int) -> Unit
  uses @server: HttpServer[next, reply, close]
  diverges
=
  tasks at most 1000 at once
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange, key: key)
        is Err(failure) -> unit
    on stop
      @server.close()
