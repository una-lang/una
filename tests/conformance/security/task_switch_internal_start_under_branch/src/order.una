-- test: the twin of `task_switch_start_under_branch` with `internal` data: a `start` under a branch on an `internal` bit, whose task is held (spec/27 §7 rule 4) and whose started call is `uncounted` (§8 rule 5, #1708), so the prints keep their order; accepted, and the report lists the started call as a `task switch` at `internal` (spec/13 §6), since a held task can still be let go at a park of its own
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "1"
-- expect: run-output "2"
-- expect: run-output "3"
-- expect: run-output "4"
-- expect: run-output "5"
-- expect: run-output "6"
-- expect: run-output "7"
module order

noop() -> Unit = unit

bit(k: Int, key: internal Int) -> internal Int
=
  let edit x: internal Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

spin() -> Unit
=
  for i in 0..<3000
    noop()

printer(k: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: internal Int = 90
  tasks
    for k in 0..<8
      if bit(k, key: key) == 1
        start spin()
      start printer(k)
