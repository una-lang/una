-- test: a record kind with a secret field: an `if` or `when` on a comparison of it raises the program counter (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 24:33
-- expect: error U4003 at 30:5
-- expect: error U4003 at 32:5
-- expect: error U4003 at 38:16
-- expect: error U4003 at 39:17
module sweep_label_record_cond

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Acct) -> secret Int = x.pin

pub chosen(x: Acct) -> Int = if x == Acct(id: 1, pin: 2) then 1 else 0

pub printed(x: Acct) -> Unit
  uses @console: Console[print]
=
  if x == Acct(id: 1, pin: 2)
    @console.print("hit")
  else
    @console.print("miss")

pub matched(x: Acct) -> Unit
  uses @console: Console[print]
=
  when x == Acct(id: 1, pin: 2)
    is true -> @console.print("hit")
    is false -> @console.print("miss")

pub chosen_twin(x: Acct) -> secret Int = if x == Acct(id: 1, pin: 2) then 1 else 0

pub printed_twin(x: Acct) -> Unit
  uses @console: Console[print]
=
  if x.id == 1
    @console.print("hit")
  else
    @console.print("miss")

pub matched_twin(x: Acct) -> Unit
  uses @console: Console[print]
=
  when x.id == 1
    is true -> @console.print("hit")
    is false -> @console.print("miss")
