-- test: an inline lambda given as an operation argument is typed against the declared parameter type, so its result flows into the declared result label even where the operation accepts more (ADR 0081, #85)
-- spec: spec/07 §7
-- expect: error U4001 at 13:19
module op_argument_inline_lambda

capability Probe
  op grab(w: fn() -> Int) -> Int
    accepts secret

pub inline(pin: secret Int) -> Int
  uses @p: Probe[grab]
=
  @p.grab(fn() -> pin)
