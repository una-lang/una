-- test: the label of a reading of `Clock.now` applies whatever handler serves it (ADR 0116 amendment of 2026-11-09, C1): a handler written by the program could read the host's clock itself, so a reading served by `fixed` after work on a `secret` parameter is still `secret` (U4003)
-- spec: spec/14 §3
-- expect: error U4003 at src/leak.una:23:18
module leak

handler fixed() for Clock
  op now() = 5

work(n: secret Int) -> secret Int = n * n

pub show(n: secret Int) -> Unit
  uses @console: Console[print]
=
  timed(n) with @clock = fixed()

timed(n: secret Int) -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let start = @clock.now()
  let squared = work(n)
  let stop = @clock.now()
  @console.print("{stop - start} ms")
