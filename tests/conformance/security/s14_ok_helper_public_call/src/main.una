-- test: a helper that only writes a public path and keeps its failure could run under an `internal` condition, but every call of it is at a public program counter, so reads stay public (S-14 twin: the call sites decide, not the helper's bound)
-- spec: spec/07 §7
-- expect: ok
module main

mark() -> Unit
  uses @files: Files[write]
=
  let w = attempt @files.write("marker.txt", content: "")
  unit

pub probe() -> Bool
  uses @files: Files[read, write]
=
  mark()
  let r = attempt @files.read("marker.txt")
  is_ok(r)
