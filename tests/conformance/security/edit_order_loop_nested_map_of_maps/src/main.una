-- test: label order shape `loop-nested-map-of-maps` (#323, N-45, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:20:20
module main

-- review: rejected (U4003) once N-44 opens nested positions: a list two maps deep
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit m = empty_map()
  edit m.set(key: 0, value: empty_map().with(key: 0, value: [0]))
  for i in 0..<2
    let inner = m.get(key: i)
      if none use empty_map()
    let xs = inner.get(key: i)
      if none use []
    @console.print("{xs}")
    edit m.set(key: i + 1, value: empty_map().with(key: i + 1, value: [s.len]))
