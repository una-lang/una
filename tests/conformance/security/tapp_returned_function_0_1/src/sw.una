-- test: in edition 0.1, a function value given a value of a type parameter, or a decision on such values (#253, review of #343): leak (U4003): the function value is the result of a call
-- spec: spec/07 §7
-- expect: error U4001 at src/sw.una:16:13
-- expect: error U4003 at src/sw.una:17:14
module sw

pub capability Log
  op write(n: Int) -> Unit

pick[T](k: fn(T) -> Int) -> fn(T) -> Int = k

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let f = pick(k)
  let n = f(if a == b then p else q)
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
