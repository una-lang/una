-- test: a branch of `first of` that calls `map` with a lambda written at the call gives `t` the label of what the lambda captures (ADR 0117 IF3, ADR 0116 IF5 item 4): with `public` captures, a `public` print in a sibling is accepted; with a `secret` capture it is U4003, and so it is with a function value whose code is not known at the call
-- spec: spec/27 §6
-- expect: error U4003 at src/floor.una:17:5
-- expect: error U4003 at src/floor.una:20:5
module floor

ignore(xs: List[secret Int]) -> Unit = unit

pub floor(n: Int, key: secret Int, g: fn(Int) -> Int) -> Unit
  uses @console: Console[print]
=
  let calm = first of
    ignore([n].map(each: fn(x: Int) -> x + n))
    @console.print("a")
  let leaky = first of
    ignore([n].map(each: fn(x: Int) -> if x > key then 1 else 2))
    @console.print("b")
  let hidden = first of
    ignore([n].map(each: g))
    @console.print("c")
  unit
