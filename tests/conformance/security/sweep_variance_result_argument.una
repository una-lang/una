-- test: `Result` is covariant in both arguments at a call argument (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:55
-- expect: error U4001 at 19:55
module sweep_variance_result_argument

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

take_0(w: Result[Int, Int]) -> Int = 0

pub arg_0(v: Result[secret Int, Int]) -> Int = take_0(v)

take_1(w: Result[Int, Int]) -> Int = 0

pub arg_1(v: Result[Int, secret Int]) -> Int = take_1(v)

take_2(w: Result[secret Int, secret Int]) -> Int = 0

pub arg_2(v: Result[Int, Int]) -> Int = take_2(v)
