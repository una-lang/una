-- test: a sum kind with a secret variant field: ordering and `in` on values read from it are secret, and the kind itself cannot be ordered (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 27:33
-- expect: error U4001 at 29:32
-- expect: error U2001 at 31:38
-- expect: error U4001 at 31:38
module sweep_label_sum_order

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Guess) -> secret Int
=
  when x
    is Hit(pin) -> pin
    is Miss -> 0

pub ordered(x: Guess) -> Bool = grab(x) < 5

pub ranged(x: Guess) -> Bool = grab(x) in 0..10

pub kind_ordered(x: Guess) -> Bool = x < Hit(pin: 2)

pub ordered_twin(x: Guess) -> secret Bool = grab(x) < 5

pub ranged_twin(x: Guess) -> secret Bool = grab(x) in 0..10
