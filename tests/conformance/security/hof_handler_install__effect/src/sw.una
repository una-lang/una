-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): reject: a handler installed with a decided argument, whose operation writes it
-- spec: spec/07 §7
-- expect: error U4001 at src/sw.una:34:32
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

handler counting(n: Int) for Log
  uses @log: Log[write]
  op write(m) = @log.write(n)

inner() -> Unit
  uses @log: Log[write]
=
  @log.write(0)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  inner() with @log = counting(if a == b then 1 else 0)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
