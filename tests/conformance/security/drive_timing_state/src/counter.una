-- test: the ticks of a driven step depend on how long earlier steps took, so `input` is labeled at least the label of what the step computes on: here its `secret` state (spec/26 §2, ADR 0116 IF7)
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:10:41
module counter

import std.drive (Tick)

pub init() -> secret Int = 0

pub step(edit count: secret Int, input: Tick) -> Unit
=
  count = count + 1
