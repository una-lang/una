-- test: precise `τ_conc` (ADR 0116 P4, P5): a `within` in a handler's operation that no part of a task construct reaches has `τ_conc = public`, since nothing runs beside it, so its `public` outcome may flow to the `public` result; the preview gave every site in a handler's operation `⊤`
-- spec: spec/27 §11
-- expect: ok
module app

import std.time (millisecond)

step(n: Int) -> Int = n + 1

capability C
  op get(k: Int) -> Int

--- A `within` in a handler's operation, which no part of a task construct reaches.
handler h() for C
  op get(k) =
    let w = step(k) within 10 * millisecond
      if error use 0
    w

pub run(n: Int) -> Int
=
  let r = @c.get(n) with @c = h()
  r
