-- test: the code between two requests (ADR 0116 P11): the `public` twin of `limits_between_after_request_secret`: `mix` reads a `public` between the two requests
-- spec: spec/27 §9
-- expect: ok
module history

--- One request, whose failure it handles, and a value.
get(url: Text) -> Int
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  0

mix(a: Int, key: Int) -> Int = a + key

pub run(url: Text, key: Int) -> Unit
  uses @http: Http[get]
=
  let a = get(url)
  let b = mix(a, key)
  let c = get(url)
  unit
