-- test: ADR 0067 recheck of #231, N05b_two_params_elem: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n05b.una:11:8
-- expect: error U4001 at src/n05b.una:12:19
module n05b

pick[T, U](a: T, b: T, p: U, q: U) -> U = if a == b then p else q

pub leak(s: secret Int) -> Int
=
  when pick(s, b: 0, p: [1], q: [2]).first
    is Some(v) -> v
    is None -> 0
