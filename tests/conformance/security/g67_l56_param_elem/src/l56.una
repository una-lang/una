-- test: ADR 0067 adversarial check of #231, L56_param_elem: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l56.una:9:34
-- expect: error U4001 at src/l56.una:9:93
module l56

pick[U](x: U, y: U, p: U, q: U) -> List[U] = [if x == y then p else q]

pub leak(s: secret Int) -> Int = pick([s], y: [0], p: [], q: [s, s]).fold(initial: 0, step: fn(acc, row) -> acc + row.len)
