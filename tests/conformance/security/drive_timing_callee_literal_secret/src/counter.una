-- test: the timing label of a driven step counts every value that the code it reaches computes (spec/26 §2, ADR 0116 IF5, IF7, #1685, `docs/plan/0116-tau-item7-amendment-draft.md`): a step that calls a function making a `secret` value from its own literals needs its `input` labeled `secret`, as a step on a `secret` state does, so an unlabeled `input` is U4001
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:16:34
module counter

import std.drive (Tick)

hidden() -> Unit
=
  let k: secret Int = 3000
  let r = k + 1
  unit

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
=
  hidden()
  count = count + 1
