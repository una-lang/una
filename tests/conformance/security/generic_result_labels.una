-- test: a generic call's result carries the labels of its type arguments, so it may flow into a secret sink, stays public for public data, and a generic body may pass a value labeled with its type parameter to a restricted parameter (R-004)
-- spec: spec/07 §7
-- expect: ok
module generic_result_labels

capability Vault
  op keep(flag: Bool) -> Unit
    accepts secret

same[T](a: T, b: T) -> Bool = a == b

chosen[T](a: T, b: T) -> Int = if a == b then 1 else 0

found[T](xs: List[T], y: T) -> Bool = xs.contains(item: y)

hold(flag: restricted Bool) -> Unit = unit

weigh[T](a: T, b: T) -> Unit = hold(a == b)

pub checked_pin(pin: secret Int) -> secret Bool = same(pin, b: 1234)

pub counted(pin: secret Int) -> secret Int = chosen(pin, b: 1234)

pub listed(pins: List[secret Int]) -> secret Bool = found(pins, y: 1234)

pub public_check(x: Int) -> Bool = same(x, b: 1)

pub stored(pin: secret Int) -> Unit
  uses @vault: Vault[keep]
=
  let flag = same(pin, b: 1234)
  @vault.keep(flag)

pub weighed(pin: secret Int) -> Unit = weigh(pin, b: 1)
