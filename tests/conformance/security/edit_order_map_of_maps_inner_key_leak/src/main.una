-- test: label order shape `map-of-maps-inner-key-leak` (#323, N-45, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:17:18
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit m = empty_map()
  edit m.set(key: 0, value: empty_map().with(key: "a", value: 1))
  edit m.set(key: 1, value: empty_map().with(key: s, value: 2))
  let inner = m.get(key: 1)
    if none use empty_map()
  @console.print("{inner.len}")
