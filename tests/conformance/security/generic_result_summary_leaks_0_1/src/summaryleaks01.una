module summaryleaks01

pub kind Box[T]
  item: T
  count: Int

pub concat[T](front: List[T], back: List[T]) -> List[T] = back.fold(initial: front, step: fn(acc,
    x
  ) -> acc.append(item: x))

--- The shape depends on a comparison of `T` values: the top carries `T`.
smaller[T](a: T, b: T) -> List[T] = if a == b then [a] else [b, a]

pub leak_branch(s: secret Int) -> Int = smaller(s, b: 0).len

--- A filter over a comparison: the top carries `T` (L4).
below[T](xs: List[T], pivot: T) -> List[T] = xs.filter(keep: fn(x) -> x == pivot)

pub leak_filter(xs: List[secret Int]) -> Int = below(xs, pivot: 0).len

pub leak_first(xs: List[secret Int]) -> Bool = xs.first_where(keep: fn(x) -> x > 0).is_some()

--- Recursion: a branch on `T` values deep in the recursion still reaches the top.
matches[T](xs: List[T], x: T,
  n: Int
) -> List[Int] = if n <= 0 then (if xs.contains(item: x) then [1] else []) else concat([],
  back: matches(xs, x, n: n - 1)
)

pub leak_recursion(xs: List[secret Int]) -> Int = matches(xs, x: 1, n: 3).len

--- A returned function whose result reads a captured `T` value.
tester[T](x: T) -> fn(T) -> Bool = fn(y) -> y == x

pub leak_function(s: secret Int) -> Bool
=
  let test = tester(s)
  test(1)

--- An option whose presence depends on a `T` value.
found[T](xs: List[T], x: T) -> Option[Int] = if xs.contains(item: x) then Some(1) else None

pub leak_option(xs: List[secret Int]) -> Bool = found(xs, x: 1).is_some()

--- A kind's `Int` field computed from a `T` value.
counted[T](x: T, y: T) -> Box[T] = Box(item: x, count: if x == y then 1 else 0)

pub leak_field(s: secret Int) -> Int = counted(s, y: 0).count
