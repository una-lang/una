-- test: a function value chosen by a secret keeps its label through `filter`, `first_where`, `map` and `fold`, which declare `uses of` and `fails of` in edition 0.2: each argument and each result is U4001, as edition 0.1 reports the same program (spec/07 §7, ADR 0062, #210)
-- spec: spec/07 §7
-- expect: error U4001 at src/throughprelude.una:20:3
-- expect: error U4001 at src/throughprelude.una:20:13
-- expect: error U4001 at src/throughprelude.una:25:3
-- expect: error U4001 at src/throughprelude.una:25:18
-- expect: error U4001 at src/throughprelude.una:30:3
-- expect: error U4001 at src/throughprelude.una:30:10
-- expect: error U4001 at src/throughprelude.una:39:3
-- expect: error U4001 at src/throughprelude.una:39:23
module throughprelude

positive(x: Int) -> Bool = x > 0

negative(x: Int) -> Bool = x < 0

pub through_filter(s: secret Bool, xs: List[Int]) -> Int
=
  let keep = if s then positive else negative
  xs.filter(keep).len

pub through_first(s: secret Bool, xs: List[Int]) -> Option[Int]
=
  let keep = if s then positive else negative
  xs.first_where(keep)

pub through_map(s: secret Bool, xs: List[Int]) -> List[Bool]
=
  let each = if s then positive else negative
  xs.map(each)

add(total: Int, x: Int) -> Int = total + x

keep_total(total: Int, x: Int) -> Int = total

pub through_fold(s: secret Bool, xs: List[Int]) -> Int
=
  let step = if s then add else keep_total
  xs.fold(initial: 0, step)
