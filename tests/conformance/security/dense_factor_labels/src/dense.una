-- test: the labels of tensors and factorizations: a secret index written into a tensor of public elements is U4001; a tensor's rank and lengths take its top label, so those of a tensor of secret elements print; whether a solve finds a solution is decided by the elements, so the top of its Option is secret, U4003 at a public sink
-- spec: spec/29 §17
-- expect: error U4001 at src/dense.una:11:19
-- expect: error U4003 at src/dense.una:23:18
module dense

pub place(t: Tensor[I64], i: secret Int) -> Tensor[I64]
  requires t.rank == 2 and 0 <= i and i < t.dim(axis: 0) and t.dim(axis: 1) > 0
=
  var u = t
  edit u.set(at: [i, 0], item: 0)
  u

pub report(t: Tensor[secret F64]) -> Unit
  uses @console: Console[print]
=
  @console.print("{t.rank} {t.dim(axis: 0)}")

pub decided(m: Matrix[secret F64], b: Matrix[F64]) -> Unit
  requires m.rows == m.columns and b.rows == m.rows
  uses @console: Console[print]
=
  @console.print("{is_some(m.solve(rhs: b))}")
