-- test: the failure of `acquire` of `std.limit` is decided at `internal`, the label of `Limited`, so passing it on as the function's own failure with `if error pass` is U4002 (S-46, spec/27 §10 rule 4, spec/07 §7 rule 4)
-- spec: spec/27 §10
-- expect: error U4002 at src/gate.una:14:5
module gate

import std.limit (Limit, Limited, limiter)
import std.time (minute)

grab() -> Unit
  uses @gate: Limit[acquire]
  fails Limited
=
  @gate.acquire()
    if error pass

pub main() -> Unit
=
  let got = attempt grab() with @gate = limiter(at_most: 1, per: minute, waiting: 0)
  unit
