-- test: ADR 0067 adversarial check of #231, L26_userhof: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l26.una:10:40
module l26

twice[A](f: fn(A, A) -> Int, x: A) -> Int = f(x, x) + f(x, x)

cmp[T](a: T, b: T) -> Int = if a == b then 1 else 0

pub leak(s: secret Int) -> Int = twice(cmp, x: s)
