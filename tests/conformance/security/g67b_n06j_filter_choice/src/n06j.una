-- test: ADR 0067 recheck of #231, N06j_filter_choice: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n06j.una:8:34
module n06j

keepeq[U](xs: List[U], y: U) -> List[U] = xs.filter(keep: fn(x) -> x == y)

pub leak(s: secret Int) -> Int = keepeq([[s], [5, 5]], y: [5, 5]).len
