-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, the review matrix): reject: the callee calls an annotated lambda through if_in_if and writes it
-- spec: spec/07 §7
-- expect: error U4002 at src/sw.una:33:3
-- expect: error U4001 at src/sw.una:33:65
-- expect: error U4001 at src/sw.una:33:87
-- expect: error U4001 at src/sw.una:33:107
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

logger[U](x: U, f: fn(U) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(f(x))

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int, c: Bool) -> Unit
  uses @log: Log[write]
=
  logger(if a == b then p else q,
    f: if c then (if c then fn(x: T) -> k(x) else fn(x: T) -> 1) else fn(x: T) -> 0
  )

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len, c: true)
