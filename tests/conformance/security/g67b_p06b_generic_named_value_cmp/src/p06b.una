-- test: ADR 0067 recheck of #231, P06b_generic_named_value_cmp: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4002 at src/p06b.una:18:36
module p06b

pub capability Log
  op write(n: Int) -> Unit

pos[T: Ord](x: T) -> Bool
  uses @log: Log[write]
=
  @log.write(0)
  x > x

pub leak(xs: List[secret Int]) -> Unit
  uses @log: Log[write]
=
  let found = xs.first_where(keep: pos)
  unit
