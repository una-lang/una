-- test: effectful function chosen by an internal branch (via the generic escape), then called; runtime prints yes/no by PIN (R-006)
-- spec: spec/10 §5
-- expect: error U4002 at 24:3
-- expect: error U3016 at 32:36
-- expect: error U3016 at 32:53
-- expect: error U4002 at 33:3
module secret_fn_value_effect

id[T](x: T) -> T = x

say_yes(line: Text) -> Unit
  uses @console: Console[print]
=
  @console.print("yes")

say_no(line: Text) -> Unit
  uses @console: Console[print]
=
  @console.print("no")

pub call(f: secret fn(Text) -> Unit uses @console: Console[print]) -> Unit
  uses @console: Console[print]
=
  f("x")

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  let f = if pin == "1234" then id(say_yes) else id(say_no)
  f("x")
