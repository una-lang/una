-- test: ADR 0067 adversarial check of #231, L15_fnresult: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l15.una:6:51
module l15

maker[T](a: T, b: T) -> fn(Int) -> Int = fn(x) -> if a == b then x else 0

pub leak(s: secret Int) -> Int
=
  let g = maker(s, b: 0)
  g(1)
