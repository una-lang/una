trusted module release

import std.time (millisecond)

pub policy key_of
  from internal Int
  to Int
  via reveal_it
  purpose "a test"
  owner privacy

--- The `via` function: a lambda written here runs `timed`, whose result becomes its result.
reveal_it(t: internal Int) -> Int = first_of([t].map(each: fn(x: internal Int) -> timed(x)))

first_of(xs: List[restricted Int]) -> restricted Int = xs.fold(initial: 0,
  step: fn(a: restricted Int, b: restricted Int) -> b
)

--- Checked with labels: its `restricted` result may hold the outcome of its `within`.
timed(t: internal Int) -> restricted Int
=
  let v: restricted Int = t within 1 * millisecond
    if error use 0
  v
