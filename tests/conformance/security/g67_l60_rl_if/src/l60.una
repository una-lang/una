-- test: ADR 0067 adversarial check of #231, L60_rl_if: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l60.una:14:34
module l60

cmp[T](a: T, b: T) -> Int
=
  let r = if a == b
    1
  else
    0
  r

pub leak(s: secret Int) -> Int = cmp(s, b: 0)
