-- test: `requires`, `ensures` and `where` clauses are not checked for labels: they may read secret parameters and results, and a public result keeps its label
-- spec: spec/07 §7
-- expect: ok
module clauses_not_label_checked

kind Pin = Int where it >= 0

pub positive(pin: secret Int) -> Int
  requires pin > 0
  ensures result == 1
=
  1

pub same(pin: secret Pin) -> secret Pin
  ensures result == pin
=
  pin

pub caller() -> Int = positive(1234)
