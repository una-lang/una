-- test: a via parameter refined where the policy's from type is not is U4005, since the policy call checks only from
-- spec: spec/07 §5, §7
-- expect: error U4005 at src/release.una:8:7
module app

import release (Pos, lower)

recip(p: Pos) -> Int = 100 / p

pub main() -> Unit
  uses @console: Console[print]
=
  let p = lower(0)
  let q = recip(p)
  @console.print("q = {q}")
