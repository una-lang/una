module media.render

import media.log (Log, Net)

handler vmute() for Net
  op post(n) = n

pub process_f(n: Int, f: fn(Int) -> Int uses @net: Net[post]) -> Int
=
  f(n) with @net = vmute()

pub plain_f(n: Int, f: fn(Int) -> Int) -> Int = f(n)

pub show(n: Int) -> Int
  uses @log: Log[write]
=
  @log.write(n)
