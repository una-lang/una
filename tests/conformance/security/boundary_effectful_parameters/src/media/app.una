-- test: a function value from a parameter, whose type has `uses`, runs on bindings captured where it was made, which the check does not follow: given to a boundary, or to a handler installed for a call into one, it is U3021 at that call even when the boundary or the handler calls it under a binding of its own; so is a handler's own parameter that its operation gives to a boundary; a parameter whose type has no `uses` is accepted when no policy is declared (ADR 0093 rules 5 and 14)
-- spec: spec/05 §4
-- expect: error U3021 at src/media/app.una:18:64
-- expect: error U3021 at src/media/app.una:22:3
-- expect: error U3021 at src/media/app.una:39:17
module media.app

import media.log (Log, Net)
import media.render (plain_f, process_f, show)

handler mute() for Net
  op post(n) = n

handler relay(cb: fn(Int) -> Int uses @net: Net[post]) for Log
  op write(n) =
    cb(n) with @net = mute()

wrap(n: Int, cb: fn(Int) -> Int uses @net: Net[post]) -> Int = process_f(n, f: cb)

wrap_relay(n: Int, cb: fn(Int) -> Int uses @net: Net[post]) -> Int
=
  show(n) with @log = relay(cb: cb)

pub wrap_pure(n: Int, cb: fn(Int) -> Int) -> Int = plain_f(n, f: cb)

pub direct(n: Int) -> Int
  uses @net: Net[post]
=
  wrap(n, cb: fn(m) -> @net.post(m))

pub relayed(n: Int) -> Int
  uses @net: Net[post]
=
  wrap_relay(n, cb: fn(m) -> @net.post(m))

pub pure(n: Int) -> Int = wrap_pure(n, cb: fn(m) -> m)

handler pass_on(cb: fn(Int) -> Int uses @net: Net[post]) for Log
  op write(n) = process_f(n, f: cb)
