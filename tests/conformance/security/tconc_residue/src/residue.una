-- test: the residue of a cancelled request (ADR 0116 P9): a started task works on a `secret` before its request, so whether that request had left when its `tasks` statement cancelled it, and holds a helper beside later code, depends on the `secret`; `L_res` is `secret`, and the deadline of a later request in a function no task reaches carries it, above the `internal` that the failure of `Http.get` carries: U4001 at the `within`, and the request, which accepts `internal` data, runs under the timing floor (U4003)
-- spec: spec/27 §5
-- expect: error U4001 at src/residue.una:31:15
-- expect: error U4003 at src/residue.una:31:23
module residue

import std.time (millisecond)

crunch(key: secret Int) -> secret Int = key * 3

--- Work on `key`, then a request, in a started task.
churn(key: secret Int, url: Text) -> Unit
  uses @http: Http[get]
=
  let spent = crunch(key)
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

--- Starts `churn`, whose request a cancellation of the task can leave on a helper.
pub serve(key: secret Int, url: Text) -> Unit
  uses @http: Http[get]
=
  tasks
    start churn(key, url)
  unit

--- A later request under a deadline, in a function no task reaches.
pub poll(url: Text) -> Unit
  uses @http: Http[get]
=
  let reply = attempt @http.get(url, headers: [], key_name: None) within 100 * millisecond
  unit
