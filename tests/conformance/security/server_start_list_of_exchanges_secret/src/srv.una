-- test: a `start` that captures a `List[Exchange]` under a `secret` program counter moves reply rights, so it is U4003 (spec/31 §1, ADR 0123 IF6)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:15:9
module srv

import std.host (Exchange)

idle(exchanges: internal List[Exchange]) -> Unit = unit

serve_all(batches: internal List[List[Exchange]], key: secret Int) -> Unit
=
  tasks
    for batch in batches
      if key > 0
        start idle(batch)
      else
        unit
