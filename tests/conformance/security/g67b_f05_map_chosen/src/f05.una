-- test: ADR 0067 recheck of #231, F05_map_chosen: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/f05.una:6:102
module f05

apply[T](a: T, b: T, p: T, q: T,
  k: fn(T) -> Int
) -> List[Int] = [if a == b then p else q].map(each: k)

pub leak(s: secret Int) -> Int = apply([s], b: [0], p: [], q: [1, 2],
  k: fn(xs: List[secret Int]) -> xs.len
).sum
