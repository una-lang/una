-- test: a value chosen by whether `acquire` of `std.limit` failed carries `internal`, the label of `Limited`, so returning it as `public` is U4001 at the condition (S-46, spec/27 §10 rule 4, spec/07 §7 rule 2)
-- spec: spec/27 §10
-- expect: error U4001 at src/gate.una:13:8
module gate

import std.limit (Limit, limiter)
import std.time (minute)

state() -> Text
  uses @gate: Limit[acquire]
=
  let got = attempt @gate.acquire()
  when got
    is Ok(v) -> "token"
    is Err(e) -> "none"

pub main() -> Unit
  uses @console: Console[print]
=
  let shown = state() with @gate = limiter(at_most: 1, per: minute, waiting: 0)
  @console.print(shown)
