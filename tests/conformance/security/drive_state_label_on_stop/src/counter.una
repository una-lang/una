-- test: the host hands the state that `step` leaves to `on_stop`, so the label of `step`'s state parameter flows into that of `on_stop`'s: a state that `step` keeps `secret`, from a `public` start, given to an unlabeled parameter is U4001 (spec/26 §2)
-- spec: spec/26 §2
-- expect: error U4001 at src/counter.una:14:20
module counter

import std.drive (Tick)

pub init() -> Int = 0

pub step(edit count: secret Int, input: secret Tick) -> Unit
=
  count = count + 1

pub on_stop(count: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{count}")
