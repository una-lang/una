-- test: ADR 0067 adversarial check of #231, L33j_fw_console: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4002 at src/l33j.una:17:61
module l33j

pin() -> secret Int = 4

probe(x: Int) -> secret Bool
  uses @console: Console[print]
=
  @console.print("probe {x}")
  x == pin()

pub main() -> Unit
  uses @console: Console[print]
=
  let found = [1, 2, 3, 4, 5, 6, 7, 8, 9].first_where(keep: probe)
  unit
