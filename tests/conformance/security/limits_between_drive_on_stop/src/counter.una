-- test: the driver's gaps (ADR 0116 P11): `Pre(on_stop)` lies after the last step's requests, and `on_stop` works on a `secret` before its request: U4001 at the request in `on_stop`
-- spec: spec/27 §9
-- expect: error U4001 at src/counter.una:21:25
module counter

import std.drive (Tick)

pub init() -> Int = 0

pub step(edit count: Int, input: internal Tick) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get("https://api.example.com/tick", headers: [], key_name: None)
  unit

pub on_stop(count: Int) -> Unit
  uses @http: Http[get]
=
  let key: secret Int = 7
  let spent = key * 3
  let outcome = attempt @http.get("https://api.example.com/stop", headers: [], key_name: None)
  unit
