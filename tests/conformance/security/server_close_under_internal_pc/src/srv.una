-- test: `close` accepts `public` only, so a server cannot close itself on the strength of a request's content: under an `internal` program counter it is U4003 (spec/31 §1, ADR 0123 IF1)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:12:5
module srv

import std.host (HttpServer, Request)

closing(request: internal Request) -> Unit
  uses @server: HttpServer[close]
=
  if request.body == "stop"
    @server.close()
  else
    unit
