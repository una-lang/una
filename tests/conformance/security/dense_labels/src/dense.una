-- test: a dense value's shape takes its top label and its elements their element label: a secret index written into a public array is U4001, the rows of a matrix of secret elements are public, and its sum is secret, U4003 at a public sink
-- spec: spec/29 §17
-- expect: error U4001 at src/dense.una:10:21
-- expect: error U4003 at src/dense.una:17:18
module dense

pub place(a: Array[Int], i: secret Int) -> Array[Int]
=
  var b = a
  edit b.set(index: i, item: 0)
  b

pub report(m: Matrix[secret F64]) -> Unit
  uses @console: Console[print]
=
  @console.print("{m.rows} rows")
  @console.print("{m.sum()}")

pub read(m: Matrix[F64], i: secret Int) -> secret F64
  requires 0 <= i and i < m.rows and m.columns > 0
=
  m.get(row: i, column: 0)
