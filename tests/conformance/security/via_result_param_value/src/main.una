-- test: a `via` whose parameter, the policy's `from` value, holds a function value can call one made outside the code it reaches (#1710): `key_of` takes a `Box` whose field `f` is `spin`, named by the caller, so every lambda and every function named as a value counts as reached, and `spin`'s `within`, beside the tasks of `pair`, is refused (U4001 at the `within`, spec/07 §5 rule 7); its twin `via_result_param_value_alone` has no task beside it
-- spec: spec/07 §5
-- expect: error U4001 at src/main.una:11:27
module main

import release (Box, key_of)
import std.time (millisecond)

spin(x: internal Int) -> internal Int
=
  let v: restricted Int = 1 within 1 * millisecond
    if error use 0
  x

pub once(n: internal Int) -> Int = key_of(Box(f: spin, n: n))

pub pair(a: Int, b: Int) -> Int
=
  together
    let x = a + 1
    let y = b + 1
  x + y
