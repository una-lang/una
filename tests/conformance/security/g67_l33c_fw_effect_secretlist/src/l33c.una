-- test: ADR 0067 adversarial check of #231, L33c_fw_effect_secretlist: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4002 at src/l33c.una:18:36
module l33c

pub capability Log
  op write(n: Int) -> Unit

noisy(x: secret Int) -> secret Bool
  uses @log: Log[write]
=
  @log.write(0)
  x > 0

pub leak(xs: List[secret Int]) -> Unit
  uses @log: Log[write]
=
  let found = xs.first_where(keep: noisy)
  unit
