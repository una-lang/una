-- test: label order shape `loop-generic-init` (#323, N-45, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:17:20
module main

same[T](xs: List[T]) -> List[T] = xs

-- review: rejected (U4003): initialized from a generic call's result with an open element
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = same([])
  for i in 0..<2
    @console.print("{xs}")
    xs = xs.append(item: s.len)
