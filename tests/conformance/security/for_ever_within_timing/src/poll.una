-- test: the failures that the deadline of a `for ever within` causes carry the timing label of its body (ADR 0116 IF5, IF8): a body that reads a `secret` binding, or calls an operation that a handler installed with a `secret` argument can serve, makes `Http`'s `internal` failure too low (U4001 at the loop); a body on `public` data is accepted, as is a plain `for ever` on a `secret` binding, and a `together` on `secret` data that ends before the loop starts, which no task runs beside (IF6)
-- spec: spec/26 §6
-- expect: error U4001 at src/poll.una:19:3
-- expect: error U4001 at src/poll.una:30:3
module poll

import std.time (millisecond)

capability Store
  op get(key: Text) -> Int

handler hidden(seed: secret Int) for Store
  op get(key) = 0

pub secretly(key: secret Int, url: Text) -> Unit
  uses @http: Http[get]
  diverges
=
  for ever within 100 * millisecond
    let doubled = key * 2
    let reading = attempt @http.get(url, headers: [], key_name: None)
    stop
  unit

pub stored(url: Text) -> Unit
  uses @store: Store[get]
  uses @http: Http[get]
  diverges
=
  for ever within 100 * millisecond
    let value = @store.get("k")
    let reading = attempt @http.get(url, headers: [], key_name: None)
    stop
  unit

pub openly(count: Int, url: Text) -> Unit
  uses @http: Http[get]
  diverges
=
  for ever within 100 * millisecond
    let doubled = count * 2
    let reading = attempt @http.get(url, headers: [], key_name: None)
    stop
  unit

pub plainly(key: secret Int, url: Text) -> Unit
  uses @http: Http[get]
  diverges
=
  for ever
    let doubled = key * 2
    let reading = attempt @http.get(url, headers: [], key_name: None)
    stop
  unit

crunch(key: secret Int) -> secret Int = key * 3

pub started(key: secret Int, url: Text) -> Unit
  uses @http: Http[get]
  diverges
=
  together
    let a = crunch(key)
    let b = crunch(key + 1)
  openly(1, url)
