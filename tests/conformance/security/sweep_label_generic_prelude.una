-- test: a generic kind instantiated with a secret type: prelude results carry the field labels of their element and argument types (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 34:53
-- expect: error U4001 at 36:50
-- expect: error U4001 at 38:47
-- expect: error U4001 at 40:56
-- expect: error U4001 at 42:50
-- expect: error U4001 at 44:53
-- expect: error U4001 at 46:48
-- expect: error U4001 at 48:53
-- expect: error U4001 at 50:56
-- expect: error U4001 at 52:50
-- expect: error U4001 at 54:64
-- expect: error U4001 at 56:53
-- expect: error U4001 at 58:40
-- expect: error U4001 at 60:40
-- expect: error U4001 at 62:40
module sweep_label_generic_prelude

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Box[secret Int]) -> secret Int = x.value

pub p_contains(xs: List[Box[secret Int]]) -> Bool = xs.contains(item: Box(value: 2))

pub p_first(xs: List[Box[secret Int]]) -> Bool = xs.first() is Some

pub p_at(xs: List[Box[secret Int]]) -> Bool = xs.at(index: 0) is Some

pub p_first_where(xs: List[Box[secret Int]]) -> Bool = xs.first_where(keep: fn(y) -> true) is Some

pub p_filter(xs: List[Box[secret Int]]) -> Int = xs.filter(keep: fn(y) -> true).len

pub p_map(xs: List[Box[secret Int]]) -> List[Int] = xs.map(each: fn(y) -> 1)

pub p_fold(xs: List[Box[secret Int]]) -> Int = xs.fold(initial: 0, step: fn(n, y) -> n + 1)

pub p_is_some(o: Option[Box[secret Int]]) -> Bool = o.is_some()

pub p_is_ok(r: Result[Box[secret Int], Int]) -> Bool = r.is_ok()

pub p_append(xs: List[Box[secret Int]]) -> Int = xs.append(item: Box(value: 2)).len

pub p_or_else(o: Option[Box[secret Int]]) -> Box[secret Int] = o.or_else(default: Box(value: 2))

pub p_is_empty(xs: List[Box[secret Int]]) -> Bool = xs.is_empty()

pub p_sum(x: Box[secret Int]) -> Int = [grab(x)].sum()

pub p_min(x: Box[secret Int]) -> Int = min(grab(x), b: 0)

pub p_max(x: Box[secret Int]) -> Int = max(grab(x), b: 0)

pub p_len_twin(xs: List[Box[secret Int]]) -> Int = xs.len
