-- test: a kind whose parameter is inside a function type is invariant at a list element (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:16
-- expect: error U4001 at 20:16
module sweep_variance_sink_element

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub elem_0(v: Sink[Int], w: Sink[secret Int]) -> List[Sink[secret Int]]
=
  let ws = [w, v]
  ws

pub elem_1(v: Sink[secret Int], w: Sink[Int]) -> List[Sink[Int]]
=
  let ws = [w, v]
  ws

pub elem_2(v: Sink[secret Int], w: Sink[secret Int]) -> List[Sink[secret Int]]
=
  let ws = [w, v]
  ws
