-- test: a request written directly in a lambda reaches `Http` for the residue label (ADR 0116 P1, P9): the lambda, written outside the `tasks` statement, is passed to `run_with`, an effect-polymorphic started function that calls it, so the statement's tasks can leave its request on a helper; every lambda is one node of the call graph, whose edges include the operations its bodies perform, so `L_res` is the statement's label, `⊤` from the call of a function value, and the outcome of a later `within` over pure work, in a function no task reaches, is above the `internal` binding (U4001)
-- spec: spec/26 §7
-- expect: error U4001 at src/residue.una:30:25
module residue

import std.time (millisecond)

drop_reply[T](reply: T) -> Unit = unit

--- Calls its function value, whose effects are its own.
run_with(go: fn(Text) -> Unit, url: Text) -> Unit
  uses of go
=
  go(url)

--- Starts `run_with` with a lambda that makes a request.
pub serve(url: Text) -> Unit
  uses @http: Http[get]
=
  let fetch = fn(u: Text) -> drop_reply(attempt @http.get(u, headers: [], key_name: None))
  tasks
    start run_with(fetch, url)
  unit

step(n: Int) -> Int = n + 1

--- Pure work under a deadline, in a function no task reaches.
pub measured(n: Int) -> internal Int
=
  let v: internal Int = step(n) within 10 * millisecond
    if error use 0
  v
