-- test: the new value of an `edit` argument or receiver flows back into its place with the labels its parameter's type has once every argument is typed, so a secret argument given after the place raises it: through a generic callee in either parameter order, prelude `set` as a call and as a method, a field place, a `List[U8]`, and a user generic over a list (spec/17 §6 rule 2, #186)
-- spec: spec/17 §6
-- expect: error U4001 at src/edit_flow.una:34:16
-- expect: error U4001 at src/edit_flow.una:40:28
-- expect: error U4001 at src/edit_flow.una:46:12
-- expect: error U4001 at src/edit_flow.una:52:8
-- expect: error U4001 at src/edit_flow.una:58:8
-- expect: error U4001 at src/edit_flow.una:64:12
-- expect: error U4001 at src/edit_flow.una:70:12
-- expect: error U4001 at src/edit_flow.una:77:16
module edit_flow

pub kind Holder
  items: List[Int]

pub capability Log
  op write(line: Text) -> Unit

replace[T](edit x: T, item: T) -> Unit
=
  x = item

replace_first[T](item: T, edit x: T) -> Unit
=
  x = item

put[T](edit xs: List[T], item: T) -> Unit
=
  set(edit xs, index: 0, item: item)

pub place_first(v: secret Int) -> Int
=
  let edit x = 0
  replace(edit x, item: v)
  x

pub place_last(v: secret Int) -> Int
=
  let edit x = 0
  replace_first(v, x: edit x)
  x

pub prelude_set(v: secret Int) -> List[Int]
=
  let edit xs = [0]
  set(edit xs, index: 0, item: v)
  xs

pub prelude_set_method(v: secret Int) -> List[Int]
=
  let edit xs = [0]
  edit xs.set(index: 0, item: v)
  xs

pub field_place(v: secret Int) -> Holder
=
  let edit t = Holder(items: [0])
  edit t.items.set(index: 0, item: v)
  t

pub fixed_width(v: secret U8) -> List[U8]
=
  let edit xs: List[U8] = [0]
  set(edit xs, index: 0, item: v)
  xs

pub user_generic_list(v: secret Int) -> List[Int]
=
  let edit xs = [0]
  put(edit xs, item: v)
  xs

pub printed(v: secret Int) -> Unit
  uses @log: Log[write]
=
  let edit x = 0
  replace(edit x, item: v)
  @log.write("{x}")

pub public_value(v: Int) -> Int
=
  let edit x = 0
  replace(edit x, item: v)
  x
