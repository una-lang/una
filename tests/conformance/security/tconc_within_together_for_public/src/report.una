-- test: the twin of `tconc_within_together_for`: the tasks work on `public` data, and the print is accepted
-- spec: spec/27 §11
-- expect: ok
module report

import std.time (millisecond)

crunch_open(n: Int) -> Int = n * 3

--- Work on `public` data, which a started task runs.
churn_open(n: Int) -> Unit
=
  let spent = crunch_open(n)
  unit

step(n: Int) -> Int = n + 1

--- Prints whether `step(n)` met its deadline: the value carries the deadline's timing label.
report(n: Int) -> Unit
  uses @console: Console[print]
=
  let v = step(n) within 10 * millisecond
    if error use 0
  @console.print("{v}")

--- Each task of the body calls `churn_open(x)` and `report(x)`.
pub serve(m: Int, xs: List[Int]) -> List[Unit]
  uses @console: Console[print]
=
  together for x in xs
    let spent = churn_open(x)
    report(x)
