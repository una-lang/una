-- test: precise `τ_conc` through `K(c)` (ADR 0116 P1): a branch performs an operation that the handler `h`, installed outside the `together`, serves, beside a branch that works on a `secret`, so the `within` in `h`'s operation runs beside it and passing its `TimedOut` on is U4002
-- spec: spec/27 §11
-- expect: error U4002 at src/plan.una:20:7
module plan

import std.time (millisecond)

pub kind PlanError = | TimedOut

step(n: Int) -> Int = n + 1

capability C
  op get(k: Int) -> Int
    fails PlanError

--- A handler whose operation passes on the `TimedOut` of a deadline over `public` work.
handler h() for C
  op get(k) =
    let v = step(k) within 10 * millisecond
      if error pass
    v

crunch(key: secret Int) -> secret Int = key * 3

--- A branch performs `@c.get`, which `h` serves, beside a branch that works on `key`.
both(key: secret Int, n: Int) -> secret Int
  uses @c: C[get]
=
  together
    let a = crunch(key)
    let b = @c.get(n)
      if error use 0
  a

pub run(key: secret Int, n: Int) -> secret Int
=
  both(key, n) with @c = h()
