-- test: ADR 0067 adversarial check of #231, L55_param_pos_print: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4003 at src/l55.una:14:18
module l55

pick[U](x: U, y: U, p: U, q: U) -> U = if x == y then p else q

pin() -> secret Int = 1234

pub main() -> Unit
  uses @console: Console[print]
=
  let guess = pick([pin()], y: [1234], p: [pin()], q: [pin(), pin()])
  @console.print("{guess.len}")
