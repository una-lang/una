-- test: a Keys handler installed only by an example's given line leaves the hmac-only via public (ADR 0098)
-- spec: spec/07 §5
-- expect: ok
module main

import release (key_of)
import std.testing (fake_hash)

pub passes(t: secret Text) -> Unit
  uses @keys: Keys[hmac]
  fails KeyError
=
  let k = key_of(t)
    if error pass
  unit

handler fake_keys() for Keys
  op hmac(key_name, data) = fake_hash(1)

example "a fake key hashes"
  given @keys = fake_keys()
  do passes("x")
  expect result == unit
