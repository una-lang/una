-- test: a kind whose field is a function type: equality on a kind with a function field is rejected by construction, and equality on its result is secret (label sweep)
-- spec: spec/07 §7
-- expect: error U2001 at 16:37
-- expect: error U4001 at 18:31
-- expect: error U4001 at 20:44
module sweep_label_fnfield_eq

kind Src
  get: fn() -> secret Int

kind Feed[T]
  get: fn() -> T

make(pin: secret Int) -> Src = Src(get: fn() -> pin)

pub kinds(s: Src, t: Src) -> Bool = s == t

pub results(s: Src) -> Bool = s.get() == 1

pub generic(f: Feed[secret Int]) -> Bool = f.get() != 1

pub results_twin(s: Src) -> secret Bool = s.get() == 1

pub generic_twin(f: Feed[secret Int]) -> secret Bool = f.get() != 1
