-- test: the root task takes turns with its started tasks and counts its turn from the start of the run, so `secret`-decided calls in `main` before the `tasks` statement decided whether the root printed before its task; the call is U4002 in the root too (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:19:7
module order

noop() -> Unit = unit

worker(k: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 165
  for i in 0..<600
    if key > 100
      noop()
  tasks
    start worker(1)
    @console.print("root")
