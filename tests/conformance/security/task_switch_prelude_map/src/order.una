-- test: `map` applies its function once per element, each a check point, so a `map` over a list whose length is `secret` passes a `secret` number of them: U4002 at the call in a program that starts tasks (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- expect: error U4002 at src/order.una:18:14
module order

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let xs: secret List[Int] = if bit(k, key: key) == 1 then [1, 2, 3, 4, 5, 6, 7, 8] else []
  for i in 0..<300
    let ys = xs.map(each: fn(x: Int) -> x + 1)
    unit
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
