-- test: in edition 0.5, the members and the size of a bit set are its shape: a `secret` item added to a bit set with a `public` top label is U4001 at the item, with a control; `has` with a `secret` item carries its label to `Console`; and a bit set made with a `secret` size has a `secret` top label, so its `len` reaches `Console` labeled `secret` (ADR 0119 IF2)
-- spec: spec/28 §9
-- expect: error U4001 at src/channels.una:14:20
-- expect: error U4003 at src/channels.una:28:18
-- expect: error U4003 at src/channels.una:35:18
module channels

import std.collections (BitSet, empty_bit_set)

--- A secret item into an editable bit set with a public top label.
pub into_public(x: secret Int) -> Unit
=
  var b: BitSet = empty_bit_set(size: 64)
  edit b.add(item: x)
  unit

--- The control: the bit set is declared with a secret top label.
pub into_secret(x: secret Int) -> Unit
=
  var b: secret BitSet = empty_bit_set(size: 64)
  edit b.add(item: x)
  unit

--- Looking a secret item up, and printing the answer.
pub presence(b: BitSet, x: secret Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{b.has(item: x)}")

--- A bit set whose size is secret, and printing how many members it has.
pub sized(n: secret Int) -> Unit
  uses @console: Console[print]
=
  const b = empty_bit_set(size: n)
  @console.print("{b.len}")
