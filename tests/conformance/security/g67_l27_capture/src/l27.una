-- test: ADR 0067 adversarial check of #231, L27_capture: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l27.una:6:53
module l27

closer[T](a: T, b: T) -> fn(Int) -> Bool = fn(n) -> a == b

pub leak(s: secret Int) -> Bool = closer(s, b: 0)(1)
