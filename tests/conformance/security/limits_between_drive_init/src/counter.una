-- test: the driver's gaps (ADR 0116 P11): `Suf(init) ⊔ Pre(step)` lies between the requests of `init` and those of the first step, and `init` works on a `secret` after its request: U4001 at the request in `init`
-- spec: spec/27 §9
-- expect: error U4001 at src/counter.una:11:25
module counter

import std.drive (Tick)

pub init() -> Int
  uses @http: Http[get]
=
  let outcome = attempt @http.get("https://api.example.com/start", headers: [], key_name: None)
  let key: secret Int = 7
  let spent = key * 3
  0

pub step(edit count: Int, input: internal Tick) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get("https://api.example.com/tick", headers: [], key_name: None)
  unit
