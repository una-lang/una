-- test: the hunt's probe (#973 T1): a started task whose pure loop runs as many iterations as a `secret` bit decides, then prints; the interpreter switches tasks after 1024 check points, so the order of the prints spelled the key, one bit per task, and #1684 refused the loop. Its iterations are now `uncounted` (spec/27 §8 rule 5, ADR 0117 amendment of 2026-11-22, second, #1708): such a loop ends and pushes no frame, so the program is accepted and the prints are `0` to `7` in order, for every key, as `una run` and native code under `--virtual-time` show alike (`crates/una-cli/tests/native.rs`)
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "1"
-- expect: run-output "2"
-- expect: run-output "3"
-- expect: run-output "4"
-- expect: run-output "5"
-- expect: run-output "6"
-- expect: run-output "7"
module order

spin(n: secret Int) -> secret Int
=
  let edit acc: secret Int = 0
  for i in 0..<n
    acc = acc + 1
  acc

bit(k: Int, key: secret Int) -> secret Int
=
  let edit x: secret Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: secret Int) -> Unit
  uses @console: Console[print]
=
  let r = spin(bit(k, key: key) * 3000)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: secret Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
