-- test: ADR 0067 adversarial check of #231, L16_fnchosen: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l16.una:11:3
module l16

maker[T](a: T, b: T) -> fn(Int) -> Int = if a == b then fn(x: Int) -> 1 else fn(x: Int) -> 0

pub leak(s: secret Int) -> Int
=
  let g = maker(s, b: 0)
  g(1)
