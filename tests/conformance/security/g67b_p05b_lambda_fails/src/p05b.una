-- test: ADR 0067 recheck of #231, P05b_lambda_fails: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4002 at src/p05b.una:11:36
module p05b

kind Boom = | Exploded

pub leak(xs: List[Int], t: secret Int) -> Bool
  fails Boom
=
  let found = xs.first_where(keep: fn(x) -> if x == 7 then fail Exploded else x < t)
    if error pass
  true
