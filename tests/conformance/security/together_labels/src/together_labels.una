-- test: a `together for` runs its tasks under the top label of its list, or the labels of its range bounds, so a public sink, a failure or a call of a `uses of` parameter there is rejected, and its list carries that label; a `together` block's branches run under the program counter of the block, and their bindings keep their labels (spec/19 §3)
-- spec: spec/19 §3
-- expect: error U4001 at src/together_labels.una:26:3
-- expect: error U4003 at src/together_labels.una:27:5
-- expect: error U4001 at src/together_labels.una:32:3
-- expect: error U4003 at src/together_labels.una:33:5
-- expect: error U4001 at src/together_labels.una:38:3
-- expect: error U4002 at src/together_labels.una:40:7
-- expect: error U4001 at src/together_labels.una:47:3
-- expect: error U4001 at src/together_labels.una:52:3
-- expect: error U4002 at src/together_labels.una:53:5
-- expect: error U4001 at src/together_labels.una:53:9
-- expect: error U4001 at src/together_labels.una:58:6
-- expect: error U4002 at src/together_labels.una:61:15
-- expect: error U4001 at src/together_labels.una:77:3
module together_labels

pub kind Oops = Bad | Worse

pub capability Log
  op write(line: Text) -> Unit

pub sink_per_task(pins: secret List[Int]) -> List[Unit]
  uses @log: Log[write]
=
  together for p in pins
    @log.write("one")

pub sink_per_range(limit: secret Int) -> List[Unit]
  uses @log: Log[write]
=
  together for i in 0..<limit
    @log.write("one")

pub failing(pins: secret List[Int]) -> List[Int]
  fails Oops
=
  together for p in pins
    if p > 3
      fail Bad
    p

pub length(pins: secret List[Int]) -> Int
=
  let done = together for p in pins
    1
  done.len

pub callback(pins: secret List[Int], act: fn(Int) -> Unit) -> List[Unit]
  uses of act
=
  together for p in pins
    act(p)

pub under_secret(flag: secret Bool) -> Int
  uses @log: Log[write]
=
  if flag
    together
      let x = 1
      let y = log_one()
    x + y
  else
    0

log_one() -> Int
  uses @log: Log[write]
=
  @log.write("branch")
  1

pub kept(pin: secret Int, n: Int) -> Int
=
  together
    let x = pin + 1
    let y = n + 1
  x

pub elements(pins: List[secret Int]) -> List[Unit]
  uses @log: Log[write]
=
  together for p in pins
    @log.write("element")
