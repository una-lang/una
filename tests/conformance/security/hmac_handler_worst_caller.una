-- test: a handler of Keys is checked against the worst caller, a public key name and data of every label (R-014, R-015)
-- spec: spec/07 §7
-- expect: error U4003 at 17:20
module hmac_handler_worst_caller

import std.testing (fake_hash)

handler naming() for Keys
  uses @console: Console[print]
  op hmac(key_name, data) =
    @console.print(key_name)
    fake_hash(1)

handler leaking() for Keys
  uses @console: Console[print]
  op hmac(key_name, data) =
    @console.print(data)
    fake_hash(2)

handler carrying() for Keys
  uses @inner: Keys[hmac]
  op hmac(key_name, data) =
    @inner.hmac(key_name: key_name, data: data)
      if error pass
