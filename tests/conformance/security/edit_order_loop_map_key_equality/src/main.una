-- test: label order shape `loop-map-key-equality` (#323, N-45, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:16:20
module main

-- review: rejected (U4003): the size of a map whose keys include an internal one tells whether it equals a known key; with S=x it prints 0 then 1, otherwise 0 then 2
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let x = "x"
  let edit m = empty_map()
  for i in 0..<2
    @console.print("{m.len}")
    edit m.set(key: s, value: i)
    edit m.set(key: x, value: i)
