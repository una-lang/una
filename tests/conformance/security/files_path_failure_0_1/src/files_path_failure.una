-- test: in edition 0.1 too, whether Files.write fails is labeled by its path, which accepts internal data, and not by its content: if error pass on an internal path is U4002, attempt gives an internal Result, and a public path keeps every handling unless the package writes to a labeled path: this one does, so the file-state label makes every Files failure internal, the public-path write's included (spec/14 §3, spec/07 §7 rule 4, N-39, S-14, ADR 0085)
-- spec: spec/14 §3
-- expect: error U4001 at src/files_path_failure.una:19:3
-- expect: error U4002 at src/files_path_failure.una:13:5
-- expect: error U4002 at src/files_path_failure.una:32:5
module files_path_failure

pub write_path(path: internal Text) -> Unit
  uses @files: Files[write]
  fails FileError
=
  @files.write(path, content: "x")
    if error pass

pub write_path_tag(path: internal Text) -> Bool
  uses @files: Files[write]
=
  let r = attempt @files.write(path, content: "x")
  r is Ok

pub write_path_tag_control(path: internal Text) -> internal Bool
  uses @files: Files[write]
=
  let r = attempt @files.write(path, content: "x")
  r is Ok

pub write_content(note: internal Text) -> Unit
  uses @files: Files[write]
  fails FileError
=
  @files.write("note.txt", content: note)
    if error pass
