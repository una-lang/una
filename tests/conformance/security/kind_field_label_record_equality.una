-- test: equality on a record with an internal field is internal, directly, through a generic and through contains
-- spec: spec/07 §7
-- expect: error U4003 at 23:18
module g06_record_equality_demo

kind Login
  user: Text
  pin: internal Text

same[T](a: T, b: T) -> Bool = a == b

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  let mine = Login(user: "ada", pin: pin)
  let guess = Login(user: "ada", pin: "1234")
  let direct = mine == guess
  let generic = same(mine, b: guess)
  let listed = [mine].contains(item: guess)
  @console.print("direct {direct} generic {generic} listed {listed}")
