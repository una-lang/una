-- test: function values: ordering function values is rejected by construction, and ordering their results is labeled (label sweep)
-- spec: spec/07 §7
-- expect: error U2001 at 17:39
-- expect: error U4001 at 17:39
-- expect: error U4001 at 19:40
-- expect: error U4001 at 24:3
module sweep_label_fnvalue_order

low(x: Int) -> Int = x

high(x: Int) -> Int = x + 1

pick(pin: secret Int) -> secret fn(Int) -> Int = if pin > 0 then low else high

is_pin[T](x: T, y: T) -> Int = if x == y then 1 else 0

pub values(pin: secret Int) -> Bool = pick(pin) < low

pub ordered(pin: secret Int) -> Bool = pick(pin)(1) < 5

pub ranged(pin: secret Int) -> Bool
=
  let f = is_pin
  f(pin, 1) in 0..1

pub ordered_twin(pin: secret Int) -> secret Bool = pick(pin)(1) < 5

pub ranged_twin(pin: secret Int) -> secret Bool
=
  let f = is_pin
  f(pin, 1) in 0..1
