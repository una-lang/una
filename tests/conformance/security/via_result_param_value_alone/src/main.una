-- test: the twin of `via_result_param_value` without a task construct in the package: the `within` that the function value of the `via`'s parameter runs has a `public` concurrent label, so the package is accepted (spec/07 §5 rule 7, #1710)
-- spec: spec/07 §5
-- expect: ok
module main

import release (Box, key_of)
import std.time (millisecond)

spin(x: internal Int) -> internal Int
=
  let v: restricted Int = 1 within 1 * millisecond
    if error use 0
  x

pub once(n: internal Int) -> Int = key_of(Box(f: spin, n: n))
