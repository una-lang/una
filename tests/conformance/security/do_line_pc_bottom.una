-- test: a `do` line is checked at pc ⊥, so it may call a function that can fail, with a secret argument
-- spec: spec/07 §7
-- expect: ok
-- expect: test-pass
module do_line_pc_bottom

pub kind Bad = | TooBig

pub risky(n: secret Int) -> Int
  fails Bad
=
  fail TooBig

pub secret_total() -> secret Int = 7

example "a do line calls a failing function on a secret"
  do risky(secret_total())
  expect fails TooBig
