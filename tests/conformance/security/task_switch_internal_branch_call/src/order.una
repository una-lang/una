-- test: the residual of #1708, the twin of `task_switch_branch_call` with an `internal` key: no loop bound is labeled, and a loop of `public` length calls a function only on one side of a branch on an `internal` bit. The rule's bound is `internal` (spec/27 §8 rule 5), so it is accepted, the report lists the call as a `task switch` at `internal` (spec/13 §6), and the prints follow the key's bits until the amendment of ADR 0117 that stops counting the check points under a raised program counter
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "2"
-- expect: run-output "5"
-- expect: run-output "7"
-- expect: run-output "1"
-- expect: run-output "3"
-- expect: run-output "4"
-- expect: run-output "6"
module order

noop() -> Unit = unit

bit(k: Int, key: internal Int) -> internal Int
=
  let edit x: internal Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: internal Int) -> Unit
  uses @console: Console[print]
=
  let b = bit(k, key: key)
  for i in 0..<3000
    if b == 1
      noop()
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: internal Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
