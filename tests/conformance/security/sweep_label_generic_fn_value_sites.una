-- test: a generic function used as a value, stored in a field, a list or a join, passed to a generic function or captured by a lambda, keeps the labels of its type arguments (N-003) (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 27:21
-- expect: error U4001 at 34:3
-- expect: error U4001 at 36:34
-- expect: error U4001 at 36:41
-- expect: error U4001 at 41:3
-- expect: error U4001 at 47:3
-- expect: error U4001 at 60:3
-- expect: error U4001 at 65:3
-- expect: error U4001 at 65:32
-- expect: error U4001 at 71:3
-- expect: error U4001 at 78:3
module sweep_label_generic_fn_value_sites

is_pin[T](x: T, y: T) -> Int = if x == y then 1 else 0

same[T](x: T, y: T) -> Int = if x == y then 1 else 0

kind Holder
  f: fn(secret Int, secret Int) -> Int

apply2[A](f: fn(A, A) -> Int, x: A) -> Int = f(x, x)

pub b1(pin: secret Int) -> Int
=
  let h = Holder(f: is_pin)
  h.f(pin, 1)

pub b2(pin: secret Int) -> Int
=
  let f = [is_pin].first()
    if none use same
  f(pin, 1)

pub b3(pin: secret Int) -> Int = apply2(is_pin, x: pin)

pub b4(c: Bool, pin: secret Int) -> Int
=
  let f = if c then is_pin else same
  f(pin, 1)

pub b5(pin: secret Int) -> Int
=
  let f = is_pin
  let g = f
  g(pin, 1)

pub b6(pin: secret Int) -> Int
=
  let f = is_pin
  let a = f(1, 1)
  let b = f(pin, 1)
  a

pub b7(pin: secret Int) -> Int
=
  let f = is_pin
  let k = fn(x: secret Int) -> f(x, 1)
  k(pin)

pub b8(pin: secret Int) -> Int
=
  let f = is_pin
  [pin].fold(initial: 0, step: fn(n, x) -> n + f(x, 1))

pub b9(pin: secret Int) -> Int
=
  let f = is_pin
  let xs = [pin].map(each: fn(x) -> f(x, 1))
  xs.sum()

pub b10(pin: secret Int) -> Int
=
  let fs = [is_pin, same]
  let f = fs.at(index: 0)
    if none use same
  f(pin, 1)
