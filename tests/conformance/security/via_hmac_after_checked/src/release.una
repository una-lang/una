trusted module release

pub kind ViaError = Broke(detail: Text) | Gone

pub policy key_of
  from secret Text
  to internal Hashed
  via hmac_it
  purpose "a keyed hash of the text"
  owner privacy

hmac_it(t: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails ViaError
=
  let short = checked(t, it.len < 20) else fail Gone
  @keys.hmac(key_name: "pepper", data: short)
    if error fail Gone
