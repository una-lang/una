-- test: a unitless `Int` start may not reach an `Int of Millisecond` state either, as a unitless value meets a measured one (spec/26 §2, issue #1647)
-- spec: spec/26 §2
-- expect: error U2028 at src/counter.una:11:22
module counter

import std.drive (Tick)
import std.time (Millisecond, millisecond)

pub init() -> Int = 7

pub step(edit state: Int of Millisecond, input: Tick) -> Unit
=
  state = state + millisecond
