-- test: the twin of `tconc_residue_lambda` whose lambda makes no request, the same program but for that call: the started tasks reach no operation of `Http`, so they can leave nothing on a helper, `L_res` is `public`, and the `within` over pure work is `public`, which the `internal` binding accepts (ADR 0116 P9); the pair differs in the request, not in a label, since a call of a function value makes the statement's own label `⊤` (IF5 item 4)
-- spec: spec/26 §7
-- expect: ok
module residue

import std.time (millisecond)

drop_reply[T](reply: T) -> Unit = unit

--- Calls its function value, whose effects are its own.
run_with(go: fn(Text) -> Unit, url: Text) -> Unit
  uses of go
=
  go(url)

--- Starts `run_with` with a lambda that makes no request.
pub serve(url: Text) -> Unit
  uses @http: Http[get]
=
  let fetch = fn(u: Text) -> drop_reply(u)
  tasks
    start run_with(fetch, url)
  unit

step(n: Int) -> Int = n + 1

--- Pure work under a deadline, in a function no task reaches.
pub measured(n: Int) -> internal Int
=
  let v: internal Int = step(n) within 10 * millisecond
    if error use 0
  v
