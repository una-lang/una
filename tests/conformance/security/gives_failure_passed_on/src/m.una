-- test: whether a labeled operation failed carries the label, so passing its failure on is U4002 (ADR 0094 rule 2)
-- spec: spec/07 §3
-- expect: error U4002 at src/m.una:17:5
module m

pub kind Lookup = | NotFound

pub capability Files
  op owner(file: Text) -> Text
    fails Lookup

pub refusal(file: Text) -> internal[Service] Text
  uses @service_files: Files[owner gives internal[Service]]
  fails Lookup
=
  let owner = @service_files.owner(file)
    if error pass
  owner
