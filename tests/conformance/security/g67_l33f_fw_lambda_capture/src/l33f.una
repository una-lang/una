-- test: ADR 0067 adversarial check of #231, L33f_fw_lambda_capture: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4002 at src/l33f.una:18:36
module l33f

pub capability Log
  op write(n: Int) -> Unit

below(x: Int, t: secret Int) -> secret Bool
  uses @log: Log[write]
=
  @log.write(x)
  x < t

pub leak(xs: List[Int], t: secret Int) -> Unit
  uses @log: Log[write]
=
  let found = xs.first_where(keep: fn(x) -> below(x, t))
  unit
