-- test: main fails with internal payloads (top level, in a list, in an Option); does the runtime print them? (review control)
-- spec: spec/04 §8
-- grant: env
-- expect: error U6001 at 11:5
module main_failure_payload

kind Stop = | Mixed(code: Int, top: internal Text, values: List[internal Text],
  wrapped: Option[internal Text]
)

pub main() -> Unit
  uses @env: Env[get]
  fails Stop
=
  let pin = @env.get("PIN")
    if none use ""
  fail Mixed(code: 7, top: pin, values: [pin], wrapped: Some(pin))
