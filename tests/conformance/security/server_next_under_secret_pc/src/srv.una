-- test: `next` accepts `internal`, so whether a task takes a request off the queue cannot depend on `secret` data: under a `secret` program counter it is U4003 (spec/31 §1, ADR 0123 IF1)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:12:23
module srv

import std.host (HttpServer)

grab(key: secret Int) -> Unit
  uses @server: HttpServer[next]
=
  if key > 0
    let got = attempt @server.next()
    unit
  else
    unit
