-- test: a constructor field fed by a field read checks every flow (label); each _bad probe is rejected and each _ok twin accepted (flow sweep)
-- spec: spec/10 §2
-- expect: error U4001 at 24:21
module sweep_flow_field_field

pub kind Pos = Int where it > 0

pub kind Holder
  n: Int
  p: Pos
  s: secret Int
  run: fn(Int) -> Int
  pos: fn(Int) -> Pos
  pinv: fn(Pos) -> Int

pub kind Boom = | Bang

pub kind BoxL
  v: Int

pub l_bad(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxL = BoxL(v: h.s)

pub l_ok(h: Holder, s: secret Int, g: fn(Int) -> Int, k: fn(Int) -> Pos, t: fn(Int) -> secret Int,
  w: fn(Pos) -> Int, z: fn(Int) -> Int fails Boom,
  q: fn(Int) -> Int uses @c: Console[print]
) -> BoxL = BoxL(v: h.n)
