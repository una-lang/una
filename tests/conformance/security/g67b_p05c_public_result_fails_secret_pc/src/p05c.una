-- test: ADR 0067 recheck of #231, control P05c_public_result_fails_secret_pc: the same shapes with nothing secret decided, which edition 0.2 accepts (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: ok
module p05c

kind Boom = | Exploded

check(x: Int) -> Bool
  fails Boom
=
  if x == 7
    fail Exploded
  x < 3

pub fine(xs: List[Int]) -> Bool
  fails Boom
=
  let found = xs.first_where(keep: check)
    if error pass
  true
