-- test: ADR 0067 adversarial check of #231, L42_option_of_list: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l42.una:11:19
module l42

found[T](a: T, b: T) -> Option[List[Int]] = Some(if a == b then [1] else [])

pub leak(s: secret Int) -> Int
=
  when found(s, b: 0)
    is Some(v) -> v.len
    is None -> 0
