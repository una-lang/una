-- test: precise `τ_conc` (ADR 0116 P2): every task of a `together for` runs beside the others, so `report(x)` beside `churn_with(key, x)` has a `secret` `τ_conc` (U4003 at the print)
-- spec: spec/27 §11
-- expect: error U4003 at src/report.una:24:18
module report

import std.time (millisecond)

crunch(key: secret Int) -> secret Int = key * 3

--- Work on `key`, which a started task runs.
churn(key: secret Int) -> Unit
=
  let spent = crunch(key)
  unit

step(n: Int) -> Int = n + 1

--- Prints whether `step(n)` met its deadline: the value carries the deadline's timing label.
report(n: Int) -> Unit
  uses @console: Console[print]
=
  let v = step(n) within 10 * millisecond
    if error use 0
  @console.print("{v}")

churn_with(key: secret Int, x: Int) -> Unit
=
  let spent = crunch(key)
  unit

--- Each task of the body calls `churn_with(key, x)` and `report(x)`.
pub serve(key: secret Int, xs: List[Int]) -> List[Unit]
  uses @console: Console[print]
=
  together for x in xs
    let spent = churn_with(key, x)
    report(x)
