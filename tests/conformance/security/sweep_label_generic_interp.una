-- test: a generic kind instantiated with a secret type: an interpolation of a comparison of it is a secret argument of Console (label sweep)
-- spec: spec/07 §7
-- expect: error U4003 at 23:18
module sweep_label_generic_interp

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Box[secret Int]) -> secret Int = x.value

pub shown(x: Box[secret Int]) -> Unit
  uses @console: Console[print]
=
  @console.print("same {x == Box(value: 2)}")

pub shown_twin(x: Box[secret Int]) -> Unit
  uses @console: Console[print]
=
  @console.print("fixed")
