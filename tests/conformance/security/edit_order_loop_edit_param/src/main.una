-- test: label order shape `loop-edit-param` (#323, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:19:20
module main

push[T](edit xs: List[T], x: T) -> Unit
=
  xs = xs.append(item: x)

-- review: rejected (U4003): a generic edit parameter raises the caller's binding
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = []
  for i in 0..<2
    @console.print("{xs}")
    push(edit xs, x: s.len)
