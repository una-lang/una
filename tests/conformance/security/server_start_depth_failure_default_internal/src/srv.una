-- test: the twin of `server_start_depth_failure_default`: the read's failure is decided by `internal` data, which a reply accepts, so the `start` is accepted (spec/31 §1, ADR 0123 IF6, #1674)
-- spec: spec/31 §1
-- expect: ok
module srv

import std.host (Exchange, HttpServer, Reply)

big(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + big(n - 1)

answer(exchange: internal Exchange) -> Unit
  uses @server: HttpServer[reply]
  uses @files: Files[read gives internal]
=
  let text = @files.read("flag")
    if error use "{big(5000)}"
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all() -> Unit
  uses @server: HttpServer[next, reply, close]
  uses @files: Files[read gives internal]
  diverges
=
  tasks at most 1000 at once
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange)
        is Err(failure) -> unit
    on stop
      @server.close()
