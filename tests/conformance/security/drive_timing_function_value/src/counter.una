-- test: a driven step that maps over its state with a lambda written at the call captures only `public` data, so the lambda is the step's own code and its `input` needs no label (spec/26 §2 rule 5 item 4, ADR 0116 IF5 item 4, #1023)
-- spec: spec/26 §2
-- expect: ok
module counter

import std.drive (Tick)

pub init() -> Int = 0

pub step(edit count: Int, input: Tick) -> Unit
=
  let next = [count].map(each: fn(x: Int) -> x + 1)
  count = count + next.len
