-- test: a text literal with interpolation in a pattern is U4008 even when what it interpolates is `public`: a pattern is a constant (S-28)
-- spec: spec/07 §7
-- expect: error U4008 at src/main.una:11:8
module main

pub main() -> Unit
  uses @console: Console[print]
=
  let p = "abc"
  when "abc"
    is "{p}" -> @console.print("yes")
    else -> @console.print("no")
