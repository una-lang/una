-- test: a generic kind instantiated with a secret type: a handler operation result keeps the field labels of the declared result (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 30:3
module sweep_label_generic_handler

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Box[secret Int]) -> secret Int = x.value

capability Store
  op fetch() -> Box[secret Int]

handler fixed() for Store
  op fetch() = Box(value: 2)

pub fetched() -> Bool
  uses @store: Store[fetch]
=
  let x = @store.fetch()
  x == Box(value: 2)

pub installed() -> secret Bool
=
  fetched_twin() with @store = fixed()

fetched_twin() -> secret Bool
  uses @store: Store[fetch]
=
  let x = @store.fetch()
  x == Box(value: 2)
