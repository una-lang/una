-- test: a function value that a task calls runs a lambda, whose calls count where it is written: a lambda that recurses on `secret` data makes the depth of the task that calls it depend on that data, U4003 at the `start` (spec/31 §1, ADR 0123 IF6, #1674)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:28:7
module srv

import std.host (Exchange, HttpServer, Reply)

deep(n: secret Int) -> secret Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

later(exchange: internal Exchange, work: fn() -> secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  let d = work()
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all(exchanges: internal List[Exchange], key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  let work = fn() -> deep(key)
  tasks
    for exchange in exchanges
      start later(exchange, work: work)
