-- test: the hunt's probe of #973 with an `internal` key, as every request of `HttpServer` is: the twin of `task_switch_secret_loop`. The loop whose bound the key decides is a check point that data above `public` decide, so Core IR marks it `uncounted` and its iterations move no switch (spec/27 §8 rule 5, ADR 0117 amendment of 2026-11-22, second, #1708): the prints are `0` to `7` in order, for every key, as `una run` and native code under `--virtual-time` show alike (`crates/una-cli/tests/native.rs`); the iterations of a `for` loop are no `task switch` of the report either
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "1"
-- expect: run-output "2"
-- expect: run-output "3"
-- expect: run-output "4"
-- expect: run-output "5"
-- expect: run-output "6"
-- expect: run-output "7"
module order

spin(n: internal Int) -> internal Int
=
  let edit acc: internal Int = 0
  for i in 0..<n
    acc = acc + 1
  acc

bit(k: Int, key: internal Int) -> internal Int
=
  let edit x: internal Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: internal Int) -> Unit
  uses @console: Console[print]
=
  let r = spin(bit(k, key: key) * 3000)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: internal Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
