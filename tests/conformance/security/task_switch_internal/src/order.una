-- test: the rule's bound is `internal`, as for the depth of a started task (#1674): the program of `task_switch_secret_loop` with an `internal` key, as every request of `HttpServer` is, is accepted. Its prints are ordered by that key: a known residual (#1708), which the report lists as a `task switch` at `internal` at the loop (spec/13 §6), until the amendment of ADR 0117 that stops counting the check points under a raised program counter (spec/27 §8 rule 5, #1684)
-- spec: spec/27 §8
-- grant: console
-- expect: run-output "0"
-- expect: run-output "2"
-- expect: run-output "5"
-- expect: run-output "7"
-- expect: run-output "1"
-- expect: run-output "3"
-- expect: run-output "4"
-- expect: run-output "6"
module order

spin(n: internal Int) -> internal Int
=
  let edit acc: internal Int = 0
  for i in 0..<n
    acc = acc + 1
  acc

bit(k: Int, key: internal Int) -> internal Int
=
  let edit x: internal Int = key
  for i in 0..<k
    x = x / 2
  x mod 2

worker(k: Int, key: internal Int) -> Unit
  uses @console: Console[print]
=
  let r = spin(bit(k, key: key) * 3000)
  @console.print("{k}")

pub main() -> Unit
  uses @console: Console[print]
=
  let key: internal Int = 90
  tasks
    for k in 0..<8
      start worker(k, key: key)
