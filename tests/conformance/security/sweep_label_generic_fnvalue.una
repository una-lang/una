-- test: a generic kind instantiated with a secret type: a call through a function value, generic or not, keeps the field labels (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 29:3
-- expect: error U4001 at 34:3
-- expect: error U4001 at 39:3
module sweep_label_generic_fnvalue

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Box[secret Int]) -> secret Int = x.value

same[T](a: T, b: T) -> Bool = a == b

equal(a: Box[secret Int], b: Box[secret Int]) -> secret Bool = a == b

pub generic_value(x: Box[secret Int]) -> Bool
=
  let f = same
  f(x, Box(value: 2))

pub plain_value(x: Box[secret Int]) -> Bool
=
  let g = equal
  g(x, Box(value: 2))

pub lambda_value(x: Box[secret Int]) -> Bool
=
  let h = fn(a: Box[secret Int]) -> a == Box(value: 2)
  h(x)
