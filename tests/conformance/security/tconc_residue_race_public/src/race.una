-- test: the twin of `tconc_residue_race` whose race reaches no request, its branches `busy(m)` and `busy(m + 1)`: no loser can leave a request behind, so `L_res` is `public`, the outcome of the later `within` over pure work is `public`, and `Console.print` accepts it (ADR 0116 P9); this pair differs in what the race reaches, not in a label, since the `internal` of a race over a request comes from `ρ` of `Http` itself
-- spec: spec/27 §6
-- expect: ok
module race

import std.time (millisecond)

--- Public work that runs for a while.
busy(m: Int) -> Int
=
  let edit total = 0
  for i in 1..m
    total = total + 1
  total

--- One request, whose failure it handles.
fetch(url: Text) -> Int
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  1

step(n: Int) -> Int = n + 1

pub run(url: Text, m: Int, n: Int) -> Unit
  uses @console: Console[print]
  uses @http: Http[get]
=
  for i in 1..10
    let got = first of
      busy(m + 1)
      busy(m)
  let v = step(n) within 10 * millisecond
    if error use 0
  @console.print("{v}")
