-- test: `Result` is covariant in both arguments at a handler result (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 17:16
-- expect: error U4001 at 23:16
module sweep_variance_result_handler

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

capability Give0
  op give(v: Result[secret Int, Int]) -> Result[Int, Int]

handler giving0() for Give0
  op give(v) = v

capability Give1
  op give(v: Result[Int, secret Int]) -> Result[Int, Int]

handler giving1() for Give1
  op give(v) = v

capability Give2
  op give(v: Result[Int, Int]) -> Result[secret Int, secret Int]

handler giving2() for Give2
  op give(v) = v

capability Give0Twin
  op give(v: Result[secret Int, Int]) -> Result[secret Int, secret Int]

handler giving0_twin() for Give0Twin
  op give(v) = v

capability Give1Twin
  op give(v: Result[Int, secret Int]) -> Result[secret Int, secret Int]

handler giving1_twin() for Give1Twin
  op give(v) = v
