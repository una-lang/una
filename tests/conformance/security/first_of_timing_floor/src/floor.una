-- test: every branch of `first of` runs under the timing floor `pc ⊔ t`, with `t` the timing label of every branch (ADR 0117 IF3): beside a branch that computes on a `secret`, a `public` print in a sibling is U4003, and a call with effects that accept `public` data is U4002; on `public` timing both are accepted
-- spec: spec/27 §6
-- expect: error U4003 at src/floor.una:19:5
-- expect: error U4002 at src/floor.una:22:5
module floor

work(key: secret Int) -> Unit = unit

announce() -> Unit
  uses @console: Console[print]
=
  @console.print("start")

pub floor(key: secret Int) -> Unit
  uses @console: Console[print]
=
  let printed = first of
    work(key)
    @console.print("b")
  let announced = first of
    work(key)
    announce()
  let calm = first of
    work(1)
    @console.print("c")
  unit
