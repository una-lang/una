-- test: `Result` is covariant in both arguments at a return (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 13:61
-- expect: error U4001 at 15:61
module sweep_variance_result_return

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub ret_0(v: Result[secret Int, Int]) -> Result[Int, Int] = v

pub ret_1(v: Result[Int, secret Int]) -> Result[Int, Int] = v

pub ret_2(v: Result[Int, Int]) -> Result[secret Int, secret Int] = v
