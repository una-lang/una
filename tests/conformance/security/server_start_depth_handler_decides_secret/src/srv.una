-- test: a task that performs an operation whose handler, installed with a `secret` key, decides by it whether to call the recursive `deep`, keeps the coarse depth test, since a handler's operation records its check points apart from any function: U4003 at the `start`, and U4002 at the call in the handler (spec/31 §1, ADR 0123 IF6, #1682)
-- spec: spec/31 §1
-- expect: error U4002 at src/srv.una:20:27
-- expect: error U4003 at src/srv.una:45:11
module srv

import std.host (Exchange, HttpServer, Reply)

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

capability Depth
  op go() -> secret Int

handler deciding(k: secret Int) for Depth
  op go() = if k > 0 then deep(3000) else 0

use_depth() -> secret Int
  uses @d: Depth[go]
=
  @d.go()

answer(exchange: internal Exchange, key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  let n = exchange.request.body.len
  let e = deep(n)
  let d = use_depth() with @d = deciding(key)
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all(key: secret Int) -> Unit
  uses @server: HttpServer[next, reply, close]
  diverges
=
  tasks at most 1000 at once
    for ever
      let next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange, key: key)
        is Err(failure) -> unit
    on stop
      @server.close()
