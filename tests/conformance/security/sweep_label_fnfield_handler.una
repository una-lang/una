-- test: a kind whose field is a function type: a handler result of a kind with a function field keeps the field's label (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 27:3
-- expect: error U4001 at 33:3
module sweep_label_fnfield_handler

kind Src
  get: fn() -> secret Int

kind Feed[T]
  get: fn() -> T

make(pin: secret Int) -> Src = Src(get: fn() -> pin)

capability Source
  op src() -> Src
  op feed() -> Feed[secret Int]

handler fixed() for Source
  op src() = Src(get: fn() -> 1)
  op feed() = Feed(get: fn() -> 2)

pub fetched() -> Int
  uses @source: Source[src]
=
  let s = @source.src()
  s.get()

pub fed() -> Int
  uses @source: Source[feed]
=
  let f = @source.feed()
  f.get()

pub fetched_twin() -> secret Int
  uses @source: Source[src]
=
  let s = @source.src()
  s.get()

pub fed_twin() -> secret Int
  uses @source: Source[feed]
=
  let f = @source.feed()
  f.get()
