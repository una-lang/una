-- test: function values: interpolating a function value is rejected by construction, and interpolating its result is a labeled argument of Console (label sweep)
-- spec: spec/07 §7
-- expect: error U4003 at 19:18
-- expect: error U2001 at 19:20
-- expect: error U4003 at 25:18
module sweep_label_fnvalue_interp

low(x: Int) -> Int = x

high(x: Int) -> Int = x + 1

pick(pin: secret Int) -> secret fn(Int) -> Int = if pin > 0 then low else high

is_pin[T](x: T, y: T) -> Int = if x == y then 1 else 0

pub values(pin: secret Int) -> Unit
  uses @console: Console[print]
=
  @console.print("{pick(pin)}")

pub results(pin: secret Int) -> Unit
  uses @console: Console[print]
=
  let f = fn(x: Int) -> x + pin
  @console.print("{f(1)}")
