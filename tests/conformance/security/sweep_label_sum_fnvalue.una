-- test: a sum kind with a secret variant field: a call through a function value, generic or not, keeps the field labels (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 33:3
-- expect: error U4001 at 38:3
-- expect: error U4001 at 43:3
module sweep_label_sum_fnvalue

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab(x: Guess) -> secret Int
=
  when x
    is Hit(pin) -> pin
    is Miss -> 0

same[T](a: T, b: T) -> Bool = a == b

equal(a: Guess, b: Guess) -> secret Bool = a == b

pub generic_value(x: Guess) -> Bool
=
  let f = same
  f(x, Hit(pin: 2))

pub plain_value(x: Guess) -> Bool
=
  let g = equal
  g(x, Hit(pin: 2))

pub lambda_value(x: Guess) -> Bool
=
  let h = fn(a: Guess) -> a == Hit(pin: 2)
  h(x)

pub generic_value_twin(x: Guess) -> secret Bool
=
  let f = same
  f(x, Hit(pin: 2))

pub plain_value_twin(x: Guess) -> secret Bool
=
  let g = equal
  g(x, Hit(pin: 2))

pub lambda_value_twin(x: Guess) -> secret Bool
=
  let h = fn(a: Guess) -> a == Hit(pin: 2)
  h(x)
