-- test: the history of a limit (ADR 0116 P8, ADR 0117 IF4): with `at most 1 per minute`, a second request waits at the bucket for a minute less the time spent since the first, and `--http-timeout` turns that wait into `TimedOut`; `run` spends that time on a `secret`, between two calls of `fetch`, so the label of the request in `fetch` covers `run`, an ancestor of it in the call graph, and is U4001 at the request
-- spec: spec/27 §9
-- expect: error U4001 at src/history.una:10:25
module history

--- One request, whose failure it handles.
fetch(url: Text) -> Unit
  uses @http: Http[get]
=
  let outcome = attempt @http.get(url, headers: [], key_name: None)
  unit

crunch(key: secret Int) -> secret Int = key * 3

pub run(url: Text, key: secret Int) -> Unit
  uses @http: Http[get]
=
  fetch(url)
  let spent = crunch(key)
  fetch(url)
