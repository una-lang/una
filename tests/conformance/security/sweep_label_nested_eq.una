-- test: nested kinds and generics holding a secret: `==` and `!=` are labeled with the declared field labels (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 25:55
-- expect: error U4001 at 27:55
-- expect: error U4001 at 33:57
-- expect: error U4001 at 35:57
-- expect: error U4001 at 41:36
-- expect: error U4001 at 43:36
module sweep_label_nested_eq

kind Acct
  id: Int
  pin: secret Int

kind Guess = Hit(pin: secret Int) | Miss

kind Box[T]
  value: T

kind Wallet
  acct: Acct

grab_boxed_list(x: Box[List[secret Int]]) -> secret Int = x.value.sum()

pub eq_boxed_list(x: Box[List[secret Int]]) -> Bool = x == Box(value: [2])

pub ne_boxed_list(x: Box[List[secret Int]]) -> Bool = x != Box(value: [2])

pub eq_twin_boxed_list(x: Box[List[secret Int]]) -> secret Bool = x == Box(value: [2])

grab_option_box(x: Option[Box[secret Int]]) -> secret Int = x.or_else(default: Box(value: 0)).value

pub eq_option_box(x: Option[Box[secret Int]]) -> Bool = x == Some(Box(value: 2))

pub ne_option_box(x: Option[Box[secret Int]]) -> Bool = x != Some(Box(value: 2))

pub eq_twin_option_box(x: Option[Box[secret Int]]) -> secret Bool = x == Some(Box(value: 2))

grab_wallet(x: Wallet) -> secret Int = x.acct.pin

pub eq_wallet(x: Wallet) -> Bool = x == Wallet(acct: Acct(id: 1, pin: 2))

pub ne_wallet(x: Wallet) -> Bool = x != Wallet(acct: Acct(id: 1, pin: 2))

pub eq_twin_wallet(x: Wallet) -> secret Bool = x == Wallet(acct: Acct(id: 1, pin: 2))
