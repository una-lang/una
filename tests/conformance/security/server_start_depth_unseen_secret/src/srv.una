-- test: a task that calls a function of a standard module other than the prelude, `std.collections`'s `to_set`, whose code the checker does not see, keeps the coarse depth test: it can recurse and holds a `secret` key, so U4003 at the `start`, though the key decides none of its calls (spec/31 §1, ADR 0123 IF6, #1682)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:34:11
module srv

import std.collections (to_set)
import std.host (Exchange, HttpServer, Reply)

deep(n: internal Int) -> internal Int
=
  if n <= 0
    0
  else
    1 + deep(n - 1)

answer(exchange: internal Exchange, key: secret Int) -> Unit
  uses @server: HttpServer[reply]
=
  const d = deep(exchange.request.body.len)
  const s = to_set([1, 2, 3])
  const masked: secret Int = key * 2 + 1
  @server.reply(to: exchange.right, reply: Reply(status: 200, headers: [], body: "ok"))
    if error use unit

pub serve_all(key: secret Int) -> Unit
  uses @server: HttpServer[next, reply, close]
  diverges
=
  tasks at most 1000 at once
    for ever
      const next = attempt @server.next()
      when next
        is Ok(exchange) ->
          start answer(exchange, key: key)
        is Err(failure) -> unit
    on stop
      @server.close()
