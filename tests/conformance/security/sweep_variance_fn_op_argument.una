-- test: a function type at an operation argument is compared at its parameters as at a call argument, and its result is data bounded by `accepts` (label sweep, ADR 0050)
-- spec: spec/07 §7
-- expect: error U4001 at 29:9
-- expect: error U4003 at 39:9
-- expect: error U4001 at 49:9
module sweep_variance_fn_op_argument

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

capability Probe
  op o0(w: fn(secret Int) -> Int) -> Int
    accepts secret
  op o1(w: fn(Int) -> Int) -> Int
    accepts secret
  op o2(w: fn(Int) -> Int) -> Int
  op o3(w: fn(Int) -> secret Int) -> Int
  op o4(w: fn(fn(Int) -> secret Int) -> Int) -> Int
    accepts secret
  op o5(w: fn(fn(secret Int) -> Int) -> Int) -> Int
    accepts secret

pub arg_0(v: fn(Int) -> Int) -> Int
  uses @p: Probe[o0]
=
  @p.o0(v)

pub arg_1(v: fn(secret Int) -> Int) -> Int
  uses @p: Probe[o1]
=
  @p.o1(v)

pub arg_2(v: fn(Int) -> secret Int) -> Int
  uses @p: Probe[o2]
=
  @p.o2(v)

pub arg_3(v: fn(Int) -> Int) -> Int
  uses @p: Probe[o3]
=
  @p.o3(v)

pub arg_4(v: fn(fn(Int) -> Int) -> Int) -> Int
  uses @p: Probe[o4]
=
  @p.o4(v)

pub arg_5(v: fn(fn(Int) -> Int) -> Int) -> Int
  uses @p: Probe[o5]
=
  @p.o5(v)
