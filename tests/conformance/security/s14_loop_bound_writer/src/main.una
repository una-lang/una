-- test: a write in a loop whose bound is `internal` runs under that label, which labels the reads (S-14, from a review)
-- spec: spec/07 §7
-- expect: error U4001 at src/main.una:13:3
module main

pub probe(count: internal Int) -> Bool
  uses @files: Files[read, write]
=
  for i in 0..<count
    let w = attempt @files.write("marker.txt", content: "")
    unit
  let r = attempt @files.read("marker.txt")
  is_ok(r)
