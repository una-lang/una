-- test: ADR 0067 amendment (2026-10-06), B05b_fn_returned_to_caller_c: a T value decided by comparing T values goes where a value of T is expected (a lambda, a higher-order function, a function result, an `edit` binding or a field of the body), which edition 0.2 rejects in the generic body; the control, sound, is rejected there, an accepted cost, since accepting it soundly would need re-checking lambdas (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/b05b_fn_returned_to_caller_c.una:6:74
module b05b_fn_returned_to_caller_c

chooser[T](a: T, b: T, p: T, q: T) -> fn(fn(T) -> Int) -> Int = fn(k) -> k(if a == b then p else q)

pub leak(s: Int) -> Int = chooser([s], b: [0], p: [], q: [1, 2])(fn(xs: List[Int]) -> xs.len)
