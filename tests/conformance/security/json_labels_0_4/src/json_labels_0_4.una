-- test: JSON keeps labels: a value parsed from a secret text, a text quoted or written from a secret, and a value bound from a secret Json are secret; in edition 0.4 a secret enters a Json constructor, whose result is then labeled secret (ADR 0073 J5 as amended); and whether a parse of a secret text fails, and where, is secret too, so attempt gives a secret Result and if error pass and if error fail are U4002 (spec/23 §5, ADR 0073 J5)
-- spec: spec/23 §5
-- expect: error U4001 at src/json_labels_0_4.una:21:3
-- expect: error U4002 at src/json_labels_0_4.una:22:5
-- expect: error U4001 at src/json_labels_0_4.una:26:42
-- expect: error U4001 at src/json_labels_0_4.una:28:39
-- expect: error U4002 at src/json_labels_0_4.una:36:5
-- expect: error U4001 at src/json_labels_0_4.una:37:8
-- expect: error U4001 at src/json_labels_0_4.una:38:22
-- expect: error U4001 at src/json_labels_0_4.una:44:3
-- expect: error U4001 at src/json_labels_0_4.una:49:8
-- expect: error U4001 at src/json_labels_0_4.una:52:12
-- expect: error U4001 at src/json_labels_0_4.una:53:26
-- expect: error U4002 at src/json_labels_0_4.una:60:5
-- expect: error U4001 at src/json_labels_0_4.una:64:3
module json_labels_0_4

pub parsed(t: secret Text) -> Json
  fails JsonError
=
  t.parse_json()
    if error pass

pub wrapped(token: secret Text) -> secret Json = Str(token)

pub quoted(token: secret Text) -> Text = token.quote_json()

pub written(j: secret Json) -> Text = j.to_json()

pub kept(token: secret Text) -> secret Text = token.quote_json()

pub bound(t: secret Text) -> Text
  fails JsonError
=
  let j = t.parse_json()
    if error pass
  when j
    is Str(value) -> value
    else -> ""

pub accepted(t: secret Text) -> Bool
=
  let r = attempt t.parse_json()
  r is Ok

pub position(t: secret Text) -> Int
=
  let r = attempt t.parse_json()
  when r
    is Ok(j) -> -1
    is Err(e) ->
      when e
        is Syntax(at) -> at
        else -> -1

pub refailed(t: secret Text) -> secret Json
  fails JsonError
=
  t.parse_json()
    if error fail Syntax(0)

pub defaulted(t: secret Text) -> Json
=
  t.parse_json()
    if error use Null

pub labeled(t: secret Text) -> secret Bool
=
  let r = attempt t.parse_json()
  r is Ok
