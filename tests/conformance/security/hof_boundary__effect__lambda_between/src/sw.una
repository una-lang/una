-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): reject: an inferred lambda checked after an undecided argument solved its parameter, before the decided one
-- spec: spec/07 §7
-- expect: error U4002 at src/sw.una:31:23
-- expect: error U4001 at src/sw.una:31:25
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

same[U](x: U, f: fn(U) -> Unit uses @log: Log[write], y: U) -> Unit
  uses @log: Log[write]
=
  f(y)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  same(p, f: fn(z) -> k(z), y: if a == b then p else q)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> @log.write(xs.len))
