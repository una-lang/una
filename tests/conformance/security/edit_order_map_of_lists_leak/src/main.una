-- test: label order shape `map-of-lists-leak` (#323, N-45, review #330): the read sees the solved label, whatever the order
-- spec: spec/17 §6
-- expect: error U4003 at src/main.una:17:18
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit m = empty_map()
  edit m.set(key: "a", value: [1])
  let early = m.get(key: "a")
    if none use []
  edit m.set(key: "b", value: [s.len])
  @console.print("{early}")
