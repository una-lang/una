-- test: in a package that imports `HttpServer`, a `start` that captures a function value under a `secret` program counter may move reply rights, so it is U4003 (spec/31 §1, ADR 0123 IF6); in a program that starts tasks, the check point that `secret` data decide there is also U4002 (spec/27 §8 rule 5, #1684)
-- spec: spec/31 §1
-- expect: error U4003 at src/srv.una:19:9
-- expect: error U4002 at src/srv.una:19:15
module srv

import std.host (HttpServer)

pub main() -> Unit
  uses @server: HttpServer[close]
=
  @server.close()

pub spawn(jobs: internal List[fn() -> Unit], key: secret Int) -> Unit
=
  tasks
    for job in jobs
      if key > 0
        start job()
      else
        unit
