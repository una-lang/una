-- test: ADR 0067 adversarial check of #231, L29_nongeneric_param: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l29.una:8:42
module l29

wrap[T](x: T, k: Int) -> List[T] = if k == 0 then [x] else [x, x]

pub leak(k: secret Int) -> Int = wrap(1, k).len
