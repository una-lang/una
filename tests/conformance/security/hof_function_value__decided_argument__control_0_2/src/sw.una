-- test: a function value given an argument decided by values of a type parameter (#253, #356): accept: control: edition 0.2 strips the decision from the flow and raises the call's result and program counter instead (ADR 0067 amendment)
-- spec: spec/07 §7
-- expect: ok
module sw

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Int
=
  let n = k(if a == b then p else q)
  0

pub main(s: secret Int) -> secret Int = g(s, b: 0, p: 1, q: 2, k: fn(x) -> 0)
