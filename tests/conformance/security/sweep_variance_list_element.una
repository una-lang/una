-- test: `List` is covariant at a list element (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:3
module sweep_variance_list_element

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub elem_0(v: List[secret Int], w: List[Int]) -> List[List[Int]]
=
  let ws = [w, v]
  ws

pub elem_1(v: List[Int], w: List[secret Int]) -> List[List[secret Int]]
=
  let ws = [w, v]
  ws
