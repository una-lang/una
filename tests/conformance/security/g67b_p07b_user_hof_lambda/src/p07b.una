-- test: ADR 0067 recheck of #231, P07b_user_hof_lambda: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/p07b.una:17:39
module p07b

pub capability Log
  op write(n: Int) -> Unit

find[T](xs: List[T], keep: fn(T) -> Bool) -> Option[T]
  uses of keep
=
  xs.first_where(keep)

pub leak(xs: List[Int], t: secret Int) -> Unit
  uses @log: Log[write]
=
  let found = find(xs, keep: fn(x) -> lg(x, t: t))
  unit

lg(x: Int, t: secret Int) -> secret Bool
  uses @log: Log[write]
=
  @log.write(x)
  x < t
