-- test: ADR 0067 adversarial check of #231, L32b_filter_threshold_elems: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l32b.una:6:55
module l32b

pub leak(xs: List[Int], t: secret Int) -> List[Int] = xs.filter(keep: fn(x) -> x < t)
