-- test: whether `e within d` times out depends on the timing of the code it reaches, a handler installed with a `secret` argument included (ADR 0117 IF2, ADR 0116 IF5 item 3), so the value of `if error use false` carries that label and cannot flow into a `public` result (U4001), and the operation inside, which accepts `public` data, runs under the timing floor (U4003)
-- spec: spec/27 §5
-- expect: error U4003 at src/guard.una:17:12
-- expect: error U4001 at src/guard.una:19:3
module guard

import std.time (millisecond)

capability Vault
  op check(code: Int) -> Bool

handler sealed(seed: secret Int) for Vault
  op check(code) = code == 0

pub gate(code: Int, seed: secret Int) -> public Bool
=
  let ok = @vault.check(code) with @vault = sealed(seed: seed) within 20 * millisecond
    if error use false
  ok
