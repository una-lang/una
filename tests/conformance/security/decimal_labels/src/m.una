-- test: a decimal carries labels as an Int does: every operation, the rounding mode included, joins its operands' labels, so a secret amount written to the console is U4003
-- spec: spec/29 §16
-- expect: error U4003 at src/m.una:10:18
module m

pub show(x: secret Decimal[2], y: Decimal[2]) -> Unit
  uses @console: Console[print]
=
  const z = (x * y).rescale(scale: 2, rounding: HalfEven) + y
  @console.print("{z}")
