-- test: the control of `clock_reading_drive_init`: a driven package whose `init`, `step` and `on_stop` handle only `public` data gives `public` readings of `Clock.now` (ADR 0116 amendment of 2026-11-09, C1 item 4), so `step` prints one
-- spec: spec/14 §3
-- expect: ok
module counter

import std.drive (Tick)

key() -> Int = 7

pub init() -> Int
=
  let k = key()
  0

pub step(edit count: Int, input: Tick) -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let now = @clock.now()
  @console.print("{now}")
  count = count + 1
