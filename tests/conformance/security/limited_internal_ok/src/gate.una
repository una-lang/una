-- test: a program that branches on whether `acquire` of `std.limit` failed and keeps what it decides at `internal`, or handles the failure in place with `if error use`, is accepted: `Limited` is `internal`, and nothing flows to a lower reader (S-46, spec/27 §10 rule 4)
-- spec: spec/27 §10
-- expect: ok
module gate

import std.limit (Limit, Limited, limiter)
import std.time (minute)

--- One for a token taken, zero for a call that found none, at the label of `Limited`.
taken(got: internal Result[Unit, internal Limited]) -> internal Int
=
  when got
    is Ok(took) -> 1
    is Err(failure) -> 0

--- How many of `n` calls took a token.
paced(n: Int) -> internal Int
  uses @gate: Limit[acquire]
=
  let edit done: internal Int = 0
  for i in 1..n
    let got = attempt @gate.acquire()
    done = done + taken(got)
  done

--- A call whose failure is handled where it happens: what follows does not depend on it.
once() -> Int
  uses @gate: Limit[acquire]
=
  @gate.acquire()
    if error use unit
  1

pub main() -> internal Int
  uses @console: Console[print]
=
  let count = paced(3) with @gate = limiter(at_most: 2, per: minute, waiting: 0)
  let one = once() with @gate = limiter(at_most: 1, per: minute, waiting: 0)
  @console.print("one: {one}")
  count
