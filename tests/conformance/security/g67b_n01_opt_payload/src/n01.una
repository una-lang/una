-- test: ADR 0067 recheck of #231, N01_opt_payload: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n01.una:11:8
-- expect: error U4001 at src/n01.una:12:19
module n01

pick[U](x: U, y: U, p: U, q: U) -> U = if x == y then p else q

pub leak(s: secret Int) -> Int
=
  when pick(Some(s), y: Some(0), p: Some(1), q: Some(2))
    is Some(v) -> v
    is None -> 0
