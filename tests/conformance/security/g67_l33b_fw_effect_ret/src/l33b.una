-- test: ADR 0067 adversarial check of #231, L33b_fw_effect_ret: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4002 at src/l33b.una:20:36
module l33b

pub capability Log
  op write(n: Int) -> Unit

noisy(x: Int) -> secret Bool
  uses @log: Log[write]
=
  @log.write(x)
  x < secret_threshold()

secret_threshold() -> secret Int = 3

pub leak(xs: List[Int]) -> secret Bool
  uses @log: Log[write]
=
  let found = xs.first_where(keep: noisy)
  found is Some
