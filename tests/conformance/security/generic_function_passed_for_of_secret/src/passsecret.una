-- test: through a generic function passed on for an `of` parameter, a secret element still never reaches a public result: the result of `count_where` is secret, the lambda's secret result does not fit the declared `Bool`, and a predicate over public `Int` does not take secret elements (spec/07 §7 rule 8, ADR 0062, #210)
-- spec: spec/07 §7
-- expect: error U4001 at src/passsecret.una:14:48
-- expect: error U4001 at src/passsecret.una:14:79
-- expect: error U4001 at src/passsecret.una:16:47
-- expect: error U4001 at src/passsecret.una:16:69
module passsecret

pub count_where[T](xs: List[T], keep: fn(T) -> Bool) -> Int = xs.filter(keep).len

positive(x: Int) -> Bool = x > 0

--- The lambda's result is secret, and `keep` declares a public `Bool`.
pub leak_lambda(xs: List[secret Int]) -> Int = count_where(xs, keep: fn(x) -> x > 0)

pub leak_named(xs: List[secret Int]) -> Int = count_where(xs, keep: positive)
