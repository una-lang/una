-- test: through a generic function passed on for an `of` parameter, a secret element still never reaches a public result: the lambda's secret result does not fit the declared `Bool`, and a predicate over public `Int` does not take secret elements; `count_where`'s result depends only on that public `Bool`, so its summary is empty (spec/07 §7 rule 8, ADR 0062, ADR 0067, #210, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/passsecret.una:12:79
-- expect: error U4001 at src/passsecret.una:14:69
module passsecret

pub count_where[T](xs: List[T], keep: fn(T) -> Bool) -> Int = xs.filter(keep).len

positive(x: Int) -> Bool = x > 0

--- The lambda's result is secret, and `keep` declares a public `Bool`.
pub leak_lambda(xs: List[secret Int]) -> Int = count_where(xs, keep: fn(x) -> x > 0)

pub leak_named(xs: List[secret Int]) -> Int = count_where(xs, keep: positive)
