-- test: ADR 0067 recheck of #231, N06f_for_choice: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n06f.una:11:11
module n06f

pick[U](xs: List[U], y: U, p: U, q: U) -> U
=
  let edit r = q
  for x in xs
    if x == y
      r = p
  r

pub leak(s: secret Int) -> Int = pick([[s]], y: [0], p: [], q: [1, 2]).len
