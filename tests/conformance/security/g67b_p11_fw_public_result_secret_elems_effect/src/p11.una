-- test: ADR 0067 recheck of #231, control P11_fw_public_result_secret_elems_effect: the same shapes with nothing secret decided, which edition 0.2 accepts (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: ok
module p11

pub capability Log
  op write(n: Int) -> Unit

lg(x: Int) -> Bool
  uses @log: Log[write]
=
  @log.write(0)
  true

pub fine(xs: List[Int]) -> Unit
  uses @log: Log[write]
=
  let r = xs.first_where(keep: lg)
  unit
