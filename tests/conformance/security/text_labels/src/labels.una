-- test: every result of a text function carries the join of every label of every argument, the top and every element of split's and chars' lists included, and a failure of parse_int is labeled like its result, each channel with a control (ADR 0070 X6)
-- spec: spec/22 §5
-- expect: error U4001 at src/labels.una:12:36
-- expect: error U4001 at src/labels.una:17:48
-- expect: error U4001 at src/labels.una:22:53
-- expect: error U4001 at src/labels.una:27:45
-- expect: error U4001 at src/labels.una:32:57
-- expect: error U4001 at src/labels.una:41:3
module labels

--- How many parts a secret splits into depends on its content.
pub parts(s: secret Text) -> Int = s.split(on: ",").len

pub parts_control(s: secret Text) -> secret Int = s.split(on: ",").len

--- So does every part.
pub first_part(s: secret Text) -> List[Text] = s.split(on: ",")

pub first_part_control(s: secret Text) -> secret List[secret Text] = s.split(on: ",")

--- A public text searched for a secret part.
pub found(t: Text, s: secret Text) -> Option[Int] = t.find(text: s)

pub found_control(t: Text, s: secret Text) -> secret Option[secret Int] = t.find(text: s)

--- The scalar values of a secret.
pub letters(s: secret Text) -> List[Text] = s.chars()

pub letters_control(s: secret Text) -> secret List[secret Text] = s.chars()

--- A secret separator decides the joined text.
pub joined(parts: List[Text], s: secret Text) -> Text = parts.join(separator: s)

pub joined_control(parts: List[Text], s: secret Text) -> secret Text = parts.join(separator: s)

--- Whether a secret parses is secret: handling the failure raises the program counter.
pub parsed(s: secret Text) -> Int
=
  let n = s.parse_int()
    if error use 0
  n

pub parsed_control(s: secret Text) -> secret Int
=
  let n = s.parse_int()
    if error use 0
  n
