-- test: a function value given to a boundary whose code is not known at the call, from a local, a parameter, a capture in a lambda, a computed value or a kind field, is U3024 while any policy exists; a named function, a lambda and a function value given to a call before the crossing are accepted (ADR 0093 rule 8)
-- spec: spec/07 §6
-- expect: error U3024 at src/media/app.una:22:3
-- expect: error U3024 at src/media/app.una:24:64
-- expect: error U3024 at src/media/app.una:29:3
-- expect: error U3024 at src/media/app.una:31:51
-- expect: error U3024 at src/media/app.una:39:36
module media.app

import media.release (reveal)
import media.render (Box, apply, open_box, plain)

through(n: secret Int) -> Int = reveal(n)

double(n: secret Int) -> Int = 2

local_apply(n: secret Int, f: fn(secret Int) -> Int) -> Int = f(n)

pub by_local(n: secret Int) -> Int
=
  let g = through
  apply(n, f: g)

pub by_param(n: secret Int, g: fn(secret Int) -> Int) -> Int = apply(n, f: g)

pub by_capture(n: secret Int) -> Int
=
  let g = double
  apply(n, f: fn(m) -> g(m))

pub by_choice(n: secret Int, fast: Bool) -> Int = apply(n, f: if fast then double else through)

pub named(n: secret Int) -> Int = apply(n, f: double)

pub lambda(n: secret Int) -> Int = apply(n, f: fn(m) -> 1)

pub eager(n: secret Int) -> Int = plain(local_apply(n, f: through))

pub by_box(n: secret Int) -> Int = open_box(n, b: Box(run: through))
