-- test: an operation argument flows into the operation's parameter type at every site of an operation call: a handler operation body, a function run under `with`, an operation on a handler installed by `with`, and a `do` line under `given` (ADR 0050)
-- spec: spec/07 §7
-- expect: error U4001 at 22:31
-- expect: error U4001 at 27:17
-- expect: error U4001 at 35:17
-- expect: error U4001 at 39:20
module op_argument_sites

capability Keeper
  op apply(f: fn(secret Int) -> Int) -> Int

capability Relay
  op relay(f: fn(Int) -> Int) -> Int

ident(x: Int) -> Int = x

handler holding(pin: secret Int) for Keeper
  op apply(f) = f(pin)

handler relaying() for Relay
  uses @keeper: Keeper[apply]
  op relay(f) = @keeper.apply(f)

pub run_apply() -> Int
  uses @keeper: Keeper[apply]
=
  @keeper.apply(ident)

pub under_with(pin: secret Int) -> Int
=
  run_apply() with @keeper = holding(pin)

pub direct(pin: secret Int) -> Int
=
  @keeper.apply(ident) with @keeper = holding(pin)

example "an operation called on a handler given to the example"
  given @keeper = holding(pin: 1)
  do @keeper.apply(ident)
  expect result == 1
