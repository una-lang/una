-- test: a generic body returns values whose type holds its type parameter in a function parameter or an invariant kind argument, positive twin (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 27:3
module sweep_variance_generic_body

kind Sink[T]
  eat: fn(T) -> Int

kind Box[T]
  value: T

mk[T](f: fn(T) -> Int) -> Sink[T] = Sink(eat: f)

mk2[T](f: fn(T) -> Int) -> fn(T) -> Int = f

mk3[T](s: Sink[T]) -> Sink[T] = s

mk4[T](x: T) -> Box[T] = Box(value: x)

mk5[T](f: fn(T) -> Int) -> List[fn(T) -> Int] = [f]

leaky[T, U](f: fn(T) -> Int, u: U) -> Sink[T] = Sink(eat: f)

pub raised(pin: secret Int) -> Int
=
  let s = leaky(fn(x: Int) -> x, u: pin)
  s.eat(pin)

pub raised_twin(pin: secret Int) -> secret Int
=
  let s = leaky(fn(x: Int) -> x, u: pin)
  s.eat(1)
