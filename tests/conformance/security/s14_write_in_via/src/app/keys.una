trusted module app.keys

pub policy reveal
  from internal Text
  to Text
  via written
  purpose "a policy whose via body writes a file under a condition on its argument"
  owner tests

written(t: internal Text) -> Text
  uses @files: Files[write]
=
  let written = if t == "a"
    let w = attempt @files.write("marker.txt", content: "")
    unit
  else
    unit
  "done"
