-- test: a policy call runs its `via` function (#1673): the `via` makes a request on a grant with limits, and the policy is called in a construct beside work on a `secret`; the policy call's edge to the `via` makes `both`, whose body reads the `secret`, an ancestor of the request (`L_lim`, ADR 0116 P10) and puts the request beside that work (`τ_conc`, `spec/27 §11`), above the `internal` that `L_lim` allows (U4001 at the request); the race's timing floor, `secret`, is also above what the policy's effects accept (U4002 at the call)
-- spec: spec/07 §5
-- expect: error U4001 at src/release.una:14:23
-- expect: error U4002 at src/main.una:26:5
module main

import release (key_of)

crunch(key: secret Int) -> secret Int
=
  let edit acc = key
  for i in 0..1000
    acc = if acc > 0 then acc - 1 else acc + 1
  acc

spin(key: secret Int, n: Int) -> Int
=
  let spent = crunch(key)
  n

--- The policy is called in a branch of `first of`, beside a branch that works on `key`.
pub both(key: secret Int, n: Int) -> secret Int
  uses @http: Http[get]
=
  first of
    key_of(n)
    spin(key, n: n)
