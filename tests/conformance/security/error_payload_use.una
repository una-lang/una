-- test: secret failure payload recovered through `attempt` and returned as public (review control)
-- spec: spec/07 §7
-- expect: error U4001 at 20:26
module error_payload_use

kind PinError = | Bad(value: secret Int)

inner(pin: secret Int) -> Int
  fails PinError
=
  fail Bad(value: pin)

pub outer_leak(pin: secret Int) -> Int
=
  let r = attempt inner(pin)
  when r
    is Ok(value) -> value
    is Err(failure) ->
      when failure
        is Bad(value) -> value
