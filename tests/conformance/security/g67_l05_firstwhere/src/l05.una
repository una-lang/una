-- test: ADR 0067 adversarial check of #231, L05_firstwhere: a secret reaches a public result only through the labels of a generic call's result, and is rejected in edition 0.2 as main rejects it (spec/07 §7 rule 8, #92)
-- spec: spec/07 §7
-- expect: error U4001 at src/l05.una:8:35
module l05

has[T](xs: List[T], p: T) -> Bool = xs.first_where(keep: fn(x) -> x == p) is Some

pub leak(s: secret Int) -> Bool = has([1, 2, 3], p: s)
