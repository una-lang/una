-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): leak (U4002 expected): run form; a decision on T values decides whether a callback fails, through a user generic function; the write after it is skipped
-- spec: spec/07 §7
-- expect: error U4002 at src/sw.una:28:11
-- expect: error U4001 at src/sw.una:28:47
-- expect: error U4002 at src/sw.una:29:5
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

kind Bad = | Oops

apply_f[U](x: U, f: fn(U) -> Int fails Bad) -> Int
  fails Bad
=
  let r = f(x)
    if error pass
  r

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int fails Bad) -> Int
  uses @log: Log[write]
  fails Bad
=
  let n = apply_f(if a == b then p else q, f: k)
    if error pass
  @log.write(1)
  2

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

check_len(xs: List[internal Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  let r = g([v], b: [0], p: [], q: [1], k: check_len)
    if error use 3
  @log.write(5)
