-- test: a function value given data decided by values of a type parameter, through the prelude or a generic function (#346, #350, Una-2's matrix): rule: an effectful function in a record field (U3006/U3016)
-- spec: spec/07 §7
-- expect: error U3006 at src/sw.una:10:8
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind EffBox[T]
  run: fn(T) -> Unit uses @log: Log[write]
