-- test: a policy call's failure is visible only where its release is: with an `internal` `to`, a public branch on it, or passing it on publicly, reveals what the `via` decided (S-18) (edition 0.1)
-- spec: spec/07 §5
-- expect: error U4003 at src/main.una:15:17
-- expect: error U4003 at src/main.una:16:18
-- expect: error U4002 at src/main.una:22:5
module main

import release (Gate, checkpin)

pub probe(n: internal Int) -> Unit
  uses @console: Console[print]
=
  let r = attempt checkpin(n)
  when r
    is Ok(v) -> @console.print("passed")
    is Err(e) -> @console.print("failed")

pub passes(n: internal Int) -> Unit
  fails Gate
=
  let v = checkpin(n)
    if error pass
  unit
