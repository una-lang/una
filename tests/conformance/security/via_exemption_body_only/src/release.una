trusted module release

--- A `via` body is not checked for labels: editable bindings, maps and loops included.
pub policy band
  from secret[Pin] Int
  to public Int
  via banded
  purpose "a coarse band of the value"
  owner review

banded(s: secret[Pin] Int) -> public Int
=
  let edit n = 0
  if s > 100
    n = 1
  let edit m: Map[Int, Int] = empty_map()
  edit m.set(key: s, value: 1)
  let edit xs: List[Int] = []
  for i in 0..<s
    xs = xs.append(item: i)
  n + m.len + digits(xs.len, limit: s)

--- Not a `via`: checked as any function, although its module is trusted.
digits(n: Int, limit: secret[Pin] Int) -> Int
=
  let edit d = 0
  if limit > 9
    d = n
  d

--- Not a `via` either: the same constructs are checked here.
pub tally(s: secret[Pin] Int) -> Int
=
  let edit n = 0
  if s > 100
    n = 1
  let edit m: Map[Int, Int] = empty_map()
  edit m.set(key: s, value: 1)
  n + m.len

--- A `via` may return a pure function: its body is the policy's code, part of the TCB.
pub policy offset
  from secret[Pin] Int
  to public fn(Int) -> Int
  via offset_by
  purpose "add the value to what the caller gives"
  owner review

offset_by(s: secret[Pin] Int) -> public fn(Int) -> Int = fn(x) -> x + s
