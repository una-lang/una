-- test: the negative twin of `via_result_value_call` (#1710): the `via` performs an operation whose handler, installed by the policy's caller, calls a function value made outside the code the `via` reaches, so a call of a function value there may run any lambda, and the `within` that `tally`'s lambda runs, beside the tasks of `pair`, is refused (U4001 at the `within`, spec/07 §5 rule 7)
-- spec: spec/07 §5
-- expect: error U4001 at src/main.una:11:27
module main

import release (Tool, key_of, with_fn)
import std.time (millisecond)

timed(t: Int) -> restricted Int
=
  let v: restricted Int = t within 1 * millisecond
    if error use 0
  v

pub tally(n: Int) -> List[restricted Int] = [n].map(each: fn(x: Int) -> timed(x))

pub pair(a: Int, b: Int) -> Int
=
  together
    let x = a + 1
    let y = b + 1
  x + y

--- The policy is called from sequential code, under a handler whose function value is a lambda of this module.
pub once(n: internal Int) -> Int
=
  key_of(n) with @tool = with_fn(f: fn(x: internal Int) -> x + 1)
