trusted module release

pub capability Tool
  op run(x: internal Int) -> internal Int

--- A handler whose parameter holds a function value, made by whoever installs it.
pub handler with_fn(f: fn(internal Int) -> internal Int) for Tool
  op run(x) = f(x)

pub policy key_of
  from internal Int
  to Int
  via reveal_it
  purpose "a test"
  owner privacy

--- The `via` function performs an operation whose handler calls a function value made outside it.
reveal_it(t: internal Int) -> Int
  uses @tool: Tool[run]
=
  @tool.run(t)
