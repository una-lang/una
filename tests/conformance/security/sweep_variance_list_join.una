-- test: `List` is covariant at a branch join (label sweep)
-- spec: spec/07 §7
-- expect: error U4001 at 15:3
module sweep_variance_list_join

kind Box[T]
  value: T

kind Sink[T]
  eat: fn(T) -> Int

pub join_0(c: Bool, v: List[secret Int], w: List[Int]) -> List[Int]
=
  let j = if c then w else v
  j

pub join_1(c: Bool, v: List[Int], w: List[secret Int]) -> List[secret Int]
=
  let j = if c then w else v
  j
