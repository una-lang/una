-- test: ADR 0067 recheck of #231, P08_secret_chosen_fn: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U3006 at src/p08.una:27:26
-- expect: error U3006 at src/p08.una:27:33
-- expect: error U4001 at src/p08.una:28:36
-- expect: error U4002 at src/p08.una:28:36
module p08

pub capability Log
  op write(n: Int) -> Unit

a(x: Int) -> Bool
  uses @log: Log[write]
=
  @log.write(x)
  x > 1

b(x: Int) -> Bool
  uses @log: Log[write]
=
  @log.write(x)
  x > 2

pub leak(xs: List[Int], s: secret Int) -> Unit
  uses @log: Log[write]
=
  let p = if s == 0 then a else b
  let found = xs.first_where(keep: p)
  unit
