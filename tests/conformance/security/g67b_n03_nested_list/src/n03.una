-- test: ADR 0067 recheck of #231, N03_nested_list: a decision on values of a type parameter reaches a public result or an effect, through a returned value, a function value or an `of` parameter, and is rejected (spec/07 §7 rule 8, #92, #234)
-- spec: spec/07 §7
-- expect: error U4001 at src/n03.una:8:34
module n03

pick[U](x: U, y: U, p: U, q: U) -> U = if x == y then p else q

pub leak(s: secret Int) -> Int = pick([[s]], y: [[0]], p: [[1]], q: [[2], [3]]).len
