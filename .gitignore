/target/
.una/
.DS_Store

# Python bytecode
__pycache__/

# libFuzzer's work directories, should a fuzz target run from fuzz/ (#766)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Not in the public tree (#2052, #2049): the maintainers keep these locally. The public tree holds
# the compiler's sources, the specification, the guides, the examples and what builds `una`.
/.claude/
/CLAUDE.md
/.mcp.json
/.github/ISSUE_TEMPLATE/work-item.md
/.github/workflows/release.yml
/docs/history/
/docs/plan/
/docs/fixes/
/docs/releases/
/docs/adr/
/docs/reviews/
/tests/
/crates/*/tests/
/crates/una-test-cases/
# The scripts, but the two that build the Z3 library that `una` links (README, "Build from source").
/scripts/*
!/scripts/z3-library.sh
!/scripts/build-z3.sh

# The test runner configuration belongs with the tests, which are not in the public tree.
/.config/
