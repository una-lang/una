/target/
# A cargo target directory under another name, as a builder's CARGO_TARGET_DIR may be (#2369):
# untracked, it would make scripts/gate-tier.sh walk every file of the build.
/target-*/
.una/
.DS_Store

# Python bytecode
__pycache__/

# libFuzzer's work directories, should a fuzz target run from fuzz/ (#766)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Not in the public tree (#2052, #2049): the maintainers keep these locally. The public tree holds
# the compiler's sources and tests, the specification, the guides, the decision records, the plan, the
# review records, the examples, and the scripts that build, validate and release `una`.
/.claude/
/CLAUDE.md
/.mcp.json
/.github/ISSUE_TEMPLATE/work-item.md
/.github/workflows/release.yml
/docs/history/
/docs/fixes/
/docs/releases/
