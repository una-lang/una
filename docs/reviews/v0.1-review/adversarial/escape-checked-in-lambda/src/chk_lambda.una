-- Adversarial: `checked` hidden in a lambda passed to a private function, with budget 0.
-- Expected: U7003 (spec/06 §6). Observed: U7003. Held (also in a handler op and a private helper).
module chk_lambda

pub kind Bad = | Nope

pub f(xs: List[Int]) -> List[Int] = xs.map(each: fn(x) -> x + 1)

priv_apply(g: fn(Int) -> Int fails Bad) -> Int
  fails Bad
=
  let v = g(3)
    if error pass
  v

pub h() -> Int
  fails Bad
=
  let v = priv_apply(fn(x) -> checked(x, it > 0) else fail Nope)
    if error pass
  v
