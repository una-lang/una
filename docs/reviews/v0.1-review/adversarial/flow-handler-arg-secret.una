-- Adversarial: secret handler argument into a public handler parameter
-- Expected: U4001
-- Observed: U4001 at 20:35
-- Verdict: Pass
module flow_handler_arg_secret

capability Store
  op count() -> Int

handler rows(n: Int) for Store
  op count() = n

counted() -> Int
  uses @store: Store[count]
=
  @store.count()

pub run(pin: secret Int) -> Int
=
  counted() with @store = rows(n: pin)
