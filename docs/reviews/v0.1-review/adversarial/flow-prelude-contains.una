-- Adversarial: prelude 'contains' over a secret list returns a public Bool; runtime demo leaks an env var
-- Expected: U4001 (spec/07 §7.1, spec/14 §1, T6)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module flow_prelude_contains

pub leak(pin: secret Int) -> Bool = [pin].contains(item: 1234)

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  let guess = [pin].contains(item: "1234")
  @console.print("pin is 1234: {guess}")
