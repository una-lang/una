-- Adversarial: `let v = g(x) if error use 0` where `g` returns `Pos`; the binder must not be
-- typed `Pos`.
-- Expected: U5001 at `100 / v`. Observed: U5001. Held (also tried `if`, `when`, `if none`, `attempt`).
module lettype_iferr

pub kind Pos = Int where it > 0

pub kind Oops = | Bad

g(x: Int) -> Pos
  fails Oops
=
  if x > 0 then x else fail Bad

pub f(x: Int) -> Int
=
  let v = g(x)
    if error use 0
  100 / v
