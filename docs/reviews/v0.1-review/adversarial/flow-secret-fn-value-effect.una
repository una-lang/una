-- Adversarial: effectful function chosen by an internal branch (via the generic escape), then called; runtime prints yes/no by PIN
-- Expected: U3006 and U4002 (spec/05 §6, spec/07 §3.4)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module flow_secret_fn_value_effect

id[T](x: T) -> T = x

say_yes(line: Text) -> Unit
  uses @console: Console[print]
=
  @console.print("yes")

say_no(line: Text) -> Unit
  uses @console: Console[print]
=
  @console.print("no")

pub call(f: secret fn(Text) -> Unit uses @console: Console[print]) -> Unit
  uses @console: Console[print]
=
  f("x")

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  let f = if pin == "1234" then id(say_yes) else id(say_no)
  f("x")
