-- Adversarial: a policy whose `to` type is refined (`public Pos`) and whose `via` function
-- returns the unrefined base type (`public Int`). The verifier assumes the `to` refinement for
-- every policy result (Rhs::Declassify, assume_refinements) but nothing proves it: the `via`
-- result is checked only for its base type (spec/07 §7 rule 5).
-- Expected: error U5001 (refinement `it > 0` of the policy result, or U4005 for a `to` type whose
-- refinement the `via` result does not carry); spec/03 §6, spec/10 §10 T5, spec/07 §6
-- ("all other code in a trusted module is checked normally").
-- Observed: `una check` accepted (exit 0); `una run` aborts with U8001 `div` by zero (exit 3).
module app

import release (Pos, lower)

recip(p: Pos) -> Int = 100 / p

pub main() -> Unit
  uses @console: Console[print]
=
  let p = lower(0)
  let q = recip(p)
  @console.print("q = {q}")
