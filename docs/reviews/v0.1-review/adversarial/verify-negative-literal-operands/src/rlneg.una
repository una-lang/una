module rlneg

pub good() -> Int
  ensures result == -7 / 2
=
  -4

pub bad() -> Int
  ensures result == -7 / 2
=
  -3

pub good_mod() -> Int
  ensures result == -7 mod -2
=
  1

pub good_div() -> Int
  ensures result == -7 / -2
=
  4

pub neg_x(x: Int) -> Int
  ensures result == -x / 2
=
  (0 - x) / 2
