-- Adversarial: effectful function stored with 'Some(note)'
-- Expected: U3006
-- Observed: U3006 at 19:8
-- Verdict: Pass
module auth_lambda_in_option

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

pub make() -> Option[fn(Text) -> Unit uses @log: Log[write]]
  uses @log: Log[write]
=
  Some(note)
