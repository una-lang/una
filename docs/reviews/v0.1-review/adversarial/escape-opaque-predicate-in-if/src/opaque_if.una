-- Adversarial: code calls an opaque predicate in an `if` condition; the branch hypothesis
-- `valid_slug(raw)` gives `raw` the `Slug` refinement without `checked`, so the escape budget
-- (0 here) and the report's escape list are bypassed. The guide's own `parse_slug` needs
-- `checked_per_module = 1`.
-- Expected: per spec/03 §4 and spec/06 §6 an opaque fact is obtained only by `checked` (counted,
-- U7003 beyond budget) or an operation `ensures`; either U7003 or U5001 on the return.
-- Observed: accepted (exit 0); `una --json report` shows `escapes.checked: []`. Runtime is sound
-- (the body runs), so this is an accounting bypass, not a false proof.
module opaque_if

pub kind Slug = Text where valid_slug(it)

pub kind SlugError = | Malformed

pub predicate opaque valid_slug(t: Text) -> Bool = t.len >= 3 and not starts_with(t, prefix: "-")

pub parse_slug(raw: Text) -> Slug
  fails SlugError
=
  if valid_slug(raw) then raw else fail Malformed

example "a slug with a leading dash is rejected"
  do parse_slug("-x")
  expect fails Malformed
