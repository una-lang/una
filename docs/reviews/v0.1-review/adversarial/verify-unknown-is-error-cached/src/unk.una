-- Adversarial: `step_budget = 1` makes every query unknown; run `una check` twice (the second
-- from the cache), then `una run` and `una test`.
-- Expected: U5002 every time, and no run (ADR 0008, spec/12 §6).
-- Observed: U5002 x3 on both runs (cached), `run` and `test` exit 1. Held. `--solver-wallclock 0`
-- gives U5002 (wallclock) and is not cached.
module unk

recip(x: Int) -> Int
  requires x > 0
=
  100 / x

pub main() -> Unit
  uses @console: Console[print]
=
  let q = recip(0 - 0)
  @console.print("q = {q}")

example "zero"
  do recip(0)
  expect result == 1
