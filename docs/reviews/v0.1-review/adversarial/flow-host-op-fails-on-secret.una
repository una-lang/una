-- Adversarial: 'Keys.hmac' with a secret 'key_name'; its public failure 'UnknownKey' reveals the key name
-- Expected: spec gap: T-Op has no pc/label rule for failing ops
-- Observed: accepted (exit 0)
-- Verdict: MAJOR (spec, needs ADR)
module flow_host_op_fails_on_secret

pub probe(name: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: name, data: "x")
    if error pass
