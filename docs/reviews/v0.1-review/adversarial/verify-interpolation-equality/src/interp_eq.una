-- Adversarial: interpolated texts must not be encoded as distinct literal constants.
-- Expected: all three ensures refuted. Observed: U5001 on each. Held.
module interp_eq

pub same(x: Int, y: Int) -> Bool
  ensures result == false
=
  "{x}" == "{y}"

pub lit(x: Int) -> Bool
  ensures result == false
=
  "n{x}" == "n1"

pub lens(x: Int) -> Int
  ensures result == 4
=
  "n{x}".len
