-- Adversarial: List[fn(Text) -> Unit uses @log: Log[write]] passed where List[fn(Text) -> Unit] is expected: uses dropped by subtyping under List (no generic needed)
-- Expected: U3003 (S-Fun, spec/05 §9.7, spec/07 §7.2 covariance)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module auth_uses_dropped_in_list

capability Log
  op write(line: Text) -> Unit

pure_fire(fs: List[fn(Text) -> Unit]) -> Int = fs.map(each: fn(f) -> f("hello")).len

impure(fs: List[fn(Text) -> Unit uses @log: Log[write]]) -> Int
  uses @log: Log[write]
=
  pure_fire(fs)
