-- Adversarial: two sequential `when` bind `v`; the first `v` is known to be 5.
-- Expected: U5001 at `100 / v`. Observed: U5001, counterexample o2.value = 0. Held.
module shadow3

pub f(o2: Option[Int]) -> Int
=
  let o1 = Some(5)
  let a = when o1
    is Some(v) -> v
    is None -> 1
  let b = when o2
    is Some(v) -> 100 / v
    is None -> 0
  a + b
