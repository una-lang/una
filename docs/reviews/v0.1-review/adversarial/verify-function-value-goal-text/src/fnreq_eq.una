-- Adversarial: a function with `requires x == y` passed as a value to a higher-order function
-- that calls it with (0, 1); the body divides by `x - y + 1`.
-- Expected: rejected (spec/10 §2 S-Fun), with a goal that names the parameters.
-- Observed: rejected, sound: U5001 at `apply(same)`, but the goal prints `same == same` (the function
-- name substituted for both parameters), which reads as a tautology the solver refuted.
module fnreq_eq

same(x: Int, y: Int) -> Int
  requires x == y
=
  100 / (x - y + 1)

apply(g: fn(Int, Int) -> Int) -> Int = g(0, 1)

pub main() -> Unit
  uses @console: Console[print]
=
  let n = apply(same)
  @console.print("n = {n}")
