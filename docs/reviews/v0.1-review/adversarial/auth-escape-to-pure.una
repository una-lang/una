-- Adversarial: laundered effectful function flows into 'Box[fn(Text) -> Unit]' and 'List[fn(Text) -> Unit]'; pub functions with no 'uses' perform Console effects
-- Expected: U3006, U3003 (spec/05 §6, spec/04 §2.4, T2, T4)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module auth_escape_to_pure

capability Log
  op write(line: Text) -> Unit

kind Box[T]
  value: T

id[T](x: T) -> T = x

handler loud() for Log
  uses @console: Console[print]
  op write(line) = @console.print("loud: {line}")

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

grab() -> Box[fn(Text) -> Unit uses @log: Log[write]]
  uses @log: Log[write]
=
  Box(value: id(note))

pub pure_fire(b: Box[fn(Text) -> Unit]) -> Unit = b.value("hello")

pub pure_map(fs: List[fn(Text) -> Unit]) -> Int = fs.map(each: fn(f) -> f("hello")).len

pub main() -> Unit
  uses @console: Console[print]
=
  let b = grab() with @log = loud()
  pure_fire(b)
  let n = pure_map([b.value])
  unit
