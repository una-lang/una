-- Adversarial: call of a 'secret'-labeled function value whose effect accepts only public
-- Expected: U4002/U4003 (spec/07 §3.4, §7.3)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module flow_secret_fn_param_call

pub call(f: secret fn(Text) -> Unit uses @console: Console[print]) -> Unit
  uses @console: Console[print]
=
  f("x")
