-- Adversarial: handler fails depending on its secret-raised parameter
-- Expected: U4002
-- Observed: U4002 at 15:42
-- Verdict: Pass
module flow_handler_fail_pc

kind VaultError = | Refused

capability Vault
  op note(flag: Bool) -> Unit
    fails VaultError
    accepts secret

handler picky() for Vault
  op note(flag) = if flag then unit else fail Refused
