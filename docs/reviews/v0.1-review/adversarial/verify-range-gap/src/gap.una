-- Adversarial: range arms `in 0..5` and `in 7..10` over `Int in 0..10` miss 6.
-- Expected: U5001 exhaustive (spec/12 §3). Observed: U5001, counterexample n = 6. Held.
module gap

pub kind Level = Low | High

pub classify(n: Int in 0..10) -> Level
=
  when n
    in 0..5 -> Low
    in 7..10 -> High
