-- Adversarial: `std.testing.fake_hash` is referenced in a handler operation body (allowed by
-- spec/14 §4) and returned as a function value; production code installs the handler with
-- `with` in `main` and mints `Hashed` values without `Keys`.
-- Expected: spec/03 §1 says `Hashed` is only produced by host capabilities, and spec/14 §4
-- limits `std.testing` to test code; U3015 somewhere on this path.
-- Observed: accepted (exit 0) and `una run` succeeds (exit 0).
module ex_testing3

import std.testing (fake_hash)

pub capability Maker
  op get() -> fn(Int) -> internal Hashed

pub handler leak() for Maker
  op get() = fake_hash

pub digest(seed: Int) -> internal Hashed
  uses @maker: Maker[get]
=
  let make = @maker.get()
  make(seed)

pub main() -> Unit
  uses @console: Console[print]
=
  let d = digest(7) with @maker = leak()
  @console.print("made a digest")
