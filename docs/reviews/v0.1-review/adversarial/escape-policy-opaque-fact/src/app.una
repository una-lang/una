-- Adversarial: a policy whose `to` type carries an opaque predicate (`Slug`) establishes the
-- opaque fact for any text with no `checked`, no escape budget and no entry in the report's
-- escapes (same root cause as verify-policy-to-refinement).
-- Expected: rejected (U5001 on the policy result, or U4005), or at least counted as an escape
-- (spec/03 §4: opaque facts come from `checked` or an operation `ensures`; spec/06 §6).
-- Observed: accepted (exit 0); `una --json report` lists `escapes.checked: []`.
module app

import release (Slug, as_slug)

pub publish(raw: internal Text) -> Slug = as_slug(raw)

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("ok")
