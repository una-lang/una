-- Adversarial: second effect inside an 'if none use' clause
-- Expected: U3013
-- Observed: U3013 at 19:17
-- Verdict: Pass
module auth_two_effects_handling_clause

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

pub run() -> Int
  uses @store: Store[find, count]
=
  let v = @store.find(1)
    if error use None
    if none use @store.count()
  v
