-- Adversarial: `if error use 0` after a callee that ensures `result > 0`; the recovered value
-- must not inherit the callee's `ensures`.
-- Expected: U5001 postcondition (spec/06 §3, spec/12 §3). Observed: U5001, result = 0. Held.
module ens_iferror

pub kind Oops = | Bad

g(x: Int) -> Int
  ensures result > 0
  fails Oops
=
  if x > 5 then fail Bad else 1

pub f(x: Int) -> Int
  ensures result > 0
=
  let v = g(x)
    if error use 0
  v
