-- Adversarial: text literal lengths and distinctness with escapes (`\"`, `\u{...}`, `\{`).
-- Expected: `a`, `b` and `distinct` refuted (true lengths 3 and 4; the literals are equal).
-- Observed: exactly those three U5001. Held.
module textlen

pub a() -> Int
  ensures result == 4
=
  "q\"t".len

pub b() -> Int
  ensures result == 6
=
  "\u{1F44D}\n\t\\".len

pub c() -> Int
  ensures result == 2
=
  "\{\}".len

pub distinct() -> Bool
  ensures result == false
=
  "\u{41}" == "A"

pub main() -> Unit
  uses @console: Console[print]
=
  let x = a()
  let y = b()
  let z = c()
  let d = distinct()
  @console.print("{x} {y} {z} {d}")
