-- Adversarial: effect inside a 'with' handler argument
-- Expected: U3013
-- Observed: U3013 at 26:35
-- Verdict: Pass
module auth_effect_in_with_arg

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

handler rows(n: Int) for Store
  op find(key) = None
  op count() = n

counted() -> Int
  uses @store: Store[count]
=
  @store.count()

pub run() -> Int
  uses @outer: Store[count]
=
  counted() with @store = rows(n: @outer.count())
