-- Adversarial: opaque predicate calls a helper with inferred effects
-- Expected: U2015
-- Observed: U3001 at 14:20; U2015 at 16:44
-- Verdict: Pass
module auth_effect_in_opaque_predicate

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

counter() -> Int = @store.count()

predicate opaque big(n: Int) -> Bool = n > counter()
