-- Adversarial: effect in an 'if' condition
-- Expected: U3013
-- Observed: U3013 at 17:6
-- Verdict: Pass
module auth_effect_in_if_condition

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

pub run() -> Int
  uses @store: Store[count]
=
  if @store.count() > 0
    1
  else
    0
