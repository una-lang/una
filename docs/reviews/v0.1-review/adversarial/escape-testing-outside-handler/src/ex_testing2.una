-- Adversarial: `fake_hash` stored in a record field in an ordinary function.
-- Expected: U3015 (spec/14 §4). Observed: U3015. Held.
module ex_testing2

import std.testing (fake_hash)

pub kind Box
  make: fn(Int) -> internal Hashed

pub capability Keys2
  op mk(seed: Int) -> internal Hashed

pub handler fake() for Keys2
  op mk(seed) = fake_hash(seed)

pub h(seed: Int) -> internal Hashed
=
  let b = Box(make: fake_hash)
  b.make(seed)
