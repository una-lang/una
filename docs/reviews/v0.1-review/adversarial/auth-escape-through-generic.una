-- Adversarial: 'Box(value: id(note))': effectful function laundered through a generic identity, stored, returned, and called after its 'with' handler scope ended; runtime runs the 'loud' handler although 'fire' was given 'quiet'
-- Expected: U3006 (spec/05 §4.3, §6, §9.6)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module auth_escape_through_generic

capability Log
  op write(line: Text) -> Unit

kind Box[T]
  value: T

id[T](x: T) -> T = x

handler loud() for Log
  uses @console: Console[print]
  op write(line) = @console.print("loud: {line}")

handler quiet() for Log
  op write(line) = unit

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

make() -> Box[fn(Text) -> Unit uses @log: Log[write]]
  uses @log: Log[write]
=
  Box(value: id(note))

fire(b: Box[fn(Text) -> Unit uses @log: Log[write]]) -> Unit
  uses @log: Log[write]
=
  b.value("hello")

pub main() -> Unit
  uses @console: Console[print]
=
  let b = make() with @log = loud()
  fire(b) with @log = quiet()
