-- Adversarial: two effects in one 'if' line
-- Expected: U3013 (ADR 0009)
-- Observed: U3013 at 17:13; U3013 at 17:33
-- Verdict: Pass
module auth_two_effects_if_line

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

pub run(c: Bool) -> Int
  uses @store: Store[count]
=
  if c then @store.count() else @store.count()
