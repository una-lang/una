-- Adversarial: the module declares its own `Clock` with `ensures result == 0` and `main` uses
-- it, hoping `una run --grant clock` binds the host clock to the stronger contract.
-- Expected: U3012 at run. Observed: `una check` exit 0, `una run` U3012 (exit 1). Held.
module hostshadow

pub capability Clock
  op now() -> Int
    ensures result == 0

pub main() -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  let t = @clock.now()
  let q = 100 / (t + 1)
  @console.print("q = {q}")
