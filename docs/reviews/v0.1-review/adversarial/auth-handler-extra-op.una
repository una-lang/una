-- Adversarial: handler implements an op the capability lacks
-- Expected: U3010
-- Observed: U3010 at 17:6
-- Verdict: Pass
module auth_handler_extra_op

kind StoreError = | Timeout

capability Store
  op find(key: Int) -> Option[Int]
    fails StoreError
  op count() -> Int

handler extra() for Store
  op find(key) = None
  op count() = 0
  op wipe() = unit
