-- Adversarial: `fn(Int) -> Pos` called on a lambda that returns 0. Core erases refinements in
-- function types (`fn(Int) -> Int`), so nothing is assumed. See the proposed ADR 0037 on dev.
-- Expected: rejected. Observed: U5001 at both divisions. Held (the written `Pos` is silently ignored).
module fnres

pub kind Pos = Int where it > 0

pub kind Box
  run: fn(Int) -> Pos

apply(g: fn(Int) -> Pos) -> Int
=
  let v = g(0)
  100 / v

apply_box(b: Box) -> Int
=
  let v = b.run(0)
  100 / v

pub main() -> Unit
  uses @console: Console[print]
=
  let q = apply(fn(x) -> 0)
  let r = apply_box(Box(run: fn(x) -> 0))
  @console.print("q = {q} {r}")
