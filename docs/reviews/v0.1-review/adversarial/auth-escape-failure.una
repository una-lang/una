-- Adversarial: failing function laundered into a non-failing 'fn(Int) -> Int'; 'main' without 'fails' fails with 'Exploded'
-- Expected: U3006, U3009 (spec/05 §9.7, spec/06, T3)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module auth_escape_failure

kind Boom = | Exploded

kind Box[T]
  value: T

id[T](x: T) -> T = x

explode(n: Int) -> Int
  fails Boom
=
  fail Exploded

pub total(b: Box[fn(Int) -> Int]) -> Int = b.value(1) + 1

pub main() -> Unit
  uses @console: Console[print]
=
  let n = total(Box(value: id(explode)))
  @console.print("total is {n}")
