-- Adversarial: print under an internal Hashed comparison
-- Expected: U4003
-- Observed: U4003 at 11:5
-- Verdict: Pass (message says 'a \'internal\'', Minor)
module flow_hashed_compare_print

pub show(a: internal Hashed, b: Hashed) -> Unit
  uses @console: Console[print]
=
  if a == b
    @console.print("same")
  else
    unit
