-- Adversarial: module `aaa`, which nothing imports, declares its own `capability Files` whose
-- `read` ensures `result.len > 0`. `app.main` uses the host `Files` (spec/14 §3), which has no
-- `ensures`. The verifier indexes capability contracts by bare name (`Index.capabilities`, first
-- declaration wins), so it assumes aaa's `ensures` for the host operation and proves
-- `100 / text.len`.
-- Expected: error U5001 at the division `100 / text.len` (spec/12 §3, spec/05 §2: host ops carry only their
-- own contract).
-- Observed: `una check` accepted (exit 0); `una run` on the empty file aborts with U8001 (exit 3).
module app

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
=
  let text = @files.read("empty.txt")
    if error use "fallback"
  let per_char = 100 / text.len
  @console.print("computed a ratio")
