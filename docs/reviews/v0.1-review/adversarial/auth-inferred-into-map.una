-- Adversarial: private helper with inferred effects called inside a pure 'map' lambda
-- Expected: U3001/U3003
-- Observed: U3001 at 13:3
-- Verdict: Pass (U3001)
module auth_inferred_into_map

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

helper(x: Int) -> Int
=
  @log.write("x")
  x

pub run(xs: List[Int]) -> List[Int]
  uses @log: Log[write]
=
  xs.map(each: fn(x) -> helper(x))
