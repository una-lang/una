-- Adversarial: policy called with method syntax 't.mask' / 't.mask()'; is it still audited?
-- Expected: accepted and listed in report
-- Observed: accepted (exit 0)
-- Verdict: Pass (both sites in information.policy_calls)
module app.caller

import app.keys (mask)

pub shown(t: secret[PII] Text) -> internal Text = t.mask

pub shown_call(t: secret[PII] Text) -> internal Text = t.mask()
