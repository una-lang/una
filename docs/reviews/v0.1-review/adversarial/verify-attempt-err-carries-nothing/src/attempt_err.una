-- Adversarial: the `Err` arm of an `attempt` divides by the argument; the `Ok` arm uses the
-- callee's `ensures`.
-- Expected: U5001 only in the `Err` arm (ADR 0033 rule 12). Observed: exactly that. Held.
module attempt_err

pub kind Oops = | Bad

g(x: Int) -> Int
  ensures result > 0
  fails Oops
=
  if x > 5 then fail Bad else 1

pub f(x: Int) -> Int
=
  let r = attempt g(x)
  when r
    is Ok(v) -> 100 / v
    is Err -> 100 / x
