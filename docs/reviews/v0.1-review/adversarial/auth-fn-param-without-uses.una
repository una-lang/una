-- Adversarial: private function calls an effectful function parameter with no declared uses (inferred)
-- Expected: accepted, uses inferred (spec/05 §9.2)
-- Observed: accepted (exit 0)
-- Verdict: Pass
module auth_fn_param_without_uses

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

each(line: Text, write: fn(Text) -> Unit uses @log: Log[write]) -> Unit = write(line)

pub run() -> Unit
  uses @log: Log[write]
=
  each("x", write: fn(t) -> @log.write(t))
