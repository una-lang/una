-- Adversarial: `Maybe[Pos]` built with `Has(v: 0)` (no field obligation for a type parameter);
-- if the pattern variable received `Pos` the division would be proven.
-- Expected: U5001 at `100 / v`. Observed: U5001 (type-argument refinements are not assumed). Held.
module genmaybe

pub kind Pos = Int where it > 0

pub kind Maybe[T] = Has(v: T) | Nothing

recip(m: Maybe[Pos]) -> Int
=
  when m
    is Has(v) -> 100 / v
    is Nothing -> 0

pub main() -> Unit
  uses @console: Console[print]
=
  let q = recip(Has(v: 0))
  @console.print("q = {q}")
