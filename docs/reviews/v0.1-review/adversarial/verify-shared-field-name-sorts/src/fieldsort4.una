-- Adversarial: two variants of one sum share the field name `size` with different types. Field
-- functions are named `<field>!<Sort>` without the variant, so a query that mentions both
-- declares `size!Kind_...` twice with different result sorts.
-- Expected: exit 0 (the program is valid and the ensures holds).
-- Observed: U8001 internal error at 1:1, "Sorts Int and Text are incompatible", exit code 1
-- (the guide says U8001 exits 3).
module fieldsort4

pub kind Shape = Circle(size: Int) | Label(size: Text)

pub measure(s: Shape) -> Int
  ensures result >= 0
=
  when s
    is Circle(size) -> abs(size)
    is Label(size) -> size.len
