-- Adversarial: effectful lambda into a pure function parameter
-- Expected: U3004/U3003
-- Observed: U3004 at 16:18
-- Verdict: Pass (U3004)
module auth_lambda_into_pure_param

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

apply(f: fn(Text) -> Unit, x: Text) -> Unit = f(x)

pub run() -> Unit
  uses @log: Log[write]
=
  apply(fn(t) -> @log.write(t), x: "x")
