-- Adversarial: main fails with internal payloads (top level, in a list, in an Option); does the runtime print them?
-- Expected: accepted; runtime prints only public payload fields (spec/04 §8)
-- Observed: accepted (exit 0)
-- Verdict: Pass (runtime prints 'Mixed(code: 7)' only)
module flow_main_failure_payload

kind Stop = | Mixed(code: Int, top: internal Text, values: List[internal Text], wrapped: Option[internal Text])

pub main() -> Unit
  uses @env: Env[get]
  fails Stop
=
  let pin = @env.get("PIN")
    if none use ""
  fail Mixed(code: 7, top: pin, values: [pin], wrapped: Some(pin))
