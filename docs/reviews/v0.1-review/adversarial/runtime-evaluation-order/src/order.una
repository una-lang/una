-- Adversarial: nested effectful calls in `do` lines: arguments left to right, and `and`/`or`
-- skip the right operand (which would fail).
-- Expected: trace write(1) then write(2); only one event in the short-circuit examples.
-- Observed: as expected in `una --json test`. Held.
module order

pub kind Oops = | Boom

pub capability Log
  op write(n: Int) -> Unit

pub handler log() for Log
  op write(n) = unit

pub tick(n: Int) -> Int
  uses @log: Log[write]
=
  @log.write(n)
  n

pub boom(n: Int) -> Bool
  uses @log: Log[write]
  fails Oops
=
  @log.write(n)
  fail Boom

pub combine(a: Int, b: Int) -> Int = a * 10 + b

example "arguments run left to right"
  given @log = log()
  do combine(tick(1), b: tick(2))
  expect result == 12

example "and short-circuits in a do line"
  given @log = log()
  do tick(0) == 1 and boom(9)
  expect result == false
  expect performed @log.write

example "or short-circuits"
  given @log = log()
  do tick(1) == 1 or boom(9)
  expect result == true
