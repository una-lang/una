-- Adversarial: generic 'filter(x == y).len' instantiated with secret data
-- Expected: U4001 (spec/07 §7.1, T6)
-- Observed: accepted (exit 0)
-- Verdict: CRITICAL
module flow_generic_filter_count

count_equal[T](xs: List[T], y: T) -> Int = xs.filter(keep: fn(x) -> x == y).len

pub leak(pin: secret Int) -> Int = count_equal([pin], y: 1234)
