-- Adversarial: private helper with inferred effects passed as 'map' argument
-- Expected: U3003
-- Observed: U3001 at 13:3; U3003 at 19:16
-- Verdict: Pass
module auth_inferred_fn_value_into_map

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

helper(x: Int) -> Int
=
  @log.write("x")
  x

pub run(xs: List[Int]) -> List[Int]
  uses @log: Log[write]
=
  xs.map(each: helper)
