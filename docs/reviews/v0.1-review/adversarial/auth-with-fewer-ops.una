-- Adversarial: rebinding to a capability with fewer operations
-- Expected: U3002
-- Observed: U3002 at 19:3
-- Verdict: Pass
module auth_with_fewer_ops

capability Log
  op write(line: Text) -> Unit
  op flush() -> Unit

note(line: Text) -> Unit
  uses @log: Log[write, flush]
=
  @log.write(line)

pub run() -> Unit
  uses @journal: Log[write]
=
  note("x") with @log = @journal
