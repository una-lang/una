-- Adversarial: a user module named `prelude` declares `KeyError` with three variants. The
-- verifier special-cases module `prelude` and takes the variant count of the standard
-- `KeyError` (one variant), so the ground fact `0 <= tag < 1` contradicts `tag = 2` for
-- `Expired`, and every later obligation is proven, here `100 / zero`.
-- Expected: error U5001 at `100 / zero` (spec/12 §3), or the module name rejected. The same program in
-- a module named `prelude_twin` gives U5001.
-- Observed: `una check` accepted (exit 0); `una run` aborts with U8001 `div` by zero (exit 3).
module prelude

pub kind KeyError = UnknownKey | Revoked | Expired

pub main() -> Unit
  uses @console: Console[print]
=
  let e = Expired
  let zero = 0
  let q = 100 / zero
  @console.print("q = {q}")
