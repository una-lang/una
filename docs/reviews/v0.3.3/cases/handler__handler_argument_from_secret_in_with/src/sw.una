-- expect: reject: handler__handler_argument_from_secret_in_with
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub capability Source
  op read() -> Int

pub handler fixed(value: Int) for Source
  op read() = value

probe(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let n = read_it() with @src = fixed(s)
  @log.write(n)

read_it() -> Int
  uses @src: Source[read]
=
  @src.read()

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(3)
