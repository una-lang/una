-- expect: reject: checked__whether_checked_fails_on_secret
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub predicate opaque small(n: Int) -> Bool = n < 10

pub kind Small = Int where small(it)

narrow(n: secret Int) -> Small
  fails Bad
=
  checked(n, small(it)) else fail Oops

probe(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let r = attempt narrow(s)
  @log.write(if r is Ok then 1 else 0)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(3)
