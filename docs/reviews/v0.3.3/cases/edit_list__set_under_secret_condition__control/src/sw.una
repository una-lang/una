-- expect: accept: edit_list__set_under_secret_condition__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let edit ys = [0, 0, 0]
  if s > 1
    edit ys.set(index: 1, item: 7)
  @log.write(ys.fold(initial: 0, step: fn(a, y) -> a + y))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(2)
