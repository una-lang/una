-- expect: accept: edit_field__field_set_under_secret_condition__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub kind Tally
  count: Int

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let edit t = Tally(count: 0)
  if s > 0
    t.count = 1
  @log.write(t.count)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(5)
