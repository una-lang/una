-- expect: reject: map__first_value_in_key_order_of_secret_keys (the order of public values depends on the secret keys)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(m: Map[secret Int, Int]) -> Unit
  uses @log: Log[write]
=
  let firsts = m.entries().map(each: fn(e) -> e.value)
  let v = firsts.first()
    if none use 0
  @log.write(v)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(empty_map().with(key: 2, value: 7).with(key: 1, value: 8))
