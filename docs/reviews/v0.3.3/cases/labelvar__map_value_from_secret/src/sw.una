-- expect: reject: labelvar__map_value_from_secret
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let edit m = empty_map()
  edit m.set(key: 1, value: s)
  let v = m.get(key: 1)
    if none use 0
  @log.write(v)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(9)
