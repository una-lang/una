-- expect: accept: text__ends_with__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public Text) -> Unit
  uses @log: Log[write]
=
  @log.write(if s.ends_with(suffix: "c") then 1 else 0)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("abc")
