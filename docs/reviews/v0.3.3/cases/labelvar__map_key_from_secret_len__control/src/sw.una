-- expect: accept: labelvar__map_key_from_secret_len__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let edit m = empty_map()
  edit m.set(key: s, value: 1)
  edit m.set(key: 5, value: 1)
  @log.write(m.len)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(5)
