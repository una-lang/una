-- expect: reject: json__object_key_order_reveals_secret_key
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Text) -> Unit
  uses @log: Log[write]
=
  let text = "\{\"b\": 1, {s.quote_json()}: 2\}"
  let doc = text.parse_json()
    if error use Null
  let n = when doc
    is Object(fields) ->
      let vs = fields.values()
      let v = vs.first()
        if none use Null
      when v
        is Number(k) -> k
        else -> 0
    else -> 0
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("a")
