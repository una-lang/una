-- expect: reject: http__secret_in_body [check only]
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Text) -> Unit
  uses @http: Http[post]
=
  let r = attempt @http.post("https://example.com/", headers: [], body: s, key_name: None)
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  unit
