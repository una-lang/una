-- expect: accept: fixed__guarded_add_of_secret__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public U8) -> Unit
  uses @log: Log[write]
=
  let r = if s.to_int() + 1 <= 255 then s + 1 else 0
  @log.write(r.to_int())

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(100)
