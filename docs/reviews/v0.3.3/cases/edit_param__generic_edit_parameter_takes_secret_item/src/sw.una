-- expect: reject: edit_param__generic_edit_parameter_takes_secret_item
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

push[T](edit xs: List[T], item: T) -> Unit
=
  xs = xs.append(item: item)

probe(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let edit xs: List[Int] = []
  edit xs.push(item: s)
  let v = xs.first()
    if none use 0
  @log.write(v)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(3)
