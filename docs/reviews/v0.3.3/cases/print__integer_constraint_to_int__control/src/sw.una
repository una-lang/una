-- expect: accept: print__integer_constraint_to_int__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

widen[T: Integer](x: T) -> Int = x.to_int()

probe(s: public U8) -> Unit
  uses @log: Log[write]
=
  @log.write(widen(s))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(200)
