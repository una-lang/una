-- expect: reject: labelvar__list_elements_from_secret
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let edit xs = []
  for i in 0..<3
    xs = xs.append(item: i + s)
  @log.write(xs.fold(initial: 0, step: fn(a, x) -> a + x))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(1)
