-- expect: accept: effects__effect_under_secret_element_condition__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(xs: List[public Int]) -> Unit
  uses @log: Log[write]
=
  for x in xs
    if x > 0
      @log.write(1)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe([1, 0])
