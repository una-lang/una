-- expect: accept: print__interpolate_map_with_secret_keys__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(m: Map[public Text, Int]) -> Unit
  uses @log: Log[write]
=
  @log.write("{m}".len)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(empty_map().with(key: "ab", value: 1))
