-- expect: accept: print__default_of_missing_key_in_secret_map__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(m: public Map[Int, Int]) -> Unit
  uses @log: Log[write]
=
  let v = m.get(key: 1)
    if none use 7
  @log.write(v)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(empty_map())
