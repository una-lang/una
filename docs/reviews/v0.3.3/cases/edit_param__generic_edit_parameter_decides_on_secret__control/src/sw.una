-- expect: rule: edit_param__generic_edit_parameter_decides_on_secret__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

push_if[T: Eq](edit xs: List[T], item: T, other: T) -> Unit
=
  if item == other
    xs = xs.append(item: item)

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let edit xs: List[Int] = []
  edit xs.push_if(item: s, other: 3)
  @log.write(xs.len)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(3)
