-- expect: accept: map__iteration_order_reveals_secret_key__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let m: public Map[Int, Int] = empty_map()
  let n = m.with(key: s, value: 1).with(key: 5, value: 2)
  let first = n.values().first()
    if none use 0
  @log.write(first)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(3)
