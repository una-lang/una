-- expect: reject: policy__trusted_function_outside_a_policy (a trusted module lowers labels only through a policy)
module sw

import release (peek)

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(pin: secret[Pin] Text) -> Unit
  uses @log: Log[write]
=
  @log.write(peek(pin))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("1234")
