-- expect: reject: http__secret_in_header_value [check only]
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Text) -> Unit
  uses @http: Http[get]
=
  let h = Header(name: "X", value: s)
  let r = attempt @http.get("https://example.com/", headers: [h], key_name: None)
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  unit
