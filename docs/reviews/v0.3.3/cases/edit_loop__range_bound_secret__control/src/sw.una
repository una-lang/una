-- expect: accept: edit_loop__range_bound_secret__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let edit total = 0
  for i in 0..<s
    total = total + 1
  @log.write(total)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(3)
