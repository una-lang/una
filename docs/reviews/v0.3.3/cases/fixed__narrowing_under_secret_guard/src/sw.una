-- expect: reject: fixed__narrowing_under_secret_guard
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let small = if s >= 0 and s <= 255 then s.to_u8() else 0
  @log.write(small.to_int())

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(7)
