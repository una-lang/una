-- expect: accept: handler__handler_effect_on_captured_secret__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub handler gated(limit: public Int) for Log
  uses @console: Console[print]
  op write(n) = report(n, limit: limit)

report(n: Int, limit: public Int) -> Unit
  uses @console: Console[print]
=
  if n > limit
    @console.print("big")

probe() -> Unit
  uses @log: Log[write]
=
  @log.write(5)

pub main() -> Unit
  uses @console: Console[print]
=
  probe() with @log = gated(3)
