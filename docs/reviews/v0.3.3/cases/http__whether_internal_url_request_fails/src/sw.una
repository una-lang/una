-- expect: reject: http__whether_internal_url_request_fails [check only]
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(u: internal Text) -> Unit
  uses @http: Http[get]
  uses @log: Log[write]
=
  let r = attempt @http.get(u, headers: [], key_name: None)
  @log.write(if r is Ok then 1 else 0)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  unit
