-- expect: accept: together__which_task_failed_first__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub kind Which = First | Second

one(t: public Text) -> Int
  fails Which
=
  let n = t.parse_int()
    if error use 0
  if n > 0 then fail First else 0

probe(t: public Text) -> Unit
  uses @log: Log[write]
=
  let r = attempt run_both(t)
  let n = when r
    is Ok(v) -> 0
    is Err(e) ->
      when e
        is First -> 1
        is Second -> 2
  @log.write(n)

run_both(t: public Text) -> Int
  fails Which
=
  together
    let a = one(t)
      if error pass
    let b = fail_second()
      if error pass
  a + b

fail_second() -> Int
  fails Which
=
  fail Second

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("1")
