-- expect: reject: effects__range_with_secret_bound_counts_effects
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Int) -> Unit
  uses @log: Log[write]
=
  for i in 0..<s
    @log.write(1)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(2)
