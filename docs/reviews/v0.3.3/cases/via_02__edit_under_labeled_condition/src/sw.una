-- expect: accept: via_02__edit_under_labeled_condition (via bodies are exempt from label checks, spec/07 §6 rule 6)
module sw

import release (p)

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret[Pin] Int) -> Unit
  uses @log: Log[write]
=
  @log.write(p(s))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(2)
