-- expect: reject: recursive__search_tree_shape_decided_by_secrets (comparisons on secret values decide the shape of a tree whose shape is public)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub kind Tree = Leaf | Node(left: Tree, value: secret Int, right: Tree)

insert(t: Tree, x: secret Int) -> Tree
=
  when t
    is Leaf -> Node(left: Leaf, value: x, right: Leaf)
    is Node(left, value, right) -> if x < value then Node(left: insert(left, x: x), value: value, right: right) else Node(left: left, value: value, right: insert(right, x: x))

depth(t: Tree) -> Int
=
  when t
    is Leaf -> 0
    is Node(left, value, right) -> 1 + max(depth(left), b: depth(right))

probe(a: secret Int, b: secret Int) -> Unit
  uses @log: Log[write]
=
  let t = insert(insert(insert(Leaf, x: 2), x: a), x: b)
  @log.write(depth(t))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(1, b: 0)
