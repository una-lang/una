-- expect: reject: edit_loop__count_under_secret_condition
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(xs: List[Int], s: secret Int) -> Unit
  uses @log: Log[write]
=
  let edit n = 0
  for x in xs
    if x == s
      n = n + 1
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe([1, 2, 3], s: 2)
