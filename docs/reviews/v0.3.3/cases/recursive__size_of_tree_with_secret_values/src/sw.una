-- expect: accept: recursive__size_of_tree_with_secret_values (the shape is public; only the values are secret)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub kind Tree = Leaf | Node(left: Tree, value: secret Int, right: Tree)

size(t: Tree) -> Int
=
  when t
    is Leaf -> 0
    is Node(left, value, right) -> size(left) + 1 + size(right)

total(t: Tree) -> secret Int
=
  when t
    is Leaf -> 0
    is Node(left, value, right) -> total(left) + value + total(right)

probe(t: Tree) -> Unit
  uses @log: Log[write]
=
  @log.write(size(t))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(Node(left: Leaf, value: 3, right: Leaf))
