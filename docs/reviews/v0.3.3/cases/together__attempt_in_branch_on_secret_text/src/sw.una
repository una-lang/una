-- expect: reject: together__attempt_in_branch_on_secret_text
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Text) -> Unit
  uses @log: Log[write]
=
  together
    let a = attempt s.parse_int()
    let b = 3
  @log.write(if a is Ok then 1 else 0)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("12")
