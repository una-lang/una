-- expect: accept: together__branch_result_from_secret__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  together
    let a = s + 1
    let b = 2
  @log.write(a + b)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(1)
