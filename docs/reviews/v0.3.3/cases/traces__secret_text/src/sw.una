-- expect: accept: traces__secret_text (traces must redact alike)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub capability Vault
  op keep(n: Int) -> Unit
    accepts secret
  op keep_text(t: Text) -> Unit
    accepts secret
  op keep_list(xs: List[Int]) -> Unit
    accepts secret
  op keep_map(m: Map[Text, Int]) -> Unit
    accepts secret

pub handler drop() for Vault
  op keep(n) = unit
  op keep_text(t) = unit
  op keep_list(xs) = unit
  op keep_map(m) = unit

probe(s: secret Text) -> Unit
  uses @vault: Vault[keep_text]
=
  @vault.keep_text("x{s}")

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("ab") with @vault = drop()
