-- expect: accept: edit_param__take_after_secret_append__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

consume(take xs: List[Int]) -> Int = xs.len

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let edit xs = [1, 2]
  if s > 0
    xs = xs.append(item: 3)
  let n = consume(take xs)
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(1)
