-- expect: reject: fixed__wrapping_add_of_secret
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret U8) -> Unit
  uses @log: Log[write]
=
  @log.write(s.wrapping_add(by: 200).to_int())

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(100)
