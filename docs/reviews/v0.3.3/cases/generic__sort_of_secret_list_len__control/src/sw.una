-- expect: accept: generic__sort_of_secret_list_len__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(xs: public List[Int]) -> Unit
  uses @log: Log[write]
=
  @log.write(xs.sort().len)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe([3, 1])
