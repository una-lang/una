-- expect: reject: http__secret_key_name [check only]
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(k: secret Text) -> Unit
  uses @http: Http[get]
=
  let r = attempt @http.get("https://example.com/", headers: [], key_name: Some(k))
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  unit
