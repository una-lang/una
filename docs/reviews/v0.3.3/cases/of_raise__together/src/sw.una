-- expect: reject: of_raise__together (edition 0.2: a decision on T given to a function named by `uses of`)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

g[T: Eq](a: T, b: T, p: T, q: T, k: fn(T) -> Unit) -> Unit
  uses of k
=
  together
    let x = k(if a == b then p else q)
    let y = 1
  unit

leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1, 2], k: fn(xs) -> @log.write(xs.len))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  leak(0)
