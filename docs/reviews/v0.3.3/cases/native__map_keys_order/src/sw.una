-- expect: accept: native__map_keys_order
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

json_len(t: Text) -> Int
=
  let doc = t.parse_json()
    if error use Null
  doc.to_json().bytes().len

parse_or_zero(t: Text) -> Int
=
  let n = t.parse_int()
    if error use 0
  n

position(t: Text, part: Text) -> Int
=
  let at = t.find(text: part)
    if none use 0 - 1
  at

squares(n: Int) -> Int
=
  let edit total = 0
  for i in 0..<n
    total = total + i * i
  total

probe() -> Unit
  uses @log: Log[write]
=
  @log.write(position(empty_map().with(key: "b", value: 2).with(key: "a", value: 1).keys().join(separator: ""), part: "b"))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe()
