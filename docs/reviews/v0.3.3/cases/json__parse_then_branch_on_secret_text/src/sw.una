-- expect: reject: json__parse_then_branch_on_secret_text
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: secret Text) -> Unit
  uses @log: Log[write]
=
  let doc = s.parse_json()
    if error use Null
  let n = when doc
    is Number(v) -> 1
    else -> 0
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("12")
