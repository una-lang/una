-- expect: reject: together__cancellation_reveals_failure (a task failing on a secret cancels a later task's public effect)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

check(n: secret Int) -> Int
  fails Bad
=
  if n > 0 then fail Oops else n

probe(s: secret Int) -> Unit
  uses @log: Log[write]
  fails Bad
=
  together
    let a = check(s)
      if error pass
    let b = @log.write(1)
  @log.write(a)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  let r = attempt probe(0)
  @log.write(0)
