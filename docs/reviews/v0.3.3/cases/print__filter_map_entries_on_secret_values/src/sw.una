-- expect: reject: print__filter_map_entries_on_secret_values
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(m: Map[Int, secret Int]) -> Unit
  uses @log: Log[write]
=
  @log.write(m.entries().filter(keep: fn(e) -> e.value > 0).len)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(empty_map().with(key: 1, value: 5).with(key: 2, value: 0))
