-- expect: accept: map__get_with_secret_key__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let m: Map[Int, Int] = empty_map()
  let n = m.with(key: 1, value: 10)
  let v = n.get(key: s)
    if none use 0
  @log.write(v)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(1)
