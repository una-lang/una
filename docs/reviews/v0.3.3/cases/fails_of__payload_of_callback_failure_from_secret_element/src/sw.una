-- expect: reject: fails_of__payload_of_callback_failure_from_secret_element
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub kind Got = | Value(n: Int)

fails_with(x: Int) -> Int
  fails Got
=
  fail Value(n: x)

probe(xs: List[secret Int]) -> Unit
  uses @log: Log[write]
=
  let r = attempt xs.map(each: fails_with)
  let n = when r
    is Ok(v) -> 0
    is Err(e) ->
      when e
        is Value(n) -> n
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe([4])
