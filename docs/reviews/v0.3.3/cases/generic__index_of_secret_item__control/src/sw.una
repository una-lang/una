-- expect: rule: generic__index_of_secret_item__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

index_of[T: Eq](xs: List[T], item: T) -> Int
=
  let edit at = 0 - 1
  let edit i = 0
  for x in xs
    if x == item and at < 0
      at = i
    i = i + 1
  at

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  @log.write(index_of([1, 2, 3], item: s))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(2)
