-- expect: accept: handler__handler_result_is_captured_secret__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub capability Source
  op read() -> Int

pub handler fixed(value: public Int) for Source
  op read() = value

probe() -> Unit
  uses @src: Source[read]
  uses @log: Log[write]
=
  let n = @src.read()
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe() with @src = fixed(3)
