-- expect: accept: print__kind_with_secret_field_interpolated__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pub kind Card
  number: public Text
  holder: Text

probe(c: Card) -> Unit
  uses @log: Log[write]
=
  @log.write("{c}".len)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(Card(number: "1234", holder: "a"))
