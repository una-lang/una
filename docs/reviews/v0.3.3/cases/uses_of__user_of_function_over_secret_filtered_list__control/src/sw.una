-- expect: accept: uses_of__user_of_function_over_secret_filtered_list__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

each_logged(xs: List[Int], act: fn(Int) -> Unit) -> Int
  uses of act
=
  let done = xs.map(each: act)
  done.len

probe(xs: List[Int], s: public Int) -> Unit
  uses @log: Log[write]
=
  let kept = xs.filter(keep: fn(x) -> x < s)
  let n = each_logged(kept, act: fn(x) -> @log.write(1))
  @log.write(0)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe([1, 5], s: 3)
