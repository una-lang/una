-- expect: accept: effects__for_over_keys_of_map_with_secret_keys__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(m: Map[public Int, Int]) -> Unit
  uses @log: Log[write]
=
  for k in m.keys()
    @log.write(1)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(empty_map().with(key: 1, value: 1))
