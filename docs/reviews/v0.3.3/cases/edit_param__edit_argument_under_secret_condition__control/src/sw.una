-- expect: accept: edit_param__edit_argument_under_secret_condition__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

bump(edit n: Int, by: Int) -> Unit
=
  n = n + by

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  let edit n = 0
  if s > 0
    edit n.bump(by: 1)
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(4)
