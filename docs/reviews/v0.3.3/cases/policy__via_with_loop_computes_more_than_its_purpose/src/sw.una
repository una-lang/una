-- expect: accept: policy__via_with_loop_computes_more_than_its_purpose (via bodies are not checked for labels (spec/07 §6 rule 6), edition 0.2 constructs included)
module sw

import release (first_digit)

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(pin: secret[Pin] Text) -> Unit
  uses @log: Log[write]
=
  @log.write(first_digit(pin))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe("1234")
