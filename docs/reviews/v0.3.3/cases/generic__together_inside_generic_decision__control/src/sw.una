-- expect: accept: generic__together_inside_generic_decision__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

pick[T: Ord](a: T, b: T) -> T
=
  together
    let x = max(a, b: b)
    let y = min(a, b: b)
  x

probe(s: public Int) -> Unit
  uses @log: Log[write]
=
  @log.write(pick(s, b: 4))

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(3)
