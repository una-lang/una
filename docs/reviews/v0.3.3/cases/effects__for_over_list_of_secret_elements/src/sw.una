-- expect: accept: effects__for_over_list_of_secret_elements (only the elements are secret: the number of writes is public)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(xs: List[secret Int]) -> Unit
  uses @log: Log[write]
=
  for x in xs
    @log.write(1)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe([1, 2])
