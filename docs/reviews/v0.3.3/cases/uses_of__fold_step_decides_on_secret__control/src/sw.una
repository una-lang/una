-- expect: accept: uses_of__fold_step_decides_on_secret__control (control)
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(xs: List[Int], s: public Int) -> Unit
  uses @log: Log[write]
=
  let total = xs.fold(initial: 0, step: fn(acc, x) -> if x == s then acc + 1 else acc)
  @log.write(total)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe([1, 2], s: 2)
