-- expect: reject: map__len_of_map_with_secret_key_type
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Bad = | Oops

probe(m: Map[secret Int, Int]) -> Unit
  uses @log: Log[write]
=
  @log.write(m.len)

pub main() -> Unit
  uses @console: Console[print]
=
  run_cell() with @log = to_console()

run_cell() -> Unit
  uses @log: Log[write]
=
  probe(empty_map().with(key: 1, value: 1))
