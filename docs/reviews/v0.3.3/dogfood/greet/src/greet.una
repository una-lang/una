module greet

import release (name_length)

--- Greets the user named by $USER, and says how long the name is.
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let name = @env.get("USER")
    if none use "stranger"
  let size = name_length(name)
  @console.print("hello, your name has {size} letters")
