module orders

--- One line of an order.
pub kind Line
  name: Text
  qty: Int

--- The lines of an order document: `{"lines": [{"name": "a", "qty": 2}, ...]}`.
pub lines(doc: Json) -> List[Line]
=
  when doc
    is Object(fields) ->
      let found = fields.get(key: "lines")
        if none use Array(items: [])
      when found
        is Array(items) -> items.map(each: fn(item) -> line(item))
        else -> []
    else -> []

--- One line, or an empty one when a field is missing.
line(item: Json) -> Line
=
  when item
    is Object(fields) ->
      let name = fields.get(key: "name")
        if none use Str(value: "")
      let qty = fields.get(key: "qty")
        if none use Number(value: 0)
      Line(name: text_of(name), qty: number_of(qty))
    else -> Line(name: "", qty: 0)

text_of(j: Json) -> Text
=
  when j
    is Str(value) -> value
    else -> ""

number_of(j: Json) -> Int
=
  when j
    is Number(value) -> value
    else -> 0

--- The summary: `{"count": 2, "total": 5, "names": ["a", "b"]}`.
pub summary(text: Text) -> Text
  fails JsonError
=
  let doc = text.parse_json()
    if error pass
  let ls = lines(doc)
  let total = ls.map(each: fn(l) -> l.qty).sum()
  let names = ls.map(each: fn(l) -> Str(value: l.name))
  let out = empty_map().with(key: "count", value: Number(value: ls.len)).with(key: "total", value: Number(value: total)).with(key: "names", value: Array(items: names))
  Object(fields: out).to_json()

example "two lines"
  do summary("\{\"lines\": [\{\"name\": \"a\", \"qty\": 2\}, \{\"name\": \"b\", \"qty\": 3\}]\}")
  expect result == "\{\"count\":2,\"names\":[\"a\",\"b\"],\"total\":5\}"
