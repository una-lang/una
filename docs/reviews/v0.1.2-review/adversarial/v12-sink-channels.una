-- Adversarial: ADR 0052: channels the covariant sink could drop. A function argument that fails depending on a secret; `let`-bound functions whose result of a result, `Option` element, `Box` field or parameter of a parameter carries a secret; a function whose parameter label is higher than declared (accepted by ADR 0052). Effectful function parameters of operations cannot be written (U1001), and lambdas cannot use capabilities, so that channel does not exist
-- Expected: U4002 for the failure in the function's own body; U4003 for each `let`-bound secret at a covariant position; `by_higher_ok` accepted
-- Observed: as expected at ca54a15 and with #102 and #103 merged; at main, `by_higher_ok` is also U4003 (R3-001)
-- Verdict: Held
module v12_sink_channels

pub kind Bad = Broke | Other

kind Box[T]
  value: T

capability Probe
  op failing(f: fn(Int) -> Int fails Bad) -> Int
  op nested(f: fn() -> fn() -> Int) -> Int
  op optional(o: Option[fn() -> Int]) -> Int
  op boxed(b: Box[fn() -> Int]) -> Int
  op callback(f: fn(fn(Int) -> Int) -> Int) -> Int
  op higher(f: fn(internal Int) -> Int) -> Int

handler shouting() for Probe
  uses @console: Console[print]
  op failing(f) = shout(f)
  op nested(f) = 0
  op optional(o) = 0
  op boxed(b) = 0
  op callback(f) = 0
  op higher(f) = 0

shout(f: fn(Int) -> Int fails Bad) -> Int
  uses @console: Console[print]
=
  let v = f(1)
    if error use 0
  @console.print("{v}")
  v

pub by_failure(pin: secret Int) -> Int
  uses @p: Probe[failing]
=
  @p.failing(fn(x: Int) -> if pin > 3 then fail Broke else x)

pub by_nested(pin: secret Int) -> Int
  uses @p: Probe[nested]
=
  let f = fn() -> fn() -> pin
  @p.nested(f)

pub by_optional(pin: secret Int) -> Int
  uses @p: Probe[optional]
=
  let f = fn() -> pin
  @p.optional(Some(f))

pub by_boxed(pin: secret Int) -> Int
  uses @p: Probe[boxed]
=
  let f = fn() -> pin
  @p.boxed(Box(value: f))

pub by_callback(pin: secret Int) -> Int
  uses @p: Probe[callback]
=
  let f = fn(g: fn(secret Int) -> Int) -> g(pin)
  @p.callback(f)

pub by_higher_ok() -> Int
  uses @p: Probe[higher]
=
  @p.higher(fn(x: secret Int) -> 1)
