module main

pub capability Store
  op put(scores: Map[Text, internal Int], tags: Map[Text, Text], pairs: List[Entry[Text, internal Int]]) -> Unit
    accepts internal

pub handler quiet() for Store
  op put(scores, tags, pairs) = unit

keep(scores: Map[Text, internal Int], tags: Map[Text, Text], pairs: List[Entry[Text, internal Int]]) -> Unit
  uses @store: Store[put]
=
  @store.put(scores, tags: tags, pairs: pairs)

-- spec/11 §5, spec/21 §5 rule 3: a map in the trace renders as in interpolation, and a labeled
-- position is redacted, identically in both engines.
pub main() -> Unit
  uses @console: Console[print]
=
  let secret_score: internal Int = 42
  let scores = empty_map().with(key: "alice", value: secret_score)
  let tags = empty_map().with(key: "role", value: "admin")
  let pairs = scores.entries()
  keep(scores, tags: tags, pairs: pairs) with @store = quiet()
  @console.print("done")
