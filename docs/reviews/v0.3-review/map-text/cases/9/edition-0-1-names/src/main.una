-- expect: accepted and runs: in edition 0.1, Map, Entry, empty_map, the text functions and ParseError are ordinary names (spec/21, spec/22 Editions)
module main

pub kind Map = Small | Large

pub kind Entry
  key: Int

pub kind ParseError = Bad | Worse

empty_map() -> Int = 7

split(t: Text) -> Int = t.len

slice(n: Int) -> Int = n + 1

find(xs: List[Int]) -> Int = xs.len

pub main() -> Unit
  uses @console: Console[print]
=
  let m = Large
  let e = Entry(key: 3)
  let p = Worse
  let abc = "abc"
  @console.print("{empty_map()} {split(abc)} {slice(4)} {find([1, 2])} {e.key}")
  when m
    is Small -> @console.print("small")
    is Large -> @console.print("large")
