-- expect: U4003 where an internal response, taken apart into a map, reaches Console; controls accepted (spec/24 §5 rule 2, spec/21 §3, spec/22 §5)
module main

counts(body: internal Text) -> internal Map[internal Text, Int]
=
  let edit m: internal Map[internal Text, Int] = empty_map()
  for word in body.split(on: " ")
    let n = m.get(key: word)
      if none use 0
    edit m.set(key: word, value: n + 1)
  m

pub main() -> Unit
  uses @http: Http[get]
  uses @console: Console[print]
=
  let r = attempt @http.get("http://127.0.0.1:9/", headers: [], key_name: None)
  when r
    is Ok(response) ->
      let m = counts(response.body)
      @console.print("{m.len}")
      @console.print("{m.keys()}")
      let header_map = response.headers.fold(initial: empty_map(), step: fn(acc, h) -> acc.with(key: h.name, value: h.value))
      @console.print("{header_map.len}")
    is Err(e) -> @console.print("failed")
