module main

grow(edit m: Map[Int, Int], k: Int) -> Unit
=
  edit m.set(key: k, value: k * k)

shrink(m: Map[Int, Int], k: Int) -> Map[Int, Int] = m.without(key: k)

-- spec/21 §5 rule 1: a map is a value; other bindings keep the old map.
pub main() -> Unit
  uses @console: Console[print]
=
  let edit a: Map[Int, Int] = empty_map()
  for i in 0..<5
    edit a.set(key: i, value: i)
  let b = a
  edit a.set(key: 9, value: 9)
  edit a.remove(key: 0)
  grow(edit a, k: 7)
  let c = shrink(a, k: 7)
  let d = a.with(key: 1, value: 100)
  let f = fn(m: Map[Int, Int]) -> m.with(key: 2, value: 200)
  let e = f(a)
  let g = f(a)
  let sizes = together for k in [1, 2]
    let edit local = b
    edit local.set(key: k + 10, value: 0)
    local.len
  @console.print("{a}")
  @console.print("{b}")
  @console.print("{c}")
  @console.print("{d}")
  @console.print("{e == g} {e}")
  @console.print("{sizes} {b.len}")
  @console.print("{a == b} {b == b.with(key: 0, value: 0)} {b == b.with(key: 0, value: 1)}")
