module main

pub kind Color = Red | Green | Blue

-- Text orders by scalar values; sums without payload by declaration order.
pub main() -> Unit
  uses @console: Console[print]
=
  let edit m: Map[Text, Int] = empty_map()
  for k in ["b", "a", "", "ab", "é", "z", "😀", "\u{FFFF}", "A", "aa"]
    edit m.set(key: k, value: k.len)
  @console.print("{m.keys()}")
  @console.print("{m}")
  let edit c: Map[Color, Text] = empty_map()
  edit c.set(key: Blue, value: "b")
  edit c.set(key: Red, value: "r")
  edit c.set(key: Green, value: "g")
  @console.print("{c}")
  for e in c.entries()
    @console.print("{e.key}={e.value}")
