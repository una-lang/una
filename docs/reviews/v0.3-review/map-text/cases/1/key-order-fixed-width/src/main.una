module main

-- spec/21 §1 rule 3: keys in ascending order by spec/03 §1 and spec/20 §5, for every Ord type.
pub main() -> Unit
  uses @console: Console[print]
=
  let edit big: Map[U64, Int] = empty_map()
  edit big.set(key: 18446744073709551615.to_u64(), value: 1)
  edit big.set(key: 9223372036854775808.to_u64(), value: 2)
  edit big.set(key: 0.to_u64(), value: 3)
  edit big.set(key: 9223372036854775807.to_u64(), value: 4)
  @console.print("{big.keys()}")
  let edit small: Map[I64, Int] = empty_map()
  edit small.set(key: 9223372036854775807.to_i64(), value: 1)
  edit small.set(key: (-9223372036854775808).to_i64(), value: 2)
  edit small.set(key: (-1).to_i64(), value: 3)
  edit small.set(key: 0.to_i64(), value: 4)
  @console.print("{small.keys()}")
  let edit bytes: Map[U8, Int] = empty_map()
  edit bytes.set(key: 255.to_u8(), value: 1)
  edit bytes.set(key: 128.to_u8(), value: 2)
  edit bytes.set(key: 127.to_u8(), value: 3)
  @console.print("{bytes.keys()}")
  let edit ints: Map[Int, Int] = empty_map()
  edit ints.set(key: 100000000000000000000000, value: 1)
  edit ints.set(key: -100000000000000000000000, value: 2)
  edit ints.set(key: 4611686018427387904, value: 3)
  edit ints.set(key: -4611686018427387905, value: 4)
  edit ints.set(key: 0, value: 5)
  @console.print("{ints.keys()}")
