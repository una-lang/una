module main

pub kind Size = Small | Medium | Large

-- spec/21 §1 rule 2: in a generic function, Map[T, V] needs T: Ord, and orders by T's order.
tally[T: Ord](xs: List[T]) -> Map[T, Int]
=
  let edit m = empty_map()
  for x in xs
    let n = m.get(key: x)
      if none use 0
    edit m.set(key: x, value: n + 1)
  m

firsts[T: Ord](m: Map[T, Int]) -> List[T] = m.keys()

pub main() -> Unit
  uses @console: Console[print]
=
  let pear = "pear"
  let words = ["pear", "apple", "pear", "é", "Zebra", "", "apple"]
  @console.print("{tally(words)}")
  @console.print("{tally([Large, Small, Large, Medium])}")
  let big = [18446744073709551615.to_u64(), 1.to_u64(), 9223372036854775808.to_u64(), 1.to_u64()]
  @console.print("{tally(big)}")
  let small = [(-128).to_i8(), 127.to_i8(), (-1).to_i8(), 0.to_i8()]
  @console.print("{tally(small)}")
  let huge = [100000000000000000000000, -100000000000000000000000, 4611686018427387904, -4611686018427387905, 0]
  @console.print("{firsts(tally(huge))}")
  @console.print("{tally(big).has(key: 9223372036854775808.to_u64())} {tally(words).get(key: pear)}")
