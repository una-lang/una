module main

show(t: Text) -> Text
=
  let r = attempt t.parse_int()
  when r
    is Ok(n) -> "ok {n}"
    is Err(e) -> "{e}"

-- spec/22 §4: at is a scalar index; Empty, NoDigits, NotADigit.
pub main() -> Unit
  uses @console: Console[print]
=
  for t in ["", "-", "--1", "12a", "é1", "1é", "😀", "12😀3", "-é", " 1", "1 ", "007", "-0", "+1", "١٢", "99999999999999999999999999"]
    @console.print("[{t}] {show(t)}")
