module main

cut(t: Text, start: Int, end: Int) -> Text = if 0 <= start and start <= end and end <= t.len then t.slice(start: start, end: end) else "?"

-- spec/22 §6: the scalar count, ASCII flag and checkpoint index stay right when a text grows in
-- place. Positions past the old end, after the index was built on the old text.
pub main() -> Unit
  uses @console: Console[print]
=
  let edit t = ""
  for i in 0..<200
    t = "{t}é"
  -- Build the index on a non-ASCII text.
  let first = cut(t, start: 150, end: 151)
  let found = t.find(text: "é")
  for i in 0..<100
    t = "{t}a"
  for i in 0..<100
    t = "{t}😀"
  @console.print("{t.len} {first} {found}")
  @console.print("{cut(t, start: 199, end: 202)}")
  @console.print("{cut(t, start: 299, end: 301)}")
  let a = "a"
  let smile = "😀"
  let both = "a😀"
  @console.print("{t.find(text: a)} {t.find(text: smile)} {t.find(text: both)}")
  @console.print("{t.chars().len} {t.bytes().len}")
  let back = cut(t, start: 380, end: 400)
  @console.print("{back.len} {back}")
  let edit u = "abc"
  for i in 0..<70
    u = "{u}x"
  let early = cut(u, start: 1, end: 3)
  u = "{u}ü"
  let umlaut = "ü"
  @console.print("{u.len} {cut(u, start: 72, end: 74)} {early} {u.find(text: umlaut)}")
