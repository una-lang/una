module main

pub main() -> Unit
  uses @console: Console[print]
=
  let edit hay = ""
  for i in 0..<2000000
    hay = "{hay}a"
  let edit needle = ""
  for i in 0..<(2000000 / 2)
    needle = "{needle}a"
  needle = "{needle}b"
  let found = hay.find(text: needle)
  let count = if needle.len > 0 then hay.split(on: needle).len else 0
  @console.print("{found} {count}")
