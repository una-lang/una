-- expect: U4001 at the key of each set/remove into a public editable map (spec/21 §3 rule 4)
module main

pub set_high(k: internal Text) -> Int
=
  let edit m: Map[Text, Int] = empty_map()
  edit m.set(key: k, value: 1)
  0

pub remove_high(k: internal Text) -> Int
=
  let edit m: Map[Text, Int] = empty_map()
  edit m.set(key: "a", value: 1)
  edit m.remove(key: k)
  m.len

pub value_high(v: internal Int) -> Int
=
  let edit m: Map[Text, Int] = empty_map()
  edit m.set(key: "a", value: v)
  m.len

pub set_under_pc(flag: secret Bool) -> Int
=
  let edit m: Map[Text, Int] = empty_map()
  if flag
    edit m.set(key: "a", value: 1)
  m.len

pub control(k: internal Text) -> internal Int
=
  let edit m: internal Map[internal Text, Int] = empty_map()
  edit m.set(key: k, value: 1)
  m.len
