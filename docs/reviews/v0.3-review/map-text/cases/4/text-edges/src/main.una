module main

show(xs: List[Text]) -> Text = xs.map(each: fn(x) -> "<{x}>").join(separator: "")

-- spec/22 §2 rules 1 to 7 and §3, at the edges.
pub main() -> Unit
  uses @console: Console[print]
=
  let aa = "aa"
  let comma = ","
  let empty = ""
  let a = "a"
  let b = "b"
  let c = "c"
  let e = "é"
  let ee = "éé"
  let smiles = "😀😀"
  let nl = "\n"
  let three = "aaa"
  let four = "aaaa"
  let commas = ",a,,b,"
  let lines = "x\ny\n"
  let mixed = "😀a😀"
  let abc = "abc"
  let eee = "ééé"
  let aee = "aéé"
  let ssb = "😀😀b"
  let upper = "ßtraße Éa ǅ ﬁ"
  let lower = "ÀBC Ǆ ΣAB"
  let sharp = "ß"
  let dotted = "İ"
  let lead = "\u{3000}\u{85}\u{A0} x \t\n"
  let trail = " x\u{2028}\u{200B}"
  let bom = "\u{FEFF}x"
  let astral = "é😀"
  @console.print(show(three.split(on: aa)))
  @console.print(show(four.split(on: aa)))
  @console.print(show(commas.split(on: comma)))
  @console.print(show(empty.split(on: comma)))
  @console.print(show(lines.split(on: nl)))
  @console.print(show(mixed.split(on: a)))
  let rejoined = commas.split(on: comma).join(separator: comma)
  @console.print("{rejoined == commas}")
  @console.print(three.replace(pattern: aa, by: b))
  @console.print(four.replace(pattern: aa, by: empty))
  @console.print(abc.replace(pattern: c, by: smiles))
  @console.print("{abc.find(text: empty)} {empty.find(text: empty)} {empty.find(text: a)}")
  @console.print("{eee.find(text: e)} {aee.find(text: ee)} {ssb.find(text: b)}")
  @console.print("{abc.contains_text(part: empty)} {abc.ends_with(suffix: empty)} {e.ends_with(suffix: e)}")
  @console.print(upper.to_upper())
  @console.print(lower.to_lower())
  @console.print("{sharp.to_upper().len} {dotted.to_lower().len}")
  @console.print("[{lead.trim_start()}]")
  @console.print("[{trail.trim_end()}]")
  @console.print("[{bom.trim_start()}]")
  @console.print("{astral.bytes()} {astral.chars()} {astral.chars().len}")
  @console.print("{empty.chars()} {empty.bytes()} {empty.split(on: comma).len}")
