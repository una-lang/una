-- expect: every obligation refuted or unknown, none proven (spec/21 §4 rule 3: set and remove give no fact about other keys)
module main

pub other_key_kept(m: Map[Text, Int]) -> Bool
  requires m.has(key: "a")
  ensures result
=
  let edit n = m
  edit n.set(key: "b", value: 1)
  n.has(key: "a")

pub other_key_removed(m: Map[Text, Int]) -> Bool
  requires not m.has(key: "a")
  ensures not result
=
  let edit n = m
  edit n.set(key: "b", value: 1)
  n.has(key: "a")

pub with_keeps_receiver(m: Map[Text, Int]) -> Int
  ensures result == m.len
=
  let n = m.with(key: "z", value: 1)
  m.len

pub len_after_two_sets(m: Map[Text, Int]) -> Int
  requires m.len == 0
  ensures result == 1
=
  let edit n = m
  edit n.set(key: "a", value: 1)
  edit n.set(key: "a", value: 2)
  n.len

pub len_after_distinct_sets(m: Map[Text, Int]) -> Int
  requires m.len == 0
  ensures result == 2
=
  let edit n = m
  edit n.set(key: "a", value: 1)
  edit n.set(key: "b", value: 2)
  n.len
