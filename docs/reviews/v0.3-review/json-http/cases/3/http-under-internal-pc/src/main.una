module main

pub main() -> Unit
  uses @http: Http[get, post]
  uses @env: Env[get]
  uses @console: Console[print]
=
  let t = @env.get("T")
    if none use ""
  if t == "go"
    let r = @http.get("http://127.0.0.1:8765/", headers: [], key_name: None)
      if error use Response(status: 0, headers: [], body: "")
    @console.print("done")
  else
    @console.print("skip")
