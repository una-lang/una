module main

pub main() -> Unit
  uses @http: Http[get, post]
  uses @env: Env[get]
  uses @console: Console[print]
=
  let k = @env.get("K")
    if none use "a"
  let m: Map[Text, Int] = empty_map().with(key: "a", value: 1)
  if m.has(key: k)
    @console.print("yes")
  else
    @console.print("no")
