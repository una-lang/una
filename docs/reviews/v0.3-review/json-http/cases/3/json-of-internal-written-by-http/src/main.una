module main

pub main() -> Unit
  uses @http: Http[get, post]
  uses @env: Env[get]
  uses @console: Console[print]
=
  let t = @env.get("T")
    if none use ""
  let j = parse_json(t)
    if error use Null
  let r = @http.post("http://127.0.0.1:8765/", headers: [], body: j.to_json(), key_name: None)
    if error use Response(status: 0, headers: [], body: "")
  @console.print("sent")
