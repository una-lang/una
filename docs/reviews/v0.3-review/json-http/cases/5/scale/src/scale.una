module scale

pub main() -> Unit
  uses @files: Files[read, write]
  fails FileError
=
  let input = @files.read("in.json")
    if error pass
  let parsed = attempt parse_json(input)
  let out = when parsed
    is Ok(j) -> j.to_json()
    is Err(e) -> "{e}"
  @files.write("out.json", content: out)
    if error pass
