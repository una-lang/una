module timeout

pub main() -> Unit
  uses @http: Http[get]
  uses @files: Files[write]
  fails FileError
=
  let plain: List[Header] = []
  let r = attempt @http.get("http://127.0.0.1:8765/slow", headers: plain, key_name: None)
  let line = when r
    is Ok(response) -> "ok {response.status}"
    is Err(e) -> "failed {e}"
  @files.write("result.txt", content: line)
    if error pass
