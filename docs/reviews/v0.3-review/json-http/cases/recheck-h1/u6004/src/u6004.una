module u6004

--- A header value from the environment: a control character in it aborts the run with U6004
--- before anything is sent, alone and in a task of `together`.
pub main() -> Unit
  uses @http: Http[get]
  uses @env: Env[get]
  uses @console: Console[print]
=
  @console.print("before")
  let v = @env.get("V")
    if none use "ok"
  let mode = @env.get("MODE")
    if none use "plain"
  let header = Header(name: "X-Test", value: v)
  together
    let a = attempt @http.get("http://127.0.0.1:8765/json", headers: [header], key_name: None)
    let b = attempt @http.get("http://127.0.0.1:8765/json?second", headers: [], key_name: None)
  let fine = when a
    is Ok -> "a ok"
    is Err -> "a failed"
  @console.print("after")
