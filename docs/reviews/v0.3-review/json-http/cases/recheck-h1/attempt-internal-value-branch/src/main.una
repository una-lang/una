module main

pub main() -> Unit
  uses @http: Http[get]
  uses @env: Env[get]
  uses @console: Console[print]
=
  let v = @env.get("V")
    if none use "x"
  let r = attempt @http.get("http://127.0.0.1:8765/", headers: [Header(name: "a", value: v)], key_name: None)
  when r
    is Ok -> @console.print("y")
    is Err -> @console.print("n")
