module main

pub main() -> Unit
  uses @http: Http[get]
  uses @env: Env[get]
  uses @console: Console[print]
=
  let u = @env.get("U")
    if none use "http://127.0.0.1:8765/"
  together
    let a = attempt @http.get(u, headers: [], key_name: None)
    let b = attempt @http.get("http://127.0.0.1:8765/", headers: [], key_name: None)
  when a
    is Ok -> @console.print("y")
    is Err -> @console.print("n")
