module main

pub main() -> Unit
  uses @http: Http[post]
  uses @env: Env[get]
  uses @console: Console[print]
=
  let b = @env.get("B")
    if none use "x"
  let r = attempt @http.post("http://127.0.0.1:8765/", headers: [], body: b, key_name: None)
  when r
    is Ok -> @console.print("y")
    is Err -> @console.print("n")
