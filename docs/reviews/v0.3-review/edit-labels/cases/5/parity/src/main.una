-- expect: accepted, the same output in both engines
module main

pub kind Size = Small | Large

tally[T: Ord](xs: List[T]) -> Map[T, Int]
=
  let edit m = empty_map()
  for x in xs
    let n = m.get(key: x)
      if none use 0
    edit m.set(key: x, value: n + 1)
  m

group_by[K: Ord, T](xs: List[T], key: fn(T) -> K) -> Map[K, List[T]]
=
  let edit m = empty_map()
  for x in xs
    let k = key(x)
    let seen = m.get(key: k)
      if none use []
    edit m.set(key: k, value: seen.append(item: x))
  m

pub main() -> Unit
  uses @console: Console[print]
=
  let words = ["b", "a", "b", "é"]
  @console.print("{tally(words)}")
  @console.print("{tally([Large, Small, Large])}")
  @console.print("{group_by([1, 22, 3, 45], key: fn(n) -> n / 10)}")
  let edit best = None
  for x in [3, 9, 4]
    best = Some(x)
  @console.print("{best}")
