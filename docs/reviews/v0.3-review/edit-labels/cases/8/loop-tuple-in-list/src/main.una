module main

-- expect: rejected (U4003 or U4001): a tuple inside an open position, raised in a later iteration
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = []
  xs = xs.append(item: (0, 0))
  for i in 0..<2
    let pair = xs.at(index: i).or_else(default: (0, 0))
    let (a, b) = pair
    @console.print("{b}")
    xs = xs.append(item: (0, s.len))
