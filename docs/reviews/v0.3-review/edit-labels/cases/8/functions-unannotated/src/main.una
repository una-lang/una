module main

-- expect: U4001 annotate: a resolved position holds a function, so its labels cannot all be variables
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit fs = []
  fs = fs.append(item: fn(x: Int) -> x + 1)
  @console.print("{fs.len}")
