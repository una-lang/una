-- expect: rejected (U4003): tally's counts carry T*, read through a generic wrapper and a map of maps
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let outer = nest([s, "a", s])
  let inner = outer.get(key: 0)
    if none use empty_map()
  let n = inner.get(key: "a")
    if none use 0
  @console.print("{n}")

nest[T: Ord](xs: List[T]) -> Map[Int, Map[T, Int]]
=
  let edit m = empty_map()
  edit m.set(key: 0, value: tally(xs))
  m

tally[T: Ord](xs: List[T]) -> Map[T, Int]
=
  let edit m = empty_map()
  for x in xs
    let n = m.get(key: x)
      if none use 0
    edit m.set(key: x, value: n + 1)
  m
