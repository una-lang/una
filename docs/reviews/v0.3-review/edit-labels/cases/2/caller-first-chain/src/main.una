-- expect: rejected (U4003): three generic levels, callers declared before callees, each through a label variable
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let r = top(s)
  @console.print("{r}")

top[T](x: T) -> List[T]
=
  let edit acc = []
  acc = middle(x)
  acc

middle[T](x: T) -> List[T]
=
  let edit acc = []
  for y in bottom(x)
    acc = acc.append(item: y)
  acc

bottom[T](x: T) -> List[T]
=
  let edit acc = []
  acc = acc.append(item: x)
  acc
