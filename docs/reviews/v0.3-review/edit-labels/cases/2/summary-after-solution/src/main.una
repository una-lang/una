-- expect: rejected (U4003): g's result carries T only once its label variables are solved through h's summary, after a read
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let r = g(s)
  @console.print("{r}")

g[T](x: T) -> List[T]
=
  let edit out = []
  let edit tmp = []
  out = tmp
  tmp = h(x)
  out = tmp
  out

h[T](x: T) -> List[T] = [x]
