-- expect: rejected (U4003): an internal Json value stored in a map built by label variables
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "1"
  let doc = s.parse_json()
    if error use Null
  let edit fields = empty_map()
  edit fields.set(key: "x", value: doc)
  @console.print(to_json(Object(fields: fields)))
