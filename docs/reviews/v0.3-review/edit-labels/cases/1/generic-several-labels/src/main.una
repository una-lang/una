-- expect: rejected (U4003) for the internal instance only; the public instance prints
module main

collect[T](xs: List[T]) -> List[T]
=
  let edit out = []
  for x in xs
    out = out.append(item: x)
  out

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let public_list = collect(["a", "b"])
  let internal_list = collect([s])
  @console.print("{public_list}")
  @console.print("{internal_list}")
