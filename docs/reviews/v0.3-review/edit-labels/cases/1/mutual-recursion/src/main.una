-- expect: rejected (U4003): label variables of mutually recursive generic functions feed each other
module main

evens[T](xs: List[T], n: Int) -> List[T]
=
  let edit out = []
  if n > 0 and xs.len > 0
    for x in odds(xs, n: n - 1)
      out = out.append(item: x)
  out

odds[T](xs: List[T], n: Int) -> List[T]
=
  let edit out = []
  for x in xs
    out = out.append(item: x)
  for y in evens(xs, n: n - 1)
    out = out.append(item: y)
  out

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let r = evens([s], n: 3)
  @console.print("{r}")
