-- expect: rejected (U4003): an internal value flows back through three edit levels into a label variable
module main

one(edit m: Map[Text, internal Int], v: internal Int) -> Unit
=
  edit m.set(key: "k", value: v)

two(edit m: Map[Text, internal Int], v: internal Int) -> Unit
=
  one(edit m, v: v)

three(edit m: Map[Text, internal Int], v: internal Int) -> Unit
=
  two(edit m, v: v)

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit m = empty_map()
  let before = m.get(key: "k")
    if none use 0
  three(edit m, v: s.len)
  @console.print("{before}")
