-- expect: rejected (U4003): an internal element of a list stored as a map value reaches Console
module main

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit m = empty_map()
  edit m.set(key: "a", value: [1])
  edit m.set(key: "b", value: [s.len])
  let xs = m.get(key: "a")
    if none use []
  let first = xs.first().or_else(default: 0)
  @console.print("{first}")
