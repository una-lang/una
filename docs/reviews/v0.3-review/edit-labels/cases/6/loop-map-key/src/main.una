module main

-- expect: rejected (U4001 or U4003): a map key raised in a loop
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit m = empty_map()
  for i in 0..<2
    @console.print("{m.len}")
    edit m.set(key: s, value: i)
