module main

-- expect: rejected (U4003) once N-44 opens nested positions: the Err side inside a list
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use "x"
  let edit xs = []
  xs = xs.append(item: Ok(0))
  for i in 0..<2
    let r = xs.at(index: i).or_else(default: Ok(0))
    @console.print("{r}")
    xs = xs.append(item: Err(s.len))
