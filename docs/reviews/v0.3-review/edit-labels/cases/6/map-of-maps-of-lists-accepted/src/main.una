-- expect: accepted (N-44): a list two maps deep rises to what flows in
module main

pub f(v: internal Int) -> internal Int
=
  let edit m = empty_map()
  edit m.set(key: 0, value: empty_map().with(key: "a", value: [1]))
  edit m.set(key: 1, value: empty_map().with(key: "b", value: [v]))
  let inner = m.get(key: 0)
    if none use empty_map()
  let xs = inner.get(key: "a")
    if none use []
  xs.first().or_else(default: 0)
