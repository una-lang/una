-- expect: accepted (N-44): the element label of a list stored in a map rises to what flows in
module main

pub f(v: internal Int) -> internal Int
=
  let edit m = empty_map()
  edit m.set(key: "a", value: [1])
  edit m.set(key: "b", value: [v])
  let xs = m.get(key: "a")
    if none use []
  xs.first().or_else(default: 0)
