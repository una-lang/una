-- expect: accepted: label variables let these check, each result carrying what flowed in
module main

pub raised(v: internal Int) -> internal Int
=
  let edit m = empty_map()
  edit m.set(key: "a", value: v)
  let n = m.get(key: "a")
    if none use 0
  n

pub public_stays_public() -> Int
=
  let edit xs = []
  xs = xs.append(item: 1)
  xs.len

pub list_of_internal(v: internal Int) -> List[internal Int]
=
  let edit xs = []
  xs = xs.append(item: v)
  xs
