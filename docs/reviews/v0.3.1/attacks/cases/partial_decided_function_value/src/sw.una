-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](a: T, b: T, p: T, k1: fn(T) -> Int, k2: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write([p].map(each: if a == b then k1 else k2).sum())

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g(s, b: 0, p: 0, k1: fn(n) -> 1, k2: fn(n) -> 0)
