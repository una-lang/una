-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](a: T, b: T, p: T, q: T, k: fn(Int, T) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write([p, q].fold(initial: if a == b then 1 else 0, step: k))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(n, xs) -> n)
