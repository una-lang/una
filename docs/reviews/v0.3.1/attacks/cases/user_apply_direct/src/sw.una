-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

apply[U](x: U, f: fn(U) -> Int) -> Int = f(x)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(apply(if a == b then p else q, f: k))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
