-- expect: U3009
module sw

pub capability Log
  op write(n: Int) -> Unit

kind Bad = | Oops

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int fails Bad) -> Unit
  uses @log: Log[write]
=
  @log.write([if a == b then p else q].map(each: k).sum())

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
