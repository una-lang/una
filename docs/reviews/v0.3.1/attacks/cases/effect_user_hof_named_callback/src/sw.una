-- expect: U4002
module sw

pub capability Log
  op write(n: Int) -> Unit

apply_eff[U](x: U, f: fn(U) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  f(x)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  apply_eff(if a == b then p else q, f: k)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> @log.write(xs.len))
