-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

my_map[U](xs: List[U], f: fn(U) -> Int) -> List[Int] = xs.fold(initial: [], step: fn(acc, x) -> acc.append(f(x)))

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let ns = my_map([if a == b then p else q], f: k)
  @log.write(ns.sum())

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
