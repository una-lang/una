-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

total(xs: List[Int], f: fn(Int) -> Int) -> Int = xs.map(each: f).sum()

g[T](a: T, b: T, h: fn(Int) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(total([if a == b then 1 else 0], f: h))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g(s, b: 0, h: fn(n) -> n)
