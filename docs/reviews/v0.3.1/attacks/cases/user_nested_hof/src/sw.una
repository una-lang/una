-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

inner[U](xs: List[U], f: fn(U) -> Int) -> Int = xs.map(each: f).sum()

outer[V](xs: List[V], f: fn(V) -> Int) -> Int = inner(xs, f: f)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(outer([if a == b then p else q], f: k))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
