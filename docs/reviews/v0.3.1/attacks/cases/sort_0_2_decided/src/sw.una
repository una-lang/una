-- expect: U4001 or U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write([if a == b then 1 else 0, 2].sort().sum())

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
