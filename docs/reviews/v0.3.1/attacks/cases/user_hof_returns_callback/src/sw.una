-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

pick[U](x: U, f: fn(U) -> Int) -> fn(U) -> Int = f

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let d = if a == b then p else q
  let h = pick(d, f: k)
  @log.write([d].map(each: h).sum())

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
