-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let f = fn(x: T) -> k(x)
  @log.write([if a == b then p else q].map(each: f).sum())

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
