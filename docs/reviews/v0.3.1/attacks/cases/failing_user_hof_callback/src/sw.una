-- expect: U4002
module sw

pub capability Log
  op write(n: Int) -> Unit

kind Bad = | Oops

apply_f[U](x: U, f: fn(U) -> Int fails Bad) -> Int
  fails Bad
=
  f(x)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int fails Bad) -> Unit
  uses @log: Log[write]
=
  let n = attempt apply_f(if a == b then p else q, f: k)
  @log.write(1)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
