-- expect: U4003
module sw

pub capability Log
  op write(n: Int) -> Unit

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let xs = [p]
  let ys = [if a == b then p else q]
  @log.write(xs.map(each: k).sum() + ys.map(each: k).sum())

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
