-- expect: leak (U4003 expected): run form; map with one of two lambdas annotated `x: T`, chosen by an `if`
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int, c: Bool) -> Unit
  uses @log: Log[write]
=
  let ns = [if a == b then p else q].map(each: if c then fn(x: T) -> k(x) else fn(x: T) -> 0)
  @log.write(ns.sum())

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], p: [], q: [1], k: fn(xs) -> xs.len, c: true)
