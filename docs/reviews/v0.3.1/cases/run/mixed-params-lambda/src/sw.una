-- expect: leak (U4002 expected): run form; a lambda whose first parameter is inferred and takes the decision, and whose second is annotated `x: T` and drops it
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

apply_eff[U](x: U, f: fn(U) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  f(x)

mix[U, W](w: W, x: U, f: fn(W, U) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(f(w, x))

g[T](a: T, b: T, p: T, q: T, len_of: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  mix(if a == b then 1 else 0, x: if a == b then p else q, f: fn(c, x: T) -> len_of(x))

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], p: [], q: [1], len_of: fn(xs) -> xs.len)
