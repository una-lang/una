-- expect: leak (U4002 expected): run form; a pure callback's result on a decided value decides the generic callee's own failure
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

kind Bad = | Oops

apply_f[U](x: U, f: fn(U) -> Int) -> Int
  fails Bad
=
  if f(x) > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Int
  uses @log: Log[write]
  fails Bad
=
  let n = apply_f(if a == b then p else q, f: k)
    if error pass
  @log.write(1)
  2

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  let r = g([v], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
    if error use 3
  @log.write(5)
