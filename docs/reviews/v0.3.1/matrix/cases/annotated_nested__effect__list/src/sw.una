-- expect: reject: the callee calls an annotated lambda from a list argument and writes it
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

logger_list[U](x: U, fs: List[fn(U) -> Int]) -> Unit
  uses @log: Log[write]
=
  let n = when fs.first()
    is Some(f) -> f(x)
    is None -> 0
  @log.write(n)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  logger_list(if a == b then p else q, fs: [fn(x: T) -> k(x)])

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
