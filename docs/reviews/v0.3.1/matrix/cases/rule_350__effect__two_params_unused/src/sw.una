-- expect: reject: two type parameters: the decided argument goes to a parameter the callback never sees (conservative)
module sw

pub capability Log
  op write(n: Int) -> Unit

two[U, W](x: U, y: W, f: fn(U) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(f(x))

g[T, V](a: T, b: T, c: V, e: V, k: fn(V) -> Int) -> Unit
  uses @log: Log[write]
=
  two(c, y: if a == b then a else b, f: k)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g(s, b: 0, c: [], e: [1], k: fn(xs) -> xs.len)
