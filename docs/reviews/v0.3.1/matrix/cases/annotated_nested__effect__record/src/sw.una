-- expect: reject: the callee calls an annotated lambda from a record argument and writes it
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

logger_box[U](x: U, box: Box[U]) -> Unit
  uses @log: Log[write]
=
  let f = box.run
  @log.write(f(x))

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  logger_box(if a == b then p else q, box: Box(run: fn(x: T) -> k(x)))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
