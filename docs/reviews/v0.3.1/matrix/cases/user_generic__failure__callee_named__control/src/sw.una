-- expect: accept: control: failer(decided, f: k): the callee fails on the pure callback's result
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

failer[U](x: U, f: fn(U) -> Int) -> Int
  fails Bad
=
  if f(x) > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Int
  uses @log: Log[write]
  fails Bad
=
  let n = failer(p, f: k)
    if error pass
  @log.write(1)
  2

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  let r = g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
    if error use 3
  @log.write(5)
