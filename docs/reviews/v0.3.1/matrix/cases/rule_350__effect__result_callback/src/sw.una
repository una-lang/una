-- expect: reject: the callee calls a pure callback from a Result argument and writes it
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

logger_res[U](x: U, f: Result[fn(U) -> Int, Int]) -> Unit
  uses @log: Log[write]
=
  let n = when f
    is Ok(h) -> h(x)
    is Err(e) -> e
  @log.write(n)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  logger_res(if a == b then p else q, f: Ok(k))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
