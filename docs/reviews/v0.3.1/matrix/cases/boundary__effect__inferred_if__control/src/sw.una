-- expect: accept: control: inferred lambdas joined by an if
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

logger[U](x: U, f: fn(U) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(f(x))

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int, c: Bool) -> Unit
  uses @log: Log[write]
=
  logger(p, f: if c then fn(x) -> k(x) else fn(x) -> 0)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len, c: true)
