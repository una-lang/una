-- expect: accept: an example of a generic higher-order function
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

apply[U](x: U, f: fn(U) -> Int) -> Int = f(x)

example "apply on lists"
  do apply([1], f: fn(xs) -> xs.len)
  expect result == 1
