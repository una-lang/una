-- expect: accept: control: an annotated lambda whose body maps an inferred lambda over its parameter
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let n = [p].map(each: fn(x: T) -> [x].map(each: fn(y) -> k(y)).sum()).sum()
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
