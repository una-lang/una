-- expect: reject: the same, in parentheses
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

mix[U, W](w: W, x: U, f: fn(W, U) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(f(w, x))

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  mix(if a == b then 1 else 0, x: if a == b then p else q, f: (fn(c, x: T) -> k(x)))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
