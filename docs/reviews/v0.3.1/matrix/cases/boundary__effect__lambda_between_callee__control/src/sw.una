-- expect: accept: control: the same with a pure lambda, and the callee writes its result
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

same_p[U](x: U, f: fn(U) -> Int, y: U) -> Unit
  uses @log: Log[write]
=
  @log.write(f(y))

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  same_p(p, f: fn(z) -> k(z), y: p)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
