-- expect: rule: control: an inferred lambda that passes its parameter through a generic identity; D-137 labels `ident(x)` with `T`, so the lambda's public result is U4001 with or without the decision: the identity raises, it does not launder
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

ident[V](v: V) -> V = v

logger[U](x: U, f: fn(U) -> Int) -> Unit
  uses @log: Log[write]
=
  @log.write(f(x))

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  logger(p, f: fn(x) -> k(ident(x)))

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
