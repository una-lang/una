-- expect: reject: map with an annotated lambda through nested_wrappers
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int, c: Bool) -> Unit
  uses @log: Log[write]
=
  let n = [if a == b then p else q].map(each: ((if c then (fn(x: T) -> k(x)) else (fn(x: T) -> 0)))).sum()
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len, c: true)
