-- expect: rule: control: a function returned by a generic function, called with the decision
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

pass_on[V](f: fn(V) -> Int) -> fn(V) -> Int = f

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let h = pass_on(k)
  let n = h(p)
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
