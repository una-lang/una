-- expect: accept: control: an inferred lambda checked after an undecided argument solved its parameter, before the decided one
module sw

pub capability Log
  op write(n: Int) -> Unit

pub kind Bad = | Oops

pub kind Box[T]
  run: fn(T) -> Int

pub kind Hold[T]
  value: T

check_len(xs: List[secret Int]) -> Int
  fails Bad
=
  if xs.len > 0 then fail Oops else 0

same[U](x: U, f: fn(U) -> Unit uses @log: Log[write], y: U) -> Unit
  uses @log: Log[write]
=
  f(y)

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Unit uses @log: Log[write]) -> Unit
  uses @log: Log[write]
=
  same(p, f: fn(z) -> k(z), y: p)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> @log.write(xs.len))
