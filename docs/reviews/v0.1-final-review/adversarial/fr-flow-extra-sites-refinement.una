-- Adversarial: refinement flow sites outside the closure matrix: operation argument, handler instance argument, failure payload, `attempt` then a pattern on the payload, `if error use` default, and `given`
-- Expected: U5001 at each
-- Observed: U5001 at each
-- Verdict: Held
module fr_flow_extra_sites_refinement

pub kind Pos = Int where it > 0

pub kind Bad = Broke(n: Pos) | Other

capability Div
  op run(n: Pos) -> Int

handler fixed(d: Pos) for Div
  op run(n) = 100 / d + 100 / n

zero() -> Int = 0

pub op_arg() -> Int
  uses @div: Div[run]
=
  @div.run(zero())

pub handler_arg() -> Int
=
  op_arg() with @div = fixed(zero())

pub fails_with() -> Int
  fails Bad
=
  fail Broke(n: zero())

pub caught() -> Int
=
  let r = attempt fails_with()
  when r
    is Ok(v) -> v
    is Err(e) ->
      when e
        is Broke(n) -> 100 / n
        is Other -> 0

pub defaulted() -> Pos
=
  let v: Pos = fails_with()
    if error use zero()
  v

example "a fixed handler given a zero"
  given @div = fixed(zero())
  do op_arg()
  expect result == 0
