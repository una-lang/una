trusted module release

pub kind Pos = Int where it > 0

pub kind Small = Int where it > 0 and it < 10

pub kind Alias = Pos

pub kind Tight = Pos where it < 10

pub policy to_alias
  from internal Int
  to public Pos
  via as_alias
  purpose "alias result"
  owner ops

pub policy from_tight
  from internal Pos
  to public Pos
  via take_tight
  purpose "tighter parameter through an alias with its own where"
  owner ops

pub policy from_small
  from internal Pos
  to public Pos
  via take_small
  purpose "a different refined kind with a stronger predicate"
  owner ops

pub policy generic_via
  from internal Int
  to public Int
  via pass_any
  purpose "generic via"
  owner ops

as_alias(n: internal Int) -> public Alias = if n > 0 then n else 1

take_tight(n: internal Tight) -> public Pos = 100 / (10 - n)

take_small(n: internal Small) -> public Pos = 100 / (10 - n)

pass_any[T](n: T) -> T = n
