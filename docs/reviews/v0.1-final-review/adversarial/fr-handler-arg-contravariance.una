-- Adversarial: control for F-001: the same values passed as handler instance arguments
-- Expected: U4001 at each
-- Observed: U4001 at each
-- Verdict: Held
module fr_handler_arg_contravariance

kind Sink[T]
  eat: fn(T) -> Int

capability Keeper
  op open() -> Int

handler holding(pin: secret Int, f: fn(secret Int) -> Int) for Keeper
  op open() = f(pin)

handler sinking(pin: secret Int, s: Sink[secret Int]) for Keeper
  op open() = s.eat(pin)

made() -> Sink[Int] = Sink(eat: fn(x: Int) -> x)

ident(x: Int) -> Int = x

pub peek() -> Int
  uses @keeper: Keeper[open]
=
  @keeper.open()

pub by_fn(pin: secret Int) -> Int
=
  peek() with @keeper = holding(pin, f: ident)

pub by_kind(pin: secret Int) -> Int
=
  peek() with @keeper = sinking(pin, s: made())
