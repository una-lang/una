-- Adversarial: ADR 0046 variance through a generic alias of a function type, a nested invariant kind, `Option` of a function, a sum variant, a recursive sum, the second of two parameters and mutually recursive kinds; each value is built at `K[Int]` by a factory and flows into `K[secret Int]`
-- Expected: U4001 at each annotated `let`; `direct` builds the value for its expected type (D-163) and must fail at the lambda parameter
-- Observed: U4001 at all seven, and at the lambda parameter in `direct`
-- Verdict: Held
module fr_variance_forms

kind Eat[T] = fn(T) -> Int

kind ViaAlias[T]
  eat: Eat[T]

kind Sink[T]
  eat: fn(T) -> Int

kind Outer[T]
  inner: Sink[T]

kind InOption[T]
  eat: Option[fn(T) -> Int]

kind Variant[T] = Feed(eat: fn(T) -> Int) | Empty

kind Chain[T] = Link(next: Option[Chain[T]], here: T) | End(eat: fn(T) -> Int)

kind Pair[A, B]
  left: A
  right: fn(B) -> Int

kind Mutual[T]
  other: Option[Back[T]]

kind Back[T]
  eat: fn(T) -> Int
  more: Option[Mutual[T]]

alias_made() -> ViaAlias[Int] = ViaAlias(eat: fn(x: Int) -> x)

outer_made() -> Outer[Int] = Outer(inner: Sink(eat: fn(x: Int) -> x))

option_made() -> InOption[Int] = InOption(eat: Some(fn(x: Int) -> x))

variant_made() -> Variant[Int] = Feed(eat: fn(x: Int) -> x)

chain_made() -> Chain[Int] = Link(next: Some(End(eat: fn(x: Int) -> x)), here: 1)

pair_made() -> Pair[Int, Int] = Pair(left: 1, right: fn(x: Int) -> x)

mutual_made() -> Mutual[Int] = Mutual(other: Some(Back(eat: fn(x: Int) -> x, more: None)))

pub by_alias(pin: secret Int) -> Int
=
  let s: ViaAlias[secret Int] = alias_made()
  s.eat(pin)

pub by_outer(pin: secret Int) -> Int
=
  let o: Outer[secret Int] = outer_made()
  o.inner.eat(pin)

pub by_option(pin: secret Int) -> Int
=
  let s: InOption[secret Int] = option_made()
  let f = s.eat
    if none use fn(x: secret Int) -> 0
  f(pin)

pub by_variant(pin: secret Int) -> Int
=
  let v: Variant[secret Int] = variant_made()
  when v
    is Feed(eat) -> eat(pin)
    is Empty -> 0

pub by_recursive(pin: secret Int) -> Int
=
  let c: Chain[secret Int] = chain_made()
  0

pub by_second_param(pin: secret Int) -> Int
=
  let p: Pair[Int, secret Int] = pair_made()
  p.right(pin)

pub by_mutual(pin: secret Int) -> Int
=
  let m: Mutual[secret Int] = mutual_made()
  0

pub direct(pin: secret Int) -> Int
=
  let s: Sink[secret Int] = Sink(eat: fn(x: Int) -> x)
  s.eat(pin)
