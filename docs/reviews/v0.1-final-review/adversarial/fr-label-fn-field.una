-- Adversarial: D-168: a function value chosen under a secret branch stored in a record field, in a generic `Box`, next to a data field, and sent to an operation; a lambda capturing the secret
-- Expected: U4001 at each field or let
-- Observed: U4001 at each
-- Verdict: Held
module fr_label_fn_field

kind Rec
  get: fn() -> Int

kind Data
  n: Int
  get: fn() -> Int

kind Box[T]
  value: T

capability Out
  op send(r: Rec) -> Unit
    accepts public

pub chosen(pin: secret Int) -> Rec
=
  let f = if pin == 1234 then fn() -> 1 else fn() -> 0
  Rec(get: f)

pub field_call(pin: secret Int) -> Int
=
  let r = chosen(pin)
  r.get()

pub in_box(pin: secret Int) -> Int
=
  let f = if pin == 1234 then fn() -> 1 else fn() -> 0
  let b = Box(value: f)
  let g: fn() -> Int = b.value
  g()

pub with_data(pin: secret Int) -> Bool
=
  let f = if pin == 1234 then fn() -> 1 else fn() -> 0
  let d = Data(n: 1, get: f)
  d.n == 1

pub to_sink(pin: secret Int) -> Unit
  uses @out: Out[send]
=
  let f = if pin == 1234 then fn() -> 1 else fn() -> 0
  @out.send(Rec(get: f))

pub captured(pin: secret Int) -> Unit
  uses @out: Out[send]
=
  @out.send(Rec(get: fn() -> pin))
