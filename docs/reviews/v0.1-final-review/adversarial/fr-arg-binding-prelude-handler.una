-- Adversarial: ADR 0049 for prelude functions (`starts_with`, `contains`, `at`) whose first argument is named like their second parameter, and for handler instance arguments in `with` and `given`
-- Expected: U2006 at each swapped call
-- Observed: as expected
-- Verdict: Held
module fr_arg_binding_prelude_handler

capability Calc
  op sub(a: Int, b: Int) -> Int

handler offset(b: Int, a: Int) for Calc
  op sub(x, y) = x - y + a - b

pub starts(prefix: Text, t: Text) -> Bool = starts_with(prefix, t)

pub has(item: List[Text], xs: Text) -> Bool = contains(item, xs)

pub at_swap(index: List[Int], xs: Int) -> Option[Int] = at(index, xs)

pub handler_args(a: Int, b: Int) -> Int
  uses @calc: Calc[sub]
=
  @calc.sub(a, b: b)

pub installed(a: Int, b: Int) -> Int
=
  handler_args(a, b: b) with @calc = offset(a, b)

example "handler arguments swap"
  given @calc = offset(1, b: 2)
  do handler_args(10, b: 3)
  expect result == 6
