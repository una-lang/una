-- Adversarial: control for F-001: a failing function passed where an operation declares a pure `fn() -> Int`
-- Expected: U3009
-- Observed: U3009
-- Verdict: Held
module fr_op_arg_fn_fails

pub kind Bad = Broke | Other

capability Runner
  op pure(f: fn() -> Int) -> Int

handler running() for Runner
  op pure(f) = f()

failing() -> Int
  fails Bad
=
  fail Broke

pub by_failing() -> Int
  uses @run: Runner[pure]
=
  @run.pure(failing)
