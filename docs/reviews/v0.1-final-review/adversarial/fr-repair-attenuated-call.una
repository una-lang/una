-- Adversarial: issue #69 (UI-005) beyond the operation site: U3002 at a call whose callee needs an operation the attenuated `@front` lacks while `@back` permits it; two permitting bindings; a lambda
-- Expected: rank 1 uses the binding that permits the operation (`with @front = @back`), widening at rank 2 at most (issue #69: no rank-1 widening when an alternative exists)
-- Observed: at the call site the only repair, at rank 1, widens `@front`; the operation site ranks `@back` first (alphabetical choice among two)
-- Verdict: Minor (F-002)
module fr_repair_attenuated_call

pub capability Shelf
  op stock(count: Int) -> Unit
  op unstock(count: Int) -> Unit

pub put_back(count: Int) -> Unit
  uses @front: Shelf[unstock]
=
  @front.unstock(count)

pub by_call(count: Int) -> Unit
  uses @front: Shelf[stock]
  uses @back: Shelf[unstock]
=
  put_back(count)

pub two_permit(count: Int) -> Unit
  uses @front: Shelf[stock]
  uses @side: Shelf[unstock]
  uses @back: Shelf[unstock]
=
  @front.unstock(count)

pub in_lambda(count: Int) -> Unit
  uses @front: Shelf[stock]
  uses @back: Shelf[unstock]
=
  let f = fn(n: Int) -> @front.unstock(n)
  f(count)
