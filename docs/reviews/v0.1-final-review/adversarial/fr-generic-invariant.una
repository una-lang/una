-- Adversarial: D-161 and D-166: generic functions over an invariant kind, unified in both argument orders, through an identity, a generic `feed`, an `Option` and `let`-bound generic function values
-- Expected: U4001 at each flow
-- Observed: U4001 at each
-- Verdict: Held
module fr_generic_invariant

kind Sink[T]
  eat: fn(T) -> Int

made() -> Sink[Int] = Sink(eat: fn(x: Int) -> x)

pick[T](a: Sink[T], b: Sink[T]) -> Sink[T] = a

same[T](s: Sink[T]) -> Sink[T] = s

feed[T](s: Sink[T], v: T) -> Int = s.eat(v)

wrap[T](v: T) -> Option[T] = Some(v)

pub unify_first(pin: secret Int) -> Int
=
  let typed: Sink[secret Int] = Sink(eat: fn(x: secret Int) -> 0)
  let s = pick(made(), b: typed)
  s.eat(pin)

pub unify_second(pin: secret Int) -> Int
=
  let typed: Sink[secret Int] = Sink(eat: fn(x: secret Int) -> 0)
  let s = pick(typed, b: made())
  s.eat(pin)

pub through_id(pin: secret Int) -> Int
=
  let s: Sink[secret Int] = same(made())
  s.eat(pin)

pub through_feed(pin: secret Int) -> Int = feed(made(), v: pin)

pub through_option(pin: secret Int) -> Int
=
  let o: Option[Sink[secret Int]] = wrap(made())
  0

pub through_value(pin: secret Int) -> Int
=
  let f = same
  let s: Sink[secret Int] = f(made())
  s.eat(pin)

pub through_value_feed(pin: secret Int) -> Int
=
  let g = feed
  g(made(), pin)
