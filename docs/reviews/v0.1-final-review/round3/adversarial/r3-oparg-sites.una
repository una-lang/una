-- Adversarial: ADR 0050 rule 3 sites: the F-001 argument in a function body installed with `with`, in a handler operation body (`uses` in the handler), and in an example `do` line under `given`
-- Expected: U4001 at each site
-- Observed: U4001 at all 3
-- Verdict: Held
module r3_oparg_sites

capability Probe
  op apply(f: fn(secret Int) -> Int) -> Int

capability Relay
  op forward(n: Int) -> Int

handler holding(pin: secret Int) for Probe
  op apply(f) = f(pin)

handler relaying() for Relay
  uses @p: Probe[apply]
  op forward(n) = @p.apply(ident)

ident(x: Int) -> Int = x

pub direct() -> Int
  uses @p: Probe[apply]
=
  @p.apply(ident)

pub installed(pin: secret Int) -> Int
=
  direct() with @p = holding(pin)

example "a do line performs the operation"
  given @p = holding(1)
  do @p.apply(ident)
  expect result == 1
