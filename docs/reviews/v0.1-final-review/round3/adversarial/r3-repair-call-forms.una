-- Adversarial: F-002: U3002 at a call whose callee needs an operation that another binding permits, as a whole statement, in a `let`, nested in an expression, and with no alternative
-- Expected: rank 1 `with @front = @back` and rank 2 widening where the alternative exists; widening only otherwise
-- Observed: as expected; the nested call is also U3013, so it cannot be a statement anyway; applying each rank-1 edit gives a program that checks
-- Verdict: Held
module r3_repair_call_forms

pub capability Shelf
  op stock(count: Int) -> Int
  op unstock(count: Int) -> Int

pub put_back(count: Int) -> Int
  uses @front: Shelf[unstock]
=
  @front.unstock(count)

pub whole(count: Int) -> Int
  uses @front: Shelf[stock]
  uses @back: Shelf[unstock]
=
  put_back(count)

pub in_let(count: Int) -> Int
  uses @front: Shelf[stock]
  uses @back: Shelf[unstock]
=
  let n = put_back(count)
  n + 1

pub nested(count: Int) -> Int
  uses @front: Shelf[stock]
  uses @back: Shelf[unstock]
=
  put_back(count) + 1

pub no_alternative(count: Int) -> Int
  uses @front: Shelf[stock]
=
  put_back(count)
