-- Adversarial: ADR 0050 rule 2 positive controls: secret data in `Int`, `Box[Int]` and `List[Int]` parameters of an operation that accepts `secret`; a `let`-bound lambda with a secret result; a public function at a public parameter; a second-order parameter; `Files.write` with `internal` content
-- Expected: accepted, and `una run` prints `n = 2`; `result_label_inline` passes the same lambda inline
-- Observed: all accepted and run, except `result_label_inline`, U4001 at the lambda result, as at 879c26a: the lambda is checked against the declared type before ADR 0050's view (R3-N1)
-- Verdict: Held (Note R3-N1)
module r3_oparg_data_accepted

kind Box[T]
  value: T

capability Store
  op keep(n: Int) -> Unit
    accepts secret
  op boxed(b: Box[Int]) -> Unit
    accepts secret
  op listed(xs: List[Int]) -> Unit
    accepts secret
  op later(f: fn() -> Int) -> Int
    accepts secret
  op plain(f: fn(Int) -> Int) -> Int
  op nested(f: fn(fn(secret Int) -> Int) -> Int) -> Int
    accepts secret

handler keeping() for Store
  op keep(n) = unit
  op boxed(b) = unit
  op listed(xs) = unit
  op later(f) = 0
  op plain(f) = f(2)
  op nested(f) = 0

ident(x: Int) -> Int = x

apply_one(g: fn(Int) -> Int) -> Int = g(1)

pub data(pin: secret Int) -> Unit
  uses @store: Store[keep, boxed, listed]
=
  @store.keep(pin)
  @store.boxed(Box(value: pin))
  @store.listed([pin])

pub result_label(pin: secret Int) -> Int
  uses @store: Store[later]
=
  let f = fn() -> pin
  @store.later(f)

pub result_label_inline(pin: secret Int) -> Int
  uses @store: Store[later]
=
  @store.later(fn() -> pin)

pub plain_fn() -> Int
  uses @store: Store[plain, nested]
=
  let a = @store.plain(ident)
  let b = @store.nested(apply_one)
  a + b

pub write(code: internal Int) -> Unit
  uses @files: Files[write]
=
  @files.write("out.txt", content: "{code}")
    if error use unit

pub main() -> Unit
  uses @console: Console[print]
=
  let n = plain_fn() with @store = keeping()
  @console.print("n = {n}")
