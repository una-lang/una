-- Adversarial: structural functions in generic functions: a count, a search, a mapping and a counting fold by `x == y`, the issue #89 `concat`, and their calls with secret data
-- Expected: U4001 at the lambdas that read `label(T)`; `flags` may carry `label(T)` in its declared result (rule 8) and its call is caught; `concat` accepted, and its call raised by D-137
-- Observed: as expected
-- Verdict: Held
module v11_structural_generic

count[T](xs: List[T], y: T) -> Int = xs.filter(keep: fn(x) -> x == y).len

found[T](xs: List[T], y: T) -> Bool = xs.first_where(keep: fn(x) -> x == y) is Some

flags[T](xs: List[T], y: T) -> List[Bool] = xs.map(each: fn(x) -> x == y)

hits[T](xs: List[T], y: T) -> Int = xs.fold(initial: 0, step: fn(n, x) -> if x == y then n + 1 else n)

concat[T](front: List[T], back: List[T]) -> List[T] = back.fold(initial: front, step: fn(acc, x) -> acc.append(item: x))

pub use_flags(pins: List[secret Int]) -> Int
=
  let fs = flags(pins, y: 1234)
  fs.filter(keep: fn(b) -> b).len

pub use_concat(pins: List[secret Int]) -> List[Int] = concat(pins, back: [1])
