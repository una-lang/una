-- Adversarial: intermediate directory links, relative and absolute, inside and outside the
-- grant, and `..` after a link component (ADR 0038 D9 rules 1 and 2, spec/14 §3).
-- Setup (from this directory): `mkdir -p box/sub outside && echo top > box/a.txt &&
-- echo inside > box/sub/f.txt && echo secret > outside/secret.txt && ln -s sub box/in &&
-- ln -s "$PWD/box/sub" box/inabs && ln -s ../outside box/out && ln -s "$PWD/outside" box/outabs`
-- Expected: links that resolve inside `box` are followed (`ok`); links that resolve outside are
-- `Denied` for read and write; `x/..` is normalized lexically before any link is followed, so
-- `out/../a.txt` names `box/a.txt` (rule 1); nothing is created under `outside/`.
-- Observed (`una run`, macOS APFS): in/f.txt ok, inabs/f.txt ok, out/secret.txt denied,
-- outabs/secret.txt denied, write out/new.txt denied, write outabs/new.txt denied, write
-- in/new.txt ok (created box/sub/new.txt), out/../a.txt ok, in/../a.txt ok, write
-- out/../w.txt ok (created box/w.txt), sub/../../outside/secret.txt denied. Nothing created in
-- `outside/`.
-- Verdict: Held
module inter

describe(e: FileError) -> Text
=
  when e
    is NotFound -> "notfound"
    is Denied -> "denied"
    is Io -> "io"

show_read(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
=
  let a = attempt @files.read(path)
  let status = when a
    is Ok(t) -> "ok"
    is Err(e) -> describe(e)
  @console.print("read [{path}]: {status}")

show_write(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[write]
=
  let a = attempt @files.write(path, content: "written by probe")
  let status = when a
    is Ok(u) -> "ok"
    is Err(e) -> describe(e)
  @console.print("write [{path}]: {status}")

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  show_read("in/f.txt")
  show_read("inabs/f.txt")
  show_read("out/secret.txt")
  show_read("outabs/secret.txt")
  show_write("out/new.txt")
  show_write("outabs/new.txt")
  show_write("in/new.txt")
  show_read("out/../a.txt")
  show_read("in/../a.txt")
  show_write("out/../w.txt")
  show_read("sub/../../outside/secret.txt")
