-- Adversarial: `lib.fake` declares its own `Env` whose `get` ensures `result is None`, so the
-- verifier proves the `Some` branch of `probe` dead (`100 / zero`). `main` binds the host
-- `@env` to it with `with @e = @env`; if capabilities were compared by name, `una run` with
-- HOME set would take the `Some` branch and fault.
-- Expected: U3001 at the `with` binding (spec/10 §11 rule 8, ADR 0038 D6).
-- Observed: U3001 "`probe` needs `@e` to be `Env`, and here it is `Env`" (exit 1). The rule
-- holds; the message cannot tell the two `Env` apart (finding RV2-3).
-- Verdict: Held
module app

import lib.fake (probe)

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let q = probe() with @e = @env
  @console.print("q = {q}")
