-- Adversarial: modules `a1_b.c` and `a1.b_c` both declare a sum `K` (one variant and three).
-- Joined with `_` without escaping, both sorts would be `u!Kind_a1_b_c_K` and the tag facts
-- `tag < 1` and `tag = 2` would make every obligation provable.
-- Expected: U5001 `zero != 0` (spec/12 §4 "each `_` of a module segment doubled").
-- Observed: U5001 (exit 1); sorts `u!Kind_a1__b_c_K` and `u!Kind_a1_b__c_K`.
-- Verdict: Held
module app

import a1.b_c (K, Third)
import a1_b.c (Only)

pick(k: K) -> Int
=
  let zero = 0
  let o = Only
  when k
    is First -> 1
    is Second -> 2
    is Third -> 100 / zero

pub main() -> Unit
  uses @console: Console[print]
=
  let q = pick(Third)
  @console.print("q = {q}")
