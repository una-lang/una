-- Adversarial: one query with `Box[Int]`, `Box[Text]`, `Box[Box[Int]]`, `Box[U]`,
-- `Pair[Int, Text]` and `Pair[Text, Int]` (a sum whose variants share field names with
-- different types per instance), and generic callees at several types.
-- Expected: U5001 `(... - 5) != 0`, which is 0 at run time; no sort clash (spec/12 §4).
-- Observed: exactly that U5001 (exit 1); every instance has its own sort and field functions
-- (`u!f!left!Both!u!Kind_t_Pair_Int_i!Text` vs `..._Pair_i!Text_Int`).
-- Verdict: Held
module t

pub kind Box[T]
  item: T
  size: Int

pub kind Pair[A, B] = Both(left: A, right: B) | Left(left: A) | Right(right: B)

same[T](x: T) -> T
  ensures result == x
=
  x

pick[T](a: T, b: T) -> T
  ensures result == a
=
  a

wrap[U](y: U) -> Box[U]
  ensures result.item == y
  ensures result.size == 1
=
  Box(item: y, size: 1)

outer[T, U](x: T, y: U) -> Box[U]
  ensures result.size == 1
=
  let b = wrap(y)
  let c = pick(a: y, b: y)
  b

pub mixed() -> Int
=
  let bi = wrap(3)
  let bt = wrap("t")
  let bb = wrap(bi)
  let n = same(bi.item)
  let s = same(bt.item)
  let o = outer(x: "q", y: 7)
  let p: Pair[Int, Text] = Left(left: 4)
  let r: Pair[Text, Int] = Right(right: 5)
  let k = when p
    is Both(left, right) -> left
    is Left(left) -> left
    is Right(right) -> 0
  let m = when r
    is Both(left, right) -> right
    is Left(left) -> 0
    is Right(right) -> right
  100 / (n + bb.item.item + o.size + k + m - 3 - 3 - 1 - 4 - 5)
