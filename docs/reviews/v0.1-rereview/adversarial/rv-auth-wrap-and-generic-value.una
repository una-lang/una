-- Adversarial: effectful and failing functions wrapped in `Ok`/`Err`, passed to a generic function value `let i = id`, and returned by `map` lambdas
-- Expected: U3006 or U3016 at each
-- Observed: U3006 at 26:14, 31:15, 44:35, 50:35; U3016 at 37:11 (message names `id`, not `note`); held
module a06_ok_wrapped

kind Boom = | Exploded

capability Log
  op write(line: Text) -> Unit

id[T](x: T) -> T = x

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

boom(x: Int) -> Int
  fails Boom
=
  fail Exploded

pub ok_wrapped() -> Int
  uses @log: Log[write]
=
  let r = Ok(note)
  1

pub err_wrapped() -> Int
=
  let r = Err(boom)
  1

pub value_of_generic() -> Unit
  uses @log: Log[write]
=
  let i = id
  let g = i(note)
  g("x")

pub mapped() -> Int
  uses @log: Log[write]
=
  let gs = [1].map(each: fn(x) -> note)
  gs.len

pub mapped_param(f: fn(Text) -> Unit uses @log: Log[write]) -> Int
  uses @log: Log[write]
=
  let gs = [1].map(each: fn(x) -> f)
  gs.len
