-- Adversarial: a handler operation that accepts `secret` calls a private helper whose `uses` are inferred and which prints
-- Expected: U4002 at the call of `helper` (spec/05 §9 rule 2 inference; spec/07 §7 rule 4 effect floor; ADR 0038 D4)
-- Observed: U4002 at the call of `helper` (4ea31cf and 85787d7)
-- Verdict: Held
module rv_hdl_inferred_helper

capability Vault
  op note(line: Text) -> Unit
    accepts secret

say() -> Unit
  uses @console: Console[print]
=
  @console.print("ping")

helper() -> Unit = say()

handler relay() for Vault
  uses @console: Console[print]
  op note(line) = helper()

branch(flag: secret Bool) -> Unit
  uses @vault: Vault[note]
=
  if flag
    @vault.note("x")
  else
    unit

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  branch(pin == "1234") with @vault = relay()
