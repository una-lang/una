-- Adversarial: S-Fun at a handler operation result and at lambda results: a handler returns an effectful named function for a pure function type, a lambda returns one, and a nested lambda calls one
-- Expected: U3003 or U3006 at each site (spec/05 §9 rules 6, 7; ADR 0038 D1)
-- Observed: U3003 and U3006 at the handler result, U3006 at the lambda result, U3003 at the nested call (4ea31cf and 85787d7)
-- Verdict: Held
module rv_hdl_sfun_result

capability Maker
  op make() -> fn(Text) -> Unit

loud(line: Text) -> Unit
  uses @console: Console[print]
=
  @console.print(line)

handler giver() for Maker
  uses @console: Console[print]
  op make() = loud

pub lam() -> Int
  uses @console: Console[print]
=
  let fs = [1].map(each: fn(x: Int) -> loud)
  fs.len

pub nested() -> Int
  uses @console: Console[print]
=
  let g = fn(x: Int) -> fn(y: Text) -> loud(y)
  1
