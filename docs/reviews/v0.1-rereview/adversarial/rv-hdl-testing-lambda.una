-- Adversarial: `std.testing` hidden in a lambda inside a handler operation body, installed by `with` in `main`; and `fake_hash` passed as a handler instance argument in `main` (allowed in a `given` line)
-- Expected: U3015 at the `with` binding of `lam` and at the `fake_hash` call in `main` (spec/14 §4; ADR 0043)
-- Observed: U3015 at the `with` binding of `lam` and at `fake_hash` in main (4ea31cf and 85787d7)
-- Verdict: Held
module rv_hdl_testing_lambda

import std.testing (fake_hash)

capability Hasher
  op hash(seed: Int) -> internal Hashed

handler lam() for Hasher
  op hash(seed) =
    let hs = [seed].map(each: fn(s: Int) -> fake_hash(s))
    hs.first()
      if none use fake_hash(0)

handler held(h: internal Hashed) for Hasher
  op hash(seed) = h

digest(seed: Int) -> internal Hashed
  uses @hasher: Hasher[hash]
=
  @hasher.hash(seed)

pub main() -> Unit
=
  let d = digest(7) with @hasher = lam()
  let e = digest(7) with @hasher = held(h: fake_hash(9))
  unit

example "held via given"
  given @hasher = held(h: fake_hash(3))
  do digest(1)
  expect result == fake_hash(3)
