-- Adversarial: an opaque predicate is used as a function value and called through it, in a
-- `let`, as the `each` of `map` and as the `keep` of `first_where`. ADR 0042 rule 2 says any
-- call outside `checked` and opaque bodies is U2016.
-- Expected: U2016 at each use of `valid_slug` as a value (or a rule that forbids opaque
-- predicates as values, as ADR 0043 rule 3 does for `std.testing`).
-- Observed: accepted, exit 0. No fact follows (a `Slug` built from `f(raw)` is refuted), so
-- the escape budget is not bypassed; the gap is in the rule, not in soundness.
module rv_escape_opaque_predicate_as_value

predicate opaque valid_slug(t: Text) -> Bool = t.len >= 3

pub kind Slug = Text where valid_slug(it)

pub by_let(raw: Text) -> Bool
=
  let f = valid_slug
  f(raw)

pub by_map(xs: List[Text]) -> List[Bool] = xs.map(each: valid_slug)

pub by_first_where(xs: List[Text]) -> Option[Text] = xs.first_where(keep: valid_slug)
