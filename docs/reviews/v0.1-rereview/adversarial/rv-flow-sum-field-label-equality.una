-- Adversarial: sum kind with a `secret` payload field compared with `==`, alone and in a list; `opt` and `wrapped` are controls whose label sits in a type argument
-- Expected: U4001 at 11:36 (control), 13:32, 15:40 (control), 17:39 (spec/07 §7 rule 3, T6); `differ` compares the tag only and may stay accepted
-- Observed: U4001 at 11:36 and 15:40 only; `summed` and `lists` are accepted (exit 1 from the controls)
module g07_eq_variants

kind Guess = Hit(pin: secret Int) | Miss

kind Wrap[T]
  value: T

pub opt(pin: secret Int) -> Bool = Some(pin) == Some(1234)

pub summed(g: Guess) -> Bool = g == Hit(pin: 1234)

pub wrapped(pin: secret Int) -> Bool = Wrap(value: pin) == Wrap(value: 1234)

pub lists(gs: List[Guess]) -> Bool = gs == [Hit(pin: 1234)]

pub differ(g: Guess) -> Bool = g != Miss
