-- Adversarial: generic whose effectful function parameter prints its `T` argument, instantiated with labeled data in both argument orders, and prelude `map` with a public-parameter function
-- Expected: U4001 (S-Fun, contravariant parameter label)
-- Observed: U4001 at 26:8, 31:21, 33:44, 33:60, 42:8; held
module g03_generic_effectful_param

printer(x: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("value {x}")

feed[T](f: fn(T) -> Unit uses @console: Console[print], x: T) -> Unit
  uses @console: Console[print]
=
  f(x)

feed_back[T](x: T, f: fn(T) -> Unit uses @console: Console[print]) -> Unit
  uses @console: Console[print]
=
  f(x)

show(x: Int) -> Int = x

pub first_fn(pin: secret Int) -> Unit
  uses @console: Console[print]
=
  feed(printer, x: pin)

pub first_value(pin: secret Int) -> Unit
  uses @console: Console[print]
=
  feed_back(pin, f: printer)

pub mapped(pin: secret Int) -> List[Int] = [pin].map(each: show)

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  let n = pin.len
  feed(printer, x: n)
