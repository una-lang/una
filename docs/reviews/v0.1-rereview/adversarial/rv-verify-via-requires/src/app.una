-- Adversarial: a policy's `via` function has a `requires` clause. Its body is verified
-- under that precondition, so the D5 obligation that the result satisfies the `to` refinement
-- (`result > 0`) is proven there. The policy call `lower(0)` is a Declassify node, and the
-- verifier checks only the refinements of `from` at it, never the `requires` of the `via`
-- function, then assumes `Pos` for the result (ADR 0038 D5: "every refinement, precondition
-- and postcondition obligation remains"; spec/07 §5 rule 3, spec/12 §3).
-- Expected: U5001 for the precondition `n > 0` at `lower(0)` (or U4005 for a `via` function
-- with `requires`).
-- Observed: `una check` exits 0 with every obligation proven; `una run` stops with U8001
-- "`div` by zero" in `recip`, exit 3.
module app

import release (Pos, lower)

recip(p: Pos) -> Int = 100 / p

pub main() -> Unit
  uses @console: Console[print]
=
  let p = lower(0)
  let q = recip(p)
  @console.print("q = {q}")
