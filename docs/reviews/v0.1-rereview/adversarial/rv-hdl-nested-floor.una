-- Adversarial: nested floors: a handler of an op that accepts `secret` performs an op of another user capability that accepts `public`, whose own handler prints; both handlers are installed around a secret branch
-- Expected: U4003 at `@bell.ring` in the outer handler (spec/07 §7 rule 4; ADR 0038 D4)
-- Observed: U4003 at `@bell.ring` (4ea31cf and 85787d7)
-- Verdict: Held
module rv_hdl_nested_floor

capability Vault
  op note(line: Text) -> Unit
    accepts secret

capability Bell
  op ring() -> Unit

handler relay() for Vault
  uses @bell: Bell[ring]
  op note(line) = @bell.ring()

handler loud() for Bell
  uses @console: Console[print]
  op ring() = @console.print("ping")

branch(flag: secret Bool) -> Unit
  uses @vault: Vault[note]
=
  if flag
    @vault.note("x")
  else
    unit

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  run(pin == "1234") with @bell = loud()

run(flag: secret Bool) -> Unit
  uses @bell: Bell[ring]
=
  branch(flag) with @vault = relay()
