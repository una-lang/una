-- Adversarial: grant prefixes that are themselves links, and two `Files` grants at once.
-- `[run] grants` holds `files:./gl:read` (gl links to `outside`), `files:./gd:write` (gd is
-- dangling) and `files:./box:write`.
-- Setup (from this directory): `mkdir -p box outside && echo secret > outside/secret.txt &&
-- ln -s "$PWD/outside" gl && ln -s "$PWD/nowhere" gd`
-- Expected: rule 2 resolves against the canonical grant prefix, so a prefix that is a link
-- grants its target (`secret.txt` ok); a dangling prefix grants nothing and must not shadow
-- the `box` grant; nothing is created through `gd`.
-- Observed (`una run`): read secret.txt ok (through `gl`), write made.txt ok (the dangling
-- `gd` grant is skipped; the file lands in box/made.txt), read made.txt notfound (the only read
-- grant is `gl`). Nothing created at `nowhere`.
-- Verdict: Held
module prefix

describe(e: FileError) -> Text
=
  when e
    is NotFound -> "notfound"
    is Denied -> "denied"
    is Io -> "io"

show_read(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
=
  let a = attempt @files.read(path)
  let status = when a
    is Ok(t) -> "ok"
    is Err(e) -> describe(e)
  @console.print("read [{path}]: {status}")

show_write(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[write]
=
  let a = attempt @files.write(path, content: "written by probe")
  let status = when a
    is Ok(u) -> "ok"
    is Err(e) -> describe(e)
  @console.print("write [{path}]: {status}")

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  show_read("secret.txt")
  show_write("made.txt")
  show_read("made.txt")
