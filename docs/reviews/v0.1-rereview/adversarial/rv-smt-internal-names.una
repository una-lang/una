-- Adversarial: user kinds named `Text`, `Unknown`, `Fn`, `List`, variants `Unit`, `Hashed`,
-- `Kind`, `Param`, `Len`, `Tag`, fields `len`, `tag`, `at`, `value`, `failure`, all equal to
-- parts of internal symbols (`i!Text`, `i!Unknown`, `i!Fn`, `i!List_`, `i!len!`, `i!tag!`,
-- `i!f!value!`, `i!f!failure!`). `b.len` on the user `Unknown` must be the field, not a length
-- with a `>= 0` fact, since `requires b.len == 0 - 1`.
-- Expected: U5001 at the last division only (spec/12 §4, ADR 0038 D8).
-- Observed: exactly that U5001 (exit 1); the query has `u!f!len!u!Kind_t_Unknown`,
-- `u!f!len!Len!u!Kind_t_Text`, `u!f!len!u!Kind_t_List_Int`, and no `i!len!`.
-- Verdict: Held
module t

pub kind Text = Len(len: Int, tag: Int) | Tag(value: Int, failure: Int)

pub kind Unknown
  len: Int
  tag: Int
  at: Int

pub kind Fn = Unit | Hashed | Kind | Param

pub kind List[T]
  len: T
  value: T

pub f(a: Text, b: Unknown, c: Fn, d: List[Int]) -> Int
  requires a is Len
  requires b.len == 0 - 1
=
  let zero = 0
  let x = when a
    is Len(len, tag) -> len + tag
    is Tag(value, failure) -> 100 / zero
  let y = when c
    is Unit -> 1
    is Hashed -> 2
    is Kind -> 3
    is Param -> 4
  100 / (b.len + b.tag + b.at + d.len + d.value + x + y)
