-- Adversarial: a handler writes its parameter through the host `Files.write` (accepts `internal`): for an op that accepts `internal` (positive twin, performed under an internal branch) and for one that accepts `secret`
-- Expected: `to_file` and `branch` accepted; U4001 or U4002 in `to_file_secret` (spec/07 §7 rule 4 effect floor; spec/14 §3)
-- Observed: to_file and branch accepted; U4002 and U4001 at the call of `write_it` in to_file_secret (4ea31cf and 85787d7)
-- Verdict: control
module rv_hdl_files_floor

capability Vault
  op note(line: Text) -> Unit
    accepts internal

capability Secrets
  op keep(line: Text) -> Unit
    accepts secret

write_it(line: internal Text) -> Unit
  uses @files: Files[write]
=
  @files.write(path: "log.txt", content: line)
    if error use unit

handler to_file() for Vault
  uses @files: Files[write]
  op note(line) = write_it(line)

handler to_file_secret() for Secrets
  uses @files: Files[write]
  op keep(line) = write_it(line)

branch(flag: internal Bool) -> Unit
  uses @vault: Vault[note]
=
  if flag
    @vault.note("x")
  else
    unit
