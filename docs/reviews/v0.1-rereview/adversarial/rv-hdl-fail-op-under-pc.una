-- Adversarial: an operation that can fail and accepts `secret` is performed under a secret branch, and its handler always fails; the performer passes the failure with `if error pass`, so whether `attempt probe` fails reveals the PIN
-- Expected: U4002 at the handling clause under the secret condition (spec/07 §3 rule 3; ADR 0038 D4)
-- Observed: U4002 at `if error pass` under the secret branch (4ea31cf and 85787d7)
-- Verdict: Held
module rv_hdl_fail_op_under_pc

kind VaultError = | Refused

capability Vault
  op note(line: Text) -> Unit
    fails VaultError
    accepts secret

handler always_refuse() for Vault
  op note(line) = fail Refused

probe(flag: secret Bool) -> Unit
  uses @vault: Vault[note]
  fails VaultError
=
  if flag
    @vault.note("x")
      if error pass
  else
    unit

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  let r = attempt probe(pin == "1234") with @vault = always_refuse()
  let shown = if r is Ok then "no" else "yes"
  @console.print(shown)
