-- Adversarial: function values chosen under a secret branch passed through generics: into `fn(Int) -> T`, through `id`, picked by a secret index with `at`, and folded as list elements
-- Expected: U4001 at each flow or public result (spec/10 §5 T-App; spec/07 §7 rule 3; ADR 0038 D1, R-006)
-- Observed: U4001 at the argument of `call`, and at the results of b, c and d (4ea31cf and 85787d7)
-- Verdict: Held
module rv_gen_labeled_fn_values

call[T](x: Int, f: fn(Int) -> T) -> T = f(x)

id[T](x: T) -> T = x

pub a(pin: secret Int) -> Int
=
  let f = if pin == 1234 then fn(y: Int) -> 1 else fn(y: Int) -> 0
  call(0, f: f)

pub b(pin: secret Int) -> Int
=
  let f = if pin == 1234 then fn(y: Int) -> 1 else fn(y: Int) -> 0
  let g = id(f)
  g(0)

pub c(pin: secret Int) -> Int
=
  let fs = [fn(y: Int) -> 1, fn(y: Int) -> 0]
  let g = fs.at(index: if pin == 1234 then 0 else 1)
    if none use fn(y: Int) -> 2
  g(0)

pub d(pin: secret Int) -> Int
=
  let f = if pin == 1234 then fn(y: Int) -> 1 else fn(y: Int) -> 0
  let fs = [f]
  fs.fold(initial: 0, step: fn(acc: Int, h: fn(Int) -> Int) -> h(acc))
