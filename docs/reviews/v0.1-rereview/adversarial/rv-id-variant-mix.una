-- Adversarial: a user kind `Answer = None | Some(value: Int) | Ok` puts `None` and `Some` at the
-- prelude's opposite tags, and a user `KeyError` puts `UnknownKey` last. `wrong_branch` matches
-- a prelude `Option` from `first` right after matching an `Answer`; if either `is` test took
-- the tag of the other kind, the `Some` branch (really taken) would look dead and `100 / 0`
-- would be proven.
-- Expected: U5001 twice, `(value - value + tag - 3) != 0` and `zero != 0` (spec/10 §12 rule 1,
-- spec/12 §4, ADR 0038 D6).
-- Observed: exactly those two U5001 (exit 1).
-- Verdict: Held
module t

pub kind Answer = None | Some(value: Int) | Ok

pub kind KeyError = Revoked | Expired | UnknownKey

wrong_branch(xs: List[Int]) -> Int
  requires xs.len > 0
=
  let zero = 0
  let o = first(xs)
  let mine = Some(value: 3)
  let tag = when mine
    is None -> 0
    is Some(value) -> value
    is Ok -> 2
  when o
    is Some(value) -> 100 / (value - value + tag - 3)
    is None -> 0

key_tag() -> Int
=
  let zero = 0
  let e = UnknownKey
  when e
    is UnknownKey -> 100 / zero
    is Revoked -> 1
    is Expired -> 2
