-- Adversarial: a handler that breaks the effect floor, installed only by `given` lines of an example with `expect performed` observing the inner effect
-- Expected: U4003 at `@out.say`: handler bodies are checked wherever they are installed (spec/05 §5 rule 5; ADR 0038 D4)
-- Observed: U4003 at `@out.say` (4ea31cf and 85787d7)
-- Verdict: Held
module rv_hdl_given_only_floor

capability Vault
  op note(line: Text) -> Unit
    accepts secret

capability Out
  op say(line: Text) -> Unit

handler relay() for Vault
  uses @out: Out[say]
  op note(line) = @out.say("ping")

handler sink() for Out
  op say(line) = unit

branch(flag: secret Bool) -> Unit
  uses @vault: Vault[note]
=
  if flag
    @vault.note("x")
  else
    unit

example "the relay says ping"
  given @out = sink()
  given @vault = relay()
  do branch(true)
  expect performed @out.say
