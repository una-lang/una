-- Adversarial: positive side: `is_some`, `is_ok` and `append` on top-labeled values and a generic returning a function; spec/07 §7 rule 8 lets results carry labels
-- Expected: accepted with labeled results (secret Bool, secret Int) where the declared result allows; U4001 only where a public result is declared
-- Observed: U4001 at 9:52 (`label(T)` inside the function-typed result of `maker`), at the public results 18:3, 20:39, 32:66 as expected, and at the top-labeled arguments of `is_some`, `is_ok`, `append` (22:45, 24:44, 26:44, 28:48, 30:45). The last five and 9:52 are over-rejections, not unsound
module g02_generic_fn_result

kind Box[T]
  value: T

maker[T](a: T, b: T) -> fn(Int) -> Bool = fn(x) -> a == b

wrap[T](a: T, b: T) -> Box[Bool] = Box(value: a == b)

mk[T](a: T, b: T) -> Option[Int] = if a == b then Some(1) else None

pub p_maker(pin: secret Int) -> Bool
=
  let f = maker(pin, b: 1234)
  f(0)

pub p_wrap(pin: secret Int) -> Bool = wrap(pin, b: 1234).value

pub p_mk(pin: secret Int) -> Bool = is_some(mk(pin, b: 1234))

pub p_mk_method(pin: secret Int) -> Bool = mk(pin, b: 1234).is_some()

pub p_top(o: secret Option[Int]) -> Bool = o.is_some()

pub p_ok(r: secret Result[Int, Int]) -> Bool = r.is_ok()

pub p_append(xs: secret List[Int]) -> Int = xs.append(item: 1).len

pub p_append_item(xs: List[Int], pin: secret Int) -> List[Int] = xs.append(item: pin)
