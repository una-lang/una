-- Adversarial: `is_some`, `is_ok` and `append` on secret data (D-136), directly and inside a generic under a symbolic condition
-- Expected: U4001 at each public result and U4002 in `sel` (spec/14 §1 result labels as amended by D-136; ADR 0038 D3.4)
-- Observed: 85787d7: U4001 at a, b, c, d and U4002 in sel. 4ea31cf: b accepted (harmless: the length of `append` never depends on the item), a and c rejected at the argument instead
-- Verdict: Held
module rv_gen_prelude_option_labels

has[T](o: Option[T]) -> Bool = is_some(o)

pub a(o: secret Option[Int]) -> Bool = is_some(o)

pub b(pin: secret Int) -> Int = append([1], item: pin).len

pub c(r: secret Result[Int, Bool]) -> Bool = is_ok(r)

pub d(pin: secret Int) -> Bool = has(if pin == 1 then Some(1) else None)

sel[T](xs: List[T], x: T) -> Unit
  uses @console: Console[print]
=
  if is_some(xs.first())
    @console.print("x")
  else
    unit
