-- Adversarial: a value labeled with a type parameter sent to a sink that accepts `secret` (not top), and into a public handler instance argument inside a generic body; `c` is a control whose effect follows a finished branch
-- Expected: U4003 at the op argument and U4001 at the handler argument; `c` accepted (spec/07 §7 rule 8; ADR 0038 D3.2)
-- Observed: U4003 at the op argument and U4001 at the handler argument; c accepted (4ea31cf and 85787d7)
-- Verdict: Held
module rv_gen_symbolic_sinks

capability Log
  op write(flag: Bool) -> Unit
    accepts secret

handler keep(tag: Bool) for Log
  op write(flag) = unit

run() -> Unit
  uses @log: Log[write]
=
  @log.write(true)

a[T](x: T, y: T) -> Unit
  uses @log: Log[write]
=
  @log.write(x == y)

b[T](x: T, y: T) -> Unit
=
  run() with @log = keep(tag: x == y)

c[T](x: T, y: T) -> Unit
  uses @log: Log[write]
=
  let o = if x == y then Some(1) else None
  run()
