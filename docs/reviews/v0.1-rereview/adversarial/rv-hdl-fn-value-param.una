-- Adversarial: a handler receives an effectful function as an instance argument and calls it in the body of an operation that accepts `secret` (T-App inside the effect floor)
-- Expected: U4002 at the call of `out` (spec/07 §7 rule 4 effect floor; ADR 0038 D1, D4)
-- Observed: U4002 at `out("ping")` in the operation body (4ea31cf and 85787d7)
-- Verdict: Held
module rv_hdl_fn_value_param

capability Vault
  op note(line: Text) -> Unit
    accepts secret

say(line: Text) -> Unit
  uses @console: Console[print]
=
  @console.print("ping")

handler relay(out: fn(Text) -> Unit uses @console: Console[print]) for Vault
  uses @console: Console[print]
  op note(line) = out("ping")

branch(flag: secret Bool) -> Unit
  uses @vault: Vault[note]
=
  if flag
    @vault.note("x")
  else
    unit

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let pin = @env.get("PIN")
    if none use ""
  branch(pin == "1234") with @vault = relay(out: say)
