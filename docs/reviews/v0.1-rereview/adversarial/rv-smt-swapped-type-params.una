-- Adversarial: generic callees `second[U, T]` and `boxed[U, T]` called from `flip[T, U]` with
-- the parameters swapped, so a sequential substitution of type parameters would give the
-- wrong sorts (a crash) or equate `u!Param_T` with `u!Param_U`.
-- Expected: `flip` proven; U5001 `(b.size + c.size - 4) != 0` (spec/12 §4).
-- Observed: exactly that one U5001 (exit 1); sorts `u!Kind_t_Box_u!Param_U` and
-- `u!Kind_t_Box_u!Param_T` are kept apart.
-- Verdict: Held
module t

pub kind Box[T]
  item: T
  size: Int

second[U, T](a: U, b: T) -> T
  ensures result == b
=
  b

boxed[U, T](a: U, b: T) -> Box[T]
  ensures result.item == b
  ensures result.size == 2
=
  Box(item: b, size: 2)

pub flip[T, U](x: T, y: U) -> U
  ensures result == y
=
  second(a: x, b: y)

pub flip_box[T, U](x: T, y: U) -> Int
=
  let b = boxed(a: x, b: y)
  let c = boxed(a: y, b: x)
  100 / (b.size + c.size - 4)
