-- Adversarial: a reflect predicate's `define-fun` takes its parameter sorts from the arguments of
-- its first use (generate.rs `predicate`). The uses pass a parameter, a
-- literal `[]` and `Some(3)`, whose sorts might differ from the declared `Option[Int]` and
-- `List[Int]`, which would make the second use ill-sorted (U8001 at check).
-- Expected: accepted (spec/12 §4).
-- Observed: `una check` exit 0; one `define-fun` per predicate, over `i!Option_Int` and
-- `i!List_Int`.
-- Verdict: Held
module t

predicate reflect has(o: Option[Int]) -> Bool = o is Some

predicate reflect empty(xs: List[Int]) -> Bool = xs.len == 0

need(o: Option[Int], xs: List[Int]) -> Int
  requires has(o)
  requires empty(xs)
=
  1

pub f(p: Option[Int]) -> Int
  requires has(p)
=
  let a = need(p, xs: [])
  let b = need(Some(3), xs: [])
  a + b
