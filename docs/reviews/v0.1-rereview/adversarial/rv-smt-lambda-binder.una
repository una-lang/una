-- Adversarial: a lambda parameter `x` after a sibling block that bound `x = 5`, and a lambda
-- parameter `y` after a pattern binder `y = 5`. If lambda parameters kept their source name
-- while lets were renamed, `x != 0` would be proven from the earlier binding.
-- Expected: U5001 `x != 0` and `y != 0` (spec/12 §4 binders).
-- Observed: exactly those two U5001 (exit 1); the lambda parameters are `x%2` and `y%2`.
-- Verdict: Held
module t

apply(f: fn(Int) -> Int, v: Int) -> Int = f(v)

pub g() -> Int
=
  let a = if true
    let x = 5
    x
  else
    0
  let h = fn(x: Int) -> 100 / x
  apply(h, v: 0) + a

pub k() -> Int
=
  let b = when Some(5)
    is Some(y) -> y
    is None -> 1
  apply(fn(y) -> 100 / y, v: 0) + b
