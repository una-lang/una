-- Adversarial: a policy says `from internal Int`, and its `via` function takes
-- `internal Pos`. spec/07 §7 rule 5 compares only base types, so this is accepted. The body
-- assumes the parameter refinement `n > 0` and proves the D5 obligation `result > 0`; the
-- policy call `lower(0)` checks only the refinements of `from` (none), never those of the
-- `via` parameter, then assumes `Pos` for the result (ADR 0038 D5; spec/07 §5 rule 4 "types
-- other than labels MUST match"; spec/12 §3).
-- Expected: U4005 (the `via` parameter type differs from `from` in more than its label), or
-- U5001 for the refinement `n > 0` at `lower(0)`.
-- Observed: `una check` exits 0 with every obligation proven; `una run` stops with U8001
-- "`div` by zero" in `recip`, exit 3.
module app

import release (Pos, lower)

recip(p: Pos) -> Int = 100 / p

pub main() -> Unit
  uses @console: Console[print]
=
  let p = lower(0)
  let q = recip(p)
  @console.print("q = {q}")
