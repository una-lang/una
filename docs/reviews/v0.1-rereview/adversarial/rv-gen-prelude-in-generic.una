-- Adversarial: user generics that call prelude generics (`first_where`, `filter`) with a predicate over T, returning `Option[T]` and `List[T]`, then observed with `is` and `.len` at a secret instantiation
-- Expected: rejection; either the lambda (a `label(T)` result into `fn(T) -> Bool`) or the public results (spec/07 §7 rule 8, spec/14 §1 result labels)
-- Observed: U4001 at both lambdas (`label(T) Bool` into `Bool`) and at both public results (4ea31cf and 85787d7)
-- Verdict: Held
module rv_gen_prelude_in_generic

find[T](xs: List[T], x: T) -> Option[T] = xs.first_where(keep: fn(y: T) -> y == x)

keep[T](xs: List[T], x: T) -> List[T] = xs.filter(keep: fn(y: T) -> y == x)

pub by_is(xs: List[Int], pin: secret Int) -> Bool = find(xs, x: pin) is Some

pub by_len(xs: List[Int], pin: secret Int) -> Int = keep(xs, x: pin).len
