-- Adversarial: record with a `secret` field compared with `==`, through generic `same[T]`, prelude `contains` and a generic over `contains`; `flagged` is a control
-- Expected: U4001 at 19:34, 21:35, 23:34, 25:40 and 27:37 (spec/07 §7 rules 3 and 8, ADR 0038 D3.2 and D3.4, T6), and U4001 at 17:45 for the symbolic label in a field
-- Observed: only U4001 at 17:45 and 27:37; `direct`, `generic`, `listed` and `generic_list` are accepted
module g05_kind_field_labels

kind Account
  id: Int
  pin: secret Int

kind Flag
  same: Bool

same[T](a: T, b: T) -> Bool = a == b

found[T](xs: List[T], y: T) -> Bool = xs.contains(item: y)

flagged[T](a: T, b: T) -> Flag = Flag(same: a == b)

pub direct(a: Account) -> Bool = a == Account(id: 1, pin: 1234)

pub generic(a: Account) -> Bool = same(a, b: Account(id: 1, pin: 1234))

pub listed(a: Account) -> Bool = [a].contains(item: Account(id: 1, pin: 1234))

pub generic_list(a: Account) -> Bool = found([a], y: Account(id: 1, pin: 1234))

pub flag(pin: secret Int) -> Bool = flagged(pin, b: 1).same
