-- Adversarial: an example installs the `lib.x.Gauge` handler `five` with `given` for
-- `measure`, which needs `lib.y.Gauge`; examples are checked on a separate path from `with`.
-- Expected: U3010 at the `given` line (spec/08 §3, spec/10 §11 rule 8).
-- Observed: U3010 at src/app.una:7 (exit 1).
-- Verdict: Held
module app

import lib.x (five)
import lib.y (measure)

example "a foreign handler in a given line"
  given @g = five()
  do measure()
  expect result == 20

pub main() -> Unit
  uses @console: Console[print]
=
  @console.print("nothing")
