-- Adversarial: symbolic labels with two type parameters: the result type mentions only T, but the branch depends on U; option and list results chosen by U are then observed with `is` and `.len`
-- Expected: U4001 at each public result (spec/10 §5 generic instantiation rule 3; spec/07 §7 rule 8; ADR 0038 D3)
-- Observed: U4001 at each of the three public results (13, 15, 17) (4ea31cf and 85787d7)
-- Verdict: Held
module rv_gen_two_params

sel[T, U](x: T, y: T, a: U, b: U) -> T = if a == b then x else y

pick[T, U](x: T, a: U, b: U) -> Option[T] = if a == b then Some(x) else None

count[T, U](xs: List[T], a: U, b: U) -> List[T] = if a == b then xs else []

pub by_value(pin: secret Int) -> Int = sel(1, y: 0, a: pin, b: 1234)

pub by_is(pin: secret Int) -> Bool = pick(1, a: pin, b: 1234) is Some

pub by_len(pin: secret Int) -> Int = count([1, 2], a: pin, b: 1234).len
