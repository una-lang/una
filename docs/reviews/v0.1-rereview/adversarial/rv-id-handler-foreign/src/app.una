-- Adversarial: `lib.x.Gauge` ensures `result >= 0`, `lib.y.Gauge` ensures `result >= 10`. The
-- `lib.x` handler `five` (verified against `>= 0`) is installed for `measure`, which needs
-- `lib.y.Gauge` and divides by `r - 5`.
-- Expected: U3010 at the binding (spec/05 §6, spec/10 §11 rule 8, ADR 0038 D6).
-- Observed: U3010 "this handler implements `Gauge`, and `measure` needs `@g` to be `Gauge`"
-- (exit 1); the message is ambiguous (finding RV2-3).
-- Verdict: Held
module app

import lib.x (five)
import lib.y (measure)

pub main() -> Unit
  uses @console: Console[print]
=
  let q = measure() with @g = five()
  @console.print("q = {q}")
