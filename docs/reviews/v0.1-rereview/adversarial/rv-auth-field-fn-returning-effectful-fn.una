-- Adversarial: record field of a pure function type whose result is an effectful function, filled by a lambda returning `note`, to carry `note` out of its `with` scope
-- Expected: U3006 (spec/05 §6)
-- Observed: U3006 at 27:24; held
module a01_record_fn_returning_fn

capability Log
  op write(line: Text) -> Unit

handler loud() for Log
  uses @console: Console[print]
  op write(line) = @console.print("loud: {line}")

handler quiet() for Log
  op write(line) = unit

kind Holder
  get: fn(Int) -> fn(Text) -> Unit uses @log: Log[write]

note(line: Text) -> Unit
  uses @log: Log[write]
=
  @log.write(line)

make() -> Holder
  uses @log: Log[write]
=
  Holder(get: fn(n) -> note)

fire(h: Holder) -> Unit
  uses @log: Log[write]
=
  let f = h.get(1)
  f("hello")

pub main() -> Unit
  uses @console: Console[print]
=
  let h = make() with @log = loud()
  fire(h) with @log = quiet()
