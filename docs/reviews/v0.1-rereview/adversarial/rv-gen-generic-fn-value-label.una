-- Adversarial: a generic function bound with `let` and then called. ADR 0038 D3 raises the result
-- of a direct generic call by the labels of its type arguments, but a function value's result
-- labels are not substituted once its type arguments are known (una-check types/expr.rs:325-333).
-- Expected: error U4003 at the print, as for the direct call `is_pin(pin, y: 1234)` (spec/07 §7
-- rule 1, ADR 0038 D3).
-- Observed: accepted (exit 0) at 4ea31cf and at 85787d7; `una run --grant console` prints
-- `pin is 1234: 1`.
-- Verdict: Critical
module rv_gen_generic_fn_value_label

is_pin[T](x: T, y: T) -> Int = if x == y then 1 else 0

pub main() -> Unit
  uses @console: Console[print]
=
  let pin: secret Int = 1234
  let f = is_pin
  let hit = f(pin, 1234)
  @console.print("pin is 1234: {hit}")
