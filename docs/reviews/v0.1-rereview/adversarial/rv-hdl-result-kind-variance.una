-- Adversarial: a handler operation result flows by the same covariant kind-argument rule: the op is declared to return `Sink[secret Int]`, the handler returns a `Sink[Int]` that returns its argument, and the performer gets the secret back as a public Int
-- Expected: U4001 at the handler's operation body (spec/05 §5 rule 5, spec/07 §7 rule 4 "the result flows into the operation's declared return type"; ADR 0038 D4)
-- Observed: accepted (exit 0) at 4ea31cf and 85787d7
-- Verdict: Critical
module rv_hdl_result_kind_variance

kind Sink[T]
  eat: fn(T) -> Int

capability Source
  op sink() -> Sink[secret Int]

handler plain() for Source
  op sink() = Sink(eat: fn(x: Int) -> x)

pub via_op(pin: secret Int) -> Int
  uses @src: Source[sink]
=
  let s = @src.sink()
  s.eat(pin)

pub installed(pin: secret Int) -> Int
=
  via_op(pin) with @src = plain()

pub main() -> Unit
  uses @env: Env[get]
  uses @console: Console[print]
=
  let raw = @env.get("PIN")
    if none use ""
  let pin: secret Int = to_int(raw)
    if none use 0
  let shown = installed(pin)
  @console.print("pin is {shown}")
