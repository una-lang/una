-- Adversarial: the "a Unit position never fails a flow" exemption stretched to `Option[Unit]`, `List[Unit]` lengths, a Unit laundered through a generic `id`, and a filter mapped to Units
-- Expected: U4001 at each public result (spec/07 §7 rule 2)
-- Observed: U4001 at each public result (and at the lambda parameters of d) (4ea31cf and 85787d7)
-- Verdict: Held
module rv_gen_unit_positions

id[T](x: T) -> T = x

pub a(flag: secret Bool) -> Option[Unit] = if flag then Some(unit) else None

pub b(flag: secret Bool) -> Int
=
  let xs = if flag then [unit, unit] else [unit]
  xs.len

pub c(flag: secret Bool) -> Bool
=
  let u = if flag then unit else unit
  let o = id(Some(u))
  o is Some

pub d(pin: secret Int) -> Int
=
  let us = [pin].filter(keep: fn(x: Int) -> x == 1).map(each: fn(x: Int) -> unit)
  us.len
