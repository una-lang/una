-- Adversarial: the module redeclares the prelude's `Nat` as `Int in -5..5`. If refinements were
-- looked up by bare name, `n: Nat` would carry `n >= 0` and `100 / (n + 5)` would be proven.
-- Expected: U5001 at `(n + 5) != 0`, `result in -5..5` and `(h + 5) != 0` (spec/10 §11 rule 5
-- "a declaration MAY reuse a prelude name").
-- Observed: exactly those three U5001 (exit 1). Declaring `kind Int = Nat` as well is U2002
-- (the module's `Int` then names its own kind).
-- Verdict: Held
module t

pub kind Nat = Int in -5..5

inv(n: Nat) -> Int = 100 / (n + 5)

hundreds(t: Text) -> Nat = t.len / 100

main_value() -> Int
=
  let h = hundreds("abc")
  100 / (h + 5)

pub main() -> Unit
  uses @console: Console[print]
=
  let q = inv(0 - 5)
  @console.print("q = {q}")
