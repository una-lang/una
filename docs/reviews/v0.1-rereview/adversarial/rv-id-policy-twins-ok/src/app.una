-- Adversarial: positive twin of rv-id-policy-twins, importing `lib.a.release` (`to public Int
-- in 1..10`).
-- Expected: accepted; `una run` prints `q = 100`.
-- Observed: `una check` exit 0; `una run` prints `q = 100` (exit 0).
-- Verdict: control
module app

import lib.a (release)

band(n: internal Int) -> Int = 100 / release(n)

pub main() -> Unit
  uses @console: Console[print]
=
  let q = band(0)
  @console.print("q = {q}")
