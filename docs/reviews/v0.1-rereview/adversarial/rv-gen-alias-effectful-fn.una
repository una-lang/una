-- Adversarial: U3016 bypass through a kind alias of an effectful function type (`kind Printer = fn(Text) -> Unit uses @c: Console[print]`) used as a list element type
-- Expected: U3016 at `List[Printer]` (spec/05 §6, §9 rule 6; ADR 0038 D2), and no other diagnostic
-- Observed: U3016 as expected, plus a spurious U1001 at the alias, "capability `Console` has no operation `print`" (also with a user capability); the alias cannot be used at all, not even as a parameter type
-- Verdict: Minor
module rv_gen_alias_effectful_fn

kind Printer = fn(Text) -> Unit uses @c: Console[print]

pub stored(ps: List[Printer]) -> Int = ps.len

run(p: Printer) -> Unit
  uses @c: Console[print]
=
  p("x")
