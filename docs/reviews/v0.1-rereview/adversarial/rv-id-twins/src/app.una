-- Adversarial: `lib.a` and `lib.b` both declare a kind `Level`, a reflect predicate `nonneg` and
-- a function `bump` with different contracts. `app` imports the `lib.a` ones and calls `lib.b`
-- functions whose contracts use the `lib.b` ones, so both twins meet in one query; `bump` is
-- also called with method syntax (`1.bump`). Any lookup by bare name proves a false fact.
-- Expected: U5001 three times: `y != 0` (a.bump gives 0), `nonneg(x)` of `inv` (b.nonneg is
-- `x > 0`), `x in 1..10` of `inv_level` (b.Level) (ADR 0038 D6, spec/10 §11 rule 8).
-- Observed: exactly those three U5001 (exit 1); the query names `u!p!lib.a.nonneg` and
-- `u!p!lib.b.nonneg` separately (4ea31cf).
-- Verdict: Held
module app

import lib.a (Level, bump, nonneg)
import lib.b (inv, inv_level)

by_method() -> Int
=
  let y = 1.bump
  100 / y

by_predicate(x: Int) -> Int
  requires nonneg(x)
=
  inv(x)

by_level(x: Level) -> Int = inv_level(x)

pub main() -> Unit
  uses @console: Console[print]
=
  let q = by_method() + by_predicate(0) + by_level(0)
  @console.print("q = {q}")
