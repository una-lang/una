-- Adversarial: callee parameters and `result` that share names with caller binders: two calls of
-- one function in a query (`inc(7)`, `inc(9)`, caller local `x`), a recursive call whose
-- `result` is the caller's own `result`, and a call with swapped labeled arguments.
-- Expected: U5001 postcondition of `count`, `(q - p - 2) != 0`, `c != 0`, precondition `b < a`
-- (spec/12 §3, §4 binders).
-- Observed: exactly those four U5001 (exit 1); callee results are substituted terms or Core
-- temporaries (`%t2`), never the callee's names.
-- Verdict: Held
module t

inc(x: Int) -> Int
  ensures result == x + 1
=
  x + 1

count(n: Int) -> Int
  requires n >= 0
  ensures result == 0
=
  if n > 0
    count(n - 1) + 1
  else
    0

swap_check(a: Int, b: Int) -> Int
  requires a < b
=
  b - a

pub twice() -> Int
=
  let x = 5
  let p = inc(7)
  let q = inc(9)
  100 / (q - p - 2)

pub rec() -> Int
=
  let c = count(3)
  100 / c

pub swapped(a: Int, b: Int) -> Int
  requires a < b
=
  swap_check(a: b, b: a)
