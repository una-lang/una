-- Adversarial: links to links, loops, a link that leaves the grant and comes back, and a
-- link to the grant's parent (ADR 0038 D9 rules 2 and 3).
-- Setup (from this directory): `mkdir -p box/sub outside && echo top > box/a.txt &&
-- echo inside > box/sub/f.txt && echo secret > outside/secret.txt && ln -s l2 box/l1 &&
-- ln -s sub box/l2 && ln -s o2 box/o1 && ln -s ../outside box/o2 && ln -s c2 box/c1 &&
-- ln -s sub/f.txt box/c2 && ln -s sub/f.txt box/fi && ln -s ../box/sub box/back &&
-- ln -s loop box/loop && ln -s .. box/sub/up && ln -s ../.. box/sub/up2`
-- Expected: an intermediate chain that ends inside is followed (`l1/f.txt`, `back/f.txt`,
-- `sub/up/a.txt` ok); one that ends outside is `Denied` (`o1/...`, `sub/up2/...`); a final
-- component that is a link is `Denied` even when it points inside (`c1`, `fi`), for read and
-- write; a loop is `Denied`; `box/sub/f.txt` keeps its content.
-- Observed (`una run`): l1/f.txt ok, o1/secret.txt denied, c1 denied, fi denied, write fi
-- denied, write c1 denied, back/f.txt ok, loop/x denied, loop denied, sub/up/a.txt ok,
-- sub/up2/outside/secret.txt denied, write sub/up2/outside/new.txt denied. box/sub/f.txt still
-- says `inside`; nothing created in `outside/`.
-- Verdict: Held
module chain

describe(e: FileError) -> Text
=
  when e
    is NotFound -> "notfound"
    is Denied -> "denied"
    is Io -> "io"

show_read(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
=
  let a = attempt @files.read(path)
  let status = when a
    is Ok(t) -> "ok"
    is Err(e) -> describe(e)
  @console.print("read [{path}]: {status}")

show_write(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[write]
=
  let a = attempt @files.write(path, content: "written by probe")
  let status = when a
    is Ok(u) -> "ok"
    is Err(e) -> describe(e)
  @console.print("write [{path}]: {status}")

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  show_read("l1/f.txt")
  show_read("o1/secret.txt")
  show_read("c1")
  show_read("fi")
  show_write("fi")
  show_write("c1")
  show_read("back/f.txt")
  show_read("loop/x")
  show_read("loop")
  show_read("sub/up/a.txt")
  show_read("sub/up2/outside/secret.txt")
  show_write("sub/up2/outside/new.txt")
