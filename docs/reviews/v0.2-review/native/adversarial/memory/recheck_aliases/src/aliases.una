-- Aliases of a record word through `take`, a `when` arm, an escaping lambda and containers:
-- a later record of the same kind must not reuse the word while any of them is live.
module aliases

pub kind Point
  x: Int
  y: Int

pub kind Holder
  point: Point

--- Returns the point it takes.
pub forward(take p: Point) -> Point = p

--- Stores `p` in a holder.
pub store(p: Point) -> Holder = Holder(point: p)

--- Binds an alias inside an arm, then builds a point of the same kind.
pub in_arm(o: Option[Point]) -> Text
=
  when o
    is Some(p) ->
      let q = p
      let s = Point(x: 9, y: 9)
      "when: {q.x} {q.y} / {s.x} {s.y}"
    is None -> "none"

--- The x of the point, or 0.
pub px(o: Option[Point]) -> Int
=
  when o
    is Some(p) -> p.x
    is None -> 0

--- The y of the point, or 0.
pub ry(r: Result[Point, Text]) -> Int
=
  when r
    is Ok(p) -> p.y
    is Err(e) -> e.len

pub main() -> Unit
  uses @console: Console[print]
=
  let a = Point(x: 1, y: 2)
  let z = forward(take a)
  let r = Point(x: 7, y: 8)
  @console.print("take: {z.x} {z.y} / {r.x} {r.y}")
  @console.print(in_arm(Some(Point(x: 3, y: 4))))
  let c0 = Point(x: 5, y: 6)
  let c1 = c0
  let fs = [fn(k: Int) -> c1.x + k, fn(k: Int) -> c1.y + k]
  let c2 = Point(x: 70, y: 80)
  @console.print("lambdas: {fs.fold(initial: 0, step: fn(acc, f) -> acc + f(0))} / {c2.x} {c2.y}")
  let l0 = Point(x: 11, y: 12)
  let l1 = l0
  let xs = [l1]
  let l2 = Point(x: 13, y: 14)
  @console.print("list: {xs.fold(initial: 0, step: fn(acc, p) -> acc + p.x)} / {l2.x}")
  let o0 = Point(x: 21, y: 22)
  let o1 = o0
  let opt = Some(o1)
  let res: Result[Point, Text] = Ok(o1)
  let o2 = Point(x: 23, y: 24)
  let o3 = Point(x: 25, y: 26)
  @console.print("option: {px(opt)} {ry(res)} / {o2.x} {o3.x}")
  let h0 = Point(x: 31, y: 32)
  let h1 = h0
  let held = store(h1)
  let edit m = h1
  m.x = 99
  @console.print("stored: {held.point.x} {m.x}")
