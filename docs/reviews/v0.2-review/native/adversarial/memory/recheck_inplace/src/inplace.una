-- An in-place update through an alias made by an `if`, a list, an option, a lambda capture,
-- a `take` call or an `edit` call must leave every other holder of the word unchanged.
module inplace

pub kind Point
  x: Int
  y: Int

pub kind Holder
  point: Point

--- Returns the point it takes.
pub forward(take p: Point) -> Point = p

--- Moves `p` right.
pub nudge(edit p: Point) -> Unit
=
  p.x = p.x + 100

--- The first point, or the origin.
pub head(ps: List[Point]) -> Point
=
  when ps.first()
    is Some(p) -> p
    is None -> Point(x: 0, y: 0)

pub main() -> Unit
  uses @console: Console[print]
=
  run(true)
  run(false)

--- Each shape, with `flag` choosing the branch.
pub run(flag: Bool) -> Unit
  uses @console: Console[print]
=
  let a = Point(x: 1, y: 2)
  let b = Point(x: 3, y: 4)
  let edit m = if flag then a else b
  m.x = 99
  @console.print("if: {a.x} {b.x} {m.x}")
  let c = Point(x: 5, y: 6)
  let xs = [c, c]
  let edit n = head(xs)
  n.x = 98
  @console.print("list: {c.x} {head(xs).x} {n.x}")
  let d = Point(x: 7, y: 8)
  let read = fn(k: Int) -> d.x + k
  let edit e = d
  e.x = 97
  @console.print("captured: {read(0)} {e.x}")
  let f = Point(x: 9, y: 10)
  let held = Holder(point: f)
  let edit g = forward(take f)
  g.x = 96
  @console.print("take: {held.point.x} {g.x}")
  let h = Point(x: 11, y: 12)
  let hs = [h]
  let edit i = h
  nudge(edit i)
  @console.print("edit: {head(hs).x} {i.x}")
  let edit j = Holder(point: Point(x: 13, y: 14))
  let k = j.point
  j.point.x = 95
  @console.print("nested: {k.x} {j.point.x}")
  let edit acc = Point(x: 0, y: 0)
  let edit keep = [acc]
  for step in 1..3
    keep = keep.append(item: acc)
    acc.x = acc.x + step
  @console.print("loop: {keep.fold(initial: 0, step: fn(t, p) -> t + p.x)} {acc.x}")
