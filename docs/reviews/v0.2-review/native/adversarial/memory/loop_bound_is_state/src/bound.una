-- The bounds of a range are evaluated once, before the first iteration (spec/17 §4); a bound
-- that the loop also updates must stay alive while the loop compares against it.
module bound

pub main() -> Unit
  uses @console: Console[print]
=
  let edit n = 4611686018427387904 + 3
  for i in 4611686018427387904..<n
    n = n + 1
  @console.print("n = {n}")
