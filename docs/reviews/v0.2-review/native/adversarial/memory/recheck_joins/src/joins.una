-- Aliases of a record word made by the value of an `if`, a `when`, a projection, a loop and a
-- `together` branch: a later record of the same kind must not reuse the word while any is live.
module joins

pub kind Point
  x: Int
  y: Int

pub kind Holder
  point: Point

pub main() -> Unit
  uses @console: Console[print]
=
  run(true)
  run(false)

--- Each alias shape, with `flag` choosing the branch.
pub run(flag: Bool) -> Unit
  uses @console: Console[print]
=
  let a = Point(x: 1, y: 2)
  let b = Point(x: 3, y: 4)
  let z = if flag then a else b
  let r = Point(x: 7, y: 8)
  @console.print("if: {z.x} {z.y} / {r.x} {r.y}")
  let c = Point(x: 5, y: 6)
  let w = when flag
    is true -> c
    is false -> Point(x: 0, y: 0)
  let s = Point(x: 9, y: 10)
  @console.print("when: {w.x} {w.y} / {s.x} {s.y}")
  let h = Holder(point: Point(x: 11, y: 12))
  let p = h.point
  let h2 = Holder(point: Point(x: 13, y: 14))
  let p2 = Point(x: 15, y: 16)
  @console.print("field: {p.x} {p.y} / {h2.point.x} {p2.x}")
  let t0 = Point(x: 21, y: 22)
  let edit cur = t0
  for i in 0..<3
    cur = if i == 1 then cur else Point(x: cur.x + 1, y: cur.y)
  let t1 = Point(x: 23, y: 24)
  @console.print("loop: {cur.x} {cur.y} / {t1.x}")
  let g0 = Point(x: 31, y: 32)
  let g1 = g0
  together
    let gx = g1.x
    let gy = g1.y
  let g2 = Point(x: 33, y: 34)
  @console.print("together: {gx} {gy} {g1.x} / {g2.x}")
  let ps = together for i in 0..<2
    let q = g1
    let fresh = Point(x: i, y: i)
    q.x + fresh.x
  @console.print("together for: {ps.fold(initial: 0, step: fn(acc, v) -> acc + v)} {g1.y}")
