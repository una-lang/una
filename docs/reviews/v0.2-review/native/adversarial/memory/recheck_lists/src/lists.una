-- A `for` over a list visits the list it evaluated once, whether the body replaces the list
-- through a field, appends to it in place, or edits an element it visits (spec/17 §4).
module lists

pub kind Point
  x: Int
  y: Int

pub kind Bag
  items: List[Point]

pub main() -> Unit
  uses @console: Console[print]
=
  let edit bag = Bag(items: [Point(x: 1, y: 2), Point(x: 3, y: 4)])
  let edit sum = 0
  for p in bag.items
    bag.items = bag.items.append(item: Point(x: p.x * 10, y: 0))
    sum = sum + p.x
  @console.print("field: {sum} {bag.items.len}")
  let edit xs = [Point(x: 5, y: 6), Point(x: 7, y: 8)]
  let edit seen = 0
  for p in xs
    let edit q = p
    q.x = 0
    xs = xs.append(item: q)
    seen = seen + p.x
  @console.print("elements: {seen} {xs.fold(initial: 0, step: fn(t, p) -> t + p.x)} {xs.len}")
  let edit total = 0
  for i in 0..<3
    let edit row = [i, i + 1]
    for v in row
      row = []
      total = total + v
  @console.print("nested: {total}")
