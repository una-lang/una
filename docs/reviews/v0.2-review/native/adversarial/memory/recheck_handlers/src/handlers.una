-- A handler instance holds an alias of a record word as its argument: a record of the same kind
-- built while the handler is installed, or edited in place, must not reuse or change that word.
module handlers

pub kind Point
  x: Int
  y: Int

pub capability Origin
  op get() -> Point

pub handler fixed(p: Point) for Origin
  op get() = p

--- Builds new points while `@origin` is installed, then reads it.
pub probe() -> Text
  uses @origin: Origin[get]
=
  let fresh = Point(x: 70, y: 80)
  let edit other = @origin.get()
  other.x = 99
  let again = @origin.get()
  "{again.x} {again.y} / {fresh.x} {other.x}"

pub main() -> Unit
  uses @console: Console[print]
=
  let a = Point(x: 1, y: 2)
  let z = a
  let t = probe() with @origin = fixed(z)
  let r = Point(x: 7, y: 8)
  @console.print("handler: {t} / {r.x}")
