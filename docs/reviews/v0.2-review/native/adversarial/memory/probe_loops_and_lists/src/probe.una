-- Probes: in-place updates next to loops that visit the updated list, nested loops, closures
-- and lists that hold the value, named functions as values, and failures midway through a loop.
module probe

pub kind Oops = | Bad(at: Int)

pub show(xs: List[Int]) -> Text = xs.fold(initial: "", step: fn(line, x) -> if line == "" then "{x}" else "{line} {x}")

pub double(x: Int) -> Int = x * 2

--- Sets every item to ten times its index, failing at index `stop`.
pub scale(edit xs: List[Int], stop: Int) -> Unit
  fails Oops
=
  for i in 0..<xs.len
    if i == stop
      fail Bad(at: i)
    if i < xs.len
      edit xs.set(index: i, item: i * 10)

pub grow(edit xs: List[Int], stop: Int) -> Unit
  fails Oops
=
  for x in xs
    if x == stop
      fail Bad(at: x)
    xs = xs.append(item: x)

pub main() -> Unit
  uses @console: Console[print]
=
  let edit xs = [1, 2, 3]
  let edit seen = ""
  for x in xs
    if xs.len > 0
      edit xs.set(index: 0, item: x * 10)
    seen = "{seen}{x}"
  @console.print("visit: {seen} / {show(xs)}")
  let edit ys = [1, 2]
  for i in 0..<2
    for y in ys
      ys = ys.append(item: y + i)
  @console.print("nested: {show(ys)}")
  let edit zs = [5, 6]
  let holder = [zs, zs]
  let f = fn(i: Int) -> zs.at(index: i).or_else(default: -1)
  if zs.len > 0
    edit zs.set(index: 0, item: 50)
  zs = zs.append(item: 7)
  let firsts = holder.map(each: fn(l: List[Int]) -> show(l))
  let joined = firsts.fold(initial: "", step: fn(a, b) -> "{a}[{b}]")
  @console.print("held: {joined} {f(0)} / {show(zs)}")
  let doubled = [1, 2, 3].map(each: double)
  @console.print("named: {show(doubled)}")
  let edit kept = [1, 2, 3, 4]
  scale(edit kept, stop: 2)
    if error use unit
  let edit done = [1, 2, 3, 4]
  scale(edit done, stop: 9)
    if error use unit
  @console.print("scale: {show(kept)} / {show(done)}")
  let edit g = [1, 2, 3]
  grow(edit g, stop: 3)
    if error use unit
  let edit h = [1, 2, 3]
  grow(edit h, stop: 9)
    if error use unit
  @console.print("grow: {show(g)} / {show(h)}")
