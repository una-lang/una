-- Probes: closures and handler instances made inside loops that capture the loop's state before
-- it is updated in place, and handled failures inside loop bodies that read the state.
module chl

pub kind Oops = | Bad(at: Int)

pub capability Peek
  op look(i: Int) -> Int

pub handler peeking(items: List[Int]) for Peek
  op look(i) = items.at(index: i).or_else(default: -1)

pub show(xs: List[Int]) -> Text = xs.fold(initial: "", step: fn(line, x) -> if line == "" then "{x}" else "{line} {x}")

pub peek_first() -> Int
  uses @peek: Peek[look]
=
  @peek.look(0)

pub odd(x: Int) -> Int
  fails Oops
=
  if x mod 2 == 1 then fail Bad(at: x) else x

pub main() -> Unit
  uses @console: Console[print]
=
  let edit acc = [0]
  let edit readers: List[fn(Int) -> Int] = []
  let edit seen = ""
  for i in 1..3
    let snapshot = fn(k: Int) -> acc.at(index: k).or_else(default: -1)
    readers = readers.append(item: snapshot)
    let before = peek_first() with @peek = peeking(acc)
    if acc.len > 0
      edit acc.set(index: 0, item: i * 100)
    acc = acc.append(item: i)
    let kept = odd(i)
      if error use acc.len
    seen = "{seen} {before}:{kept}"
  let firsts = readers.map(each: fn(r: fn(Int) -> Int) -> r(0))
  @console.print("acc: {show(acc)} / firsts: {show(firsts)} / seen:{seen}")
