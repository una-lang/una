-- `Link(next: z)`, where `z` took over `a`'s value at `let z = a`, must not reuse `z`'s own
-- object for the new link: that would make a value that contains itself.
module chain

pub kind Chain = End | Link(next: Chain, n: Int)

pub depth(c: Chain) -> Int
=
  when c
    is End -> 0
    is Link(next, n) -> 1 + depth(next)

pub make(n: Int) -> Chain = Link(next: End, n: n)

pub main() -> Unit
  uses @console: Console[print]
=
  let a = make(1)
  let z = a
  let r = Link(next: z, n: 2)
  @console.print("depth {depth(r)}")
