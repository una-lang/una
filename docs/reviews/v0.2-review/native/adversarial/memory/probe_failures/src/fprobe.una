-- Probes: failures in loop bodies, in handled calls inside loops, in lambdas of `map` and
-- `fold`, in handlers' operations, and in `attempt`, while lists and records are alive.
module fprobe

pub kind Oops = | Bad(at: Int, trail: List[Text])

pub kind Box
  items: List[Int]
  name: Text

pub show(xs: List[Int]) -> Text = xs.fold(initial: "", step: fn(line, x) -> if line == "" then "{x}" else "{line} {x}")

pub check(x: Int, note: Text) -> Int
  fails Oops
=
  if x == 3 then fail Bad(at: x, trail: [note, "deep"]) else x

pub fill(edit b: Box, xs: List[Int]) -> Unit
  fails Oops
=
  for x in xs
    let tag = "item {x}"
    let y = check(x, note: tag)
      if error pass
    b.items = b.items.append(item: y)
    b.name = "{b.name}+"

pub soft(edit b: Box, xs: List[Int]) -> Unit
=
  for x in xs
    let tag = "item {x}"
    let y = check(x, note: tag)
      if error use -1
    b.items = b.items.append(item: y)

pub three(x: Int) -> Int
  fails Oops
=
  if x == 3 then fail Bad(at: x, trail: ["three"]) else x

pub mapped(xs: List[Int]) -> List[Int]
  fails Oops
=
  let label = "mapped {xs.len}"
  let out = xs.map(each: three)
    if error pass
  out.append(item: label.len)

pub folded(xs: List[Int]) -> List[Int]
  fails Oops
=
  let label = "folded"
  let out = xs.fold(initial: [0], step: fn(acc: List[Int], x: Int) -> if x == 3 then fail Bad(at: x, trail: [label]) else acc.append(item: x))
    if error pass
  out

pub main() -> Unit
  uses @console: Console[print]
=
  let edit b = Box(items: [0], name: "b")
  fill(edit b, xs: [1, 2, 3, 4])
    if error use unit
  let edit c = Box(items: [0], name: "c")
  fill(edit c, xs: [1, 2])
    if error use unit
  @console.print("fill: {show(b.items)} {b.name} / {show(c.items)} {c.name}")
  let edit d = Box(items: [], name: "d")
  soft(edit d, xs: [1, 3, 5])
  @console.print("soft: {show(d.items)}")
  let m = attempt mapped([1, 2, 3])
  let m2 = attempt mapped([1, 2])
  let fo = attempt folded([1, 2, 3])
  let fo2 = attempt folded([4, 5])
  let ms = when m
    is Ok(v) -> show(v)
    is Err(e) -> "err"
  let ms2 = when m2
    is Ok(v) -> show(v)
    is Err(e) -> "err"
  let fs = when fo
    is Ok(v) -> show(v)
    is Err(e) -> "err"
  let fs2 = when fo2
    is Ok(v) -> show(v)
    is Err(e) -> "err"
  @console.print("hof: {ms} / {ms2} / {fs} / {fs2}")
