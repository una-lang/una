module reflectfw

kind GateError = | Rejected

predicate reflect scaled_large(x: U32) -> Bool = x * 4294967295 > 4294967295

predicate reflect scaled_positive(x: I32) -> Bool = x * -2147483648 > 0

predicate reflect sum_large(x: U32, y: U32) -> Bool = x + y > 4294967295

--- The verifier proves `result == 1`: for the greatest `U32`, the predicate holds.
one(a: U32 in 4294967295..4294967295) -> Int
  ensures result == 1
=
  if scaled_large(a) then 1 else 2

--- Only 0 and 1 pass the gate, so the verifier proves `k in 0..1`.
gate(a: U32) -> Int
  fails GateError
=
  let v = checked(a, not scaled_large(it)) else fail Rejected
  let k: Int in 0..1 = v.to_int()
  let w: Int in 0..2 = k + k
  w

pub main() -> Unit
  uses @console: Console[print]
=
  let a: U32 = 4294967295
  let b: I32 = -2147483648
  let p = scaled_large(a)
  let q = scaled_positive(b)
  let r = sum_large(a, y: a)
  let n = one(a)
  @console.print("{p} {q} {r} {n}")
  let g = attempt gate(a)
  let shown = when g
    is Ok(w) -> "passed with {w}"
    is Err(e) -> "rejected"
  @console.print(shown)
