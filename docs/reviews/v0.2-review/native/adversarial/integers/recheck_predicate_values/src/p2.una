module p2

predicate reflect scaled_large(x: U32) -> Bool = x * 4294967295 > 4294967295

predicate reflect via(x: U32) -> Bool = scaled_large(x)

truthy(b: Bool) -> Bool = b

pub main() -> Unit
  uses @console: Console[print]
=
  let xs: List[U32] = [4294967295, 2]
  let kept = xs.filter(keep: scaled_large)
  let mapped = xs.map(each: scaled_large).filter(keep: truthy)
  let viad = xs.filter(keep: via)
  let f = scaled_large
  let top: U32 = 4294967295
  let parts = together for x in xs
    scaled_large(x)
  together
    let p = f(top)
    let q = via(top)
  @console.print("{kept.len} {mapped.len} {viad.len} {f(top)} {parts.filter(keep: truthy).len} {p} {q}")
