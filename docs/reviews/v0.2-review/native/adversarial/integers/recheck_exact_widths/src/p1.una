module p1

predicate reflect mul64(x: U64) -> Bool = x * 2 > 18446744073709551615

predicate reflect neg64(x: I64) -> Bool = -x > 9223372036854775807

predicate reflect div64(x: I64) -> Bool = x / -1 > 9223372036854775807

predicate reflect sub64(x: U64) -> Bool = x - 18446744073709551615 - 1 < 0

predicate reflect add8(x: U8) -> Bool = x + x > 254

predicate reflect mod8(x: I8) -> Bool = (x * 3) mod 7 == 1

predicate reflect inner(x: U32) -> Bool = x * 2 > 4294967295

predicate reflect outer(x: U32) -> Bool = inner(x + x)

predicate reflect range8(x: U8) -> Bool = x + x in 254..255

predicate reflect cmp(x: I16, y: I16) -> Bool = x - y > 32767

predicate reflect neg8(x: U8) -> Bool = -x < 0

pub main() -> Unit
  uses @console: Console[print]
=
  let a: U64 = 18446744073709551615
  let b: I64 = -9223372036854775808
  let c: U8 = 255
  let d: I8 = -128
  let e: U32 = 4294967295
  let f: I16 = 32767
  let g: I16 = -32768
  let h: U8 = 1
  @console.print("{mul64(a)} {neg64(b)} {div64(b)} {sub64(a)}")
  @console.print("{add8(c)} {mod8(d)} {inner(e)} {outer(e)}")
  @console.print("{range8(c)} {cmp(f, y: g)} {neg8(h)}")
