module p4

kind GateError = | Rejected

predicate reflect branchy(x: U32) -> Bool = x * 2 > 4294967295 and (x + x > 4294967295 or x - 4294967295 - 1 < 0)

gate(a: U32) -> Bool
  fails GateError
=
  let v = checked(a, it * 4294967295 > 4294967295) else fail Rejected
  true

shown(ok: Bool) -> Text = if ok then "passed" else "rejected"

tried(x: U32) -> Text
=
  let r = attempt gate(x)
  shown(r is Ok)

pub main() -> Unit
  uses @console: Console[print]
=
  let xs: List[U32] = [4294967295, 0]
  let parts = together for x in xs
    let r = attempt gate(x)
    shown(r is Ok)
  let mapped = xs.map(each: fn(x) -> tried(x))
  let top: U32 = 4294967295
  @console.print("{parts.len} {mapped.len} {branchy(top)}")
  for p in parts
    @console.print(p)
  for m in mapped
    @console.print(m)
