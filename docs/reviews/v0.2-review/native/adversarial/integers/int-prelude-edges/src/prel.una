module prel

show(o: Option[Int]) -> Text
=
  when o
    is Some(v) -> "{v}"
    is None -> "none"

pub main() -> Unit
  uses @console: Console[print]
=
  let xs = [10, 20, 30]
  let huge = 18446744073709551616
  let a1 = show(xs.at(index: huge))
  let a2 = show(xs.at(index: 0 - huge))
  let a3 = show(xs.at(index: -1))
  let a4 = show(xs.at(index: 2))
  let a5 = show(xs.at(index: 4611686018427387904))
  @console.print("{a1} {a2} {a3} {a4} {a5}")
  let t1 = show("99999999999999999999999".to_int())
  let t2 = show("-0".to_int())
  let t3 = show("-".to_int())
  let t4 = show("".to_int())
  let t5 = show("+5".to_int())
  let t6 = show("٣".to_int())
  let t7 = show("-9223372036854775809".to_int())
  let t8 = show("0004611686018427387904".to_int())
  let t9 = show(" 5".to_int())
  @console.print("{t1} {t2} {t3} {t4} {t5} {t6} {t7} {t8} {t9}")
  let d1 = is_digits("٣")
  let d2 = is_digits("")
  @console.print("{d1} {d2}")
  let m1 = min(huge, b: 0 - huge)
  let m2 = max(4611686018427387903, b: 4611686018427387904)
  let m3 = abs(-4611686018427387904)
  let m4 = abs(0 - huge)
  @console.print("{m1} {m2} {m3} {m4}")
