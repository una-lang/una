module genloop

same[T: Eq](a: T, b: T) -> Bool = a == b

count_u8(lo: U8) -> Int
=
  let edit n = 0
  for i in lo..255
    n = n + i.to_int()
  n

count_i64() -> Int
=
  let least: I64 = -9223372036854775808
  let greatest: I64 = 9223372036854775807
  let edit n = 0
  for i in least..-9223372036854775806
    n = n + i.to_int()
  for j in 9223372036854775805..greatest
    n = n + j.to_int()
  n

count_u64() -> Int
=
  let top: U64 = 18446744073709551615
  let edit n = 0
  for i in 18446744073709551613..top
    n = n + 1
  for k in 18446744073709551614..<top
    n = n + 10
  n

pub main() -> Unit
  uses @console: Console[print]
=
  let a: U64 = 18446744073709551615
  let b: U64 = 9223372036854775808
  let c: I64 = -9223372036854775808
  let d: I64 = 4611686018427387904
  let e: I8 = -128
  let f: I8 = 127
  let s1 = same(a, b: a)
  let s2 = same(c, b: d)
  let s3 = same([a, b], b: [a, b])
  let xs: List[U64] = [18446744073709551615, 18446744073709551615]
  let ys: List[I8] = [-128, -128, 127]
  let l1 = count_u8(250)
  let l2 = count_i64()
  let l3 = count_u64()
  let has = xs.contains(item: a)
  @console.print("{s1} {s2} {s3} {l1} {l2} {l3} {has}")
