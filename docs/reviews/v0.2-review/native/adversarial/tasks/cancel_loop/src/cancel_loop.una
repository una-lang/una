module cancel_loop

pub kind Oops = Bad(n: Int) | Worse

spin(n: Int) -> Int
=
  let edit acc = 0
  for i in 1..n
    acc = (acc + i) mod 1000
  acc

bad(n: Int) -> Int
  fails Oops
=
  if n > 0 then fail Bad(n: n) else n

slow_print(n: Int) -> Int
  uses @console: Console[print]
=
  let edit acc = 0
  for i in 1..n
    @console.print("tick {i}")
    acc = acc + 1
  acc

run() -> Int
  uses @console: Console[print]
  fails Oops
=
  together
    let a = spin(3000000)
    let b = bad(7)
      if error pass
    let c = spin(100000000000)
    let d = slow_print(100000000)
  a + b + c + d

pub main() -> Unit
  uses @console: Console[print]
=
  let r = run()
    if error use -1
  @console.print("r = {r}")
