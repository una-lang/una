module recheck_nested_cancel

pub kind Oops = | Bad(at: Int)

pub kind Rec
  open: Int
  hidden: secret Int

pub capability Src
  op get(n: Int) -> Int
    fails Oops
  op rec(n: Int) -> Rec
  op lab(n: internal Int) -> internal Int
    accepts internal

pub handler src() for Src
  op get(n) = if n == 23 then fail Bad(at: n) else n * 2
  op rec(n) = Rec(open: n, hidden: n + 1)
  op lab(n) = n + 1

leaf(i: Int, j: Int) -> Int
  uses @src: Src[get, rec, lab]
  fails Oops
=
  let r = @src.rec(i * 10 + j)
  let l: internal Int = @src.lab(r.open)
  let g = @src.get(i * 10 + j)
    if error pass
  g + r.open

cell(i: Int) -> Int
  uses @src: Src[get, rec, lab]
  fails Oops
=
  together
    let a = leaf(i, j: 1)
      if error pass
    let b = leaf(i, j: 2)
      if error pass
    let c = leaf(i, j: 3)
      if error pass
  a + b + c

grid() -> List[Int]
  uses @src: Src[get, rec, lab]
  fails Oops
=
  together for i in 1..4
    let c = cell(i)
      if error pass
    c

kept() -> List[Int]
  uses @src: Src[get, rec, lab]
=
  together for i in 1..3
    let v = attempt cell(i)
    when v
      is Ok(x) -> x
      is Err(e) -> -1

shown(e: Oops) -> Text
=
  when e
    is Bad(at) -> "bad {at}"

pub main() -> Unit
  uses @console: Console[print]
=
  let k = kept() with @src = src()
  let r = attempt grid() with @src = src()
  let t = when r
    is Ok(xs) -> "ok {xs.len}"
    is Err(e) -> shown(e)
  @console.print("{k.len} {t}")
