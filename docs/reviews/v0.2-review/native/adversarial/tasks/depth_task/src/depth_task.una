module depth_task

down(n: Int) -> Int = if n <= 0 then 0 else down(n - 1) + 1

nest(k: Int, n: Int) -> Int
=
  if k > 0
    nest(k - 1, n: n) + 1
  else
    together
      let a = down(n)
      let b = down(n - 1)
    let xs = together for i in 1..2
      down(n - i)
    a + b + xs.len

pub main() -> Unit
  uses @console: Console[print]
=
  let r = nest(5, n: 20)
  @console.print("r = {r}")
