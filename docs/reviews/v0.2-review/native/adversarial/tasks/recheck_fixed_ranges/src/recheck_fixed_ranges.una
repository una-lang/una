module recheck_fixed_ranges

full_u8(low: U8, high: U8) -> List[U8]
=
  together for b in low..high
    b

empty_u8(low: U8, high: U8) -> List[U8]
=
  together for b in low..<high
    b

span_i8(low: I8, high: I8) -> List[I8]
=
  together for v in low..high
    v

edges_i64(low: I64, high: I64) -> List[I64]
=
  together for v in low..high
    v

edges_u64(low: U64, high: U64) -> List[U64]
=
  together for v in low..high
    v

shown(xs: List[Int]) -> Text
=
  let edit out = ""
  for x in xs
    out = "{out} {x}"
  "[{out} ]"

pub main() -> Unit
  uses @console: Console[print]
=
  let f = full_u8(0, high: 255)
  @console.print("{f.len} {shown(f.map(each: fn(x) -> x.to_int()))}")
  @console.print(shown(empty_u8(7, high: 7).map(each: fn(x) -> x.to_int())))
  @console.print(shown(empty_u8(9, high: 3).map(each: fn(x) -> x.to_int())))
  @console.print(shown(span_i8(5, high: 1).map(each: fn(x) -> x.to_int())))
  @console.print(shown(span_i8(-128, high: -126).map(each: fn(x) -> x.to_int())))
  @console.print(shown(span_i8(125, high: 127).map(each: fn(x) -> x.to_int())))
  @console.print(shown(edges_i64(9223372036854775805, high: 9223372036854775807).map(each: fn(x) -> x.to_int())))
  @console.print(shown(edges_u64(18446744073709551613, high: 18446744073709551615).map(each: fn(x) -> x.to_int())))
  @console.print(shown(edges_i64(-9223372036854775808, high: -9223372036854775806).map(each: fn(x) -> x.to_int())))
  @console.print(shown(edges_u64(18446744073709551615, high: 0).map(each: fn(x) -> x.to_int())))
