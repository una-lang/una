module moves

pub kind Rec
  items: List[Int]
  name: Text

shown(xs: List[Int]) -> Text = xs.fold(initial: "", step: fn(acc, x) -> if acc == "" then "{x}" else "{acc} {x}")

pub main() -> Unit
  uses @console: Console[print]
=
  let edit xs = [1, 2, 3]
  let edit r = Rec(items: [7, 8], name: "r")
  let nested = [[1], [2, 3], [4, 5, 6]]
  together
    let a = if xs.len > 0
      let edit ys = xs
      ys = ys.append(item: 10)
      if ys.len > 0
        edit ys.set(index: 0, item: 100)
      ys
    else
      xs
    let b = if xs.len > 0
      let edit zs = xs
      zs = zs.append(item: 20)
      zs
    else
      xs
    let c = if r.items.len > 0
      let edit q = r
      q = Rec(items: q.items.append(item: 9), name: "{q.name}!")
      q
    else
      r
  let ws = together for item in nested
    let edit w = item
    w = w.append(item: 0)
    if w.len > 1
      edit w.set(index: 1, item: -1)
    w
  let vs = together for item in nested
    item.append(item: 42)
  xs = xs.append(item: 4)
  if xs.len > 0
    edit xs.set(index: 0, item: -9)
  r = Rec(items: r.items.append(item: 1), name: r.name)
  let edit aa = a
  aa = aa.append(item: 5)
  @console.print("{shown(a)} | {shown(aa)} | {shown(b)} | {shown(c.items)} {c.name} | {shown(xs)} | {shown(r.items)}")
  for w in ws
    @console.print(shown(w))
  for v in vs
    @console.print(shown(v))
  for n in nested
    @console.print(shown(n))
