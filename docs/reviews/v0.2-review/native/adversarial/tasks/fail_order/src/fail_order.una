module fail_order

pub kind Oops = Bad(n: Int, why: Text, items: List[Int]) | Worse

pub capability Log
  op write(line: Text) -> Unit

handler echo(prefix: Text) for Log
  uses @console: Console[print]
  op write(line) = @console.print("{prefix}{line}")

spin(n: Int) -> Int
=
  let edit acc = 0
  for i in 1..n
    acc = acc + i
  acc

bad(n: Int, delay: Int) -> Int
  uses @log: Log[write]
  fails Oops
=
  let s = spin(delay)
  @log.write("failing {n}")
  fail Bad(n: n * 99999999999999999999, why: "task {n} {s}", items: [n, s, 99999999999999999999])

ok(n: Int) -> Int
  uses @log: Log[write]
=
  @log.write("ok {n}")
  n

inner(n: Int) -> Int
  uses @log: Log[write]
  uses @console: Console[print]
  fails Oops
=
  together
    let a = ok(n) with @log = echo("in1:")
    let b = ok(n + 1) with @log = echo("in2:")
    let c = bad(n, delay: 10) with @log = echo("in3:")
      if error pass
  a + b + c

lowest() -> Int
  uses @console: Console[print]
  fails Oops
=
  together
    let a = bad(1, delay: 200000) with @log = echo("a:")
      if error pass
    let b = ok(2) with @log = echo("b:")
    let c = bad(3, delay: 0) with @log = echo("c:")
      if error pass
  a + b + c

ordered() -> Int
  uses @console: Console[print]
  fails Oops
=
  together
    let a = ok(1) with @log = echo("a:")
    let b = ok(2) with @log = echo("b:")
    let c = inner(3) with @log = echo("c:")
      if error pass
  a + b + c

shown(e: Oops) -> Text
=
  when e
    is Bad(n, why, items) -> "Bad {n} {why} {items.len} {items.at(index: 2).or_else(default: 0)}"
    is Worse -> "Worse"

pub main() -> Unit
  uses @console: Console[print]
=
  let r = attempt ordered()
  let s = attempt lowest()
  let rs = together for i in 1..3
    ok(i) with @log = echo("f:")
  let t = when r
    is Ok(v) -> "ok {v}"
    is Err(e) -> shown(e)
  let u = when s
    is Ok(v) -> "ok {v}"
    is Err(e) -> shown(e)
  @console.print(t)
  @console.print(u)
  @console.print("{rs.len}")
