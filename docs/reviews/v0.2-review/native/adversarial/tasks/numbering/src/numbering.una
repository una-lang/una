module numbering

pub capability Log
  op write(line: Text) -> Unit

handler echo(prefix: Text) for Log
  uses @console: Console[print]
  op write(line) = @console.print("{prefix}{line}")

handler wrap(k: Int) for Log
  uses @log: Log[write]
  op write(line) = @log.write("[{k}] {line}")

say(line: Text) -> Int
  uses @log: Log[write]
=
  @log.write(line)
  line.len

fan(tag: Text) -> Int
  uses @log: Log[write]
=
  let first = say("{tag} before") with @log = wrap(0)
  together
    let a = say("{tag}.1")
    let b = say("{tag}.2") with @log = wrap(2)
    let c = deeper("{tag}.3") with @log = wrap(3)
  let xs = together for i in 1..3
    say("{tag} for {i}") with @log = wrap(i)
  first + a + b + c + xs.len

deeper(tag: Text) -> Int
  uses @log: Log[write]
=
  together
    let a = say("{tag}.1") with @log = wrap(5)
    let b = say("{tag}.2")
  a + b

pub main() -> Unit
  uses @console: Console[print]
=
  let zero = say("root") with @log = echo("root:")
  let total = fan("t") with @log = echo("fan:")
  together
    let p = fan("p") with @log = echo("p:")
    let q = say("q") with @log = echo("q:")
    let r = fan("r") with @log = echo("r:")
  let last = say("last") with @log = echo("last:")
  @console.print("{zero} {total} {p} {q} {r} {last}")
