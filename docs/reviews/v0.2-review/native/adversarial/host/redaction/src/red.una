module red

pub kind Card
  owner: Text
  number: secret Text

pub kind Box[T] = | MkBox(value: T)

pub kind Wrap[T] = | MkWrap(tag: Text, hidden: secret T, open: T)

pub kind Leak = Leaked(why: Text, pin: secret Int, card: Card) | Plain

pub kind Refusal = | Blocked(reason: Text, code: secret[PII] Int, inner: Option[Card], box: Box[secret Text], cards: List[Card], wrap: Wrap[Int], level: Int, gen: Box[Int])

pub capability Vault
  op keep(tag: Text, card: Card, extra: List[secret Text], maybe: Option[secret Text], raw: secret Text, box: Box[Card], wrap: Wrap[Text]) -> Unit
    accepts secret[PII]
  op fetch(n: Int) -> Card
  op number(n: Int) -> Int
  op boom(pin: secret Int) -> Unit
    fails Leak
    accepts secret
  op nested(n: Int) -> Option[Card]
  op pair(n: Int) -> Wrap[Text]

handler vault() for Vault
  op keep(tag, card, extra, maybe, raw, box, wrap) = unit
  op fetch(n) = Card(owner: "Ana", number: "4111-FETCHED")
  op number(n) = n * 1000
  op boom(pin) = fail Leaked(why: "boom", pin: pin, card: Card(owner: "Bo", number: "5500-FAILED"))
  op nested(n) = Some(Card(owner: "Cy", number: "6011-NESTED"))
  op pair(n) = MkWrap(tag: "t", hidden: "HIDDEN-PAIR", open: "open")

run_vault(pin: secret Text, code: secret Int) -> Unit
  uses @vault: Vault
=
  let card = Card(owner: "Ana", number: pin)
  @vault.keep("t", card, extra: [pin, "x"], maybe: Some(pin), raw: pin, box: MkBox(value: card), wrap: MkWrap(tag: "w", hidden: pin, open: "visible"))
  let fetched = @vault.fetch(1)
  let s: secret Int = @vault.number(2)
  let plain = @vault.number(3)
  @vault.boom(code)
    if error use unit
  let n = @vault.nested(4)
  let p = @vault.pair(5)
  unit

pub main() -> Unit
  uses @console: Console[print]
  fails Refusal
=
  run_vault("4111-SECRET", code: 8485) with @vault = vault()
  @console.print("before failing")
  let card = Card(owner: "Ana", number: "4111-INFAIL")
  fail Blocked(reason: "maintenance", code: 4242, inner: Some(card), box: MkBox(value: "BOXED-SECRET"), cards: [card], wrap: MkWrap(tag: "w", hidden: 77, open: 78), level: 3, gen: MkBox(value: 5))
