module probe

describe(failure: FileError) -> Text
=
  when failure
    is NotFound -> "NotFound"
    is Denied -> "Denied"
    is Io -> "Io"

read_outcome(path: Text) -> Text
  uses @files: Files[read]
=
  let outcome = attempt @files.read(path)
  when outcome
    is Ok -> "ok"
    is Err(failure) -> describe(failure)

write_outcome(path: Text) -> Text
  uses @files: Files[write]
=
  let outcome = attempt @files.write(path, content: "written")
  when outcome
    is Ok -> "ok"
    is Err(failure) -> describe(failure)

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  let paths = ["a.txt", "./a.txt", "sub/b.txt", "sub/../a.txt", "../outside.txt", "/etc/hosts", "//etc/hosts", "", ".", "sub", "sub/", "a.txt/", "a.txt/.", "link_out", "link_in", "dirlink_out/c.txt", "dirlink_in/b.txt", "dirlink_out/../a.txt", "dangling", "dangling/x", "nosuch/x", "sub/../../outside.txt", "x/../../outside.txt", "a\u{0}b", "caf\u{e9}.txt", "cafe\u{301}.txt", "a.txt\\..", "...", "sub//b.txt", "hard_out", "pfx/a.txt"]
  for p in paths
    let r = read_outcome(p)
    @console.print("read [{p}] {r}")
  let wpaths = ["new.txt", "a.txt", "link_out", "link_in", "dangling", "dirlink_out/new.txt", "dirlink_in/new.txt", "../escape.txt", "/tmp/escape.txt", "", "sub", "sub/", "nosuch/new.txt", "new2.txt/", "a\u{0}c"]
  for p in wpaths
    let w = write_outcome(p)
    @console.print("write [{p}] {w}")
