module pipe

grow(text: Text, times: Int) -> Text
=
  let edit out = text
  for i in 0..<times
    out = "{out}{out}"
  out

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[write]
=
  let line = grow("0123456789abcdef", times: 16)
  @console.print(line)
  @console.print(line)
  @files.write("done.txt", content: "main finished")
    if error use unit
