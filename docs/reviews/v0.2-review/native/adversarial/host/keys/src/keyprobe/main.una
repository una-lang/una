module keyprobe.main

import keyprobe.reveal (matched)

hmac_of(name: Text, data: Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: name, data: data)
    if error pass

compare(a: Text, b: Text) -> Text
  uses @keys: Keys[hmac]
=
  let x = attempt hmac_of(a, data: "payload")
  let y = attempt hmac_of(b, data: "payload")
  when x
    is Err -> "{a} UnknownKey"
    is Ok(hx) ->
      when y
        is Err -> "{b} UnknownKey"
        is Ok(hy) -> if matched(hx == hy) then "{a}=={b}" else "{a}!={b}"

pub main() -> Unit
  uses @console: Console[print]
  uses @keys: Keys[hmac]
  uses @env: Env[get]
  uses @clock: Clock[now]
=
  let c1 = compare("dup", b: "same")
  @console.print(c1)
  let c2 = compare("dup", b: "other2")
  @console.print(c2)
  let c3 = compare("padded", b: "same")
  @console.print(c3)
  let c4 = compare("trailing", b: "same")
  @console.print(c4)
  let c5 = compare("missing", b: "same")
  @console.print(c5)
  let c6 = compare("", b: "same")
  @console.print(c6)
  let t = @clock.now()
  @console.print(if t > 1700000000000 then "clock ok" else "clock wrong")
  let home = @env.get("PROBE_VAR")
  let shown = when home
    is Some -> "env some"
    is None -> "env none"
  @console.print(shown)
  let bad = @env.get("A=B")
  let shown2 = when bad
    is Some -> "env= some"
    is None -> "env= none"
  @console.print(shown2)
  let empty = @env.get("")
  let shown3 = when empty
    is Some -> "env empty some"
    is None -> "env empty none"
  @console.print(shown3)
  let nul = @env.get("A\u{0}B")
  let shown4 = when nul
    is Some -> "env nul some"
    is None -> "env nul none"
  @console.print(shown4)
