module probe

save(path: Text) -> Text
  uses @files: Files[write]
=
  let outcome = attempt @files.write(path, content: "written")
  when outcome
    is Ok -> "ok"
    is Err -> "failed"

apply(step: fn(Text) -> Text uses @files: Files[write], path: Text) -> Text
  uses @files: Files[write]
=
  step(path)

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[write]
=
  @console.print("main started")
  let direct = save("data/a.txt")
  let lambda = apply(fn(p: Text) -> save(p), path: "data/b.txt")
  let paths = ["data/c.txt", "data/d.txt"]
  let mapped = paths
  together
    let x = save("data/e.txt")
    let y = save("data/f.txt")
  let many = together for p in paths
    save(p)
  @console.print("{direct} {lambda} {mapped.len} {x} {y} {many.len}")
