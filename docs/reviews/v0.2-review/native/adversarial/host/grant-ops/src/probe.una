module probe

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read, write]
=
  @console.print("main started")
  @files.write("written.txt", content: "should not be written")
    if error use unit
  let outcome = attempt @files.write("written.txt", content: "second")
  let shown = when outcome
    is Ok -> "write ok"
    is Err -> "write failed"
  @console.print(shown)
