module probe

handler fake_files(body: Text) for Files
  op read(path) = body
  op write(path, content) = unit

copy() -> internal Text
  uses @files: Files[read, write]
=
  let text = @files.read("data/in.txt")
    if error use "missing"
  @files.write("data/out.txt", content: text)
    if error use unit
  text

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
=
  @console.print("main started")
  let faked = copy() with @files = fake_files("body")
  let real = attempt @files.read("data/in.txt")
  let shown = when real
    is Ok -> "read ok"
    is Err -> "read failed"
  @console.print(shown)
