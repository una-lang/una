module probe

pub main() -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
  uses @env: Env[get]
  uses @files: Files[read, write]
=
  @console.print("main started")
  let t = @clock.now()
  let positive = t > 0
  let home = @env.get("UNA_RECHECK")
  let shown = when home
    is Some -> "set"
    is None -> "unset"
  @files.write("data/out.txt", content: "written")
    if error use unit
  let back = attempt @files.read("data/out.txt")
  let read = when back
    is Ok -> "read ok"
    is Err -> "read failed"
  @console.print("{positive} {shown} {read}")
