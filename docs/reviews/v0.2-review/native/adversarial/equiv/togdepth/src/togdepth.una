module togdepth

spin(n: Int) -> Int = if n <= 0 then 0 else 1 + spin(n - 1)

nest(k: Int, n: Int) -> Int
=
  if k <= 0
    let edit t = 0
    together
      let a = spin(n)
      let b = spin(1)
    a + b
  else
    nest(k - 1, n: n) + 1

pub main() -> Unit
  uses @console: Console[print]
=
  let r = nest(10, n: 25)
  @console.print("{r}")
