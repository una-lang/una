module rendergen

pub kind Pair[A, B]
  left: A
  right: B

pub kind Tree[T] = Leaf | Node(value: T, kids: List[Tree[T]])

pub kind Wrap[T] = | Wrapped(inner: Pair[T, Option[T]])

pub kind Color = Red | Green

pub kind Expr = Lit(value: Int) | Pairs(p: Pair[Expr, Expr])

pub capability Sink
  op put(a: Tree[Bool], b: Tree[Unit], c: Pair[Option[Bool], List[Unit]], d: Result[Bool, Unit], e: Wrap[Color], f: Expr, g: Pair[Pair[Int, Bool], Pair[Unit, Color]], h: Option[Pair[Bool, Bool]]) -> Pair[Tree[Bool], Wrap[Unit]]

pub handler sink() for Sink
  op put(a, b, c, d, e, f, g, h) = Pair(left: a, right: Wrapped(inner: Pair(left: unit, right: None)))

mk[T](v: T, w: T) -> Tree[T] = Node(value: v, kids: [Leaf, Node(value: w, kids: [])])

pub run() -> Unit
  uses @sink: Sink[put]
=
  let r = @sink.put(mk(false, w: true), b: mk(unit, w: unit), c: Pair(left: Some(false), right: [unit, unit]), d: Err(unit), e: Wrapped(inner: Pair(left: Green, right: Some(Red))), f: Pairs(p: Pair(left: Lit(value: 0), right: Pairs(p: Pair(left: Lit(value: -1), right: Lit(value: 1))))), g: Pair(left: Pair(left: 0, right: false), right: Pair(left: unit, right: Red)), h: Some(Pair(left: true, right: false)))
  let s = @sink.put(Leaf, b: Leaf, c: Pair(left: None, right: []), d: Ok(true), e: Wrapped(inner: Pair(left: Red, right: None)), f: Lit(value: 0), g: Pair(left: Pair(left: 1, right: true), right: Pair(left: unit, right: Green)), h: None)
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  run() with @sink = sink()
  @console.print("ok")
