module numbering

pub kind Oops = | Bad

pub capability Log
  op note(line: Text) -> Unit

pub handler quiet() for Log
  op note(line) = unit

pub maybe(go: Bool) -> Unit
  uses @log: Log[note]
=
  if go
    @log.note("x")

pub two(go: Bool) -> Unit
  uses @a: Log[note]
  uses @b: Log[note]
=
  if go
    @b.note("b")
  @a.note("a")

pub early() -> Unit
  uses @log: Log[note]
  fails Oops
=
  fail Bad

pub pure_one() -> Int = 3

pub main() -> Unit
  uses @console: Console[print]
=
  maybe(false) with @log = quiet()
  maybe(true) with @log = quiet()
  two(true) with @a = quiet(), @b = quiet()
  early() with @log = quiet()
    if error use unit
  maybe(true) with @log = quiet()
  @console.print("done")
