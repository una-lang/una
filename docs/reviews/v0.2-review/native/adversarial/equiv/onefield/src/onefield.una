module onefield

pub kind Box
  items: List[Int]

pub kind Unitish
  u: Unit

pub kind Sec
  s: secret Int

pub capability Sink
  op put(b: Box, u: Unitish, o: Option[Box]) -> Box

pub handler sink() for Sink
  op put(b, u, o) = b

pub run() -> Unit
  uses @sink: Sink[put]
=
  let b = @sink.put(Box(items: [1]), u: Unitish(u: unit), o: Some(Box(items: [])))
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  run() with @sink = sink()
  @console.print("ok")
