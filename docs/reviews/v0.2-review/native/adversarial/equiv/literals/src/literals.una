module literals

pub kind Oops = | Bad(n: Int)

big() -> Int = 1_000_000_000_000_000_000_000

neg() -> Int = -1_000_000_000_000_000_000_000

zero() -> Int = -0

pick(n: Int) -> Text
=
  when n
    in 1_000_000_000_000_000_000_000..1_000_000_000_000_000_000_000 -> "big"
    in -1_000_000_000_000_000_000_000..-1_000_000_000_000_000_000_000 -> "neg"
    is 0 -> "zero"
    else -> "other"

boom(n: Int) -> Int
  fails Oops
=
  fail Bad(n: -4_611_686_018_427_387_905)

pub main() -> Unit
  uses @console: Console[print]
=
  let a = big()
  let b = neg()
  let c = zero()
  let d = a + b
  let xs = [1_000_000_000_000_000_000_000, -1_000_000_000_000_000_000_000, -0]
  let s = xs.sum
  let e = -(-4611686018427387904)
  let f = -e
  let g = - -4611686018427387904
  @console.print("{a} {b} {c} {d} {s} {e} {f} {g} {pick(a)} {pick(b)} {pick(c)} {pick(d)}")
  let r = boom(1)
    if error use -1
  let r2 = attempt boom(2)
  let r3 = when r2
    is Ok(v) -> v
    is Err(err) ->
      when err
        is Bad(n) -> n
  @console.print("{r} {r3}")
