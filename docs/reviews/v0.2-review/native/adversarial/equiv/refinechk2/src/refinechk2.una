module refinechk2

pub kind Small = Int in 0..10

pub kind Oops = | Bad

predicate opaque near(x: Small) -> Bool = step_up(x)

step_up(y: Small) -> Bool
=
  let d: Int in 1..11 = y + 1
  d > 5

probe(v: Int) -> Int
  fails Oops
=
  let w = checked(v, near(it)) else fail Bad
  w

pub main() -> Unit
  uses @console: Console[print]
=
  let big = 99999999999999999999
  let names = ["ann", "bo"]
  let r = probe(big)
    if error use -1
  let r2 = probe(big)
    if error use -1
  @console.print("{r} {r2} {names.len}")
  let n = names.first().or_else(default: "none")
  @console.print(n)
