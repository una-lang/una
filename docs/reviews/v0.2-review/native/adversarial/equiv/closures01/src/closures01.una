module closures01

pub kind Ops
  name: Text
  run: fn(Int) -> Int

adder(n: Int) -> fn(Int) -> Int = fn(x: Int) -> x + n

compose(f: fn(Int) -> Int, g: fn(Int) -> Int) -> fn(Int) -> Int = fn(x: Int) -> g(f(x))

twice(f: fn(Int) -> Int) -> fn(Int) -> Int = compose(f, g: f)

apply_all(fs: List[fn(Int) -> Int], x: Int) -> List[Int] = fs.map(each: fn(f) -> f(x))

nest(n: Int, f: fn(Int) -> Int) -> fn(Int) -> Int = if n <= 0 then f else nest(n - 1, f: twice(f))

pub main() -> Unit
  uses @console: Console[print]
=
  let big = 99999999999999999999
  let a = adder(big)
  let b = adder(-1)
  let c = compose(a, g: b)
  let ops = Ops(name: "big \"op\"", run: c)
  let r1 = ops.run(1)
  let fs = [a, b, c, twice(c), adder(0)]
  let rs = apply_all(fs, x: 4611686018427387903)
  let line = rs.fold(initial: "", step: fn(acc, v) -> "{acc} {v}")
  @console.print("{r1}{line}")
  let deep = nest(12, f: adder(1))
  let d = deep(0)
  @console.print("{d}")
  let words = ["a", "bb", "ccc"]
  let lens = words.map(each: fn(w) -> w.len)
  let picked = words.first_where(keep: fn(w) -> w.len > 1)
  let p = picked.or_else(default: "none")
  let opsl = [ops, Ops(name: "id", run: fn(x: Int) -> x)]
  let r2 = opsl.map(each: fn(o) -> o.run(2)).fold(initial: 0, step: fn(s, v) -> s + v)
  @console.print("{lens.len} {p} {r2}")
