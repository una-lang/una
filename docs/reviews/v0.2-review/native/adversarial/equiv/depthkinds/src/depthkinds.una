module depthkinds

import depthkinds.pol (lower)

pub kind Oops = | Bad

pub capability Probe
  op go(n: Int) -> Int

pub handler prober() for Probe
  op go(n) = n + 1

predicate opaque ok(x: Int) -> Bool = helper(x) > 0

helper(x: Int) -> Int = x + 1

via_pred(v: Int) -> Int
  fails Oops
=
  checked(v, ok(it)) else fail Bad

via_policy(v: Int) -> Int = lower(v)

via_lambda(v: Int) -> Int
=
  let xs = [v].map(each: fn(k) -> helper(k))
  xs.sum

pub via_op(v: Int) -> Int
  uses @probe: Probe[go]
=
  let r = @probe.go(v)
  r

down(n: Int) -> Int
  uses @probe: Probe[go]
  fails Oops
=
  if n <= 0
    let a = via_pred(1)
      if error pass
    let b = via_policy(2)
    let c = via_lambda(3)
    let d = via_op(4)
    a + b + c + d
  else
    let r = down(n - 1)
      if error pass
    r + 1

pub main() -> Unit
  uses @console: Console[print]
=
  let r = down(20) with @probe = prober()
    if error use -1
  @console.print("{r}")
