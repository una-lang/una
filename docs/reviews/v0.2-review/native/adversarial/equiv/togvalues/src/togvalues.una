module togvalues

pub kind Box
  f: fn(Int) -> Int
  name: Text

adder(n: Int) -> fn(Int) -> Int = fn(x: Int) -> x + n

boxed(n: Int) -> Box = Box(f: adder(n), name: "b{n}")

pub main() -> Unit
  uses @console: Console[print]
=
  let big = 99999999999999999999
  let g = adder(big)
  together
    let f1 = adder(big)
    let b1 = boxed(7)
    let r = g(1)
    let fs = [g, adder(2)].map(each: fn(h) -> h(10))
  let fs2 = together for i in 0..<3
    adder(i * big)
  let applied = fs2.map(each: fn(h) -> h(1))
  @console.print("{f1(1)} {b1.f(1)} {b1.name} {r} {fs.sum} {applied.sum}")
