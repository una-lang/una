module handlers2

pub kind Oops = Bad(n: Int) | Worse

pub capability Log
  op note(line: Text) -> Unit

pub capability Count
  op next(by: Int) -> Int
    fails Oops

pub handler console_log(prefix: Text) for Log
  uses @console: Console[print]
  op note(line) = @console.print("{prefix}{line}")

pub handler counter(start: Int) for Count
  uses @log: Log[note]
  op next(by) =
    @log.note("next {by} from {start}")
    if by < 0 then fail Bad(n: by) else start + by

pub handler wrapper(k: Int) for Log
  uses @log: Log[note]
  op note(line) =
    @log.note("[{k}] {line}")
    unit

pub step(by: Int) -> Int
  uses @count: Count[next]
  fails Oops
=
  let v = @count.next(by)
    if error pass
  v

pub twice(by: Int) -> Int
  uses @log: Log[note]
  fails Oops
=
  let a = step(by) with @count = counter(10)
    if error pass
  let b = step(by) with @count = counter(a)
    if error pass
  b

pub inner_log(line: Text) -> Unit
  uses @log: Log[note]
=
  @log.note(line) with @log = wrapper(1)
  @log.note(line) with @log = wrapper(2)

pub main() -> Unit
  uses @console: Console[print]
=
  let r = twice(1) with @log = console_log("a: ")
    if error use -1
  let s = attempt twice(-1) with @log = console_log("b: ")
  for i in 0..<3
    inner_log("loop {i}") with @log = console_log("c{i}: ")
  let edit total = 0
  for i in [5, -5, 6]
    let v = twice(i) with @log = console_log("d: ")
      if error use 0
    total = total + v
  let ok = when s
    is Ok(v) -> v
    is Err(e) ->
      when e
        is Bad(n) -> n
        is Worse -> 0
  @console.print("{r} {ok} {total}")
