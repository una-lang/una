module render

pub kind Color = Red | Green | Blue

pub kind Card
  owner: Text
  number: secret Text
  tag: Option[internal Int]

pub kind Shape = Dot | Circle(radius: Int) | Rect(w: Int, h: Int) | Named(name: Text, inner: Option[Shape])

pub kind Pair[A, B]
  left: A
  right: B

pub kind Oops = Bad(code: Int, why: Text) | Worse(n: Int)

pub capability Sink
  op put(t: Text, n: Int, b: Bool, u: Unit, c: Color, s: Shape, l: List[Option[Int]], p: Pair[Text, List[Shape]], r: Result[Int, Oops]) -> Shape
  op card(c: Card, cs: List[Card], o: Option[Option[Card]]) -> Unit
    accepts secret
  op boom(n: Int) -> Pair[Int, Option[Text]]
    fails Oops
  op fun(f: fn(Int) -> Int) -> Int

pub handler sink() for Sink
  op put(t, n, b, u, c, s, l, p, r) = Named(name: "{t}\"x\\y\n", inner: Some(s))
  op card(c, cs, o) = unit
  op boom(n) = if n > 0 then Pair(left: -n, right: Some("a\tb\u{1}\u{7f}\u{202e}é")) else fail Bad(code: -12345678901234567890, why: "w\"hy")
  op fun(f) = f(3)

pub run() -> Unit
  uses @sink: Sink[put, card, boom, fun]
=
  let pin: secret Text = "4111"
  let card = Card(owner: "Ana \"A\"", number: pin, tag: Some(7))
  let shape = Named(name: "n", inner: Some(Named(name: "m", inner: Some(Rect(w: -1, h: 0)))))
  let x = @sink.put("q\"\\\n\t\u{0}\u{1f}\u{a0}", n: -4611686018427387905, b: false, u: unit, c: Blue, s: shape, l: [Some(-1), None, Some(99999999999999999999)], p: Pair(left: "", right: [Dot, Circle(radius: 3)]), r: Err(Bad(code: -1, why: "")))
  let y = @sink.card(card, cs: [card, card], o: Some(Some(card)))
  let z = @sink.boom(1)
    if error use Pair(left: 0, right: None)
  let w = @sink.boom(-1)
    if error use Pair(left: 0, right: None)
  let v = @sink.fun(fn(k) -> k + 1)
  let e: List[Int] = []
  let q = @sink.put("", n: 0, b: true, u: unit, c: Red, s: Dot, l: [], p: Pair(left: "x", right: []), r: Ok(5))
  unit

pub main() -> Unit
  uses @console: Console[print]
=
  run() with @sink = sink()
  @console.print("done")
