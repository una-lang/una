module refinechk

pub kind Small = Int in 0..10

pub kind Oops = | Bad

--- The argument of `roomy` in `checked` is not proven to be `Small`.
predicate opaque roomy(x: Small) -> Bool = twice_big(x)

--- `y + y` is proven in `0..20`, so the backend adds machine words with no check.
twice_big(y: Small) -> Bool
=
  let d: Int in 0..20 = y + y
  d > 5

probe(v: Int) -> Int
  fails Oops
=
  let w = checked(v, roomy(it)) else fail Bad
  w

pub main() -> Unit
  uses @console: Console[print]
=
  let r = probe(4611686018427387903)
    if error use -1
  let r2 = probe(4)
    if error use -1
  let r3 = probe(-3)
    if error use -1
  @console.print("{r} {r2} {r3}")
