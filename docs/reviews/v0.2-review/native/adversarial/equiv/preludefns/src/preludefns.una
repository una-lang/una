module preludefns

show(o: Option[Int]) -> Text
=
  when o
    is Some(v) -> "S{v}"
    is None -> "N"

pub main() -> Unit
  uses @console: Console[print]
=
  let xs = [10, 20, 30]
  let big = 99999999999999999999
  let a1 = xs.at(index: big)
  let a2 = xs.at(index: 0 - big)
  let a3 = xs.at(index: -1)
  let a4 = xs.at(index: 4611686018427387904)
  let a5 = xs.at(index: -4611686018427387905)
  let a6 = xs.at(index: 2)
  let a7 = xs.at(index: 18446744073709551616)
  let a8 = xs.at(index: 18446744073709551617)
  let a9 = xs.at(index: 9223372036854775808)
  @console.print("{show(a1)} {show(a2)} {show(a3)} {show(a4)} {show(a5)} {show(a6)} {show(a7)} {show(a8)} {show(a9)}")
  let s1 = sum([big, big, -1])
  let nil: List[Int] = []
  let s2 = sum(nil)
  let m1 = min(big, b: 0 - big)
  let m2 = max(4611686018427387903, b: 4611686018427387904)
  let ab = abs(-4611686018427387904)
  let e1 = is_empty(nil)
  let e2 = [big].contains(item: 99999999999999999998 + 1)
  let f1 = [1, 2].first()
  let no: Option[Int] = None
  let o1 = no.or_else(default: big)
  let r: Result[Int, Text] = Ok(1)
  let ok = is_ok(r)
  let nn: Option[Option[Int]] = Some(None)
  let sm = is_some(nn)
  @console.print("{s1} {s2} {m1} {m2} {ab} {e1} {e2} {show(f1)} {o1} {ok} {sm}")
