module togsilent

pub kind Oops = | Bad(n: Int)

pub capability Log
  op note(n: Int) -> Int

pub handler quiet() for Log
  op note(n) = 0

maybe(go: Bool) -> Int
  uses @log: Log[note]
=
  if go
    let v = @log.note(1)
    v
  else
    0

risky(n: Int) -> Int
  fails Oops
=
  let a = maybe(false) with @log = quiet()
  if n == 1
    fail Bad(n: n)
  let b = maybe(true) with @log = quiet()
  a + b

pub main() -> Unit
  uses @console: Console[print]
=
  together
    let a = maybe(false) with @log = quiet()
    let b = maybe(true) with @log = quiet()
  let c = maybe(true) with @log = quiet()
  let xs = attempt run_all()
  let d = maybe(true) with @log = quiet()
  @console.print("{a} {b} {c} {d}")

run_all() -> List[Int]
  fails Oops
=
  let r = together for i in 0..<3
    let v = risky(i)
      if error pass
    v
  r
