module refinefn

pub kind Small = Int in 0..10

double(x: Small) -> Int = x + x

apply(f: fn(Int) -> Int, v: Int) -> Int = f(v)

pub main() -> Unit
  uses @console: Console[print]
=
  let xs = [4611686018427387903, 3]
  let ys = xs.map(each: fn(x: Small) -> x + x)
  let zs = xs.map(each: double)
  let w = apply(double, v: 4611686018427387903)
  @console.print("{ys.sum} {zs.sum} {w}")
