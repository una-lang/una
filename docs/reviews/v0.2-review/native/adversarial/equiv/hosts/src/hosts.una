module hosts

import hosts.pub_keys (open_hash)

pub capability Sink
  op put(h: Hashed, same: Bool) -> Unit

pub handler sink() for Sink
  op put(h, same) = unit

fe(e: FileError) -> Text
=
  when e
    is NotFound -> "NotFound"
    is Denied -> "Denied"
    is Io -> "Io"

pub show_read(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
=
  let r = attempt @files.read(path)
  let shown = when r
    is Ok(v) -> "ok"
    is Err(e) -> fe(e)
  @console.print("read {path}: {shown}")

pub show_write(path: Text) -> Unit
  uses @console: Console[print]
  uses @files: Files[write]
=
  let r = attempt @files.write(path, content: "hello\u{0}é")
  let shown = when r
    is Ok(v) -> "ok"
    is Err(e) -> fe(e)
  @console.print("write {path}: {shown}")

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
  uses @files: Files[read, write]
  uses @keys: Keys[hmac]
=
  let home = @env.get("UNA_EQUIV_NOPE")
  let missing = home is None
  let present = @env.get("UNA_EQUIV_SET")
  let p = present is Some
  @console.print("env {missing} {p}")
  show_write("out.txt")
  show_read("out.txt")
  show_read("missing.txt")
  show_read("../escape.txt")
  show_read("/etc/hosts")
  show_read("sub/../out.txt")
  show_read("link.txt")
  show_read("")
  show_read(".")
  show_read("sub")
  show_write("sub")
  show_write("nodir/x.txt")
  show_write("link.txt")
  let h1 = open_hash("abc")
    if error use None
  let h2 = open_hash("abc")
    if error use None
  let h3 = open_hash("abd")
    if error use None
  let s12 = h1 == h2
  let s13 = h1 == h3
  @console.print("hash {s12} {s13}")
  put_all(h1, same: s12) with @sink = sink()
  let bad = attempt @keys.hmac(key_name: "nokey", data: "x")
  let b = when bad
    is Ok(v) -> "ok"
    is Err(e) -> "UnknownKey"
  @console.print("bad key {b}")

pub put_all(o: Option[Hashed], same: Bool) -> Unit
  uses @sink: Sink[put]
=
  when o
    is Some(h) -> @sink.put(h, same)
    is None -> unit
