trusted module hosts.pub_keys

pub policy open_hash
  from Text
  to Option[Hashed]
  via hash_it
  purpose "test rendering of hashes"
  owner review

hash_it(t: Text) -> Option[Hashed]
  uses @keys: Keys[hmac]
  fails KeyError
=
  let h = @keys.hmac(key_name: "k1", data: t)
    if error pass
  Some(h)
