module hosthandlers

pub handler loud(prefix: Text) for Console
  uses @console: Console[print]
  op print(line) = @console.print("{prefix}{line}")

pub handler frozen(t: Int) for Clock
  op now() = t

pub handler fake_files(body: Text) for Files
  op read(path) = if path == "x" then fail NotFound else body
  op write(path, content) = unit

pub greet(n: Int) -> Unit
  uses @console: Console[print]
=
  @console.print("hello {n}")

pub stamp() -> Int
  uses @clock: Clock[now]
=
  let t = @clock.now()
  t

pub files_go() -> internal Text
  uses @files: Files[read, write]
=
  let a = @files.read("x")
    if error use "missing"
  let b = @files.read("y")
    if error use "missing"
  @files.write("d", content: a)
    if error use unit
  "{a}/{b}"

pub main() -> Unit
  uses @console: Console[print]
  uses @clock: Clock[now]
=
  greet(1) with @console = loud("> ")
  greet(2) with @console = @console
  greet(3)
  let t = stamp() with @clock = frozen(-99999999999999999999)
  @console.print("{t}")
  let real = stamp()
  let positive = real > 0
  let f = files_go() with @files = fake_files("body")
  @console.print("{positive}")
