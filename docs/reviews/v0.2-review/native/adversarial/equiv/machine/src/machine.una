module machine

pub kind Delta = Int in -1000..1000

pub kind Edge = Int where it >= -4611686018427387904 and it <= 4611686018427387903

mulp(a: Delta, b: Delta) -> Int
=
  let p: Int in -1000000..1000000 = a * 1000
  let q: Int in -2000..2000 = a - b
  let r: Int in -2000..2000 = a + b
  let s: Int in -1000..1000 = -a
  let big = p * 99999999999999
  p + q + r + s + big

edgy(a: Edge, b: Edge) -> Int
=
  let s = a + b
  let d = a - b
  let m = a * b
  let c = a < b
  let e = a == 4611686018427387903
  let f = if c then 1 else 0
  let g = if e then 10 else 0
  s + d + m + f + g

pub main() -> Unit
  uses @console: Console[print]
=
  let r1 = mulp(-1000, b: -1000)
  let r2 = mulp(-7, b: 3)
  let r3 = mulp(1000, b: -1000)
  let r4 = edgy(4611686018427387903, b: 4611686018427387903)
  let r5 = edgy(-4611686018427387904, b: -4611686018427387904)
  let r6 = edgy(-4611686018427387904, b: 4611686018427387903)
  @console.print("{r1} {r2} {r3} {r4} {r5} {r6}")
