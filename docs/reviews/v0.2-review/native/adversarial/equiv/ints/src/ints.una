module ints

pow2(n: Int) -> Int = if n <= 0 then 1 else 2 * pow2(n - 1)

pub main() -> Unit
  uses @console: Console[print]
=
  let a = 4611686018427387903
  let b = a + 1
  let c = -4611686018427387904
  let d = c - 1
  let e = 9223372036854775807
  let f = e + 1
  @console.print("{a} {b} {c} {d} {e} {f}")
  let g = b - 1
  let same = g == a
  let lt = a < b
  let lt2 = d < c
  @console.print("{g} {same} {lt} {lt2}")
  let p = pow2(62)
  let q = pow2(63)
  let r = pow2(64)
  let m = 0 - p
  @console.print("{p} {q} {r} {m}")
  let x = r * r * r
  let y = x / 7
  let z = x mod 7
  let nx = 0 - x
  let ny = nx / 7
  let nz = nx mod 7
  @console.print("{x} {y} {z}")
  @console.print("{nx} {ny} {nz}")
  let s = -7 / 2
  let t = -7 mod 2
  let u = 7 / -2
  let v = 7 mod -2
  let w = -7 / -2
  let w2 = -7 mod -2
  @console.print("{s} {t} {u} {v} {w} {w2}")
  let big = c / -1
  let bigm = c mod -1
  @console.print("{big} {bigm}")
  let k = nx / -7
  let k2 = nx mod -7
  let k3 = if nx != 0 then nx / nx else 0
  let k4 = if x + 1 != 0 then x / (x + 1) else 0
  let k5 = if x != 0 then (x + 1) mod x else 0
  @console.print("{k} {k2} {k3} {k4} {k5}")
  let back = (b - 1) * 1
  let eqx = back == a
  let mul = a * a
  let shrink = if a != 0 then mul / a else 0
  let eqm = shrink == a
  @console.print("{back} {eqx} {mul} {shrink} {eqm}")
  let ab = abs(c)
  let ab2 = abs(nx)
  let mn = min(d, b: c)
  let mx = max(b, b: e)
  @console.print("{ab} {ab2} {mn} {mx}")
