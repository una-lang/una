module deep

pub kind Expr = Lit(value: Int) | Neg(operand: Expr) | Add(left: Expr, right: Expr)

pub kind Chain
  value: Int
  next: Option[Chain]

pub capability Sink
  op put(e: Expr) -> Unit

pub handler sink() for Sink
  op put(e) = unit

build(n: Int) -> Expr
=
  let edit e = Lit(value: 0)
  for i in 0..<n
    e = Neg(operand: e)
  e

chain(n: Int) -> Chain
=
  let edit c = Chain(value: 0, next: None)
  for i in 0..<n
    c = Chain(value: i, next: Some(c))
  c

leftadd(n: Int) -> Expr
=
  let edit e = Lit(value: 1)
  for i in 0..<n
    e = Add(left: e, right: Lit(value: i))
  e

pub send(e: Expr) -> Unit
  uses @sink: Sink[put]
=
  @sink.put(e)

pub main() -> Unit
  uses @console: Console[print]
=
  let a = build(300000)
  let b = build(300000)
  let c = build(299999)
  let same = a == b
  let diff = a == c
  let lt = a != c
  @console.print("{same} {diff} {lt}")
  let x = chain(300000)
  let y = chain(300000)
  let eqc = x == y
  @console.print("chains {eqc}")
  let l1 = leftadd(200000)
  let l2 = leftadd(200000)
  let eql = l1 == l2
  @console.print("left {eql}")
  let small = build(3)
  send(small) with @sink = sink()
  send(a) with @sink = sink()
  @console.print("sent")
