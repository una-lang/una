module opinnercancel

pub kind Oops = | Bad

pub capability Work
  op step(n: Int) -> Int

pub capability Inner
  op deep(n: Int) -> Int

pub capability Log
  op note(n: Int) -> Int

handler quiet() for Log
  op note(n) = n

spin(n: Int) -> Int
=
  let edit t = 0
  for i in 0..<n
    t = t + 1
  t

rec(n: Int) -> Int = if n <= 0 then 0 else 1 + rec(n - 1)

--- Fails after some work, while the second task is inside its operations.
early() -> Int
  fails Oops
=
  let w = spin(30000)
  if w > 0
    fail Bad
  w

steps(k: Int) -> Int
  uses @work: Work[step]
=
  let edit total = 0
  for i in 0..<k
    let s = @work.step(20000)
    total = total + s
  total

handler cancels() for Work
  uses @log: Log[note]
  op step(n) =
    let r = attempt inner(n)
    when r
      is Ok(v) -> v
      is Err(e) -> n

inner(n: Int) -> Int
  uses @log: Log[note]
  fails Oops
=
  together
    let a = early()
      if error pass
    let b = noting(n)
  a + b

noting(n: Int) -> Int
  uses @log: Log[note]
=
  let edit t = 0
  for i in 0..<n
    let o = @log.note(1)
    t = t + o
  t

viacancels(k: Int) -> Int
  uses @log: Log[note]
=
  steps(k) with @work = cancels()

pick() -> Int
  fails Oops
=
  together
    let a = early()
      if error pass
    let b = viacancels(20) with @log = quiet()
  a + b

pub main() -> Unit
  uses @console: Console[print]
=
  let r = attempt pick()
  let shown = when r
    is Ok(v) -> "ok {v}"
    is Err(e) -> "failed"
  @console.print(shown)
