-- #201 recheck: `append` and `set` update a list in place at the last use of its binding.
-- Every other holder of the list (an alias, a lambda, a record, a caller, a loop's initial
-- state, a handler) must keep its value.
module aliases

pub kind Box
  items: List[Int]

pub kind Oops = Boom | Bust

--- Returns `xs` with `v` appended.
pub push(xs: List[Int], v: Int) -> List[Int] = xs.append(item: v)

--- Appends 0 to `xs`.
pub grow(edit xs: List[Int]) -> Unit
=
  xs = xs.append(item: 0)

--- Appends 1 to `xs`, then fails.
pub grow_fail(edit xs: List[Int]) -> Unit
  fails Oops
=
  xs = xs.append(item: 1)
  fail Boom

--- The sum of the elements.
pub sum(xs: List[Int]) -> Int = xs.fold(initial: 0, step: fn(acc, x) -> acc + x)

pub main() -> Unit
  uses @console: Console[print]
=
  let edit xs = [1, 2, 3]
  let ys = xs
  xs = xs.append(item: 4)
  @console.print("alias: {ys.len} {xs.len}")
  let edit a = [1]
  let f = fn(k: Int) -> a.len + k
  a = a.append(item: 2)
  @console.print("lambda: {f(0)} {a.len}")
  let edit b = [5]
  let box = Box(items: b)
  b = b.append(item: 6)
  @console.print("record: {box.items.len} {b.len}")
  let edit s = [1, 2, 3]
  let s0 = s
  edit s.set(index: 0, item: 9)
  @console.print("set: {sum(s0)} {sum(s)}")
  let edit c = [7]
  let c0 = c
  grow(edit c)
  @console.print("edit param: {c0.len} {c.len}")
  let p = [1]
  let q = push(p, v: 2)
  @console.print("returned: {p.len} {q.len}")
  let edit d = [1]
  let d0 = d
  let edit failed = 0
  grow_fail(edit d)
    if error use unit
  @console.print("failed edit: {d0.len} {d.len}")
  let edit acc = [0]
  let before = acc
  for i in 0..<3
    acc = acc.append(item: i)
  @console.print("loop state: {before.len} {acc.len}")
  let base = [1, 2]
  let edit out: List[List[Int]] = []
  for i in 0..<3
    let t = base.append(item: i)
    out = out.append(item: t)
  @console.print("loop outer: {base.len} {out.fold(initial: 0, step: fn(n, l) -> n + sum(l))}")
  let edit nest: List[Int] = []
  let edit snaps: List[List[Int]] = []
  for i in 0..<3
    for j in 0..<2
      nest = nest.append(item: i * 10 + j)
    snaps = snaps.append(item: nest)
  let lens = snaps.fold(initial: 0, step: fn(n, l) -> n * 10 + l.len)
  @console.print("nested: {lens} {sum(nest)}")
  let edit w = [1, 2]
  let o = Some(w)
  w = w.append(item: 3)
  let held = when o
    is Some(v) -> v.len
    is None -> -1
  @console.print("option: {held} {w.len}")
  let edit g = [4]
  let gs = [g, g]
  g = g.append(item: 5)
  edit g.set(index: 0, item: 0)
  @console.print("list of lists: {gs.fold(initial: 0, step: fn(n, l) -> n + sum(l))} {sum(g)}")
