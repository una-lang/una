-- #201 recheck: a loop that appends to a list it binds, inside another loop or a `together`
-- task. The native code appends in place. The interpreter copies the list at each append, so
-- it takes quadratic time: the later entry of the enclosing loop or task is its whole body,
-- whose reads include the inner state, which every iteration binds anew. In a debug build:
-- nested, 1.5 s at 10,000 appends and 10.9 s at 30,000, against 0.4 s natively, and 213 s
-- against 0.8 s for a 316 by 316 nest; in a task, 1.2 s and 12.5 s, against 0.4 s and 2.0 s.
module nested

pub main() -> Unit
  uses @console: Console[print]
=
  let edit acc: List[Int] = []
  for i in 0..<1
    for j in 0..<30000
      acc = acc.append(item: j)
  together
    let a = if acc.len > 0
      let edit own: List[Int] = []
      for k in 0..<10000
        own = own.append(item: k)
      own
    else
      []
    let b = acc.len
  @console.print("{acc.len} {a.len} {b}")
