module opfails

pub kind Oops = | Bad

pub capability Work
  op step(n: Int) -> Int
    fails Oops

pub capability Inner
  op deep(n: Int) -> Int

pub capability Log
  op note(n: Int) -> Int

handler quiet() for Log
  op note(n) = n

spin(n: Int) -> Int
=
  let edit t = 0
  for i in 0..<n
    t = t + 1
  t

rec(n: Int) -> Int = if n <= 0 then 0 else 1 + rec(n - 1)

--- Fails after some work, while the second task is inside its operations.
early() -> Int
  fails Oops
=
  let w = spin(30000)
  if w > 0
    fail Bad
  w

steps(k: Int) -> Int
  uses @work: Work[step]
=
  let edit total = 0
  for i in 0..<k
    let r = attempt @work.step(20000 + i)
    let s = when r
      is Ok(v) -> v
      is Err(e) -> 1
    total = total + s
  total

handler busy() for Work
  op step(n) =
    let a = spin(n)
    if a / 2 * 2 == a then fail Bad else a

pick() -> Int
  fails Oops
=
  together
    let a = early()
      if error pass
    let b = steps(50) with @work = busy()
  a + b

pub main() -> Unit
  uses @console: Console[print]
=
  let r = attempt pick()
  let shown = when r
    is Ok(v) -> "ok {v}"
    is Err(e) -> "failed"
  @console.print(shown)
