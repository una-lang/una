module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Box[T]
  run: fn(T) -> Int

g[T](a: T, b: T, step: fn(Int, Text) -> Int) -> Unit
  uses @log: Log[write]
=
  let e = ""
  let x = "x"
  let n = [if a == b then e else x].fold(initial: 0, step: step)
  @log.write(n)

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], step: fn(acc, t) -> acc + t.len)
