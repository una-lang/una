-- expect: a leak if  prints a different number for S="" and S="x", with no diagnostic
module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

g[T](a: T, b: T, p: T, q: T, keep: fn(T) -> Bool) -> Unit
  uses @log: Log[write]
=
  let kept = [if a == b then p else q].filter(keep: keep)
  @log.write(kept.len)

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], p: [], q: [1], keep: fn(xs) -> xs.len > 0)
