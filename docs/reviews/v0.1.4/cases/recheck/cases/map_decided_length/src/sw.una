module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

g[T](a: T, b: T, p: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let ns = (if a == b then [p] else [p, p]).map(each: k)
  @log.write(ns.len)

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], p: [1], k: fn(ys) -> ys.len)
