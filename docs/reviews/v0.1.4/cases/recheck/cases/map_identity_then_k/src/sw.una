module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

g[T](a: T, b: T, p: T, q: T, same: fn(T) -> T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let ys = [if a == b then p else q].map(each: same)
  let ns = ys.map(each: k)
  @log.write(ns.sum())

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], p: [], q: [1], same: fn(ys) -> ys, k: fn(ys) -> ys.len)
