module sw

pub capability Log
  op write(n: Int) -> Unit

pub handler to_console() for Log
  uses @console: Console[print]
  op write(n) = @console.print("{n}")

pub kind Boom = Bang | Other

g[T](a: T, b: T, p: T, q: T, z: fn(T) -> Int fails Boom) -> Unit
  uses @log: Log[write]
  fails Boom
=
  let ns = [if a == b then p else q].map(each: z)
    if error pass
  @log.write(0)

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let s = @env.get("S")
    if none use ""
  run(s.len) with @log = to_console()

run(v: internal Int) -> Unit
  uses @log: Log[write]
=
  g([v], b: [0], p: [], q: [1], z: fn(ys) -> ys.len)
