-- expect: leak (U4003): the comparison is made by a generic helper, then decides k's argument
module sw

pub capability Log
  op write(n: Int) -> Unit

same[U](x: U, y: U) -> Bool = x == y

g[T](a: T, b: T, p: T, q: T, k: fn(T) -> Int) -> Unit
  uses @log: Log[write]
=
  let n = k(if same(a, y: b) then p else q)
  @log.write(n)

pub leak(s: secret Int) -> Unit
  uses @log: Log[write]
=
  g([s], b: [0], p: [], q: [1], k: fn(xs) -> xs.len)
