module stock

import credentials (api_token)

count_of(response: internal Response) -> internal Option[internal Int]
=
  let parsed = attempt parse_json(response.body)
  if response.status != 200
    None
  else
    when parsed
      is Err(failure) -> None
      is Ok(value) -> count_field(value)

count_field(doc: internal Json) -> internal Option[internal Int]
=
  when doc
    is Object(fields) -> number_of(fields.get(key: "count"))
    else -> None

number_of(found: internal Option[Json]) -> internal Option[internal Int]
=
  when found
    is Some(value) -> int_of(value)
    is None -> None

int_of(doc: internal Json) -> internal Option[internal Int]
=
  when doc
    is Number(value) -> Some(value)
    else -> None

--- The stock level of `item` from the inventory API, or nothing when the request or the reply fails.
pub stock_level(item: Text, token: secret Text) -> internal Option[internal Int]
  uses @http: Http[get]
=
  let token_value = api_token(token)
  let url = "https://inventory.example.com/v1/items/{item}"
  let reply = attempt @http.get(url, headers: [Header(name: "X-Api-Token", value: token_value)], key_name: None)
  when reply
    is Err(failure) -> None
    is Ok(value) -> count_of(value)

--- A stand-in for the inventory API: it answers `{"count": 7}` for the item `widget` when the request carries the token `t0ken` in `X-Api-Token`, and 401 otherwise.
handler fake_inventory() for Http
  op get(url, headers, key_name) = if url == "https://inventory.example.com/v1/items/widget" and headers.contains(item: Header(name: "X-Api-Token", value: "t0ken")) then Response(status: 200, headers: [], body: "\{\"count\": 7\}") else Response(status: 401, headers: [], body: "")
  op post(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op put(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op delete(url, headers, key_name) = Response(status: 405, headers: [], body: "")

--- A stand-in for an unreachable inventory API.
handler unreachable_inventory() for Http
  op get(url, headers, key_name) = fail Unreachable
  op post(url, headers, body, key_name) = fail Unreachable
  op put(url, headers, body, key_name) = fail Unreachable
  op delete(url, headers, key_name) = fail Unreachable

example "the stand-in API answers a count of 7"
  given @http = fake_inventory()
  do stock_level("widget", token: "t0ken")
  expect result == Some(7)

example "a wrong token gets nothing"
  given @http = fake_inventory()
  do stock_level("widget", token: "wrong")
  expect result == None

example "an unreachable API gets nothing"
  given @http = unreachable_inventory()
  do stock_level("widget", token: "t0ken")
  expect result == None
