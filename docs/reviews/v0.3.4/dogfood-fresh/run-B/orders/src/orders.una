module orders

--- Why an order document cannot be summarized.
pub kind OrderError = | Malformed

field(doc: Json, name: Text) -> Option[Json]
=
  when doc
    is Object(fields) -> fields.get(key: name)
    else -> None

items_of(doc: Json) -> Option[List[Json]]
=
  when doc
    is Array(items) -> Some(items)
    else -> None

text_of(doc: Json) -> Option[Text]
=
  when doc
    is Str(value) -> Some(value)
    else -> None

int_of(doc: Json) -> Option[Int]
=
  when doc
    is Number(value) -> Some(value)
    else -> None

--- Summarizes the order lines of `input`: how many lines, their names in order, and the total quantity.
pub summarize(input: Text) -> Text
  fails OrderError
=
  let doc = parse_json(input)
    if error fail Malformed
  let lines_json = field(doc, name: "lines")
    if none fail Malformed
  let lines = items_of(lines_json)
    if none fail Malformed
  let edit names: List[Json] = []
  let edit total = 0
  for line in lines
    let name_json = field(line, name: "name")
      if none fail Malformed
    let name = text_of(name_json)
      if none fail Malformed
    let qty_json = field(line, name: "qty")
      if none fail Malformed
    let qty = int_of(qty_json)
      if none fail Malformed
    names = names.append(item: Str(value: name))
    total = total + qty
  let edit out: Map[Text, Json] = empty_map()
  edit out.set(key: "count", value: Number(value: lines.len))
  edit out.set(key: "names", value: Array(items: names))
  edit out.set(key: "total", value: Number(value: total))
  to_json(Object(fields: out))

example "two order lines"
  do summarize("\{\"lines\": [\{\"name\": \"a\", \"qty\": 2\}, \{\"name\": \"b\", \"qty\": 3\}]\}")
  expect result == "\{\"count\":2,\"names\":[\"a\",\"b\"],\"total\":5\}"
