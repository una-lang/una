module tally

--- Counts one more vote for `name`: the map keeps every candidate it had and gains at most the one new candidate.
pub add_vote(edit counts: Map[Text, Int], name: Text) -> Unit
  ensures counts.len >= old(counts).len
  ensures counts.len <= old(counts).len + 1
=
  let seen = counts.get(key: name)
    if none use 0
  edit counts.set(key: name, value: seen + 1)

--- The number of votes each candidate got, from a list with one name per vote.
pub tally(votes: List[Text]) -> Map[Text, Int]
=
  let edit counts: Map[Text, Int] = empty_map()
  for name in votes
    add_vote(edit counts, name)
  counts

example "three votes for two candidates"
  do tally(["ana", "bo", "ana"])
  expect result.get(key: "ana") == Some(2)
  expect result.get(key: "bo") == Some(1)
  expect result.len == 2

example "no votes, no candidates"
  do tally([])
  expect result.len == 0
