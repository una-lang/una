module greet

import reveal (login_name)

--- The greeting line for a user name.
pub greeting(name: Text) -> Text = "Hello, {name}! Your name has {name.len} letters."

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let name = @env.get("USER")
    if none use "stranger"
  @console.print(greeting(login_name(name)))

example "the greeting names the user"
  do greeting("ana")
  expect result == "Hello, ana! Your name has 3 letters."
