module sensors

pub kind ReadError = Unreachable | Broken

--- A bank of sensors, each named by its number; a reading can fail.
pub capability SensorBank
  op read(sensor: Int) -> Int
    fails ReadError

--- The readings of every sensor, read concurrently, in list order. Fails with the failure of the first sensor in list order that fails.
pub read_all(sensors: List[Int]) -> List[Int]
  uses @bank: SensorBank[read]
  fails ReadError
=
  let readings = together for sensor in sensors
    @bank.read(sensor)
      if error pass
  readings

--- How many sensors answered, reading them all concurrently. A failing sensor is counted as silent.
pub count_answered(sensors: List[Int]) -> Int
  uses @bank: SensorBank[read]
=
  let answers = together for sensor in sensors
    let outcome = attempt @bank.read(sensor)
    if is_ok(outcome) then 1 else 0
  answers.sum()

--- A stand-in bank: sensor `unreachable` is unreachable, sensor `broken` is broken, every other sensor reads ten times its number.
handler bank_with(unreachable: Int, broken: Int) for SensorBank
  op read(sensor) =
    if sensor == unreachable
      fail Unreachable
    else if sensor == broken
      fail Broken
    else
      sensor * 10

example "all sensors answer"
  given @bank = bank_with(unreachable: 0 - 1, broken: 0 - 2)
  do read_all([1, 2, 3])
  expect result == [10, 20, 30]

example "one failing sensor fails the whole reading"
  given @bank = bank_with(unreachable: 2, broken: 0 - 2)
  do read_all([1, 2, 3])
  expect fails Unreachable

example "the first failure in list order wins"
  given @bank = bank_with(unreachable: 3, broken: 2)
  do read_all([1, 2, 3, 4])
  expect fails Broken

example "the answering sensors are counted"
  given @bank = bank_with(unreachable: 2, broken: 0 - 2)
  do count_answered([1, 2, 3])
  expect result == 2
  expect performed @bank.read
