trusted module token

--- The API token leaves the program only as the value of the inventory API's header.
pub policy api_token_header
  from secret Text
  to internal Text
  via header_value
  purpose "authenticate to the inventory API in the X-Api-Token header"
  owner inventory_owner

header_value(token: secret Text) -> internal Text = token.replace(pattern: "\n", by: "").replace(pattern: "\u{D}", by: "")
