module orders

--- Why an order text cannot be summarized.
pub kind OrderError = | Malformed

--- Summarizes the order lines of a JSON text: how many lines, their names in order, and the total quantity.
pub summary(text: Text) -> Text
  fails OrderError
=
  let doc = parse_json(text)
    if error fail Malformed
  let lines_json = field(doc, key: "lines")
    if none fail Malformed
  let lines = as_list(lines_json)
    if none fail Malformed
  let edit names: List[Json] = []
  let edit total = 0
  for line in lines
    let name_json = field(line, key: "name")
      if none fail Malformed
    let name = as_text(name_json)
      if none fail Malformed
    let qty_json = field(line, key: "qty")
      if none fail Malformed
    let qty = as_int(qty_json)
      if none fail Malformed
    names = names.append(item: Str(name))
    total = total + qty
  let edit out: Map[Text, Json] = empty_map()
  edit out.set(key: "count", value: Number(lines.len))
  edit out.set(key: "names", value: Array(names))
  edit out.set(key: "total", value: Number(total))
  to_json(Object(out))

field(doc: Json, key: Text) -> Option[Json]
=
  when doc
    is Object(fields) -> fields.get(key: key)
    else -> None

as_list(value: Json) -> Option[List[Json]]
=
  when value
    is Array(items) -> Some(items)
    else -> None

as_text(value: Json) -> Option[Text]
=
  when value
    is Str(t) -> Some(t)
    else -> None

as_int(value: Json) -> Option[Int]
=
  when value
    is Number(n) -> Some(n)
    else -> None

example "two lines"
  do summary("\{\"lines\": [\{\"name\": \"a\", \"qty\": 2\}, \{\"name\": \"b\", \"qty\": 3\}]\}")
  expect result == "\{\"count\":2,\"names\":[\"a\",\"b\"],\"total\":5\}"
