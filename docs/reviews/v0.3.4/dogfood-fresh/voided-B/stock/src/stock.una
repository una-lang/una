module stock

import token_policy (api_token_header)

--- The stock level of an item, from the `count` field of the inventory API's answer, or nothing when the request, its status or its body fails.
pub stock_level(item: Text, token: secret Text) -> internal Option[internal Int]
  uses @http: Http[get]
=
  let auth = Header(name: "X-Api-Token", value: api_token_header(token))
  let outcome = attempt @http.get("https://inventory.example.com/v1/items/{item}", headers: [auth], key_name: None)
  when outcome
    is Ok(response) -> if response.status == 200 then count_of(response.body) else None
    is Err(failure) -> None

--- The integer field `count` of a JSON object text, or nothing.
count_of(body: internal Text) -> internal Option[internal Int]
=
  let doc = parse_json(body)
    if error use Null
  when doc
    is Object(fields) -> as_int(fields.get(key: "count"))
    else -> None

as_int(value: internal Option[Json]) -> internal Option[internal Int]
=
  when value
    is Some(j) -> int_of(j)
    is None -> None

int_of(j: internal Json) -> internal Option[internal Int]
=
  when j
    is Number(n) -> Some(n)
    else -> None

has_token(headers: internal List[internal Header]) -> internal Bool
=
  let edit found: internal Bool = false
  for h in headers
    if h.name == "X-Api-Token"
      found = true
  found

--- A stand-in for the inventory API: it answers a count of 7 to a request that carries the token header, and 401 otherwise.
handler fake_api() for Http
  op get(url, headers, key_name) = if has_token(headers) then Response(status: 200, headers: [], body: "\{\"count\": 7\}") else Response(status: 401, headers: [], body: "")
  op post(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op put(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op delete(url, headers, key_name) = Response(status: 405, headers: [], body: "")

example "the API answers a count of 7"
  given @http = fake_api()
  do stock_level("widget", token: "t0ken")
  expect result == Some(7)
