trusted module token

--- The API token, lowered so that it can be sent as a header value to the inventory API.
pub policy api_token_header
  from secret Text
  to internal Text
  via as_header
  purpose "send the inventory API token in the X-Api-Token header of requests to that API"
  owner inventory_owner

as_header(token: secret Text) -> internal Text = token.replace(pattern: "\n", by: "").replace(pattern: "\u{D}", by: "")
