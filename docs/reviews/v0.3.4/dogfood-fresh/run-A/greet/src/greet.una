module greet

import release (name_length)

--- Prints one line about the user named by USER.
pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let name = @env.get("USER")
    if none use ""
  let size = name_length(name)
  @console.print("Hello! Your user name has {size} characters.")
