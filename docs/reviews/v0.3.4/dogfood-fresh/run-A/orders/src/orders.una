module orders

--- Why an order text could not be summarized.
pub kind OrderError = BadJson | BadShape

--- One line of an order.
pub kind Line
  name: Text
  qty: Int

--- The fields of a JSON object.
object_fields(doc: Json) -> Map[Text, Json]
  fails OrderError
=
  when doc
    is Object(fields) -> fields
    else -> fail BadShape

--- The text of a field that holds a JSON string.
text_field(fields: Map[Text, Json], key: Text) -> Text
  fails OrderError
=
  let value = fields.get(key)
    if none fail BadShape
  when value
    is Str(text) -> text
    else -> fail BadShape

--- The integer of a field that holds a JSON integer.
int_field(fields: Map[Text, Json], key: Text) -> Int
  fails OrderError
=
  let value = fields.get(key)
    if none fail BadShape
  when value
    is Number(n) -> n
    else -> fail BadShape

--- The items of a field that holds a JSON array.
array_field(fields: Map[Text, Json], key: Text) -> List[Json]
  fails OrderError
=
  let value = fields.get(key)
    if none fail BadShape
  when value
    is Array(items) -> items
    else -> fail BadShape

--- One order line read from its JSON object.
line_of(item: Json) -> Line
  fails OrderError
=
  let fields = object_fields(item)
    if error pass
  let name = text_field(fields, key: "name")
    if error pass
  let qty = int_field(fields, key: "qty")
    if error pass
  Line(name: name, qty: qty)

--- The summary of an order: how many lines, their names in order, and the total quantity.
pub summarize(text: Text) -> Text
  fails OrderError
=
  let doc = text.parse_json()
    if error fail BadJson
  let fields = object_fields(doc)
    if error pass
  let items = array_field(fields, key: "lines")
    if error pass
  let lines = items.map(each: line_of)
    if error pass
  let names = lines.map(each: fn(l) -> Str(l.name))
  let total = lines.map(each: fn(l) -> l.qty).sum()
  let summary: Map[Text, Json] = empty_map().with(key: "count", value: Number(lines.len)).with(key: "names", value: Array(names)).with(key: "total", value: Number(total))
  Object(summary).to_json()

example "two lines are counted, named and totalled"
  do summarize("\{\"lines\": [\{\"name\": \"a\", \"qty\": 2\}, \{\"name\": \"b\", \"qty\": 3\}]\}")
  expect result == "\{\"count\":2,\"names\":[\"a\",\"b\"],\"total\":5\}"

example "text that is not JSON fails"
  do summarize("nope")
  expect fails BadJson
