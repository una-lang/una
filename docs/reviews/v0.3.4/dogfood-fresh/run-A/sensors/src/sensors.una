module sensors

--- A sensor that did not answer.
pub kind ReadError = | Offline(sensor: Text)

--- A bank of sensors, each read by its name.
pub capability SensorBank
  op reading(sensor: Text) -> Int
    fails ReadError

--- Every sensor's reading, in list order, read concurrently. Fails with the first failure in
--- list order, as reading them one after another would.
pub read_all(sensors: List[Text]) -> List[Int]
  uses @bank: SensorBank[reading]
  fails ReadError
=
  let readings = together for sensor in sensors
    @bank.reading(sensor)
      if error pass
  readings

--- How many sensors answered, read concurrently; a sensor that fails is not counted.
pub answered(sensors: List[Text]) -> Int
  uses @bank: SensorBank[reading]
=
  let answers = together for sensor in sensors
    let outcome = attempt @bank.reading(sensor)
    if outcome.is_ok() then 1 else 0
  answers.sum()

--- A stand-in bank: a sensor in the map answers its value, any other fails.
handler bank_of(readings: Map[Text, Int]) for SensorBank
  op reading(sensor) = if readings.has(key: sensor) then readings.get(key: sensor).or_else(default: 0) else fail Offline(sensor: sensor)

example "all sensors answer, in list order"
  given @bank = bank_of(readings: empty_map().with(key: "north", value: 12).with(key: "south", value: 20))
  do read_all(["south", "north"])
  expect result == [20, 12]

example "one sensor fails, so reading all of them fails"
  given @bank = bank_of(readings: empty_map().with(key: "north", value: 12).with(key: "east", value: 9))
  do read_all(["north", "south", "east"])
  expect fails Offline
  expect performed @bank.reading

example "the first failure in list order is the one reported"
  given @bank = bank_of(readings: empty_map().with(key: "north", value: 12))
  do attempt read_all(["north", "west", "south"])
  expect result == Err(Offline(sensor: "west"))

example "with one sensor failing, the others are counted"
  given @bank = bank_of(readings: empty_map().with(key: "north", value: 12).with(key: "east", value: 9))
  do answered(["north", "south", "east"])
  expect result == 2
