module allow

import std.testing (fake_hash)

--- Whether the address is on the list of known hashes, compared only as hashes.
pub is_known(address: secret Text, known: List[internal Hashed]) -> secret Bool
  uses @keys: Keys[hmac]
  fails KeyError
=
  let h = @keys.hmac(key_name: "pepper", data: address)
    if error pass
  known.filter(keep: fn(k) -> k == h).len > 0

pub handler fake_keys() for Keys
  op hmac(key_name, data) = if data == "ana@example.com" then fake_hash(1) else fake_hash(2)

example "a known address"
  given @keys = fake_keys()
  do is_known("ana@example.com", known: [fake_hash(1)])
  expect result == true
