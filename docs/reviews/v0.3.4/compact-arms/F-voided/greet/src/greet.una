module greet

import release (name_length)

--- The line printed about a user whose name has `length` letters.
pub describe(length: Nat) -> Text = "Hello! Your user name has {length} letters."

pub main() -> Unit
  uses @console: Console[print]
  uses @env: Env[get]
=
  let name = @env.get("USER")
    if none use ""
  @console.print(describe(name_length(name)))

example "the line names the length"
  do describe(3)
  expect result == "Hello! Your user name has 3 letters."
