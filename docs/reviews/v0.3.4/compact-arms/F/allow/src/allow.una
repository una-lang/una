module allow

import keyed (address_key)
import std.testing (fake_hash)

--- Whether an address is on an allowlist kept as HMAC hashes made with the key `pepper`.
--- Only the address's keyed hash is compared, never the address itself.
pub is_allowed(address: secret Text, allowlist: List[internal Hashed]) -> internal Bool
  uses @keys: Keys[hmac]
  fails KeyError
=
  let hashed = address_key(address)
    if error pass
  allowlist.contains(item: hashed)

--- A stand-in for the key service: under `pepper`, the address `ana@example.com` hashes
--- as seed 1 and every other address as seed 2; any other key gives seed 0.
handler fake_pepper() for Keys
  op hmac(key_name, data) = if key_name != "pepper" then fake_hash(0) else if data == "ana@example.com" then fake_hash(1) else fake_hash(2)

example "an address whose keyed hash is listed is allowed"
  given @keys = fake_pepper()
  do is_allowed("ana@example.com", allowlist: [fake_hash(3), fake_hash(1)])
  expect result == true
  expect performed @keys.hmac

example "an address whose keyed hash is not listed is refused"
  given @keys = fake_pepper()
  do is_allowed("bo@example.com", allowlist: [fake_hash(3), fake_hash(1)])
  expect result == false
