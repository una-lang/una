trusted module keyed

--- An e-mail address leaves the program only as its HMAC under the key `pepper`.
pub policy address_key
  from secret Text
  to internal Hashed
  via hmac_address
  purpose "look an e-mail address up in an allowlist kept only as keyed hashes"
  owner access_owner

hmac_address(address: secret Text) -> internal Hashed
  uses @keys: Keys[hmac]
  fails KeyError
=
  @keys.hmac(key_name: "pepper", data: address)
    if error pass
