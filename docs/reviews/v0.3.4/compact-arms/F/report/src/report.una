module report

import readings (summarize)
import release (shown_summary)

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
  fails FileError
=
  let text = @files.read("readings.txt")
    if error pass
  let newline = "\n"
  let summary = summarize(text.split(on: newline))
  @console.print(shown_summary(summary))
