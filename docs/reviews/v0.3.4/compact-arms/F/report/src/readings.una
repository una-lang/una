module readings

--- How many lines held an integer, and their sum.
pub kind Readings
  count: internal Nat
  sum: internal Int

--- The integer a line holds, without the spaces around it, or `None` for a blank line or
--- one that is not a number.
reading(line: internal Text) -> internal Option[internal Int]
=
  let parsed = attempt line.trim().parse_int()
  when parsed
    is Ok(n) -> Some(n)
    is Err(e) -> None

--- The valid readings among the lines: never more than there are lines.
pub summarize(lines: internal List[internal Text]) -> internal Readings
  ensures result.count <= lines.len
=
  let valid = lines.map(each: reading).filter(keep: fn(o) -> o.is_some())
  let values = valid.map(each: fn(o) -> o.or_else(default: 0))
  Readings(count: valid.len, sum: values.sum())

example "blank lines and words are skipped"
  do summarize(["12", "7", "x", "-3", "", "40"])
  expect result == Readings(count: 4, sum: 56)

example "no lines, no readings"
  do summarize([])
  expect result.count == 0 and result.sum == 0
