trusted module release

--- The API token leaves the program only as the value of the `X-Api-Token` header.
pub policy api_token_header
  from secret Text
  to internal Text
  via as_header_value
  purpose "send the inventory API token in the X-Api-Token header"
  owner inventory_owner

--- The token without line breaks, so that it cannot add a header of its own.
as_header_value(token: secret Text) -> internal Text = token.replace(pattern: "\n", by: "").replace(pattern: "\u{D}", by: "")
