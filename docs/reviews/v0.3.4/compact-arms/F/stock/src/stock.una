module stock

import release (api_token_header)

--- Whether an item name can stand in the path of the URL as one segment.
pub safe_item(item: Text) -> Bool = item.len > 0 and not item.contains_text(part: "/") and not item.contains_text(part: "?") and not item.contains_text(part: "#") and not item.contains_text(part: "%") and not item.contains_text(part: " ")

--- The stock level of an item, from the inventory API, or `None` when anything fails:
--- an unusable item name, no response, a status other than 200, or no integer `count`.
pub stock(item: Text, token: secret Text) -> internal Option[internal Int]
  uses @http: Http[get]
=
  if not safe_item(item)
    None
  else
    let auth = Header(name: "X-Api-Token", value: api_token_header(token))
    let r = attempt @http.get("https://inventory.example.com/v1/items/{item}", headers: [auth], key_name: None)
    when r
      is Ok(response) -> if response.status == 200 then count_of(response.body) else None
      is Err(e) -> None

--- The `count` field of a JSON object, when it is an integer.
count_of(body: internal Text) -> internal Option[internal Int]
=
  let doc = body.parse_json()
    if error use Null
  when doc
    is Object(fields) ->
      let value = fields.get(key: "count")
        if none use Null
      when value
        is Number(n) -> Some(n)
        else -> None
    else -> None

--- A stand-in for the inventory API: a GET with an `X-Api-Token` header answers 200 with
--- `answer`, one without it 401, and the other methods 405.
pub handler inventory(answer: Text) for Http
  op get(url, headers, key_name) = if headers.first_where(keep: fn(h) -> h.name == "X-Api-Token").is_some() then Response(status: 200, headers: [], body: answer) else Response(status: 401, headers: [], body: "")
  op post(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op put(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op delete(url, headers, key_name) = Response(status: 405, headers: [], body: "")

example "the API's count is returned"
  given @http = inventory(answer: "\{\"count\": 7\}")
  do stock("widget", token: "t0ken")
  expect result == Some(7)
  expect performed @http.get

example "an answer without a count is nothing"
  given @http = inventory(answer: "\{\"items\": 7\}")
  do stock("widget", token: "t0ken")
  expect result == None

example "an item name that would change the path is refused without a request"
  given @http = inventory(answer: "\{\"count\": 7\}")
  do stock("../admin", token: "t0ken")
  expect result == None
  expect not performed @http.get
