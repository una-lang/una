module sensors

--- Why a sensor gave no reading.
pub kind SensorError = Offline(sensor: Text) | Garbled(sensor: Text)

--- A bank of sensors, each read by its name.
pub capability SensorBank
  op read(sensor: Text) -> Int
    fails SensorError

--- Every sensor read concurrently, in list order; fails with the failure of the first
--- sensor in the list that fails.
pub read_all(names: List[Text]) -> List[Int]
  ensures result.len == names.len
  uses @bank: SensorBank[read]
  fails SensorError
=
  let readings = together for name in names
    @bank.read(name)
      if error pass
  readings

--- How many sensors answered, every sensor read concurrently.
pub answered(names: List[Text]) -> Nat
  ensures result <= names.len
  uses @bank: SensorBank[read]
=
  let outcomes = together for name in names
    attempt @bank.read(name)
  outcomes.filter(keep: fn(r) -> r.is_ok()).len

--- A stand-in bank: the sensor named `broken` is offline, and each other one reads the
--- length of its name times ten.
pub handler bank_with_broken(broken: Text) for SensorBank
  op read(sensor) = if sensor == broken then fail Offline(sensor) else sensor.len * 10

example "every sensor answers"
  given @bank = bank_with_broken(broken: "none")
  do read_all(["a", "bb", "ccc"])
  expect result == [10, 20, 30]

example "the first failure in list order is the failure"
  given @bank = bank_with_broken(broken: "bb")
  do read_all(["a", "bb", "ccc"])
  expect fails Offline

example "the sensors that answered are counted"
  given @bank = bank_with_broken(broken: "bb")
  do answered(["a", "bb", "ccc"])
  expect result == 2
  expect performed @bank.read

example "the failure names the first failing sensor"
  given @bank = bank_with_broken(broken: "bb")
  do attempt read_all(["a", "bb", "ccc"])
  expect result == Err(Offline("bb"))
  expect performed @bank.read
