module tally

--- One vote counted: the candidate is in the map afterwards, and the map grew by at most one key.
pub add_vote(edit counts: Map[Text, Int], vote: Text) -> Unit
  ensures counts.has(key: vote)
  ensures counts.len <= old(counts).len + 1
=
  let n = counts.get(key: vote)
    if none use 0
  edit counts.set(key: vote, value: n + 1)

--- The votes per candidate, one call of `add_vote` per vote.
pub tally(votes: List[Text]) -> Map[Text, Int]
=
  let edit counts: Map[Text, Int] = empty_map()
  for vote in votes
    add_vote(edit counts, vote)
  counts

--- The votes counted, with one more vote: its candidate is always in the result.
pub tally_with(votes: List[Text], last: Text) -> Map[Text, Int]
  ensures result.has(key: last)
=
  let edit counts = tally(votes)
  add_vote(edit counts, vote: last)
  counts

example "votes are counted per candidate"
  do tally(["ana", "bo", "ana", "cy", "ana"])
  expect result == empty_map().with(key: "ana", value: 3).with(key: "bo", value: 1).with(key: "cy", value: 1)

example "no votes give an empty map"
  do tally([])
  expect result.len == 0

example "the last vote's candidate is counted"
  do tally_with(["ana"], last: "bo")
  expect result.has(key: "bo")
