module allow

import release (keyed_hash)
import std.host (KeyError)
import std.testing (fake_hash)

--- Whether `email` is on the allowlist, which holds only HMAC hashes made with the key `pepper`.
--- The address is hashed by the key service and compared only as its hash.
pub allowed(email: secret Text, allowlist: List[internal Hashed]) -> internal Bool
  uses @keys: Keys[hmac]
  fails KeyError
=
  let hashed = @keys.hmac("pepper", data: email)
    if error pass
  allowlist.contains(item: keyed_hash(hashed))

--- A stand-in key service that hashes every address to `fake_hash(seed)`.
pub handler fake_keys(seed: Int) for Keys
  op hmac(key_name, data) = fake_hash(seed)

example "an address whose hash is on the allowlist"
  given @keys = fake_keys(seed: 15)
  do allowed("ana@example.com", allowlist: [fake_hash(3), fake_hash(15)])
  expect result == true
  expect performed @keys.hmac

example "an address whose hash is not on the allowlist"
  given @keys = fake_keys(seed: 7)
  do allowed("bo@example.com", allowlist: [fake_hash(3), fake_hash(15)])
  expect result == false
