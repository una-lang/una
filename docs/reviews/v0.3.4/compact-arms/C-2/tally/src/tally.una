module tally

--- Count one more vote for `name`.
add_vote(edit counts: Map[Text, Int], name: Text) -> Unit
  ensures counts.has(key: name)
  ensures counts.len >= old(counts).len
=
  let seen = counts.get(key: name)
    if none use 0
  edit counts.set(key: name, value: seen + 1)

--- The number of votes of each candidate, in ascending order of the names.
pub tally(votes: List[Text]) -> Map[Text, Int]
=
  let edit counts: Map[Text, Int] = empty_map()
  for name in votes
    add_vote(edit counts, name)
  counts

example "three votes for two candidates"
  do tally(["ana", "bo", "ana"])
  expect result.len == 2
  expect result.get(key: "ana") == Some(2)
  expect result.get(key: "bo") == Some(1)

example "no votes"
  do tally([])
  expect result.len == 0
