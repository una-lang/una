module stock

import release (token_header)

count_of(status: internal Int, body: internal Text) -> internal Option[internal Int] = if status == 200 then parse_count(body) else None

parse_count(body: internal Text) -> internal Option[internal Int]
=
  let doc = attempt body.parse_json()
  when doc
    is Ok(j) -> count_field(j)
    else -> None

count_field(j: internal Json) -> internal Option[internal Int]
=
  when j
    is Object(fields) -> number_of(fields.get(key: "count"))
    else -> None

number_of(j: internal Option[internal Json]) -> internal Option[internal Int]
=
  when j
    is Some(v) -> number_value(v)
    else -> None

number_value(v: internal Json) -> internal Option[internal Int]
=
  when v
    is Number(n) -> Some(n)
    else -> None

fetch(item: Text, token: secret Text) -> internal Response
  uses @http: Http[get]
  fails HttpError
=
  let value = token_header(token)
  @http.get("https://inventory.example.com/v1/items/{item}", headers: [Header(name: "X-Api-Token", value: value)], key_name: None)
    if error pass

--- The stock level of `item`, or nothing when the request or its answer fails.
pub stock_level(item: Text, token: secret Text) -> internal Option[internal Int]
  uses @http: Http[get]
=
  let reply = attempt fetch(item, token: token)
  when reply
    is Ok(r) -> count_of(r.status, body: r.body)
    else -> None

handler inventory(count: Int) for Http
  op get(url, headers, key_name) = Response(status: 200, headers: [], body: "\{\"count\": {count}\}")
  op post(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op put(url, headers, body, key_name) = Response(status: 405, headers: [], body: "")
  op delete(url, headers, key_name) = Response(status: 405, headers: [], body: "")

example "the stand-in API answers 7"
  given @http = inventory(7)
  do stock_level("widget", token: "t0k3n")
  expect result == Some(7)
  expect performed @http.get

handler outage() for Http
  op get(url, headers, key_name) = Response(status: 503, headers: [], body: "\{\"count\": 1\}")
  op post(url, headers, body, key_name) = Response(status: 503, headers: [], body: "")
  op put(url, headers, body, key_name) = Response(status: 503, headers: [], body: "")
  op delete(url, headers, key_name) = Response(status: 503, headers: [], body: "")

example "an API error gives nothing"
  given @http = outage()
  do stock_level("widget", token: "t0k3n")
  expect result == None
