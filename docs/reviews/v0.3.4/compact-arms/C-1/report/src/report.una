module report

import release (shown)

pub kind ReportError = | Unreadable

pub kind Readings
  count: internal Nat
  sum: internal Int

--- Adds one line: a line that holds an integer adds one reading, any other line adds none.
add_line(edit acc: internal Readings, line: internal Text) -> Unit
  ensures acc.count >= old(acc).count
  ensures acc.count <= old(acc).count + 1
=
  let value = attempt line.trim().parse_int()
  acc = when value
    is Ok(n) -> Readings(count: acc.count + 1, sum: acc.sum + n)
    else -> acc

--- The number of lines of `text` that hold an integer, and their sum; blank lines and other text are skipped.
pub count_valid(text: internal Text) -> internal Readings
  ensures result.count >= 0
=
  let edit acc: internal Readings = Readings(count: 0, sum: 0)
  for line in text.split(on: "\n")
    add_line(edit acc, line: line)
  acc

pub main() -> Unit
  uses @console: Console[print]
  uses @files: Files[read]
  fails ReportError
=
  let text = @files.read("readings.txt")
    if error fail Unreadable
  let r = count_valid(text)
  let line = shown("{r.count} valid readings, sum {r.sum}")
  @console.print(line)

example "blank and non-numeric lines are skipped"
  do count_valid("12\n7\nx\n-3\n\n40\n")
  expect result.count == 4
  expect result.sum == 56

example "no valid lines"
  do count_valid("\nabc\n")
  expect result.count == 0
  expect result.sum == 0
