module allow

import std.testing (fake_hash)

--- Whether an e-mail address is on an allowlist kept only as HMAC hashes made with the key
--- `pepper`. The address is trimmed and lowercased, as the allowlist's entries were, then
--- hashed by the key service; only hashes are compared, never the address in clear. The
--- answer depends on the secret address, so it is secret too.
pub is_allowed(email: secret Text, allowlist: List[internal Hashed]) -> secret Bool
  uses @keys: Keys[hmac]
  fails KeyError
=
  let normalized = email.trim().to_lower()
  let hashed = @keys.hmac(key_name: "pepper", data: normalized)
    if error pass
  allowlist.contains(item: hashed)

--- A stand-in for the key service. A handler sees `data` as `restricted`, so its hash can
--- depend only on the key's name: every text hashes to `fake_hash(1)` with `pepper`.
handler fake_keys() for Keys
  op hmac(key_name, data) = fake_hash(if key_name == "pepper" then 1 else 0)

example "an address whose hash is on the allowlist is allowed"
  given @keys = fake_keys()
  do is_allowed("ana@example.org", allowlist: [fake_hash(7), fake_hash(1)])
  expect result == true
  expect performed @keys.hmac

example "an address whose hash is not on the allowlist is not allowed"
  given @keys = fake_keys()
  do is_allowed("eve@example.org", allowlist: [fake_hash(7)])
  expect result == false

example "an empty allowlist allows nobody"
  given @keys = fake_keys()
  do is_allowed("ana@example.org", allowlist: [])
  expect result == false
