module orders

pub kind OrderError = Malformed | MissingField(name: Text)

--- One order line: a product name and a quantity.
pub kind Line
  name: Text
  qty: Int

--- The line a JSON object describes.
line_of(j: Json) -> Line
  fails OrderError
=
  let fields = when j
    is Object(fields) -> fields
    else -> fail Malformed
  let name_json = fields.get(key: "name")
    if none fail MissingField("name")
  let qty_json = fields.get(key: "qty")
    if none fail MissingField("qty")
  let name = when name_json
    is Str(value) -> value
    else -> fail Malformed
  let qty = when qty_json
    is Number(value) -> value
    else -> fail Malformed
  Line(name: name, qty: qty)

--- The lines of an order document.
lines_of(text: Text) -> List[Line]
  fails OrderError
=
  let doc = text.parse_json()
    if error fail Malformed
  let fields = when doc
    is Object(fields) -> fields
    else -> fail Malformed
  let lines_json = fields.get(key: "lines")
    if none fail MissingField("lines")
  let items = when lines_json
    is Array(items) -> items
    else -> fail Malformed
  items.map(each: line_of)
    if error pass

--- A summary of an order: how many lines, their names in order, and the total quantity.
pub summary(text: Text) -> Text
  fails OrderError
=
  let lines = lines_of(text)
    if error pass
  let names = lines.map(each: fn(l) -> Str(l.name))
  let total = lines.map(each: fn(l) -> l.qty).sum()
  let edit out: Map[Text, Json] = empty_map()
  edit out.set(key: "count", value: Number(lines.len))
  edit out.set(key: "names", value: Array(names))
  edit out.set(key: "total", value: Number(total))
  Object(out).to_json()

example "two lines are summarized"
  do summary("\{\"lines\": [\{\"name\": \"a\", \"qty\": 2\}, \{\"name\": \"b\", \"qty\": 3\}]\}")
  expect result == "\{\"count\":2,\"names\":[\"a\",\"b\"],\"total\":5\}"

example "text that is not JSON is rejected"
  do summary("not json")
  expect fails Malformed
