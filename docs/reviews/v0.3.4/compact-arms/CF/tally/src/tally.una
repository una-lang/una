module tally

--- One vote counted: the candidate is in the map afterwards, and at most one key was added.
pub add_vote(edit counts: Map[Text, Int], candidate: Text) -> Unit
  ensures counts.has(key: candidate)
  ensures counts.len <= old(counts).len + 1
=
  let n = counts.get(key: candidate)
    if none use 0
  edit counts.set(key: candidate, value: n + 1)

--- The votes per candidate, one call of `add_vote` per vote.
pub tally(votes: List[Text]) -> Map[Text, Int]
=
  let edit counts: Map[Text, Int] = empty_map()
  for vote in votes
    add_vote(edit counts, candidate: vote)
  counts

--- The votes per candidate with one more vote: that candidate is always in the result.
pub tally_with(votes: List[Text], last: Text) -> Map[Text, Int]
  ensures result.has(key: last)
=
  let edit counts = tally(votes)
  add_vote(edit counts, candidate: last)
  counts

example "votes are counted per candidate"
  do tally(["ann", "bob", "ann"])
  expect result == empty_map().with(key: "ann", value: 2).with(key: "bob", value: 1)

example "no votes give an empty map"
  do tally([])
  expect result.len == 0

example "the last vote's candidate is counted"
  do tally_with(["ann"], last: "cid")
  expect result.has(key: "cid")
  expect result.get(key: "ann") == Some(1)
