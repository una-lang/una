  {
   "module": "prelude",
   "name": "is_digits",
   "area": "text",
   "params": [
    {
     "name": "t",
     "meaning": "the text"
    }
   ],
   "returns": {
    "type": "Bool",
    "meaning": "`true` when every character of `t` is an ASCII digit, so also for the empty text"
   },
   "use_instead": [
    {
     "item": "parse_int",
     "why": "to read the number the digits write, with a reason when there is none"
    }
   ],
   "see_also": [
    "to_int"
   ],
   "example": "docs/std/examples/prelude/is_digits"
  },
