module shop

--- How many units to reorder, never fewer than none, and the last of two names in the order of
--- their scalar values.
pub main() -> Unit
  uses @console: Console[print]
=
  let reorder = max(0, b: 10 - 14)
  @console.print("reorder {reorder}")
  let last = max("Desk lamp", b: "Chair")
  @console.print(last)
