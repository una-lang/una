module shop

--- Whether an item is stocked at all.
pub main() -> Unit
  uses @console: Console[print]
=
  let stock = empty_map().with(key: "lamp", value: 3).with(key: "desk", value: 1)
  let lamp = stock.has(key: "lamp")
  @console.print("lamp: {lamp}")
  let chair = stock.has(key: "chair")
  @console.print("chair: {chair}")
