module kernels

--- K1: calls and tagged integers.
fib(n: Int) -> Int = if n < 2 then n else fib(n - 1) + fib(n - 2)

--- K2: a loop of integer arithmetic over `let edit` state.
mix(n: Int) -> Int
=
  let edit h = 7
  for i in 0..<n
    h = (h * 31 + i) mod 1000000007
  h

--- K3: a list built, then folded (the runtime's lists and reference counts).
listsum(n: Int) -> Int
=
  let edit xs: List[Int] = []
  for i in 0..<n
    xs = xs.append(item: i mod 1000)
  xs.fold(initial: 0, step: fn(acc, x) -> acc + x)

pub main() -> Unit
  uses @console: Console[print]
=
  let r = mix(50000000)
  @console.print("{r}")
