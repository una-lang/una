module k2

pub main() -> Unit
  uses @console: Console[print]
=
  let edit bytes: List[U8] = []
  let edit b: U8 = 0
  for i in 0..<2000000
    bytes = bytes.append(item: b)
    b = b.wrapping_add(by: 7)
  let edit h: U64 = 14695981039346656037
  for x in bytes
    h = h.bit_xor(mask: x.to_u64()).wrapping_mul(by: 1099511628211)
  @console.print("{h}")
